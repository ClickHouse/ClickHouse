diff --git a/runtimes/glibc/startup_config.bzl b/runtimes/glibc/startup_config.bzl
new file mode 100644
index 0000000000000000000000000000000000000000..cf0d89cb2027766c8023d341a38d1fa318b01132
--- /dev/null
+++ b/runtimes/glibc/startup_config.bzl
@@ -0,0 +1,25 @@
+"""Build settings for the optional glibc PIE startup objects."""
+
+load("@rules_cc//cc/common:cc_common.bzl", "cc_common")
+load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")
+
+# These releases use csu/init.c only to define _IO_stdin_used.
+PIE_STARTUP_VERSIONS = ["2.28", "2.31"]
+
+def _minimum_kernel_impl(ctx):
+    parts = ctx.build_setting_value.split(".")
+    if len(parts) != 3 or not all([p.isdigit() for p in parts]):
+        fail("minimum_kernel must be three unsigned decimal integers, e.g. 3.2.0")
+    numbers = [int(p, 10) for p in parts]
+    if any([n > 0xffffffff for n in numbers]):
+        fail("minimum_kernel components must fit in an ELF note word")
+    define = "__ABI_TAG_VERSION=" + ",".join([str(n) for n in numbers])
+    return [CcInfo(compilation_context = cc_common.create_compilation_context(
+        defines = depset([define]),
+    ))]
+
+minimum_kernel = rule(
+    implementation = _minimum_kernel_impl,
+    build_setting = config.string(flag = True),
+    doc = "Linux ABI version for the GNU ABI note in the selected glibc PIE startup objects.",
+)

diff --git a/3rd_party/libc/glibc/pie_startup.bzl b/3rd_party/libc/glibc/pie_startup.bzl
new file mode 100644
index 0000000000000000000000000000000000000000..cb3040eb90cc1915e8ac44245449e5c90f63ff19
--- /dev/null
+++ b/3rd_party/libc/glibc/pie_startup.bzl
@@ -0,0 +1,139 @@
+"""Compile the GNU/Linux PIE startup objects from a selected glibc source release."""
+
+load("@llvm//toolchain/runtimes:cc_runtime_library.bzl", "cc_runtime_stage0_library")
+load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")
+load(":helpers.bzl", "glibc_includes")
+
+def _object(target):
+    # Each private cc_library below compiles one assembly file and declares
+    # only header dependencies. Select its object, not its static archive.
+    objects = []
+    for linker_input in target[CcInfo].linking_context.linker_inputs.to_list():
+        for library in linker_input.libraries:
+            objects.extend(library.objects or library.pic_objects or [])
+    if len(objects) != 1:
+        fail("{}: expected one compiled glibc startup object, got {}".format(target.label, objects))
+    return objects[0]
+
+def _pie_startup_impl(ctx):
+    out = ctx.outputs.startup
+    args = ctx.actions.args()
+    args.add("-r")
+    args.add_all(["-z", "noexecstack"])
+    args.add_all(ctx.attr.undefined_symbols, format_each = "--undefined=%s")
+    args.add("-o", out)
+    components = [_object(dep) for dep in ctx.attr.entry]
+    args.add_all(components)
+    ctx.actions.run(
+        executable = ctx.attr.ld_bfd[DefaultInfo].files_to_run,
+        arguments = [args],
+        inputs = components,
+        outputs = [out],
+        mnemonic = "GlibcPieStartup",
+        progress_message = "Combining glibc startup objects into %{output}",
+        toolchain = None,
+    )
+    ctx.actions.symlink(output = ctx.outputs.crti, target_file = _object(ctx.attr.init))
+    ctx.actions.symlink(output = ctx.outputs.crtn, target_file = _object(ctx.attr.fini))
+    return [DefaultInfo(files = depset([out, ctx.outputs.crti, ctx.outputs.crtn]))]
+
+_pie_startup = rule(
+    implementation = _pie_startup_impl,
+    attrs = {
+        "crti": attr.output(mandatory = True),
+        "crtn": attr.output(mandatory = True),
+        "entry": attr.label_list(providers = [CcInfo], mandatory = True),
+        "fini": attr.label(providers = [CcInfo], mandatory = True),
+        "init": attr.label(providers = [CcInfo], mandatory = True),
+        "ld_bfd": attr.label(cfg = "exec", executable = True, mandatory = True),
+        "startup": attr.output(mandatory = True),
+        "undefined_symbols": attr.string_list(),
+    },
+)
+
+def glibc_pie_startup_objects(name, hdrs, ld_bfd):
+    """Declare the three GNU startup objects used by the Clang PIE driver.
+
+    Args:
+      name: Public filegroup name in the glibc source repository.
+      hdrs: glibc source headers used by sysdeps assembly.
+      ld_bfd: GNU linker label resolved by the glibc source repository.
+    """
+    cpus = ["aarch64", "x86_64"]
+    includes = select({"@platforms//cpu:" + cpu: glibc_includes(cpu) for cpu in cpus} | {"//conditions:default": []})
+    enabled = select({
+        "@llvm//runtimes/glibc:crt_source_unset": ["@platforms//:incompatible"],
+        "//conditions:default": [],
+    })
+    compatible = enabled + select(
+        {"@platforms//cpu:" + cpu: [] for cpu in cpus} |
+        {"//conditions:default": ["@platforms//:incompatible"]},
+    ) + ["@platforms//os:linux"]
+
+    # glibc sysdeps/x86/Makefile passes both options to its assembler.
+    # cet.h defines _CET_ENDBR and emits .note.gnu.property.
+    asm_copts = ["-nostdlibinc", "-fPIC", "-fno-addrsig", "-g0", "-Wa,--noexecstack"] + select({
+        "@llvm//runtimes/glibc:x86_64_cet": ["-fcf-protection=full", "-include", "cet.h"],
+        "//conditions:default": ["-nobuiltininc"],
+    })
+    for part in ["start", "crti", "crtn"]:
+        cc_runtime_stage0_library(
+            name = "pie_" + part,
+            srcs = select({"@platforms//cpu:" + cpu: ["sysdeps/{}/{}.S".format(cpu, part)] for cpu in cpus} | {"//conditions:default": []}),
+            hdrs = hdrs,
+            additional_compiler_inputs = ["include/libc-modules.h", "include/libc-symbols.h"],
+            copts = asm_copts + [
+                "-Wno-nonportable-include-path",
+                "-include",
+                "$(location include/libc-modules.h)",
+                "-include",
+                "$(location include/libc-symbols.h)",
+            ],
+            implementation_deps = [":gnu_libc_headers", ":kernel_headers"],
+            includes = includes,
+            local_defines = ["ASSEMBLER", "MODULE_NAME=libc", "PIC", "SHARED", "TOP_NAMESPACE=glibc", "_LIBC_REENTRANT"],
+            target_compatible_with = compatible,
+        )
+
+    cc_runtime_stage0_library(
+        name = "pie_abi_note",
+        srcs = ["@llvm//3rd_party/libc/glibc/csu:abi-note-2.31.S"],
+        hdrs = ["csu/abi-tag.h", "include/config.h"],
+        copts = asm_copts,
+        implementation_deps = ["@llvm//runtimes/glibc:minimum_kernel"],
+        includes = ["csu", "include"],
+        target_compatible_with = compatible,
+    )
+    cc_runtime_stage0_library(
+        name = "pie_stdio_marker",
+        srcs = ["@llvm//3rd_party/libc/glibc/csu:io-stdin-used.S"],
+        copts = asm_copts,
+        target_compatible_with = compatible,
+    )
+
+    for cpu in cpus:
+        # The BCR binutils binary implements the ELF emulation of its own
+        # platform. Build and run it on Linux on the target CPU.
+        native_linux = ["@platforms//os:linux", "@platforms//cpu:" + cpu]
+        directory = "native/" + cpu + "/"
+        _pie_startup(
+            name = "pie_startup_" + cpu,
+            entry = [":pie_abi_note", ":pie_stdio_marker", ":pie_start"],
+            init = ":pie_crti",
+            fini = ":pie_crtn",
+            ld_bfd = ld_bfd,
+            # GNU as emits an undefined _GLOBAL_OFFSET_TABLE_ for x86-64 GOTPCREL references.
+            undefined_symbols = ["_GLOBAL_OFFSET_TABLE_"] if cpu == "x86_64" else [],
+            startup = directory + "Scrt1.o",
+            crti = directory + "crti.o",
+            crtn = directory + "crtn.o",
+            exec_compatible_with = native_linux,
+            target_compatible_with = enabled + native_linux,
+        )
+
+    native.filegroup(
+        name = name,
+        srcs = select({"@platforms//cpu:" + cpu: [":pie_startup_" + cpu] for cpu in cpus} | {"//conditions:default": []}),
+        target_compatible_with = compatible,
+        visibility = ["//visibility:public"],
+    )

+    constraint_values = ["@platforms//cpu:x86_64"],
+    flag_values = {":crt_cet": "true"},
+    visibility = ["//visibility:public"],
+)
+
+alias(
+    name = "pie_startup_objects",
+    actual = "@glibc//:pie_startup_objects",
+    visibility = ["//visibility:public"],
+)
+
+bzl_library(
+    name = "startup_config",
+    srcs = ["startup_config.bzl"],
+    visibility = ["//visibility:public"],
+    deps = ["@rules_cc//cc/common"],
+)
 

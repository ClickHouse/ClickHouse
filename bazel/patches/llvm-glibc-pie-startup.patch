diff --git a/3rd_party/libc/glibc/csu/io-stdin-used.S b/3rd_party/libc/glibc/csu/io-stdin-used.S
new file mode 100644
index 0000000000000000000000000000000000000000..85b66524360a6c729ed2cf911eb5ecf2bcf84a4d
--- /dev/null
+++ b/3rd_party/libc/glibc/csu/io-stdin-used.S
@@ -0,0 +1,11 @@
+/* glibc 2.28 and 2.31 csu/init.c define this symbol for libio. Its GNU
+   build uses four-byte SHF_MERGE entries; Clang emits plain .rodata for
+   the externally visible C constant, even with -fmerge-all-constants. */
+        .section .rodata.cst4,"aM",%progbits,4
+        .p2align 2
+        .globl _IO_stdin_used
+        .type _IO_stdin_used,%object
+_IO_stdin_used:
+        .long 0x20001
+        .size _IO_stdin_used, .-_IO_stdin_used
+        .section .note.GNU-stack,"",%progbits

+def _stage_public_header_directories(public_headers, directories, repo_path, include_dirs):
+    include_prefixes = tuple([d.rstrip("/") + "/" for d in include_dirs if d and d != "."])
+    declared = set(public_headers)
+    covered = set()
+    roots = []
+    prefixes = []
+    for target in directories:
+        info = target[DirectoryInfo]
+        files = target[DefaultInfo].files.to_list()
+        if len(files) != 1 or not files[0].is_source or files[0].path != info.path:
+            fail("{} must provide one source directory at {}".format(target.label, info.path))
+        if not info.path.startswith(repo_path + "/"):
+            fail("{} must be inside {}".format(info.path, repo_path))
+        prefix = info.path + "/"
+        if not prefix.startswith(include_prefixes):
+            continue
+        members = info.transitive_files.to_list()
+        if not members or not all([f.is_source and f.path.startswith(prefix) for f in members]):
+            fail("{} must enumerate the source files under {}".format(target.label, info.path))
+        if not declared.issuperset(members):
+            # This configuration does not publish every file in the directory.
+            continue
+        if not covered.isdisjoint(members):
+            fail("overlapping source_header_directories at {}".format(info.path))
+        covered.update(members)
+        roots.append(files[0])
+        prefixes.append(prefix)
+    if not roots:
+        return public_headers
+    individual = [f for f in public_headers if f not in covered]
+    directory_prefixes = tuple(prefixes)
+    for f in individual:
+        if f.path.startswith(directory_prefixes):
+            fail("source_header_directories did not enumerate {}".format(f.path))
+    return individual + roots
+

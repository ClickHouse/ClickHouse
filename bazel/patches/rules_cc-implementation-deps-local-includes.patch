+def _check_private_textual_srcs(ctx):
+    if not ctx.files.private_textual_srcs:
+        return
+    other_files = {}
+    for name in ["srcs", "hdrs", "textual_hdrs", "private_hdrs", "additional_compiler_inputs"]:
+        for artifact in getattr(ctx.files, name):
+            other_files[artifact] = name
+    allowed = cc_helper.extensions.C_SOURCE + cc_helper.extensions.CC_SOURCE
+    seen = {}
+    for artifact in ctx.files.private_textual_srcs:
+        if artifact.is_directory or not artifact.is_source or "." + artifact.extension not in allowed:
+            fail("Artifact '{}' must be a source C/C++ file, not a header, data file or directory".format(artifact), attr = "private_textual_srcs")
+        owner = artifact.owner
+        if owner == None or owner.workspace_name != ctx.label.workspace_name or owner.package != ctx.label.package:
+            fail("Artifact '{}' must belong to the same Bazel package as '{}'".format(artifact, ctx.label), attr = "private_textual_srcs")
+        if artifact in other_files:
+            fail("Artifact '{}' is also declared in '{}'".format(artifact, other_files[artifact]), attr = "private_textual_srcs")
+        if artifact in seen:
+            fail("Artifact '{}' is declared twice".format(artifact), attr = "private_textual_srcs")
+        seen[artifact] = True
+

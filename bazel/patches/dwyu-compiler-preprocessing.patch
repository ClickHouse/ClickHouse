diff --git a/dwyu/cc/aspect/private/preprocessing/compiler.h b/dwyu/cc/aspect/private/preprocessing/compiler.h
new file mode 100644
--- /dev/null
+++ b/dwyu/cc/aspect/private/preprocessing/compiler.h
@@ -0,0 +1,134 @@
+#ifndef DWYU_CC_ASPECT_PRIVATE_PREPROCESSING_COMPILER_H
+#define DWYU_CC_ASPECT_PRIVATE_PREPROCESSING_COMPILER_H
+
+#include "dwyu/cc/private/utils.h"
+
+#include <nlohmann/json.hpp>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <sstream>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace dwyu {
+
+inline std::string execPath(const std::string& filename) {
+    namespace fs = std::filesystem;
+    auto file = fs::path{filename}.lexically_normal();
+    if (file.is_absolute()) file = file.lexically_relative(fs::current_path());
+    return file.generic_string();
+}
+
+inline bool isUnder(const std::string& filename, const std::string& directory) {
+    auto relative = std::filesystem::path{filename}.lexically_relative(directory);
+    return !relative.empty() && *relative.begin() != "..";
+}
+
+inline nlohmann::json extractCompilerIncludes(const std::string& compiler_output,
+                                               const std::string& source,
+                                               const std::vector<std::string>& include_paths,
+                                               const std::vector<std::string>& system_paths,
+                                               const std::vector<std::string>& toolchain_files,
+                                               const std::vector<std::string>& sysroots) {
+    std::ifstream input{compiler_output};
+    if (!input.is_open()) abortWithError("Cannot read Clang preprocessor output ", compiler_output);
+    const std::string own_file = execPath(source);
+    std::unordered_set<std::string> toolchain;
+    for (const auto& file : toolchain_files) toolchain.insert(execPath(file));
+    std::unordered_map<std::string, std::string> seen;
+    nlohmann::json includes = nlohmann::json::array();
+    std::string current_file;
+    std::string pending_file;
+    std::string pending_statement;
+    auto complete = [&](std::string resolved) {
+        if (pending_statement.empty()) return;
+        if (resolved.empty()) {
+            // Clang emits -dI even when it has seen a header guard. In that case there is
+            // no enter marker. Resolve against the same directories given to Clang.
+            std::string header = pending_statement.substr(1, pending_statement.size() - 2);
+            const bool quoted = pending_statement.front() == '"';
+            std::vector<std::string> candidates;
+            if (quoted) {
+                candidates.push_back(std::filesystem::path{pending_file}.parent_path().generic_string());
+                candidates.insert(candidates.end(), include_paths.begin(), include_paths.end());
+            }
+            candidates.insert(candidates.end(), system_paths.begin(), system_paths.end());
+            for (const auto& directory : candidates) {
+                auto candidate = std::filesystem::path{directory} / header;
+                if (std::filesystem::is_regular_file(candidate)) {
+                    resolved = execPath(candidate.generic_string());
+                    break;
+                }
+            }
+            // Compiler builtin search directories are intentionally not library include
+            // paths. Reuse a file actually entered by this Clang invocation only if it
+            // is an identified toolchain or sysroot header.
+            if (resolved.empty()) {
+                auto it = seen.find(pending_statement);
+                if (it != seen.end()) {
+                    bool from_toolchain = (toolchain.find(it->second) != toolchain.end());
+                    for (const auto& sysroot : sysroots)
+                        from_toolchain = from_toolchain || isUnder(it->second, execPath(sysroot));
+                    if (from_toolchain) resolved = it->second;
+                }
+            }
+        }
+        if (resolved.empty()) {
+            abortWithError("Clang resolved ", pending_statement, " in ", pending_file,
+                           " but DWYU cannot attribute the guarded header; inspect Clang's include dirs.");
+        }
+        resolved = execPath(resolved);
+        seen[pending_statement] = resolved;
+        if (pending_file == own_file) {
+            bool from_toolchain = (toolchain.find(resolved) != toolchain.end());
+            for (const auto& sysroot : sysroots)
+                from_toolchain = from_toolchain || isUnder(resolved, execPath(sysroot));
+            if (!from_toolchain)
+                includes.push_back({{"include", pending_statement}, {"file", resolved}});
+        }
+        pending_statement.clear();
+        pending_file.clear();
+    };
+    std::string line;
+    while (std::getline(input, line)) {
+        // Only -dI's active directives, not arbitrary #include-like text in source.
+        if (line.find("/* clang -E -dI */") != std::string::npos &&
+            (line.rfind("#include ", 0) == 0 || line.rfind("#include_next ", 0) == 0)) {
+            complete("");
+            const auto begin = line.find_first_of("<\\\"");
+            const auto end = line.find(begin == std::string::npos || line[begin] == '<' ? '>' : '"', begin + 1);
+            if (begin == std::string::npos || end == std::string::npos)
+                abortWithError("Unexpected Clang -dI directive: ", line);
+            pending_file = current_file;
+            pending_statement = line.substr(begin, end - begin + 1);
+            continue;
+        }
+        std::istringstream marker{line};
+        char hash;
+        unsigned number;
+        std::string filename;
+        if ((marker >> hash >> number >> std::quoted(filename)) && hash == '#') {
+            int flag;
+            bool entering = false;
+            bool returning = false;
+            while (marker >> flag) {
+                entering = entering || flag == 1;
+                returning = returning || flag == 2;
+            }
+            if (entering) complete(filename);
+            if (returning) complete("");
+            current_file = (filename.rfind("<", 0) == 0) ? filename : execPath(filename);
+        } else if (!line.empty()) {
+            complete("");
+        }
+    }
+    complete("");
+    return nlohmann::json::array({{{"file", source}, {"resolved_includes", std::move(includes)}}});
+}
+
+}  // namespace dwyu
+
+#endif

+    const auto file = input.at("symbols").get<std::string>();
+    std::ifstream stream{file};
+    if (!stream) abortWithError("Cannot read DWYU owned object symbols ", file);
+    std::string line;
+    while (std::getline(stream, line)) {
+        // llvm-nm -A -P: "<object>: <mangled-symbol> <type> [value] [size]".
+        const auto delimiter = line.find(": ");

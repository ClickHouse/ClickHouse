+def _symbol_route(dep, inventory, interned, objects, archives):
+    route = []
+    for linker_input in dep.cc_info.linking_context.linker_inputs.to_list():
+        libraries = []
+        for lib in _as_list(linker_input.libraries):
+            selected = lib.pic_objects or lib.objects or []
+            readable = [f for f in selected if not f.is_directory]
+            for file in readable:
+                objects[file.path] = file
+            archive = lib.pic_static_library or lib.static_library
+            if not selected and archive:
+                archives[archive.path] = archive
+            libraries.append(dict(
+                objects = [f.path for f in readable],
+                object_owners = {f.path: str(f.owner) for f in readable},
+                unchecked_objects = [f.path for f in selected if f.is_directory],
+                static = _link_library_path(lib.static_library),
+                pic_static = _link_library_path(lib.pic_static_library),
+                dynamic = _link_library_path(lib.dynamic_library),
+                interface = _link_library_path(lib.interface_library),
+                alwayslink = lib.alwayslink,
+            ))
+        record = dict(
+            owner = str(linker_input.owner),
+            libraries = libraries,
+            flags = _as_list(linker_input.user_link_flags),
+            inputs = [f.path for f in _as_list(linker_input.additional_inputs)],
+            linkstamps = [str(s) for s in _as_list(getattr(linker_input, "linkstamps", []))],
+        )
+
+        # File.path includes the Bazel configuration. The ordered library
+        # metadata distinguishes flags and stamp inputs with the same owner.
+        key = json.encode(record)
+        if key not in interned:
+            interned[key] = len(inventory)
+            inventory.append(record)
+        route.append(interned[key])
+    return dict(target = str(dep.label), records = route)

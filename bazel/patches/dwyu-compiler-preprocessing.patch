+        args = make_param_file_args(ctx)
+        args.add_all("--files", [item.output])
+        args.add("--mode", "compiler")
+        args.add("--source", item.source)
+        if item.included_header != None:
+            args.add("--included_header", item.included_header)
+        args.add("--compiler_headers", item.compiler_headers)
+        args.add("--consumer_root")
+        args.add("--compiler_command", json.encode(item.command))
+        args.add_all("--toolchain_files", item.toolchain_files, expand_directories = False)
+        args.add("--output", pub)
+        args.add("--private_output", priv)
+        args.add("--owned_headers", data.headers)
+        ctx.actions.run(
+            executable = ctx.executable._tool_preprocessing,
+            inputs = depset(direct = [item.output, item.compiler_headers, data.headers], transitive = [item.inputs]),
+            outputs = [pub, priv],
+            mnemonic = "DwyuProcessConsumerContext",
+            arguments = [args],
+        )
+        header_report = ctx.actions.declare_file(name + "_headers.json")
+        args = make_param_file_args(ctx)
+        args.add("--owned_headers", data.headers)
+        args.add("--output", header_report)
+        args.add("--target_under_inspection", str(dep.label))
+        args.add_all("--preprocessed_public_files", [pub], omit_if_empty = False)
+        args.add_all("--preprocessed_private_files", [priv], omit_if_empty = False)
+        args.add("--target_under_inspection_info", data.target)
+        args.add_all("--deps", data.deps, omit_if_empty = False)
+        args.add_all("--implementation_deps", data.implementation_deps, omit_if_empty = False)
+        args.add("--report_missing_direct_deps")
+        ctx.actions.run(
+            executable = ctx.executable._tool_analyze_includes,
+            inputs = depset(direct = [data.headers, data.target, pub, priv] + data.deps + data.implementation_deps),
+            outputs = [header_report],
+            mnemonic = "DwyuAnalyzeImportHeaders",
+            arguments = [args],
+        )
+        report = ctx.actions.declare_file(name + "_evidence.json")
+        args = ctx.actions.args()
+        args.add("--consumer", str(target.label))
+        args.add("--import", str(dep.label))
+        args.add("--source", item.source)
+        args.add("--preprocessed", item.output)
+        args.add("--compiler-headers", item.compiler_headers)
+        args.add("--import-headers", data.headers)
+        args.add("--header-report", header_report)
+        args.add("--symbols", symbols[0])
+        args.add("--output", report)
+        archives = []
+        for linker in dep[CcInfo].linking_context.linker_inputs.to_list():
+            if linker.owner == dep.label:

+bool readSymbolRecord(const std::string& line, OwnedSymbols& symbols) {
+    std::istringstream record{line};
+    std::string symbol, type, address, size, extra;
+    if (!(record >> symbol >> type >> address >> size) || type.size() != 1 || (record >> extra)) return false;
+    const auto hex = [](const std::string& value) {
+        return !value.empty() && value.find_first_not_of("0123456789abcdefABCDEF") == std::string::npos;
+    };
+    // LLVM IR does not give llvm-nm object addresses. LLVM prints 8 or 16
+    // dashes instead. Never split an unescaped ELF name at embedded whitespace.
+    const bool ir = (address.size() == 8 || address.size() == 16) && address.find_first_not_of('-') == std::string::npos;
+    if ((!hex(address) && !ir) || !hex(size)) return false;
+    if (type == "U") symbols.strong_undefined.insert(symbol);
+    else if (type == "w" || type == "v") symbols.weak_undefined.insert(symbol);
+    else if (type == "W" || type == "V" || type == "u" || type == "C")
+        symbols.weak_definitions.insert(symbol);
+    else if (std::string("ABDGRST").find(type[0]) != std::string::npos)
+        symbols.strong_definitions.insert(symbol);
+    else symbols.unsupported.insert(symbol);
+    return true;

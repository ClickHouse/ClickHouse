+def dwyu_scan_archive(ctx, archive, prefix):
+    """Read the symbols and archive signature from the same configured File."""
+    symbols = ctx.actions.declare_file(prefix + ".nm.txt")
+    status = ctx.actions.declare_file(prefix + ".status")
+    magic = ctx.actions.declare_file(prefix + ".magic")

+        if (!result.emplace(path, OwnedSymbols{}).second) abortWithError("Duplicate DWYU nm input: ", path);
+    const auto file = input.at("symbols").get<std::string>();
+    std::ifstream stream{file};
+    if (!stream) abortWithError("Cannot read DWYU owned object symbols ", file);
+    std::string line;
+    while (std::getline(stream, line)) {
+        // llvm-nm -A -P: "<object>: <mangled-symbol> <type> [value] [size]".
+        const auto delimiter = line.find(": ");
+        if (delimiter == std::string::npos) abortWithError("Invalid llvm-nm object record: ", line);
+        const auto path = line.substr(0, delimiter);
+        auto object = result.find(path);
+        if (object == result.end()) abortWithError("llvm-nm reported an unconfigured object: ", path);

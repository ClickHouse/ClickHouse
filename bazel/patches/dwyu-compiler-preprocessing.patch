+                    archive = lib.pic_static_library or lib.static_library
+                    if archive:
+                        archives.append(archive)
+        ctx.actions.run(
+            executable = ctx.executable._tool_import_evidence,
+            inputs = depset(direct = symbols + archives + [header_report, data.headers, item.output, item.compiler_headers]),
+            outputs = [report],
+            mnemonic = "DwyuRustImportEvidence",
+            arguments = [args],
+        )
+        reports.append(report)
+    return reports
+
+# These providers are dev audit data. They never change CcInfo or cc_library actions.
+DwyuOwnerGraphInfo = provider(fields = ["identity", "exported", "available"])
+DwyuCompilerContextInfo = provider(fields = [
+    "graph",
+    "headers",
+    "target",
+    "deps",
+    "implementation_deps",
+    "public",
+    "private",
+    "assemblies",
+    "link_inputs",
+    "captured",
+    "compiled_sources",
+    "kind",
+])
+
+def dwyu_owner_graph_impl(target, ctx):
+    identity = ctx.actions.declare_file("{}.dwyu_configured_owner".format(target.label.name))
+    ctx.actions.write(identity, str(target.label))
+    deps = [dep[DwyuOwnerGraphInfo].exported for dep in getattr(ctx.rule.attr, "deps", []) if DwyuOwnerGraphInfo in dep]
+    impl = [dep[DwyuOwnerGraphInfo].exported for dep in getattr(ctx.rule.attr, "implementation_deps", []) if DwyuOwnerGraphInfo in dep]
+    exported = depset(direct = [identity], transitive = deps)
+    return [DwyuOwnerGraphInfo(
+        identity = identity,
+        exported = exported,
+        available = depset(transitive = [exported] + impl),
+    )]
+
+def dwyu_compiler_context_impl(target, ctx):
+    if ctx.rule.kind not in ["cc_library", "cc_binary", "cc_test"]:
+        fail("{}: consumer audit requires native cc_library, cc_binary or cc_test, got {}".format(target.label, ctx.rule.kind))
+    cc_toolchain = find_cc_toolchain(ctx)
+    features = cc_common.configure_features(
+        ctx = ctx,
+        cc_toolchain = cc_toolchain,
+        requested_features = ctx.features,
+        unsupported_features = ctx.disabled_features,
+    )
+    config = struct(ignore_private_headers_from_deps = True, preprocessing_mode = "compiler")
+    public = [file for file in getattr(ctx.rule.files, "hdrs", []) if not _is_rules_cc_textual_header(file)]
+    srcs, link_inputs, raw_assembly = _compiler_srcs(target, getattr(ctx.rule.files, "srcs", []))
+    headers = _compiler_header_manifest(ctx, target, srcs, link_inputs, raw_assembly, prefix = "consumer_collect.")
+    target_file = _process_target(
+        ctx,
+        target = struct(label = target.label, cc_info = target[CcInfo]),
+        config = config,
+        output_path = "consumer_collect.{}.target.json".format(target.label.name),
+        is_target_under_inspection = True,
+    )
+    deps, implementation_deps = _preprocess_deps(ctx)
+    dep_files = [_process_target(
+        ctx,
+        target = dep,
+        config = config,
+        output_path = "consumer_collect.{}.dep_{}.json".format(target.label.name, _hash(str(dep.label))),
+        is_target_under_inspection = False,
+    ) for dep in deps]
+    impl_files = [_process_target(
+        ctx,
+        target = dep,
+        config = config,
+        output_path = "consumer_collect.{}.impl_{}.json".format(target.label.name, _hash(str(dep.label))),
+        is_target_under_inspection = False,
+    ) for dep in implementation_deps]
+    captured = []
+    pub_from_hdrs, priv_from_hdrs = _preprocess_with_compiler(
+        ctx,
+        target,
+        public,
+        cc_toolchain,
+        features,
+        "pub",
+        headers,
+        capture = captured,
+    )
+    pub_from_srcs, priv_from_srcs = _preprocess_with_compiler(
+        ctx,
+        target,
+        srcs,
+        cc_toolchain,
+        features,
+        "priv",
+        headers,
+        capture = captured,
+    )
+    return [DwyuCompilerContextInfo(
+        graph = target[DwyuOwnerGraphInfo],
+        headers = headers,
+        target = target_file,
+        deps = dep_files,
+        implementation_deps = impl_files,
+        public = pub_from_hdrs + pub_from_srcs,
+        private = priv_from_hdrs + [file for file in priv_from_srcs if file.extension != "o"],
+        assemblies = [file for file in priv_from_srcs if file.extension == "o"],
+        captured = captured,
+        compiled_sources = srcs,
+        link_inputs = link_inputs,
+        kind = ctx.rule.kind,
+    )]
+
+def dwyu_consumer_audit_impl(ctx):
+    owner = ctx.attr.owner
+    data = owner[DwyuCompilerContextInfo]
+    public = list(data.public)
+    private = list(data.private)
+    contexts = []
+    consumer_observations = []
+    if not ctx.attr.consumers:
+        fail("{}: consumer audit requires at least one actual configured consumer".format(ctx.label))
+    identities = {}
+    requested_sources = {path: True for path in ctx.attr.compiler_sources}
+    matched_sources = {}
+    if len(requested_sources) != len(ctx.attr.compiler_sources):
+        fail("{}: repeated compiler source".format(ctx.label))
+    for consumer in ctx.attr.consumers:
+        evidence = consumer[DwyuCompilerContextInfo]
+        identity = evidence.graph.identity
+        if identity in identities:
+            fail("{}: duplicate consumer {}".format(ctx.label, consumer.label))
+        identities[identity] = True
+        if identity == data.graph.identity:
+            fail("{}: owner {} cannot be its own consumer".format(ctx.label, owner.label))
+        if data.graph.identity not in evidence.graph.available.to_list():
+            fail("{}: consumer {} cannot use configured owner {}; the owner is not in the consumer's compilation dependencies".format(
+                ctx.label,
+                consumer.label,
+                owner.label,
+            ))
+        sources = []
+        compiler_files = {file: True for file in evidence.compiled_sources}
+        for index, item in enumerate(evidence.captured):
+            if requested_sources:
+                if item.source.short_path not in requested_sources:
+                    continue
+                if item.source not in compiler_files or item.source.short_path in matched_sources:
+                    fail("{}: compiler source {} is not unique or not compiled by {}".format(ctx.label, item.source.short_path, consumer.label))
+                matched_sources[item.source.short_path] = True
+            basename = "{}.consumer_{}_{}".format(ctx.label.name, _hash(str(identity)), index)
+            pub = ctx.actions.declare_file(basename + "_public.json")
+            priv = ctx.actions.declare_file(basename + "_private.json")
+            args = make_param_file_args(ctx)
+            args.add_all("--files", [item.output])
+            args.add("--mode", "compiler")
+            args.add("--source", item.source)
+            if item.included_header != None:
+                args.add("--included_header", item.included_header)
+            args.add("--compiler_headers", item.compiler_headers)
+            args.add("--consumer_root")
+            args.add("--compiler_command", json.encode(item.command))
+            args.add_all("--toolchain_files", item.toolchain_files, expand_directories = False)
+            args.add("--output", pub)
+            args.add("--private_output", priv)
+            args.add("--owned_headers", data.headers)
+            ctx.actions.run(
+                executable = ctx.executable._tool_preprocessing,
+                inputs = depset(direct = [item.output, item.compiler_headers, data.headers], transitive = [item.inputs]),
+                outputs = [pub, priv],
+                mnemonic = "DwyuProcessConsumerContext",
+                arguments = [args],
+            )
+            public.append(pub)
+            private.append(priv)
+            if requested_sources:
+                consumer_observations.extend([pub, priv])
+            sources.append({"source": item.source.path, "preprocessed": item.output.path})
+        if not sources:
+            fail("{}: consumer {} provides no C/C++/preprocessed assembly compilation roots".format(ctx.label, consumer.label))
+        contexts.append({"consumer": str(consumer.label), "configured_identity": identity.path, "sources": sources})
+    if requested_sources and requested_sources != matched_sources:
+        fail("{}: requested source is not a C/C++ translation unit of the original consumer: {}".format(ctx.label, [path for path in requested_sources if path not in matched_sources]))
+    provenance = ctx.actions.declare_file(ctx.label.name + ".consumer_evidence.json")
+    ctx.actions.write(provenance, json.encode({
+        "audit_target": str(ctx.label),
+        "owner": str(owner.label),
+        "configured_owner": data.graph.identity.path,
+        "consumers": contexts,
+    }))
+    report = ctx.actions.declare_file(ctx.label.name + "_dwyu_consumer_report.json")
+    args = make_param_file_args(ctx)
+    args.add("--owned_headers", data.headers)
+    args.add("--consumer_evidence", provenance)
+    args.add("--output", report)
+    args.add("--target_under_inspection", str(owner.label))
+    args.add_all("--preprocessed_public_files", public, omit_if_empty = False)
+    args.add_all("--preprocessed_private_files", private, omit_if_empty = False)
+    args.add("--target_under_inspection_info", data.target)
+    args.add_all("--deps", data.deps, omit_if_empty = False)
+    args.add_all("--implementation_deps", data.implementation_deps, omit_if_empty = False)
+    args.add("--report_missing_direct_deps")
+    if not data.link_inputs:
+        args.add("--report_unused_deps")
+        if data.kind == "cc_library":
+            args.add("--optimize_implementation_deps")
+    ctx.actions.run(
+        executable = ctx.executable._tool_analyze_includes,
+        inputs = depset(direct = [data.headers, data.target, provenance] + data.deps + data.implementation_deps + public + private + data.assemblies),
+        outputs = [report],
+        mnemonic = "DwyuAnalyzeOwnerWithConsumers",
+        arguments = [args],
+    )
+    return [DefaultInfo(files = depset([report])), OutputGroupInfo(dwyu_consumer = depset([report] + consumer_observations))]
+
+# Reuse real compiler preprocessing without synthesizing a cc_library.
+dwyu_process_compiler_command = _process_compiler_command
+dwyu_configured_header_aliases = _configured_header_aliases

+        const auto owner = private_headers.find(include.resolved_include);
+        if (owner != private_headers.end() && reached.insert(owner->second).second)
+            pending.push_back(owner->second);
+    };
+    for (const auto& include : public_includes) visit(include);
+    for (std::size_t i = 0; i < pending.size(); ++i) {
+        const auto file = private_by_file.find(pending[i]);
+        if (file != private_by_file.end())
+            for (const auto* include : file->second) visit(*include);
+    }
+    std::vector<IncludeStatement> still_private;
+    for (auto& include : private_includes) {
+        if (reached.find(include.file) != reached.end())
+            public_includes.push_back(std::move(include));
+        else
+            still_private.push_back(std::move(include));
+    }
+    private_includes = std::move(still_private);

index 0000000000000000000000000000000000000000..caf0c7a95f2148594fcf6a10abec3083346ab728
--- /dev/null
+++ b/dwyu/cc/aspect/private/preprocessing/compiler.h
@@ -0,0 +1,237 @@
+#ifndef DWYU_CC_ASPECT_PRIVATE_PREPROCESSING_COMPILER_H
+#define DWYU_CC_ASPECT_PRIVATE_PREPROCESSING_COMPILER_H
+
+#include "dwyu/cc/aspect/private/preprocessing/compiler_search.h"
+
+#include <nlohmann/json.hpp>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <sstream>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+namespace dwyu {
+
+struct CompilerIncludes {
+    nlohmann::json public_files;
+    nlohmann::json private_files;
+};
+
+inline CompilerIncludes extractCompilerIncludes(const std::string& compiler_output,
+                                                const std::string& source,
+                                                const std::string& owned_headers,
+                                                const std::string& compiler_headers,
+                                                const std::vector<std::string>& command,
+                                                const std::vector<std::string>& toolchain_files,
+                                                bool root_is_owned = true,
+                                                const std::string& included_header = {}) {
+    std::ifstream input{compiler_output};
+    if (!input.is_open()) abortWithError("Cannot read Clang preprocessor output ", compiler_output);
+    std::ifstream header_trace{compiler_headers};
+    if (!header_trace.is_open()) abortWithError("Cannot read Clang header output ", compiler_headers);
+    std::ifstream headers_input{owned_headers};
+    if (!headers_input.is_open()) abortWithError("Cannot read DWYU header manifest ", owned_headers);
+    const auto headers = nlohmann::json::parse(headers_input);
+    using AliasMap = std::unordered_map<std::string, std::string>;
+    const auto public_headers = headers.at("public").get<AliasMap>();
+    const auto private_headers = headers.at("private").get<AliasMap>();
+    const std::string own_file = execPath(source);
+    auto isOwned = [&](const std::string& file) {
+        if (file == own_file || (!included_header.empty() && file == included_header)) return root_is_owned;
+        return public_headers.find(file) != public_headers.end()
+            || private_headers.find(file) != private_headers.end();
+    };
+    auto original = [&](const std::string& file) {
+        const auto public_it = public_headers.find(file);
+        if (public_it != public_headers.end()) return public_it->second;
+        const auto private_it = private_headers.find(file);
+        if (private_it != private_headers.end()) return private_it->second;
+        return file;
+    };
+    const CompilerSearch search{command, toolchain_files};
+    nlohmann::json public_includes = nlohmann::json::object();
+    nlohmann::json private_includes = nlohmann::json::object();
+    std::unordered_set<std::string> entered_files;
+    // A modular hdrs action includes this header from stdin. Only a confirmed
+    // Clang entry can credit it, including when replaying a foreign consumer.
+    const bool wrapped = !included_header.empty();
+    if (wrapped && root_is_owned && (public_headers.find(included_header) == public_headers.end()
+                                    || public_headers.at(included_header) != own_file))
+        abortWithError("Requested header ", included_header, " is not a configured public header of ", source);
+    if (wrapped && !search.unsupportedFlag().empty())
+        abortWithError("Cannot verify public header ", source, " with Clang option ", search.unsupportedFlag());
+    std::string current_file = wrapped ? "<stdin>" : own_file;
+    bool current_public = !wrapped && public_headers.find(own_file) != public_headers.end();
+    bool saw_forced_header = false, saw_wrapper_header = false;
+    std::vector<std::pair<std::string, bool>> include_stack;
+    bool processed_predefines = false;
+    // HeaderIncludeGen::PrintHeaderInfo escapes, but does not surround, names.
+    // Consume in preprocessor order, including foreign files; never search ahead.
+    auto nextHeader = [&]() {
+        std::string record;
+        if (!std::getline(header_trace, record))
+            abortWithError("Missing Clang header record in ", compiler_headers, " while in ", current_file);
+        std::istringstream name{"\"" + record + "\""};
+        std::string filename;
+        if (!(name >> std::quoted(filename)) || (name >> std::ws && !name.eof()) || filename.empty())
+            abortWithError("Malformed Clang header record in ", compiler_headers, ": ", record);
+        return execPath(filename);
+    };
+    auto observations = [&](const std::string& file, bool is_public) -> nlohmann::json& {
+        auto& per_file = (is_public ? public_includes : private_includes)[original(file)];
+        if (per_file.is_null()) per_file = nlohmann::json::array();
+        return per_file;
+    };
+    // This file is an actual preprocessing root, even if also declared textual.
+    if (root_is_owned && !wrapped) {
+        observations(current_file, current_public);
+        entered_files.insert(original(current_file));
+    }
+    std::string pending_file;
+    std::string pending_statement;
+    bool pending_public = false;
+    bool pending_include_next = false;
+    auto complete = [&](std::string resolved) {
+        if (pending_statement.empty()) return;
+        const bool entered = !resolved.empty();
+        if (resolved.empty()) {
+            if (isOwned(pending_file) && pending_include_next)
+                abortWithError("Clang skipped guarded #include_next ", pending_statement, " in ", pending_file,
+                               "; DWYU cannot prove which directory supplied the next header.");
+            // HeaderIncludeGen suppresses skips at the initial source and
+            // built-in levels until the predefines have been processed.
+            if (processed_predefines || include_stack.size() + 1 > 2)
+                resolved = nextHeader();
+            else if (isOwned(pending_file))
+                abortWithError("Clang did not report guarded ", pending_statement, " in ", pending_file,
+                               " before the end of its predefines.");
+        }
+        if (wrapped && pending_file == "<stdin>" && processed_predefines && include_stack.empty()) {
+            const auto path = execPath(resolved);
+            if (path != included_header || (!entered && !saw_forced_header))
+                abortWithError("Clang did not enter requested public header ", source, " from stdin; resolved ", path);
+            saw_wrapper_header = true;
+        }
+        if (!isOwned(pending_file)) {
+            pending_statement.clear();
+            pending_file.clear();
+            return;
+        }
+        resolved = execPath(resolved);
+        if ((!root_is_owned || (resolved != own_file && resolved != included_header)) && !search.isToolchain(resolved)) {
+            auto include = nlohmann::json{{"include", pending_statement}, {"file", resolved}};
+            if (!search.unsupportedFlag().empty()) include["unsupported_search_flag"] = search.unsupportedFlag();
+            observations(pending_file, pending_public).push_back(std::move(include));
+        }
+        pending_statement.clear();
+        pending_file.clear();
+    };
+    std::string line;
+    while (std::getline(input, line)) {
+        // Only -dI's active directives, not arbitrary #include-like source text.
+        if (line.find("/* clang -E -dI */") != std::string::npos &&
+            (line.rfind("#include ", 0) == 0 || line.rfind("#include_next ", 0) == 0)) {
+            complete("");
+            const auto begin = line.find_first_of("<\"");
+            const auto end = line.find(begin == std::string::npos || line[begin] == '<' ? '>' : '"', begin + 1);
+            if (begin == std::string::npos || end == std::string::npos)
+                abortWithError("Unexpected Clang -dI directive: ", line);
+            pending_file = current_file;
+            pending_statement = line.substr(begin, end - begin + 1);
+            pending_public = current_public;
+            pending_include_next = line.rfind("#include_next ", 0) == 0;
+            continue;
+        }
+        std::istringstream marker{line};
+        char hash;
+        unsigned number;
+        std::string filename;
+        if ((marker >> hash >> number >> std::quoted(filename)) && hash == '#') {
+            int flag;
+            bool entering = false;
+            bool returning = false;
+            while (marker >> flag) {
+                entering = entering || flag == 1;
+                returning = returning || flag == 2;
+            }
+            if (entering) {
+                const auto next_file = filename.rfind("<", 0) == 0 ? filename : execPath(filename);
+                // The main file has no -dI enter flag and is depth one.
+                // Match HeaderIncludeGen::ShouldShowHeader/FileChanged on entry.
+                const bool has_record = (processed_predefines || include_stack.size() + 2 > 2) && filename != "<command line>";
+                if (has_record) {
+                    const auto reported = nextHeader();
+                    if (reported != execPath(filename))
+                        abortWithError("Clang header record ", reported, " does not match enter marker ",
+                                       filename, " in ", compiler_output);
+                }
+                if ((current_file == "<built-in>" || current_file == "<command line>") &&
+                    next_file.rfind("<", 0) != 0) {
+                    const auto statement = search.forcedStatement(next_file);
+                    if (!statement.empty()) {
+                        if (wrapped && has_record && next_file == included_header)
+                            saw_forced_header = true;
+                        pending_file = own_file;
+                        pending_statement = statement;
+                        pending_public = public_headers.find(own_file) != public_headers.end();
+                        pending_include_next = false;
+                    }
+                }
+                complete(filename);
+                if (!root_is_owned && !isOwned(current_file) &&
+                    private_headers.find(next_file) != private_headers.end())
+                    abortWithError("DWYU consumer ", source, " directly enters owner's private header ", next_file);
+                include_stack.emplace_back(current_file, current_public);
+                // Public use carries through only this owner's private headers.
+                // Do not carry it across a dependency's files.
+                current_public = public_headers.find(next_file) != public_headers.end()
+                    || (private_headers.find(next_file) != private_headers.end()
+                        && isOwned(current_file) && current_public);
+                current_file = next_file;
+                if (isOwned(next_file)) {
+                    observations(next_file, current_public);
+                    entered_files.insert(original(next_file));
+                }
+            }
+            if (returning) {
+                complete("");
+                if (include_stack.empty())
+                    abortWithError("Unbalanced Clang include return in ", compiler_output, ": ", line);
+                // The marker's filename can be the caller's #line name.
+                // Restore the caller's physical file and ownership together.
+                current_file = std::move(include_stack.back().first);
+                current_public = include_stack.back().second;
+                include_stack.pop_back();
+                if (include_stack.empty()) processed_predefines = true;
+            }
+            // A marker without enter/return flags only changes source line
+            // locations, as from #line. It never changes header ownership.
+        } else if (!line.empty()) {
+            complete("");
+        }
+    }
+    complete("");
+    if (wrapped && (!saw_wrapper_header || !include_stack.empty()))
+        abortWithError("No verified Clang include of requested public header ", source, " from stdin");
+    if (std::getline(header_trace, line))
+        abortWithError("Unexpected Clang header record after ", compiler_output, ": ", line);
+    if (!header_trace.eof())
+        abortWithError("Failed reading Clang header output ", compiler_headers);
+    auto records = [&](nlohmann::json& per_file) {
+        auto result = nlohmann::json::array();
+        for (auto it = per_file.begin(); it != per_file.end(); ++it)
+            result.push_back({{"file", it.key()},
+                              {"entered", entered_files.find(it.key()) != entered_files.end()},
+                              {"resolved_includes", std::move(it.value())}});
+        return result;
+    };
+    return {records(public_includes), records(private_includes)};
+}
+
+} // namespace dwyu
+
+#endif
diff --git a/dwyu/cc/aspect/private/preprocessing/compiler_search.h b/dwyu/cc/aspect/private/preprocessing/compiler_search.h
new file mode 100644
index 0000000000000000000000000000000000000000..53d73ec52808388c94bd01a1cd632a43026bcf25
--- /dev/null
+++ b/dwyu/cc/aspect/private/preprocessing/compiler_search.h
@@ -0,0 +1,205 @@
+#ifndef DWYU_CC_ASPECT_PRIVATE_PREPROCESSING_COMPILER_SEARCH_H
+#define DWYU_CC_ASPECT_PRIVATE_PREPROCESSING_COMPILER_SEARCH_H
+
+#include "dwyu/cc/private/utils.h"
+
+#include <algorithm>
+#include <filesystem>
+#include <string>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+namespace dwyu {
+
+inline std::string execPath(const std::string& filename) {
+    namespace fs = std::filesystem;
+    auto file = fs::path{filename}.lexically_normal();
+    if (file.is_absolute()) file = file.lexically_relative(fs::current_path());
+    return file.generic_string();
+}
+
+inline bool isUnder(const std::string& filename, const std::string& directory) {
+    auto relative = std::filesystem::path{filename}.lexically_relative(directory);
+    return !relative.empty() && *relative.begin() != "..";
+}
+
+// Clang keeps quote, angled, system and after directories in separate groups.
+// Only inputs declared by the selected toolchain identify toolchain files.
+class CompilerSearch {
+  public:
+    CompilerSearch(const std::vector<std::string>& command, const std::vector<std::string>& toolchain_files) {
+        namespace fs = std::filesystem;
+        for (const auto& file : toolchain_files) {
+            auto path = execPath(file);
+            if (fs::is_directory(path))
+                toolchain_directories_.push_back(std::move(path));
+            else
+                toolchain_files_.insert(std::move(path));
+        }
+        std::vector<std::string> args;
+        args.reserve(command.size());
+        // Forwarded cc1 search flags participate in the same order as driver
+        // flags. Keep -internal-isystem after user -isystem as Clang does.
+        for (size_t i = 0; i < command.size(); ++i) {
+            if (command[i] == "-Xclang") {
+                if (++i == command.size()) abortWithError("Incomplete -Xclang in DWYU compiler command");
+            }
+            args.push_back(command[i]);
+        }
+        std::vector<std::string> internal;
+        std::vector<std::string> after;
+        std::string resource_dir;
+        bool builtin_headers = true;
+        for (size_t i = 0; i < args.size(); ++i) {
+            const std::string opt = args[i];
+            std::string value;
+            if (readOption(args, i, "--sysroot", value, true) ||
+                readOption(args, i, "-isysroot", value, true)) {
+                // Clang uses the last sysroot, not every superseded command flag.
+                sysroot_ = execPath(value);
+            } else if (readOption(args, i, "-resource-dir", value, true)) {
+                resource_dir = value;
+            } else if (opt == "-nobuiltininc" || opt == "-nostdinc") {
+                builtin_headers = false;
+            } else if (opt == "-include") {
+                if (++i == args.size()) abortWithError("Incomplete Clang -include option");
+                forced_headers_.push_back(args[i]);
+            } else if (starts(opt, "-F") || starts(opt, "-iframework") || starts(opt, "-ivfsoverlay") ||
+                       starts(opt, "-iprefix") || starts(opt, "-iwith") || starts(opt, "-isystem-after") ||
+                       starts(opt, "-stdlib++-isystem") || starts(opt, "-cxx-isystem") ||
+                       starts(opt, "-fmodules") || opt == "-load" || starts(opt, "@") || opt == "-I-") {
+                // Do not guess at framework/header-map/VFS/module lookup.
+                unsupported_ = opt;
+            } else if (readOption(args, i, "-iquote", value, false)) {
+                quoted_.push_back(std::move(value));
+            } else if (readOption(args, i, "-internal-isystem", value, false) ||
+                       readOption(args, i, "-internal-externc-isystem", value, false)) {
+                internal.push_back(std::move(value));
+            } else if (readOption(args, i, "-isystem", value, false)) {
+                system_.push_back(std::move(value));
+            } else if (readOption(args, i, "-idirafter", value, false)) {
+                after.push_back(std::move(value));
+            } else if (readOption(args, i, "-I", value, false)) {
+                angled_.push_back(std::move(value));
+            }
+        }
+        system_.insert(system_.end(), internal.begin(), internal.end());
+        if (builtin_headers && !resource_dir.empty())
+            system_.push_back((fs::path{resource_dir} / "include").generic_string());
+        system_.insert(system_.end(), after.begin(), after.end());
+        prepare(quoted_);
+        prepare(angled_);
+        prepare(system_);
+        // InitHeaderSearch removes a duplicate -I when the directory is also
+        // -isystem, even if -I occurred earlier. Preserve the system position.
+        angled_.erase(std::remove_if(angled_.begin(), angled_.end(), [&](const auto& directory) {
+            return std::any_of(system_.begin(), system_.end(), [&](const auto& system) {
+                return fs::equivalent(directory, system);
+            });
+        }), angled_.end());
+        if (!sysroot_.empty() && !fs::is_directory(sysroot_)) sysroot_.clear();
+    }
+
+    bool isToolchain(const std::string& file) const {
+        if (toolchain_files_.find(file) != toolchain_files_.end()) return true;
+        if (!sysroot_.empty() && isUnder(file, sysroot_)) return true;
+        return std::any_of(toolchain_directories_.begin(), toolchain_directories_.end(),
+                           [&](const auto& directory) { return isUnder(file, directory); });
+    }
+
+    const std::string& unsupportedFlag() const { return unsupported_; }
+
+    std::string guardedHeader(const std::string& statement, const std::string& includer) const {
+        if (!unsupported_.empty())
+            abortWithError("DWYU cannot resolve guarded ", statement, " in ", includer,
+                           " with unsupported Clang search flag ", unsupported_);
+        namespace fs = std::filesystem;
+        const std::string header = statement.substr(1, statement.size() - 2);
+        auto find = [&](const std::string& directory) {
+            const auto candidate = fs::path{directory} / header;
+            return fs::is_regular_file(candidate) ? execPath(candidate.generic_string()) : std::string{};
+        };
+        if (statement.front() == '"') {
+            auto result = find(fs::path{includer}.parent_path().generic_string());
+            if (!result.empty()) return result;
+            for (const auto& directory : quoted_) {
+                result = find(directory);
+                if (!result.empty()) return result;
+            }
+        }
+        for (const auto& group : {&angled_, &system_}) {
+            for (const auto& directory : *group) {
+                auto result = find(directory);
+                if (!result.empty()) return result;
+            }
+        }
+        return {};
+    }
+
+    // Clang searches -include from its working directory, then the normal
+    // quoted include directories. A command flag alone does not prove entry.
+    std::string forcedStatement(const std::string& entered) const {
+        for (const auto& file : forced_headers_) {
+            const auto statement = '"' + file + '"';
+            if (execPath(file) == entered || guardedHeader(statement, "") == entered) return statement;
+        }
+        return {};
+    }
+
+  private:
+    static bool starts(const std::string& value, const std::string& prefix) {
+        return value.compare(0, prefix.size(), prefix) == 0;
+    }
+
+    static bool readOption(const std::vector<std::string>& args, size_t& i, const std::string& flag,
+                           std::string& value, bool equal_only) {
+        const auto& opt = args[i];
+        if (opt == flag) {
+            if (++i == args.size()) abortWithError("Incomplete Clang directory option ", flag);
+            value = args[i];
+            return true;
+        }
+        if (equal_only && starts(opt, flag + "=")) {
+            value = opt.substr(flag.size() + 1);
+            return true;
+        }
+        if (!equal_only && starts(opt, flag) && opt.size() > flag.size()) {
+            value = opt.substr(flag.size());
+            return true;
+        }
+        return false;
+    }
+
+    void prepare(std::vector<std::string>& directories) const {
+        namespace fs = std::filesystem;
+        std::vector<std::string> result;
+        for (const auto& raw : directories) {
+            std::string directory;
+            if (starts(raw, "="))
+                directory = (fs::path{sysroot_} / fs::path{raw.substr(1)}.relative_path()).generic_string();
+            else if (starts(raw, "$SYSROOT"))
+                directory = (fs::path{sysroot_} / fs::path{raw.substr(8)}.relative_path()).generic_string();
+            else
+                directory = raw;
+            directory = execPath(directory);
+            if (fs::is_directory(directory) && std::none_of(result.begin(), result.end(), [&](const auto& previous) {
+                return fs::equivalent(previous, directory);
+            })) result.push_back(std::move(directory));
+        }
+        directories = std::move(result);
+    }
+
+    std::vector<std::string> quoted_;
+    std::vector<std::string> angled_;
+    std::vector<std::string> system_;
+    std::vector<std::string> forced_headers_;
+    std::vector<std::string> toolchain_directories_;
+    std::unordered_set<std::string> toolchain_files_;
+    std::string sysroot_;
+    std::string unsupported_;
+};
+
+} // namespace dwyu
+
+#endif

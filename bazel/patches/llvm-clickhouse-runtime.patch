diff --git a/private/header_archive_patches.bzl b/private/header_archive_patches.bzl
new file mode 100644
index 0000000..3ff843e
--- /dev/null
+++ b/private/header_archive_patches.bzl
@@ -0,0 +1,23 @@
+"""Patches to the headers installed for one glibc or Linux release."""
+
+header_patch = tag_class(
+    attrs = {
+        "patches": attr.label_list(mandatory = True, doc = "Patches applied with -p1."),
+        "repository": attr.string(mandatory = True, doc = "The generated header archive to patch."),
+    },
+)
+
+def header_archive_patches(module_ctx):
+    """Collect the root module's patches by generated header archive."""
+    result = {}
+    for mod in module_ctx.modules:
+        for tag in mod.tags.patch:
+            if not mod.is_root:
+                fail("Only the root module can patch installed headers")
+            if tag.repository in result:
+                fail("Duplicate header archive: " + tag.repository)
+            result[tag.repository] = {
+                "patch_strip": 1,
+                "patches": tag.patches,
+            }
+    return result

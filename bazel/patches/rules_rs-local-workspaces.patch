+def _local_workspace_metadata(mctx, cargo_path, cargo_metadata, package_limit):
+    """Discover transitive local workspaces without resolving registry crates."""
+    pending = {}
+    discovered = {}
+    roots = {cargo_metadata["workspace_root"]: True}
+    for package in cargo_metadata["packages"]:
+        for dep in package["dependencies"]:
+            if dep.get("path"):
+                pending[dep["path"]] = True
+    for _ in range(package_limit):
+        if not pending:
+            break
+        path = pending.keys()[0]
+        pending.pop(path)
+        if path in discovered:
+            continue
+        result = mctx.execute([
+            cargo_path, "metadata", "--no-deps", "--format-version=1", "--quiet",
+            "--manifest-path", paths.join(path, "Cargo.toml"),
+        ])
+        if result.return_code:
+            fail(result.stdout + "\n" + result.stderr)
+        metadata = json.decode(result.stdout)
+        root = metadata["workspace_root"]
+        manifest = paths.join(root, "Cargo.toml")
+        mctx.watch(mctx.path(manifest))
+        if root in roots:
+            continue
+        roots[root] = True
+        for package in metadata["packages"]:
+            package_path = paths.dirname(package["manifest_path"])
+            mctx.watch(mctx.path(package["manifest_path"]))
+            discovered[package_path] = dict(package, workspace_manifest = manifest)
+            for dep in package["dependencies"]:
+                if dep.get("path") and dep["path"] not in discovered:
+                    pending[dep["path"]] = True
+    if pending:
+        fail("Local workspace discovery exceeded the number of locked packages")
+    return discovered
+

bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "rules_nodejs", version = "6.7.6")

clickstack_node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
clickstack_node.toolchain(node_version = "22.21.1")
use_repo(
    clickstack_node,
    "nodejs_darwin_amd64",
    "nodejs_darwin_arm64",
    "nodejs_linux_amd64",
    "nodejs_linux_arm64",
    "nodejs_toolchains",
)

register_toolchains("@nodejs_toolchains//:all")

clickstack_http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

clickstack_http_archive(
    name = "clickhouse_hyperdx_src",
    build_file = "//bazel/rules/clickstack:hyperdx.BUILD.bazel",
    patch_args = ["-p1"],
    patches = ["//bazel/rules/clickstack:hyperdx-release.patch"],
    sha256 = "9577ae79350c844ea8d83394966b1e26977fb9e856df3ea621bf2bc3be781755",
    strip_prefix = "hyperdx-bfa4b980f34c73dd88a138d509edb7aa32db2e6a",
    type = "tar.gz",
    urls = ["https://codeload.github.com/hyperdxio/hyperdx/tar.gz/bfa4b980f34c73dd88a138d509edb7aa32db2e6a"],
)

clickstack_http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")


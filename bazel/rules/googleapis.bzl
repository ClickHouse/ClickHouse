GOOGLE_API_SCHEMAS = GOOGLE_API_IMPORTS.keys()

GOOGLE_API_PROTO_ROOT = "gen/external/googleapis/src/googleapis_download"

def googleapis_archive_inputs(archive):
    """Return the genrule attributes for extracting the Google APIs schemas."""
    root = GOOGLE_API_PROTO_ROOT + "/"
    revision = archive.split("/")[-1].removesuffix(".tar.gz")
    tool = "//bazel/rules:extract_archive"
    return {
        "srcs": [archive],
        "outs": [root + schema for schema in GOOGLE_API_SCHEMAS],
        "tools": [tool],
        "cmd": "$(execpath %s) --archive=$(execpath %s) " % (tool, archive) +
               "--root=$(BINDIR)/bazel/%s --strip-prefix=googleapis-%s " % (root, revision) +
               " ".join(GOOGLE_API_SCHEMAS),
    }

"""Rules and tools used to build ClickHouse."""

load("@bazel_skylib//rules:common_settings.bzl", "string_list_flag")
load("@rules_python//python:py_binary.bzl", "py_binary")
load(":dwyu_tool.bzl", "dwyu_tool")

package(default_visibility = ["//visibility:public"])

string_list_flag(
    name = "dwyu_production_repositories",
    build_setting_default = [],
)

exports_files([
    "contrib_repositories.json",
    "license_manifest.json",
])

[
    py_binary(
        name = name,
        srcs = [name + ".py"],
        # Tool startup must not write bytecode caches into its input tree.
        interpreter_args = ["-B"],
        python_version = "3.11",
    )
    for name in [
        "prepare_hdfs_crc",
        "extract_archive",
        "generate_licenses",
        "embed_resources",
        "process_rust_archive",
        "cmake_cargo",
        "cbindgen",
        "generate_timezones",
    ]
]

[
    dwyu_tool(
        name = "dwyu_" + name,
        binary = "@depend_on_what_you_use//dwyu/cc/aspect/private/" + name + ":main",
    )
    for name in [
        "analyze_includes",
        "preprocessing",
        "process_target",
    ]
]

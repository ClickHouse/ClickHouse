package(default_visibility = ["//visibility:public"])

proto_toolchain(
    name = "clickhouse_proto",
    exec_compatible_with = ["@platforms//os:linux"],
    proto_compiler = "@clickhouse_google_protobuf//:protoc",
    target_compatible_with = ["@platforms//os:linux"],
)

proto_lang_toolchain(
    name = "clickhouse_cc_proto",
    command_line = "--cpp_out=$(OUT)",
    denylisted_protos = ["@clickhouse_google_protobuf//:libprotobuf_well_known_protos"],
    output_files = "multiple",
    runtime = "@clickhouse_google_protobuf//:_libprotobuf",
    target_compatible_with = ["@platforms//os:linux"],
    toolchain_type = "@protobuf//bazel/private:cc_toolchain_type",
)

proto_lang_toolchain(
    name = "clickhouse_grpc_proto",
    command_line = "--grpc_out=$(OUT)",
    output_files = "multiple",
    plugin = "@clickhouse_grpc//:grpc_cpp_plugin",
    plugin_format_flag = "--plugin=protoc-gen-grpc=%s",
)


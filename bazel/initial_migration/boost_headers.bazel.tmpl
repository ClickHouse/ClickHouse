_ASIO_COMPILER_OPTIONS = [
    "boost/asio/detail/pop_options.hpp",
    "boost/asio/detail/push_options.hpp",
]

# push_options.hpp and pop_options.hpp bracket each Asio reader's compiler
# pragmas. Their owner lets the NuRaft consumer audit check the pair together.
cc_library(
    name = "boost_asio_options",
    textual_hdrs = _ASIO_COMPILER_OPTIONS,
)

_BOOST_CONFIG_HEADERS = [
    "boost/config.hpp",
    "boost/config/compiler/clang.hpp",
    "boost/config/compiler/clang_version.hpp",
    "boost/config/detail/cxx_composite.hpp",
    "boost/config/detail/posix_features.hpp",
    "boost/config/detail/select_compiler_config.hpp",
    "boost/config/detail/select_platform_config.hpp",
    "boost/config/detail/select_stdlib_config.hpp",
    "boost/config/helper_macros.hpp",
    "boost/config/no_tr1/utility.hpp",
    "boost/config/platform/linux.hpp",
    "boost/config/pragma_message.hpp",
    "boost/config/stdlib/libcpp.hpp",
    "boost/config/user.hpp",
]

_BOOST_CONFIG_PRIVATE_HEADERS = [
    "boost/config/detail/suffix.hpp",
]

_BOOST_CONFIG_ABI = [
    "boost/config/abi_prefix.hpp",
    "boost/config/abi_suffix.hpp",
]

# detail/suffix.hpp is included only by config.hpp. The ABI headers are a
# public pair; the Boost.Iostreams consumer audit verifies both in context.
cc_library(
    name = "boost_config",
    srcs = _BOOST_CONFIG_PRIVATE_HEADERS,
    hdrs = _BOOST_CONFIG_HEADERS,
    features = ["external_include_paths"],
    includes = ["."],
    textual_hdrs = _BOOST_CONFIG_ABI,
)

cc_library(
    name = "pfr",
    srcs = glob(["boost/pfr/detail/*.hpp"]),
    hdrs = ["boost/pfr.hpp"] + glob(["boost/pfr/*.hpp"]),
    features = ["external_include_paths"],
    includes = ["."],
)

# function2.hpp, function3.hpp and function4.hpp set args for function_n.hpp.
# The Fusion fold wrappers choose detail/fold.hpp or their preprocessed expansion.
# result_of.hpp includes the variadic implementation or repeats result_of_iterate.hpp with BOOST_PP_ITERATE.
# FunctionTypes sets BOOST_FT_al_path before including its arity loops.
# MultiIndex pairs define_if_constexpr_macro.hpp with undef_if_constexpr_macro.hpp.
# Boost.MPL wrappers define AUX778076_OP_NAME or BOOST_MPL_PREPROCESSED_HEADER for each inclusion.
# BOOST_PP_ITERATE and BOOST_PP_ASSIGN_SLOT repeatedly include their detail headers.
_BOOST_MACRO_FRAGMENTS = glob([
    "boost/function_types/detail/components_impl/arity10_*.hpp",
    "boost/function_types/detail/components_impl/arity20_*.hpp",
    "boost/function_types/detail/encoding/*.hpp",
    "boost/function_types/detail/pp_*/preprocessed.hpp",
    "boost/function_types/detail/pp_*loop.hpp",
    "boost/function_types/detail/synthesize_impl/arity10_*.hpp",
    "boost/function_types/detail/synthesize_impl/arity20_*.hpp",
    "boost/fusion/algorithm/iteration/detail/preprocessed/*fold.hpp",
    "boost/mpl/**/aux_/include_preprocessed.hpp",
    "boost/multi_index/detail/*_if_constexpr_macro.hpp",
    "boost/preprocessor/iteration/detail/**/*.hpp",
    "boost/preprocessor/slot/detail/slot*.hpp",
]) + [
    "boost/accumulators/numeric/detail/function_n.hpp",
    "boost/function_types/detail/components_impl/master.hpp",
    "boost/function_types/detail/pp_cc_loop/master.hpp",
    "boost/function_types/detail/pp_retag_default_cc/master.hpp",
    "boost/function_types/detail/pp_tags/cc_tag.hpp",
    "boost/function_types/detail/synthesize_impl/master.hpp",
    "boost/fusion/algorithm/iteration/detail/fold.hpp",
    "boost/mpl/aux_/arithmetic_op.hpp",
    "boost/mpl/aux_/comparison_op.hpp",
    "boost/mpl/aux_/shift_op.hpp",
    "boost/preprocessor/slot/detail/counter.hpp",
    "boost/preprocessor/slot/detail/shared.hpp",
    "boost/utility/detail/result_of_iterate.hpp",
    "boost/utility/detail/result_of_variadic.hpp",
]

# Boost includes these implementation headers in exactly one translation unit
# when BOOST_ASIO_SEPARATE_COMPILATION or BOOST_MYSQL_SEPARATE_COMPILATION is set.
_ASIO_SEPARATE_COMPILATION = ["boost/asio/impl/src.hpp"]

_OPENSSL_SEPARATE_COMPILATION = [
    "boost/asio/ssl/impl/src.hpp",
    "boost/mysql/src.hpp",
]

# Boost.MySQL and Boost.Redis require OpenSSL; Asio, Beast, Cobalt and MQTT5
# also publish TLS APIs. Their other APIs stay available without OpenSSL.
_OPENSSL_HEADERS = glob(
    [
        "boost/asio/ssl/**/*.hpp",
        "boost/beast/ssl/**/*.hpp",
        "boost/mysql/**/*.hpp",
        "boost/redis/**/*.hpp",
    ],
    exclude = _OPENSSL_SEPARATE_COMPILATION,
) + [
    "boost/asio/ssl.hpp",
    "boost/beast/ssl.hpp",
    "boost/beast/websocket/ssl.hpp",
    "boost/cobalt/io/ssl.hpp",
    "boost/mqtt5/ssl.hpp",
    "boost/mqtt5/websocket_ssl.hpp",
    "boost/mysql.hpp",
    "boost/redis.hpp",
]

# These definitions are included by the public headers and upstream's
# separate-compilation entry points.
_OPENSSL_IMPLEMENTATIONS = glob([
    "boost/asio/ssl/**/*.ipp",
    "boost/mysql/**/*.ipp",
    "boost/redis/**/*.ipp",
]) + ["boost/beast/websocket/impl/ssl.hpp"]

_ASIO_IMPLEMENTATIONS = glob(
    ["boost/asio/**/*.ipp"],
    exclude = ["boost/asio/ssl/**/*.ipp"],
)

# config.hpp and the nested WinAPI helpers are portable. The remaining top-level
# WinAPI headers include basic_types.hpp, which rejects Linux.
_WINAPI_HEADERS = glob(
    [
        "boost/detail/winapi/*.hpp",
        "boost/winapi/*.hpp",
    ],
    exclude = [
        "boost/detail/winapi/config.hpp",
        "boost/winapi/config.hpp",
    ],
)

# The public Boost.Process wrappers select their Windows implementation after
# including the platform configuration. Keep the v1 helpers that preprocess
# without the Windows SDK, including async_handler.hpp's fallback includes.
_WINDOWS_PROCESS_HEADERS = glob(
    [
        "boost/process/**/windows/*.hpp",
        "boost/process/v1/windows.hpp",
    ],
    exclude = [
        "boost/process/v1/detail/windows/asio_fwd.hpp",
        "boost/process/v1/detail/windows/async_handler.hpp",
        "boost/process/v1/detail/windows/basic_cmd.hpp",
        "boost/process/v1/detail/windows/cmd.hpp",
        "boost/process/v1/detail/windows/handler.hpp",
        "boost/process/v1/detail/windows/on_exit.hpp",
        "boost/process/v1/detail/windows/start_dir.hpp",
    ],
)

# Boost.Config selects these four platform implementations outside Linux.
# The Interprocess and Thread wrappers choose Windows implementations from Win32
# macros. mfc_thread_init.hpp can also be included without MFC.
_NON_LINUX_HEADERS = glob(
    [
        "boost/interprocess/*windows_shared_memory.hpp",
        "boost/interprocess/detail/win32_api.hpp",
        "boost/interprocess/detail/windows_intermodule_singleton.hpp",
        "boost/interprocess/sync/windows/*.hpp",
        "boost/thread/win32/*.hpp",
    ],
    exclude = ["boost/thread/win32/mfc_thread_init.hpp"],
) + [
    "boost/config/platform/bsd.hpp",
    "boost/config/platform/cygwin.hpp",
    "boost/config/platform/symbian.hpp",
    "boost/config/platform/vxworks.hpp",
]

cc_library(
    name = "boost_headers_no_openssl",
    srcs = _ASIO_IMPLEMENTATIONS,
    hdrs = glob(
        [
            "boost/**/*.h",
            "boost/**/*.hpp",
            "boost/**/*.ipp",
        ],
        exclude = _ASIO_COMPILER_OPTIONS + _BOOST_CONFIG_HEADERS + _BOOST_CONFIG_PRIVATE_HEADERS + _BOOST_CONFIG_ABI + _BOOST_MACRO_FRAGMENTS + _ASIO_IMPLEMENTATIONS + _ASIO_SEPARATE_COMPILATION + _OPENSSL_HEADERS + _OPENSSL_IMPLEMENTATIONS + _OPENSSL_SEPARATE_COMPILATION + _WINAPI_HEADERS + _WINDOWS_PROCESS_HEADERS + _NON_LINUX_HEADERS + [
            "boost/compute.hpp",
            "boost/compute/**",
            # preprocess_encoding.cpp uses these Boost.Wave templates to generate preprocessed.hpp.
            "boost/function_types/detail/pp_tags/master.hpp",
            "boost/function_types/detail/pp_variate_loop/master.hpp",
            # ClickHouse enables no Boost.Python, MPI, GIL image codecs, or OdeInt external backends.
            "boost/python.hpp",
            "boost/python/**",
            "boost/parameter/python*",
            "boost/mpi.hpp",
            "boost/mpi/**",
            "boost/graph/accounting.hpp",
            "boost/graph/distributed/**",
            "boost/graph/parallel/**",
            "boost/graph/use_mpi.hpp",
            "boost/property_map/parallel/**",
            "boost/gil/extension/io/jpeg*",
            "boost/gil/extension/io/jpeg/**",
            "boost/gil/extension/io/png*",
            "boost/gil/extension/io/png/**",
            "boost/gil/extension/io/tiff*",
            "boost/gil/extension/io/tiff/**",
            "boost/gil/extension/io/raw*",
            "boost/gil/extension/io/raw/**",
            "boost/numeric/odeint/external/**",
            "boost/numeric/ublas/opencl.hpp",
            "boost/numeric/ublas/opencl/**",
            # Boost.Parser includes this Win32 implementation only under _MSC_VER.
            "boost/parser/detail/vs_output_stream.hpp",
            # Boost.URL rejects this discontinued single-translation-unit entry point.
            "boost/url/src.hpp",
            "boost/program_options/detail/config_file.hpp",
            "boost/pfr.hpp",
            "boost/pfr/**",
        ],
    ) + select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": _WINAPI_HEADERS + _WINDOWS_PROCESS_HEADERS + _NON_LINUX_HEADERS + ["boost/parser/detail/vs_output_stream.hpp"],
        "//conditions:default": _WINAPI_HEADERS + _NON_LINUX_HEADERS,
    }),
    features = ["external_include_paths"],
    textual_hdrs = glob(["boost/**/*.inc"]) + _BOOST_MACRO_FRAGMENTS + _ASIO_SEPARATE_COMPILATION,
    deps = [
        ":boost_asio_options",
        ":boost_config",
    ],
)

cc_library(
    name = "boost_headers",
    srcs = _OPENSSL_IMPLEMENTATIONS,
    hdrs = _OPENSSL_HEADERS,
    includes = ["boost"],
    textual_hdrs = _OPENSSL_SEPARATE_COMPILATION,
    deps = [
        ":boost_asio_options",
        ":boost_config",
        ":boost_headers_no_openssl",
        ":pfr",
        "@clickhouse_openssl//:crypto",
        "@clickhouse_openssl//:ssl",
    ],
)


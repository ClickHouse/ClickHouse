load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:private"])

[
    ch_cc_library(
        name = mode + "_" + header.replace(".", "_"),
        srcs = ["public_header.cc"],
        copts = [
            "-std=" + standard,
            "-DMIGRATION_PUBLIC_HEADER=<" + header + ">",
        ] + flags,
    )
    for mode, standard, flags in [
        ("cxx23", "c++23", []),
        ("cxx03_default", "c++03", []),
        (
            "cxx03_frozen",
            "c++03",
            ["-D_LIBCPP_USE_FROZEN_CXX03_HEADERS"],
        ),
    ]
    for header in [
        "vector",
        "cstddef",
        "wchar.h",
        "algorithm",
        "string",
    ]
]

ch_cc_library(
    name = "provider_a",
    srcs = ["provider.cc"],
    copts = [
        "-std=c++23",
        "-DMIGRATION_PREFIX=a",
    ],
    link_runtime = True,
)

ch_cc_library(
    name = "provider_b_cxx23",
    srcs = ["provider.cc"],
    copts = [
        "-std=c++23",
        "-DMIGRATION_PREFIX=b",
    ],
)

ch_cc_library(
    name = "provider_b_frozen",
    srcs = ["provider.cc"],
    copts = [
        "-std=c++03",
        "-DMIGRATION_PREFIX=b",
        "-D_LIBCPP_USE_FROZEN_CXX03_HEADERS",
    ],
)

ch_cc_library(
    name = "provider_b_wrong_abi",
    srcs = ["provider.cc"],
    copts = [
        "-std=c++23",
        "-DMIGRATION_PREFIX=b",
        "-DMIGRATION_WRONG_ABI",
    ],
)

cc_test(
    name = "cxx23_exception_control",
    srcs = ["exception_test.cc"],
    copts = ["-std=c++23"],
    linkstatic = True,
    deps = [
        ":provider_a",
        ":provider_b_cxx23",
    ],
)

cc_test(
    name = "mixed_exception_abi",
    srcs = ["exception_test.cc"],
    copts = ["-std=c++23"],
    linkstatic = True,
    deps = [
        ":provider_a",
        ":provider_b_frozen",
    ],
)

# The same test must reject an intentionally incompatible exception layout.
# Its expected nonzero exit is inspected by the migration script, not hidden
# with a cc_test attribute or treated as a successful runtime test.
cc_test(
    name = "negative_wrong_exception_abi",
    srcs = ["exception_test.cc"],
    copts = ["-std=c++23"],
    linkstatic = True,
    tags = ["manual"],
    deps = [
        ":provider_a",
        ":provider_b_wrong_abi",
    ],
)

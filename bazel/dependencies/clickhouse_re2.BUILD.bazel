load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel:repository_paths.bzl", "repository_path")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_re2",
    srcs = (glob(["re2/*.cc"]) + [
        "util/rune.cc",
        "util/strutil.cc",
    ]),
    hdrs = (glob(["**/*.h"])),
    copts = ["-w", "-std=c++23", "-I", repository_path("contrib/re2")],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = ["@clickhouse_abseil_cpp//:absl_flags_internal", "@clickhouse_abseil_cpp//:absl_flags_reflection", "@clickhouse_abseil_cpp//:absl_log_internal_check_op", "@clickhouse_abseil_cpp//:absl_log_internal_conditions"],
    alwayslink = False,
)

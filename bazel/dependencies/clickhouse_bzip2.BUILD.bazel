load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["external_include_paths"],
)

exports_files([
    "COPYING",
])

expand_template(
    name = "configure_x86_64_3ed97a267ca30f19",
    out = "config/x86_64/contrib/bzip2/bz_version.h",
    substitutions = {
        "@BZ_VERSION@": "1.0.7",
    },
    template = ":bz_version.h.in",
)

expand_template(
    name = "configure_aarch64_3ed97a267ca30f19",
    out = "config/aarch64/contrib/bzip2/bz_version.h",
    substitutions = {
        "@BZ_VERSION@": "1.0.7",
    },
    template = ":bz_version.h.in",
)

ch_cc_library(
    name = "_bzip2",
    srcs = [
        "blocksort.c",
        "huffman.c",
        "crctable.c",
        "randtable.c",
        "compress.c",
        "decompress.c",
        "bzlib.c",
    ],
    hdrs = select({
        "@platforms//cpu:x86_64": [":config/x86_64/contrib/bzip2/bz_version.h"] + glob(["**/*.h"]),
        "@platforms//cpu:aarch64": [":config/aarch64/contrib/bzip2/bz_version.h"] + glob(["**/*.h"]),
    }),
    additional_compiler_inputs = ["@clickhouse_llvm_project//:runtime_source_inputs", "@clickhouse_llvm_project//:runtime_generated_headers"],
    copts = [
        "-w",
        "-std=gnu11",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    includes = [
        ".",
    ] + select({
        "@platforms//cpu:x86_64": [
            "config/x86_64/contrib/bzip2",
        ],
        "@platforms//cpu:aarch64": [
            "config/aarch64/contrib/bzip2",
        ],
    }),
    language = "C",
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = ["@clickhouse//:clang_rt_builtins"],
    alwayslink = False,
)

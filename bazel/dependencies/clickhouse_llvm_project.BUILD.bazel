load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:llvm_runtime.bzl", "llvm_runtime_objects")
load("@clickhouse//bazel/rules:repository_paths.bzl", "cmake_prefix_maps")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "llvm_tablegen_inputs",
    srcs = glob([
        "llvm/include/**/*.td",
        "llvm/lib/Target/**/*.td",
    ]),
)

_COMPILER_RT_PUBLIC_HEADERS = glob([
    "compiler-rt/include/**/*.h",
    "compiler-rt/include/**/*.inc",
])

_LIBCXX_PUBLIC_HEADERS = [
    header
    for header in glob(["libcxx/include/**"])
    if "." not in header.rsplit("/", 1)[-1]
] + glob(["libcxx/include/**/*.h"]) + [
    ":configure_libcxx_include_c_v1___assertion_handler",
    ":configure_libcxx_include_c_v1___config_site",
]

_LIBCXXABI_PUBLIC_HEADERS = glob(["libcxxabi/include/**/*.h"])

_LIBUNWIND_PUBLIC_HEADERS = glob(["libunwind/include/**/*.h"])

_BUILTINS_HEADERS = _COMPILER_RT_PUBLIC_HEADERS + glob([
    "compiler-rt/lib/builtins/**/*.h",
    "compiler-rt/lib/builtins/**/*.inc",
])

_XRAY_HEADERS = _COMPILER_RT_PUBLIC_HEADERS + _LIBCXXABI_PUBLIC_HEADERS + _LIBUNWIND_PUBLIC_HEADERS + glob([
    "compiler-rt/lib/xray/**/*.h",
    "compiler-rt/lib/xray/**/*.inc",
    "compiler-rt/lib/sanitizer_common/**/*.h",
    "compiler-rt/lib/sanitizer_common/**/*.inc",
    "compiler-rt/lib/interception/**/*.h",
    "third-party/siphash/include/**/*.h",
])

_LIBCXX_SRC_HEADERS = glob([
    "libcxx/src/**/*.h",
    "libcxx/src/**/*.ipp",
])

_LIBCXX_HEADERS = _LIBCXX_PUBLIC_HEADERS + _LIBCXX_SRC_HEADERS + _LIBCXXABI_PUBLIC_HEADERS + _LIBUNWIND_PUBLIC_HEADERS + _COMPILER_RT_PUBLIC_HEADERS

_LIBCXXABI_HEADERS = _LIBCXX_HEADERS + glob([
    "libcxxabi/src/**/*.h",
    "libcxxabi/src/**/*.inc",
    "libcxxabi/src/**/*.def",
])

_LLVM_LIBC_SOURCE_HEADERS = glob([
    "libc/include/**/*.h",
    "libc/include/**/*.def",
    "libc/hdr/**/*.h",
    "libc/src/**/*.h",
    "libc/src/**/*.inc",
    "libc/shared/**/*.h",
])

_LLVM_LIBC_HEADERS = _LIBCXX_PUBLIC_HEADERS + _LIBCXXABI_PUBLIC_HEADERS + _LIBUNWIND_PUBLIC_HEADERS + _COMPILER_RT_PUBLIC_HEADERS + _LLVM_LIBC_SOURCE_HEADERS + select({
    "@platforms//cpu:x86_64": ["@clickhouse//contrib/libllvmlibc-cmake:string/x86_cpu_dispatch.h"],
    "@platforms//cpu:aarch64": [],
})

_LIBUNWIND_HEADERS = _LIBUNWIND_PUBLIC_HEADERS + _COMPILER_RT_PUBLIC_HEADERS + glob([
    "libunwind/src/**/*.h",
    "libunwind/src/**/*.hpp",
])

copy_file(
    name = "configure_libcxx_include_c_v1___assertion_handler",
    src = ":libcxx/include/__assertion_handler",
    out = "gen/libcxx/include/c++/v1/__assertion_handler",
)

copy_file(
    name = "configure_libcxx_include_c_v1___config_site",
    src = ":libcxx/include/__config_site",
    out = "gen/libcxx/include/c++/v1/__config_site",
)

cc_library(
    name = "libcxx_config_headers",
    hdrs = [
        ":configure_libcxx_include_c_v1___assertion_handler",
        ":configure_libcxx_include_c_v1___config_site",
    ],
    includes = ["gen/libcxx/include/c++/v1"],
)

expand_template(
    name = "configure_llvm_include_llvm_Config_llvm_config_h",
    out = "gen/llvm/include/llvm/Config/llvm-config.h",
    substitutions = select({
        "@platforms//cpu:x86_64": {
            "@LLVM_HOST_TRIPLE@": "x86_64-unknown-linux-gnu",
            "@LLVM_TARGET_ARCH@": "X86",
        },
        "@platforms//cpu:aarch64": {
            "@LLVM_HOST_TRIPLE@": "aarch64-unknown-linux-gnu",
            "@LLVM_TARGET_ARCH@": "AArch64",
        },
    }),
    template = "@clickhouse//contrib:llvm-project-cmake/config/llvm-config.h.in",
)

expand_template(
    name = "configure_llvm_include_llvm_Config_config_h",
    out = "gen/llvm/include/llvm/Config/config.h",
    substitutions = {
        "@HAVE_BACKTRACE_DEFINE@": "#define HAVE_BACKTRACE 1",
        "@BACKTRACE_HEADER_DEFINE@": "#define BACKTRACE_HEADER <execinfo.h>",
        "@HAVE_DECL_ARC4RANDOM_DECL_DEFINE@": "#define HAVE_DECL_ARC4RANDOM 0",
        "@HAVE_MACH_MACH_H_DEFINE@": "/* #undef HAVE_MACH_MACH_H */",
        "@HAVE_MALLINFO_DEFINE@": "#define HAVE_MALLINFO 1",
        "@HAVE_MALLOC_MALLOC_H_DEFINE@": "/* #undef HAVE_MALLOC_MALLOC_H */",
        "@HAVE_MALLOC_ZONE_STATISTICS_DEFINE@": "/* #undef HAVE_MALLOC_ZONE_STATISTICS */",
        "@HAVE_STRUCT_STAT_ST_MTIMESPEC_TV_NSEC_DEFINE@": "/* #undef HAVE_STRUCT_STAT_ST_MTIMESPEC_TV_NSEC */",
        "@HAVE_STRUCT_STAT_ST_MTIM_TV_NSEC_DEFINE@": "#define HAVE_STRUCT_STAT_ST_MTIM_TV_NSEC 1",
        "@LLVM_SHLIB_EXT@": ".so",
        "@HAVE_BUILTIN_THREAD_POINTER_DEFINE@": "#define HAVE_BUILTIN_THREAD_POINTER 1",
        "@HAVE_GETAUXVAL_DEFINE@": "#define HAVE_GETAUXVAL 1",
        "@HAVE_DECL_ARC4RANDOM_DEFINE@": "/* #undef HAVE_DECL_ARC4RANDOM */",
    },
    template = "@clickhouse//contrib:llvm-project-cmake/config/config.h.in",
)

expand_template(
    name = "configure_llvm_include_llvm_Config_abi_breaking_h",
    out = "gen/llvm/include/llvm/Config/abi-breaking.h",
    substitutions = {},
    template = "@clickhouse//contrib:llvm-project-cmake/config/abi-breaking.h.in",

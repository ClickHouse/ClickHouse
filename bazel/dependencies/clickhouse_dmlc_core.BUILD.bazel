load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "repository_local_include", "repository_path")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
    "cmake/build_config.h.in",
])

ch_cc_library(
    name = "_dmlc_core",
    srcs = [
        "src/data.cc",
        "src/io.cc",
        "src/recordio.cc",
        "src/io/recordio_split.cc",
        "src/io/local_filesys.cc",
        "src/io/input_split_base.cc",
        "src/io/indexed_recordio_split.cc",
        "src/io/line_split.cc",
        "src/io/filesys.cc",
        "src/config.cc",
        "src/data/basic_row_iter.h",
        "src/data/csv_parser.h",
        "src/data/disk_row_iter.h",
        "src/data/libfm_parser.h",
        "src/data/libsvm_parser.h",
        "src/data/parquet_parser.h",
        "src/data/parser.h",
        "src/data/row_block.h",
        "src/data/text_parser.h",
        "src/io/azure_filesys.h",
        "src/io/cached_input_split.h",
        "src/io/hdfs_filesys.h",
        "src/io/indexed_recordio_split.h",
        "src/io/input_split_base.h",
        "src/io/line_split.h",
        "src/io/local_filesys.h",
        "src/io/recordio_split.h",
        "src/io/s3_filesys.h",
        "src/io/single_file_split.h",
        "src/io/single_threaded_input_split.h",
        "src/io/threaded_input_split.h",
        "src/io/uri_spec.h",
    ],
    hdrs = ([
        "@clickhouse_xgboost//:config/contrib/xgboost/dmlc-core/dmlc/build_config.h",
    ] + glob(["include/dmlc/*.h"])),
    additional_compiler_inputs = [
        "src/data.cc",
        "src/io.cc",
        "src/recordio.cc",
        "src/io/recordio_split.cc",
        "src/io/local_filesys.cc",
        "src/io/input_split_base.cc",
        "src/io/indexed_recordio_split.cc",
        "src/io/line_split.cc",
        "src/io/filesys.cc",
        "src/config.cc",
    ],
    copts = ([
        "-w",
        "-std=c++23",
        "-Wall",
        "-Wno-unknown-pragmas",
    ] + select({
        "@platforms//cpu:x86_64": [
            "-msse2",
        ],
        "@platforms//cpu:aarch64": [],
    }) + []),
    includes = [
        "include",
    ],
    local_defines = [
        "DMLC_CORE_USE_CMAKE",
        "DMLC_USE_CXX11=1",
        "DMLC_USE_CXX14=1",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_DARWIN_C_SOURCE",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
        "_POSIX_C_SOURCE=200809L",
        "_POSIX_SOURCE",
        "_XOPEN_SOURCE=700",
        "__USE_XOPEN2K8",
    ],
    local_includes = [
        "include",
    ] + [
        repository_local_include(
            repository_path("contrib/xgboost") + "/config/contrib/xgboost/dmlc-core",
            "contrib/dmlc-core",
        ),
    ],
    deps = ["@clickhouse_llvm_project//:clang_rt_builtins"],
    alwayslink = False,
)

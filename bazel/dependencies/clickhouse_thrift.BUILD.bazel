load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

expand_template(
    name = "configure_thrift_config_h",
    out = "config/contrib/thrift-cmake/thrift/config.h",
    substitutions = {
        "#cmakedefine PACKAGE_BUGREPORT \"${PACKAGE_BUGREPORT}\"": "/* #undef PACKAGE_BUGREPORT */",
        "#cmakedefine PACKAGE_TARNAME \"${PACKAGE_TARNAME}\"": "/* #undef PACKAGE_TARNAME */",
        "#cmakedefine BISON_USE_PARSER_H_EXTENSION 1": "/* #undef BISON_USE_PARSER_H_EXTENSION */",
        "#cmakedefine PACKAGE_NAME \"${PACKAGE_NAME}\"": "/* #undef PACKAGE_NAME */",
        "#cmakedefine HAVE_SCHED_GET_PRIORITY_MAX 1": "#define HAVE_SCHED_GET_PRIORITY_MAX 1",
        "#cmakedefine HAVE_SCHED_GET_PRIORITY_MIN 1": "#define HAVE_SCHED_GET_PRIORITY_MIN 1",
        "#cmakedefine PACKAGE_URL \"${PACKAGE_URL}\"": "/* #undef PACKAGE_URL */",
        "#cmakedefine HAVE_GETHOSTBYNAME_R 1": "/* #undef HAVE_GETHOSTBYNAME_R */",
        "#cmakedefine HAVE_SYS_RESOURCE_H 1": "#define HAVE_SYS_RESOURCE_H 1",
        "#cmakedefine HAVE_GETHOSTBYNAME 1": "#define HAVE_GETHOSTBYNAME 1",
        "#cmakedefine PACKAGE \"${PACKAGE}\"": "/* #undef PACKAGE */",
        "#cmakedefine HAVE_NETINET_IN_H 1": "#define HAVE_NETINET_IN_H 1",
        "#cmakedefine HAVE_SYS_SELECT_H 1": "#define HAVE_SYS_SELECT_H 1",
        "#cmakedefine HAVE_SYS_SOCKET_H 1": "#define HAVE_SYS_SOCKET_H 1",
        "#cmakedefine STRERROR_R_CHAR_P 1": "#define STRERROR_R_CHAR_P 1",
        "#cmakedefine HAVE_ARPA_INET_H 1": "#define HAVE_ARPA_INET_H 1",
        "#cmakedefine HAVE_SYS_IOCTL_H 1": "#define HAVE_SYS_IOCTL_H 1",
        "#cmakedefine HAVE_SYS_PARAM_H 1": "#define HAVE_SYS_PARAM_H 1",
        "#cmakedefine HAVE_INTTYPES_H 1": "#define HAVE_INTTYPES_H 1",
        "#cmakedefine HAVE_STRERROR_R 1": "#define HAVE_STRERROR_R 1",
        "#cmakedefine HAVE_SYS_POLL_H 1": "#define HAVE_SYS_POLL_H 1",
        "#cmakedefine HAVE_SYS_STAT_H 1": "#define HAVE_SYS_STAT_H 1",
        "#cmakedefine HAVE_SYS_TIME_H 1": "#define HAVE_SYS_TIME_H 1",
        "#cmakedefine HAVE_AF_UNIX_H 1": "/* #undef HAVE_AF_UNIX_H */",
        "#cmakedefine HAVE_PTHREAD_H 1": "#define HAVE_PTHREAD_H 1",
        "#cmakedefine HAVE_STRINGS_H 1": "#define HAVE_STRINGS_H 1",
        "#cmakedefine HAVE_SIGNAL_H 1": "#define HAVE_SIGNAL_H 1",
        "#cmakedefine HAVE_STDINT_H 1": "#define HAVE_STDINT_H 1",
        "#cmakedefine HAVE_SYS_UN_H 1": "#define HAVE_SYS_UN_H 1",
        "#cmakedefine HAVE_UNISTD_H 1": "#define HAVE_UNISTD_H 1",
        "#cmakedefine HAVE_FCNTL_H 1": "#define HAVE_FCNTL_H 1",
        "#cmakedefine HAVE_NETDB_H 1": "#define HAVE_NETDB_H 1",
        "#cmakedefine HAVE_SCHED_H 1": "#define HAVE_SCHED_H 1",
        "#cmakedefine HAVE_POLL_H 1": "#define HAVE_POLL_H 1",
        "${PACKAGE_VERSION}": "",
        "${PACKAGE_STRING}": "",
    },
    template = ":build/cmake/config.h.in",
)

ch_cc_library(
    name = "_thrift",
    srcs = [
        "lib/cpp/src/thrift/TApplicationException.cpp",
        "lib/cpp/src/thrift/TOutput.cpp",
        "lib/cpp/src/thrift/async/TAsyncChannel.cpp",
        "lib/cpp/src/thrift/async/TAsyncProtocolProcessor.cpp",
        "lib/cpp/src/thrift/async/TConcurrentClientSyncInfo.cpp",
        "lib/cpp/src/thrift/concurrency/ThreadManager.cpp",
        "lib/cpp/src/thrift/concurrency/TimerManager.cpp",
        "lib/cpp/src/thrift/processor/PeekProcessor.cpp",
        "lib/cpp/src/thrift/protocol/TBase64Utils.cpp",
        "lib/cpp/src/thrift/protocol/TDebugProtocol.cpp",
        "lib/cpp/src/thrift/protocol/TJSONProtocol.cpp",
        "lib/cpp/src/thrift/protocol/TMultiplexedProtocol.cpp",
        "lib/cpp/src/thrift/protocol/TProtocol.cpp",
        "lib/cpp/src/thrift/transport/TTransportException.cpp",
        "lib/cpp/src/thrift/transport/TFDTransport.cpp",
        "lib/cpp/src/thrift/transport/TSimpleFileTransport.cpp",
        "lib/cpp/src/thrift/transport/THttpTransport.cpp",
        "lib/cpp/src/thrift/transport/THttpClient.cpp",
        "lib/cpp/src/thrift/transport/THttpServer.cpp",
        "lib/cpp/src/thrift/transport/TSocket.cpp",
        "lib/cpp/src/thrift/transport/TSocketPool.cpp",
        "lib/cpp/src/thrift/transport/TServerSocket.cpp",
        "lib/cpp/src/thrift/transport/TTransportUtils.cpp",
        "lib/cpp/src/thrift/transport/TBufferTransports.cpp",
        "lib/cpp/src/thrift/transport/SocketCommon.cpp",
        "lib/cpp/src/thrift/transport/TWebSocketServer.cpp",
        "lib/cpp/src/thrift/server/TConnectedClient.cpp",
        "lib/cpp/src/thrift/server/TServerFramework.cpp",
        "lib/cpp/src/thrift/server/TSimpleServer.cpp",
        "lib/cpp/src/thrift/server/TThreadPoolServer.cpp",
        "lib/cpp/src/thrift/server/TThreadedServer.cpp",
        "lib/cpp/src/thrift/concurrency/ThreadFactory.cpp",
        "lib/cpp/src/thrift/concurrency/Thread.cpp",
        "lib/cpp/src/thrift/concurrency/Monitor.cpp",
        "lib/cpp/src/thrift/concurrency/Mutex.cpp",
    ],
    hdrs = [":config/contrib/thrift-cmake/thrift/config.h"] + glob(
        [
            "lib/cpp/src/**/*.h",
            "lib/cpp/src/**/*.tcc",
        ],
        exclude = [
            "lib/cpp/src/thrift/windows/**",
            "lib/cpp/src/thrift/qt/**",
            "lib/cpp/src/thrift/async/TEvhttp*.h",
            "lib/cpp/src/thrift/server/TNonblockingServer.h",
            "lib/cpp/src/thrift/transport/TNonblockingSSLServerSocket.h",
            "lib/cpp/src/thrift/transport/TNonblockingServerSocket.h",
            "lib/cpp/src/thrift/transport/TNonblockingServerTransport.h",
            "lib/cpp/src/thrift/protocol/THeaderProtocol.h",
            "lib/cpp/src/thrift/transport/THeaderTransport.h",
            "lib/cpp/src/thrift/transport/TZlibTransport.h",
            "lib/cpp/src/thrift/transport/TPipe.h",
            "lib/cpp/src/thrift/transport/TPipeServer.h",
        ],
    ),
    copts = [
        "-w",
        "-std=c++23",
    ],
    includes = [
        "lib/cpp/src",
        "lib/cpp/src/thrift",
        "config/contrib/thrift-cmake",
    ],
    local_defines = [
        "BOOST_ASIO_HAS_STD_INVOKE_RESULT=1",
        "BOOST_ASIO_STANDALONE=1",
        "BOOST_TIMER_ENABLE_DEPRECATED=1",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = [
        "@clickhouse_boost//:boost_headers",
        "@clickhouse_openssl//:crypto",
        "@clickhouse_openssl//:ssl",
    ],
)

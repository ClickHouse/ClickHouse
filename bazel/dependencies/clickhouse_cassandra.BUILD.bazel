load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE.txt",
])

expand_template(
    name = "configure_driver_config_hpp",
    out = "config/contrib/cassandra-cmake/driver_config.hpp",
    substitutions = {
        "#cmakedefine HAVE_BUILTIN_BSWAP32": "#define HAVE_BUILTIN_BSWAP32",
        "#cmakedefine HAVE_BUILTIN_BSWAP64": "#define HAVE_BUILTIN_BSWAP64",
        "#cmakedefine HAVE_BOOST_ATOMIC": "/* #undef HAVE_BOOST_ATOMIC */",
        "#cmakedefine HAVE_SIGTIMEDWAIT": "#define HAVE_SIGTIMEDWAIT",
        "#cmakedefine HAVE_ARC4RANDOM": "/* #undef HAVE_ARC4RANDOM */",
        "#cmakedefine HAVE_STD_ATOMIC": "#define HAVE_STD_ATOMIC",
        "#cmakedefine HAVE_GETRANDOM": "/* #undef HAVE_GETRANDOM */",
        "#cmakedefine HAVE_NOSIGPIPE": "/* #undef HAVE_NOSIGPIPE */",
        "#cmakedefine HAVE_KERBEROS": "/* #undef HAVE_KERBEROS */",
        "#cmakedefine HAVE_OPENSSL": "#define HAVE_OPENSSL",
        "#cmakedefine HAVE_TIMERFD": "/* #undef HAVE_TIMERFD */",
        "#cmakedefine HASH_IN_TR1": "/* #undef HASH_IN_TR1 */",
        "#cmakedefine HAVE_ZLIB": "#define HAVE_ZLIB",
    },
    template = ":driver_config.hpp.in",
)


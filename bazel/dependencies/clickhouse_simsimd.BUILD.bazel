load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_simsimd",
    srcs = [
        "c/lib.c",
    ],
    hdrs = glob(["include/**/*.h"]),
    includes = [
        "include",
    ],
    language = "C",
    local_defines = [
        "SIMSIMD_DYNAMIC_DISPATCH",
        "SIMSIMD_NATIVE_BF16=0",
        "SIMSIMD_TARGET_SVE2=0",
        "SIMSIMD_TARGET_SVE=0",
    ] + CXX_RUNTIME_DEFINES,
)

load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

_GENERATED_LOCAL_DEFINES_0 = [
    "BOOST_ASIO_HAS_STD_INVOKE_RESULT=1",
    "BOOST_ASIO_STANDALONE=1",
    "BOOST_TIMER_ENABLE_DEPRECATED=1",
    "STD_EXCEPTION_HAS_STACK_TRACE=1",
    "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
    "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
    "_LIBUNWIND_IS_NATIVE_ONLY",
]

ch_cc_library(
    name = "_silk_fibers",
    srcs = (glob(["src/fibers/*.cpp"])) + glob(["src/**/*.h"]),
    hdrs = select({
        "@platforms//cpu:x86_64": [
            "@clickhouse_sysroot//:linux_native_headers",
        ],
        "@platforms//cpu:aarch64": [
            "@clickhouse_sysroot//:linux_native_headers",
        ],
    }),
    additional_compiler_inputs = [
        "@clickhouse_sysroot//:linux_compile_files",
        "src/util/error.cpp",
    ],
    copts = [
        "-w",
        "-std=c++23",
        "-nostdinc++",
    ],
    local_defines = _GENERATED_LOCAL_DEFINES_0,
    local_includes = ([
        "include",
        "src",
    ] + select({
        "@platforms//cpu:x86_64": [
        ],
        "@platforms//cpu:aarch64": [
        ],
    })),
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse_boost//:boost_headers",
        "@clickhouse_boost//:_boost_context",
        "@clickhouse_librseq//:_librseq",
        "@clickhouse_liburing//:_liburing",
        ":_silk_util",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)

ch_cc_library(
    name = "_silk_util",
    srcs = (glob(["src/util/*.cpp"])) + glob(["src/**/*.h"]),
    hdrs = (["@clickhouse_sysroot//:linux_native_headers"] + glob(["include/**/*.h"])),
    additional_compiler_inputs = [
        "@clickhouse_sysroot//:linux_compile_files",
        "src/util/error.cpp",
    ],
    copts = [
        "-w",
        "-std=c++23",
        "-nostdinc++",
    ],
    local_defines = _GENERATED_LOCAL_DEFINES_0,
    local_includes = [
        "include",
        "src",
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse_boost//:boost_headers",
        "@clickhouse_librseq//:_librseq",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)

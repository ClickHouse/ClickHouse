load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

_GENERATED_LOCAL_DEFINES_0 = [
    "BOOST_ASIO_HAS_STD_INVOKE_RESULT=1",
    "BOOST_ASIO_STANDALONE=1",
    "BOOST_TIMER_ENABLE_DEPRECATED=1",
    "STD_EXCEPTION_HAS_STACK_TRACE=1",
    "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
    "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
    "_LIBUNWIND_IS_NATIVE_ONLY",
]

ch_cc_library(
    name = "_silk_fibers",
    srcs = glob(["src/fibers/*.cpp"]) + glob(["src/**/*.h"]),
    additional_compiler_inputs = ["src/util/error.cpp"],
    copts = [
        "-w",
        "-std=c++23",
    ],
    local_defines = _GENERATED_LOCAL_DEFINES_0,
    local_includes = ([
        "include",
        "src",
    ] + select({
        "@platforms//cpu:x86_64": [
        ],
        "@platforms//cpu:aarch64": [
        ],
    })),
    deps = [
        "@clickhouse_boost//:_boost_context",
        "@clickhouse_liburing//:_liburing",
        ":_silk_util",
    ],
    alwayslink = False,
)

ch_cc_library(
    name = "_silk_util",
    srcs = glob(["src/util/*.cpp"]) + glob(["src/**/*.h"]),
    hdrs = glob(["include/**/*.h"]),
    additional_compiler_inputs = ["src/util/error.cpp"],
    copts = [
        "-w",
        "-std=c++23",
    ],
    local_defines = _GENERATED_LOCAL_DEFINES_0,
    local_includes = [
        "include",
        "src",
    ],
    deps = [
        "@clickhouse_boost//:boost_headers",
        "@clickhouse_librseq//:_librseq",
    ],
    alwayslink = False,
)

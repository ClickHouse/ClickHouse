load("@clickhouse//bazel/dependencies:aws_crt_defines.bzl", "AWS_CRT_DEFINES")
load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "aws_c_compression",
    srcs = glob(["source/*.c"]) + glob(["include/**/private/**/*.h"]),
    hdrs = glob(
        ["include/**/*.h"],
        exclude = ["include/**/private/**/*.h"],
    ),
    copts = [
        "-w",
        "-std=gnu11",
        "-g1",
    ],
    includes = ["include"],
    language = "C",
    llvm_headers = False,
    local_defines = AWS_CRT_DEFINES,
    deps = ["@clickhouse_aws_c_common//:aws_c_common"],
)

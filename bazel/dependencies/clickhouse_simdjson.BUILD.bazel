load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE-MIT",
])

ch_cc_library(
    name = "_simdjson",
    srcs = [
        "src/simdjson.cpp",
    ] + glob(["src/**/*.h"]),
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.hpp",
    ]),
    additional_compiler_inputs = (glob(
        [
            "include/**",
            "src/**",
        ],
        exclude = [
            "include/**/*.h",
            "include/**/*.hpp",
            "src/**/*.h",
            "src/simdjson.cpp",
        ],
    ) + [
    ]),
    copts = (([
        "-w",
        "-std=c++23",
    ] + select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            "-DSIMDJSON_IMPLEMENTATION_FALLBACK=1",
        ],
    })) + []),
    includes = [
        "include",
    ],
    local_defines = [
        "SIMDJSON_UTF8VALIDATION=0",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "include",
        "src",
    ],
    deps = ["@clickhouse_llvm_project//:clang_rt_builtins"],
    alwayslink = False,
)

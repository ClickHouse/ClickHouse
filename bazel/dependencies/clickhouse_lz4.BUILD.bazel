load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_lz4__compile_0",
    srcs = [
        "lib/lz4.c",
        "lib/lz4hc.c",
        "lib/lz4frame.c",
        "lib/xxhash.c",
        "lib/lz4.h",
        "lib/lz4hc.h",
        "lib/lz4frame.h",
        "lib/xxhash.h",
    ],
    additional_compiler_inputs = ["lib/lz4.c"],
    copts = [
        "-w",
        "-std=gnu11",
    ],
    language = "C",
    local_defines = [
        "LZ4_FAST_DEC_LOOP=1",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "lib",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

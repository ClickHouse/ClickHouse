load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_xgboost",
    srcs = glob(
        [
            "src/**/*.cc",
            "src/**/*.h",
        ],
        exclude = [
            "src/collective/in_memory_communicator.h",
            "src/collective/nccl_stub.h",
            "src/common/base64.h",
            "src/common/cuda_dr_utils.h",
            "src/common/cuda_pinned_allocator.h",
            "src/common/cuda_stream_pool.h",
        ],
    ),
    hdrs = glob(["include/**/*.h"]),
    copts = [
        "-w",
        "-std=c++17",
        "-include",
        "exception",
    ],
    includes = [
        "include",
    ],
    local_defines = [
        "DMLC_CORE_USE_CMAKE",
        "DMLC_USE_CXX11=1",
        "DMLC_USE_CXX14=1",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "config/contrib/xgboost/dmlc-core",
    ],
    private_hdrs = [
        "src/metric/elementwise_metric.cu",
        "src/metric/multiclass_metric.cu",
        "src/metric/survival_metric.cu",
        "src/objective/aft_obj.cu",
        "src/objective/hinge.cu",
        "src/objective/multiclass_obj.cu",
        "src/objective/quantile_obj.cu",
        "src/objective/regression_obj.cu",
    ],
    deps = ["@clickhouse_dmlc_core//:_dmlc_core"],
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

_ZSTD_LEGACY_HEADERS = glob(["lib/legacy/*.h"])

exports_files([
    "LICENSE",
])

_ZSTD_PRIVATE_HEADERS = [
    "lib/compress/clevels.h",
    "lib/compress/zstd_compress_literals.h",
    "lib/compress/zstd_compress_sequences.h",
    "lib/compress/zstd_compress_superblock.h",
    "lib/compress/zstd_double_fast.h",
    "lib/compress/zstd_fast.h",
    "lib/compress/zstd_lazy.h",
    "lib/compress/zstd_ldm.h",
    "lib/compress/zstd_ldm_geartab.h",
    "lib/compress/zstd_opt.h",
    "lib/decompress/zstd_ddict.h",
    "lib/dictBuilder/cover.h",
    "lib/dictBuilder/divsufsort.h",
]

_ZSTD_LOCAL_DEFINES = [
    "STD_EXCEPTION_HAS_STACK_TRACE=1",
    "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
    "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
    "_LIBUNWIND_IS_NATIVE_ONLY",
]

ch_cc_library(
    name = "_zstd",
    srcs = glob(["lib/common/*.c"]) + [
        "lib/compress/fse_compress.c",
        "lib/compress/hist.c",
        "lib/compress/huf_compress.c",
        "lib/compress/zstd_compress.c",
    ] + glob(["lib/compress/zstd_compress_*.c"]) + ([
        "lib/compress/zstd_double_fast.c",
        "lib/compress/zstd_fast.c",
        "lib/compress/zstd_lazy.c",
        "lib/compress/zstd_ldm.c",
        "lib/compress/zstdmt_compress.c",
        "lib/compress/zstd_opt.c",
        "lib/compress/zstd_preSplit.c",
    ] + glob(["lib/decompress/*.c"])) + glob(["lib/dictBuilder/*.c"]) + glob(["lib/legacy/*.c"]) + _ZSTD_LEGACY_HEADERS + _ZSTD_PRIVATE_HEADERS,
    hdrs = glob(
        ["lib/**/*.h"],
        exclude = ["lib/common/portability_macros.h"] + _ZSTD_LEGACY_HEADERS + _ZSTD_PRIVATE_HEADERS,
    ),
    copts = [
        "-w",
        "-std=gnu11",
        "-D",
        "ZSTD_LEGACY_SUPPORT=1",
        "-fno-sanitize=undefined",
    ],
    includes = [
        "lib",
    ],
    language = "C",
    libcxx_headers = False,
    local_defines = _ZSTD_LOCAL_DEFINES,
    local_includes = [
        "lib/legacy",
        "lib/common",
    ],
    deps = [
        ":_zstd__compile_1",
    ],
)

ch_cc_library(
    name = "_zstd__compile_1",
    srcs = ["lib/decompress/huf_decompress_amd64.S"],
    hdrs = ["lib/common/portability_macros.h"],
    copts = [
        "-D",
        "ZSTD_LEGACY_SUPPORT=1",
        "-fno-sanitize=undefined",
    ],
    language = "ASM",
    libcxx_headers = False,
    local_defines = _ZSTD_LOCAL_DEFINES,
    local_includes = [
        "lib",
        "lib/legacy",
        "lib/common",
    ],
)

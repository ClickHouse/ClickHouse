load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

_GENERATED_LOCAL_DEFINES_0 = [
    "STD_EXCEPTION_HAS_STACK_TRACE=1",
    "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
    "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
    "_LIBUNWIND_IS_NATIVE_ONLY",
]

_GENERATED_DEPS_0 = [
    "@llvm-project//compiler-rt:headers",
    "@llvm-project//libc:libc_headers",
    "@llvm-project//libunwind:headers",
]

ch_cc_library(
    name = "_zstd__compile_0",
    srcs = (glob(["lib/common/*.c"]) + ([
        "lib/compress/fse_compress.c",
        "lib/compress/hist.c",
        "lib/compress/huf_compress.c",
        "lib/compress/zstd_compress.c",
    ] + glob(["lib/compress/zstd_compress_*.c"]) + [
        "lib/compress/zstd_double_fast.c",
        "lib/compress/zstd_fast.c",
        "lib/compress/zstd_lazy.c",
        "lib/compress/zstd_ldm.c",
        "lib/compress/zstdmt_compress.c",
        "lib/compress/zstd_opt.c",
        "lib/compress/zstd_preSplit.c",
        "lib/decompress/huf_decompress.c",
        "lib/decompress/zstd_ddict.c",
        "lib/decompress/zstd_decompress_block.c",
        "lib/decompress/zstd_decompress.c",
    ]) + glob(["lib/dictBuilder/*.c"]) + glob(["lib/legacy/*.c"])),
    hdrs = glob(["lib/**/*.h"]),
    additional_compiler_inputs = [
        "@clickhouse_llvm_project//:runtime_source_inputs",
        "@clickhouse_llvm_project//:runtime_generated_headers",
    ],
    copts = [
        "-w",
        "-std=gnu11",
        "-D",
        "ZSTD_LEGACY_SUPPORT=1",
        "-fno-sanitize=undefined",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    language = "C",
    local_defines = _GENERATED_LOCAL_DEFINES_0,
    local_includes = [
        "lib",
        "lib/legacy",
        "lib/common",
    ],

    # librdkafka's rdxxhash.c includes this source as text.
    textual_hdrs = ["lib/common/xxhash.c"],
    deps = _GENERATED_DEPS_0,
)

ch_cc_library(
    name = "_zstd__compile_1",
    srcs = [
        "lib/decompress/huf_decompress_amd64.S",
    ],
    hdrs = glob(["lib/**/*.h"]),
    copts = [
        "-D",
        "ZSTD_LEGACY_SUPPORT=1",
        "-fno-sanitize=undefined",
    ],
    language = "ASM",
    local_defines = _GENERATED_LOCAL_DEFINES_0,
    local_includes = [
        "lib",
        "lib/legacy",
        "lib/common",
    ],
    deps = _GENERATED_DEPS_0,
)

cc_library(
    name = "_zstd",
    deps = [
        "@clickhouse_llvm_project//:clang_rt_builtins",
        ":_zstd__compile_0",
        ":_zstd__compile_1",
    ],
)

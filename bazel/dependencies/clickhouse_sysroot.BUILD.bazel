package(default_visibility = ["//visibility:public"])

filegroup(
    name = "linux_x86_64_link_files",
    srcs = glob(
        ["linux-x86_64/**"],
        exclude = ["linux-x86_64/**/include/**"],
    ),
)

filegroup(
    name = "linux_aarch64_link_files",
    srcs = glob(
        ["linux-aarch64/**"],
        exclude = ["linux-aarch64/**/include/**"],
    ),
)

filegroup(
    name = "linux_link_files",
    srcs = select({
        "@platforms//cpu:x86_64": [":linux_x86_64_link_files"],
        "@platforms//cpu:aarch64": [":linux_aarch64_link_files"],
    }),
)

filegroup(
    name = "linux_x86_64_compile_files",
    srcs = glob(["linux-x86_64/**"]),
)

filegroup(
    name = "linux_aarch64_compile_files",
    srcs = glob(["linux-aarch64/**"]),
)

filegroup(
    name = "linux_compile_files",
    srcs = select({
        "@platforms//cpu:x86_64": [":linux_x86_64_compile_files"],
        "@platforms//cpu:aarch64": [":linux_aarch64_compile_files"],
    }),
)

filegroup(
    name = "linux_math_library",
    srcs = select({
        "@platforms//cpu:x86_64": [
            "linux-x86_64/x86_64-linux-gnu/libc/lib64/libm.so.6",
        ],
        "@platforms//cpu:aarch64": [
            "linux-aarch64/aarch64-linux-gnu/libc/lib64/libm.so.6",
        ],
    }),
)

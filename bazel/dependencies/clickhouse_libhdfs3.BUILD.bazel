expand_template(
    name = "configure_platform_h",
    out = "config/contrib/libhdfs3-cmake/platform.h",
    substitutions = {
        "#cmakedefine HAVE_NESTED_EXCEPTION": "#define HAVE_NESTED_EXCEPTION",
        "#cmakedefine STRERROR_R_RETURN_INT": "/* #undef STRERROR_R_RETURN_INT */",
        "#cmakedefine ENABLE_FRAME_POINTER": "/* #undef ENABLE_FRAME_POINTER */",
        "#cmakedefine HAVE_BOOST_ATOMIC": "/* #undef HAVE_BOOST_ATOMIC */",
        "#cmakedefine HAVE_BOOST_CHRONO": "/* #undef HAVE_BOOST_CHRONO */",
        "#cmakedefine HAVE_STEADY_CLOCK": "#define HAVE_STEADY_CLOCK",
        "#cmakedefine HAVE_STD_ATOMIC": "#define HAVE_STD_ATOMIC",
        "#cmakedefine HAVE_STD_CHRONO": "#define HAVE_STD_CHRONO",
        "#cmakedefine LIBUNWIND_FOUND": "/* #undef LIBUNWIND_FOUND */",
        "#cmakedefine01 WITH_KERBEROS": "#define WITH_KERBEROS 1",
        "#cmakedefine HAVE_SYMBOLIZE": "/* #undef HAVE_SYMBOLIZE */",
        "#cmakedefine HAVE_DLADDR": "/* #undef HAVE_DLADDR */",
        "#cmakedefine NEED_BOOST": "/* #undef NEED_BOOST */",
        "#cmakedefine OS_MACOSX": "/* #undef OS_MACOSX */",
        "#cmakedefine OS_LINUX": "#define OS_LINUX",
    },
    template = ":src/platform.h.in",
)


load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_nats_io",
    srcs = [
        "src/asynccb.h",
        "src/buf.h",
        "src/comsock.h",
        "src/conn.h",
        "src/crypto.h",
        "src/dispatch.h",
        "src/err.h",
        "src/gc.h",
        "src/glib/glib.h",
        "src/glib/glibp.h",
        "src/hash.h",
        "src/include/n-unix.h",
        "src/js.h",
        "src/kv.h",
        "src/mem.h",
        "src/msg.h",
        "src/natsp.h",
        "src/natstime.h",
        "src/nkeys.h",
        "src/nuid.h",
        "src/opts.h",
        "src/parser.h",
        "src/srvpool.h",
        "src/stats.h",
        "src/sub.h",
        "src/timer.h",
        "src/url.h",
        "src/util.h",
        "src/asynccb.c",
        "src/buf.c",
        "src/comsock.c",
        "src/conn.c",
        "src/crypto.c",
        "src/dispatch.c",
        "src/hash.c",
        "src/js.c",
        "src/jsm.c",
        "src/kv.c",
        "src/msg.c",
        "src/nats.c",
        "src/natstime.c",
        "src/nkeys.c",
        "src/nuid.c",
        "src/opts.c",
        "src/parser.c",
        "src/pub.c",
        "src/srvpool.c",
        "src/stats.c",
        "src/status.c",
        "src/sub.c",
        "src/timer.c",
        "src/url.c",
        "src/util.c",
    ] + glob([
        "src/glib/*.c",
        "src/unix/*.c",
    ]),
    hdrs = [
        "src/adapters/libuv.h",
        "src/nats.h",
        "src/status.h",
        "src/version.h",
    ],
    implementation_deps = [
        "@clickhouse_openssl//:crypto",
        "@clickhouse_openssl//:ssl",
    ],
    includes = [
        "src",
        "src/adapters",
        "src/include",
    ],
    language = "C",
    local_defines = [
        "NATS_HAS_TLS",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "src/unix",
    ],
    deps = ["@clickhouse_libuv//:_uv"],
)

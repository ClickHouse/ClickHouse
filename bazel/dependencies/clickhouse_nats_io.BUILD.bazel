load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_nats_io",
    srcs = ([
        "src/asynccb.c",
        "src/buf.c",
        "src/comsock.c",
        "src/conn.c",
        "src/crypto.c",
        "src/dispatch.c",
        "src/hash.c",
        "src/js.c",
        "src/jsm.c",
        "src/kv.c",
        "src/msg.c",
        "src/nats.c",
        "src/natstime.c",
        "src/nkeys.c",
        "src/nuid.c",
        "src/opts.c",
        "src/parser.c",
        "src/pub.c",
        "src/srvpool.c",
        "src/stats.c",
        "src/status.c",
        "src/sub.c",
        "src/timer.c",
        "src/url.c",
        "src/util.c",
    ] + glob(["src/glib/*.c"]) + glob(["src/unix/*.c"])),
    hdrs = glob(["src/**/*.h"]),
    copts = [
        "-w",
        "-std=gnu11",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    language = "C",
    local_defines = [
        "NATS_HAS_TLS",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "src",
        "src/adapters",
        "src/include",
        "src/unix",
    ],
    deps = [
        "@clickhouse_libuv//:_uv",
        "@clickhouse_openssl//:ssl",
    ],
)

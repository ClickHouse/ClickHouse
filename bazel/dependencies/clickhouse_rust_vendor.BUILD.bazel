load("@clickhouse//bazel/rules:codegen_actions.bzl", "rust_vendor_licenses")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = ["**/BUILD.bazel"],
    ),
)

rust_vendor_licenses(
    name = "licenses",
    filenames = [
        "LICENSE",
        "LICENCE",
        "LICENSE.md",
        "LICENSE.txt",
        "LICENSE.TXT",
        "COPYING",
        "LICENSE_APACHE",
        "LICENSE-APACHE",
        "license-apache-2.0",
        "LICENSES/Apache-2.0.txt",
        "LICENSE-MIT",
        "LICENSE-MIT.txt",
        "LICENSE-MIT.md",
        "LICENSE.MIT",
        "LICENSE_A2",
        "LICENSE_CC0",
        "LICENSE_A2LLVM",
        "LICENSE-0BSD.txt",
    ],
)

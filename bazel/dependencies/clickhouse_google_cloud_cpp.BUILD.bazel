package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

expand_template(
    name = "configure_internal_build_info_cc",
    out = "config/contrib/google-cloud-cpp-cmake/internal/build_info.cc",
    substitutions = {
        "@GOOGLE_CLOUD_CPP_BUILD_METADATA@": "",
        "@CMAKE_CXX_FLAGS@": "",
    } | select({
        "@platforms//cpu:x86_64": {
            "${CMAKE_CXX_FLAGS_${GOOGLE_CLOUD_CPP_BUILD_TYPE_UPPER}}": "--gcc-toolchain=cmake/linux/../../contrib/sysroot/linux-x86_64 --no-default-config -fdiagnostics-color=always  -pipe -march=x86-64-v3 -mpclmul -fasynchronous-unwind-tables -fdebug-compilation-dir=. -ffile-prefix-map== -falign-functions=64 -falign-loops=32 -ffunction-sections -fdata-sections -faddrsig -mbranches-within-32B-boundaries -fstack-protector-strong -fstack-clash-protection -ffp-contract=off -fno-math-errno  -fdiagnostics-absolute-paths -fstrict-vtable-pointers -fPIE -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST -w -ffunction-sections -fdata-sections -faddrsig -O3 -DNDEBUG",
        },
        "@platforms//cpu:aarch64": {
            "${CMAKE_CXX_FLAGS_${GOOGLE_CLOUD_CPP_BUILD_TYPE_UPPER}}": "--gcc-toolchain=cmake/linux/../../contrib/sysroot/linux-aarch64 --no-default-config -fdiagnostics-color=always  -pipe -march=armv8.2-a+simd+crypto+dotprod+ssbs+rcpc+bf16 -fasynchronous-unwind-tables -fdebug-compilation-dir=. -ffile-prefix-map== -falign-functions=64 -falign-loops=32 -ffunction-sections -fdata-sections -faddrsig -fstack-protector-strong -fstack-clash-protection -ffp-contract=off -fno-math-errno  -fdiagnostics-absolute-paths -fstrict-vtable-pointers -fPIE -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST -w -ffunction-sections -fdata-sections -faddrsig -O3 -DNDEBUG",
        },
    }),
    template = ":google/cloud/internal/build_info.cc.in",
)

_GRPC_LOCAL_DEFINES = select({
    "@platforms//cpu:x86_64": [],
    "@platforms//cpu:aarch64": [
        "ARM_ACLE",
        "ARM_ASM_HWCAP",
        "ARM_AUXV_HAS_CRC32",
        "ARM_AUXV_HAS_NEON",
        "ARM_FEATURES",
        "ARM_NEON",
        "ARM_NEON_HASLD4",
        "HAVE_ARM_ACLE_H",
    ],
}) + [
    "HAVE_ATTRIBUTE_ALIGNED",
    "HAVE_BUILTIN_CTZ",
    "HAVE_BUILTIN_CTZLL",
    "HAVE_POSIX_MEMALIGN",
] + select({
    "@platforms//cpu:x86_64": [],
    "@platforms//cpu:aarch64": [
        "HAVE_SYS_AUXV_H",
    ],
}) + [
    "HAVE_VISIBILITY_HIDDEN",
    "HAVE_VISIBILITY_INTERNAL",
    "STD_EXCEPTION_HAS_STACK_TRACE=1",
    "UNALIGNED_OK",
    "WITH_GZFILEOP",
    "X86_64",
] + select({
    "@platforms//cpu:x86_64": [
        "X86_AVX2",
        "X86_FEATURES",
        "X86_PCLMULQDQ_CRC",
        "X86_SSE2",
        "X86_SSE42",
        "X86_SSSE3",
    ],
    "@platforms//cpu:aarch64": [],
}) + [
    "ZLIB_COMPAT",
    "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
    "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
    "_LIBUNWIND_IS_NATIVE_ONLY",
]

_DEBUG_COPTS = [
    "-w",
    "-std=c++23",
    "-g1",
]

google_cloud_grpc_libraries(
    local_defines = _GRPC_LOCAL_DEFINES,
    storage_copts = _DEBUG_COPTS,
)

# ClickHouse and the other Google Cloud libraries include some upstream internal headers.
# Keep the headers used only by google_cloud_cpp_common in its srcs.
_COMMON_PRIVATE_HEADERS = [
    "internal/build_info.h",
    "internal/compiler_info.h",
    "internal/detect_gcp.h",
    "internal/detect_gcp_impl.h",
    "internal/log_impl.h",
    "internal/strerror.h",
    "internal/timer_queue.h",
    "internal/user_agent_prefix.h",
]

# google_cloud_cpp_grpc_utils owns disable_deprecation_warnings.inc.
# disable_msvc_crt_secure_warnings.inc is only used on Windows.
_COMMON_HEADER_EXCLUSIONS = _COMMON_PRIVATE_HEADERS + [
    "internal/disable_deprecation_warnings.inc",
    "internal/disable_msvc_crt_secure_warnings.inc",
]

ch_cc_library(
    name = "google_cloud_cpp_common",
    srcs = [":config/contrib/google-cloud-cpp-cmake/internal/build_info.cc"] + [
        "google/cloud/" + src
        for src in google_cloud_cpp_common_srcs + _COMMON_PRIVATE_HEADERS
    ],
    hdrs = [
        "google/cloud/" + hdr
        for hdr in google_cloud_cpp_common_hdrs
        if hdr not in _COMMON_HEADER_EXCLUSIONS
    ],
    copts = _DEBUG_COPTS,
    implementation_deps = [
        "@clickhouse_openssl//:crypto",
        "@clickhouse_re2//:_re2",
        "@clickhouse_abseil_cpp//:absl_str_format_internal",
    ],
    local_includes = [
        ".",
    ],
    deps = [
        "@clickhouse_abseil_cpp//:absl_base_config",
        "@clickhouse_abseil_cpp//:absl_function_ref",
        "@clickhouse_abseil_cpp//:absl_optional",
        "@clickhouse_abseil_cpp//:absl_span",
        "@clickhouse_abseil_cpp//:absl_strings",
        "@clickhouse_abseil_cpp//:absl_time",
        "@clickhouse_abseil_cpp//:absl_type_traits",
        "@clickhouse_abseil_cpp//:absl_variant",
    ],
)


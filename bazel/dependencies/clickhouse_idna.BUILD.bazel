load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE-MIT",
])

ch_cc_library(
    name = "_idna",
    srcs = [
        "src/idna.cpp",
    ],
    hdrs = glob(["include/**/*.h"]),
    additional_compiler_inputs = [
        "src/id_tables.cpp",
        "src/identifier.cpp",
        "src/mapping.cpp",
        "src/mapping_tables.cpp",
        "src/normalization.cpp",
        "src/normalization_tables.cpp",
        "src/punycode.cpp",
        "src/to_ascii.cpp",
        "src/to_unicode.cpp",
        "src/unicode_transcoding.cpp",
        "src/validity.cpp",
    ],
    copts = (
        [
            "-w",
            "-std=c++23",
        ]
    ),
    features = [],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "include",
    ],
    deps = ["@clickhouse_llvm_project//:clang_rt_builtins"],
    alwayslink = False,
)

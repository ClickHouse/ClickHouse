load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

_GENERATED_LOCAL_DEFINES_0 = [
    "STD_EXCEPTION_HAS_STACK_TRACE=1",
    "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
    "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
    "_LIBUNWIND_IS_NATIVE_ONLY",
]

ch_cc_library(
    name = "google_benchmark",
    srcs = [
        "src/benchmark.cc",
        "src/benchmark_api_internal.cc",
        "src/benchmark_name.cc",
        "src/benchmark_register.cc",
        "src/benchmark_runner.cc",
        "src/check.cc",
        "src/colorprint.cc",
        "src/commandlineflags.cc",
        "src/complexity.cc",
        "src/console_reporter.cc",
        "src/counter.cc",
        "src/csv_reporter.cc",
        "src/json_reporter.cc",
        "src/perf_counters.cc",
        "src/reporter.cc",
        "src/statistics.cc",
        "src/string_util.cc",
        "src/sysinfo.cc",
        "src/timers.cc",
    ] + glob(["src/**/*.h"]),
    hdrs = [
        "@clickhouse_sysroot//:linux_native_headers",
    ] + glob(["include/**/*.h"]),
    additional_compiler_inputs = [
        "@clickhouse_sysroot//:linux_compile_files",
    ],
    copts = [
        "-w",
        "-std=c++23",
        "-nostdinc++",
    ],
    includes = [
        "include",
    ],
    local_defines = _GENERATED_LOCAL_DEFINES_0,
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)

ch_cc_library(
    name = "google_benchmark_main",
    srcs = [
        "src/benchmark_main.cc",
    ],
    additional_compiler_inputs = [
        "@clickhouse_sysroot//:linux_compile_files",
    ],
    copts = [
        "-w",
        "-std=c++23",
        "-nostdinc++",
    ],
    local_defines = _GENERATED_LOCAL_DEFINES_0,
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        ":google_benchmark",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)

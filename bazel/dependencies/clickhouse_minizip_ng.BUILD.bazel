load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel:repository_paths.bzl", "repository_local_include", "repository_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_minizip",
    srcs = [
        "mz_crypt.c",
        "mz_os.c",
        "mz_strm.c",
        "mz_strm_buf.c",
        "mz_strm_mem.c",
        "mz_strm_split.c",
        "mz_zip.c",
        "mz_zip_rw.c",
        "mz_strm_zlib.c",
        "mz_strm_bzip.c",
        "mz_strm_lzma.c",
        "mz_strm_zstd.c",
        "mz_crypt_openssl.c",
        "mz_strm_wzaes.c",
        "mz_strm_pkcrypt.c",
        "mz_os_posix.c",
        "mz_strm_os_posix.c",
        "compat/zip.c",
        "compat/unzip.c",
        "compat/ioapi.c",
    ],
    hdrs = select({
        "@platforms//cpu:x86_64": ([
            "@clickhouse_zlib_ng//:config/x86_64/contrib/zlib-ng-cmake/gzread.c",
            "@clickhouse_sysroot//:linux_native_headers",
            "@clickhouse//:contrib/minizip-ng-cmake/mz_config.h",
        ] + glob(["**/*.h"])),
        "@platforms//cpu:aarch64": ([
            "@clickhouse_zlib_ng//:config/aarch64/contrib/zlib-ng-cmake/gzread.c",
            "@clickhouse_sysroot//:linux_native_headers",
            "@clickhouse//:contrib/minizip-ng-cmake/mz_config.h",
        ] + glob(["**/*.h"])),
    }),
    additional_compiler_inputs = [
        "@clickhouse_sysroot//:linux_compile_files",
        "@clickhouse_llvm_project//:runtime_source_inputs",
        "@clickhouse_llvm_project//:runtime_generated_headers",
        "@clickhouse//:contrib/minizip-ng-cmake/CMakeLists.txt",
    ],
    copts = [
        "-w",
        "-std=gnu11",
        "-I",
        repository_path("contrib/minizip-ng"),
        "-I",
        "contrib/minizip-ng-cmake",
        "-I",
        repository_path("contrib/minizip-ng") + "/compat",
        "-I",
        repository_path("contrib/zstd") + "/lib",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    language = "C",
    local_defines = select({
        "@platforms//cpu:x86_64": [
            "HAVE_ATTRIBUTE_ALIGNED",
            "HAVE_BUILTIN_CTZ",
            "HAVE_BUILTIN_CTZLL",
            "HAVE_BZIP2",
            "HAVE_LZMA",
            "HAVE_PKCRYPT",
            "HAVE_POSIX_MEMALIGN",
            "HAVE_VISIBILITY_HIDDEN",
            "HAVE_VISIBILITY_INTERNAL",
            "HAVE_WZAES",
            "HAVE_ZLIB",
            "HAVE_ZSTD",
            "MZ_COMPAT_VERSION=110",
            "STD_EXCEPTION_HAS_STACK_TRACE=1",
            "UNALIGNED_OK",
            "WITH_GZFILEOP",
            "X86_64",
            "X86_AVX2",
            "X86_FEATURES",
            "X86_PCLMULQDQ_CRC",
            "X86_SSE2",
            "X86_SSE42",
            "X86_SSSE3",
        ],
        "@platforms//cpu:aarch64": [
            "ARM_ACLE",
            "ARM_ASM_HWCAP",
            "ARM_AUXV_HAS_CRC32",
            "ARM_AUXV_HAS_NEON",
            "ARM_FEATURES",
            "ARM_NEON",
            "ARM_NEON_HASLD4",
            "HAVE_ARM_ACLE_H",
            "HAVE_ATTRIBUTE_ALIGNED",
            "HAVE_BUILTIN_CTZ",
            "HAVE_BUILTIN_CTZLL",
            "HAVE_BZIP2",
            "HAVE_LZMA",
            "HAVE_PKCRYPT",
            "HAVE_POSIX_MEMALIGN",
            "HAVE_SYS_AUXV_H",
            "HAVE_VISIBILITY_HIDDEN",
            "HAVE_VISIBILITY_INTERNAL",
            "HAVE_WZAES",
            "HAVE_ZLIB",
            "HAVE_ZSTD",
            "MZ_COMPAT_VERSION=110",
            "STD_EXCEPTION_HAS_STACK_TRACE=1",
            "UNALIGNED_OK",
            "WITH_GZFILEOP",
            "X86_64",
        ],
    }) + [
        "ZLIB_COMPAT",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = select({
        "@platforms//cpu:x86_64": [
        ],
        "@platforms//cpu:aarch64": [
        ],
    }),
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse_bzip2//:_bzip2",
        "@clickhouse_xz//:_liblzma",
        "@clickhouse_zlib_ng//:_zlib",
        "@clickhouse_zstd//:_zstd",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse_openssl//:crypto",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        "@clickhouse_openssl//:ssl",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)

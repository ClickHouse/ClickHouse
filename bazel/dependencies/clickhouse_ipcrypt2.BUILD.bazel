load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_ipcrypt2",
    srcs = [
        "src/ipcrypt2.c",
    ] + select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [],
        "//conditions:default": glob(["src/softaes/*.h"]),
    }),
    hdrs = glob(["src/include/**/*.h"]),
    copts = [
        "-w",
        "-std=gnu11",
    ],
    includes = [
        "src/include",
    ],
    language = "C",
    local_defines = CXX_RUNTIME_DEFINES,
)

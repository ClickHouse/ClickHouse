load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_fmt",
    srcs = [
        "src/format.cc",
        "src/os.cc",
    ],
    hdrs = glob(["include/**/*.h"]),
    copts = [
        "-w",
        "-std=c++23",
    ],
    includes = [
        "include",
    ],
    local_defines = CXX_RUNTIME_DEFINES,
)

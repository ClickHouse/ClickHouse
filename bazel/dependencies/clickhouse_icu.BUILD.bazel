load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

alias(
    name = "_icudata",
    actual = "@clickhouse_icudata//:_icudata",
)

ch_cc_library(
    name = "_icui18n",
    srcs = glob(["icu4c/source/i18n/*.cpp"]),
    hdrs = [
        "@clickhouse_sysroot//:linux_native_headers",
    ] + glob(["icu4c/source/i18n/**/*.h"]),
    additional_compiler_inputs = [
        "@clickhouse_sysroot//:linux_compile_files",
    ],
    copts = [
        "-w",
        "-std=c++23",
        "-nostdinc++",
    ],
    local_defines = [
        "'DEFAULT_ICU_PLUGINS=\"/dev/null\"'",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "U_HAVE_ELF_H=1",
        "U_HAVE_STRTOD_L=1",
        "U_HAVE_XLOCALE_H=0",
        "U_I18N_IMPLEMENTATION",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
        "_REENTRANT",
    ],
    local_includes = [
        "icu4c/source/i18n",
        "icu4c/source/common",
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        ":_icudata",
        ":_icuuc",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)

ch_cc_library(
    name = "_icuuc",
    srcs = glob(["icu4c/source/common/*.cpp"]),
    hdrs = [
        "@clickhouse_sysroot//:linux_native_headers",
    ] + glob(["icu4c/source/common/**/*.h"]),
    additional_compiler_inputs = [
        "@clickhouse_sysroot//:linux_compile_files",
    ],
    copts = [
        "-w",
        "-std=c++23",
        "-nostdinc++",
    ],
    local_defines = [
        "'DEFAULT_ICU_PLUGINS=\"/dev/null\"'",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "U_COMMON_IMPLEMENTATION",
        "U_HAVE_ELF_H=1",
        "U_HAVE_STRTOD_L=1",
        "U_HAVE_XLOCALE_H=0",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
        "_REENTRANT",
    ],
    local_includes = [
        "icu4c/source/common",
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        ":_icudata",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)

    substitutions = select({
        "@platforms//cpu:x86_64": _AWS_CRT_CONFIG_H_SUBSTITUTIONS | {
            "@GIT_HASH@": "8b819009ee01311c3ec6767472a85b82a5f35b7c",
        },
        "@platforms//cpu:aarch64": _AWS_CRT_CONFIG_H_SUBSTITUTIONS | {
            "@GIT_HASH@": "6bb427c9a81459c2b9e7369ef6ed8a6e8680b0da",
        },
    }),
    template = "@clickhouse_aws_crt_cpp//:include/aws/crt/Config.h.in",

expand_template(
    name = "configure_include_aws_common_config_h",
    out = "config/contrib/aws-cmake/include/aws/common/config.h",
    substitutions = select({
        "@platforms//cpu:x86_64": _AWS_COMMON_CONFIG_H_SUBSTITUTIONS | {
            "#cmakedefine AWS_ARCH_ARM64": "/* #undef AWS_ARCH_ARM64 */",
            "#cmakedefine AWS_ARCH_INTEL": "#define AWS_ARCH_INTEL",
            "#cmakedefine AWS_HAVE_CLMUL": "/* #undef AWS_HAVE_CLMUL */",
        },
        "@platforms//cpu:aarch64": _AWS_COMMON_CONFIG_H_SUBSTITUTIONS | {
            "#cmakedefine AWS_ARCH_ARM64": "#define AWS_ARCH_ARM64",
            "#cmakedefine AWS_ARCH_INTEL": "/* #undef AWS_ARCH_INTEL */",
            "#cmakedefine AWS_HAVE_CLMUL": "/* #undef AWS_HAVE_CLMUL */",
        },
    }),
    template = "@clickhouse_aws_c_common//:include/aws/common/config.h.in",
)

expand_template(
    name = "configure_include_aws_core_SDKConfig_h",
    out = "config/contrib/aws-cmake/include/aws/core/SDKConfig.h",
    substitutions = {
        "#cmakedefine USE_AWS_MEMORY_MANAGEMENT": "/* #undef USE_AWS_MEMORY_MANAGEMENT */",
    },
    template = ":src/aws-cpp-sdk-core/include/aws/core/SDKConfig.h.in",
)


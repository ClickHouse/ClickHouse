load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

_AI_SDK_CPP_LOCAL_INCLUDES = [
    "src",
    "third_party/httplib-header-only",
    "third_party/concurrentqueue-header-only",
]

_AI_SDK_CPP_HTTP_DEPS = [
    "@clickhouse_brotli//:_brotli",
    "@clickhouse_openssl//:ssl",
    "@clickhouse_openssl//:crypto",
]

ch_cc_library(
    name = "_ai-sdk-cpp-anthropic",
    srcs = glob(["src/providers/anthropic/*.cpp"]) + glob([
        "src/http/*.h",
        "src/providers/*.h",
        "src/providers/anthropic/*.h",
        "src/utils/*.h",
        "third_party/concurrentqueue-header-only/**/*.h",
        "third_party/httplib-header-only/**/*.h",
    ]),
    hdrs = ["include/ai/anthropic.h"],
    copts = [
        "-std=c++20",
        "-w",
    ],
    implementation_deps = ["@clickhouse_nlohmann_json//:nlohmann_json"] + _AI_SDK_CPP_HTTP_DEPS,
    includes = ["include"],
    local_defines = [
        "AI_SDK_HAS_ANTHROPIC=1",
        "CPPHTTPLIB_BROTLI_SUPPORT=1",
        "CPPHTTPLIB_OPENSSL_SUPPORT=1",
        "CPPHTTPLIB_THREAD_POOL_COUNT=8",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = _AI_SDK_CPP_LOCAL_INCLUDES,
    deps = [":_ai-sdk-cpp-core"],
)

ch_cc_library(
    name = "_ai-sdk-cpp-core",
    srcs = [
        "src/types/generate_options.cpp",
        "src/types/stream_options.cpp",
        "src/types/stream_result.cpp",
        "src/types/message.cpp",
        "src/http/http_request_handler.cpp",
        "src/providers/base_provider_client.cpp",
        "src/tools/tool_executor.cpp",
        "src/tools/multi_step_coordinator.cpp",
    ] + glob(
        ["src/**/*.h"],
        exclude = [
            "src/providers/anthropic/*.h",
            "src/providers/openai/*.h",
            "src/utils/message_utils.h",
        ],
    ) + glob(["third_party/httplib-header-only/**/*.h"]),
    hdrs = glob(
        ["include/**/*.h"],
        exclude = [
            "include/ai/ai.h",
            "include/ai/anthropic.h",
            "include/ai/openai.h",
        ],
    ),
    copts = [
        "-std=c++20",
        "-w",
    ],
    implementation_deps = _AI_SDK_CPP_HTTP_DEPS,
    includes = [
        "include",
    ],
    local_defines = [
        "CPPHTTPLIB_BROTLI_SUPPORT=1",
        "CPPHTTPLIB_OPENSSL_SUPPORT=1",
        "CPPHTTPLIB_THREAD_POOL_COUNT=8",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = _AI_SDK_CPP_LOCAL_INCLUDES,
    deps = ["@clickhouse_nlohmann_json//:nlohmann_json"],
)

ch_cc_library(
    name = "_ai-sdk-cpp-openai",
    srcs = glob(["src/providers/openai/*.cpp"]) + glob([
        "src/http/*.h",
        "src/providers/*.h",
        "src/providers/openai/*.h",
        "src/utils/*.h",
        "third_party/concurrentqueue-header-only/**/*.h",
        "third_party/httplib-header-only/**/*.h",
    ]),
    hdrs = ["include/ai/openai.h"],
    copts = [
        "-std=c++20",
        "-w",
    ],
    implementation_deps = ["@clickhouse_nlohmann_json//:nlohmann_json"] + _AI_SDK_CPP_HTTP_DEPS,
    includes = ["include"],
    local_defines = [
        "AI_SDK_HAS_OPENAI=1",
        "CPPHTTPLIB_BROTLI_SUPPORT=1",
        "CPPHTTPLIB_OPENSSL_SUPPORT=1",
        "CPPHTTPLIB_THREAD_POOL_COUNT=8",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = _AI_SDK_CPP_LOCAL_INCLUDES,
    deps = [":_ai-sdk-cpp-core"],
)

ch_cc_library(
    name = "sdk",
    hdrs = ["include/ai/ai.h"],
    copts = ["-std=c++20"],
    includes = ["include"],
    local_defines = [
        "AI_SDK_HAS_ANTHROPIC=1",
        "AI_SDK_HAS_OPENAI=1",
    ],
    deps = [
        ":_ai-sdk-cpp-core",
        ":_ai-sdk-cpp-anthropic",
        ":_ai-sdk-cpp-openai",
    ],
)

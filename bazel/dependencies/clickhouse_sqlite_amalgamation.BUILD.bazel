load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["external_include_paths"],
)

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_sqlite",
    srcs = [
        "sqlite3.c",
    ],
    hdrs = glob(["**/*.h"]),
    copts = [
        "-w",
        "-std=gnu11",
    ],
    language = "C",
    libcxx_headers = False,
    local_defines = CXX_RUNTIME_DEFINES,
)

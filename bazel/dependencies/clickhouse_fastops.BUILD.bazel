load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["external_include_paths"],
)

exports_files(["LICENSE"])

ch_cc_library(
    name = "_fastops",
    srcs = ["fastops/fastops.cpp"] + select({
        "@platforms//cpu:x86_64": ["fastops/avx2/ops_avx2.cpp"],
        "@platforms//cpu:aarch64": ["fastops/neon/ops_neon.cpp"],
    }) + [
        "fastops/core/FastIntrinsics.h",
        "fastops/core/SIMDFunctions.h",
    ] + select({
        "@platforms//cpu:x86_64": ["fastops/avx2/ops_avx2.h"],
        "@platforms//cpu:aarch64": ["fastops/neon/ops_neon.h"],
    }),
    hdrs = ["fastops/fastops.h"],
    copts = [
        "-w",
        "-std=c++23",
    ],
    implementation_deps = select({
        "@platforms//cpu:aarch64": [":_fastops_sve"],
        "//conditions:default": [],
    }),
    local_defines = CXX_RUNTIME_DEFINES,
)

ch_cc_library(
    name = "_fastops_sve",
    srcs = [
        "fastops/sve/ops_sve.cpp",
        "fastops/core/FastIntrinsics.h",
        "fastops/core/SIMDFunctions.h",
    ],
    hdrs = ["fastops/sve/ops_sve.h"],
    arches = ["aarch64"],
    copts = [
        "-w",
        "-std=c++23",
        "-march=armv8-a+sve",
    ],
    local_defines = CXX_RUNTIME_DEFINES,
    target_compatible_with = select({
        "@platforms//cpu:aarch64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["@clickhouse//:__pkg__"],
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["external_include_paths"],
)

exports_files(["LICENSE"])

ch_cc_library(
    name = "_fastops",
    srcs = ["fastops/fastops.cpp"] + select({
        "@platforms//cpu:x86_64": ["fastops/avx2/ops_avx2.cpp"],
        "@platforms//cpu:aarch64": ["fastops/neon/ops_neon.cpp"],
    }),
    hdrs = glob([
        "**/*.h",
        "**/*.hpp",
    ]),
    copts = [
        "-w",
        "-std=c++23",
    ],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = ["."],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse_llvm_project//:clang_rt_builtins",
    ] + select({
        "@platforms//cpu:aarch64": [":_fastops_sve"],
        "//conditions:default": [],
    }),
    alwayslink = False,
)

ch_cc_library(
    name = "_fastops_sve",
    srcs = ["fastops/sve/ops_sve.cpp"],
    hdrs = glob([
        "**/*.h",
        "**/*.hpp",
    ]),
    arches = ["aarch64"],
    copts = [
        "-w",
        "-std=c++23",
        "-march=armv8-a+sve",
    ],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = ["."],
    target_compatible_with = select({
        "@platforms//cpu:aarch64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["@clickhouse//:__pkg__"],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
    ],
    alwayslink = False,
)

load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["external_include_paths"],
)

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_fastops__compile_0",
    srcs = ([
        "fastops/fastops.cpp",
    ] + select({
        "@platforms//cpu:x86_64": [
            "fastops/avx2/ops_avx2.cpp",
        ],
        "@platforms//cpu:aarch64": [
            "fastops/neon/ops_neon.cpp",
        ],
    })),
    hdrs = glob([
        "**/*.h",
        "**/*.hpp",
    ]),
    additional_compiler_inputs = [],
    copts = ["-w", "-std=c++23"],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        ".",
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
    ],
    alwayslink = False,
)

ch_cc_library(
    name = "_fastops__compile_1",
    srcs = select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            "fastops/sve/ops_sve.cpp",
        ],
    }),
    hdrs = select({"@platforms//cpu:x86_64": [], "@platforms//cpu:aarch64": glob([
        "**/*.h",
        "**/*.hpp",
    ])}),
    additional_compiler_inputs = [],
    arches = [
        "aarch64",
    ],
    copts = select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": ["-w", "-std=c++23", "-march=armv8-a+sve"],
    }),
    local_defines = select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            "STD_EXCEPTION_HAS_STACK_TRACE=1",
            "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
            "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
            "_LIBUNWIND_IS_NATIVE_ONLY",
        ],
    }),
    local_includes = select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            ".",
        ],
    }),
    deps = select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            "@llvm-project//compiler-rt:headers",
            "@llvm-project//libc:libc_headers",
            "@llvm-project//libunwind:headers",
        ],
    }),
    alwayslink = False,
)

cc_library(
    name = "_fastops",
    deps = ["@clickhouse//:clang_rt_builtins", ":_fastops__compile_0", ":_fastops__compile_1"],
)

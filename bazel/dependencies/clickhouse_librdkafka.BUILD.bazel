load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//contrib/librdkafka-cmake:flags.bzl", "RDKAFKA_LOCAL_DEFINES")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSES.txt",
])

expand_template(
    name = "configure_config_h",
    out = "config/contrib/librdkafka-cmake/config.h",
    substitutions = {
        "#cmakedefine WITH_OAUTHBEARER_OIDC 1": "#define WITH_OAUTHBEARER_OIDC 1",
        "#cmakedefine WITH_SASL_OAUTHBEARER 1": "#define WITH_SASL_OAUTHBEARER 1",
        "#cmakedefine WITH_SASL_CYRUS 1": "#define WITH_SASL_CYRUS 1",
        "#cmakedefine WITH_SASL_SCRAM 1": "#define WITH_SASL_SCRAM 1",
        "#cmakedefine WITH_HTTP 1": "#define WITH_HTTP 1",
        "#cmakedefine WITH_SSL 1": "#define WITH_SSL 1",
    },
    template = "@clickhouse//contrib/librdkafka-cmake:config.h.in",
)

ch_cc_library(
    name = "_rdkafka__compile_0",
    srcs = [
        "src/cJSON.c",
        "src/crc32c.c",
        "src/rdaddr.c",
        "src/rdavl.c",
        "src/rdbase64.c",
        "src/rdbuf.c",
        "src/rdcrc32.c",
        "src/rdfnv1a.c",
        "src/rdgz.c",
        "src/rdkafka_admin.c",
        "src/rdkafka_assignment.c",
        "src/rdkafka_assignor.c",
        "src/rdkafka_aux.c",
        "src/rdkafka_background.c",
        "src/rdkafka_broker.c",
        "src/rdkafka_buf.c",
        "src/rdkafka.c",
        "src/rdkafka_cert.c",
        "src/rdkafka_cgrp.c",
        "src/rdkafka_coord.c",
        "src/rdkafka_error.c",
        "src/rdkafka_event.c",
        "src/rdkafka_feature.c",
        "src/rdkafka_fetcher.c",
        "src/rdkafka_header.c",
        "src/rdkafka_idempotence.c",
        "src/rdkafka_interceptor.c",
        "src/rdkafka_lz4.c",
        "src/rdkafka_metadata.c",
        "src/rdkafka_metadata_cache.c",
        "src/rdkafka_mock.c",
    ] + glob(["src/rdkafka_mock_*.c"]) + [
        "src/rdkafka_msg.c",
        "src/rdkafka_msgset_reader.c",
        "src/rdkafka_msgset_writer.c",
        "src/rdkafka_offset.c",
        "src/rdkafka_op.c",
        "src/rdkafka_partition.c",
        "src/rdkafka_pattern.c",
        "src/rdkafka_queue.c",
        "src/rdkafka_range_assignor.c",
        "src/rdkafka_request.c",
        "src/rdkafka_roundrobin_assignor.c",
        "src/rdkafka_sasl.c",
        "src/rdkafka_sasl_plain.c",
        "src/rdkafka_share_acknowledgement.c",
        "src/rdkafka_sticky_assignor.c",
        "src/rdkafka_subscription.c",
        "src/rdkafka_telemetry.c",
        "src/rdkafka_telemetry_decode.c",
        "src/rdkafka_telemetry_encode.c",
    ] + glob(["src/nanopb/*.c"]) + glob(["src/opentelemetry/*.c"]) + [
        "src/rdkafka_timer.c",
        "src/rdkafka_topic.c",
        "src/rdkafka_transport.c",
        "src/rdkafka_txnmgr.c",
        "src/rdkafka_zstd.c",
        "@clickhouse//contrib/librdkafka-cmake:rdkafka_conf_sensitive.c",
        "src/rdlist.c",
        "src/rdlog.c",
        "src/rdmap.c",
        "src/rdmurmur2.c",
        "src/rdports.c",
        "src/rdrand.c",
        "src/rdregex.c",
        "src/rdstring.c",
        "src/rdunittest.c",
    ] + glob(["src/rdunittest_*.c"]) + [
        "src/rdvarint.c",
        "src/rdxxhash.c",
        "src/snappy.c",
        "src/tinycthread.c",
        "src/tinycthread_extra.c",
        "src/rdkafka_ssl.c",
        "@clickhouse//contrib/librdkafka-cmake:rdhttp_poco.c",
        "src/rdkafka_sasl_oauthbearer_oidc.c",
        "src/rdkafka_sasl_cyrus.c",
        "src/rdkafka_sasl_scram.c",
        "src/rdkafka_sasl_oauthbearer.c",
        ":config/contrib/librdkafka-cmake/config.h",
        "@clickhouse//contrib/librdkafka-cmake:rdhttp_poco_transport.h",
    ] + glob(
        ["src/**/*.h"],
        exclude = [
            "src/lz4.h",
            "src/lz4frame_static.h",
            "src/lz4hc.h",
            "src/rddl.h",
            "src/rdhdrhistogram.h",
            "src/rdkafka.h",
            "src/rdkafka_plugin.h",
            "src/rdsignal.h",
            "src/rdwin32.h",
            "src/regexp.h",
            "src/win32_config.h",
        ],
    ),
    hdrs = ["src/rdkafka.h"],
    copts = [
        "-w",
        "-std=gnu11",
        "-fno-sanitize=undefined",
    ],
    implementation_deps = [
        "@clickhouse_zlib_ng//:_zlib",
        "@clickhouse_cyrus_sasl//:_sasl2",
        "@clickhouse_zstd//:_zstd",
        "@clickhouse_openssl//:crypto",
        "@clickhouse_openssl//:ssl",
    ],
    language = "C",
    local_defines = RDKAFKA_LOCAL_DEFINES,
    local_includes = [
        "config/contrib/librdkafka-cmake",
        "src",
    ],
    private_hdrs = ["src/rdkafka_conf.c"],
    strip_include_prefix = "src",
)

cc_library(
    name = "_rdkafka",
    deps = [
        "@clickhouse_cyrus_sasl//:_sasl2",
        "@clickhouse//base:common",
        ":_rdkafka__compile_0",
        "@clickhouse//contrib/librdkafka-cmake:rdhttp_poco_transport",
    ],
)

load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "COPYING",
])

cc_library(
    name = "libpqxx_headers",
    hdrs = glob(["include/**/*.hxx"]),
    textual_hdrs = glob(
        ["include/pqxx/*"],
        exclude = ["include/pqxx/*.*"],
    ),
)

expand_template(
    name = "configure_pqxx_config_internal_compiler_h",
    out = "config/contrib/libpqxx-cmake/pqxx/config-internal-compiler.h",
    substitutions = {},
    template = ":include/pqxx/config.h.in",
)

expand_template(
    name = "configure_pqxx_config_public_compiler_h",
    out = "config/contrib/libpqxx-cmake/pqxx/config-public-compiler.h",
    substitutions = {},
    template = ":include/pqxx/config.h.in",
)

ch_cc_library(
    name = "_libpqxx",
    srcs = glob(["src/*.cxx"]) + glob(["src/**/*.hxx"]),
    hdrs = [
        ":config/contrib/libpqxx-cmake/pqxx/config-internal-compiler.h",
        ":config/contrib/libpqxx-cmake/pqxx/config-public-compiler.h",
    ],
    copts = [
        "-w",
        "-std=c++23",
    ],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "include",
        "config/contrib/libpqxx-cmake",
    ],
    deps = [
        ":libpqxx_headers",
        "@clickhouse_postgres//:_libpq",
    ],
    alwayslink = False,
)

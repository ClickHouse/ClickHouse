load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "COPYING",
])

cc_library(
    name = "libpqxx_headers",
    hdrs = glob(["include/**/*.hxx"]),
    textual_hdrs = glob(
        ["include/pqxx/*"],
        exclude = ["include/pqxx/*.*"],
    ),
)

expand_template(
    name = "configure_x86_64_6fedff1c3446af59",
    out = "config/x86_64/contrib/libpqxx-cmake/pqxx/config-internal-compiler.h",
    substitutions = {},
    template = ":include/pqxx/config.h.in",
)

expand_template(
    name = "configure_x86_64_9372f8a8ab9501d3",
    out = "config/x86_64/contrib/libpqxx-cmake/pqxx/config-public-compiler.h",
    substitutions = {},
    template = ":include/pqxx/config.h.in",
)

expand_template(
    name = "configure_aarch64_6fedff1c3446af59",
    out = "config/aarch64/contrib/libpqxx-cmake/pqxx/config-internal-compiler.h",
    substitutions = {},
    template = ":include/pqxx/config.h.in",
)

expand_template(
    name = "configure_aarch64_9372f8a8ab9501d3",
    out = "config/aarch64/contrib/libpqxx-cmake/pqxx/config-public-compiler.h",
    substitutions = {},
    template = ":include/pqxx/config.h.in",
)

ch_cc_library(
    name = "_libpqxx",
    srcs = glob(["src/*.cxx"]) + glob(["src/**/*.hxx"]),
    hdrs = (select({
        "@platforms//cpu:x86_64": [
            ":config/x86_64/contrib/libpqxx-cmake/pqxx/config-internal-compiler.h",
            ":config/x86_64/contrib/libpqxx-cmake/pqxx/config-public-compiler.h",
        ],
        "@platforms//cpu:aarch64": [
            ":config/aarch64/contrib/libpqxx-cmake/pqxx/config-internal-compiler.h",
            ":config/aarch64/contrib/libpqxx-cmake/pqxx/config-public-compiler.h",
        ],
    })),
    additional_compiler_inputs = ["@clickhouse//:contrib/postgres-cmake/CMakeLists.txt"],
    copts = ["-w", "-std=c++23"],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = ([
        "include",
    ] + select({
        "@platforms//cpu:x86_64": [
            "config/x86_64/contrib/libpqxx-cmake",
        ],
        "@platforms//cpu:aarch64": [
            "config/aarch64/contrib/libpqxx-cmake",
        ],
    })),
    deps = [":libpqxx_headers", "@clickhouse_postgres//:_libpq"],
    alwayslink = False,
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "repository_path")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_cppkafka",
    srcs = [
        "src/buffer.cpp",
        "src/configuration_option.cpp",
        "src/configuration.cpp",
        "src/consumer.cpp",
        "src/error.cpp",
        "src/event.cpp",
        "src/exceptions.cpp",
        "src/group_information.cpp",
        "src/kafka_handle_base.cpp",
        "src/message_internal.cpp",
        "src/message_timestamp.cpp",
        "src/message.cpp",
        "src/metadata.cpp",
        "src/producer.cpp",
        "src/queue.cpp",
        "src/topic_configuration.cpp",
        "src/topic_partition_list.cpp",
        "src/topic_partition.cpp",
        "src/topic.cpp",
    ],
    hdrs = glob(["include/**/*.h"]),
    additional_compiler_inputs = ["src/error.cpp"],
    copts = [
        "-w",
        "-std=c++23",
        # queue.cpp includes "queue.h"; CppKafka's header must precede system headers.
        "-I",
        repository_path("contrib/cppkafka") + "/include/cppkafka",
    ],
    includes = ["include"],
    local_defines = [
        "BOOST_ASIO_HAS_STD_INVOKE_RESULT=1",
        "BOOST_ASIO_STANDALONE=1",
        "BOOST_TIMER_ENABLE_DEPRECATED=1",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = (select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [],
    }) + ["@clickhouse_librdkafka//:_rdkafka"]),
    alwayslink = False,
)

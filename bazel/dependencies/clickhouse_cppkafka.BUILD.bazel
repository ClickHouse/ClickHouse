load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_cppkafka",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["include/**/*.h"]),
    implementation_deps = [
        "@clickhouse_librdkafka//:_rdkafka",
    ],
    includes = ["include"],
    local_defines = [
        "BOOST_ASIO_HAS_STD_INVOKE_RESULT=1",
        "BOOST_ASIO_STANDALONE=1",
        "BOOST_TIMER_ENABLE_DEPRECATED=1",
    ] + CXX_RUNTIME_DEFINES,
    local_includes = ["include/cppkafka"],
    deps = [
        "@clickhouse//contrib/librdkafka-cmake:rdhttp_poco_transport",
        "@clickhouse_boost//:boost_headers_no_openssl",
    ],
)

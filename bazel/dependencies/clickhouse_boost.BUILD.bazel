load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE_1_0.txt",
])

_GENERATED_LOCAL_DEFINES_0 = [
    "STD_EXCEPTION_HAS_STACK_TRACE=1",
    "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
    "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
    "_LIBUNWIND_IS_NATIVE_ONLY",
]

_BOOST_COPTS = [
    "-w",
    "-std=c++23",
]

ch_cc_library(
    name = "_boost_context__compile_0",
    srcs = [
        "libs/context/src/dummy.cpp",
        "libs/context/src/fcontext.cpp",
        "libs/context/src/posix/stack_traits.cpp",
    ],
    copts = _BOOST_COPTS,
    implementation_deps = [
        ":boost_config",
        ":boost_headers",
    ],
    local_defines = _GENERATED_LOCAL_DEFINES_0,
)

ch_cc_library(
    name = "_boost_context__compile_1",
    srcs = select({
        "@platforms//cpu:x86_64": glob(["libs/context/src/asm/*_64_sysv_elf_gas.S"]),
        "@platforms//cpu:aarch64": glob(["libs/context/src/asm/*_arm64_aapcs_elf_gas.S"]),
    }),
    language = "ASM",
    libcxx_headers = False,
    local_defines = _GENERATED_LOCAL_DEFINES_0,
    deps = [":boost_headers"],
)

cc_library(
    name = "_boost_context",
    deps = [
        ":_boost_context__compile_0",
        ":_boost_context__compile_1",
        "@clickhouse_llvm_project//:clang_rt_builtins",
    ],
)

ch_cc_library(
    name = "_boost_coroutine",
    srcs = [
        "libs/coroutine/src/detail/coroutine_context.cpp",
        "libs/coroutine/src/exceptions.cpp",
        "libs/coroutine/src/posix/stack_traits.cpp",
    ],
    copts = _BOOST_COPTS,
    implementation_deps = [
        ":boost_config",
        ":boost_headers",
    ],
    local_defines = _GENERATED_LOCAL_DEFINES_0,
    deps = [":_boost_context"],
)

ch_cc_library(
    name = "_boost_filesystem",
    srcs = glob(["libs/filesystem/src/*.cpp"]) + [
        "libs/filesystem/src/atomic_ref.hpp",
        "libs/filesystem/src/atomic_tools.hpp",
        "libs/filesystem/src/error_handling.hpp",
        "libs/filesystem/src/platform_config.hpp",
        "libs/filesystem/src/posix_tools.hpp",
        "libs/filesystem/src/private_config.hpp",
    ],
    copts = _BOOST_COPTS,
    implementation_deps = [":boost_headers"],
    local_defines = [
        "BOOST_FILESYSTEM_HAS_POSIX_AT_APIS=1",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = ["@clickhouse_llvm_project//:clang_rt_builtins"],
)

ch_cc_library(
    name = "_boost_graph",
    srcs = [
        "libs/graph/src/graphml.cpp",
        "libs/graph/src/read_graphviz_new.cpp",
    ],
    copts = _BOOST_COPTS,
    implementation_deps = [":boost_headers"],
    local_defines = _GENERATED_LOCAL_DEFINES_0,
)

ch_cc_library(
    name = "_boost_iostreams",
    srcs = [
        "libs/iostreams/src/file_descriptor.cpp",
        "libs/iostreams/src/gzip.cpp",
        "libs/iostreams/src/mapped_file.cpp",
        "libs/iostreams/src/zlib.cpp",
        "libs/iostreams/src/zstd.cpp",
    ],
    copts = _BOOST_COPTS,
    implementation_deps = [
        ":boost_config",
        ":boost_headers",
        "@clickhouse_zlib_ng//:_zlib",
        "@clickhouse_zstd//:_zstd__compile_0",
    ],
    local_defines = select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            "ARM_ACLE",
            "ARM_ASM_HWCAP",
            "ARM_AUXV_HAS_CRC32",
            "ARM_AUXV_HAS_NEON",
            "ARM_FEATURES",
            "ARM_NEON",
            "ARM_NEON_HASLD4",
            "HAVE_ARM_ACLE_H",
        ],
    }) + [
        "HAVE_ATTRIBUTE_ALIGNED",
        "HAVE_BUILTIN_CTZ",
        "HAVE_BUILTIN_CTZLL",
        "HAVE_POSIX_MEMALIGN",
    ] + select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            "HAVE_SYS_AUXV_H",
        ],
    }) + [
        "HAVE_VISIBILITY_HIDDEN",
        "HAVE_VISIBILITY_INTERNAL",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "UNALIGNED_OK",
        "WITH_GZFILEOP",
        "X86_64",
    ] + select({
        "@platforms//cpu:x86_64": [
            "X86_AVX2",
            "X86_FEATURES",
            "X86_PCLMULQDQ_CRC",
            "X86_SSE2",
            "X86_SSE42",
            "X86_SSSE3",
        ],
        "@platforms//cpu:aarch64": [],
    }) + [
        "ZLIB_COMPAT",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = ["@clickhouse_zstd//:_zstd"],
)

ch_cc_library(
    name = "_boost_program_options",
    srcs = glob(["libs/program_options/src/*.cpp"]),
    copts = _BOOST_COPTS,
    implementation_deps = [
        ":boost_config",
        ":boost_headers",
    ],
    local_defines = _GENERATED_LOCAL_DEFINES_0,
    deps = ["@clickhouse_llvm_project//:clang_rt_builtins"],
)

ch_cc_library(
    name = "_boost_regex",
    srcs = [
        "libs/regex/src/posix_api.cpp",
        "libs/regex/src/wide_posix_api.cpp",
    ],
    copts = _BOOST_COPTS,
    implementation_deps = [":boost_headers"],
    local_defines = _GENERATED_LOCAL_DEFINES_0,
    deps = ["@clickhouse_llvm_project//:clang_rt_builtins"],
)

_ASIO_COMPILER_OPTIONS = [
    "boost/asio/detail/pop_options.hpp",
    "boost/asio/detail/push_options.hpp",
]

# push_options.hpp and pop_options.hpp bracket each Asio reader's compiler
# pragmas. Their owner lets the NuRaft consumer audit check the pair together.
cc_library(
    name = "boost_asio_options",
    textual_hdrs = _ASIO_COMPILER_OPTIONS,
)

_BOOST_CONFIG_HEADERS = [
    "boost/config.hpp",
    "boost/config/compiler/clang.hpp",
    "boost/config/compiler/clang_version.hpp",
    "boost/config/detail/cxx_composite.hpp",
    "boost/config/detail/posix_features.hpp",
    "boost/config/detail/select_compiler_config.hpp",
    "boost/config/detail/select_platform_config.hpp",
    "boost/config/detail/select_stdlib_config.hpp",
    "boost/config/helper_macros.hpp",
    "boost/config/platform/linux.hpp",
    "boost/config/stdlib/libcpp.hpp",
    "boost/config/user.hpp",
]

_BOOST_CONFIG_PRIVATE_HEADERS = [
    "boost/config/detail/suffix.hpp",
]

_BOOST_CONFIG_ABI = [
    "boost/config/abi_prefix.hpp",
    "boost/config/abi_suffix.hpp",
]

# detail/suffix.hpp is included only by config.hpp. The ABI headers are a
# public pair; the Boost.Iostreams consumer audit verifies both in context.
cc_library(
    name = "boost_config",
    srcs = _BOOST_CONFIG_PRIVATE_HEADERS,
    hdrs = _BOOST_CONFIG_HEADERS,
    features = ["external_include_paths"],
    includes = ["."],
    textual_hdrs = _BOOST_CONFIG_ABI,
)

cc_library(
    name = "boost_headers",
    hdrs = glob(
        [
            "boost/**/*.h",
            "boost/**/*.hpp",
            "boost/**/*.ipp",
        ],
        exclude = _ASIO_COMPILER_OPTIONS + _BOOST_CONFIG_HEADERS + _BOOST_CONFIG_PRIVATE_HEADERS + _BOOST_CONFIG_ABI,
    ),
    features = ["external_include_paths"],
    textual_hdrs = glob(["boost/**/*.inc"]),
    deps = [
        ":boost_asio_options",
        ":boost_config",
    ],
)

cc_library(
    name = "boost_asio_headers",
    includes = ["boost"],
    deps = [":boost_headers"],
)

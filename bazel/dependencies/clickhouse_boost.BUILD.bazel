    name = "boost_asio_options",
    textual_hdrs = _ASIO_COMPILER_OPTIONS,
)

_BOOST_CONFIG_HEADERS = [
    "boost/config.hpp",
    "boost/config/compiler/clang.hpp",
    "boost/config/compiler/clang_version.hpp",
    "boost/config/detail/cxx_composite.hpp",
    "boost/config/detail/posix_features.hpp",

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "repository_path")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_jieba",
    srcs = [
        "src/jieba.cpp",
        "src/jieba_dict.cpp",
        "src/jieba_mp_seg.cpp",
        "src/jieba_hmm_seg.cpp",
    ],
    hdrs = glob(["include/**/*.h"]),
    additional_compiler_inputs = glob(
        [
            "data/**",
            "include/**",
            "src/**",
        ],
        exclude = [
            "include/**/*.h",
            "src/jieba.cpp",
            "src/jieba_dict.cpp",
            "src/jieba_hmm_seg.cpp",
            "src/jieba_mp_seg.cpp",
        ],
    ),
    copts = [
        "-w",
        "-std=c++23",
        "--embed-dir=" + repository_path("contrib/Jieba-CPP") + "/data",
        "-I",
        repository_path("contrib/zstd") + "/lib",
    ],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "data",
        "include",
    ],
    deps = [
        "@clickhouse_zstd//:_zstd",
        "@clickhouse_darts_clone//:darts_clone",
    ],
    alwayslink = False,
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "repository_path")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_jieba",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["include/**/*.h"]),
    additional_compiler_inputs = glob(["data/*.zst"]),
    copts = [
        "-w",
        "-std=c++23",
        "--embed-dir=" + repository_path("contrib/Jieba-CPP") + "/data",
    ],
    implementation_deps = ["@clickhouse_zstd//:_zstd"],
    includes = [
        "include",
    ],
    local_defines = CXX_RUNTIME_DEFINES,
    local_includes = [
        "data",
    ],
    private_hdrs = ["data/jieba_hmm_model.dat"],
    deps = ["@clickhouse_darts_clone//:darts_clone"],
)

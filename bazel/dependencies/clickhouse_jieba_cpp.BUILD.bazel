load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "repository_path")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_jieba",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["include/**/*.h"]),
    additional_compiler_inputs = glob(["data/*.zst"]),
    copts = [
        "-w",
        "-std=c++23",
        "--embed-dir=" + repository_path("contrib/Jieba-CPP") + "/data",
    ],
    implementation_deps = ["@clickhouse_zstd//:_zstd__compile_0"],
    includes = [
        "include",
    ],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "data",
    ],
    private_hdrs = ["data/jieba_hmm_model.dat"],
    deps = [
        "@clickhouse_zstd//:_zstd",
        "@clickhouse_darts_clone//:darts_clone",
    ],
)

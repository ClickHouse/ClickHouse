load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "aws_c_event_stream",
    srcs = glob(["source/*.c"]),
    additional_compiler_inputs = [
        "@clickhouse_llvm_project//:runtime_source_inputs",
        "@clickhouse_llvm_project//:runtime_generated_headers",
    ],
    copts = [
        "-w",
        "-std=gnu11",
        "-g1",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"] + [] + [
        "@clickhouse_aws_c_io//:aws_c_io_headers",
        "@clickhouse_aws_checksums//:aws_checksums_headers",
    ],
    language = "C",
    local_defines = ([
        "AWS_AFFINITY_METHOD=AWS_AFFINITY_METHOD_NONE",
        "AWS_ENABLE_EPOLL",
        "AWS_PTHREAD_SETNAME_TAKES_2ARGS",
        "ENABLE_OPENSSL_ENCRYPTION",
        "INTEL_NO_ITTNOTIFY_API",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
    ] + select({
        "@platforms//cpu:x86_64": [
            "USE_SIMD_ENCODING",
        ],
        "@platforms//cpu:aarch64": [],
    }) + [
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ]),
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        ":aws_c_event_stream_headers",
    ],
    alwayslink = False,
)

cc_library(
    name = "aws_c_event_stream_headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    deps = ["@clickhouse_aws_c_common//:aws_c_common_headers"],
)

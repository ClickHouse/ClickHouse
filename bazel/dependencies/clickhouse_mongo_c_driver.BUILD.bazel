ch_cc_library(
    name = "_libbson",
    srcs = glob(["src/libbson/src/bson/*.c"]) + ["src/libbson/src/jsonsl/jsonsl.c"] + glob(["src/common/src/*.c"]) + glob([
        "src/libbson/src/bson/*-private.h",
        "src/libbson/src/jsonsl/*.h",
    ]),
    hdrs = [
        ":config/contrib/mongo-c-driver/src/common/src/common-config.h",
        ":config/contrib/mongo-c-driver/src/libbson/src/bson/config.h",
        ":config/contrib/mongo-c-driver/src/libbson/src/bson/version.h",
    ] + glob(
        [
            "src/common/src/**/*.h",
            "src/libbson/src/bson/*.h",
        ],
        exclude = [
            "src/common/src/mlib/str_vec.h",
            "src/libbson/src/bson/*-private.h",
        ],
    ),
    copts = [
        "-w",
        "-std=gnu11",
    ],
    includes = [
        "src/common/src",
        "src/libbson/src",
        "config/contrib/mongo-c-driver/src/common/src",
        "config/contrib/mongo-c-driver/src/libbson/src",
    ],
    language = "C",
    libcxx_headers = False,
    local_defines = [
        "BSON_COMPILATION",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_GNU_SOURCE",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
        "_POSIX_C_SOURCE=199309L",
        "_XOPEN_SOURCE=600",
    ],
    local_includes = [
        "src/common/src/src",
    ],
)

_MONGOC_PUBLIC_HEADERS = glob(
    ["src/libmongoc/src/mongoc/mongoc*.h"],
    exclude = [
        "src/libmongoc/src/mongoc/*-private.h",
        "src/libmongoc/src/mongoc/mongoc-stream-tls-secure-*.h",
    ],
)

ch_cc_library(
    name = "_libmongoc",
    srcs = glob(["src/libmongoc/src/mongoc/*.c"]) + glob(["src/common/src/*.c"]) + [
        "src/utf8proc-2.11.3/utf8proc.c",
        ":config/contrib/mongo-c-driver/src/libmongoc/src/mongoc/mongoc-config-private.h",
    ] + glob(
        [
            "src/libmongoc/src/mongoc/*.h",
            "src/utf8proc-2.11.3/*.h",
            "src/uthash/**/*.h",
        ],
        exclude = _MONGOC_PUBLIC_HEADERS + [
            "src/libmongoc/src/mongoc/mcd-integer.h",
            "src/libmongoc/src/mongoc/mongoc-cyrus-private.h",
            "src/libmongoc/src/mongoc/mongoc-secure-channel-private.h",
            "src/libmongoc/src/mongoc/mongoc-secure-transport-private.h",
            "src/libmongoc/src/mongoc/mongoc-sspi-private.h",
            "src/libmongoc/src/mongoc/mongoc-stream-tls-secure-channel.h",
            "src/libmongoc/src/mongoc/mongoc-stream-tls-secure-transport.h",
        ],
    ),
    hdrs = [
        ":config/contrib/mongo-c-driver/src/libmongoc/src/mongoc/mongoc-config.h",
        ":config/contrib/mongo-c-driver/src/libmongoc/src/mongoc/mongoc-version.h",
    ] + _MONGOC_PUBLIC_HEADERS,
    copts = [
        "-w",
        "-std=gnu11",
    ],
    implementation_deps = [
        "@clickhouse_openssl//:crypto",
        "@clickhouse_zstd//:_zstd",
    ],
    includes = [
        "src/libmongoc/src",
        "src/libmongoc/src/mongoc",
        "src/utf8proc-2.11.3",
        "src/uthash",
        "config/contrib/mongo-c-driver/src/libmongoc/src/mongoc",
        "config/contrib/mongo-c-driver/src/libmongoc/src",
    ],
    language = "C",
    libcxx_headers = False,
    local_defines = [
        "MONGOC_COMPILATION",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    private_hdrs = [
        "src/libmongoc/src/mongoc/mongoc-counters.defs",
        "src/utf8proc-2.11.3/utf8proc_data.c",
    ],
    deps = [
        ":_libbson",
        "@clickhouse_openssl//:ssl",
    ],
)

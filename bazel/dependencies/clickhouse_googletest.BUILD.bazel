load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel:repository_paths.bzl", "repository_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

_GENERATED_LOCAL_DEFINES_0 = [
    "GTEST_HAS_POSIX_RE=0",
    "STD_EXCEPTION_HAS_STACK_TRACE=1",
    "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
    "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
    "_LIBUNWIND_IS_NATIVE_ONLY",
]

_GENERATED_ADDITIONAL_COMPILER_INPUTS_0 = [
    "@clickhouse_sysroot//:linux_compile_files",
    "googlemock/src/gmock-cardinalities.cc",
    "googlemock/src/gmock-internal-utils.cc",
    "googlemock/src/gmock-matchers.cc",
    "googlemock/src/gmock-spec-builders.cc",
    "googlemock/src/gmock.cc",
]

ch_cc_library(
    name = "_gmock",
    srcs = [
        "googlemock/src/gmock-all.cc",
    ] + glob(
        ["googlemock/**/*.h"],
        exclude = [
            "googlemock/include/gmock/gmock-actions.h",
            "googlemock/include/gmock/gmock-cardinalities.h",
            "googlemock/include/gmock/gmock-function-mocker.h",
            "googlemock/include/gmock/gmock-matchers.h",
            "googlemock/include/gmock/gmock-more-actions.h",
            "googlemock/include/gmock/gmock-more-matchers.h",
            "googlemock/include/gmock/gmock-nice-strict.h",
            "googlemock/include/gmock/gmock-spec-builders.h",
            "googlemock/include/gmock/gmock.h",
            "googlemock/include/gmock/internal/custom/gmock-generated-actions.h",
            "googlemock/include/gmock/internal/custom/gmock-matchers.h",
            "googlemock/include/gmock/internal/custom/gmock-port.h",
            "googlemock/include/gmock/internal/gmock-internal-utils.h",
            "googlemock/include/gmock/internal/gmock-port.h",
            "googlemock/include/gmock/internal/gmock-pp.h",
        ],
    ),
    hdrs = [
        "@clickhouse_sysroot//:linux_native_headers",
    ] + glob([
        "googlemock/include/**/*.h",
        "googletest/include/**/*.h",
    ]),
    additional_compiler_inputs = _GENERATED_ADDITIONAL_COMPILER_INPUTS_0,
    copts = [
        "-w",
        "-std=c++23",
        "-nostdinc++",
        "-I",
        repository_path("contrib/googletest") + "/googlemock",
    ],
    local_defines = _GENERATED_LOCAL_DEFINES_0,
    local_includes = [
        "googlemock/include",
        "googletest/include",
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        ":_gtest",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)

ch_cc_library(
    name = "_gmock_main",
    srcs = [
        "googlemock/src/gmock_main.cc",
    ],
    hdrs = [
        "@clickhouse_sysroot//:linux_native_headers",
    ] + glob([
        "googlemock/include/**/*.h",
        "googletest/include/**/*.h",
    ]),
    additional_compiler_inputs = ["@clickhouse_sysroot//:linux_compile_files"],
    copts = [
        "-w",
        "-std=c++23",
        "-nostdinc++",
    ],
    local_defines = _GENERATED_LOCAL_DEFINES_0,
    local_includes = [
        "googlemock/include",
        "googletest/include",
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        ":_gmock",
        ":_gtest",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)


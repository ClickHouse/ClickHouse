load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["external_include_paths"],
)

ch_cc_library(
    name = "_wnb",
    srcs = glob(["wnb/core/*.cc"]),
    hdrs = [
        "wnb/nltk_similarity.hh",
        "wnb/std_ext.hh",
    ] + glob(["wnb/core/*.hh"]),
    local_defines = [
        "BOOST_ASIO_HAS_STD_INVOKE_RESULT=1",
        "BOOST_ASIO_STANDALONE=1",
        "BOOST_TIMER_ENABLE_DEPRECATED=1",
    ] + CXX_RUNTIME_DEFINES,
    deps = ["@clickhouse_boost//:boost_headers_no_openssl"],
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "aws_c_s3",
    srcs = glob(["source/*.c"]) + glob(
        ["include/aws/s3/private/*.h"],
        exclude = ["include/aws/s3/private/s3_endpoint_resolver.h"],
    ),
    hdrs = glob(
        ["include/**/*.h"],
        exclude = ["include/**/private/**/*.h"],
    ),
    copts = [
        "-w",
        "-std=gnu11",
        "-g1",
    ],
    implementation_deps = [
        "@clickhouse_aws_c_cal//:aws_c_cal",
        "@clickhouse_aws_checksums//:aws_checksums",
        "@clickhouse_aws_c_http//:aws_c_http",
    ],
    includes = ["include"],
    language = "C",
    libcxx_headers = False,
    local_defines = [
        "AWS_AFFINITY_METHOD=AWS_AFFINITY_METHOD_NONE",
        "AWS_ENABLE_EPOLL",
        "AWS_PTHREAD_SETNAME_TAKES_2ARGS",
        "ENABLE_OPENSSL_ENCRYPTION",
        "INTEL_NO_ITTNOTIFY_API",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
    ] + select({
        "@platforms//cpu:x86_64": [
            "USE_SIMD_ENCODING",
        ],
        "@platforms//cpu:aarch64": [],
    }) + [
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = [
        "@clickhouse_aws_c_auth//:aws_c_auth",
        "@clickhouse_aws_c_common//:aws_c_common",
        "@clickhouse_aws_c_io//:aws_c_io",
    ],
)

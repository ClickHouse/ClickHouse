load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
    "include/aws/common/config.h.in",
])

ch_cc_library(
    name = "aws_c_common",
    srcs = ([
        "source/allocator.c",
        "source/allocator_sba.c",
        "source/array_list.c",
        "source/assert.c",
        "source/byte_buf.c",
        "source/cache.c",
        "source/cbor.c",
        "source/codegen.c",
        "source/command_line_parser.c",
        "source/common.c",
        "source/condition_variable.c",
        "source/date_time.c",
        "source/device_random.c",
        "source/encoding.c",
        "source/error.c",
        "source/external/cJSON.c",
        "source/external/libcbor/allocators.c",
        "source/external/libcbor/cbor.c",
        "source/external/libcbor/cbor/arrays.c",
        "source/external/libcbor/cbor/bytestrings.c",
        "source/external/libcbor/cbor/callbacks.c",
        "source/external/libcbor/cbor/common.c",
        "source/external/libcbor/cbor/encoding.c",
        "source/external/libcbor/cbor/floats_ctrls.c",
    ] + glob(["source/external/libcbor/cbor/internal/*.c"]) + ([
        "source/external/libcbor/cbor/ints.c",
        "source/external/libcbor/cbor/maps.c",
        "source/external/libcbor/cbor/serialization.c",
        "source/external/libcbor/cbor/streaming.c",
        "source/external/libcbor/cbor/strings.c",
        "source/external/libcbor/cbor/tags.c",
        "source/fifo_cache.c",
        "source/file.c",
        "source/hash_table.c",
        "source/host_utils.c",
        "source/json.c",
        "source/lifo_cache.c",
        "source/linked_hash_table.c",
        "source/linux/file_direct_io.c",
        "source/linux/system_info.c",
    ] + glob(["source/log_*.c"]) + [
        "source/logging.c",
        "source/lru_cache.c",
        "source/math.c",
        "source/memtrace.c",
    ]) + glob(["source/posix/*.c"]) + [
        "source/priority_queue.c",
        "source/process_common.c",
        "source/ref_count.c",
        "source/ring_buffer.c",
        "source/statistics.c",
        "source/string.c",
        "source/system_info.c",
        "source/task_scheduler.c",
        "source/thread_scheduler.c",
        "source/thread_shared.c",
        "source/uri.c",
        "source/uuid.c",
        "source/xml_parser.c",
    ] + select({
        "@platforms//cpu:x86_64": [
            "source/arch/intel/asm/cpuid.c",
            "source/arch/intel/cpuid.c",
        ],
        "@platforms//cpu:aarch64": ["source/arch/arm/auxv/cpuid.c"],
    }) + glob(["source/external/**/*.h"])),
    copts = [
        "-w",
        "-std=gnu11",
        "-g1",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    language = "C",
    llvm_headers = True,
    local_defines = ([
        "AWS_AFFINITY_METHOD=AWS_AFFINITY_METHOD_NONE",
        "AWS_ENABLE_EPOLL",
        "AWS_PTHREAD_SETNAME_TAKES_2ARGS",
        "ENABLE_OPENSSL_ENCRYPTION",
        "INTEL_NO_ITTNOTIFY_API",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
    ] + select({
        "@platforms//cpu:x86_64": [
            "USE_SIMD_ENCODING",
        ],
        "@platforms//cpu:aarch64": [],
    }) + [
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ]),
    local_includes = [
        "source/external/libcbor/cbor",
        "source/external/libcbor",
    ],
    deps = [":aws_c_common_headers"],
)

ch_cc_library(
    name = "aws_c_common__compile_2",
    srcs = select({
        "@platforms//cpu:x86_64": (["source/arch/intel/encoding_avx2.c"] + glob(["source/external/libcbor/**/*.h"])),
        "@platforms//cpu:aarch64": [],
    }),
    additional_compiler_inputs = select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [],
    }),
    arches = [
        "x86_64",
    ],
    copts = select({
        "@platforms//cpu:x86_64": [
            "-w",
            "-std=gnu11",
            "-g1",
            "-mavx",
            "-mavx2",
        ],
        "@platforms//cpu:aarch64": [],
    }),
    implementation_deps = select({
        "@platforms//cpu:x86_64": ["@clickhouse_llvm_project//:libcxxabi_headers"],
        "@platforms//cpu:aarch64": [],
    }),
    language = "C",
    llvm_headers = True,
    local_defines = select({
        "@platforms//cpu:x86_64": [
            "AWS_AFFINITY_METHOD=AWS_AFFINITY_METHOD_NONE",
            "AWS_ENABLE_EPOLL",
            "AWS_PTHREAD_SETNAME_TAKES_2ARGS",
            "ENABLE_OPENSSL_ENCRYPTION",
            "INTEL_NO_ITTNOTIFY_API",
            "STD_EXCEPTION_HAS_STACK_TRACE=1",
            "USE_SIMD_ENCODING",
            "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
            "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
            "_LIBUNWIND_IS_NATIVE_ONLY",
        ],
        "@platforms//cpu:aarch64": [],
    }),
    local_includes = select({
        "@platforms//cpu:x86_64": [
            "source/external/libcbor/cbor",
            "source/external/libcbor",
        ],
        "@platforms//cpu:aarch64": [],
    }),
    deps = (select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [],
    }) + [":aws_c_common_headers"]),
    alwayslink = select({
        "@platforms//cpu:x86_64": False,
        "@platforms//cpu:aarch64": False,
    }),
)

cc_library(
    name = "aws_c_common_headers",
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.inl",
    ]),
    includes = ["include"],
    deps = ["@clickhouse_aws//:aws_config_headers"],
)

load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
    "include/aws/http/connection.h",
    "include/aws/http/connection_manager.h",
    "include/aws/http/exports.h",
    "include/aws/http/http.h",
    "include/aws/http/http2_stream_manager.h",
    "include/aws/http/private/connection_impl.h",
    "include/aws/http/private/connection_manager_system_vtable.h",
    "include/aws/http/private/connection_monitor.h",
    "include/aws/http/private/h1_connection.h",
    "include/aws/http/private/h1_decoder.h",
    "include/aws/http/private/h1_encoder.h",
    "include/aws/http/private/h1_stream.h",
    "include/aws/http/private/h2_connection.h",
    "include/aws/http/private/h2_decoder.h",
    "include/aws/http/private/h2_frames.h",
    "include/aws/http/private/h2_stream.h",
    "include/aws/http/private/hpack.h",
    "include/aws/http/private/hpack_header_static_table.def",
    "include/aws/http/private/hpack_huffman_static_table.def",
    "include/aws/http/private/http2_stream_manager_impl.h",
    "include/aws/http/private/http_impl.h",
    "include/aws/http/private/no_proxy.h",
    "include/aws/http/private/proxy_impl.h",
    "include/aws/http/private/random_access_set.h",
    "include/aws/http/private/request_response_impl.h",
    "include/aws/http/private/strutil.h",
    "include/aws/http/private/websocket_decoder.h",
    "include/aws/http/private/websocket_encoder.h",
    "include/aws/http/private/websocket_impl.h",
    "include/aws/http/proxy.h",
    "include/aws/http/request_response.h",
    "include/aws/http/server.h",
    "include/aws/http/statistics.h",
    "include/aws/http/status_code.h",
    "include/aws/http/websocket.h",
])

ch_cc_library(
    name = "aws_c_http",
    srcs = glob(["source/*.c"]),
    hdrs = ["@clickhouse_sysroot//:linux_native_headers"],
    additional_compiler_inputs = [
        "@clickhouse_sysroot//:linux_compile_files",
        "@clickhouse_llvm_project//:runtime_source_inputs",
        "@clickhouse_llvm_project//:runtime_generated_headers",
    ],
    copts = [
        "-w",
        "-std=gnu11",
        "-g1",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"] + [] + ["@clickhouse_aws_c_cal//:aws_c_cal_headers"],
    language = "C",
    local_defines = ([
        "AWS_AFFINITY_METHOD=AWS_AFFINITY_METHOD_NONE",
        "AWS_ENABLE_EPOLL",
        "AWS_PTHREAD_SETNAME_TAKES_2ARGS",
        "ENABLE_OPENSSL_ENCRYPTION",
        "INTEL_NO_ITTNOTIFY_API",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
    ] + select({
        "@platforms//cpu:x86_64": [
            "USE_SIMD_ENCODING",
        ],
        "@platforms//cpu:aarch64": [],
    }) + [
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ]),
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        ":aws_c_http_headers",
    ],
    alwayslink = False,
)

cc_library(
    name = "aws_c_http_headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    textual_hdrs = ["include/aws/http/private/hpack_header_static_table.def"],
    deps = [
        "@clickhouse_aws_c_common//:aws_c_common_headers",
        "@clickhouse_aws_c_compression//:aws_c_compression_headers",
        "@clickhouse_aws_c_io//:aws_c_io_headers",
    ],
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_roaring__compile_0",
    srcs = [
        "src/array_util.c",
        "src/bitset.c",
        "src/bitset_util.c",
        "src/isadetection.c",
        "src/memory.c",
        "src/roaring64.c",
        "src/roaring_array.c",
        "src/roaring_priority_queue.c",
        "src/art/art.c",
    ] + glob(["src/containers/*.c"]),
    hdrs = glob(["include/**/*.h"]),
    includes = [
        "include",
    ],
    language = "C",
)

ch_cc_library(
    name = "_roaring__compile_1",
    srcs = [
        "src/roaring.c",
        "@clickhouse//contrib/croaring-cmake:page_aligned_functions.h",
    ],
    copts = [
        "-w",
        "-std=gnu11",
        "-include",
        "contrib/croaring-cmake/page_aligned_functions.h",
    ],
    implementation_deps = [
        ":_roaring__compile_0",
    ],
    language = "C",
)

cc_library(
    name = "_roaring",
    hdrs = glob(["cpp/**/*.hh"]),
    includes = [
        "cpp",
    ],
    deps = [
        ":_roaring__compile_0",
        ":_roaring__compile_1",
    ],
)

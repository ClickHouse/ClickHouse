load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

_ROARING_LOCAL_DEFINES = select({
    "@platforms//cpu:x86_64": [],
    "@platforms//cpu:aarch64": [
        "ARM_ACLE",
        "ARM_ASM_HWCAP",
        "ARM_AUXV_HAS_CRC32",
        "ARM_AUXV_HAS_NEON",
        "ARM_FEATURES",
        "ARM_NEON",
        "ARM_NEON_HASLD4",
    ],
}) + [
    "BOOST_ASIO_HAS_STD_INVOKE_RESULT=1",
    "BOOST_ASIO_STANDALONE=1",
    "BOOST_TIMER_ENABLE_DEPRECATED=1",
    "ENABLE_DISTRIBUTED_CACHE=0",
    "FIU_ENABLE",
] + select({
    "@platforms//cpu:x86_64": [],
    "@platforms//cpu:aarch64": [
        "HAVE_ARM_ACLE_H",
    ],
}) + [
    "HAVE_ATTRIBUTE_ALIGNED",
    "HAVE_BUILTIN_CTZ",
    "HAVE_BUILTIN_CTZLL",
    "HAVE_CONFIG_H",
    "HAVE_POSIX_MEMALIGN",
] + select({
    "@platforms//cpu:x86_64": [],
    "@platforms//cpu:aarch64": [
        "HAVE_SYS_AUXV_H",
    ],
}) + [
    "HAVE_VISIBILITY_HIDDEN",
    "HAVE_VISIBILITY_INTERNAL",
    "JEMALLOC_NO_RENAME",
    "PICOJSON_USE_LOCALE=0",
    "POCO_ENABLE_CPP11",
    "POCO_OS_FAMILY_UNIX",
    "STD_EXCEPTION_HAS_STACK_TRACE=1",
    "UNALIGNED_OK",
    "WITH_COVERAGE=0",
    "WITH_COVERAGE_DEPTH=0",
    "WITH_GZFILEOP",
    "X86_64",
] + select({
    "@platforms//cpu:x86_64": [
        "X86_AVX2",
        "X86_FEATURES",
        "X86_PCLMULQDQ_CRC",
        "X86_SSE2",
        "X86_SSE42",
        "X86_SSSE3",
    ],
    "@platforms//cpu:aarch64": [],
}) + [
    "ZLIB_COMPAT",
    "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
    "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
    "_LIBUNWIND_IS_NATIVE_ONLY",
]

_ROARING_LOCAL_INCLUDES = [
    "cpp",
    "include",
]

ch_cc_library(
    name = "_roaring__compile_0",
    srcs = [
        "src/array_util.c",
        "src/bitset.c",
        "src/bitset_util.c",
        "src/isadetection.c",
        "src/memory.c",
        "src/roaring64.c",
        "src/roaring_array.c",
        "src/roaring_priority_queue.c",
        "src/art/art.c",
    ] + glob(["src/containers/*.c"]),
    hdrs = glob(["include/**/*.h"]),
    copts = [
        "-w",
        "-std=gnu11",
    ],
    includes = [
        "cpp",
        "include",
    ],
    language = "C",
    local_defines = _ROARING_LOCAL_DEFINES,
    local_includes = [
        "include/roaring",
    ] + _ROARING_LOCAL_INCLUDES,
)

ch_cc_library(
    name = "_roaring__compile_1",
    srcs = [
        "src/roaring.c",
        "@clickhouse//contrib/croaring-cmake:page_aligned_functions.h",
    ],
    copts = [
        "-w",
        "-std=gnu11",
        "-include",
        "contrib/croaring-cmake/page_aligned_functions.h",
    ],
    implementation_deps = [":_roaring__compile_0"],
    language = "C",
    local_defines = _ROARING_LOCAL_DEFINES,
    local_includes = [
        "include/roaring",
    ] + _ROARING_LOCAL_INCLUDES,
)

cc_library(
    name = "_roaring",
    hdrs = glob(["cpp/**/*.hh"]),
    deps = [
        ":_roaring__compile_0",
        ":_roaring__compile_1",
    ],
)

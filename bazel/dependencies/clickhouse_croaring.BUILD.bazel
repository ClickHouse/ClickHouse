    local_defines = _ROARING_LOCAL_DEFINES,
    local_includes = [
        "include/roaring",
    ] + _ROARING_LOCAL_INCLUDES,
    deps = ["@clickhouse_boost//:boost_headers", "@clickhouse_fmtlib//:_fmt", "@clickhouse_aws_c_mqtt//:aws_c_mqtt", "@clickhouse_fast_float//:fast_float", "@clickhouse_jwt_cpp//:jwt_cpp", "@clickhouse_libdivide//:libdivide", "@clickhouse_magic_enum//:magic_enum", "@clickhouse_miniselect//:miniselect", "@clickhouse_msgpack_c//:msgpack_c", "@clickhouse_pocketfft//:pocketfft", "@clickhouse_sparsehash_c11//:sparsehash_c11", "@clickhouse_google_protobuf//:_libprotobuf", "@clickhouse_libssh//:_ssh", "@clickhouse//contrib/cityhash102:_cityhash", "@clickhouse//contrib/driftsort:headers", "@clickhouse//contrib/ipnsort:headers", "@clickhouse//contrib/pdqsort:headers"],
)

ch_cc_library(
    name = "_roaring__compile_1",
    srcs = [
        "src/roaring.c",
    ] + glob(["src/*.h"]),
    hdrs = [
        "@clickhouse_liburing//:config/contrib/liburing/src/include-compat/liburing/compat.h",
        "@clickhouse_liburing//:config/contrib/liburing/src/include/liburing/io_uring_version.h",
        "@clickhouse_snappy//:config/contrib/snappy-cmake/config.h",
        "@clickhouse_snappy//:config/contrib/snappy-cmake/snappy-stubs-public.h",
    ] + _ROARING_HDRS + glob([
        "cpp/**/*.hh",
        "include/**/*.h",
    ]),
    copts = [
        "-w",
        "-std=gnu11",
        "-include",
        "contrib/croaring-cmake/page_aligned_functions.h",
    ],
    implementation_deps = (["@clickhouse_llvm_project//:libcxxabi_headers"]) + ["@clickhouse//base:base_headers", "@clickhouse//src:headers", "@clickhouse_cctz//:_cctz", "@clickhouse_re2//:_re2", "@clickhouse_libfiu//:_libfiu", "@clickhouse_zstd//:_zstd", "@clickhouse_crc32c//:_crc32c", "@clickhouse_libarchive//:_libarchive"],
    language = "C",
    local_defines = _ROARING_LOCAL_DEFINES,
    local_includes = [
        "include/roaring",
    ] + _ROARING_LOCAL_INCLUDES,
    deps = ["@clickhouse_boost//:boost_headers", "@clickhouse_fmtlib//:_fmt", "@clickhouse_aws_c_mqtt//:aws_c_mqtt", "@clickhouse_fast_float//:fast_float", "@clickhouse_jwt_cpp//:jwt_cpp", "@clickhouse_libdivide//:libdivide", "@clickhouse_magic_enum//:magic_enum", "@clickhouse_miniselect//:miniselect", "@clickhouse_msgpack_c//:msgpack_c", "@clickhouse_pocketfft//:pocketfft", "@clickhouse_sparsehash_c11//:sparsehash_c11", "@clickhouse_google_protobuf//:_libprotobuf", "@clickhouse_libssh//:_ssh", "@clickhouse//contrib/cityhash102:_cityhash", "@clickhouse//contrib/croaring-cmake:headers", "@clickhouse//contrib/driftsort:headers", "@clickhouse//contrib/ipnsort:headers", "@clickhouse//contrib/pdqsort:headers"],
)

cc_library(
    name = "_roaring",
    deps = [
        "@clickhouse//base:common",
        ":_roaring__compile_0",
        ":_roaring__compile_1",
    ],
)

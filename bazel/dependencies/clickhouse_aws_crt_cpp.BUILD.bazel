load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
    "include/aws/crt/Config.h.in",
])

ch_cc_library(
    name = "aws_crt_cpp",
    srcs = (glob(["source/*.cpp"]) + [
        "source/auth/Credentials.cpp",
        "source/auth/Sigv4Signing.cpp",
        "source/cbor/Cbor.cpp",
        "source/checksum/CRC.cpp",
        "source/checksum/XXHash.cpp",
    ] + glob(["source/crypto/*.cpp"]) + [
        "source/endpoints/BddEngine.cpp",
        "source/endpoints/RuleEngine.cpp",
    ] + glob(["source/http/*.cpp"]) + glob(["source/io/*.cpp"])),
    copts = [
        "-w",
        "-std=c++23",
        "-g1",
    ],
    implementation_deps = [
        "@clickhouse_aws_c_event_stream//:aws_c_event_stream_headers",
        "@clickhouse_aws_c_s3//:aws_c_s3_headers",
        "@clickhouse_aws_checksums//:aws_checksums_headers",
    ],
    local_defines = ([
        "AWS_AFFINITY_METHOD=AWS_AFFINITY_METHOD_NONE",
        "AWS_ENABLE_EPOLL",
        "AWS_PTHREAD_SETNAME_TAKES_2ARGS",
        "ENABLE_OPENSSL_ENCRYPTION",
        "INTEL_NO_ITTNOTIFY_API",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
    ] + select({
        "@platforms//cpu:x86_64": [
            "USE_SIMD_ENCODING",
        ],
        "@platforms//cpu:aarch64": [],
    }) + [
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ]),
    deps = [":aws_crt_cpp_headers"],
    alwayslink = False,
)

cc_library(
    name = "aws_crt_cpp_headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    deps = [
        "@clickhouse_aws_c_auth//:aws_c_auth_headers",
        "@clickhouse_aws_c_cal//:aws_c_cal_headers",
        "@clickhouse_aws_c_mqtt//:aws_c_mqtt",
    ],
)

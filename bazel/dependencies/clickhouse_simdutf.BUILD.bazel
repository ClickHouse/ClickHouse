load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE-MIT",
])

ch_cc_library(
    name = "_simdutf",
    srcs = [
        "src/simdutf.cpp",
    ] + glob(["src/**/*.h"]),
    hdrs = glob(["include/**/*.h"]),
    additional_compiler_inputs = (glob(
        [
            "include/**",
            "src/**",
        ],
        exclude = [
            "include/**/*.h",
            "src/**/*.h",
            "src/simdutf.cpp",
        ],
    ) + [
    ]),
    copts = ["-w", "-std=c++23"],
    includes = [
        "include",
    ],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "include",
        "src",
    ],
    deps = ["@clickhouse//:clang_rt_builtins"],
    alwayslink = False,
)

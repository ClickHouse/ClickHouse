            "ARM_AUXV_HAS_NEON",
            "ARM_FEATURES",
            "ARM_NEON",
            "ARM_NEON_HASLD4",
            "HAVE_ARM_ACLE_H",
            "HAVE_ATTRIBUTE_ALIGNED",
            "HAVE_BUILTIN_CTZ",

        "SAX2.c",
        "threads.c",
        "tree.c",
        "uri.c",
        "valid.c",
        "xmlIO.c",
        "xmlmemory.c",
        "xmlstring.c",
        "pattern.c",
        "xmlreader.c",
        "xinclude.c",
        "xpath.c",
        "xlink.c",
        "xpointer.c",
        "xmlschemas.c",
        "xmlschemastypes.c",
        "xmlregexp.c",
        "relaxng.c",
        "catalog.c",
        "HTMLparser.c",

load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel:repository_paths.bzl", "repository_local_include", "repository_path")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE.txt",
])

ch_cc_library(
    name = "_avrocpp",
    srcs = [
        "lang/c++/impl/Compiler.cc",
        "lang/c++/impl/Node.cc",
        "lang/c++/impl/LogicalType.cc",
        "lang/c++/impl/NodeImpl.cc",
        "lang/c++/impl/ResolverSchema.cc",
        "lang/c++/impl/Schema.cc",
        "lang/c++/impl/Types.cc",
        "lang/c++/impl/ValidSchema.cc",
        "lang/c++/impl/Zigzag.cc",
        "lang/c++/impl/BinaryEncoder.cc",
        "lang/c++/impl/BinaryDecoder.cc",
        "lang/c++/impl/Stream.cc",
        "lang/c++/impl/FileStream.cc",
        "lang/c++/impl/Generic.cc",
        "lang/c++/impl/GenericDatum.cc",
        "lang/c++/impl/DataFile.cc",
        "lang/c++/impl/parsing/Symbol.cc",
        "lang/c++/impl/parsing/ValidatingCodec.cc",
        "lang/c++/impl/parsing/JsonCodec.cc",
        "lang/c++/impl/parsing/ResolvingDecoder.cc",
        "lang/c++/impl/json/JsonIO.cc",
        "lang/c++/impl/json/JsonDom.cc",
        "lang/c++/impl/Resolver.cc",
        "lang/c++/impl/Validator.cc",
    ] + glob(["lang/c++/impl/**/*.hh"]),
    hdrs = select({
        "@platforms//cpu:x86_64": ([
            "@clickhouse_sysroot//:linux_native_headers",
        ] + glob(["lang/c++/api/**/*.hh"])),
        "@platforms//cpu:aarch64": ([
            "@clickhouse_sysroot//:linux_native_headers",
        ] + glob(["lang/c++/api/**/*.hh"])),
    }),
    additional_compiler_inputs = [
        "@clickhouse_sysroot//:linux_compile_files",
    ],
    copts = [
        "-w",
        "-std=c++17",
        "-nostdinc++",
    ],
    local_defines = [
        "BOOST_ASIO_HAS_STD_INVOKE_RESULT=1",
        "BOOST_ASIO_STANDALONE=1",
        "BOOST_TIMER_ENABLE_DEPRECATED=1",
        "SNAPPY_CODEC_AVAILABLE",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = ([
        "lang/c++/api",
    ] + select({
        "@platforms//cpu:x86_64": [
            repository_local_include(
                "$(GENDIR)/" + repository_path("contrib/snappy") + "/config/x86_64/contrib/snappy-cmake",
                "contrib/avro",
            ),
        ],
        "@platforms//cpu:aarch64": [
            repository_local_include(
                "$(GENDIR)/" + repository_path("contrib/snappy") + "/config/aarch64/contrib/snappy-cmake",
                "contrib/avro",
            ),
        ],
    })),
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse_boost//:boost_headers",
        "@clickhouse_boost//:_boost_iostreams",
        "@clickhouse_snappy//:_snappy",
        "@clickhouse_zlib_ng//:_zlib",
        "@clickhouse_zstd//:_zstd",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)

load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "COPYING",
])

expand_template(
    name = "configure_include_linux_jemalloc_internal_jemalloc_internal_defs_h",
    out = "config/contrib/jemalloc-cmake/include_linux/jemalloc/internal/jemalloc_internal_defs.h",
    substitutions = {
        "@JEMALLOC_CONFIG_MALLOC_CONF@": "percpu_arena:percpu,oversize_threshold:67108864,muzzy_decay_ms:0,dirty_decay_ms:5000,prof:true,prof_active:true,prof_thread_active_init:false,background_thread:true,lg_extent_max_active_fit:6",
    } | select({
        "@platforms//cpu:x86_64": {},
        "@platforms//cpu:aarch64": {
            "@JEMALLOC_LG_HUGEPAGE@": "29",
            "@JEMALLOC_LG_PAGE@": "16",
        },
    }),
    template = select({
        "@platforms//cpu:x86_64": "@clickhouse//contrib/jemalloc-cmake:include_linux_x86_64/jemalloc/internal/jemalloc_internal_defs.h.in",
        "@platforms//cpu:aarch64": "@clickhouse//contrib/jemalloc-cmake:include_linux_aarch64/jemalloc/internal/jemalloc_internal_defs.h.in",
    }),
)

ch_cc_library(
    name = "_jemalloc",
    srcs = [
        "src/arena.c",
        "src/background_thread.c",
        "src/base.c",
        "src/bin.c",
        "src/bin_info.c",
        "src/bitmap.c",
        "src/buf_writer.c",
        "src/cache_bin.c",
        "src/ckh.c",
        "src/conf.c",
        "src/counter.c",
        "src/ctl.c",
        "src/decay.c",
        "src/div.c",
        "src/ecache.c",
        "src/edata.c",
        "src/edata_cache.c",
        "src/ehooks.c",
        "src/emap.c",
        "src/eset.c",
        "src/exp_grow.c",
        "src/extent.c",
        "src/extent_dss.c",
        "src/extent_mmap.c",
        "src/fxp.c",
        "src/hook.c",
        "src/hpa.c",
    ] + glob(["src/hpa_*.c"]) + [
        "src/hpdata.c",
        "src/inspect.c",
        "src/jemalloc.c",
        "src/large.c",
        "src/log.c",
        "src/malloc_io.c",
        "src/mutex.c",
        "src/nstime.c",
        "src/pa.c",
        "src/pac.c",
        "src/pa_extra.c",
        "src/pages.c",
        "src/peak_event.c",
        "src/prof.c",
        "src/prof_data.c",
        "src/prof_log.c",
        "src/prof_recent.c",
        "src/prof_stats.c",
        "src/prof_stack_range.c",
        "src/prof_sys.c",
        "src/psset.c",
        "src/rtree.c",
        "src/safety_check.c",
        "src/san_bump.c",
        "src/san.c",
        "src/sc.c",
        "src/sec.c",
        "src/stats.c",
        "src/sz.c",
        "src/tcache.c",
        "src/test_hooks.c",
        "src/thread_event.c",
        "src/thread_event_registry.c",
        "src/ticker.c",
        "src/tsd.c",
        "src/util.c",
        "src/witness.c",
        ":config/contrib/jemalloc-cmake/include_linux/jemalloc/internal/jemalloc_internal_defs.h",
    ] + glob(["include/**/*.h"]),
    copts = [
        "-w",
        "-std=gnu11",
        "-D_GNU_SOURCE",
    ],
    implementation_deps = [
        "@clickhouse_llvm_project//:libcxxabi_headers",
        "@llvm-project//libunwind:headers",
    ],
    language = "C",
    local_defines = [
        "JEMALLOC_NO_PRIVATE_NAMESPACE",
        "JEMALLOC_PROF=1",
        "JEMALLOC_PROF_LIBUNWIND=1",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "include",
        "config/contrib/jemalloc-cmake/include_linux/jemalloc/internal",
    ],
    deps = [
        "@clickhouse//contrib/jemalloc-cmake:headers",
        "@clickhouse_llvm_project//:clang_rt_builtins",
    ],
)

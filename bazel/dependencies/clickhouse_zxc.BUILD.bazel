load("@clickhouse//bazel/dependencies:zxc.bzl", "zxc_cc_library")
load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_zxc",
    srcs = [
        "src/lib/zxc_common.c",
        "src/lib/zxc_pivco_tables.c",
        "src/lib/zxc_dict.c",
        "src/lib/zxc_driver.c",
        "src/lib/zxc_dispatch.c",
        "src/lib/zxc_pstream.c",
        "src/lib/zxc_seekable.c",
    ] + glob(["src/lib/**/*.h"]),
    hdrs = glob(["include/**/*.h"]),
    implementation_deps = select({
        "@platforms//cpu:x86_64": [
            ":_zxc_compress_avx2",
            ":_zxc_compress_avx512",
            ":_zxc_compress_default",
            ":_zxc_decompress_avx2",
            ":_zxc_decompress_avx512",
            ":_zxc_decompress_default",
            ":_zxc_huffman_avx2",
            ":_zxc_huffman_avx512",
        ],
        "@platforms//cpu:aarch64": [
            ":_zxc_compress_default",
            ":_zxc_decompress_default",
        ],
    }) + [":_zxc_huffman_default"],
    includes = ["include"],
    language = "C",
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "ZXC_STATIC_DEFINE",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "src/lib",
        "src/lib/vendors",
    ],
)

_ZXC_X86_ONLY = select({
    "@platforms//cpu:x86_64": [],
    "@platforms//cpu:aarch64": [
        "@platforms//:incompatible",
    ],
})

_ZXC_PRIVATE_HEADERS = [
    "include/zxc_buffer.h",
    "include/zxc_constants.h",
    "include/zxc_error.h",
    "include/zxc_export.h",
    "include/zxc_opts.h",
    "include/zxc_seekable.h",
    "src/lib/vendors/rapidhash.h",
    "src/lib/zxc_deps.h",
    "src/lib/zxc_internal.h",
]

_ZXC_COMPRESS_SRCS = ["src/lib/zxc_compress.c"] + _ZXC_PRIVATE_HEADERS

zxc_cc_library(
    name = "_zxc_compress_avx2",
    srcs = _ZXC_COMPRESS_SRCS,
    arches = ["x86_64"],
    target_compatible_with = _ZXC_X86_ONLY,
    variant = "avx2",
)

zxc_cc_library(
    name = "_zxc_compress_avx512",
    srcs = _ZXC_COMPRESS_SRCS,
    arches = ["x86_64"],
    target_compatible_with = _ZXC_X86_ONLY,
    variant = "avx512",
)

zxc_cc_library(
    name = "_zxc_compress_default",
    srcs = _ZXC_COMPRESS_SRCS,
)

_ZXC_DECOMPRESS_SRCS = ["src/lib/zxc_decompress.c"] + _ZXC_PRIVATE_HEADERS

zxc_cc_library(
    name = "_zxc_decompress_avx2",
    srcs = _ZXC_DECOMPRESS_SRCS,
    arches = ["x86_64"],
    target_compatible_with = _ZXC_X86_ONLY,
    variant = "avx2",
)

zxc_cc_library(
    name = "_zxc_decompress_avx512",
    srcs = _ZXC_DECOMPRESS_SRCS,
    arches = ["x86_64"],
    target_compatible_with = _ZXC_X86_ONLY,
    variant = "avx512",
)

zxc_cc_library(
    name = "_zxc_decompress_default",
    srcs = _ZXC_DECOMPRESS_SRCS,
)

_ZXC_HUFFMAN_SRCS = ["src/lib/zxc_huffman.c"] + _ZXC_PRIVATE_HEADERS + ["src/lib/zxc_pivco_tables.h"]

zxc_cc_library(
    name = "_zxc_huffman_avx2",
    srcs = _ZXC_HUFFMAN_SRCS,
    arches = ["x86_64"],
    target_compatible_with = _ZXC_X86_ONLY,
    variant = "avx2",
)

zxc_cc_library(
    name = "_zxc_huffman_avx512",
    srcs = _ZXC_HUFFMAN_SRCS,
    arches = ["x86_64"],
    target_compatible_with = _ZXC_X86_ONLY,
    variant = "avx512",
)

zxc_cc_library(
    name = "_zxc_huffman_default",
    srcs = _ZXC_HUFFMAN_SRCS,
)

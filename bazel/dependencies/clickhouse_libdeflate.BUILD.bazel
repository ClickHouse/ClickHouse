load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["external_include_paths"],
)

exports_files([
    "COPYING",
])

ch_cc_library(
    name = "_libdeflate",
    srcs = [
        "lib/utils.c",
        "lib/arm/cpu_features.c",
        "lib/x86/cpu_features.c",
        "lib/deflate_compress.c",
        "lib/deflate_decompress.c",
        "lib/adler32.c",
        "lib/zlib_compress.c",
        "lib/zlib_decompress.c",
        "lib/crc32.c",
        "lib/gzip_compress.c",
        "lib/gzip_decompress.c",
    ],
    hdrs = glob(["**/*.h"]),
    additional_compiler_inputs = [
        "@clickhouse_llvm_project//:runtime_source_inputs",
        "@clickhouse_llvm_project//:runtime_generated_headers",
    ],
    copts = [
        "-w",
        "-std=gnu11",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    includes = [
        ".",
    ],
    language = "C",
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        ".",
    ],
    deps = ["@clickhouse//:clang_rt_builtins"],
    alwayslink = False,
)

_KRB5_HEADER_PARTS = ["src/include/krb5/krb5.hin"] + [
    "config/contrib/krb5-cmake/include_private/lib/krb5/error_tables/" + table + ".h"
    for table in [
        "krb5_err",
        "k5e1_err",
        "kdb5_err",
        "kv5m_err",
        "krb524_err",
        "asn1_err",
    ]
]

genrule(
    name = "generate_contrib_krb5_cmake_include_krb5_krb5_h",
    srcs = _KRB5_HEADER_PARTS,
    outs = ["config/contrib/krb5-cmake/include/krb5/krb5.h"],
    cmd = "cat " + " ".join(['"$(location %s)"' % part for part in _KRB5_HEADER_PARTS]) + ' > "$@"',
)


load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")

exports_files([
    "LICENSE",
    "build/mkversion",
])

copy_file(
    name = "lber_types",
    src = select({
        "@clickhouse//contrib/openldap-cmake:linux_x86_64": "@clickhouse//contrib/openldap-cmake:linux_x86_64/include/lber_types.h",
        "@clickhouse//contrib/openldap-cmake:linux_aarch64": "@clickhouse//contrib/openldap-cmake:linux_aarch64/include/lber_types.h",
    }),
    out = "include/lber_types.h",
    allow_symlink = True,
)

copy_file(
    name = "ldap_features",
    src = select({
        "@clickhouse//contrib/openldap-cmake:linux_x86_64": "@clickhouse//contrib/openldap-cmake:linux_x86_64/include/ldap_features.h",
        "@clickhouse//contrib/openldap-cmake:linux_aarch64": "@clickhouse//contrib/openldap-cmake:linux_aarch64/include/ldap_features.h",
    }),
    out = "include/ldap_features.h",
    allow_symlink = True,
)

copy_file(
    name = "ldap_config",
    src = select({
        "@clickhouse//contrib/openldap-cmake:linux_x86_64": "@clickhouse//contrib/openldap-cmake:linux_x86_64/include/ldap_config.h",
        "@clickhouse//contrib/openldap-cmake:linux_aarch64": "@clickhouse//contrib/openldap-cmake:linux_aarch64/include/ldap_config.h",
    }),
    out = "include/ldap_config.h",
    allow_symlink = True,
)

copy_file(
    name = "portable",
    src = select({
        "@clickhouse//contrib/openldap-cmake:linux_x86_64": "@clickhouse//contrib/openldap-cmake:linux_x86_64/include/portable.h",
        "@clickhouse//contrib/openldap-cmake:linux_aarch64": "@clickhouse//contrib/openldap-cmake:linux_aarch64/include/portable.h",
    }),
    out = "include/portable.h",
    allow_symlink = True,
)

# liblber and libldap both include these implementation headers.

_OPENLDAP_PRIVATE_HEADERS = [
    ":ldap_config",
    ":portable",
    "include/ac/assert.h",
    "include/ac/ctype.h",
    "include/ac/errno.h",
    "include/ac/fdset.h",
    "include/ac/localize.h",
    "include/ac/socket.h",
    "include/ac/stdarg.h",
    "include/ac/stdlib.h",
    "include/ac/string.h",
    "include/ac/time.h",
    "include/ac/unistd.h",
    "include/lber_pvt.h",
    "include/ldap_defaults.h",
    "include/ldap_log.h",
    "include/ldap_queue.h",
    "include/lutil.h",
    "include/lutil_lockf.h",
    "libraries/liblber/lber-int.h",
]

ch_cc_library(
    name = "_lber",
    srcs = [
        "libraries/liblber/assert.c",
        "libraries/liblber/decode.c",
        "libraries/liblber/encode.c",
        "libraries/liblber/io.c",
        "libraries/liblber/bprint.c",
        "libraries/liblber/debug.c",
        "libraries/liblber/memory.c",
        "libraries/liblber/options.c",
        "libraries/liblber/sockbuf.c",
        "libraries/liblber/stdio.c",
        "@clickhouse//bazel:gen/contrib/openldap-cmake/lber-version.c",
    ] + _OPENLDAP_PRIVATE_HEADERS,
    hdrs = [
        ":lber_types",
        ":ldap_features",
        "include/lber.h",
        "include/ldap_cdefs.h",
    ],
    includes = ["include"],
    language = "C",
    local_defines = [
        "LBER_LIBRARY",
    ] + CXX_RUNTIME_DEFINES,
    local_includes = ["libraries/liblber"],
    visibility = ["//visibility:public"],
)


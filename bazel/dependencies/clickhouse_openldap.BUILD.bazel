        "libraries/liblber/options.c",
        "libraries/liblber/sockbuf.c",
        "libraries/liblber/stdio.c",
    ] + select({
        "@platforms//cpu:x86_64": [
            "@clickhouse//bazel:gen/x86_64/contrib/openldap-cmake/lber-version.c",
        ],
        "@platforms//cpu:aarch64": [
            "@clickhouse//bazel:gen/aarch64/contrib/openldap-cmake/lber-version.c",
        ],
    })),
    hdrs = select({
        "@platforms//cpu:x86_64": ([
            "@clickhouse_sysroot//:linux_native_headers",
            "@clickhouse//:contrib/openldap-cmake/linux_x86_64/include/lber_types.h",
            "@clickhouse//:contrib/openldap-cmake/linux_x86_64/include/ldap_config.h",
            "@clickhouse//:contrib/openldap-cmake/linux_x86_64/include/ldap_features.h",
            "@clickhouse//:contrib/openldap-cmake/linux_x86_64/include/portable.h",
        ] + glob([
            "include/**/*.h",
            "libraries/liblber/**/*.h",
            "libraries/liblunicode/ucdata/**/*.h",
        ])),
        "@platforms//cpu:aarch64": ([
            "@clickhouse_sysroot//:linux_native_headers",
            "@clickhouse//:contrib/openldap-cmake/linux_aarch64/include/lber_types.h",
            "@clickhouse//:contrib/openldap-cmake/linux_aarch64/include/ldap_config.h",
            "@clickhouse//:contrib/openldap-cmake/linux_aarch64/include/ldap_features.h",
            "@clickhouse//:contrib/openldap-cmake/linux_aarch64/include/portable.h",
        ] + glob([
            "include/**/*.h",
            "libraries/liblber/**/*.h",
            "libraries/liblunicode/ucdata/**/*.h",
        ])),
    }),
    additional_compiler_inputs = [
        "@clickhouse_sysroot//:linux_compile_files",
        "@clickhouse_llvm_project//:runtime_source_inputs",
        "@clickhouse_llvm_project//:runtime_generated_headers",
        "libraries/liblber/debug.c",
    ],
    copts = [
        "-w",
        "-std=gnu11",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    language = "C",
    local_defines = [
        "LBER_LIBRARY",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = (select({
        "@platforms//cpu:x86_64": [
            repository_local_include("contrib/openldap-cmake/linux_x86_64/include", "contrib/openldap"),
        ],
        "@platforms//cpu:aarch64": [
            repository_local_include("contrib/openldap-cmake/linux_aarch64/include", "contrib/openldap"),
        ],
    }) + [
        "include",
        "libraries/liblber",
    ]),
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse_openssl//:crypto",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        "@clickhouse_openssl//:ssl",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)


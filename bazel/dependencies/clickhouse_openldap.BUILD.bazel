load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
    "build/mkversion",
])

# These are include fragments of the ClickHouse-generated portable.h.
# Only that configuration owner may refer to their source labels.
exports_files(
    [
        "include/ac/assert.h",
        "include/ac/fdset.h",
        "include/ac/localize.h",
    ],
    visibility = ["@clickhouse//contrib/openldap-cmake:__pkg__"],
)

cc_library(
    name = "_config_support",
    hdrs = ["include/ldap_cdefs.h"],
    includes = ["include"],
)

# liblber/debug.c includes ldap_pvt.h -> openldap.h -> ldap.h -> lber.h.
# libldap also includes liblber/lber-int.h, so the shared declarations cannot
# be owned by libldap without a dependency cycle between the two archives.
cc_library(
    name = "_api",
    hdrs = [
        "include/lber.h",
        "include/ldap.h",
        "include/openldap.h",
    ],
    includes = ["include"],
    deps = [
        "@clickhouse//contrib/openldap-cmake:headers",
    ],
)

ch_cc_library(
    name = "_lber",
    srcs = [
        "libraries/liblber/assert.c",
        "libraries/liblber/decode.c",
        "libraries/liblber/encode.c",
        "libraries/liblber/io.c",
        "libraries/liblber/bprint.c",
        "libraries/liblber/debug.c",
        "libraries/liblber/memory.c",
        "libraries/liblber/options.c",
        "libraries/liblber/sockbuf.c",
        "libraries/liblber/stdio.c",
        "@clickhouse//bazel:gen/contrib/openldap-cmake/lber-version.c",
    ],
    hdrs = [
        "include/ac/ctype.h",
        "include/ac/errno.h",
        "include/ac/signal.h",
        "include/ac/socket.h",
        "include/ac/stdarg.h",
        "include/ac/stdlib.h",
        "include/ac/string.h",
        "include/ac/syslog.h",
        "include/ac/time.h",
        "include/ac/unistd.h",
        "include/getopt-compat.h",
        "include/lber_pvt.h",
        "include/ldap_defaults.h",
        "include/ldap_log.h",
        "include/ldap_queue.h",
        "include/lutil.h",
        "include/lutil_lockf.h",
        "libraries/liblber/lber-int.h",
        "libraries/liblunicode/ucdata/ucdata.h",
    ],
    # These shared headers require portable.h's SIZEOF_* definitions. Both
    # real libraries enter them after portable.h, including liblber/debug.c.
    textual_hdrs = [
        "include/ac/bytes.h",
        "include/ldap_pvt.h",
        "include/ldap_pvt_uc.h",
    ],
    additional_compiler_inputs = ["libraries/liblber/debug.c"],
    copts = [
        "-w",
        "-std=gnu11",
    ],
    includes = [
        "include",
    ],
    language = "C",
    libcxx_headers = False,
    local_defines = [
        "LBER_LIBRARY",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = ["libraries/liblber"],
    deps = [
        ":_api",
        ":_config_support",
        "@clickhouse//contrib/openldap-cmake:headers",
        "@clickhouse//contrib/openldap-cmake:private_config",
    ],
)


load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["external_include_paths"],
)

exports_files([
    "LICENSE",
])

cc_library(
    name = "sparsehash_c11",
    hdrs = glob([
        "sparsehash/dense_hash_*",
        "sparsehash/sparse_hash_*",
        "sparsehash/internal/**/*.h",
    ]) + [
        "sparsehash/sparsetable",
        "sparsehash/traits",
    ],
    includes = [
        ".",
    ],

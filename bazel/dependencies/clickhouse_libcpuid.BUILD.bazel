load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["external_include_paths"],
)

exports_files([
    "COPYING",
])

ch_cc_library(
    name = "_cpuid",
    srcs = select({
        "@platforms//cpu:x86_64": [
            "libcpuid/asm-bits.c",
            "libcpuid/cpuid_main.c",
            "libcpuid/libcpuid_util.c",
            "libcpuid/msrdriver.c",
            "libcpuid/rdcpuid.c",
            "libcpuid/rdmsr.c",
            "libcpuid/rdtsc.c",
            "libcpuid/recog_amd.c",
            "libcpuid/recog_arm.c",
            "libcpuid/recog_intel.c",
            "libcpuid/recog_centaur.c",
        ],
        "@platforms//cpu:aarch64": [],
    }),
    hdrs = select({
        "@platforms//cpu:x86_64": glob(["**/*.h"]),
        "@platforms//cpu:aarch64": [],
    }),
    additional_compiler_inputs = select({
        "@platforms//cpu:x86_64": [
            "@clickhouse_llvm_project//:runtime_source_inputs",
            "@clickhouse_llvm_project//:runtime_generated_headers",
        ],
        "@platforms//cpu:aarch64": [],
    }),
    arches = [
        "x86_64",
    ],
    copts = select({
        "@platforms//cpu:x86_64": [
            "-w",
            "-std=gnu11",
        ],
        "@platforms//cpu:aarch64": [],
    }),
    implementation_deps = select({
        "@platforms//cpu:x86_64": ["@clickhouse_llvm_project//:libcxxabi_headers"],
        "@platforms//cpu:aarch64": [],
    }),
    language = "C",
    local_defines = select({
        "@platforms//cpu:x86_64": [
            "STD_EXCEPTION_HAS_STACK_TRACE=1",
            "'VERSION=\"v0.8.2\"'",
            "_GNU_SOURCE",
            "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
            "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
            "_LIBUNWIND_IS_NATIVE_ONLY",
        ],
        "@platforms//cpu:aarch64": [],
    }),
    local_includes = select({
        "@platforms//cpu:x86_64": [
            ".",
        ],
        "@platforms//cpu:aarch64": [],
    }),
    target_compatible_with = select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            "@platforms//:incompatible",
        ],
    }),
    deps = ["@clickhouse_llvm_project//:clang_rt_builtins"],
)

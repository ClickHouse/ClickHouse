load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel:repository_paths.bzl", "repository_local_include", "repository_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["external_include_paths"],
)

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "xxHash",
    srcs = [
        "xxhash.c",
    ],
    hdrs = [
        "@clickhouse_sysroot//:linux_native_headers",
    ] + glob([
        "**/*.h",
        "**/*.hh",
    ]),
    additional_compiler_inputs = ([
        "@clickhouse_sysroot//:linux_compile_files",
        "@clickhouse_llvm_project//:runtime_source_inputs",
        "@clickhouse_llvm_project//:runtime_generated_headers",
    ] + [
        "build/cmake/xxHashConfig.cmake.in",
        "cli/xsum_os_specific.c",
        "cli/xsum_output.c",
        "libxxhash.pc.in",
        "tests/bench/main.c",
        "tests/collisions/main.c",
        "tests/collisions/pool.c",
        "tests/collisions/threading.c",
    ]) + [
    ],
    copts = [
        "-w",
        "-std=gnu11",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    language = "C",
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "XXH_INLINE_ALL",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)

exports_files([
    "build/cmake/xxHashConfig.cmake.in",
    "cli/xsum_arch.h",
    "cli/xsum_bench.h",
    "cli/xsum_config.h",
    "cli/xsum_os_specific.c",
    "cli/xsum_os_specific.h",
    "cli/xsum_output.c",
    "cli/xsum_output.h",
    "cli/xsum_sanity_check.h",
    "libxxhash.pc.in",
    "tests/bench/benchHash.h",
    "tests/bench/benchfn.h",
    "tests/bench/bhDisplay.h",
    "tests/bench/hashes.h",
    "tests/bench/main.c",
    "tests/bench/timefn.h",
    "tests/collisions/allcodecs/dummy.h",
    "tests/collisions/hashes.h",
    "tests/collisions/main.c",
    "tests/collisions/pool.c",
    "tests/collisions/pool.h",
    "tests/collisions/sort.hh",
    "tests/collisions/threading.c",
    "tests/collisions/threading.h",
    "tests/sanity_test_vectors.h",
    "xxh3.h",
    "xxh_x86dispatch.h",
    "xxhash.c",
    "xxhash.h",
])

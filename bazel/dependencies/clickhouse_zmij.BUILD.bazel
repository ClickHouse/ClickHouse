load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["external_include_paths"],
)

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_zmij",
    srcs = [
        "zmij.cc",
    ],
    hdrs = glob(["**/*.h"]),
    copts = [
        "-w",
        "-std=c++23",
    ],
    includes = [
        ".",
    ],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = ["@clickhouse_llvm_project//:clang_rt_builtins"] + [
        "@clickhouse_abseil_cpp//:absl_any",
        "@clickhouse_abseil_cpp//:absl_optional",
        "@clickhouse_abseil_cpp//:absl_strings",
        "@clickhouse_abseil_cpp//:absl_variant",
    ],
)

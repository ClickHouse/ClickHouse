load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_simdcomp",
    srcs = select({
        "@platforms//cpu:x86_64": glob(["src/*.c"]),
        "@platforms//cpu:aarch64": [],
    }),
    hdrs = select({
        "@platforms//cpu:x86_64": glob(["include/**/*.h"]),
        "@platforms//cpu:aarch64": [],
    }),
    arches = [
        "x86_64",
    ],
    copts = select({
        "@platforms//cpu:x86_64": [
            "-w",
            "-std=gnu11",
        ],
        "@platforms//cpu:aarch64": [],
    }),
    includes = select({
        "@platforms//cpu:x86_64": [
            "include",
        ],
        "@platforms//cpu:aarch64": [],
        "//conditions:default": [],
    }),
    language = "C",
    libcxx_headers = False,
    local_defines = select({
        "@platforms//cpu:x86_64": [
            "STD_EXCEPTION_HAS_STACK_TRACE=1",
            "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
            "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
            "_LIBUNWIND_IS_NATIVE_ONLY",
        ],
        "@platforms//cpu:aarch64": [],
    }),
    local_includes = select({
        "@platforms//cpu:x86_64": [
            "src",
        ],
        "@platforms//cpu:aarch64": [],
    }),
    target_compatible_with = select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            "@platforms//:incompatible",
        ],
    }),
    deps = [],
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE.txt",
])

ch_cc_library(
    name = "_ch_contrib_antlr4_cpp_runtime",
    srcs = glob(["runtime/Cpp/runtime/src/**/*.cpp"]),
    hdrs = glob(["runtime/Cpp/runtime/src/**/*.h"]),
    copts =
        [
            "-w",
            "-std=c++23",
        ],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    includes = ["runtime/Cpp/runtime/src"],
    local_includes = [
        "runtime/Cpp/runtime/src/atn",
        "runtime/Cpp/runtime/src/dfa",
        "runtime/Cpp/runtime/src/internal",
        "runtime/Cpp/runtime/src/misc",
        "runtime/Cpp/runtime/src/support",
        "runtime/Cpp/runtime/src/tree",
        "runtime/Cpp/runtime/src/tree/pattern",
        "runtime/Cpp/runtime/src/tree/xpath",
    ],
    deps = ["@clickhouse_llvm_project//:clang_rt_builtins"],
)

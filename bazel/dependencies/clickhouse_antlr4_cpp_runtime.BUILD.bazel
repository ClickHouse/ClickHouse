load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel:repository_paths.bzl", "repository_path")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE.txt",
])

ch_cc_library(
    name = "_ch_contrib_antlr4_cpp_runtime",
    srcs = (glob(["runtime/Cpp/runtime/src/*.cpp"]) + glob(["runtime/Cpp/runtime/src/atn/*.cpp"]) + glob(["runtime/Cpp/runtime/src/dfa/*.cpp"]) + [
        "runtime/Cpp/runtime/src/internal/Synchronization.cpp",
    ] + glob(["runtime/Cpp/runtime/src/misc/*.cpp"]) + glob(["runtime/Cpp/runtime/src/support/*.cpp"]) + glob(["runtime/Cpp/runtime/src/tree/*.cpp"]) + glob(["runtime/Cpp/runtime/src/tree/pattern/*.cpp"]) + glob(["runtime/Cpp/runtime/src/tree/xpath/*.cpp"])),
    hdrs = glob(["runtime/Cpp/runtime/src/**/*.h"]),
    additional_compiler_inputs = [],
    copts = (
        ["-w", "-std=c++23", "-I", repository_path("contrib/antlr4-cpp-runtime") + "/runtime/Cpp/runtime/src", "-I", repository_path("contrib/antlr4-cpp-runtime") + "/runtime/Cpp/runtime/src/atn", "-I", repository_path("contrib/antlr4-cpp-runtime") + "/runtime/Cpp/runtime/src/dfa", "-I", repository_path("contrib/antlr4-cpp-runtime") + "/runtime/Cpp/runtime/src/internal", "-I", repository_path("contrib/antlr4-cpp-runtime") + "/runtime/Cpp/runtime/src/misc", "-I", repository_path("contrib/antlr4-cpp-runtime") + "/runtime/Cpp/runtime/src/support", "-I", repository_path("contrib/antlr4-cpp-runtime") + "/runtime/Cpp/runtime/src/tree", "-I", repository_path("contrib/antlr4-cpp-runtime") + "/runtime/Cpp/runtime/src/tree/pattern", "-I", repository_path("contrib/antlr4-cpp-runtime") + "/runtime/Cpp/runtime/src/tree/xpath"]
    ),
    features = [],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = ["@clickhouse//:clang_rt_builtins"],
    alwayslink = False,
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_librseq",
    srcs = [
        "src/rseq.c",
        "src/smp.c",
    ] + glob(
        ["src/**/*.h"],
        exclude = [
            "src/list.h",
            "src/rseq-utils.h",
        ],
    ),
    hdrs = glob(
        ["include/**/*.h"],
        exclude = [
            "include/rseq/arch.h",
            "include/rseq/arch/**/*.h",
        ],
    ),
    copts = [
        "-w",
        "-std=gnu11",
    ],
    includes = [
        "include",
    ],
    language = "C",
    libcxx_headers = False,
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_GNU_SOURCE",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "src",
    ],
    textual_hdrs = [
        "include/rseq/arch.h",
        "include/rseq/arch/generic/common.h",
    ] + glob(["include/rseq/arch/templates/**/*.h"]) + select({
        "@platforms//cpu:x86_64": ["include/rseq/arch/x86.h"] + glob(["include/rseq/arch/x86/**/*.h"]),
        "@platforms//cpu:aarch64": [
            "include/rseq/arch/aarch64.h",
            "include/rseq/arch/generic/thread-pointer.h",
        ] + glob(["include/rseq/arch/aarch64/**/*.h"]),
    }),
    implementation_deps = [],
)

load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_librseq",
    srcs = [
        "src/rseq.c",
        "src/smp.c",
    ] + glob(["src/**/*.h"]),
    hdrs = glob(["include/**/*.h"]),
    additional_compiler_inputs = ["@clickhouse_llvm_project//:runtime_source_inputs", "@clickhouse_llvm_project//:runtime_generated_headers"],
    copts = [
        "-w",
        "-std=gnu11",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    includes = [
        "include",
    ],
    language = "C",
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_GNU_SOURCE",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "include",
        "src",
    ],
    deps = ["@clickhouse//:clang_rt_builtins"],
    alwayslink = False,
)

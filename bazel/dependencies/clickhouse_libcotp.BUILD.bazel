load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel:repository_paths.bzl", "repository_local_include", "repository_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_libcotp",
    srcs = (glob(["src/*.c"]) + [
        "src/utils/base32.c",
        "src/utils/otpauth_uri.c",
        "src/utils/pct.c",
        "src/utils/secure_zero.c",
        "src/utils/whash_openssl.c",
        "src/utils/whmac_openssl.c",
        "src/utils/yaotp_uri.c",
    ]) + glob(["src/**/*.h"]),
    hdrs = [
        "src/cotp.h",
        "src/utils/pct.h",
        "src/utils/secure_zero.h",
        "src/whash.h",
        "src/whmac.h",
        "@clickhouse_sysroot//:linux_native_headers",
    ],
    additional_compiler_inputs = [
        "@clickhouse_sysroot//:linux_compile_files",
        "@clickhouse_llvm_project//:runtime_source_inputs",
        "@clickhouse_llvm_project//:runtime_generated_headers",
    ],
    copts = [
        "-w",
        "-std=gnu11",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    language = "C",
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "src",
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse_openssl//:crypto",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)

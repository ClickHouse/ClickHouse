load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_libcotp",
    srcs = glob(["src/*.c"]) + [
        "src/utils/base32.c",
        "src/utils/otpauth_uri.c",
        "src/utils/pct.c",
        "src/utils/secure_zero.c",
        "src/utils/whash_openssl.c",
        "src/utils/whmac_openssl.c",
        "src/utils/yaotp_uri.c",
    ] + glob(["src/**/*.h"], exclude = ["src/cotp.h"]),
    hdrs = ["src/cotp.h"],
    copts = [
        "-w",
        "-std=gnu11",
    ],
    implementation_deps = [
        "@clickhouse_openssl//:crypto",
    ],
    includes = [
        "src",
    ],
    language = "C",
    libcxx_headers = False,
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["external_include_paths"],
)

exports_files([
    "LICENSE",
])

_AMQP_SHARED_HEADERS = [
    "src/basicframe.h",
    "src/basicheaderframe.h",
    "src/basicpublishframe.h",
    "src/bodyframe.h",
    "src/channelframe.h",
    "src/confirmframe.h",
    "src/connectionframe.h",
    "src/exchangeframe.h",
    "src/extframe.h",
    "src/headerframe.h",
    "src/includes.h",
    "src/linux_tcp/function.h",
    "src/linux_tcp/poll.h",
    "src/methodframe.h",
    "src/queueframe.h",
    "src/receivedframe.h",
    "src/transactionframe.h",
]

ch_cc_library(
    name = "_amqp-cpp",
    srcs = [
        "src/array.cpp",
        "src/channel.cpp",
        "src/channelimpl.cpp",
        "src/connectionimpl.cpp",
        "src/deferredcancel.cpp",
        "src/deferredconfirm.cpp",
        "src/deferredconsumer.cpp",
        "src/deferredextreceiver.cpp",
        "src/deferredget.cpp",
        "src/deferredrecall.cpp",
        "src/deferredreceiver.cpp",
        "src/field.cpp",
        "src/flags.cpp",
    ] + glob(["src/linux_tcp/*.cpp"]) + [
        "src/inbuffer.cpp",
        "src/receivedframe.cpp",
        "src/table.cpp",
        "src/watchable.cpp",
    ] + glob(["src/**/*.h"], exclude = _AMQP_SHARED_HEADERS),
    hdrs = glob(["include/**/*.h"]) + _AMQP_SHARED_HEADERS,
    copts = [
        "-w",
        "-std=c++23",
    ],
    includes = [
        "include",
    ],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = [
        "@clickhouse_libuv//:_uv",
        "@clickhouse_openssl//:ssl",
    ],
)

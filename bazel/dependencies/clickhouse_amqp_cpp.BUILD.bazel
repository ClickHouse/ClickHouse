load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel:repository_paths.bzl", "repository_local_include", "repository_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["external_include_paths"],
)

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_amqp-cpp",
    srcs = ([
        "src/array.cpp",
        "src/channel.cpp",
        "src/channelimpl.cpp",
        "src/connectionimpl.cpp",
        "src/deferredcancel.cpp",
        "src/deferredconfirm.cpp",
        "src/deferredconsumer.cpp",
        "src/deferredextreceiver.cpp",
        "src/deferredget.cpp",
        "src/deferredrecall.cpp",
        "src/deferredreceiver.cpp",
        "src/field.cpp",
        "src/flags.cpp",
    ] + glob(["src/linux_tcp/*.cpp"]) + [
        "src/inbuffer.cpp",
        "src/receivedframe.cpp",
        "src/table.cpp",
        "src/watchable.cpp",
    ]),
    hdrs = ([
        "@clickhouse_sysroot//:linux_native_headers",
    ] + glob(["**/*.h"])),
    additional_compiler_inputs = [
        "@clickhouse_sysroot//:linux_compile_files",
    ],
    copts = [
        "-w",
        "-std=c++23",
        "-nostdinc++",
    ],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "include",
        ".",
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse_libuv//:_uv",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse_openssl//:crypto",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        "@clickhouse_openssl//:ssl",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_brotli",
    srcs = glob(["c/common/*.c"]) + glob(["c/dec/*.c"]) + glob(["c/enc/*.c"]) + glob([
        "c/common/**/*.h",
        "c/dec/**/*.h",
        "c/enc/**/*.h",
    ]),
    hdrs = glob(["c/include/**/*.h"]),
    copts = [
        "-w",
        "-std=gnu11",
    ],
    includes = [
        "c/include",
    ],
    language = "C",
    libcxx_headers = False,
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = [],
)

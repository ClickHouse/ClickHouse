load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_brotli",
    srcs = glob([
        "c/common/*.c",
        "c/dec/*.c",
        "c/enc/*.c",
        "c/common/**/*.h",
        "c/dec/**/*.h",
        "c/enc/**/*.h",
    ]),
    hdrs = glob(["c/include/**/*.h"]),
    includes = [
        "c/include",
    ],
    language = "C",
    local_defines = CXX_RUNTIME_DEFINES,
)

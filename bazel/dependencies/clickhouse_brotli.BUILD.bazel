load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_brotli",
    srcs = glob(["c/common/*.c"]) + glob(["c/dec/*.c"]) + glob(["c/enc/*.c"]) + glob([
        "c/common/**/*.h",
        "c/dec/**/*.h",
        "c/enc/**/*.h",
    ]),
    hdrs = glob(["c/include/**/*.h"]),
    copts = [
        "-w",
        "-std=gnu11",
    ],
    includes = [
        "c/include",
    ],
    language = "C",
    libcxx_headers = False,
    local_defines = CXX_RUNTIME_DEFINES,
)

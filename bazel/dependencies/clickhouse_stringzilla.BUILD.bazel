load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_stringzilla",
    srcs = [
        "c/stringzilla/runtime.c",
        "c/stringzilla/compare.c",
        "c/stringzilla/memory.c",
        "c/stringzilla/hash.c",
        "c/stringzilla/find.c",
        "c/stringzilla/sort.c",
        "c/stringzilla/intersect.c",
        "c/stringzilla/utf8_norm.c",
        "c/stringzilla/utf8_runes.c",
        "c/stringzilla/utf8_tokens.c",
        "c/stringzilla/utf8_wordbreaks.c",
        "c/stringzilla/utf8_graphemes.c",
        "c/stringzilla/utf8_sentences.c",
        "c/stringzilla/utf8_linebreaks.c",
        "c/stringzilla/utf8_uncased_fold.c",
        "c/stringzilla/utf8_uncased.c",
    ] + glob(["c/stringzilla/**/*.h"]),
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.hpp",
    ]),
    additional_compiler_inputs = [
        "@clickhouse_llvm_project//:runtime_source_inputs",
        "@clickhouse_llvm_project//:runtime_generated_headers",
    ],
    copts = [
        "-w",
        "-std=gnu11",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    language = "C",
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "SZ_AVOID_LIBC=0",
        "SZ_DEBUG=0",
        "SZ_DYNAMIC_DISPATCH=1",
    ] + select({
        "@platforms//cpu:x86_64": [
            "SZ_USE_GOLDMONT=1",
            "SZ_USE_HASWELL=1",
            "SZ_USE_ICELAKE=1",
            "SZ_USE_NEON=0",
            "SZ_USE_NEONAES=0",
            "SZ_USE_NEONSHA=0",
            "SZ_USE_SKYLAKE=1",
            "SZ_USE_SVE2=0",
            "SZ_USE_SVE2AES=0",
            "SZ_USE_SVE=0",
            "SZ_USE_WESTMERE=1",
        ],
        "@platforms//cpu:aarch64": [
            "SZ_USE_GOLDMONT=0",
            "SZ_USE_HASWELL=0",
            "SZ_USE_ICELAKE=0",
            "SZ_USE_NEON=1",
            "SZ_USE_NEONAES=1",
            "SZ_USE_NEONSHA=1",
            "SZ_USE_SKYLAKE=0",
            "SZ_USE_SVE2=1",
            "SZ_USE_SVE2AES=1",
            "SZ_USE_SVE=1",
            "SZ_USE_WESTMERE=0",
        ],
    }) + [
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "include",
    ],
    deps = ["@clickhouse//:clang_rt_builtins"],
    alwayslink = False,
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_stringzilla",
    srcs = glob(["c/stringzilla/*.c"]) + glob(["c/stringzilla/**/*.h"]),
    hdrs = glob([
        "include/stringzilla/**/*.h",
        "include/stringzilla/**/*.hpp",
    ]),
    conlyopts = ["-std=gnu11"],
    copts = ["-w"],
    includes = [
        "include",
    ],
    language = "C",
    libcxx_headers = False,
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "SZ_AVOID_LIBC=0",
        "SZ_DEBUG=0",
        "SZ_DYNAMIC_DISPATCH=1",
    ] + select({
        "@platforms//cpu:x86_64": [
            "SZ_USE_GOLDMONT=1",
            "SZ_USE_HASWELL=1",
            "SZ_USE_ICELAKE=1",
            "SZ_USE_NEON=0",
            "SZ_USE_NEONAES=0",
            "SZ_USE_NEONSHA=0",
            "SZ_USE_SKYLAKE=1",
            "SZ_USE_SVE2=0",
            "SZ_USE_SVE2AES=0",
            "SZ_USE_SVE=0",
            "SZ_USE_WESTMERE=1",
        ],
        "@platforms//cpu:aarch64": [
            "SZ_USE_GOLDMONT=0",
            "SZ_USE_HASWELL=0",
            "SZ_USE_ICELAKE=0",
            "SZ_USE_NEON=1",
            "SZ_USE_NEONAES=1",
            "SZ_USE_NEONSHA=1",
            "SZ_USE_SKYLAKE=0",
            "SZ_USE_SVE2=1",
            "SZ_USE_SVE2AES=1",
            "SZ_USE_SVE=1",
            "SZ_USE_WESTMERE=0",
        ],
    }) + [
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = ["@clickhouse_llvm_project//:clang_rt_builtins"],
)

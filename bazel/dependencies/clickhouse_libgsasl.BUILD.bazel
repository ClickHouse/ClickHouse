load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel:repository_paths.bzl", "repository_local_include", "repository_path")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_gsasl",
    srcs = ([
        "gl/gc-gnulib.c",
        "gl/printf-parse.c",
        "gl/c-ctype.c",
        "gl/float.c",
        "gl/printf-args.c",
        "gl/strverscmp.c",
        "gl/hmac-sha1.c",
        "gl/itold.c",
        "gl/hmac-md5.c",
        "gl/gc-pbkdf2-sha1.c",
        "gl/md5.c",
        "gl/base64.c",
        "gl/memxor.c",
        "gl/sha1.c",
    ] + glob(["openid20/*.c"]) + glob(["anonymous/*.c"]) + glob(["saml20/*.c"]) + [
        "scram/parser.c",
        "scram/printer.c",
        "scram/tokens.c",
        "scram/client.c",
        "scram/mechinfo.c",
        "scram/server.c",
        "scram/validate.c",
        "src/free.c",
        "src/supportp.c",
        "src/init.c",
        "src/mechtools.c",
        "src/error.c",
        "src/property.c",
        "src/done.c",
        "src/callback.c",
        "src/xstart.c",
        "src/xfinish.c",
        "src/version.c",
        "src/xstep.c",
        "src/mechname.c",
        "src/xcode.c",
        "src/crypto.c",
        "src/doxygen.c",
        "src/suggest.c",
        "src/saslprep.c",
        "src/listmech.c",
        "src/register.c",
        "src/base64.c",
        "src/md5pwd.c",
    ] + glob(["external/*.c"]) + glob(["securid/*.c"]) + glob(["plain/*.c"]) + [
        "cram-md5/client.c",
        "cram-md5/challenge.c",
        "cram-md5/mechinfo.c",
        "cram-md5/server.c",
        "cram-md5/digest.c",
    ] + glob(["digest-md5/*.c"]) + glob(["login/*.c"]) + glob(["gssapi/*.c"])),
    hdrs = select({
        "@platforms//cpu:x86_64": ([
            "@clickhouse_sysroot//:linux_native_headers",
            "@clickhouse//:contrib/libgsasl-cmake/linux_x86_64/include/config.h",
        ] + glob(["**/*.h"])),
        "@platforms//cpu:aarch64": ([
            "@clickhouse_sysroot//:linux_native_headers",
            "@clickhouse//:contrib/libgsasl-cmake/linux_x86_64/include/config.h",
        ] + glob(["**/*.h"])),
    }),
    additional_compiler_inputs = [
        "@clickhouse_sysroot//:linux_compile_files",
        "@clickhouse_llvm_project//:runtime_source_inputs",
        "@clickhouse_llvm_project//:runtime_generated_headers",
    ],
    copts = [
        "-w",
        "-std=gnu11",
        "-I",
        repository_path("contrib/libgsasl"),
        "-I",
        repository_path("contrib/libgsasl") + "/gl",
        "-I",
        repository_path("contrib/libgsasl") + "/src",
        "-I",
        repository_path("contrib/libgsasl") + "/digest-md5",
        "-I",
        "contrib/libgsasl-cmake/linux_x86_64/include",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    language = "C",
    local_defines = [
        "HAVE_CONFIG_H=1",
        "HAVE_GSSAPI_H=1",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "USE_GSSAPI=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = select({
        "@platforms//cpu:x86_64": [
            repository_local_include(
                "$(GENDIR)/" + repository_path("contrib/krb5") + "/config/x86_64/contrib/krb5-cmake/include",
                "contrib/libgsasl",
            ),
        ],
        "@platforms//cpu:aarch64": [
            repository_local_include(
                "$(GENDIR)/" + repository_path("contrib/krb5") + "/config/aarch64/contrib/krb5-cmake/include",
                "contrib/libgsasl",
            ),
        ],
    }),
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse_krb5//:_krb5",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse_openssl//:crypto",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        "@clickhouse_openssl//:ssl",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_gsasl",
    srcs = ([
        "gl/gc-gnulib.c",
        "gl/printf-parse.c",
        "gl/c-ctype.c",
        "gl/float.c",
        "gl/printf-args.c",
        "gl/strverscmp.c",
        "gl/hmac-sha1.c",
        "gl/itold.c",
        "gl/hmac-md5.c",
        "gl/gc-pbkdf2-sha1.c",
        "gl/md5.c",
        "gl/base64.c",
        "gl/memxor.c",
        "gl/sha1.c",
    ] + glob(["openid20/*.c"]) + glob(["anonymous/*.c"]) + glob(["saml20/*.c"]) + [
        "scram/parser.c",
        "scram/printer.c",
        "scram/tokens.c",
        "scram/client.c",
        "scram/mechinfo.c",
        "scram/server.c",
        "scram/validate.c",
        "src/free.c",
        "src/supportp.c",
        "src/init.c",
        "src/mechtools.c",
        "src/error.c",
        "src/property.c",
        "src/done.c",
        "src/callback.c",
        "src/xstart.c",
        "src/xfinish.c",
        "src/version.c",
        "src/xstep.c",
        "src/mechname.c",
        "src/xcode.c",
        "src/crypto.c",
        "src/doxygen.c",
        "src/suggest.c",
        "src/saslprep.c",
        "src/listmech.c",
        "src/register.c",
        "src/base64.c",
        "src/md5pwd.c",
    ] + glob(["external/*.c"]) + glob(["securid/*.c"]) + glob(["plain/*.c"]) + [
        "cram-md5/client.c",
        "cram-md5/challenge.c",
        "cram-md5/mechinfo.c",
        "cram-md5/server.c",
        "cram-md5/digest.c",
    ] + glob(["digest-md5/*.c"]) + glob(["login/*.c"]) + glob(["gssapi/*.c"])),
    hdrs = (["@clickhouse//contrib/libgsasl-cmake:linux_x86_64/include/config.h"] + glob(["**/*.h"])),
    additional_compiler_inputs = [
        "@clickhouse_llvm_project//:runtime_source_inputs",
        "@clickhouse_llvm_project//:runtime_generated_headers",
    ],
    copts = [
        "-w",
        "-std=gnu11",
        "-I",
        "contrib/libgsasl-cmake/linux_x86_64/include",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    language = "C",
    local_defines = [
        "HAVE_CONFIG_H=1",
        "HAVE_GSSAPI_H=1",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "USE_GSSAPI=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        ".",
        "gl",
        "src",
        "digest-md5",
    ],
    deps = ["@clickhouse_krb5//:_krb5"],
)

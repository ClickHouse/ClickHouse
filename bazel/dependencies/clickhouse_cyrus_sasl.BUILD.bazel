load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel:repository_paths.bzl", "repository_path")

package(default_visibility = ["//visibility:public"])

exports_files([
    "COPYING",
])

copy_file(
    name = "configure_x86_64_c0a3fdaa62e2c9c1",
    src = ":include/prop.h",
    out = "config/x86_64/contrib/cyrus-sasl-cmake/prop.h",
)

copy_file(
    name = "configure_x86_64_0556187902609143",
    src = ":include/sasl.h",
    out = "config/x86_64/contrib/cyrus-sasl-cmake/sasl/sasl.h",
)

copy_file(
    name = "configure_aarch64_c0a3fdaa62e2c9c1",
    src = ":include/prop.h",
    out = "config/aarch64/contrib/cyrus-sasl-cmake/prop.h",
)

copy_file(
    name = "configure_aarch64_0556187902609143",
    src = ":include/sasl.h",
    out = "config/aarch64/contrib/cyrus-sasl-cmake/sasl/sasl.h",
)

ch_cc_library(
    name = "_sasl2",
    srcs = [
        "plugins/gssapi.c",
        "common/plugin_common.c",
        "lib/common.c",
        "lib/canonusr.c",
        "lib/server.c",
        "lib/config.c",
        "lib/auxprop.c",
        "lib/saslutil.c",
        "lib/external.c",
        "lib/seterror.c",
        "lib/md5.c",
        "lib/dlopen.c",
        "lib/client.c",
        "lib/checkpw.c",
        "@clickhouse//:contrib/cyrus-sasl-cmake/config.h",
    ] + glob(["**/*.h"]),
    hdrs = (select({
        "@platforms//cpu:x86_64": [
            ":config/x86_64/contrib/cyrus-sasl-cmake/prop.h",
            ":config/x86_64/contrib/cyrus-sasl-cmake/sasl/sasl.h",
        ],
        "@platforms//cpu:aarch64": [
            ":config/aarch64/contrib/cyrus-sasl-cmake/prop.h",
            ":config/aarch64/contrib/cyrus-sasl-cmake/sasl/sasl.h",
        ],
    })),
    additional_compiler_inputs = ["@clickhouse_llvm_project//:runtime_source_inputs", "@clickhouse_llvm_project//:runtime_generated_headers", "@clickhouse//:contrib/cyrus-sasl-cmake/CMakeLists.txt"],
    copts = (([
        "-w",
        "-std=gnu11",
        "-I",
    ] + select({
        "@platforms//cpu:x86_64": [
            "$(GENDIR)/" + repository_path("contrib/cyrus-sasl") + "/config/x86_64/contrib/cyrus-sasl-cmake",
        ],
        "@platforms//cpu:aarch64": [
            "$(GENDIR)/" + repository_path("contrib/cyrus-sasl") + "/config/aarch64/contrib/cyrus-sasl-cmake",
        ],
    })) + [
        "-I",
        "contrib/cyrus-sasl-cmake",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/plugins",
        "-I",
        repository_path("contrib/cyrus-sasl"),
        "-I",
        repository_path("contrib/cyrus-sasl") + "/include",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/lib",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/sasldb",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/common",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/saslauthd",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/sample",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/utils",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/tests",
    ]),
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    language = "C",
    local_defines = [
        "'CONFIGDIR=\"\"'",
        "HAVE_CONFIG_H",
        "OBSOLETE_CRAM_ATTR=1",
        "OBSOLETE_DIGEST_ATTR=1",
        "'PLUGINDIR=\"\"'",
        "'SASLAUTHD_CONF_FILE_DEFAULT=\"\"'",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = ["@clickhouse_krb5//:_krb5"],
    alwayslink = False,
)

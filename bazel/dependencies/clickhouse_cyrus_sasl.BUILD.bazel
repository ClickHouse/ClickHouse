load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "repository_path")

package(default_visibility = ["//visibility:public"])

exports_files([
    "COPYING",
])

copy_file(
    name = "configure_prop_h",
    src = ":include/prop.h",
    out = "config/contrib/cyrus-sasl-cmake/prop.h",
)

copy_file(
    name = "configure_sasl_sasl_h",
    src = ":include/sasl.h",
    out = "config/contrib/cyrus-sasl-cmake/sasl/sasl.h",
)

ch_cc_library(
    name = "_sasl2",
    srcs = [
        "plugins/gssapi.c",
        "common/plugin_common.c",
        "lib/common.c",
        "lib/canonusr.c",
        "lib/server.c",
        "lib/config.c",
        "lib/auxprop.c",
        "lib/saslutil.c",
        "lib/external.c",
        "lib/seterror.c",
        "lib/md5.c",
        "lib/dlopen.c",
        "lib/client.c",
        "lib/checkpw.c",
        "@clickhouse//contrib/cyrus-sasl-cmake:config.h",
    ] + glob(["**/*.h"]),
    hdrs = [
        ":config/contrib/cyrus-sasl-cmake/prop.h",
        ":config/contrib/cyrus-sasl-cmake/sasl/sasl.h",
    ],
    additional_compiler_inputs = [
        "@clickhouse_llvm_project//:runtime_source_inputs",
        "@clickhouse_llvm_project//:runtime_generated_headers",
    ],
    copts = (([
        "-w",
        "-std=gnu11",
        "-I",
    ] + [
        "$(GENDIR)/" + repository_path("contrib/cyrus-sasl") + "/config/contrib/cyrus-sasl-cmake",
    ]) + [
        "-I",
        "contrib/cyrus-sasl-cmake",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/plugins",
        "-I",
        repository_path("contrib/cyrus-sasl"),
        "-I",
        repository_path("contrib/cyrus-sasl") + "/include",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/lib",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/sasldb",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/common",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/saslauthd",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/sample",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/utils",
        "-I",
        repository_path("contrib/cyrus-sasl") + "/tests",
    ]),
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    language = "C",
    local_defines = [
        "'CONFIGDIR=\"\"'",
        "HAVE_CONFIG_H",
        "OBSOLETE_CRAM_ATTR=1",
        "OBSOLETE_DIGEST_ATTR=1",
        "'PLUGINDIR=\"\"'",
        "'SASLAUTHD_CONF_FILE_DEFAULT=\"\"'",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = ["@clickhouse_krb5//:_krb5"],
    alwayslink = False,
)

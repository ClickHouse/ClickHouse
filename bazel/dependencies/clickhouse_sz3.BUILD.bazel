load("@clickhouse//bazel/rules:source_header_directories.bzl", "source_header_directories")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "copyright-and-BSD-license.txt",
    "tools/pysz/LICENSE",
])

cc_library(
    name = "sz3",
    hdrs = glob(["include/SZ3/**/*.hpp"]),
    includes = [
        "include",
    ],
    source_header_directories = source_header_directories(["include/SZ3/api"]),
    deps = [
        "@clickhouse_zstd//:_zstd",
    ],
)

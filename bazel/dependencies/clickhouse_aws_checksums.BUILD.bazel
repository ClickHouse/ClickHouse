load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "aws_checksums",
    srcs = glob(["source/*.c"]) + select({
        "@platforms//cpu:x86_64": ["source/intel/asm/crc32c_sse42_asm.c"],
        "@platforms//cpu:aarch64": ["source/arm/crc64_arm.c"],
    }) + ["source/external/xxhash.h"] + glob(["include/**/private/**/*.h"]),
    hdrs = glob(
        ["include/**/*.h"],
        exclude = ["include/**/private/**/*.h"],
    ),
    copts = [
        "-w",
        "-std=gnu11",
        "-g1",
    ],
    includes = ["include"],
    language = "C",
    libcxx_headers = False,
    llvm_headers = False,
    local_defines = [
        "AWS_AFFINITY_METHOD=AWS_AFFINITY_METHOD_NONE",
        "AWS_ENABLE_EPOLL",
        "AWS_PTHREAD_SETNAME_TAKES_2ARGS",
        "ENABLE_OPENSSL_ENCRYPTION",
        "INTEL_NO_ITTNOTIFY_API",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
    ] + select({
        "@platforms//cpu:x86_64": [
            "USE_SIMD_ENCODING",
        ],
        "@platforms//cpu:aarch64": [],
    }) + [
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = ["@clickhouse_aws_c_common//:aws_c_common"],
)

ch_cc_library(
    name = "aws_checksums__compile_2",
    srcs = select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": ["source/arm/crc32c_arm.c"] + glob(["include/aws/checksums/private/crc32*.h"]),
    }),
    arches = [
        "aarch64",
    ],
    copts = select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            "-w",
            "-std=gnu11",
            "-g1",
            "-march=armv8-a+crc",
        ],
    }),
    implementation_deps = select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            ":aws_checksums",
            "@clickhouse_aws_c_common//:aws_c_common",
        ],
    }),
    language = "C",
    libcxx_headers = False,
    local_defines = select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            "AWS_AFFINITY_METHOD=AWS_AFFINITY_METHOD_NONE",
            "AWS_ENABLE_EPOLL",
            "AWS_PTHREAD_SETNAME_TAKES_2ARGS",
            "ENABLE_OPENSSL_ENCRYPTION",
            "INTEL_NO_ITTNOTIFY_API",
            "STD_EXCEPTION_HAS_STACK_TRACE=1",
            "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
            "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
            "_LIBUNWIND_IS_NATIVE_ONLY",
        ],
    }),
)

load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE.md",
])

ch_cc_library(
    name = "_replxx",
    srcs = [
        "src/conversion.cxx",
        "src/ConvertUTF.cpp",
        "src/escape.cxx",
        "src/history.cxx",
        "src/terminal.cxx",
        "src/prompt.cxx",
        "src/replxx_impl.cxx",
        "src/replxx.cxx",
        "src/util.cxx",
        "src/wcwidth.cpp",
    ] + glob([
        "src/**/*.h",
        "src/**/*.hxx",
    ]),
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.hxx",
    ]),
    copts = ["-w", "-std=c++23"],
    includes = [
        "include",
    ],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "include",
    ],
    deps = ["@clickhouse//:clang_rt_builtins"],
    alwayslink = False,
)

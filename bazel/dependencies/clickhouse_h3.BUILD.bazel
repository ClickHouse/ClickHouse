load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

expand_template(
    name = "configure_src_h3lib_include_h3api_h",
    out = "config/contrib/h3/src/h3lib/include/h3api.h",
    substitutions = {
        "@H3_VERSION_MAJOR@": "4",
        "@H3_VERSION_MINOR@": "5",
        "@H3_VERSION_PATCH@": "0",
    },
    template = ":src/h3lib/include/h3api.h.in",
)

ch_cc_library(
    name = "_h3",
    srcs = glob(["src/h3lib/lib/*.c"]),
    hdrs = [":config/contrib/h3/src/h3lib/include/h3api.h"] + glob(["src/h3lib/include/**/*.h"]),
    copts = [
        "-w",
        "-std=gnu11",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:libcxxabi_headers"],
    includes = [
        "src/h3lib/include",
    ],
    language = "C",
    local_defines = [
        "H3_HAVE_VLA",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "config/contrib/h3/src/h3lib/include",
    ],
    deps = ["@clickhouse_llvm_project//:clang_rt_builtins"],
)

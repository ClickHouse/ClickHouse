load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_crc32c",
    srcs = select({
        "@platforms//cpu:x86_64": [
            "src/crc32c_portable.cc",
            "src/crc32c.cc",
            "src/crc32c_sse42.cc",
            "@clickhouse//contrib/crc32c-cmake:x86_64/sse42/crc32c/crc32c_config.h",
        ] + glob(["src/**/*.h"]),
        "@platforms//cpu:aarch64": [
            "src/crc32c_portable.cc",
            "src/crc32c.cc",
            "src/crc32c_arm64.cc",
            "@clickhouse//contrib/crc32c-cmake:aarch64/crc32c/crc32c_config.h",
        ] + glob(["src/**/*.h"]),
    }),
    hdrs = glob(["include/**/*.h"]),
    copts =
        [
            "-w",
            "-std=c++23",
            "-I",
        ] + select({
            "@platforms//cpu:x86_64": [
                "contrib/crc32c-cmake/x86_64/sse42",
            ],
            "@platforms//cpu:aarch64": [
                "contrib/crc32c-cmake/aarch64",
            ],
        }),
    includes = [
        "include",
    ],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "include",
    ],
    deps = ["@clickhouse_llvm_project//:clang_rt_builtins"],
)

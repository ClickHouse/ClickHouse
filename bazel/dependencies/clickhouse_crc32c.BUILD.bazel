load("@clickhouse//bazel:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel:repository_paths.bzl", "repository_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_crc32c",
    srcs = select({
        "@platforms//cpu:x86_64": [
            "src/crc32c_portable.cc",
            "src/crc32c.cc",
            "src/crc32c_sse42.cc",
            "@clickhouse//:contrib/crc32c-cmake/x86_64/sse42/crc32c/crc32c_config.h",
        ] + glob(["src/**/*.h"]),
        "@platforms//cpu:aarch64": [
            "src/crc32c_portable.cc",
            "src/crc32c.cc",
            "src/crc32c_arm64.cc",
            "@clickhouse//:contrib/crc32c-cmake/aarch64/crc32c/crc32c_config.h",
        ] + glob(["src/**/*.h"]),
    }),
    hdrs = [
        "@clickhouse_sysroot//:linux_native_headers",
    ] + glob(["include/**/*.h"]),
    additional_compiler_inputs = [
        "@clickhouse_sysroot//:linux_compile_files",
    ],
    copts = (
        (([
            "-w",
            "-std=c++23",
            "-nostdinc++",
            "-I",
        ] + select({
            "@platforms//cpu:x86_64": [
                "contrib/crc32c-cmake/x86_64/sse42",
            ],
            "@platforms//cpu:aarch64": [
                "contrib/crc32c-cmake/aarch64",
            ],
        })) + [
            "-I",
            repository_path("contrib/crc32c") + "/include",
        ])
    ),
    features = [],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse//:clang_rt_builtins",
        "@clickhouse//:cxx",
        "@clickhouse//:cxxabi",
        "@clickhouse//:glibc-compatibility",
        "@clickhouse//:unwind",
    ],
    alwayslink = False,
)

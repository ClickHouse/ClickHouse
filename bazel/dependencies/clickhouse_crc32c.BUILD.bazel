load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_crc32c",
    srcs = select({
        "@platforms//cpu:x86_64": [
            "src/crc32c_portable.cc",
            "src/crc32c.cc",
            "src/crc32c_sse42.cc",
        ],
        "@platforms//cpu:aarch64": [
            "src/crc32c_portable.cc",
            "src/crc32c.cc",
            "src/crc32c_arm64.cc",
        ],
    }) + [
        "src/crc32c_arm64.h",
        "src/crc32c_arm64_check.h",
        "src/crc32c_internal.h",
        "src/crc32c_prefetch.h",
        "src/crc32c_read_le.h",
        "src/crc32c_round_up.h",
        "src/crc32c_sse42.h",
        "src/crc32c_sse42_check.h",
    ] + select({
        "@platforms//cpu:x86_64": ["configured/x86_64/crc32c/crc32c_config.h"],
        "@platforms//cpu:aarch64": ["configured/aarch64/crc32c/crc32c_config.h"],
    }),
    hdrs = glob(["include/**/*.h"]),
    copts =
        [
            "-w",
            "-std=c++23",
        ],
    includes = [
        "include",
    ],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = select({
        "@platforms//cpu:x86_64": ["configured/x86_64"],
        "@platforms//cpu:aarch64": ["configured/aarch64"],
    }),
)

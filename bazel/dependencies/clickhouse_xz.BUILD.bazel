        "src/liblzma/check/sha256.c",
    ] + glob(["src/liblzma/common/*.c"]) + glob(["src/liblzma/delta/*.c"]) + glob(["src/liblzma/lz/*.c"]) + [
        "src/liblzma/lzma/fastpos_table.c",
        "src/liblzma/lzma/lzma2_decoder.c",
        "src/liblzma/lzma/lzma2_encoder.c",
    ] + glob(["src/liblzma/lzma/lzma_*.c"]) + [
        "src/liblzma/rangecoder/price_table.c",
    ] + glob(["src/liblzma/simple/*.c"]) + glob(
        [
            "src/common/**/*.h",
            "src/liblzma/check/**/*.h",
            "src/liblzma/common/**/*.h",
            "src/liblzma/delta/**/*.h",
            "src/liblzma/lz/**/*.h",

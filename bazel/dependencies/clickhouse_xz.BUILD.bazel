        "_LIBUNWIND_IS_NATIVE_ONLY",
        "_POSIX_PTHREAD_SEMANTICS",
        "_TANDEM_SOURCE",
        "__EXTENSIONS__",
    ],
    local_includes = [
        "src/liblzma/common",
        "src/liblzma/check",
        "src/liblzma/lz",
        "src/liblzma/rangecoder",
        "src/liblzma/lzma",
        "src/liblzma/delta",
        "src/liblzma/simple",
        "src/common",
    ],
    textual_hdrs = glob(["src/liblzma/api/lzma/*.h"]),
    deps = ["@clickhouse_llvm_project//:clang_rt_builtins"],
)

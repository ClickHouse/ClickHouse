load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "llvm_toolchain_path", "repository_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "time.h",
])

ch_cc_library(
    name = "common",
    srcs = [
        "argsToConfig.cpp",
        "cgroupsv2.cpp",
        "coverage.cpp",
        "demangle.cpp",
        "Decimal.cpp",
        "getAvailableMemoryAmount.cpp",
        "getFQDNOrHostName.cpp",
        "getL2CacheSize.cpp",
        "getMemoryAmount.cpp",
        "getPageSize.cpp",
        "getThreadId.cpp",
        "int8_to_string.cpp",
        "itoa.cpp",
        "JSON.cpp",
        "mremap.cpp",
        "openpty.cpp",
        "phdr_cache.cpp",
        "preciseExp10.cpp",
        "shift10.cpp",
        "sleep.cpp",
        "terminalColors.cpp",
        "errnoToString.cpp",
        "safeExit.cpp",
        "throwError.cpp",
        "Numa.cpp",
        "//bazel:gen/base/base/GitHash.generated.cpp",
        "wide_integer_to_string.cpp",
    ],
    clickhouse_code = True,
    local_defines = [
        "BOOST_ASIO_HAS_STD_INVOKE_RESULT=1",
        "BOOST_ASIO_STANDALONE=1",
        "BOOST_TIMER_ENABLE_DEPRECATED=1",
        "POCO_ENABLE_CPP11",
        "POCO_OS_FAMILY_UNIX",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "WITH_COVERAGE=0",
        "WITH_COVERAGE_DEPTH=0",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",

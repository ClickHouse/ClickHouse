    local_includes = [
        "../../bazel/gen/includes/configs",
        "..",
        "../../bazel/gen/base",
    ] + [
        "../../" + "contrib/cityhash102/include",
        "../../" + repository_path("contrib/boost"),
        "../../" + "base/poco/Net/include",
        "../../" + "base/poco/Foundation/include",
        "../../" + "base/poco/NetSSL_OpenSSL/include",
        "../../" + "base/poco/Util/include",
        "../../" + "base/poco/JSON/include",
        "../../" + "base/poco/XML/include",
        "../../" + "contrib/openssl-cmake/common/include",
        "../../" + (repository_path("contrib/openssl") + "/include"),
        "../../" + (repository_path("contrib/replxx") + "/include"),
        "../../" + (repository_path("contrib/fmtlib") + "/include"),
        "../../" + (repository_path("contrib/magic_enum") + "/include/magic_enum"),
        "../../" + (llvm_toolchain_path() + "/libunwind/include"),
        "../../" + (llvm_toolchain_path() + "/libc"),
        "../../" + (llvm_toolchain_path() + "/compiler-rt/include"),

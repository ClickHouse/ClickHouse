load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

ch_cc_library(
    name = "widechar_width",
    srcs = ["widechar_width.cpp"],
    hdrs = ["widechar_width.h"],
    clickhouse_code = True,
    copts = [
        "-I",
        "$(GENDIR)/bazel/gen/includes/configs",
    ],
    link_runtime = True,
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = ["."],
    deps = ["@clickhouse_llvm_project//:clang_rt_builtins"],
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
    includes = [
        ".",
    ],
)

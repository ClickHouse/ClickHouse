load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "CLICKHOUSE_WARNINGS")

package(default_visibility = ["//visibility:public"])

ch_cc_library(
    name = "readpassphrase",
    srcs = ["readpassphrase.c"],
    hdrs = glob(["**/*.h"]),
    copts = [
        "-fxray-instrument",
        "-fxray-modes=none",
        "-fxray-instrumentation-bundle=function",
        "-Wframe-larger-than=65536",
    ] + CLICKHOUSE_WARNINGS + [
        "-std=gnu11",
        "-Wno-unused-result",
        "-Wno-reserved-id-macro",
        "-Wno-disabled-macro-expansion",
    ],
    includes = [
        ".",
    ],
    language = "C",
    libcxx_headers = False,
    llvm_headers = False,
    local_defines = CXX_RUNTIME_DEFINES,
    deps = ["@clickhouse_llvm_project//:unwind"],
)

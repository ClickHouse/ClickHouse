load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "CLICKHOUSE_WARNINGS", "llvm_toolchain_path", "repository_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

ch_cc_library(
    name = "readpassphrase",
    srcs = ["readpassphrase.c"],
    hdrs = ["readpassphrase.h"],
    copts = [
        "-fxray-instrument",
        "-fxray-modes=none",
        "-fxray-instrumentation-bundle=function",
        "-Wframe-larger-than=65536",
    ] + CLICKHOUSE_WARNINGS + [
        "-std=gnu11",
        "-Wno-unused-result",
        "-Wno-reserved-id-macro",
        "-Wno-disabled-macro-expansion",
        "-I",
        "$(GENDIR)/bazel/gen/includes/configs",
    ],
    language = "C",
    link_runtime = True,
    llvm_headers = True,
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        ".",
        "../../" + (llvm_toolchain_path() + "/libunwind/include"),
        "../../" + (llvm_toolchain_path() + "/libc"),
        "../../" + (llvm_toolchain_path() + "/compiler-rt/include"),
        "../../" + (repository_path("contrib/llvm-project") + "/libcxxabi/include"),
    ],
    deps = [
        "@clickhouse_llvm_project//:clang_rt_builtins",
        "//base/glibc-compatibility:glibc-compatibility",
    ],
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
)

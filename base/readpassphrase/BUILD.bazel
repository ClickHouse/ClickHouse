load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "CLICKHOUSE_WARNINGS")

package(default_visibility = ["//visibility:public"])

ch_cc_library(
    name = "readpassphrase",
    srcs = ["readpassphrase.c"],
    hdrs = glob(["**/*.h"]),
    copts = [
        "-fxray-instrument",
        "-fxray-modes=none",
        "-fxray-instrumentation-bundle=function",
        "-Wframe-larger-than=65536",
    ] + CLICKHOUSE_WARNINGS + [
        "-std=gnu11",
        "-Wno-unused-result",
        "-Wno-reserved-id-macro",
        "-Wno-disabled-macro-expansion",
    ],
    implementation_deps = ["@clickhouse_llvm_project//:clang_rt_builtins"],
    includes = [
        ".",
    ],
    language = "C",
    libcxx_headers = False,
    llvm_headers = False,
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = ["@clickhouse_llvm_project//:unwind"],
)

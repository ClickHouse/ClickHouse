load("@clickhouse//base:poco/poco_cc_library.bzl", "poco_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

poco_cc_library(
    name = "_poco_redis",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["include/**/*.h"]),
    copts = [
        "-Wno-deprecated-dynamic-exception-spec",
        "-Wno-shadow",
        "-Wno-shorten-64-to-32",
        "-Wno-sign-compare",
        "-Wno-zero-as-null-pointer-constant",
        "-Wno-implicit-int-conversion",
    ],
    implementation_deps = ["//bazel:clickhouse_config_headers"],
    includes = ["include"],
    link_runtime = True,
    local_defines = [
        "POCO_ENABLE_CPP11",
        "POCO_OS_FAMILY_UNIX",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [],
    }) + [
        "//base:common",
        "//base/poco/Net:poco_net_headers",
    ],
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
    includes = [
        "include",
    ],
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "CLICKHOUSE_WARNINGS", "llvm_toolchain_path", "repository_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

ch_cc_library(
    name = "_poco_json",
    srcs = glob(["src/*.cpp"]),
    hdrs = [],
    clickhouse_code = True,
    copts = ["-Wframe-larger-than=65536"] + CLICKHOUSE_WARNINGS + [
        "-std=c++23",
        "-Wno-deprecated-dynamic-exception-spec",
        "-Wno-sign-compare",
        "-Wno-suggest-destructor-override",
        "-Wno-suggest-override",
        "-Wno-unused-parameter",
        "-Wno-zero-as-null-pointer-constant",
        "-Wno-implicit-int-conversion",
        "-I",
    ] + ["$(GENDIR)/bazel/gen/includes/configs"],
    local_defines = [
        "POCO_ENABLE_CPP11",
        "POCO_OS_FAMILY_UNIX",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "../../../" + "base/poco/JSON/include",
        "../../../" + "base/poco/Foundation/include",
        "../../../" + (llvm_toolchain_path() + "/libunwind/include"),
        "../../../" + (llvm_toolchain_path() + "/libc"),
        "../../../" + (llvm_toolchain_path() + "/compiler-rt/include"),
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "//base/poco/Net:_poco_net",
        ":poco_json_headers",
        "//base/poco/Foundation:headers",
    ],
)

ch_cc_library(
    name = "_poco_json_pdjson",
    srcs = ["src/pdjson.c"],
    hdrs = [] + ["src/pdjson.h"],
    additional_compiler_inputs = [
        "@clickhouse_llvm_project//:runtime_source_inputs",
        "@clickhouse_llvm_project//:runtime_generated_headers",
    ],
    copts = [
        "-fxray-instrument",
        "-fxray-modes=none",
        "-fxray-instrumentation-bundle=function",
        "-Wframe-larger-than=65536",
    ] + CLICKHOUSE_WARNINGS + [
        "-std=gnu11",
        "-Wno-cast-qual",
        "-Wno-declaration-after-statement",
        "-Wno-extra-semi-stmt",
        "-Wno-implicit-fallthrough",
        "-Wno-shorten-64-to-32",
        "-Wno-unreachable-code-return",
        "-Wno-implicit-int-conversion",
        "-I",
    ] + ["$(GENDIR)/bazel/gen/includes/configs"],
    language = "C",
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "../../../" + (llvm_toolchain_path() + "/libunwind/include"),
        "../../../" + (llvm_toolchain_path() + "/libc"),
        "../../../" + (llvm_toolchain_path() + "/compiler-rt/include"),
        "../../../" + (repository_path("contrib/llvm-project") + "/libcxxabi/include"),
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse_llvm_project//:clang_rt_builtins",
        "@clickhouse_llvm_project//:cxx",
        "@clickhouse_llvm_project//:cxxabi",
        "//base/glibc-compatibility:glibc-compatibility",
        "@clickhouse_llvm_project//:unwind",
    ],
)

cc_library(
    name = "poco_json_headers",
    hdrs = [
        "include/Poco/JSON/Array.h",
        "include/Poco/JSON/Handler.h",
        "include/Poco/JSON/JSON.h",
        "include/Poco/JSON/JSONException.h",
        "include/Poco/JSON/Object.h",
        "include/Poco/JSON/ParseHandler.h",
        "include/Poco/JSON/Parser.h",
        "include/Poco/JSON/ParserImpl.h",
        "include/Poco/JSON/PrintHandler.h",
        "include/Poco/JSON/Query.h",
        "include/Poco/JSON/Stringifier.h",
    ],
    includes = ["../../../" + "base/poco/JSON/include"],
    deps = ["//base/poco/Foundation:poco_foundation_headers"],
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
)

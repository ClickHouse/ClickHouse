load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "CLICKHOUSE_WARNINGS", "llvm_toolchain_path", "repository_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

ch_cc_library(
    name = "_poco_json",
    srcs = glob(["src/*.cpp"]),
    clickhouse_code = True,
    copts = [
        "-Wno-deprecated-dynamic-exception-spec",
        "-Wno-sign-compare",
        "-Wno-suggest-destructor-override",
        "-Wno-suggest-override",
        "-Wno-unused-parameter",
        "-Wno-zero-as-null-pointer-constant",
        "-Wno-implicit-int-conversion",
        "-I",
        "$(GENDIR)/bazel/gen/includes/configs",
    ],
    local_defines = [
        "POCO_ENABLE_CPP11",
        "POCO_OS_FAMILY_UNIX",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = [
        "//base/poco/Net:_poco_net",
        ":poco_json_headers",
        "//base/poco/Foundation:headers",
    ],
)

ch_cc_library(
    name = "_poco_json_pdjson",
    srcs = ["src/pdjson.c"],
    hdrs = ["src/pdjson.h"],
    copts = [
        "-fxray-instrument",
        "-fxray-modes=none",
        "-fxray-instrumentation-bundle=function",
        "-Wframe-larger-than=65536",
    ] + CLICKHOUSE_WARNINGS + [
        "-std=gnu11",
        "-Wno-cast-qual",
        "-Wno-declaration-after-statement",
        "-Wno-extra-semi-stmt",
        "-Wno-implicit-fallthrough",
        "-Wno-shorten-64-to-32",
        "-Wno-unreachable-code-return",
        "-Wno-implicit-int-conversion",
        "-I",
    ] + ["$(GENDIR)/bazel/gen/includes/configs"],
    language = "C",
    link_runtime = True,
    llvm_headers = True,
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "../../../" + (llvm_toolchain_path() + "/libunwind/include"),
        "../../../" + (llvm_toolchain_path() + "/libc"),
        "../../../" + (llvm_toolchain_path() + "/compiler-rt/include"),
        "../../../" + (repository_path("contrib/llvm-project") + "/libcxxabi/include"),
    ],
    deps = [
        "@clickhouse_llvm_project//:clang_rt_builtins",
        "//base/glibc-compatibility:glibc-compatibility",
    ],
)

cc_library(
    name = "poco_json_headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    deps = ["//base/poco/Foundation:poco_foundation_headers"],
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
)

load("@clickhouse//base:poco/poco_cc_library.bzl", "poco_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

_NET_SSL_PRIVATE_HEADERS = [
    "include/Poco/Net/HTTPSSessionInstantiator.h",
    "include/Poco/Net/KeyConsoleHandler.h",
    "include/Poco/Net/KeyFileHandler.h",
    "include/Poco/Net/SecureServerSocketImpl.h",
]

exports_files([
    "src/EmbeddedCertificates.cpp",
])

_NET_SSL_COPTS = [
    "-Wno-cast-qual",
    "-Wno-covered-switch-default",
    "-Wno-deprecated-copy-with-user-provided-dtor",
    "-Wno-deprecated-dynamic-exception-spec",
    "-Wno-extra-semi",
    "-Wno-extra-semi-stmt",
    "-Wno-implicit-fallthrough",
    "-Wno-old-style-cast",
    "-Wno-shorten-64-to-32",
    "-Wno-sign-compare",
    "-Wno-unused-exception-parameter",
    "-Wno-unused-macros",
    "-Wno-unused-parameter",
    "-Wno-zero-as-null-pointer-constant",
]

_NET_SSL_DEFINES = select({
    "@platforms//cpu:x86_64": [],
    "@platforms//cpu:aarch64": [
        "ARM_ACLE",
        "ARM_ASM_HWCAP",
        "ARM_AUXV_HAS_CRC32",
        "ARM_AUXV_HAS_NEON",
        "ARM_FEATURES",
        "ARM_NEON",
        "ARM_NEON_HASLD4",
    ],
}) + [
    "BOOST_ASIO_HAS_STD_INVOKE_RESULT=1",
    "BOOST_ASIO_STANDALONE=1",
    "BOOST_TIMER_ENABLE_DEPRECATED=1",
    "ENABLE_DISTRIBUTED_CACHE=0",
    "FIU_ENABLE",
] + select({
    "@platforms//cpu:x86_64": [],
    "@platforms//cpu:aarch64": [
        "HAVE_ARM_ACLE_H",
    ],
}) + [
    "HAVE_ATTRIBUTE_ALIGNED",
    "HAVE_BUILTIN_CTZ",
    "HAVE_BUILTIN_CTZLL",
    "HAVE_CONFIG_H",
    "HAVE_POSIX_MEMALIGN",
] + select({
    "@platforms//cpu:x86_64": [],
    "@platforms//cpu:aarch64": [
        "HAVE_SYS_AUXV_H",
    ],
}) + [
    "HAVE_VISIBILITY_HIDDEN",
    "HAVE_VISIBILITY_INTERNAL",
    "JEMALLOC_NO_RENAME",
    "PICOJSON_USE_LOCALE=0",
    "POCO_ENABLE_CPP11",
    "POCO_OS_FAMILY_UNIX",
    "STD_EXCEPTION_HAS_STACK_TRACE=1",
    "UNALIGNED_OK",
    "WITH_COVERAGE=0",
    "WITH_COVERAGE_DEPTH=0",
    "WITH_GZFILEOP",
    "X86_64",
] + select({
    "@platforms//cpu:x86_64": [
        "X86_AVX2",
        "X86_FEATURES",
        "X86_PCLMULQDQ_CRC",
        "X86_SSE2",
        "X86_SSE42",
        "X86_SSSE3",
    ],
    "@platforms//cpu:aarch64": [],
}) + [
    "ZLIB_COMPAT",
    "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
    "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
    "_LIBUNWIND_IS_NATIVE_ONLY",
]

poco_cc_library(
    name = "_poco_net_ssl__compile_0",
    srcs = glob(
        ["src/*.cpp"],
        exclude = [
            "src/EmbeddedCertificates.cpp",
            "src/SecureSocketImpl.cpp",
        ],
    ) + _NET_SSL_PRIVATE_HEADERS,
    hdrs = glob(
        ["include/**/*.h"],
        exclude = _NET_SSL_PRIVATE_HEADERS,
    ),
    copts = _NET_SSL_COPTS,
    includes = ["include"],
    local_defines = _NET_SSL_DEFINES,
    deps = [
        "//base/poco/Foundation:_poco_foundation",
        "//base/poco/Net:_poco_net",
        "//base/poco/Util:_poco_util",
        "@clickhouse_openssl//:crypto",
        "@clickhouse_openssl//:ssl",
    ],
)

poco_cc_library(
    name = "_poco_net_ssl__compile_1",
    srcs = ["//bazel:gen/embedded/base/poco/NetSSL_OpenSSL/src/EmbeddedCertificates.cpp"],
    additional_compiler_inputs = ["//bazel:gen/embedded/contrib/grpc/etc/roots.pem"],
    copts = _NET_SSL_COPTS,
    implementation_deps = [":_poco_net_ssl__compile_0"],
    local_defines = _NET_SSL_DEFINES + ["POCO_EMBEDDED_CA_CERTIFICATES=1"],
)

poco_cc_library(
    name = "secure_socket",
    srcs = ["src/SecureSocketImpl.cpp"],
    copts = _NET_SSL_COPTS,
    implementation_deps = [
        ":_poco_net_ssl__compile_0",
        "//src/Common",
        "//base/poco/Foundation:_poco_foundation",
        "//base/poco/Net:_poco_net",
        "@clickhouse_openssl//:crypto",
    ],
    local_defines = _NET_SSL_DEFINES,
)

cc_library(
    name = "_poco_net_ssl",
    deps = [
        ":_poco_net_ssl__compile_0",
        ":_poco_net_ssl__compile_1",
        ":secure_socket",
    ],
)

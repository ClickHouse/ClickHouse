load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "CLICKHOUSE_WARNINGS", "llvm_toolchain_path", "repository_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "src/xmltok_impl.c",
    "src/xmltok_ns.c",
])

_GENERATED_HDRS_0 = glob(["**/*.h"])

ch_cc_library(
    name = "_poco_xml",
    srcs = glob(["src/*.cpp"]),
    hdrs = _GENERATED_HDRS_0,
    clickhouse_code = True,
    copts = [
        "-Wno-c99-extensions",
        "-Wno-cast-qual",
        "-Wno-covered-switch-default",
        "-Wno-deprecated-dynamic-exception-spec",
        "-Wno-disabled-macro-expansion",
        "-Wno-implicit-fallthrough",
        "-Wno-missing-noreturn",
        "-Wno-old-style-cast",
        "-Wno-reserved-identifier",
        "-Wno-shadow",
        "-Wno-shorten-64-to-32",
        "-Wno-suggest-destructor-override",
        "-Wno-suggest-override",
        "-Wno-tautological-type-limit-compare",
        "-Wno-tautological-unsigned-zero-compare",
        "-Wno-unreachable-code",
        "-Wno-unreachable-code-break",
        "-Wno-unreachable-code-fallthrough",
        "-Wno-unreachable-code-return",
        "-Wno-unused-macros",
        "-Wno-unused-parameter",
        "-Wno-zero-as-null-pointer-constant",
        "-I",
        "$(GENDIR)/bazel/gen/includes/configs",
    ],
    local_defines = [
        "POCO_ENABLE_CPP11",
        "POCO_OS_FAMILY_UNIX",
        "PRIVATE",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "XML_GE=0",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
        "_poco_xml",
    ],
    deps = [
        "//src:clickhouse_common_io",
        ":poco_xml_headers",
    ],
)

ch_cc_library(
    name = "_poco_xml_expat",
    srcs = glob(["src/*.c"]),
    hdrs = _GENERATED_HDRS_0,
    additional_compiler_inputs = [
        "src/xmltok_impl.c",
        "src/xmltok_ns.c",
    ],
    copts = [
        "-fxray-instrument",
        "-fxray-modes=none",
        "-fxray-instrumentation-bundle=function",
        "-Wframe-larger-than=65536",
    ] + CLICKHOUSE_WARNINGS + [
        "-std=gnu11",
        "-Wno-cast-qual",
        "-Wno-disabled-macro-expansion",
        "-Wno-empty-translation-unit",
        "-Wno-extra-semi-stmt",
        "-Wno-implicit-fallthrough",
        "-Wno-reserved-identifier",
        "-Wno-unreachable-code-fallthrough",
        "-Wno-unused-macros",
        "-Wno-implicit-int-conversion",
        "-I",
        "$(GENDIR)/bazel/gen/includes/configs",
    ],
    language = "C",
    link_runtime = True,
    llvm_headers = True,
    local_defines = [
        "PRIVATE",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "XML_GE=0",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
        "_poco_xml",
    ],
    local_includes = [
        "include",
        "../../../" + (llvm_toolchain_path() + "/libunwind/include"),
        "../../../" + (llvm_toolchain_path() + "/libc"),
        "../../../" + (llvm_toolchain_path() + "/compiler-rt/include"),
        "../../../" + (repository_path("contrib/llvm-project") + "/libcxxabi/include"),
    ],
    deps = [
        "@clickhouse_llvm_project//:clang_rt_builtins",
        "//base/poco/Foundation:headers",
    ],
)

cc_library(
    name = "poco_xml_headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    deps = ["//base/poco/Foundation:poco_foundation_headers"],
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
    includes = [
        "include",
    ],
)

load("@clickhouse//base:poco/poco_cc_library.bzl", "poco_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "src/xmltok_impl.c",
    "src/xmltok_ns.c",
])

poco_cc_library(
    name = "_poco_xml",
    srcs = glob(["src/*.cpp"]) + glob(
        ["src/**/*.h"],
        exclude = [
            "src/asciitab.h",
            "src/iasciitab.h",
            "src/latin1tab.h",
            "src/nametab.h",
            "src/utf8tab.h",
            "src/xmltok_impl.h",
        ],
    ),
    hdrs = glob(["include/**/*.h"]),
    copts = [
        "-Wno-c99-extensions",
        "-Wno-cast-qual",
        "-Wno-covered-switch-default",
        "-Wno-deprecated-dynamic-exception-spec",
        "-Wno-disabled-macro-expansion",
        "-Wno-implicit-fallthrough",
        "-Wno-old-style-cast",
        "-Wno-reserved-identifier",
        "-Wno-shadow",
        "-Wno-shorten-64-to-32",
        "-Wno-suggest-destructor-override",
        "-Wno-suggest-override",
        "-Wno-tautological-type-limit-compare",
        "-Wno-tautological-unsigned-zero-compare",
        "-Wno-unreachable-code",
        "-Wno-unreachable-code-break",
        "-Wno-unreachable-code-fallthrough",
        "-Wno-unreachable-code-return",
        "-Wno-unused-macros",
        "-Wno-unused-parameter",
        "-Wno-zero-as-null-pointer-constant",
    ],
    includes = ["include"],
    llvm_headers = False,
    local_defines = [
        "POCO_ENABLE_CPP11",
        "POCO_OS_FAMILY_UNIX",
        "PRIVATE",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "XML_GE=0",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
        "_poco_xml",
    ],
    deps = ["//base/poco/Foundation:_poco_foundation"],
)

poco_cc_library(
    name = "_poco_xml_expat",
    srcs = glob(["src/*.c"]) + glob(
        [
            "src/*.h",
            "include/Poco/XML/expat*.h",
        ],
        exclude = [
            "src/hash_table.h",
            "src/siphash.h",
        ],
    ),
    additional_compiler_inputs = [
        "src/xmltok_impl.c",
        "src/xmltok_ns.c",
    ],
    copts = [
        "-Wno-cast-qual",
        "-Wno-disabled-macro-expansion",
        "-Wno-empty-translation-unit",
        "-Wno-extra-semi-stmt",
        "-Wno-implicit-fallthrough",
        "-Wno-reserved-identifier",
        "-Wno-unreachable-code-fallthrough",
        "-Wno-unused-macros",
        "-Wno-implicit-int-conversion",
    ],
    implementation_deps = [
        "//bazel:clickhouse_config_headers",
        "//base/poco/Foundation:_poco_foundation",
        "@llvm-project//libunwind:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//compiler-rt:headers",
        "@clickhouse_llvm_project//:libcxxabi_headers",
    ],
    language = "C",
    local_defines = [
        "PRIVATE",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "XML_GE=0",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
        "_poco_xml",
    ],
    local_includes = ["include"],
    deps = ["@clickhouse_llvm_project//:clang_rt_builtins"],
)

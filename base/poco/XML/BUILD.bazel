load("@clickhouse//base:poco/poco_cc_library.bzl", "poco_cc_library")

package(default_visibility = ["//visibility:public"])

_EXPAT_INTERNAL_HEADERS = [
    "src/ascii.h",
    "src/expat_config.h",
    "src/fallthrough.h",
    "src/internal.h",
    "src/xcs.h",
    "src/xmlrole.h",
    "src/xmltok.h",
]

_XML_PRIVATE_HEADERS = [
    "include/Poco/DOM/AttrMap.h",
    "include/Poco/DOM/CDATASection.h",
    "include/Poco/DOM/ChildNodesList.h",
    "include/Poco/DOM/DOMBuilder.h",
    "include/Poco/DOM/DOMException.h",
    "include/Poco/DOM/DOMImplementation.h",
    "include/Poco/DOM/DOMSerializer.h",
    "include/Poco/DOM/DTDMap.h",
    "include/Poco/DOM/DocumentFragment.h",
    "include/Poco/DOM/DocumentType.h",
    "include/Poco/DOM/ElementsByTagNameList.h",
    "include/Poco/DOM/Entity.h",
    "include/Poco/DOM/EntityReference.h",
    "include/Poco/DOM/EventDispatcher.h",
    "include/Poco/DOM/EventException.h",
    "include/Poco/DOM/EventListener.h",
    "include/Poco/DOM/NodeAppender.h",
    "include/Poco/DOM/NodeFilter.h",
    "include/Poco/DOM/NodeIterator.h",
    "include/Poco/DOM/Notation.h",
    "include/Poco/DOM/ProcessingInstruction.h",
    "include/Poco/DOM/TreeWalker.h",
    "include/Poco/SAX/AttributesImpl.h",
    "include/Poco/SAX/DeclHandler.h",
    "include/Poco/SAX/EntityResolverImpl.h",
    "include/Poco/SAX/LocatorImpl.h",
    "include/Poco/SAX/SAXException.h",
    "include/Poco/SAX/WhitespaceFilter.h",
    "include/Poco/SAX/XMLFilter.h",
    "include/Poco/SAX/XMLFilterImpl.h",
    "include/Poco/XML/Content.h",
    "include/Poco/XML/NamespaceStrategy.h",
    "include/Poco/XML/QName.h",
    "include/Poco/XML/ValueTraits.h",
    "include/Poco/XML/XMLStreamParser.h",
    "include/Poco/XML/XMLStreamParserException.h",
]

poco_cc_library(
    name = "_poco_xml",
    srcs = glob(["src/*.cpp"]) + [
        "src/hash_table.h",
        "src/siphash.h",
    ] + _XML_PRIVATE_HEADERS + _EXPAT_INTERNAL_HEADERS,
    hdrs = glob(
        ["include/**/*.h"],
        exclude = ["include/Poco/XML/expat*.h"] + _XML_PRIVATE_HEADERS,
    ),
    copts = [
        "-Wno-c99-extensions",
        "-Wno-cast-qual",
        "-Wno-covered-switch-default",
        "-Wno-deprecated-dynamic-exception-spec",
        "-Wno-disabled-macro-expansion",
        "-Wno-implicit-fallthrough",
        "-Wno-old-style-cast",
        "-Wno-reserved-identifier",
        "-Wno-shadow",
        "-Wno-shorten-64-to-32",
        "-Wno-suggest-destructor-override",
        "-Wno-suggest-override",
        "-Wno-tautological-type-limit-compare",
        "-Wno-tautological-unsigned-zero-compare",
        "-Wno-unreachable-code",
        "-Wno-unreachable-code-break",
        "-Wno-unreachable-code-fallthrough",
        "-Wno-unreachable-code-return",
        "-Wno-unused-macros",
        "-Wno-unused-parameter",
        "-Wno-zero-as-null-pointer-constant",
    ],
    includes = ["include"],
    llvm_headers = False,
    local_defines = [
        "POCO_ENABLE_CPP11",
        "POCO_OS_FAMILY_UNIX",
        "PRIVATE",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "XML_GE=0",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
        "_poco_xml",
    ],
    deps = [
        ":_poco_xml_expat",
        "//base/poco/Foundation:_poco_foundation",
    ],
)

poco_cc_library(
    name = "_poco_xml_expat",
    srcs = glob(
        ["src/*.c"],
        exclude = [
            "src/xmltok_impl.c",
            "src/xmltok_ns.c",
        ],
    ) + [
        "src/asciitab.h",
        "src/iasciitab.h",
        "src/latin1tab.h",
        "src/nametab.h",
        "src/utf8tab.h",
        "src/xmltok_impl.h",
    ] + _EXPAT_INTERNAL_HEADERS,
    hdrs = glob(["include/Poco/XML/expat*.h"]),
    copts = [
        "-Wno-cast-qual",
        "-Wno-disabled-macro-expansion",
        "-Wno-empty-translation-unit",
        "-Wno-extra-semi-stmt",
        "-Wno-implicit-fallthrough",
        "-Wno-reserved-identifier",
        "-Wno-unreachable-code-fallthrough",
        "-Wno-unused-macros",
        "-Wno-implicit-int-conversion",
    ],
    implementation_deps = ["//base/poco/Foundation:_poco_foundation"],
    includes = ["include"],
    language = "C",
    llvm_headers = False,
    local_defines = [
        "PRIVATE",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "XML_GE=0",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
        "_poco_xml",
    ],
    private_hdrs = [
        "src/xmltok_impl.c",
        "src/xmltok_ns.c",
    ],
)

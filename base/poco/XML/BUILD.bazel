poco_cc_library(
    name = "_poco_xml_expat",
    srcs = glob(["src/*.c"]),
    hdrs = _GENERATED_HDRS_0,
    additional_compiler_inputs = [
        "src/xmltok_impl.c",
        "src/xmltok_ns.c",
    ],
    copts = [
        "-Wno-cast-qual",
        "-Wno-disabled-macro-expansion",
        "-Wno-empty-translation-unit",
        "-Wno-extra-semi-stmt",

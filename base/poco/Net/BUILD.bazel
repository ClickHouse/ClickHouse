load("@clickhouse//base:poco/poco_cc_library.bzl", "poco_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

poco_cc_library(
    name = "_poco_net",
    srcs = glob(["src/*.cpp"]),
    copts = [
        "-Wno-atomic-implicit-seq-cst",
        "-Wno-cast-align",
        "-Wno-cast-qual",
        "-Wno-comma",
        "-Wno-covered-switch-default",
        "-Wno-deprecated",
        "-Wno-extra-semi",
        "-Wno-extra-semi-stmt",
        "-Wno-old-style-cast",
        "-Wno-shadow",
        "-Wno-shorten-64-to-32",
        "-Wno-sign-compare",
        "-Wno-suggest-destructor-override",
        "-Wno-suggest-override",
        "-Wno-undef",
        "-Wno-unreachable-code",
        "-Wno-unreachable-code-return",
        "-Wno-unused-macros",
        "-Wno-unused-parameter",
        "-Wno-zero-as-null-pointer-constant",
        "-Wno-implicit-int-conversion",
        "-Wno-implicit-int-float-conversion",
        "-I",
        "$(GENDIR)/bazel/gen/includes/configs",
    ],
    local_defines = [
        "POCO_ENABLE_CPP11",
        "POCO_HAVE_FD_EPOLL",
        "POCO_OS_FAMILY_UNIX",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = ["//base/poco/NetSSL_OpenSSL:_poco_net_ssl"],
)

cc_library(
    name = "poco_net_headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    deps = ["//base/poco/Foundation:poco_foundation_headers"],
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
    includes = [
        "include",
    ],
)

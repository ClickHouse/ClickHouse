load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "llvm_toolchain_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "include/Poco/Net/HTTPClientSession.h",
    "include/Poco/Net/HTTPCookie.h",
    "include/Poco/Net/HTTPMessage.h",
    "include/Poco/Net/HTTPRequest.h",
    "include/Poco/Net/HTTPResponse.h",
    "include/Poco/Net/HTTPSession.h",
    "include/Poco/Net/HTTPSessionFactory.h",
    "include/Poco/Net/IPAddress.h",
    "include/Poco/Net/IPAddressImpl.h",
    "include/Poco/Net/MessageHeader.h",
    "include/Poco/Net/NameValueCollection.h",
    "include/Poco/Net/Net.h",
    "include/Poco/Net/Socket.h",
    "include/Poco/Net/SocketAddress.h",
    "include/Poco/Net/SocketAddressImpl.h",
    "include/Poco/Net/SocketDefs.h",
    "include/Poco/Net/SocketImpl.h",
    "include/Poco/Net/StreamSocket.h",
    "include/Poco/Net/Throttler.h",
])

ch_cc_library(
    name = "_poco_net",
    srcs = glob(["src/*.cpp"]),
    clickhouse_code = True,
    copts = [
        "-Wno-atomic-implicit-seq-cst",
        "-Wno-cast-align",
        "-Wno-cast-qual",
        "-Wno-comma",
        "-Wno-covered-switch-default",
        "-Wno-deprecated",
        "-Wno-extra-semi",
        "-Wno-extra-semi-stmt",
        "-Wno-missing-noreturn",
        "-Wno-old-style-cast",
        "-Wno-shadow",
        "-Wno-shorten-64-to-32",
        "-Wno-sign-compare",
        "-Wno-suggest-destructor-override",
        "-Wno-suggest-override",
        "-Wno-undef",
        "-Wno-unreachable-code",
        "-Wno-unreachable-code-return",
        "-Wno-unused-macros",
        "-Wno-unused-parameter",
        "-Wno-zero-as-null-pointer-constant",
        "-Wno-implicit-int-conversion",
        "-Wno-implicit-int-float-conversion",
        "-I",
        "$(GENDIR)/bazel/gen/includes/configs",
    ],
    local_defines = [
        "POCO_ENABLE_CPP11",
        "POCO_HAVE_FD_EPOLL",
        "POCO_OS_FAMILY_UNIX",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "../../../" + "base/poco/Net/include",
        "../../../" + "base/poco/Foundation/include",
        "../../../" + (llvm_toolchain_path() + "/libunwind/include"),
        "../../../" + (llvm_toolchain_path() + "/libc"),
        "../../../" + (llvm_toolchain_path() + "/compiler-rt/include"),
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "//base/poco/NetSSL_OpenSSL:_poco_net_ssl",
        ":poco_net_headers",
        "//base/poco/Foundation:headers",
    ],
)


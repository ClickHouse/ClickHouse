load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "llvm_toolchain_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

ch_cc_library(
    name = "_poco_util",
    srcs = glob(["src/*.cpp"]),
    clickhouse_code = True,
    copts = [
        "-Wno-deprecated-dynamic-exception-spec",
        "-Wno-disabled-macro-expansion",
        "-Wno-extra-semi-stmt",
        "-Wno-newline-eof",
        "-Wno-old-style-cast",
        "-Wno-shadow",
        "-Wno-sign-compare",
        "-Wno-suggest-destructor-override",
        "-Wno-suggest-override",
        "-Wno-unused-parameter",
        "-Wno-zero-as-null-pointer-constant",
        "-Wno-implicit-int-conversion",
        "-I",
        "$(GENDIR)/bazel/gen/includes/configs",
    ],
    local_defines = [
        "POCO_ENABLE_CPP11",
        "POCO_OS_FAMILY_UNIX",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "../../../" + "base/poco/Util/include",
        "../../../" + "base/poco/JSON/include",
        "../../../" + "base/poco/Foundation/include",
        "../../../" + "base/poco/XML/include",
        "../../../" + "base/poco/Net/include",
        "../../../" + (llvm_toolchain_path() + "/libunwind/include"),
        "../../../" + (llvm_toolchain_path() + "/libc"),
        "../../../" + (llvm_toolchain_path() + "/compiler-rt/include"),
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "//base/poco/XML:_poco_xml",
        ":poco_util_headers",
        "//base/poco/Foundation:headers",
        "//base/poco/JSON:headers",
        "//base/poco/Net:headers",
        "//base/poco/XML:headers",
    ],
)

cc_library(
    name = "poco_util_headers",
    hdrs = [
        "include/Poco/Util/AbstractConfiguration.h",
        "include/Poco/Util/Application.h",
        "include/Poco/Util/ConfigurationView.h",
        "include/Poco/Util/FilesystemConfiguration.h",
        "include/Poco/Util/HelpFormatter.h",
        "include/Poco/Util/IniFileConfiguration.h",
        "include/Poco/Util/IntValidator.h",
        "include/Poco/Util/JSONConfiguration.h",
        "include/Poco/Util/LayeredConfiguration.h",
        "include/Poco/Util/LoggingConfigurator.h",
        "include/Poco/Util/LoggingSubsystem.h",
        "include/Poco/Util/MapConfiguration.h",
        "include/Poco/Util/Option.h",
        "include/Poco/Util/OptionCallback.h",
        "include/Poco/Util/OptionException.h",
        "include/Poco/Util/OptionProcessor.h",
        "include/Poco/Util/OptionSet.h",
        "include/Poco/Util/PropertyFileConfiguration.h",
        "include/Poco/Util/RegExpValidator.h",
        "include/Poco/Util/ServerApplication.h",
        "include/Poco/Util/Subsystem.h",
        "include/Poco/Util/SystemConfiguration.h",
        "include/Poco/Util/Timer.h",
        "include/Poco/Util/TimerTask.h",
        "include/Poco/Util/TimerTaskAdapter.h",
        "include/Poco/Util/Units.h",
        "include/Poco/Util/Util.h",
        "include/Poco/Util/Validator.h",
        "include/Poco/Util/XMLConfiguration.h",
    ],
    includes = ["../../../" + "base/poco/Util/include"],
    deps = [
        "//base/poco/Foundation:poco_foundation_headers",
        "//base/poco/JSON:poco_json_headers",
        "//base/poco/XML:poco_xml_headers",
    ],
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
)

load("@clickhouse//base:poco/poco_cc_library.bzl", "poco_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

poco_cc_library(
    name = "_poco_util",
    srcs = glob(["src/*.cpp"]),
    copts = [
        "-Wno-deprecated-dynamic-exception-spec",
        "-Wno-disabled-macro-expansion",
        "-Wno-extra-semi-stmt",
        "-Wno-newline-eof",
        "-Wno-old-style-cast",
        "-Wno-shadow",
        "-Wno-sign-compare",
        "-Wno-suggest-destructor-override",
        "-Wno-suggest-override",
        "-Wno-unused-parameter",
        "-Wno-zero-as-null-pointer-constant",
        "-Wno-implicit-int-conversion",
    ],
    implementation_deps = [
        "//bazel:clickhouse_config_headers",
        "//base/poco/Net:poco_net_headers",
    ],
    local_defines = [
        "POCO_ENABLE_CPP11",
        "POCO_OS_FAMILY_UNIX",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = [
        "//base/poco/XML:_poco_xml",
        ":poco_util_headers",
    ],
)

cc_library(
    name = "poco_util_headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    deps = [
        "//base/poco/JSON:poco_json_headers",
        "//base/poco/XML:poco_xml_headers",
    ],
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
    includes = [
        "include",
    ],
)

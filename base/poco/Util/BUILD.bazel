load("@clickhouse//base:poco/poco_cc_library.bzl", "poco_cc_library")
load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES")

package(default_visibility = ["//visibility:public"])

_UTIL_PRIVATE_HEADERS = [
    "include/Poco/Util/ConfigurationView.h",
    "include/Poco/Util/FilesystemConfiguration.h",
    "include/Poco/Util/IniFileConfiguration.h",
    "include/Poco/Util/IntValidator.h",
    "include/Poco/Util/LoggingConfigurator.h",
    "include/Poco/Util/LoggingSubsystem.h",
    "include/Poco/Util/OptionProcessor.h",
    "include/Poco/Util/PropertyFileConfiguration.h",
    "include/Poco/Util/RegExpValidator.h",
    "include/Poco/Util/SystemConfiguration.h",
    "include/Poco/Util/Timer.h",
    "include/Poco/Util/TimerTask.h",
    "include/Poco/Util/Validator.h",
]

poco_cc_library(
    name = "_poco_util",
    srcs = glob(["src/*.cpp"]) + _UTIL_PRIVATE_HEADERS,
    hdrs = glob(
        ["include/**/*.h"],
        exclude = _UTIL_PRIVATE_HEADERS,
    ),
    copts = [
        "-Wno-deprecated-dynamic-exception-spec",
        "-Wno-disabled-macro-expansion",
        "-Wno-extra-semi-stmt",
        "-Wno-newline-eof",
        "-Wno-old-style-cast",
        "-Wno-shadow",
        "-Wno-sign-compare",
        "-Wno-suggest-destructor-override",
        "-Wno-suggest-override",
        "-Wno-unused-parameter",
        "-Wno-zero-as-null-pointer-constant",
        "-Wno-implicit-int-conversion",
    ],
    implementation_deps = [
        "//base/poco/Net:_poco_net",
    ],
    includes = ["include"],
    local_defines = [
        "POCO_ENABLE_CPP11",
        "POCO_OS_FAMILY_UNIX",
    ] + CXX_RUNTIME_DEFINES,
    deps = [
        "//base/poco/JSON:_poco_json",
        "//base/poco/XML:_poco_xml",
        "//base/poco/Foundation:_poco_foundation",
    ],
)

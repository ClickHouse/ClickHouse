load("@clickhouse//base:poco/poco_cc_library.bzl", "poco_cc_library")

package(default_visibility = ["//visibility:public"])

poco_cc_library(
    name = "_poco_util",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["include/**/*.h"]),
    copts = [
        "-Wno-deprecated-dynamic-exception-spec",
        "-Wno-disabled-macro-expansion",
        "-Wno-extra-semi-stmt",
        "-Wno-newline-eof",
        "-Wno-old-style-cast",
        "-Wno-shadow",
        "-Wno-sign-compare",
        "-Wno-suggest-destructor-override",
        "-Wno-suggest-override",
        "-Wno-unused-parameter",
        "-Wno-zero-as-null-pointer-constant",
        "-Wno-implicit-int-conversion",
    ],
    implementation_deps = [
        "//base/poco/Net:_poco_net",
    ],
    includes = ["include"],
    local_defines = [
        "POCO_ENABLE_CPP11",
        "POCO_OS_FAMILY_UNIX",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = [
        "//base/poco/JSON:_poco_json",
        "//base/poco/XML:_poco_xml",
        "//base/poco/Foundation:_poco_foundation",
    ],
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "CLICKHOUSE_WARNINGS")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

ch_cc_library(
    name = "glibc-rseq",
    srcs = ["rseq.c"],
    hdrs = [
        "rseq.h",
        "//bazel:gen/includes/configs/config.h",
        "//bazel:gen/includes/configs/config_tools.h",
        "//bazel:gen/includes/configs/config_version.cpp",
    ],
    copts = [
        "-fxray-instrument",
        "-fxray-modes=none",
        "-fxray-instrumentation-bundle=function",
        "-Wframe-larger-than=65536",
    ] + CLICKHOUSE_WARNINGS + [
        "-std=gnu11",
        "-fno-direct-access-external-data",
        "-Wno-declaration-after-statement",
    ],
    implementation_deps = [
        "//bazel:clickhouse_config_headers",
        "@llvm-project//libunwind:headers",
        "@llvm-project//libc:libc_headers",
        "@clickhouse_llvm_project//:libcxxabi_headers",
    ],
    language = "C",
    link_runtime = True,
    llvm_headers = True,
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = ["//base/glibc-compatibility"],
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
)

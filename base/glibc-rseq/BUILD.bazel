load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

ch_cc_library(
    name = "glibc-rseq",
    srcs = ["rseq.c"],
    hdrs = ["rseq.h"],
    clickhouse_code = True,
    copts = [
        "-fno-direct-access-external-data",
        "-Wno-declaration-after-statement",
    ],
    language = "C",
    libcxx_headers = False,
    local_defines = CXX_RUNTIME_DEFINES,
)

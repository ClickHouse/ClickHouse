load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "CLICKHOUSE_WARNINGS", "llvm_toolchain_path", "repository_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["rseq.h"])

ch_cc_library(
    name = "glibc-rseq",
    srcs = [
        "rseq.c",
        "rseq.h",
    ],
    hdrs = select({
        "@platforms//cpu:x86_64": [
            "//bazel:config/x86_64/includes/configs/config.h",
            "//bazel:config/x86_64/includes/configs/config_tools.h",
            "//bazel:config/x86_64/includes/configs/config_version.cpp",
        ],
        "@platforms//cpu:aarch64": [
            "//bazel:config/aarch64/includes/configs/config.h",
            "//bazel:config/aarch64/includes/configs/config_tools.h",
            "//bazel:config/aarch64/includes/configs/config_version.cpp",
        ],
    }),
    additional_compiler_inputs = [
        "@clickhouse_llvm_project//:runtime_source_inputs",
        "@clickhouse_llvm_project//:runtime_generated_headers",
        "rseq.c",
    ],
    copts = [
        "-fxray-instrument",
        "-fxray-modes=none",
        "-fxray-instrumentation-bundle=function",
        "-Wframe-larger-than=65536",
    ] + CLICKHOUSE_WARNINGS + [
        "-std=gnu11",
        "-fno-direct-access-external-data",
        "-Wno-declaration-after-statement",
        "-I",
    ] + select({
        "@platforms//cpu:x86_64": ["bazel/config/x86_64/includes/configs"],
        "@platforms//cpu:aarch64": ["bazel/config/aarch64/includes/configs"],
    }),
    language = "C",
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "../../" + (llvm_toolchain_path() + "/libunwind/include"),
        "../../" + (llvm_toolchain_path() + "/libc"),
        "../../" + (llvm_toolchain_path() + "/compiler-rt/include"),
        "../../" + (repository_path("contrib/llvm-project") + "/libcxxabi/include"),
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse_llvm_project//:cxx",
        "@clickhouse_llvm_project//:cxxabi",
        "//base/glibc-compatibility:glibc-compatibility",
        "@clickhouse_llvm_project//:unwind",
    ],
    alwayslink = False,
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
    textual_hdrs = [],
)

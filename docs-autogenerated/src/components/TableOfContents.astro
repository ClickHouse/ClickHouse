---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const headings = Astro.props.headings.filter(({ depth }) => depth >= 2 && depth <= 4).slice(0, 30);
---

{headings.length > 0 && (
  <nav class="table-of-contents" aria-labelledby="table-of-contents-title">
    <h2 id="table-of-contents-title">
      <button class="toc-heading" type="button" aria-expanded="true" aria-controls="table-of-contents-list">
        <svg aria-hidden="true" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2.75 14.25H15.25M2.75 3.75H15.25M2.75 9H8.25" />
        </svg>
        <span>On this page</span>
      </button>
    </h2>
    <ol id="table-of-contents-list" class="toc-list">
      {headings.map((heading, index) => (
        <li class:list={['toc-item', { nested: heading.depth >= 3, deep: heading.depth === 4, active: index === 0 }]} data-depth={heading.depth}>
          <a class="toc-link" href={`#${heading.slug}`} aria-current={index === 0 ? 'location' : undefined}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  let tableOfContentsController: AbortController | undefined;

  function initializeTableOfContents() {
    tableOfContentsController?.abort();
    tableOfContentsController = new AbortController();
    const tocHeading = document.querySelector<HTMLButtonElement>('.toc-heading');
    const tocList = document.querySelector<HTMLOListElement>('.toc-list');
    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')];
    const tocTargets = tocLinks
      .map((link) => {
        const id = link.hash.slice(1);
        return { link, target: document.getElementById(id) };
      })
      .filter((entry): entry is { link: HTMLAnchorElement; target: HTMLElement } => entry.target !== null);

    const setActiveLink = (activeLink: HTMLAnchorElement | undefined) => {
      tocLinks.forEach((link) => {
        const active = link === activeLink;
        link.closest('.toc-item')?.classList.toggle('active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    const updateActiveLink = () => {
      let activeLink = tocTargets[0]?.link;
      for (const entry of tocTargets) {
        if (entry.target.getBoundingClientRect().top > 128) break;
        activeLink = entry.link;
      }
      setActiveLink(activeLink);
    };

    tocHeading?.addEventListener('click', () => {
      if (!tocList) return;
      const expanded = tocHeading.getAttribute('aria-expanded') === 'true';
      tocHeading.setAttribute('aria-expanded', String(!expanded));
      tocList.hidden = expanded;
    }, { signal: tableOfContentsController.signal });

    document.addEventListener('scroll', updateActiveLink, {
      passive: true,
      signal: tableOfContentsController.signal,
    });
    updateActiveLink();
  }

  document.addEventListener('astro:page-load', initializeTableOfContents);
</script>

---
import manifest from '@generated/data/manifest.json';

const searchVersionLabel = manifest.channel === 'latest' ? 'Latest' : manifest.channel;
---

<button id="search-bar-entry" class="search-trigger" type="button" aria-label="Search generated reference documentation">
  <span class="search-icon" aria-hidden="true"></span>
  <span class="search-placeholder">Search reference</span>
  <kbd>⌘K</kbd>
</button>

<dialog
  class="search-dialog"
  aria-labelledby="search-title"
  data-search-index={`/docs/reference/_search/${manifest.channel}.json`}
>
  <div class="search-panel">
    <div class="search-input-row">
      <span class="search-icon" aria-hidden="true"></span>
      <label class="sr-only" id="search-title" for="reference-search">Search reference documentation</label>
      <input id="reference-search" type="search" placeholder="Search functions, metrics, events…" autocomplete="off" />
      <button class="search-close" type="button" aria-label="Close search">Esc</button>
    </div>
    <div class="search-status" aria-live="polite">Start typing to search this version.</div>
    <ol class="search-results"></ol>
    <footer class="search-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span class="search-version">{searchVersionLabel} · English</span>
    </footer>
  </div>
</dialog>

<script>
  import { entityKindLabels } from '../lib/entity-kinds';

  interface SearchRecord {
    id: string;
    title: string;
    description: string;
    aliases: string[];
    route: string;
    entityKind: string;
    headings: string[];
  }

  let searchController: AbortController | undefined;

  function initializeSearch() {
  searchController?.abort();
  searchController = new AbortController();
  const signal = searchController.signal;
  const trigger = document.querySelector<HTMLButtonElement>('.search-trigger');
  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog');
  const input = document.querySelector<HTMLInputElement>('#reference-search');
  const closeButton = document.querySelector<HTMLButtonElement>('.search-close');
  const results = document.querySelector<HTMLOListElement>('.search-results');
  const status = document.querySelector<HTMLElement>('.search-status');
  let records: SearchRecord[] | null = null;
  let activeIndex = -1;

  async function loadIndex() {
    if (records) return records;
    const indexUrl = dialog?.dataset.searchIndex;
    if (!indexUrl) throw new Error('Search index URL is missing');
    const response = await fetch(indexUrl);
    if (!response.ok) throw new Error(`Search index request failed: ${response.status}`);
    const payload = await response.json();
    records = payload.records;
    return records;
  }

  function score(record: SearchRecord, query: string) {
    const title = record.title.toLocaleLowerCase();
    const aliases = record.aliases.map((alias) => alias.toLocaleLowerCase());
    const headings = record.headings.map((heading) => heading.toLocaleLowerCase());
    if (title === query || aliases.includes(query)) return 100;
    if (title.startsWith(query) || aliases.some((alias) => alias.startsWith(query))) return 80;
    if (title.includes(query)) return 60;
    if (headings.some((heading) => heading.includes(query))) return 40;
    if (record.description.toLocaleLowerCase().includes(query)) return 20;
    return 0;
  }

  function setActive(index: number) {
    const links = [...(results?.querySelectorAll<HTMLAnchorElement>('a') ?? [])];
    links.forEach((link) => link.classList.remove('active'));
    if (links.length === 0) {
      activeIndex = -1;
      return;
    }
    activeIndex = (index + links.length) % links.length;
    links[activeIndex].classList.add('active');
    links[activeIndex].scrollIntoView({ block: 'nearest' });
  }

  function render(matches: SearchRecord[], query: string, totalMatches = matches.length) {
    if (!results || !status) return;
    results.replaceChildren();
    activeIndex = -1;

    if (!query) {
      status.textContent = 'Start typing to search this version.';
      return;
    }

    status.textContent = totalMatches === 0
      ? `No generated reference pages match “${query}”.`
      : totalMatches > matches.length
        ? `${totalMatches} results (showing first ${matches.length})`
        : `${totalMatches} result${totalMatches === 1 ? '' : 's'}`;

    for (const record of matches) {
      const item = document.createElement('li');
      const link = document.createElement('a');
      const copy = document.createElement('span');
      const title = document.createElement('strong');
      const kind = document.createElement('em');

      link.href = record.route;
      link.dataset.entityKind = record.entityKind;
      title.textContent = record.title;
      kind.textContent = entityKindLabels[record.entityKind] ?? record.entityKind.replaceAll('-', ' ');
      copy.append(title, kind);
      link.append(copy);
      item.append(link);
      results.append(item);
    }
    setActive(0);
  }

  async function runSearch() {
    const query = input?.value.trim().toLocaleLowerCase() ?? '';
    if (!query) {
      render([], '');
      return;
    }

    try {
      const index = await loadIndex();
      const rankedMatches = index
        .map((record) => ({ record, rank: score(record, query) }))
        .filter(({ rank }) => rank > 0)
        .sort((left, right) => right.rank - left.rank || left.record.title.localeCompare(right.record.title));
      const matches = rankedMatches
        .slice(0, 200)
        .map(({ record }) => record);
      render(matches, input?.value.trim() ?? '', rankedMatches.length);
    } catch {
      if (status) status.textContent = 'The search index could not be loaded.';
    }
  }

  function openSearch() {
    dialog?.showModal();
    window.setTimeout(() => input?.focus(), 0);
    void loadIndex();
  }

  trigger?.addEventListener('click', openSearch, { signal });
  trigger?.addEventListener('blur', () => trigger.classList.remove('search-trigger-restored-focus'), { signal });
  closeButton?.addEventListener('click', () => dialog?.close(), { signal });
  input?.addEventListener('input', runSearch, { signal });
  input?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      setActive(activeIndex + 1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      setActive(activeIndex - 1);
    } else if (event.key === 'Enter' && activeIndex >= 0) {
      const active = results?.querySelectorAll<HTMLAnchorElement>('a')[activeIndex];
      active?.click();
    } else if (event.key === 'Escape') {
      event.preventDefault();
      trigger?.classList.add('search-trigger-restored-focus');
      dialog?.close();
    }
  }, { signal });
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  }, { signal });
  dialog?.addEventListener('cancel', () => trigger?.classList.add('search-trigger-restored-focus'), { signal });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLocaleLowerCase() === 'k') {
      event.preventDefault();
      openSearch();
    }
  }, { signal });
  }

  document.addEventListener('astro:page-load', initializeSearch);
</script>

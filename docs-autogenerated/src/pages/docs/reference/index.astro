---
import manifest from '@generated/data/manifest.json';
import docsConfig from '@generated/mintlify/docs.json';
import { getCollection } from 'astro:content';
import { isNavGroup, isNavPage, resolvePageData, type NavEntry } from '@mintlify/astro/helpers';
import type { DocsConfig } from '@mintlify/astro';

import DocsLayout from '../../../layouts/DocsLayout.astro';

function countDocuments(entries: NavEntry[]): number {
  return entries.reduce(
    (total, entry) => total + (isNavPage(entry) ? 1 : countDocuments(entry.pages)),
    0,
  );
}

function firstPage(entries: NavEntry[]): string {
  for (const entry of entries) {
    if (isNavPage(entry)) return entry.href;
    const nested = firstPage(entry.pages);
    if (nested) return nested;
  }
  return '/docs/reference';
}

const entries = await getCollection('reference');
const sidebarTitleMap = Object.fromEntries(
  entries.map((entry) => [entry.id, entry.data.sidebarTitle]),
);
const featureStateByRoute = Object.fromEntries(
  entries
    .filter((entry) => entry.data.featureState)
    .map((entry) => [entry.data.route, entry.data.featureState]),
) as Record<string, 'beta' | 'experimental'>;
const page = resolvePageData(docsConfig as DocsConfig, {
  currentPath: '/docs/reference',
  titleMap: sidebarTitleMap,
});
const families = page.sidebarEntries.filter(isNavGroup);
const document = {
  title: 'ClickHouse reference',
  description: `${manifest.documentCount.toLocaleString('en')} source-generated pages from the current ClickHouse reference corpus.`,
  route: '/docs/reference',
  stableId: 'reference:index',
  entityKind: 'reference',
  sourcePath: '',
};
---

<DocsLayout
  document={document}
  sidebarEntries={page.sidebarEntries}
  featureStateByRoute={featureStateByRoute}
  showGeneratedBanner={false}
>
  <section class="reference-intro">
    <div class="reference-stats">
      <div><strong>{manifest.documentCount.toLocaleString('en')}</strong><span>generated pages</span></div>
      <div><strong>{families.length}</strong><span>reference families</span></div>
      <div><strong>{(manifest.contentBytes / 1024 / 1024).toFixed(1)} MB</strong><span>source content</span></div>
    </div>
    <p>
      This prototype renders only the documentation currently enclosed by autogenerated markers.
      It is a build of the <strong>Latest</strong> channel from exact source revision
      <code>{manifest.sourceRevision.slice(0, 12)}</code>.
    </p>
  </section>

  <section class="family-grid" aria-label="Reference families">
    {families.map((family) => (
      <a href={firstPage(family.pages)}>
        <span class="family-icon" aria-hidden="true">{family.group.slice(0, 1)}</span>
        <span>
          <strong>{family.group}</strong>
          <small>{countDocuments(family.pages).toLocaleString('en')} generated pages</small>
        </span>
        <span aria-hidden="true">→</span>
      </a>
    ))}
  </section>

  <section class="prototype-note">
    <h2 id="prototype-scope">Prototype scope</h2>
    <p>
      Handwritten reference pages and prose outside generated regions are intentionally absent.
      The export artifact remains independent of Astro so future renderers, search, translation,
      and MCP ingestion can consume the same version-pinned records.
    </p>
  </section>
</DocsLayout>

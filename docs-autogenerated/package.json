{
  "name": "clickhouse-autogenerated-reference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "export": "node scripts/export-reference-docs.mjs",
    "prepare:content": "node scripts/prepare-content.mjs",
    "prepare:site": "npm run export && npm run prepare:content",
    "test": "node scripts/smoke-test-reference-pipeline.mjs",
    "predev": "npm run prepare:site",
    "dev": "astro dev",
    "prebuild": "npm run prepare:site",
    "build": "node --max-old-space-size=8192 node_modules/astro/bin/astro.mjs build",
    "preview": "node scripts/serve-dist.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@mintlify/astro": "^1.0.0",
    "@mintlify/components": "^1.0.5",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^7.2.0",
    "katex": "^0.16.47",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.18"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

#!/bin/bash

set -e

SRC_DIR=../..
BUILD_DIR=${SRC_DIR}/build

# The binary is statically linked with `musl`, so no shared libraries are needed.

mkdir root
pushd root
mkdir etc tmp root
cp ${BUILD_DIR}/programs/clickhouse .
cp /etc/resolv.conf ./etc
strip clickhouse


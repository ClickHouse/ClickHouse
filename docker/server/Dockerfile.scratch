# The default ClickHouse server image, built `FROM scratch`.
# It contains the statically linked `clickhouse` binary, its configuration files, and the few system files
# the binary needs (CA certificates, `/etc/passwd`): no shell, no package manager, no C library,
# no coreutils. The entrypoint is the compiled `clickhouse docker-init` subcommand.
#
# When a shell is needed for troubleshooting, mount one into the container, for example a statically
# linked busybox:
#   docker run --rm -it -v /bin/busybox:/bin/sh:ro --entrypoint /bin/sh clickhouse/clickhouse-server
# The image with a full Ubuntu userland is published with the `-ubuntu` tag suffix (`Dockerfile.ubuntu`).
#
# Usage:
#   docker build -f Dockerfile.scratch -t clickhouse/clickhouse-server \
#       --build-arg single_binary_location_url=<URL of a statically linked clickhouse binary> .
# or, from the package repository, with a release whose binary is statically linked (`musl`):
#   docker build -f Dockerfile.scratch -t clickhouse/clickhouse-server --build-arg VERSION=<version> .
# The image has no C library, so the binary must be static. Until a release built with the `musl` toolchain is
# published, the default `VERSION` (the latest release, set by `utils/list-versions/update-docker-version.sh`) is
# linked against glibc, and the build stops with an error saying so: pass `single_binary_location_url` (e.g. of a
# master build) instead.

# ──────────────────────────────────────────────────────────────────────────────
# Stage 1: Install ClickHouse and assemble the output directory tree.
# ──────────────────────────────────────────────────────────────────────────────
FROM ubuntu:22.04 AS ch-builder

# see https://github.com/moby/moby/issues/4032#issuecomment-192327844
ARG DEBIAN_FRONTEND=noninteractive

# amd64 base images use archive.ubuntu.com, arm64 uses ports.ubuntu.com.
ARG apt_archive="http://archive.ubuntu.com"
ARG apt_ports_archive="http://ports.ubuntu.com"

# user/group precreated explicitly with fixed uid/gid on purpose.
# It is especially important for rootless containers: in that case entrypoint
# can't do chown and owners of mounted volumes should be configured externally.
# We do that in advance at the beginning of Dockerfile before any packages will be
# installed to prevent picking those uid/gid by some unrelated software.
# The same uid/gid (101) is used both for alpine and ubuntu.
# apt does not retry a mirror in mid-sync, so apt_update falls back to Canonical once.
RUN apt_update() { apt-get update --error-on=any || { sed -i -e "s|${apt_archive}|http://archive.ubuntu.com|g" -e "s|${apt_ports_archive}|http://ports.ubuntu.com|g" /etc/apt/sources.list && apt-get update --error-on=any; }; } \
    && sed -i -e "s|http://archive.ubuntu.com|${apt_archive}|g" -e "s|http://ports.ubuntu.com|${apt_ports_archive}|g" /etc/apt/sources.list \
    && groupadd -r clickhouse --gid=101 \
    && useradd -r -g clickhouse --uid=101 --home-dir=/var/lib/clickhouse --shell=/bin/bash clickhouse \
    # `apt-get update` reports a failed repository index fetch as a warning and exits 0,
    # proceeding with a stale or absent index; `--error-on=any` fails there, not in the install.
    && apt_update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        wget \
    && rm -rf /var/lib/apt/lists/* /var/cache/debconf /tmp/*

ARG REPO_CHANNEL="stable"
ARG REPOSITORY="deb [signed-by=/usr/share/keyrings/clickhouse-keyring.gpg] https://packages.clickhouse.com/deb ${REPO_CHANNEL} main"
# The latest release, updated on every release; see "Usage" above for a release whose binary is not static.
ARG VERSION="26.10.12.13"
ARG PACKAGES="clickhouse-client clickhouse-server clickhouse-common-static"

#docker-official-library:off
ARG deb_location_url=""
ARG DIRECT_DOWNLOAD_URLS=""
ARG single_binary_location_url=""
ARG TARGETARCH

# Number of `wget` retries and delay between them, for resilience against
# transient HTTP errors (e.g. `clickhouse-builds.s3.amazonaws.com` returning
# `500 Internal Server Error` / `503 Service Unavailable` during builds).
ARG WGET_RETRIES=5
ARG WGET_RETRY_DELAY=1

# Install from direct URLs (deb packages provided by CI).
RUN wget_with_retry() { \
        local attempt=1; \
        while [ "$attempt" -le "${WGET_RETRIES}" ]; do \
            if wget --progress=bar:force:noscroll "$@"; then return 0; fi; \
            echo "Attempt $attempt/${WGET_RETRIES} failed, retrying in ${WGET_RETRY_DELAY}s..."; \
            sleep "${WGET_RETRY_DELAY}"; \
            attempt=$((attempt + 1)); \
        done; \
        echo "ERROR: Failed to download after ${WGET_RETRIES} attempts"; return 1; \
    } \
    && if [ -n "${DIRECT_DOWNLOAD_URLS}" ]; then \
        rm -rf /tmp/clickhouse_debs \
        && mkdir -p /tmp/clickhouse_debs \
        && for url in $DIRECT_DOWNLOAD_URLS; do \
            wget_with_retry "$url" -P /tmp/clickhouse_debs || exit 1 \
        ; done \
        && dpkg -i /tmp/clickhouse_debs/*.deb \
        && rm -rf /tmp/* ; \
    fi

# Install from a web location with deb packages.
RUN arch="${TARGETARCH:-amd64}" \
    && if [ -n "${deb_location_url}" ]; then \
        rm -rf /tmp/clickhouse_debs \
        && mkdir -p /tmp/clickhouse_debs \
        && for package in ${PACKAGES}; do \
            { wget --progress=bar:force:noscroll "${deb_location_url}/${package}_${VERSION}_${arch}.deb" -P /tmp/clickhouse_debs || \
              wget --progress=bar:force:noscroll "${deb_location_url}/${package}_${VERSION}_all.deb" -P /tmp/clickhouse_debs ; } \
            || exit 1 \
        ; done \
        && dpkg -i /tmp/clickhouse_debs/*.deb \
        && rm -rf /tmp/* ; \
    fi

# Install from a single binary.
RUN if [ -n "${single_binary_location_url}" ]; then \
        rm -rf /tmp/clickhouse_binary \
        && mkdir -p /tmp/clickhouse_binary \
        && wget --progress=bar:force:noscroll "${single_binary_location_url}" -O /tmp/clickhouse_binary/clickhouse \
        && chmod +x /tmp/clickhouse_binary/clickhouse \
        && /tmp/clickhouse_binary/clickhouse install --user "clickhouse" --group "clickhouse" \
        && rm -rf /tmp/* ; \
    fi

# Fall back to installation from the ClickHouse repository.
# `--tmp` keeps `clickhouse local` from creating its default data directory in the home inside the image.
# The check goes first, so that the whole `RUN` is a no-op when the packages are already installed.
RUN clickhouse local --tmp -q 'SELECT 1' >/dev/null 2>&1 && exit 0 || : \
    ; apt_update() { apt-get update --error-on=any || { sed -i -e "s|${apt_archive}|http://archive.ubuntu.com|g" -e "s|${apt_ports_archive}|http://ports.ubuntu.com|g" /etc/apt/sources.list && apt-get update --error-on=any; }; } \
    ; apt_update \
    && apt-get install --yes --no-install-recommends dirmngr gnupg2 \
    && mkdir -p /etc/apt/sources.list.d \
    && GNUPGHOME=$(mktemp -d) \
    && ( set +e; \
        for KEYSERVER in \
            hkp://keys.openpgp.org:80 \
            hkp://pgp.mit.edu:80 \
            hkp://keyserver.ubuntu.com:80; do \
            GNUPGHOME="$GNUPGHOME" gpg --batch --no-default-keyring \
                --keyring /usr/share/keyrings/clickhouse-keyring.gpg \
                --keyserver "$KEYSERVER" \
                --recv-keys 3a9ea1193a97b548be1457d48919f6bd2b48d754 && break; \
        done || exit 1 \
    ) \
    && rm -rf "$GNUPGHOME" \
    && chmod +r /usr/share/keyrings/clickhouse-keyring.gpg \
    && echo "${REPOSITORY}" > /etc/apt/sources.list.d/clickhouse.list \
    && echo "installing from repository: ${REPOSITORY}" \
    && apt_update \
    && for package in ${PACKAGES}; do \
        packages="${packages} ${package}=${VERSION}" \
    ; done \
    && apt-get install --yes --no-install-recommends ${packages} \
    && rm -rf /var/lib/apt/lists/* /var/cache/debconf /tmp/* \
    && apt-get autoremove --purge -yq dirmngr gnupg2

#docker-official-library:on

# Verify the installation.
RUN clickhouse-local --tmp -q 'SELECT * FROM system.build_options'

# Assemble the output directory tree that is copied into the final image.
RUN mkdir -p \
        /output/usr/bin \
        /output/etc/ssl/certs \
        /output/etc/clickhouse-server/config.d \
        /output/etc/clickhouse-server/users.d \
        /output/etc/clickhouse-client \
        /output/var/lib/clickhouse \
        /output/var/log/clickhouse-server \
        /output/docker-entrypoint-initdb.d \
        /output/tmp \
        /output/root \
    # The home of `root` in `/etc/passwd`, where the tools started as root keep their history files.
    && chmod 700 /output/root \
    && cp /usr/bin/clickhouse /output/usr/bin/clickhouse \
    # All the tools of the multi-tool binary, as installed by the packages (`clickhouse-client`,
    # `clickhouse-local`, `clickhouse-format`, ...), and the ones the entrypoint relies on.
    && for link in /usr/bin/clickhouse-* \
                   clickhouse-server clickhouse-client clickhouse-local \
                   clickhouse-keeper clickhouse-keeper-client \
                   clickhouse-docker-init; do \
        if [ -L "${link}" ] || [ "${link#/}" = "${link}" ]; then \
            ln -sf clickhouse "/output/usr/bin/$(basename "${link}")" ; \
        fi ; \
    done \
    # The image has no C library and no dynamic loader, so the binary must be statically linked
    # (the `musl` build): a dynamically linked one would fail to start with `no such file`.
    && if ldd /usr/bin/clickhouse 2>&1 | grep -q '=>'; then \
        echo "ERROR: /usr/bin/clickhouse is dynamically linked, but the FROM scratch image needs a static binary." ; \
        echo "The releases built with the glibc toolchain cannot be used: pass a VERSION whose binary is statically linked (musl)," ; \
        echo "or single_binary_location_url of a static binary (e.g. of a master build). See the usage at the top of Dockerfile.scratch." ; \
        ldd /usr/bin/clickhouse ; \
        exit 1 ; \
    fi \
    && cp /etc/ssl/certs/ca-certificates.crt /output/etc/ssl/certs/ \
    && cp -r /etc/clickhouse-server/. /output/etc/clickhouse-server/ \
    && if [ -d /etc/clickhouse-client ]; then cp -r /etc/clickhouse-client/. /output/etc/clickhouse-client/; fi \
    # The standard Protobuf schemas (`google/protobuf/wrappers.proto`, ...), which `google_protos_path` in
    # the server configuration points to.
    && if [ -d /usr/share/clickhouse/protos ]; then \
        mkdir -p /output/usr/share/clickhouse \
        && cp -r /usr/share/clickhouse/protos /output/usr/share/clickhouse/ ; \
    fi

COPY docker_related_config.xml /output/etc/clickhouse-server/config.d/

# The directories are owned by the `clickhouse` user, and also writable by others, because the container
# can be started with an arbitrary uid (the OpenShift use case).
RUN chown -R clickhouse:clickhouse \
        /output/etc/clickhouse-server \
        /output/etc/clickhouse-client \
        /output/var/lib/clickhouse \
        /output/var/log/clickhouse-server \
        /output/docker-entrypoint-initdb.d \
    && chmod -R ugo+Xrw \
        /output/etc/clickhouse-server \
        /output/etc/clickhouse-client \
        /output/var/lib/clickhouse \
        /output/var/log/clickhouse-server \
    && chmod 1777 /output/tmp

# `/etc/passwd` and `/etc/group` name the `clickhouse` user (uid/gid 101), which `docker-init` switches to
# when started as root. Host names are resolved from `/etc/hosts` (which docker generates, e.g. for `--link`)
# and DNS by the `musl` C library itself, without the Name Service Switch, so there is no `/etc/nsswitch.conf`.
RUN { \
        printf 'root:x:0:0:root:/root:/sbin/nologin\n'; \
        printf 'nobody:x:65534:65534:nobody:/nonexistent:/sbin/nologin\n'; \
        printf 'clickhouse:x:101:101:ClickHouse:/var/lib/clickhouse:/sbin/nologin\n'; \
    } > /output/etc/passwd \
    && { \
        printf 'root:x:0:\n'; \
        printf 'nobody:x:65534:\n'; \
        printf 'clickhouse:x:101:\n'; \
    } > /output/etc/group

# ──────────────────────────────────────────────────────────────────────────────
# Stage 2: The image itself.
# ──────────────────────────────────────────────────────────────────────────────
FROM scratch

COPY --from=ch-builder /output/ /

# Time zones are embedded into the binary.
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    CLICKHOUSE_CONFIG=/etc/clickhouse-server/config.xml \
    TZ=UTC \
    CLICKHOUSE_WATCHDOG_ENABLE=0

EXPOSE 9000 8123 9009

VOLUME ["/var/lib/clickhouse"]

WORKDIR /var/lib/clickhouse

# The entrypoint starts as root to prepare the directories (including mounted volumes), and then runs
# the server as the `clickhouse` user, the same as `entrypoint.sh` in the Ubuntu image.
ENTRYPOINT ["/usr/bin/clickhouse", "docker-init"]

<clickhouse>
    <storage_configuration>
        <disks>
            <disk1_05212>
                <type>local</type>
                <path>disk1_05212/</path>
            </disk1_05212>
            <disk2_05212>
                <type>local</type>
                <path>disk2_05212/</path>
            </disk2_05212>
        </disks>
        <policies>
            <!-- Two multi-volume policies over the same volumes and disks, so that a table can be
                 switched from one to the other and back: a storage policy change must keep every
                 volume and disk of the previous policy, so no other pair of named policies can be
                 rolled back after a failed ALTER. -->
            <policy_05212_a>
                <volumes>
                    <vol1_05212>
                        <disk>disk1_05212</disk>
                    </vol1_05212>
                    <vol2_05212>
                        <disk>disk2_05212</disk>
                    </vol2_05212>
                </volumes>
                <move_factor>0.1</move_factor>
            </policy_05212_a>
            <policy_05212_b>
                <volumes>
                    <vol1_05212>
                        <disk>disk1_05212</disk>
                    </vol1_05212>
                    <vol2_05212>
                        <disk>disk2_05212</disk>
                    </vol2_05212>
                </volumes>
                <move_factor>0.2</move_factor>
            </policy_05212_b>
        </policies>
    </storage_configuration>
</clickhouse>

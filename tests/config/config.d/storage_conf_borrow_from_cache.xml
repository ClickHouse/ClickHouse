<clickhouse>
    <storage_configuration>
        <disks>
            <!-- A named `borrow_from_cache` disk for the tests of the direct-disk engines (`Log`, `TinyLog`,
                 `StripeLog`, `Set`, `Join`), which accept only a named disk. It is defined here and not by an
                 inline `disk(...)` of another table, because after a server restart the tables are loaded in
                 parallel, and a table referencing a disk registered by another table may be loaded first.
                 The cache wraps its own local disk defined in this file: the disks of `storage_conf_local.xml`
                 come later in the merged configuration, and a cache must be defined after the disk it wraps. -->
            <borrow_from_cache_local>
                <type>object_storage</type>
                <object_storage_type>local</object_storage_type>
                <path>borrow_from_cache_local/</path>
            </borrow_from_cache_local>
            <borrow_from_cache_cache>
                <type>cache</type>
                <disk>borrow_from_cache_local</disk>
                <path>borrow_from_cache_cache/</path>
                <max_size>100Mi</max_size>
                <load_metadata_asynchronously>0</load_metadata_asynchronously>
            </borrow_from_cache_cache>
            <borrow_from_cache_disk>
                <type>object_storage</type>
                <object_storage_type>borrow_from_cache</object_storage_type>
                <metadata_type>memory</metadata_type>
                <cache_name>borrow_from_cache_cache</cache_name>
            </borrow_from_cache_disk>
        </disks>
    </storage_configuration>
</clickhouse>

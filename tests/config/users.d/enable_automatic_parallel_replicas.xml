<clickhouse>
    <profiles>
        <default>
            <!-- `automatic_parallel_replicas_mode` = 1 is the only mode that runs the cost model and
                 rewrites the plan. The settings randomizer only ever picks 0 or 2, and mode 2 collects
                 statistics without ever switching, so without this profile the plan-rewriting half of
                 the optimization has no coverage outside its own handful of tests. -->
            <automatic_parallel_replicas_mode>1</automatic_parallel_replicas_mode>
            <!-- Stateless test tables read far less than the 1 MiB per replica the setting defaults to,
                 so keeping the default would make the cheap pre-check reject every plan before the
                 probe is built and the job would pass without ever exercising the switch. -->
            <automatic_parallel_replicas_min_bytes_per_replica>0</automatic_parallel_replicas_min_bytes_per_replica>
            <enable_parallel_replicas>1</enable_parallel_replicas>
            <cluster_for_parallel_replicas>parallel_replicas</cluster_for_parallel_replicas>
            <!-- Every replica of the `parallel_replicas` cluster is a loopback address of this same
                 server. Left unpinned the setting defaults to 1000 and is clamped to the cluster's
                 node count, so the cost model would divide the read by 11 and judge parallel replicas
                 about 11x better than they are on a real cluster. Pin a realistic replica count. -->
            <max_parallel_replicas>3</max_parallel_replicas>
            <!-- The cost model divides the read by `min(max_threads [* replicas], input_bytes /
                 merge_tree_min_bytes_per_task_for_remote_reading + 1)`. When that second term is the
                 smaller one it clamps BOTH sides to the same value, the comparison collapses to
                 `0 > output_bytes / replicas`, and the answer is "no" before the cost model looks at
                 anything. Measured across runs of these jobs, by the value of this setting:

                     2 MiB (default)     86 of 7366 evaluations escaped the clamp,  76 switched
                     16 KiB             248 of 7746 evaluations escaped the clamp, 236 switched
                     1 KiB              600 of 7568 evaluations escaped the clamp, 561 switched

                 0 is not "a very small threshold" but a distinct code path: `considerEnablingParallelReplicas`
                 reads the setting as `value ? input_bytes / value + 1 : SIZE_MAX`, so zero makes the
                 clamp structurally unreachable and every evaluation is decided by the cost model. Any
                 non-zero value leaves a residue - at 1 the clamp still binds for reads of a couple of
                 bytes.

                 Zero is also the quieter choice for real reading. `MergeTreeReadPoolBase` only raises
                 `min_marks_per_task` when `min_bytes_per_task / avg_mark_bytes` exceeds it, so zero
                 skips that heuristic and leaves task sizing on its default path instead of shrinking
                 tasks - which is what a small non-zero value does, and what broke
                 03581_parallel_replicas_task_size at 16 KiB. That test keeps its pin regardless: it
                 asserts on coordinator request counts, and `no-random-settings` gives it no protection
                 against a server profile. -->
            <merge_tree_min_bytes_per_task_for_remote_reading>0</merge_tree_min_bytes_per_task_for_remote_reading>
            <parallel_replicas_local_plan>1</parallel_replicas_local_plan>
            <parallel_replicas_for_non_replicated_merge_tree>1</parallel_replicas_for_non_replicated_merge_tree>
        </default>
    </profiles>
</clickhouse>

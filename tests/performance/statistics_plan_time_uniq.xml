<test>
    <!--
        Plan-time cost of uniq_v2 statistics, which no other performance test covers.

        The WHERE optimizer estimates every condition group separately, and each
        estimate finalizes the sketch of every statistics-carrying column of the
        relation. Cost therefore grows with conditions times columns, not with
        rows, so the fixture is wide (400 statistics columns) and short (6000
        rows in two parts) and the queries are EXPLAIN PLAN, which isolates plan
        time from execution the same way analyzer_nested_function_resolution.xml
        uses EXPLAIN QUERY TREE.
    -->

    <settings>
        <allow_statistics>1</allow_statistics>
        <use_statistics>1</use_statistics>
        <materialize_statistics_on_insert>1</materialize_statistics_on_insert>
    </settings>


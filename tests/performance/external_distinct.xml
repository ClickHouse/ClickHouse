<test>
    <!-- These key shapes use serialized storage in `ExternalDistinctTransform` and hash-only storage
         when spilling is disabled. A high absolute threshold with the ratio disabled selects the
         external transform without spilling on these inputs, measuring the cost of extractable keys. -->
    <substitutions>
        <substitution>
            <name>external</name>
            <values>
                <value>max_bytes_ratio_before_external_distinct = 0, max_bytes_before_external_distinct = '1T'</value>
                <value>max_bytes_ratio_before_external_distinct = 0, max_bytes_before_external_distinct = 0</value>
            </values>
        </substitution>
    </substitutions>

    <query>SELECT count() FROM (SELECT DISTINCT toString(number % 1000000) AS a, toString(number % 1000) AS b FROM numbers_mt(10000000)) SETTINGS {external}</query>
    <query>SELECT count() FROM (SELECT DISTINCT toLowCardinality(toString(number % 100000)) AS a FROM numbers_mt(30000000)) SETTINGS {external}</query>
</test>

<test>
    <substitutions>
        <substitution>
            <name>m</name>
            <values>
                <value>20</value>
                <value>40</value>
                <value>80</value>
            </values>
        </substitution>
    </substitutions>

    <drop_query>DROP TABLE IF EXISTS bench_intersect_crossbars_{m}</drop_query>
    <create_query>CREATE TABLE bench_intersect_crossbars_{m} (p MultiPolygon) ENGINE = Memory</create_query>
    <fill_query>
        INSERT INTO bench_intersect_crossbars_{m}
        SELECT arrayMap(i -> [if(number = 0,
            [(0., 3. * i), (0., 3. * i + 1), (3. * {m}, 3. * i + 1), (3. * {m}, 3. * i), (0., 3. * i)],
            [(3. * i, 0.), (3. * i, 3. * {m}), (3. * i + 1, 3. * {m}), (3. * i + 1, 0.), (3. * i, 0.)]
        )], range({m})) FROM numbers(2)
    </fill_query>

    <query>SELECT groupPolygonIntersection(p) FROM bench_intersect_crossbars_{m} FORMAT Null SETTINGS max_threads = 1</query>

    <drop_query>DROP TABLE IF EXISTS bench_intersect_crossbars_{m}</drop_query>
</test>

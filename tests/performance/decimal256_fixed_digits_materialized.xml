<test>
    <!-- Materialize deterministic coefficients so timed queries measure `toString`
         rather than constructing wide integers. `cityHash64` observes every output byte. -->
    <create_query>
        CREATE TABLE decimal256_fixed_digits_materialized
        (
            id UInt32,
            below_boundary Decimal256(40),
            above_boundary Decimal256(40),
            wide_fraction Decimal256(76),
            signed_fraction Decimal256(76),
            below_boundary_array Array(Decimal256(40)),
            wide_fraction_array Array(Decimal256(76))
        ) ENGINE = Memory
    </create_query>
    <fill_query>
        INSERT INTO decimal256_fixed_digits_materialized
        SELECT
            toUInt32(number),
            reinterpret(toInt256('340282366920938463463374607431768211456') - 262144 + number, 'Decimal256(40)'),
            reinterpret(toInt256('340282366920938463463374607431768211456') + number, 'Decimal256(40)'),
            reinterpret(toInt256('1234567890123456789012345678901234567890123456789012345678901234567890123456') + number, 'Decimal256(76)'),
            reinterpret((toInt256('1234567890123456789012345678901234567890123456789012345678901234567890123456') + number) * (1 + number % 8) * toInt256(if(number % 2, -1, 1)), 'Decimal256(76)'),
            arrayMap(offset -> reinterpret(toInt256('340282366920938463463374607431768211456') - 2097152 + number * 8 + offset, 'Decimal256(40)'), range(8)),
            arrayMap(offset -> reinterpret(toInt256('1234567890123456789012345678901234567890123456789012345678901234567890123456') + number * 8 + offset, 'Decimal256(76)'), range(8))
        FROM numbers(262144)
        SETTINGS max_threads = 1
    </fill_query>

    <!-- Scalar and array controls stay below the `UInt128` boundary. The remaining
         queries reach the normal default-enabled wide formatter, including signed fractions. -->
    <query>SELECT sum(cityHash64(toString(below_boundary))) FROM decimal256_fixed_digits_materialized SETTINGS max_threads = 1</query>
    <query>SELECT sum(cityHash64(toString(above_boundary))) FROM decimal256_fixed_digits_materialized SETTINGS max_threads = 1</query>
    <query>SELECT sum(cityHash64(toString(wide_fraction))) FROM decimal256_fixed_digits_materialized SETTINGS max_threads = 1</query>
    <query>SELECT sum(cityHash64(toString(signed_fraction))) FROM decimal256_fixed_digits_materialized SETTINGS max_threads = 1</query>
    <query>SELECT sum(cityHash64(toString(below_boundary_array))) FROM decimal256_fixed_digits_materialized SETTINGS max_threads = 1</query>
    <query>SELECT sum(cityHash64(toString(wide_fraction_array))) FROM decimal256_fixed_digits_materialized SETTINGS max_threads = 1</query>
    <drop_query>DROP TABLE IF EXISTS decimal256_fixed_digits_materialized</drop_query>
</test>

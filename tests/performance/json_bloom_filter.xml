<test>
    <settings>
        <max_insert_threads>1</max_insert_threads>
        <use_query_condition_cache>0</use_query_condition_cache>
        <use_skip_indexes>1</use_skip_indexes>
        <use_skip_indexes_on_data_read>1</use_skip_indexes_on_data_read>
    </settings>

    <substitutions>
        <substitution>
            <name>table</name>
            <values>
                <value>json_bf_perf_plain</value>
                <value>json_bf_perf_indexed</value>
            </values>
        </substitution>
        <substitution>
            <name>json_row</name>
            <values>
                <value>concat('{"user":{"id":', toString(number), ',"name":"user-', toString(number), '"},"tags":["tag-', toString(number), '","common"],"event":{"kind":"kind-', toString(number % 32), '"}}')</value>
            </values>
        </substitution>
    </substitutions>

    <create_query>DROP TABLE IF EXISTS json_bf_perf_plain</create_query>
    <create_query>DROP TABLE IF EXISTS json_bf_perf_indexed</create_query>

    <create_query>
        CREATE TABLE json_bf_perf_plain
        (
            id UInt64,
            data JSON(
                user.id UInt64,
                user.name String,
                tags Array(Nullable(String)))
        )
        ENGINE = MergeTree
        ORDER BY id
        SETTINGS index_granularity = 256
    </create_query>
    <create_query>
        CREATE TABLE json_bf_perf_indexed
        (
            id UInt64,
            data JSON(
                user.id UInt64,
                user.name String,
                tags Array(Nullable(String))),
            INDEX data_idx data TYPE jsonbf_v1(false_positive_rate = 0.01, tokenizer = ngrams(3)) GRANULARITY 1
        )
        ENGINE = MergeTree
        ORDER BY id
        SETTINGS index_granularity = 256
    </create_query>
    <fill_query>INSERT INTO json_bf_perf_plain SELECT number, {json_row} FROM numbers(3000000)</fill_query>
    <fill_query>INSERT INTO json_bf_perf_indexed SELECT number, {json_row} FROM numbers(3000000)</fill_query>

    <query>SELECT count() FROM {table} WHERE data.user.id = 2500000</query>
    <query>SELECT count() FROM {table} WHERE data.user.id = 4000000</query>
    <query>SELECT count() FROM {table} WHERE data.user.name = 'user-2500000'</query>
    <query>SELECT count() FROM {table} WHERE has(data.tags, 'tag-2500000')</query>
    <query>SELECT count() FROM {table} WHERE data.user.name LIKE '%2500000%'</query>

    <drop_query>DROP TABLE IF EXISTS json_bf_perf_plain</drop_query>
    <drop_query>DROP TABLE IF EXISTS json_bf_perf_indexed</drop_query>
</test>

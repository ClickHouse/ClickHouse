<test>
    <settings>
        <allow_experimental_time_series_aggregate_functions>1</allow_experimental_time_series_aggregate_functions>
        <max_threads>1</max_threads>
    </settings>

    <!--
        Benchmarks the `timeSeries*ToGrid` aggregate functions when many series share one aggregation state and
        repeat the same timestamps, so a bucket receives many samples with duplicate timestamps in no sorted order.
        The unsorted samples are sorted and deduplicated before the buffer of the bucket is reallocated, so the buffer
        stays as small as the number of distinct timestamps instead of the number of samples.
    -->

    <!-- 500 series of 20000 samples, one sample every 15s, all series with the same timestamps, in one state: 10M rows. -->
    <query>SELECT timeSeriesRateToGrid(0, 300000, 300000, 300000)(toDateTime64((number % 20000) * 15, 3), toFloat64(number % 1000)) FROM numbers(10000000) FORMAT Null</query>

    <!-- 4095 distinct timestamps repeated by every series: the buffer is nearly full after the deduplication. -->
    <query>SELECT timeSeriesRateToGrid(0, 4095, 1, 2)(toDateTime64(1 + number % 4095, 3, 'UTC'), toFloat64(number % 4095)) FROM numbers(2000000) FORMAT Null</query>
</test>

<test>
    <!-- Synthetic-IO twin of iceberg_suite_local_read.xml: enable a fixed delay on each local object-storage read, metadata lookup and listing. -->
    <settings>
        <iceberg_metadata_log_level>none</iceberg_metadata_log_level>
    </settings>
    <substitutions>
        <substitution>
            <name>database</name>
            <values><value>tpch_ice10</value></values>
        </substitution>
        <substitution>
            <name>table_function</name>
            <values><value>icebergLocal((SELECT value FROM system.server_settings WHERE name = 'user_files_path') || '/tpch_ice_sf10/lineitem/')</value></values>
        </substitution>
    </substitutions>
    <fill_query do_not_check_in_pr="119976">SYSTEM ENABLE FAILPOINT local_object_storage_slow_response</fill_query>
    <include file="iceberg_suite_shared_read.xml.inc"/>
    <drop_query>SYSTEM DISABLE FAILPOINT local_object_storage_slow_response</drop_query>
</test>

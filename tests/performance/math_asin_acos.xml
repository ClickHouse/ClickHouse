<test>
    <substitutions>
        <substitution>
            <name>func</name>
            <values>
                <value>asin</value>
                <value>acos</value>
            </values>
        </substitution>
        <substitution>
            <name>arg_bounded</name>
            <values>
                <value>toFloat64(number % 1000) / 1000.0</value>
                <value>toFloat32(number % 1000) / 1000.0</value>
                <value>(number % 1000) / 1000.0</value>
            </values>
        </substitution>
    </substitutions>

    <query>SELECT count() FROM numbers(100000000) WHERE NOT ignore({func}({arg_bounded}))</query>
</test>

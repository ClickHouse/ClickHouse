<test run_all_queries="1" profile_all_queries="1">
    <!-- Prototype smoke test: Iceberg writes and reads over the job-local S3 endpoint (ci/jobs/scripts/perf/s3_service.py), via the perf_s3 named collection. -->
    <!-- The infrastructure keys off content, not the name: referencing perf_s3 triggers provisioning in the perf job and the skip in PGO/BOLT profile collection. -->
    <!-- The fixed literal path cannot collide across the comparison (each server's perf_s3 points at its own namespace); drop + iceberg_delete_data_on_drop cleans reruns. -->
    <!-- run_all_queries: a smoke test must run every query regardless of the sampling policy. -->
    <!-- profile_all_queries: always produce flamegraphs; otherwise only queries with a significant diff are profiled. -->
    <!-- TODO: replace with iceberg_suite_s3_{read,write,rw_features,tpch} twins of the local suites, renamed to iceberg_suite_local_* (renames reset CIDB history keyed on test names). -->

    <settings>
        <allow_insert_into_iceberg>1</allow_insert_into_iceberg>
        <iceberg_metadata_log_level>none</iceberg_metadata_log_level>
        <iceberg_delete_data_on_drop>1</iceberg_delete_data_on_drop>
        <!-- 1M rows / 250K per file: the queries below read a multi-file table over S3. -->
        <iceberg_insert_max_rows_in_data_file>250000</iceberg_insert_max_rows_in_data_file>
    </settings>

    <create_query>CREATE DATABASE IF NOT EXISTS iceberg_suite_s3_dummy</create_query>

    <create_query>DROP TABLE IF EXISTS iceberg_suite_s3_dummy.events</create_query>
    <create_query>
        CREATE TABLE iceberg_suite_s3_dummy.events
        (
            id UInt64,
            ts DateTime,
            value Float64,
            tag String
        )
        ENGINE = IcebergS3(perf_s3, filename = 'iceberg_suite_s3_dummy_events/')
    </create_query>

    <fill_query>
        INSERT INTO iceberg_suite_s3_dummy.events
        SELECT
            number AS id,
            toDateTime('2024-01-01 00:00:00') + (number % 86400) AS ts,
            (number % 1000) / 7 AS value,
            'tag_' || toString(number % 100) AS tag
        FROM numbers(1000000)
        SETTINGS max_threads = 1, max_insert_threads = 1
    </fill_query>

    <!-- full_scan: read every data file from S3. -->
    <query>SELECT count(), sum(value) FROM iceberg_suite_s3_dummy.events</query>

    <!-- filtered_scan: predicate over all files, exercises Parquet reads over S3. -->
    <query>SELECT avg(value), max(id) FROM iceberg_suite_s3_dummy.events WHERE id % 10 = 0</query>

    <!-- group_by: aggregation over the low-cardinality tag column. -->
    <query>SELECT tag, count() FROM iceberg_suite_s3_dummy.events GROUP BY tag ORDER BY tag LIMIT 10</query>

    <!-- table_function_resolution: same data via icebergS3, paying resolution + schema inference per run. -->
    <query>SELECT count() FROM icebergS3(perf_s3, filename = 'iceberg_suite_s3_dummy_events/') WHERE ts &lt; toDateTime('2024-01-01 12:00:00')</query>

    <drop_query>DROP TABLE IF EXISTS iceberg_suite_s3_dummy.events</drop_query>
</test>

<test>
    <!-- Key-only aggregations, which group without aggregate functions, run many times on one server. The
         hash-table statistics of the first run decide the path of the later runs: they skip the adaptive
         aggregator only when at least half of the threads whose tables froze thawed. In these queries the
         staged keys repeat too little for that, for example 3 of 12 threads thaw in the first query and 1
         of 8 in the second, so every run takes the adaptive path, which is faster here than the ordinary
         aggregation. -->
    <query>SELECT UserID, SearchPhrase FROM hits_100m_single GROUP BY UserID, SearchPhrase FORMAT Null</query>
    <query>SELECT ClientIP, ClientIP - 1, ClientIP - 2, ClientIP - 3 FROM hits_100m_single GROUP BY ClientIP, ClientIP - 1, ClientIP - 2, ClientIP - 3 FORMAT Null</query>
</test>

<test>
    <settings>
        <allow_experimental_time_series_table>1</allow_experimental_time_series_table>
        <allow_experimental_time_series_aggregate_functions>1</allow_experimental_time_series_aggregate_functions>
        <max_insert_threads>8</max_insert_threads>
    </settings>

    <!-- Benchmarks PromQL evaluation (prometheusQuery / prometheusQueryRange) over a TimeSeries table -->
    <!-- with all default settings, so the identifiers have the default type Tuple(UInt64, UUID). -->
    <!-- The focus is the per-sample id-to-group lookup in the per-query tags collector: a PromQL selector -->
    <!-- evaluates timeSeriesIdToGroup(id) for every sample, so the lookup speed dominates on large scans. -->
    <!-- The data is sized so that per-sample work dominates: 20000 series x 1440 samples = 28.8M samples, -->
    <!-- while the query result is small (50 namespaces, or 20000 series on a coarse grid). -->
    <!-- The size also keeps every query above 100ms, otherwise the fixed per-query overhead makes the -->
    <!-- measurements too noisy to reach the harness's precision target. -->

    <create_query>
        CREATE TABLE promql ENGINE = TimeSeries
    </create_query>

    <!-- 20000 series of metric `m`: 50 namespaces x 400 pods. -->
    <!-- One sample per series every 15s over [0, 21600) -> 1440 samples/series, 28.8M samples total. -->
    <!-- The value is a counter growing by 1 per second, so `rate(m[5m])` is ~1 everywhere. -->
    <fill_query>
        INSERT INTO promql (metric_name, tags, time_series)
        SELECT
            'm' AS metric_name,
            map('ns', 'ns' || toString(intDiv(number, 400)), 'pod', 'pod' || toString(number % 400)) AS tags,
            arrayMap(n -> (toDateTime64(n * 15, 3), (n * 15)::Float64), range(1440)) AS time_series
        FROM numbers(20000)
    </fill_query>

    <!-- Range query aggregated to 50 namespaces: the per-series aggregation consumes all 7.2M samples. -->
    <query>SELECT * FROM prometheusQueryRange('promql', 'sum by (ns) (rate(m[5m]))', 3600, 21600, 60) FORMAT Null</query>
    <!-- Range query without re-aggregation: 20000 output series on a coarse grid. -->
    <query>SELECT * FROM prometheusQueryRange('promql', 'rate(m[5m])', 3600, 21600, 300) FORMAT Null</query>
    <!-- Instant queries: a plain selector (the last_over_time path) and an aggregated rate. -->
    <query>SELECT * FROM prometheusQuery('promql', 'm', 21600) FORMAT Null</query>
    <query>SELECT * FROM prometheusQuery('promql', 'sum by (ns) (rate(m[5m]))', 21600) FORMAT Null</query>

    <drop_query>DROP TABLE IF EXISTS promql</drop_query>
</test>

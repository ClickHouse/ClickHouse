<test>
    <!-- Repeat one right-side Array row many times through the join output path.
         Empty arrays only need offset insertion. Single-element arrays can bulk-copy
         their nested value, including the already-specialized LowCardinality path. -->
    <settings>
        <enable_analyzer>1</enable_analyzer>
        <allow_suspicious_low_cardinality_types>1</allow_suspicious_low_cardinality_types>
        <max_threads>1</max_threads>
        <max_block_size>65536</max_block_size>
        <query_plan_join_swap_table>0</query_plan_join_swap_table>
    </settings>

    <create_query>
        CREATE TABLE tab
        (
            empty_array Array(UInt64),
            single_u64 Array(UInt64),
            single_string Array(String),
            single_lc Array(LowCardinality(String))
        ) ENGINE = Memory
    </create_query>

    <fill_query>
        INSERT INTO tab VALUES
            ([], [42], ['repeated'], [toLowCardinality('repeated')])
    </fill_query>

    <query>
        SELECT
            l.number,
            r.empty_array,
            r.single_u64,
            r.single_string,
            r.single_lc
        FROM numbers(50000000) AS l
        ANY LEFT JOIN tab AS r ON 1
        FORMAT Null
    </query>

    <drop_query>DROP TABLE IF EXISTS tab</drop_query>
</test>

<clickhouse>
    <http_port remove="remove"/>
    <mysql_port remove="remove"/>
    <postgresql_port remove="remove"/>
    <tcp_with_proxy_port remove="remove"/>
    <listen_host>::</listen_host>

    <logger>
        <console>true</console>
    </logger>

    <!-- Excessive use of memory and CPU. Left the ones used in get_profiles -->
<!--    <query_log remove="remove"/>-->
<!--    <trace_log remove="remove"/>-->
    <query_thread_log remove="remove"/>
    <query_views_log remove="remove"/>
    <part_log remove="remove"/>
    <text_log remove="remove"/>
<!--    <metric_log remove="remove"/>-->
    <error_log remove="remove"/>
    <query_metric_log remove="remove"/>
<!--    <asynchronous_metric_log remove="remove"/>-->
    <opentelemetry_span_log remove="remove"/>
    <crash_log remove="remove"/>
    <session_log remove="remove"/>
    <processors_profile_log remove="remove"/>
    <asynchronous_insert_log remove="remove"/>
    <backup_log remove="remove"/>
    <s3queue_log remove="remove"/>
    <blob_storage_log remove="remove"/>
    <transactions_info_log remove="remove"/>
    <filesystem_cache_log remove="remove"/>
    <aggregated_zookeeper_log remove="remove"/>
    <iceberg_metadata_log remove="remove"/>
    <delta_lake_metadata_log remove="remove"/>

    <uncompressed_cache_size>1000000000</uncompressed_cache_size>

    <!--
        Disable the columns cache in the perf-comparison environment:
        - the comparison should measure code effects, not right-server-only cache
          hits (the same reason the query condition cache is disabled in
          perf-comparison-tweaks-users.xml);
        - the default 2 GiB cache (weighted by byteSize, so actual RSS is higher)
          on top of two servers and the hits datasets exhausts the memory of the
          perf runner and kills it mid-run.
        A size of 0 makes the server skip both cache reads and cache writes
        (including the deferred-write buffering). The old reference server
        ignores this unknown config key.
    -->
    <columns_cache_size>0</columns_cache_size>
    <asynchronous_metrics_update_period_s>10</asynchronous_metrics_update_period_s>
    <remap_executable replace="replace">true</remap_executable>
</clickhouse>

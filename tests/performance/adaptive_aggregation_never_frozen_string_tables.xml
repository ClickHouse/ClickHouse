<test>
    <!-- The merge of the adaptive aggregator's local string tables that never freeze, measured where finding
         the cells of a partition dominates it: every thread's table holds all of 15 thousand keys, below the
         freeze threshold. A single `String` key takes the string table when
         `enable_packed_string_keys_in_aggregation` is off, and a single `FixedString` key always takes it. The
         keys of the queries fill different submaps of the table: keys of up to 8 bytes, keys of 20 to 24
         bytes, and `FixedString` keys that end in a zero byte of padding.

         The states are wide or own memory, so the merge runs on all the threads, partition by partition. Each
         partition reads only its own cells, through the index that every producer builds of its table when it
         finishes. A merge that walked every table for every partition would cost the tables times the
         partitions, and both follow the thread count. The queries run 64 threads, which the cores of the runner
         share: the number of tables, not the cores, makes this cost. The free-memory cap of the thread count is
         off, as it would lower the 64 threads to the free memory of the runner. -->
    <settings>
        <max_threads>64</max_threads>
        <max_threads_min_free_memory_per_thread>0</max_threads_min_free_memory_per_thread>
        <enable_packed_string_keys_in_aggregation>0</enable_packed_string_keys_in_aggregation>
    </settings>

    <query>SELECT k, uniqExact(x) FROM (SELECT toString(number % 15000) AS k, number % 3 AS x FROM numbers_mt(60000000)) GROUP BY k FORMAT Null</query>
    <query>SELECT k, groupArray(2)(number) FROM (SELECT toString(number % 15000) AS k, number FROM numbers_mt(80000000)) GROUP BY k FORMAT Null</query>
    <query>SELECT k, uniqExact(x) FROM (SELECT concat('key_', toString(number % 15000), '_of_some_length') AS k, number % 3 AS x FROM numbers_mt(40000000)) GROUP BY k FORMAT Null</query>
    <query>SELECT k, uniqExact(x) FROM (SELECT toFixedString(toString(number % 15000), 5) AS k, number % 3 AS x FROM numbers_mt(50000000)) GROUP BY k FORMAT Null</query>
</test>

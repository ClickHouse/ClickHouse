<test>
    <!--
        Inserting into a `QBit` column transposes every vector into one bit plane per bit of the
        element type. The per-element kernel walks the set bits of a value, so its cost follows how
        dense the values are, not how many planes there are.

        `qbit_insert_memory` inserts `id + i - 1`, whose Float64 pattern has 11.4 set bits out of 64
        on average. Embeddings are not like that: a standard normal has 35.1 set bits as Float64,
        17.7 as Float32 and 9.7 as BFloat16. This test measures that shape.
    -->
    <substitutions>
        <substitution>
            <name>vector_size</name>
            <values>
                <value>100</value>
            </values>
        </substitution>

        <substitution>
            <name>elements</name>
            <values>
                <value>100000</value>
            </values>
        </substitution>

        <substitution>
            <name>type</name>
            <values>
                <value>BFloat16</value>
                <value>Float32</value>
                <value>Float64</value>
            </values>
        </substitution>
    </substitutions>

    <create_query>DROP TABLE IF EXISTS tab_dense_{type}</create_query>
    <create_query>CREATE TABLE tab_dense_{type} (id UInt32, vec QBit({type}, {vector_size})) ENGINE = Memory</create_query>

    <query>INSERT INTO tab_dense_{type} SELECT number + 1 AS id, arrayMap(i -> to{type}(randNormal(0, 1)), range({vector_size})) AS vec FROM numbers({elements})</query>

    <drop_query>DROP TABLE tab_dense_{type}</drop_query>
</test>

<test>
    <settings>
        <allow_experimental_time_series_table>1</allow_experimental_time_series_table>
        <max_insert_threads>8</max_insert_threads>
    </settings>

    <!--
        Benchmarks the primary-key index analysis of PromQL selectors over the default layout of a
        TimeSeries table (the id is Tuple(sipHash64(metric_name), hash of tags), so the series of a
        metric are adjacent in the samples table).

        The samples table is created with a tiny byte limit of a granule, below the size of a row with a
        full bucket of samples, so every row is a granule and the part has as many marks as rows
        (20000 series x 2 buckets = 40K marks). A whole-metric selector resolves to all 20000 series ids
        of the metric, so the index analysis of the generated query is the dominant cost. The
        label-filtered selector resolves to a sparse subset of the ids and is the control: it must not
        regress.
    -->

    <create_query do_not_check_in_pr="117344">CREATE TABLE promql_pk_range_ts ENGINE = TimeSeries SETTINGS samples_index_granularity_bytes = 1024</create_query>

    <!-- 20000 series of one metric, one sample every 15s over [1000000, 1003840): 256 samples per
         series in 2 buckets, and the 5m instant lookback selects one granule per series. -->
    <fill_query>
        INSERT INTO promql_pk_range_ts (metric_name, tags, samples)
        SELECT
            'pkr_metric',
            map('instance', toString(number), 'dc', toString(number % 8)),
            arrayMap(step -> (toDateTime64(1000000 + step * 15, 3), (sipHash64(number, step) % 1000000) / 1000), range(256))
        FROM numbers_mt(20000)
    </fill_query>

    <!-- whole-metric selectors: all series ids of the metric -->
    <query>SELECT * FROM prometheusQuery('promql_pk_range_ts', 'pkr_metric', 1003830) FORMAT Null</query>
    <query>SELECT * FROM prometheusQuery('promql_pk_range_ts', 'sum(pkr_metric{{dc=~".*"}})', 1003830) FORMAT Null</query>
    <query>SELECT * FROM prometheusQuery('promql_pk_range_ts', 'sum(rate(pkr_metric[30m]))', 1003830) FORMAT Null</query>

    <!-- label-filtered selector: a subset of the ids (regression control) -->
    <query>SELECT * FROM prometheusQuery('promql_pk_range_ts', 'sum(pkr_metric{{dc="0"}})', 1003830) FORMAT Null</query>

    <drop_query>DROP TABLE IF EXISTS promql_pk_range_ts</drop_query>
</test>

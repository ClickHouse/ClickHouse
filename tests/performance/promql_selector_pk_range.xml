<test>
    <settings>
        <allow_experimental_time_series_table>1</allow_experimental_time_series_table>
        <max_insert_threads>8</max_insert_threads>
    </settings>

    <!--
        Benchmarks the primary-key index analysis of PromQL selectors over a TimeSeries table with a
        metric-clustered id layout (id = Tuple(sipHash64(metric_name), hash of tags)).

        The samples table is created with a small index granularity, so the part has many marks
        (20000 series x 256 samples = 5.12M rows at granularity 64 -> 80K marks). The id set of a
        selector reaches index analysis, where the generic exclusion search with the set is
        single-threaded and the dominant cost of these queries, unless the range of the ids holds no
        other series of the metric: then the range replaces the set (a continuous-range search). A
        metric-name-only selector qualifies without a query. With other matchers a query on the tags
        table checks it from `time_series_id_range_check_min_series` series on; below that the set
        is cheaper than the check.
    -->

    <create_query>
        CREATE TABLE promql_pk_range_ts ENGINE = TimeSeries
        SAMPLES INNER ENGINE = MergeTree ORDER BY (id, timestamp) SETTINGS index_granularity = 64
        TAGS INNER COLUMNS (id Tuple(UInt64, UUID))
    </create_query>

    <!-- 20000 series of one metric, one sample every 15s over [1000000, 1003840): 256 samples per
         series, so a series spans 4 granules and the 5m instant lookback selects about one granule
         per series - index analysis dominates the query. -->
    <fill_query>
        INSERT INTO promql_pk_range_ts (metric_name, tags, samples)
        SELECT
            'pkr_metric',
            map('instance', toString(number), 'dc', toString(number % 8)),
            arrayMap(step -> (toDateTime64(1000000 + step * 15, 3), (sipHash64(number, step) % 1000000) / 1000), range(256))
        FROM numbers_mt(20000)
    </fill_query>

    <!-- metric name only: the range replaces the set without a check -->
    <query>SELECT * FROM prometheusQuery('promql_pk_range_ts', 'pkr_metric', 1003830) FORMAT Null</query>

    <!-- a matcher every series passes (a dashboard's "All" filter): the check passes, the range replaces the set -->
    <query>SELECT * FROM prometheusQuery('promql_pk_range_ts', 'sum(pkr_metric{{dc=~".*"}})', 1003830) FORMAT Null</query>

    <!-- metric name only -->
    <query>SELECT * FROM prometheusQuery('promql_pk_range_ts', 'sum(rate(pkr_metric[30m]))', 1003830) FORMAT Null</query>

    <!-- a matcher keeping 2500 of the series: the check fails, the set stays in index analysis -->
    <query>SELECT * FROM prometheusQuery('promql_pk_range_ts', 'sum(pkr_metric{{dc="0"}})', 1003830) FORMAT Null</query>

    <!-- matchers keeping 100 series (a dashboard panel) and one series (an alert): no check, the set -->
    <query>SELECT * FROM prometheusQuery('promql_pk_range_ts', 'sum(pkr_metric{{instance=~"1[0-9][0-9]"}})', 1003830) FORMAT Null</query>
    <query>SELECT * FROM prometheusQuery('promql_pk_range_ts', 'pkr_metric{{instance="42"}}', 1003830) FORMAT Null</query>

    <drop_query>DROP TABLE IF EXISTS promql_pk_range_ts</drop_query>
</test>

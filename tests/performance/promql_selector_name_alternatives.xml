<test>
    <settings>
        <allow_experimental_time_series_table>1</allow_experimental_time_series_table>
        <max_insert_threads>8</max_insert_threads>
    </settings>

    <!--
        Benchmarks a PromQL selector whose metric name is a list of many alternatives. Such a selector reads the
        time ranges table by the id ranges of the selected metrics: only the primary key uses the
        comparisons with the bounds of the ranges (they are in `indexHint`), and the rows are
        filtered by one set lookup on the first component of the id.

        200 metrics with 1000 series each; the selector picks 100 of them. The time range covers
        every sample, so the time ranges table is joined and both the tags and the time ranges
        tables are read for half of the series. The single-metric selector and the regular
        expression over the same 100 metrics (no id ranges) are the controls: they must not regress.
    -->

    <create_query>CREATE TABLE promql_name_alternatives_ts ENGINE = TimeSeries</create_query>

    <!-- 200 metrics x 1000 series, 20 samples each at 15s: 4M samples -->
    <fill_query>
        INSERT INTO promql_name_alternatives_ts (metric_name, tags, samples)
        SELECT
            concat('m_', toString(100 + number % 200)),
            map('instance', toString(intDiv(number, 200)), 'dc', toString(number % 8)),
            arrayMap(step -> (toDateTime64(1000000 + step * 15, 3), toFloat64(step)), range(20))
        FROM numbers_mt(200000)
    </fill_query>

    <!-- 100 metric names as a list of alternatives: the time ranges table is read by 100 id ranges -->
    <query>SELECT count() FROM timeSeriesSelector('promql_name_alternatives_ts', '{{__name__=~"m_100|m_101|m_102|m_103|m_104|m_105|m_106|m_107|m_108|m_109|m_110|m_111|m_112|m_113|m_114|m_115|m_116|m_117|m_118|m_119|m_120|m_121|m_122|m_123|m_124|m_125|m_126|m_127|m_128|m_129|m_130|m_131|m_132|m_133|m_134|m_135|m_136|m_137|m_138|m_139|m_140|m_141|m_142|m_143|m_144|m_145|m_146|m_147|m_148|m_149|m_150|m_151|m_152|m_153|m_154|m_155|m_156|m_157|m_158|m_159|m_160|m_161|m_162|m_163|m_164|m_165|m_166|m_167|m_168|m_169|m_170|m_171|m_172|m_173|m_174|m_175|m_176|m_177|m_178|m_179|m_180|m_181|m_182|m_183|m_184|m_185|m_186|m_187|m_188|m_189|m_190|m_191|m_192|m_193|m_194|m_195|m_196|m_197|m_198|m_199"}}', 1000000, 1000300, 'timestamp_and_value') SETTINGS max_threads = 4 FORMAT Null</query>

    <!-- controls: one metric (one id range), and a regular expression over the same 100 metrics (no id ranges) -->
    <query>SELECT count() FROM timeSeriesSelector('promql_name_alternatives_ts', 'm_100', 1000000, 1000300, 'timestamp_and_value') SETTINGS max_threads = 4 FORMAT Null</query>
    <query>SELECT count() FROM timeSeriesSelector('promql_name_alternatives_ts', '{{__name__=~"m_1[0-9][0-9]"}}', 1000000, 1000300, 'timestamp_and_value') SETTINGS max_threads = 4 FORMAT Null</query>

    <drop_query>DROP TABLE IF EXISTS promql_name_alternatives_ts</drop_query>
</test>

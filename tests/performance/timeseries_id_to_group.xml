<test>
    <settings>
        <max_insert_threads>8</max_insert_threads>
    </settings>

    <!--
        Benchmarks `timeSeriesIdToGroup` on a long sorted stream of time-series ids of the canonical type
        `Tuple(UInt64, UUID)`. The ids arrive in long runs of equal values (samples are sorted by id), so
        `ContextTimeSeriesTagsCollector::getGroupByID` reuses the previous row's group after checking that
        the current row equals the previous one. Ids of the canonical type are dispatched to a typed id map,
        so both this per-row equality check and the map lookups work on typed values instead of virtual
        `compareAt` / `serializeValueIntoArena` chains; this test measures that typed fast path.

        The `IN` subquery populates the per-query tags collector via `timeSeriesStoreTags` for every id
        scanned afterwards (`timeSeriesIdToGroup` throws on ids that were never stored); this mirrors the
        shape of transpiled PromQL selectors. The query returns 2000: 2000 distinct non-empty tag sets get
        group indexes 1..2000 (group 0 is reserved for the empty tag set).
    -->

    <create_query>
        CREATE TABLE ts_ids (id Tuple(UInt64, UUID)) ENGINE = MergeTree ORDER BY id
    </create_query>

    <!-- 2000 distinct ids in runs of 20000 equal values, 40M rows total, sorted by id. -->
    <fill_query>
        INSERT INTO ts_ids
        SELECT (intDiv(number, 20000), reinterpretAsUUID(sipHash128(intDiv(number, 20000))))::Tuple(UInt64, UUID) AS id
        FROM numbers_mt(40000000)
    </fill_query>

    <query>
        SELECT max(timeSeriesIdToGroup(id))
        FROM ts_ids
        WHERE id IN (
            SELECT timeSeriesStoreTags((number, reinterpretAsUUID(sipHash128(number)))::Tuple(UInt64, UUID), [('n', toString(number))], '__name__', 'm')
            FROM numbers(2000)
        )
    </query>

    <drop_query>DROP TABLE IF EXISTS ts_ids</drop_query>
</test>

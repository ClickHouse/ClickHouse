<test>
    <!-- A left semi join with an empty right side returns nothing, so the left side does not have to be read.
         The right side is empty only at runtime. The join runtime filter is switched off, because it stops the
         left side on its own, and the table swap is switched off to keep the empty side on the build side.
         The left key is hashed to give the left side a cost worth skipping: a plain numbers source is too cheap. -->
    <settings>
        <enable_join_runtime_filters>0</enable_join_runtime_filters>
        <query_plan_join_swap_table>0</query_plan_join_swap_table>
    </settings>

    <substitutions>
        <substitution>
            <name>join_algorithm</name>
            <values>
                <value>hash</value>
                <value>parallel_hash</value>
                <value>grace_hash</value>
                <value>partial_merge</value>
            </values>
        </substitution>
    </substitutions>

    <query>
        SELECT count()
        FROM (SELECT sipHash64(number) AS number FROM numbers_mt(100000000)) AS l
        SEMI LEFT JOIN (SELECT number FROM numbers(1000) WHERE sipHash64(number) = 42) AS r ON l.number = r.number
        SETTINGS join_algorithm = '{join_algorithm}'
    </query>
</test>

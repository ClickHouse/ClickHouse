<!-- https://clickhouse.com/docs/getting-started/example-datasets/tpch -->
<!-- Scale factor: 10 -->
<test requires_s3="1">
    <!-- Synthetic-IO twin of iceberg_suite_s3_write.xml: simulate S3 response latency during setup and measured queries. -->
    <settings>
        <allow_insert_into_iceberg>1</allow_insert_into_iceberg>
        <iceberg_metadata_log_level>none</iceberg_metadata_log_level>
        <iceberg_delete_data_on_drop>1</iceberg_delete_data_on_drop>
    </settings>
    <substitutions>
        <substitution>
            <name>database</name>
            <values><value>iceberg_suite_s3_synthio_write</value></values>
        </substitution>
        <substitution>
            <name>engine_function_wr_large</name>
            <values><value>IcebergS3(perf_s3, filename = 'iceberg_suite_s3_synthio_write_wr_large_' || toString(toUnixTimestamp64Micro(now64(6))) || '/')</value></values>
        </substitution>
        <substitution>
            <name>engine_function_wr_small</name>
            <values><value>IcebergS3(perf_s3, filename = 'iceberg_suite_s3_synthio_write_wr_small_' || toString(toUnixTimestamp64Micro(now64(6))) || '/')</value></values>
        </substitution>
        <substitution>
            <name>engine_function_wr_planned</name>
            <values><value>IcebergS3(perf_s3, filename = 'iceberg_suite_s3_synthio_write_wr_planned_' || toString(toUnixTimestamp64Micro(now64(6))) || '/')</value></values>
        </substitution>
    </substitutions>
    <fill_query do_not_check_in_pr="119976">SYSTEM ENABLE FAILPOINT s3_slow_response</fill_query>
    <include file="iceberg_suite_shared_write.xml.inc"/>
    <drop_query>SYSTEM DISABLE FAILPOINT s3_slow_response</drop_query>
</test>

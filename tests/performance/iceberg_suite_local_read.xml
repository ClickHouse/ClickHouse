<test run_all_queries="1" profile_all_queries="1">
    <settings>
        <iceberg_metadata_log_level>none</iceberg_metadata_log_level>
    </settings>
    <!-- Shared read workload over the local tpch_ice10 dataset. -->
    <substitutions>
        <substitution>
            <name>database</name>
            <values><value>tpch_ice10</value></values>
        </substitution>
        <substitution>
            <name>table_function</name>
            <values><value>icebergLocal((SELECT value FROM system.server_settings WHERE name = 'user_files_path') || '/tpch_ice_sf10/lineitem/')</value></values>
        </substitution>
    </substitutions>
    <include file="iceberg_suite_shared_read.xml.inc"/>
</test>

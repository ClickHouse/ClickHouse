    <create_query>CREATE TABLE sparse_wide_defaults (k UInt64, ts DateTime) ENGINE = MergeTree ORDER BY (k, ts) SETTINGS min_bytes_for_wide_part = 0</create_query>
    <create_query>ALTER TABLE sparse_wide_defaults
        ADD COLUMN u{i}_0 UInt32,
        ADD COLUMN u{i}_1 UInt32,
        ADD COLUMN u{i}_2 UInt32,
        ADD COLUMN u{i}_3 UInt32,
        ADD COLUMN u{i}_4 UInt32,

        ADD COLUMN u{i}_9 UInt32,
        ADD COLUMN u{i}_10 UInt32,
        ADD COLUMN u{i}_11 UInt32</create_query>
    <create_query>ALTER TABLE sparse_wide_defaults
        ADD COLUMN s{i}_0 String,
        ADD COLUMN s{i}_1 String,
        ADD COLUMN s{i}_2 String,
        ADD COLUMN s{i}_3 String</create_query>
    <create_query>CREATE TABLE sparse_wide_mixed AS sparse_wide_defaults</create_query>
    <create_query>CREATE TABLE sparse_wide_dense AS sparse_wide_defaults ENGINE = MergeTree ORDER BY (k, ts) SETTINGS min_bytes_for_wide_part = 0, ratio_of_defaults_for_sparse_serialization = 1</create_query>

    <fill_query>INSERT INTO sparse_wide_defaults (k, ts) SELECT number, toDateTime('2024-01-01') + number FROM numbers(100000)</fill_query>
    <!-- Values only in rows k % 50000 &lt; 500, i.e. in two of the granules. -->
    <fill_query>INSERT INTO sparse_wide_mixed SELECT k, ts, COLUMNS('^u') APPLY (x -> if(k % 50000 &lt; 500, toUInt32(k + 1), x)), COLUMNS('^s') APPLY (x -> if(k % 50000 &lt; 500, toString(k), x)) FROM sparse_wide_defaults</fill_query>
    <fill_query>INSERT INTO sparse_wide_dense SELECT * FROM sparse_wide_mixed</fill_query>
    <fill_query>OPTIMIZE TABLE sparse_wide_defaults FINAL</fill_query>
    <fill_query>OPTIMIZE TABLE sparse_wide_mixed FINAL</fill_query>
    <fill_query>OPTIMIZE TABLE sparse_wide_dense FINAL</fill_query>

    <query>SELECT * FROM sparse_wide_defaults WHERE k = 30000 FORMAT Null</query>
    <query>SELECT * FROM sparse_wide_mixed WHERE k = 30000 FORMAT Null</query>
    <query>SELECT * FROM sparse_wide_mixed WHERE k > 1000 ORDER BY ts DESC LIMIT 10 FORMAT Null</query>
    <query>SELECT * FROM sparse_wide_defaults FORMAT Null</query>
    <query>SELECT * FROM sparse_wide_mixed FORMAT Null</query>
    <query>SELECT * FROM sparse_wide_dense WHERE k = 30000 FORMAT Null</query>


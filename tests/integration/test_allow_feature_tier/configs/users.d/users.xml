<clickhouse>
    <profiles>
        <default>
            <!-- To verify it works with compatibility values too (as long as they don't change tiers)
                allow_experimental_reverse_key was introduced as experimental and added to compatibility,
                but it's disabled in all cases. It has since been made obsolete, which does not affect this test.
            -->
            <compatibility>24.10</compatibility>

            <allow_experimental_funnel_functions>0</allow_experimental_funnel_functions>
        </default>

        <!-- An EXPERIMENTAL setting a read-only storage puts in effect, used to check writes which change
             which same-name user is visible. -->
        <tier_config_experimental>
            <allow_experimental_funnel_functions>1</allow_experimental_funnel_functions>
        </tier_config_experimental>
    </profiles>
    <users>
        <default>
            <password></password>
            <profile>default</profile>
            <quota>default</quota>
            <named_collection_control>1</named_collection_control>
            <show_named_collections>1</show_named_collections>
            <show_named_collections_secrets>1</show_named_collections_secrets>
        </default>
        <tier_config_user>
            <no_password/>
            <profile>default</profile>
        </tier_config_user>
        <tier_config_experimental_user>
            <no_password/>
            <profile>tier_config_experimental</profile>
        </tier_config_experimental_user>
    </users>
</clickhouse>

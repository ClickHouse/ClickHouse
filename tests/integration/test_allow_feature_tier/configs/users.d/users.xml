<clickhouse>
    <profiles>
        <default>
            <!-- To verify it works with compatibility values too: `compatibility` leaves the settings of a
                disabled tier as they are. -->
            <compatibility>24.10</compatibility>

            <enable_funnel_functions>0</enable_funnel_functions>
        </default>
    </profiles>
    <users>
        <default>
            <password></password>
            <profile>default</profile>
            <quota>default</quota>
            <named_collection_control>1</named_collection_control>
            <show_named_collections>1</show_named_collections>
            <show_named_collections_secrets>1</show_named_collections_secrets>
        </default>
        <tier_config_user>
            <no_password/>
            <profile>default</profile>
        </tier_config_user>
    </users>
</clickhouse>

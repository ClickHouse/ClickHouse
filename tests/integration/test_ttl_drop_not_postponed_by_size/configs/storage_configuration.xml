<clickhouse>
    <storage_configuration>
        <disks>
            <gate_a>
                <type>local</type>
                <path>/ttl_drop_gate_a/</path>
            </gate_a>
            <gate_b>
                <type>local</type>
                <path>/ttl_drop_gate_b/</path>
            </gate_b>
            <gate_c>
                <type>local</type>
                <path>/ttl_drop_gate_c/</path>
            </gate_c>
            <gate_d>
                <type>local</type>
                <path>/ttl_drop_gate_d/</path>
            </gate_d>
        </disks>
        <policies>
            <only_a>
                <volumes>
                    <main>
                        <disk>gate_a</disk>
                    </main>
                </volumes>
            </only_a>
            <only_b>
                <volumes>
                    <main>
                        <disk>gate_b</disk>
                    </main>
                </volumes>
            </only_b>
            <only_c>
                <volumes>
                    <main>
                        <disk>gate_c</disk>
                    </main>
                </volumes>
            </only_c>
            <only_d>
                <volumes>
                    <main>
                        <disk>gate_d</disk>
                    </main>
                </volumes>
            </only_d>
        </policies>
    </storage_configuration>
</clickhouse>

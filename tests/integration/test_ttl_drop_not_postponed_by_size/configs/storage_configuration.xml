<clickhouse>
    <storage_configuration>
        <disks>
            <gate_a>
                <type>local</type>
                <path>/ttl_drop_gate_a/</path>
            </gate_a>
            <gate_b>
                <type>local</type>
                <path>/ttl_drop_gate_b/</path>
            </gate_b>
            <gate_orphan>
                <type>local</type>
                <path>/ttl_drop_gate_orphan/</path>
            </gate_orphan>
        </disks>
        <policies>
            <only_a>
                <volumes>
                    <main>
                        <disk>gate_a</disk>
                    </main>
                </volumes>
            </only_a>
            <only_b>
                <volumes>
                    <main>
                        <disk>gate_b</disk>
                    </main>
                </volumes>
            </only_b>
            <only_orphan>
                <volumes>
                    <main>
                        <disk>gate_orphan</disk>
                    </main>
                </volumes>
            </only_orphan>
        </policies>
    </storage_configuration>
</clickhouse>

<clickhouse>
    <remote_servers>
        <cluster_simple>
            <shard>
                <replica>
                    <host>node1</host>
                    <port>9000</port>
                </replica>
                <replica>
                    <host>node2</host>
                    <port>9000</port>
                </replica>
            </shard>
        </cluster_simple>
        <cluster_demo_default_database>
            <shard>
                <replica>
                    <host>node2</host>
                    <port>9000</port>
                    <default_database>demo</default_database>
                </replica>
            </shard>
        </cluster_demo_default_database>
        <cluster_worker_default_database_demo>
            <shard>
                <replica>
                    <host>node2</host>
                    <port>9000</port>
                    <user>worker_default_database_demo</user>
                </replica>
            </shard>
        </cluster_worker_default_database_demo>
    </remote_servers>
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <max_size_rows>1048576</max_size_rows>
        <reserved_size_rows>8192</reserved_size_rows>
        <buffer_size_rows_flush_threshold>524288</buffer_size_rows_flush_threshold>
        <flush_on_crash>false</flush_on_crash>
    </query_log>
</clickhouse>

<clickhouse>
    <ldap_servers>
        <openldap_strict>
            <host>openldap_strict</host>
            <port>1389</port>
            <enable_tls>no</enable_tls>
            <!-- Search-and-bind: every search runs as the service account, the password of the user
                 is verified by binding as the DN that `user_dn_detection` found. -->
            <lookup_bind_dn>cn=svc.clickhouse,ou=service,dc=example,dc=org</lookup_bind_dn>
            <lookup_password>svcsecret</lookup_password>
            <bind_dn>{user_dn}</bind_dn>
            <user_dn_detection>
                <base_dn>dc=example,dc=org</base_dn>
                <scope>subtree</scope>
                <search_filter>(&amp;(objectClass=inetOrgPerson)(uid={user_name}))</search_filter>
            </user_dn_detection>
            <verification_cooldown>300</verification_cooldown>
        </openldap_strict>
    </ldap_servers>
    <user_directories>
        <ldap>
            <server>openldap_strict</server>
            <!-- `ou=groups` is readable by the service account only (see setup_strict.sh),
                 so the mapping only works when the search runs after the re-bind. -->
            <role_mapping>
                <base_dn>ou=groups,dc=example,dc=org</base_dn>
                <scope>subtree</scope>
                <search_filter>(&amp;(objectClass=groupOfNames)(member={user_dn}))</search_filter>
                <attribute>cn</attribute>
                <prefix>clickhouse-</prefix>
            </role_mapping>
        </ldap>
    </user_directories>
</clickhouse>

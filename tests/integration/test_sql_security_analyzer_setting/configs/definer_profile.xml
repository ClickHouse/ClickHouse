<clickhouse>
    <profiles>
        <!-- `allow_experimental_analyzer` is obsolete and frozen at `1`: an access entity cannot be
             created with a `0` in it, and neither a query nor a session can set one. A settings
             profile written in the server configuration is the one place where the value still
             reaches a user, because the configuration is not checked against the constraints. -->
        <old_analyzer>
            <allow_experimental_analyzer>0</allow_experimental_analyzer>
        </old_analyzer>
    </profiles>
    <users>
        <definer_user>
            <password></password>
            <profile>old_analyzer</profile>
            <networks>
                <ip>::/0</ip>
            </networks>
        </definer_user>
    </users>
</clickhouse>

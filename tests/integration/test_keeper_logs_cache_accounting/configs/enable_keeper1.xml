<clickhouse>
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
        <data_storage_path>/var/lib/clickhouse/coordination/data</data_storage_path>
        <create_snapshot_on_exit>false</create_snapshot_on_exit>

        <coordination_settings>
            <operation_timeout_ms>5000</operation_timeout_ms>
            <session_timeout_ms>10000</session_timeout_ms>
            <!-- Small enough that the writes below overflow it many times over, so the reported
                 cache size is the steady state the eviction loop settles on. -->
            <latest_logs_cache_size_threshold>65536</latest_logs_cache_size_threshold>
            <!-- Keep the log intact: no snapshot, no compaction, so nothing but the cache bound
                 decides what stays in memory. -->
            <snapshot_distance>1000000</snapshot_distance>
            <reserved_log_items>1000000</reserved_log_items>
            <rotate_log_storage_interval>1000</rotate_log_storage_interval>
            <compress_logs>false</compress_logs>
            <log_readahead_commit_window_bytes>0</log_readahead_commit_window_bytes>
        </coordination_settings>

        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>node1</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>
</clickhouse>

<clickhouse>
    <http_authentication_servers>
        <main_server>
            <uri>http://localhost:8000/main</uri>
            <connection_timeout_ms>1000</connection_timeout_ms>
            <receive_timeout_ms>1000</receive_timeout_ms>
            <send_timeout_ms>1000</send_timeout_ms>
            <max_tries>3</max_tries>
            <retry_initial_backoff_ms>50</retry_initial_backoff_ms>
            <retry_max_backoff_ms>1000</retry_max_backoff_ms>
        </main_server>
    </http_authentication_servers>

    <user_directories>
        <http>
            <server>main_server</server>
            <allowed_roles>
                <role>reader</role>
                <role>analyst</role>
                <role>role_a</role>
                <role>role_b</role>
                <role>policy_role</role>
                <role>cluster_role</role>
                <role>only_node1_role</role>
                <role>probe_role_a</role>
                <role>probe_role_b</role>
                <role>capped_role</role>
            </allowed_roles>
            <allowed_role_prefix>external_</allowed_role_prefix>
        </http>
    </user_directories>
</clickhouse>

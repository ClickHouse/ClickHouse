<clickhouse>
    <remote_servers>
        <!-- 127.0.0.2 is not a local address, so the node is queried over the network with the secret. -->
        <secret_cluster>
            <secret>secret</secret>
            <shard>
                <replica>
                    <host>127.0.0.2</host>
                    <port>9000</port>
                </replica>
            </shard>
        </secret_cluster>
    </remote_servers>
</clickhouse>

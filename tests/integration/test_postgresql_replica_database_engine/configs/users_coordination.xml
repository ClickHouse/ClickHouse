<clickhouse>
    <profiles>
        <default>
            <enable_database_materialized_postgresql>1</enable_database_materialized_postgresql>
            <!-- Disable fault injection so the leader-election / failover assertions are deterministic. -->
            <postgresql_fault_injection_probability>0</postgresql_fault_injection_probability>
        </default>
    </profiles>
    <users>
        <default>
            <password></password>
            <profile>default</profile>
            <named_collection_control>1</named_collection_control>
        </default>
    </users>
</clickhouse>

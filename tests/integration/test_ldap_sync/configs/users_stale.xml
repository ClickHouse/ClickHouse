<clickhouse>
    <users>
        <!-- The harness `default` user (from `0_common_instance_users.xml`) is kept: the readiness
             probe run by `start_clickhouse` queries as `default`, so removing it makes every restart
             in the test look like a failed start. -->
        <admin>
            <password></password>
            <access_management>1</access_management>
            <readonly>0</readonly>
        </admin>
        <!-- Defined in the `users_xml` storage that FOLLOWS the synchronised `ldap` directory on `node_stale`. -->
        <local_after>
            <password>local</password>
        </local_after>
        <!-- Same name as an LDAP user `test_synced_user_shadows_a_same_named_user_of_a_later_storage` creates:
             while the directory holds that user, this definition must be unreachable. -->
        <shadowed>
            <password>local</password>
        </shadowed>
    </users>
</clickhouse>

<clickhouse>
    <!-- Strip the top-level `users_config` so that the access storages are exactly the ones declared
         below, in that order: `users_xml` (admin), `replicated` (roles created by the synchronisation,
         users created with SQL), `ldap` (synchronised users) last. -->
    <users_config remove="remove"/>
    <user_directories replace="replace">
        <users_xml>
            <path>users.xml</path>
        </users_xml>
        <replicated>
            <zookeeper_path>/clickhouse/access</zookeeper_path>
        </replicated>
        <ldap>
            <server>openldap_strict</server>
            <exclude_users>
                <user>johndoe</user>
            </exclude_users>
            <!-- Self-lookup of `memberOf`: answered from the enumerated entries, one search per run. -->
            <role_mapping>
                <base_dn>{user_dn}</base_dn>
                <scope>base</scope>
                <search_filter>(objectClass=*)</search_filter>
                <attribute>memberOf</attribute>
                <rdn_attribute>cn</rdn_attribute>
                <groups>
                    <group>cn=clickhouse-role_a,ou=groups,dc=example,dc=org</group>
                    <group>clickhouse-role_b</group>
                </groups>
                <prefix>clickhouse-</prefix>
            </role_mapping>
            <sync>
                <interval>2</interval>
                <base_dn>dc=example,dc=org</base_dn>
                <scope>subtree</scope>
                <search_filter>(&amp;(objectClass=inetOrgPerson)(|(memberOf=cn=clickhouse-role_a,ou=groups,dc=example,dc=org)(memberOf=cn=clickhouse-role_b,ou=groups,dc=example,dc=org)))</search_filter>
                <attribute>uid</attribute>
                <page_size>100</page_size>
                <create_roles>true</create_roles>
                <roles_storage>replicated</roles_storage>
            </sync>
        </ldap>
    </user_directories>
</clickhouse>

<clickhouse>
    <users_config remove="remove"/>
    <!-- Driven by `SYSTEM RELOAD USERS` only (`interval` 0): no periodic run can observe the directory while
         the `memberof` overlay is still applying a bulk change, so the numbers a forced run reports are exact.
         Same server, search, role mapping, `page_size` and exclusion as `directories_cluster.xml`; the roles are
         created in `local_directory`, which is not ephemeral. -->
    <user_directories replace="replace">
        <users_xml>
            <path>users.xml</path>
        </users_xml>
        <local_directory>
            <path>/var/lib/clickhouse/access/</path>
        </local_directory>
        <!-- A second writable storage, for `test_role_in_another_storage_is_not_created_again`. -->
        <memory/>
        <ldap>
            <server>openldap_strict</server>
            <exclude_users>
                <user>johndoe</user>
            </exclude_users>
            <role_mapping>
                <base_dn>{user_dn}</base_dn>
                <scope>base</scope>
                <search_filter>(objectClass=*)</search_filter>
                <attribute>memberOf</attribute>
                <rdn_attribute>cn</rdn_attribute>
                <groups>
                    <group>cn=clickhouse-role_a,ou=groups,dc=example,dc=org</group>
                    <group>clickhouse-role_b</group>
                </groups>
                <prefix>clickhouse-</prefix>
            </role_mapping>
            <sync>
                <interval>0</interval>
                <base_dn>dc=example,dc=org</base_dn>
                <scope>subtree</scope>
                <search_filter>(&amp;(objectClass=inetOrgPerson)(|(memberOf=cn=clickhouse-role_a,ou=groups,dc=example,dc=org)(memberOf=cn=clickhouse-role_b,ou=groups,dc=example,dc=org)))</search_filter>
                <attribute>uid</attribute>
                <page_size>100</page_size>
                <create_roles>true</create_roles>
                <roles_storage>local_directory</roles_storage>
            </sync>
        </ldap>
    </user_directories>
</clickhouse>

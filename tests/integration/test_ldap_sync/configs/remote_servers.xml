<clickhouse>
    <remote_servers>
        <test_ldap_cluster>
            <secret>my_secret</secret>
            <shard>
                <replica>
                    <host>node1</host>
                    <port>9000</port>
                </replica>
            </shard>
            <shard>
                <replica>
                    <host>node2</host>
                    <port>9000</port>
                </replica>
            </shard>
        </test_ldap_cluster>
        <!-- For `test_interserver_materialised_user_promoted_by_a_run_needs_no_lookup`: a fanout from `node1`
             reaches `node_bad` under the cluster secret. -->
        <test_ldap_cluster_bad>
            <secret>my_secret</secret>
            <shard>
                <replica>
                    <host>node1</host>
                    <port>9000</port>
                </replica>
            </shard>
            <shard>
                <replica>
                    <host>node_bad</host>
                    <port>9000</port>
                </replica>
            </shard>
        </test_ldap_cluster_bad>
        <!-- For the interserver check of `test_staleness_gate_refuses_synced_users_only`. -->
        <test_ldap_cluster_stale>
            <secret>my_secret</secret>
            <shard>
                <replica>
                    <host>node1</host>
                    <port>9000</port>
                </replica>
            </shard>
            <shard>
                <replica>
                    <host>node_stale</host>
                    <port>9000</port>
                </replica>
            </shard>
        </test_ldap_cluster_stale>
    </remote_servers>
</clickhouse>

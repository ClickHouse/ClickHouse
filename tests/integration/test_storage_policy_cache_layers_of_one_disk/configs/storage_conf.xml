<clickhouse>
    <storage_configuration>
        <disks>
            <blob>
                <type>object_storage</type>
                <object_storage_type>local</object_storage_type>
                <path>/var/lib/clickhouse/blob_objects/</path>
            </blob>
            <cache_1>
                <type>cache</type>
                <disk>blob</disk>
                <path>cache_1/</path>
                <max_size>1Gi</max_size>
            </cache_1>
            <cache_2>
                <type>cache</type>
                <disk>blob</disk>
                <path>cache_2/</path>
                <max_size>1Gi</max_size>
            </cache_2>
            <cache_of_cache_1>
                <type>cache</type>
                <disk>cache_1</disk>
                <path>cache_of_cache_1/</path>
                <max_size>1Gi</max_size>
            </cache_of_cache_1>
        </disks>
        <policies>
            <cache_1_only>
                <volumes>
                    <main>
                        <disk>cache_1</disk>
                    </main>
                </volumes>
            </cache_1_only>
            <cache_2_only>
                <volumes>
                    <main>
                        <disk>cache_2</disk>
                    </main>
                </volumes>
            </cache_2_only>
        </policies>
    </storage_configuration>
</clickhouse>

<clickhouse>
    <profiles>
        <default>
            <stream_like_engine_allow_direct_select>1</stream_like_engine_allow_direct_select>
            <!-- parallel_view_processing = 0 (the default): the insert into materialized views gets a single
                 pipeline thread. -->
            <parallel_view_processing>0</parallel_view_processing>
        </default>
    </profiles>
    <users>
        <default>
            <password></password>
            <profile>default</profile>
            <named_collection_control>1</named_collection_control>
        </default>
    </users>
</clickhouse>

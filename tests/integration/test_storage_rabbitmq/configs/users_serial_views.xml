<clickhouse>
    <profiles>
        <default>
            <stream_like_engine_allow_direct_select>1</stream_like_engine_allow_direct_select>
            <!-- Force serial materialized-view processing so the per-consumer RabbitMQ sources share a
                 single pipeline thread; this is the case the REFRESH self-drive budget must be fair to. -->
            <parallel_view_processing>0</parallel_view_processing>
        </default>
    </profiles>
    <users>
        <default>
            <password></password>
            <profile>default</profile>
            <named_collection_control>1</named_collection_control>
        </default>
    </users>
</clickhouse>

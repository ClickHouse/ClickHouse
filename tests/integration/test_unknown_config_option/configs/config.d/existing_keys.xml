<!-- Regression coverage for top-level keys that are consumed outside `ServerSettings`
     (read directly from the server config by various components). Every key here is
     read somewhere in the codebase (or was read by an older release and must stay
     accepted as a no-op); if a future allowlist edit drops one of them, the server
     will fail to start and this test will catch it. -->
<clickhouse>
    <proto_caps>
        <send>notchunked</send>
        <recv>notchunked</recv>
    </proto_caps>
    <enable_http_close_session>true</enable_http_close_session>
    <enable_arrow_close_session>true</enable_arrow_close_session>
    <!-- Read directly by `Context::loadUserDefinedExecutableFunctionDrivers` via `getMultipleValuesFromConfig`. -->
    <user_defined_executable_function_drivers_config>user_defined_executable_function_drivers_config.d/*_driver.xml</user_defined_executable_function_drivers_config>
    <!-- `ignore_table_dependencies_on_metadata_loading` is also read outside `ServerSettings`
         (by `TablesLoader`) and is kept in the allowlist, but it is intentionally NOT exercised
         here. It is a vestigial flag whose only remaining effect is to route databases into the
         unimplemented `DatabaseOrdinary::loadStoredObjects`, which aborts startup with a
         `LOGICAL_ERROR` ("Not implemented"). That abort is a pre-existing bug independent of this
         config check (it reproduces on `master`), so setting the flag in a "server must start
         cleanly" config would make this test fail for an unrelated reason. -->
    <allow_reserved_database_name_tmp_convert>1</allow_reserved_database_name_tmp_convert>
    <keeper_map_keys_limit>0</keeper_map_keys_limit>
    <umask>027</umask>
    <distributed_ddl_keeper_max_retries>5</distributed_ddl_keeper_max_retries>
    <distributed_ddl_keeper_initial_backoff_ms>100</distributed_ddl_keeper_initial_backoff_ms>
    <distributed_ddl_keeper_max_backoff_ms>5000</distributed_ddl_keeper_max_backoff_ms>
    <schema_inference_cache_max_elements_for_hdfs>1024</schema_inference_cache_max_elements_for_hdfs>
    <schema_inference_cache_max_elements_for_local>1024</schema_inference_cache_max_elements_for_local>
    <!-- Read directly by `Context::getBackgroundStreamingTaskSchedulingSettings`. -->
    <background_streaming_processing_pool_thread_sleep_seconds>10</background_streaming_processing_pool_thread_sleep_seconds>
    <background_streaming_processing_pool_thread_sleep_seconds_random_part>1.0</background_streaming_processing_pool_thread_sleep_seconds_random_part>
    <background_streaming_processing_pool_thread_sleep_seconds_if_nothing_to_do>0.1</background_streaming_processing_pool_thread_sleep_seconds_if_nothing_to_do>
    <background_streaming_processing_pool_task_sleep_seconds_when_no_work_min>10</background_streaming_processing_pool_task_sleep_seconds_when_no_work_min>
    <background_streaming_processing_pool_task_sleep_seconds_when_no_work_max>600</background_streaming_processing_pool_task_sleep_seconds_when_no_work_max>
    <background_streaming_processing_pool_task_sleep_seconds_when_no_work_multiplier>1.1</background_streaming_processing_pool_task_sleep_seconds_when_no_work_multiplier>
    <background_streaming_processing_pool_task_sleep_seconds_when_no_work_random_part>1.0</background_streaming_processing_pool_task_sleep_seconds_when_no_work_random_part>
    <resource_overload_warnings>
        <memory_overload_warn_ratio>0.9</memory_overload_warn_ratio>
    </resource_overload_warnings>
    <nats>
        <user>nats_user</user>
        <password>nats_password</password>
    </nats>
    <azure>
        <use_native_copy>true</use_native_copy>
    </azure>
    <library_bridge>
        <host>localhost</host>
        <port>9012</port>
    </library_bridge>
    <odbc_bridge>
        <host>localhost</host>
        <port>9018</port>
    </odbc_bridge>
    <jdbc_bridge>
        <host>localhost</host>
        <port>9019</port>
    </jdbc_bridge>
    <!-- Per-user HDFS client section: `hdfs_USERNAME` with an arbitrary user name. -->
    <hdfs_testuser>
        <hadoop_kerberos_principal>testuser@TEST.CLICKHOUSE.TECH</hadoop_kerberos_principal>
    </hdfs_testuser>
    <!-- Legacy system log sections no longer read by the current server. A config carried over
         an upgrade may still contain them with real content (`latency_log` was deprecated in
         favor of `histogram_metric_log`); they must stay accepted as no-ops. -->
    <latency_log>
        <database>system</database>
        <table>latency_log</table>
    </latency_log>
    <query_condition_cache_log>
        <database>system</database>
        <table>query_condition_cache_log</table>
    </query_condition_cache_log>
</clickhouse>

<clickhouse>
    <!--
        Negative case: a section shaped like a `GraphiteMergeTree` rollup whose `<pattern>` carries a
        `<rule_type>tag_list</rule_type>` and a `<function>` but no non-empty `<regexp>`.
        `appendGraphitePattern` only rewrites a `tag_list` rule into the dispatchable `tagged` type
        when its `<regexp>` is non-empty (`buildTaggedRegex` needs the tag spec); without one the
        pattern keeps the internal `RuleTypeTagList`, which `setGraphitePatternsFromConfig`'s final
        dispatch rejects with `Unhandled rule_type in config`. Every child name is recognized and the
        rule has a `<function>`, so a name-only check would exempt it, but the section would never
        load. The unknown-key validator must mirror that semantic check and reject the whole section
        as an unknown top-level key (a typo). The node must fail to start with
        `UNKNOWN_ELEMENT_IN_CONFIG`.
    -->
    <graphite_tag_list_without_regexp>
        <pattern>
            <function>any</function>
            <rule_type>tag_list</rule_type>
        </pattern>
    </graphite_tag_list_without_regexp>
</clickhouse>

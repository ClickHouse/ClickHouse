<clickhouse>
    <!--
        Regression: a top-level key whose tag name contains a literal dot. Poco reports such a
        key from `config.keys("")` with the dot escaped (`my_dotted\.payload`, see
        `gtest_config_dot.cpp`), and a `config://` reference must escape the dot the same way to
        address it as one top-level component rather than a nested path `my_dotted` -> `payload`.
        The unknown-key validator's `top_level_component` helper must recognize the escaped dot
        too, or it would wrongly trim the exemption to `my_dotted\` and reject this valid,
        in-use key with `UNKNOWN_ELEMENT_IN_CONFIG`.
    -->
    <my_dotted.payload>Hello from a dotted key</my_dotted.payload>

    <http_handlers>
        <rule>
            <methods>GET</methods>
            <url>/my_dotted_response</url>
            <handler>
                <type>static</type>
                <response_content>config://my_dotted\.payload</response_content>
            </handler>
        </rule>
        <defaults/>
    </http_handlers>
</clickhouse>

<clickhouse>
    <storage_configuration>
        <disks>
            <disk_cas_s3>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>cas</metadata_type>
                <!-- Phase 0 (mount safety): required, validated layout-subtree identity. Single server. -->
                <server_root_id>itest-content-addressed-s3</server_root_id>
                <!-- RustFS (not MinIO): the CA mount capability probe requires enforced conditional-DELETE
                     semantics (CasProbe step 6); MinIO OSS silently honors a mismatched-token DELETE and the
                     fail-closed probe aborts server startup (PR#2073 CI triage). -->
                <endpoint>http://rustfs1:11121/test/cas_data/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse</secret_access_key>
            </disk_cas_s3>
        </disks>
        <policies>
            <cas_s3>
                <volumes>
                    <main>
                        <disk>disk_cas_s3</disk>
                    </main>
                </volumes>
            </cas_s3>
        </policies>
    </storage_configuration>
</clickhouse>

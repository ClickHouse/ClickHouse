<clickhouse>
    <include_from>/etc/clickhouse-server/config.d/hdfs_locations.xml</include_from>
    <hdfs_locations>
        <locations>
            <main>
                <object_storage_type>hdfs</object_storage_type>
                <endpoint>hdfs://hdfs1:9000/sql_disk_filter/filter_locations/</endpoint>
                <local>1</local>
                <enabled>1</enabled>
            </main>
        </locations>
    </hdfs_locations>
    <encrypted_old_hdfs>
        <disk>old_hdfs</disk>
        <key>0123456789abcdef</key>
        <path>bypass_include/</path>
    </encrypted_old_hdfs>
</clickhouse>

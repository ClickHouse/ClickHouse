<clickhouse>
    <remote_servers>
        <two_nodes_dist>
            <shard>
                <replica>
                    <host>node1</host>
                    <port>9000</port>
                </replica>
            </shard>
            <shard>
                <replica>
                    <host>node2</host>
                    <port>9000</port>
                </replica>
            </shard>
        </two_nodes_dist>
        <!-- The same two replicas, replicating internally: the sink writes one of them, by failover. -->
        <one_shard_replicated>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>node1</host>
                    <port>9000</port>
                </replica>
                <replica>
                    <host>node2</host>
                    <port>9000</port>
                </replica>
            </shard>
        </one_shard_replicated>
        <one_shard_two_replicas>
            <shard>
                <replica>
                    <host>node1</host>
                    <port>9000</port>
                </replica>
                <replica>
                    <host>node2</host>
                    <port>9000</port>
                </replica>
            </shard>
        </one_shard_two_replicas>
    </remote_servers>
</clickhouse>

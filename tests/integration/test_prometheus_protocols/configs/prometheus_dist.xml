<clickhouse>
    <prometheus>
        <port>9093</port>
        <handlers>
            <dist_write>
                <url>/dist/write</url>
                <handler>
                    <type>write</type>
                    <table>default.prom_dist</table>
                </handler>
            </dist_write>
            <bad_write>
                <url>/bad/write</url>
                <handler>
                    <type>write</type>
                    <table>default.prom_dist_bad</table>
                </handler>
            </bad_write>
            <coarse_write>
                <url>/coarse/write</url>
                <handler>
                    <type>write</type>
                    <table>default.prom_dist_coarse</table>
                </handler>
            </coarse_write>
            <queue_write>
                <url>/queue/write</url>
                <handler>
                    <type>write</type>
                    <table>default.prom_queue</table>
                </handler>
            </queue_write>
            <rep_write>
                <url>/rep/write</url>
                <handler>
                    <type>write</type>
                    <table>default.prom_rep</table>
                </handler>
            </rep_write>
            <irep_write>
                <url>/irep/write</url>
                <handler>
                    <type>write</type>
                    <table>default.prom_irep</table>
                </handler>
            </irep_write>
            <missing_write>
                <url>/missing/write</url>
                <handler>
                    <type>write</type>
                    <table>default.prom_missing</table>
                </handler>
            </missing_write>
            <keyless_write>
                <url>/keyless/write</url>
                <handler>
                    <type>write</type>
                    <table>default.prom_dist_keyless</table>
                </handler>
            </keyless_write>
            <!-- The same shard shape over a cluster entry whose user holds only the shard databases. -->
            <restricted_write>
                <url>/restricted/write</url>
                <handler>
                    <type>write</type>
                    <table>default.prom_restricted</table>
                </handler>
            </restricted_write>
            <!-- The same shard shape over a cluster entry whose user holds only a column-level INSERT. -->
            <column_granted_write>
                <url>/column_granted/write</url>
                <handler>
                    <type>write</type>
                    <table>default.prom_column_granted</table>
                </handler>
            </column_granted_write>
            <!-- The decoy over those same credentials, which only the shard's own insert can refuse. -->
            <column_granted_bad_write>
                <url>/column_granted_bad/write</url>
                <handler>
                    <type>write</type>
                    <table>default.prom_column_granted_bad</table>
                </handler>
            </column_granted_bad_write>
            <!-- Wrappers retyped away from the outer schema of a TimeSeries table, and one declaring it. -->
            <retyped_name_write>
                <url>/retyped_name/write</url>
                <handler>
                    <type>write</type>
                    <table>default.prom_retyped_name</table>
                </handler>
            </retyped_name_write>
            <retyped_metadata_write>
                <url>/retyped_metadata/write</url>
                <handler>
                    <type>write</type>
                    <table>default.prom_retyped_metadata</table>
                </handler>
            </retyped_metadata_write>
            <retyped_ok_write>
                <url>/retyped_ok/write</url>
                <handler>
                    <type>write</type>
                    <table>default.prom_retyped_ok</table>
                </handler>
            </retyped_ok_write>
            <dist_query>
                <url>/api/v1/query</url>
                <handler>
                    <type>query</type>
                    <table>default.prom_dist</table>
                </handler>
            </dist_query>
            <!-- The read side of that same restricted cluster entry. -->
            <restricted_query>
                <url>/restricted_api/v1/query</url>
                <handler>
                    <type>query</type>
                    <table>default.prom_restricted</table>
                </handler>
            </restricted_query>
        </handlers>
    </prometheus>
</clickhouse>

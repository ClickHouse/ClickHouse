<clickhouse>
    <prometheus>
        <port>9093</port>
        <handlers>
            <my_rule_1>
                <url>/write</url>
                <handler>
                    <type>write</type>
                    <table>default.prometheus</table>
                </handler>
            </my_rule_1>
            <my_rule_1_dynamic>
                <url>regex:^/[^/]+/[^/]+/write$</url>
                <handler>
                    <type>remote_write</type>
                    <enable_table_name_url_routing>true</enable_table_name_url_routing>
                </handler>
            </my_rule_1_dynamic>
            <my_rule_1_dynamic_api_v1>
                <url>regex:^/[^/]+/[^/]+/api/v1/write$</url>
                <handler>
                    <type>prometheus_api_v1</type>
                    <enable_table_name_url_routing>true</enable_table_name_url_routing>
                </handler>
            </my_rule_1_dynamic_api_v1>
            <my_rule_1_dynamic_api_v1_query>
                <url>regex:^/[^/]+/[^/]+/api/v1/query$</url>
                <handler>
                    <type>prometheus_api_v1</type>
                    <enable_table_name_url_routing>true</enable_table_name_url_routing>
                </handler>
            </my_rule_1_dynamic_api_v1_query>
            <!-- A misconfigured handler that enables URL path routing on the legacy fixed-prefix
                 `/prometheus/api/v1` shape. A request to `/prometheus/api/v1/write` must be rejected
                 (the path does not match `/{database}/{table}/api/v1/write`) instead of being silently
                 reinterpreted as database `prometheus`, table `api`. -->
            <my_rule_1_legacy_prefix_routing>
                <url>/prometheus/api/v1/write</url>
                <handler>
                    <type>prometheus_api_v1</type>
                    <enable_table_name_url_routing>true</enable_table_name_url_routing>
                </handler>
            </my_rule_1_legacy_prefix_routing>
            <my_rule_1_dynamic_query_params>
                <url>/write_query_params</url>
                <handler>
                    <type>remote_write</type>
                </handler>
            </my_rule_1_dynamic_query_params>
            <my_rule_2>
                <url>/read</url>
                <handler>
                    <type>read</type>
                    <table>default.prometheus</table>
                </handler>
            </my_rule_2>

            <my_rule_3>
                <url>/read_auth_ok</url>
                <handler>
                    <type>read</type>
                    <table>default.prometheus</table>
                    <user>default</user>
                </handler>
            </my_rule_3>

            <my_rule_4>
                <url>/read_auth_fail</url>
                <handler>
                    <type>read</type>
                    <table>default.prometheus</table>
                    <user>no_such_user</user>
                </handler>
            </my_rule_4>

            <!-- Query and metadata endpoints of the Prometheus HTTP API -->
            <my_rule_5>
                <url>/api/v1/query</url>
                <handler>
                    <type>query</type>
                    <table>default.prometheus</table>
                </handler>
            </my_rule_5>
            <my_rule_6>
                <url>/api/v1/query_range</url>
                <handler>
                    <type>query</type>
                    <table>default.prometheus</table>
                </handler>
            </my_rule_6>
            <my_rule_7>
                <url>/api/v1/series</url>
                <handler>
                    <type>query</type>
                    <table>default.prometheus</table>
                </handler>
            </my_rule_7>
            <my_rule_8>
                <url>/api/v1/labels</url>
                <handler>
                    <type>query</type>
                    <table>default.prometheus</table>
                </handler>
            </my_rule_8>
            <my_rule_9>
                <url>/api/v1/label/*/values</url>
                <handler>
                    <type>query</type>
                    <table>default.prometheus</table>
                </handler>
            </my_rule_9>
            <my_rule_13>
                <url>/api/v1/metadata</url>
                <handler>
                    <type>query</type>
                    <table>default.prometheus</table>
                </handler>
            </my_rule_13>
            <!-- A table which never gets any metrics metadata: /api/v1/metadata must return an empty result for it. -->
            <my_rule_14>
                <url>/empty/api/v1/metadata</url>
                <handler>
                    <type>query</type>
                    <table>default.prometheus_empty</table>
                </handler>
            </my_rule_14>
            <!-- A table with a metric family having multiple metadata entries: for testing limit_per_metric. -->
            <my_rule_15>
                <url>/multi/api/v1/metadata</url>
                <handler>
                    <type>query</type>
                    <table>default.prometheus_multi</table>
                </handler>
            </my_rule_15>

            <my_rule_10>
                <!-- This handler sets no database and no table, so both database and table names
                     come from the query parameters. -->
                <url>/dynamic_table/api/v1/query</url>
                <handler>
                    <type>query_api</type>
                </handler>
            </my_rule_10>

            <my_rule_11>
                <!-- This handler sets only database, so the table name comes from the query parameters. -->
                <url>/dynamic_table_and_fixed_db/api/v1/query</url>
                <handler>
                    <type>query_api</type>
                    <database>default</database>
                </handler>
            </my_rule_11>

            <!-- Table without min_time/max_time columns: /api/v1/series must ignore the time range for it. -->
            <my_rule_12>
                <url_prefix>/no_bounds</url_prefix>
                <handler>
                    <type>query</type>
                    <table>default.prometheus_no_bounds</table>
                </handler>
            </my_rule_12>
        </handlers>
    </prometheus>
</clickhouse>

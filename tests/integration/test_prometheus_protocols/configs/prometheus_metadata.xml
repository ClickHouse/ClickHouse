<clickhouse>
    <http_options_response>
        <header>
            <name>Access-Control-Allow-Origin</name>
            <value>https://example.test</value>
        </header>
    </http_options_response>
    <prometheus>
        <port>9093</port>
        <handlers>
            <metadata>
                <url>/api/v1/metadata</url>
                <handler>
                    <type>query</type>
                    <table>default.prometheus</table>
                </handler>
            </metadata>
            <external_metadata>
                <url>/external/api/v1/metadata</url>
                <handler>
                    <type>query</type>
                    <table>default.external_prometheus</table>
                </handler>
            </external_metadata>
            <nullable_metadata>
                <url>/nullable/api/v1/metadata</url>
                <handler>
                    <type>query</type>
                    <table>default.nullable_prometheus</table>
                </handler>
            </nullable_metadata>
            <wrapped_metadata>
                <url>/wrapped/api/v1/metadata</url>
                <handler>
                    <type>query</type>
                    <table>default.wrapped_prometheus</table>
                </handler>
            </wrapped_metadata>
            <distributed_plain_metadata>
                <url>/distributed-plain/api/v1/metadata</url>
                <handler>
                    <type>query</type>
                    <table>default.distributed_plain_prometheus</table>
                </handler>
            </distributed_plain_metadata>
            <high_card_metadata>
                <url>/high-card/api/v1/metadata</url>
                <handler>
                    <type>query</type>
                    <table>default.high_card_prometheus</table>
                </handler>
            </high_card_metadata>
            <pruning_metadata>
                <url>/pruning/api/v1/metadata</url>
                <handler>
                    <type>query</type>
                    <table>default.pruning_prometheus</table>
                </handler>
            </pruning_metadata>
            <query>
                <url>/api/v1/query</url>
                <handler>
                    <type>query</type>
                    <table>default.prometheus</table>
                </handler>
            </query>
            <custom_query>
                <url>/custom/query</url>
                <handler>
                    <type>query</type>
                    <table>default.prometheus</table>
                </handler>
            </custom_query>
            <api_v1>
                <url_prefix>/combined/api/v1</url_prefix>
                <handler>
                    <type>api_v1</type>
                    <table>default.prometheus</table>
                </handler>
            </api_v1>
            <api_v1_custom_prefix>
                <url_prefix>/custom_api</url_prefix>
                <handler>
                    <type>api_v1</type>
                    <table>default.prometheus</table>
                </handler>
            </api_v1_custom_prefix>
            <malformed_label_values>
                <url>/values</url>
                <handler>
                    <type>query</type>
                    <table>default.prometheus</table>
                </handler>
            </malformed_label_values>
            <api_v1_root>
                <url_prefix>/</url_prefix>
                <url_regexp>^/(query|metadata|write|read)$</url_regexp>
                <handler>
                    <type>api_v1</type>
                    <table>default.prometheus</table>
                </handler>
            </api_v1_root>
        </handlers>
    </prometheus>
</clickhouse>

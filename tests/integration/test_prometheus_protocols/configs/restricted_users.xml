<clickhouse>
    <users>
        <!-- Everything except SELECT: the read surfaces must refuse this user before they
             disclose anything about the target table. -->
        <prom_no_select>
            <password></password>
            <profile>default</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT INSERT ON *.*</query>
            </grants>
        </prom_no_select>
        <!-- Everything except INSERT: remote write must refuse this user. SELECT is granted on
             every database so the read surfaces work through the shards as well. -->
        <prom_no_insert>
            <password></password>
            <profile>default</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON *.*</query>
            </grants>
        </prom_no_insert>
    </users>
</clickhouse>

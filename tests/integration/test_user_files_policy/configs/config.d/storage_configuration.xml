<clickhouse>
    <storage_configuration>
        <disks>
            <user_files_disk1>
                <path>/test_user_files_disk1/</path>
            </user_files_disk1>
        </disks>

        <policies>
            <user_files_local>
                <volumes>
                    <main>
                        <disk>user_files_disk1</disk>
                    </main>
                </volumes>
            </user_files_local>
        </policies>
    </storage_configuration>

    <user_files_policy>user_files_local</user_files_policy>

    <!-- With `user_files_policy`, `user_files_path` is a path inside the disk of the policy.
         The base config sets it to `/var/lib/clickhouse/user_files/`, so point it at the disk root. -->
    <user_files_path>/</user_files_path>
</clickhouse>

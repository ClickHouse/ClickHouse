<clickhouse>
    <remote_servers>
        <default>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>shared1</host>
                    <port>9000</port>
                </replica>
                <replica>
                    <host>shared2</host>
                    <port>9000</port>
                </replica>
            </shard>
        </default>
    </remote_servers>
    <user_directories replace="replace">
        <users_xml>
            <path>users.xml</path>
        </users_xml>
        <replicated>
            <zookeeper_path>/clickhouse/access</zookeeper_path>
        </replicated>
        <local_directory>
            <path>/var/lib/clickhouse/access_local/</path>
        </local_directory>
    </user_directories>
</clickhouse>

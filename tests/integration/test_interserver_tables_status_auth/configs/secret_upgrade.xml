<clickhouse>
    <!-- Shared by the old-version initiator and the current-build node of the rolling-upgrade
         test, so the initiator signs its query with the same secret the new node validates. -->
    <remote_servers>
        <upgrade>
            <secret>secret_upgrade</secret>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>node_new</host><port>9000</port></replica>
            </shard>
        </upgrade>
        <!-- Same shape, but the replica (`node_a`) enables
             `interserver_tables_status_require_auth`; see `configs/secret_a.xml`. -->
        <upgrade_strict>
            <secret>secret_upgrade</secret>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>node_a</host><port>9000</port></replica>
            </shard>
        </upgrade_strict>
    </remote_servers>
</clickhouse>

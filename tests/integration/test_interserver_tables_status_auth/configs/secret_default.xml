<clickhouse>
    <!-- No `interserver_tables_status_require_auth` override: exercises the default, where an
         unauthenticated `TablesStatusRequest` gets a placeholder response instead of an error. -->
    <remote_servers>
        <mismatch>
            <secret>secret_a</secret>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>node_b</host><port>9000</port></replica>
            </shard>
        </mismatch>
    </remote_servers>
</clickhouse>

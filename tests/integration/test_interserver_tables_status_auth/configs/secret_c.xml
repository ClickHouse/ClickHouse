<clickhouse>
    <!-- An unsigned interserver `TablesStatusRequest` is not rejected here, so it reaches the
         deserialization step that `MAX_TABLES_IN_INTERSERVER_STATUS_REQUEST` bounds. -->
    <interserver_tables_status_require_auth>0</interserver_tables_status_require_auth>
    <remote_servers>
        <!-- The interserver Hello names this cluster, which must exist and have a secret for the
             handshake to be accepted into interserver mode. -->
        <mismatch>
            <secret>secret_c</secret>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>node_c</host><port>9000</port></replica>
            </shard>
        </mismatch>
    </remote_servers>
</clickhouse>

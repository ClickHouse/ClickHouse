<clickhouse>
    <interserver_tables_status_require_auth>1</interserver_tables_status_require_auth>
    <remote_servers>
        <mismatch>
            <secret>secret_a</secret>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>node_b</host><port>9000</port></replica>
            </shard>
        </mismatch>
        <!-- Serves the strict-mode half of the rolling-upgrade test: this node has
             `interserver_tables_status_require_auth` enabled, which is what the server used to
             do by default, so an old initiator reading over this cluster must fail. -->
        <upgrade_strict>
            <secret>secret_upgrade</secret>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>node_a</host><port>9000</port></replica>
            </shard>
        </upgrade_strict>
    </remote_servers>
</clickhouse>

<clickhouse>
    <dictionary>
        <name>proj_dict</name>
        <source>
            <file>
                <path>/var/lib/clickhouse/user_files/proj_dict.csv</path>
                <format>CSVWithNames</format>
            </file>
        </source>
        <!-- Never reload: the test asserts on whether the dictionary resolves at startup, not on updates -->
        <lifetime>0</lifetime>
        <layout>
            <flat/>
        </layout>
        <structure>
            <id>
                <name>key</name>
            </id>
            <attribute>
                <name>val</name>
                <type>UInt64</type>
                <null_value>0</null_value>
            </attribute>
        </structure>
    </dictionary>
</clickhouse>

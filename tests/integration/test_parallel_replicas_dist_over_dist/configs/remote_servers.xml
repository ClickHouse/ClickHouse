<clickhouse>
    <remote_servers>
        <!-- Two data clusters, each a single shard of two replicas, holding the `ReplicatedMergeTree`
             tables. These are the only clusters parallel replicas can run on, since a `Distributed`
             table is never itself eligible for them. -->
        <default_cluster>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>n1</host><port>9000</port></replica>
                <replica><host>n2</host><port>9000</port></replica>
            </shard>
        </default_cluster>
        <inner_cluster>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>n3</host><port>9000</port></replica>
                <replica><host>n4</host><port>9000</port></replica>
            </shard>
        </inner_cluster>
        <!-- The outer cluster joins the two data clusters: one shard per cluster, addressed through a
             single server of it, which holds the `Distributed` table over that cluster. Every shard
             here has one replica, so parallel replicas cannot be used for this hop - but the hop below
             it reads a two-replica cluster and must still use them. -->
        <outer_cluster>
            <shard>
                <internal_replication>false</internal_replication>
                <replica><host>n1</host><port>9000</port></replica>
            </shard>
            <shard>
                <internal_replication>false</internal_replication>
                <replica><host>n3</host><port>9000</port></replica>
            </shard>
        </outer_cluster>
    </remote_servers>
</clickhouse>

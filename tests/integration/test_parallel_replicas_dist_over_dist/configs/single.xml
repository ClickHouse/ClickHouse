<clickhouse>
    <remote_servers>
        <!-- An instance of one node, under the same `default` name. Its single replica means parallel
             replicas cannot be used for its read at all, which is the other half of the contract. -->
        <default>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>n6</host><port>9000</port></replica>
            </shard>
        </default>
    </remote_servers>
</clickhouse>

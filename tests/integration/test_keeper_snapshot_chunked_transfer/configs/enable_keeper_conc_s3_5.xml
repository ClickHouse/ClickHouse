<clickhouse>

<storage_configuration>
    <disks>
        <keeper_snap_s3>
            <type>s3_plain</type>
            <endpoint>http://minio1:9001/root/keeper-snapshots/node_concs5/</endpoint>
            <access_key_id>minio</access_key_id>
            <secret_access_key>ClickHouse_Minio_P@ssw0rd</secret_access_key>
        </keeper_snap_s3>
    </disks>
</storage_configuration>
    <keeper_server>
        <snapshot_storage_disk>keeper_snap_s3</snapshot_storage_disk>
        <tcp_port>9181</tcp_port>
        <server_id>5</server_id>

        <coordination_settings>
            <operation_timeout_ms>5000</operation_timeout_ms>
            <session_timeout_ms>10000</session_timeout_ms>
            <raft_logs_level>trace</raft_logs_level>
            <snapshot_distance>50</snapshot_distance>
            <stale_log_gap>10</stale_log_gap>
            <reserved_log_items>1</reserved_log_items>
            <snapshot_transfer_chunk_size>4096</snapshot_transfer_chunk_size>
        </coordination_settings>

        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>node_concs1</hostname>
                <port>9234</port>
                <can_become_leader>true</can_become_leader>
                <priority>70</priority>
            </server>
            <server>
                <id>2</id>
                <hostname>node_concs2</hostname>
                <port>9234</port>
                <can_become_leader>true</can_become_leader>
                <start_as_follower>true</start_as_follower>
                <priority>20</priority>
            </server>
            <server>
                <id>3</id>
                <hostname>node_concs3</hostname>
                <port>9234</port>
                <can_become_leader>true</can_become_leader>
                <start_as_follower>true</start_as_follower>
                <priority>10</priority>
            </server>
            <server>
                <id>4</id>
                <hostname>node_concs4</hostname>
                <port>9234</port>
                <can_become_leader>true</can_become_leader>
                <start_as_follower>true</start_as_follower>
                <priority>5</priority>
            </server>
            <server>
                <id>5</id>
                <hostname>node_concs5</hostname>
                <port>9234</port>
                <can_become_leader>true</can_become_leader>
                <start_as_follower>true</start_as_follower>
                <priority>3</priority>
            </server>
        </raft_configuration>
    </keeper_server>
</clickhouse>

<clickhouse>
    <storage_configuration>
        <disks>
            <broken_s3>
                <type>s3</type>
                <endpoint>http://resolver:8087/root/data/</endpoint>
                <access_key_id>minio</access_key_id>
                <secret_access_key>ClickHouse_Minio_P@ssw0rd</secret_access_key>
                <skip_access_check>1</skip_access_check>
                <!-- A budget the test could exhaust would make the oracle a wall-clock race. -->
                <s3_max_single_read_retries>1000000</s3_max_single_read_retries>
                <s3_retry_attempts>1000000</s3_retry_attempts>
            </broken_s3>
            <!-- Writes every file larger than about 10 MiB as a multipart upload, in parts of the
                 smallest size MinIO accepts. A separate prefix, so that the incomplete uploads of the
                 tests that use it can be listed. -->
            <broken_s3_multipart>
                <type>s3</type>
                <endpoint>http://resolver:8087/root/data_multipart/</endpoint>
                <access_key_id>minio</access_key_id>
                <secret_access_key>ClickHouse_Minio_P@ssw0rd</secret_access_key>
                <skip_access_check>1</skip_access_check>
                <s3_max_single_part_upload_size>5242880</s3_max_single_part_upload_size>
                <s3_min_upload_part_size>5242880</s3_min_upload_part_size>
            </broken_s3_multipart>
        </disks>
        <policies>
            <broken_s3>
                <volumes><main><disk>broken_s3</disk></main></volumes>
            </broken_s3>
            <broken_s3_multipart>
                <volumes><main><disk>broken_s3_multipart</disk></main></volumes>
            </broken_s3_multipart>
        </policies>
    </storage_configuration>
</clickhouse>

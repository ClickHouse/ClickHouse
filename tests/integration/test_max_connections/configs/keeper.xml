<clickhouse>
    <!-- Its Keeper session would take a thread of the main pool for the whole test. -->
    <distributed_ddl remove="1"/>
    <!-- A shutdown that waits for a connection gives up before the Keeper sessions of the test expire. -->
    <shutdown_wait_unfinished>5</shutdown_wait_unfinished>

    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>node</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>
</clickhouse>

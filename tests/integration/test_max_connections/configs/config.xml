<clickhouse>
    <max_connections>2</max_connections>
    <listen_backlog>1</listen_backlog>
    <!-- Raw connections that send nothing keep their handler thread for the whole test. -->
    <handshake_timeout_milliseconds>120000</handshake_timeout_milliseconds>
    <!-- Served by a pool of its own, so it answers while the threads of the main pool are busy. -->
    <protocols>
        <introspection_native>
            <type>tcp</type>
            <introspection>true</introspection>
            <port>9010</port>
        </introspection_native>
    </protocols>
</clickhouse>

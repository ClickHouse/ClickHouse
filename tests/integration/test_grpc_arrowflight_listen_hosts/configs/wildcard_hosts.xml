<clickhouse>
    <!-- The wildcard follows a specific address and precedes another one, covering both orders of
         mixed wildcard/specific `listen_host` entries. -->
    <listen_host>127.0.0.1</listen_host>
    <listen_host>0.0.0.0</listen_host>
    <listen_host>::1</listen_host>

    <!-- Plain sockets can overlap in this configuration, which must stay a warning instead of a
         startup failure. -->
    <listen_try>1</listen_try>

    <grpc_port>9100</grpc_port>
    <arrowflight_port>8888</arrowflight_port>
</clickhouse>

<?xml version="1.0"?>
<clickhouse>
    <storage_configuration>
        <disks>
            <s3_disk>
                <type>s3</type>
                <endpoint>http://minio1:9001/root/data/</endpoint>
                <access_key_id>minio</access_key_id>
                <secret_access_key>ClickHouse_Minio_P@ssw0rd</secret_access_key>
                <persistent_removal_log>true</persistent_removal_log>
            </s3_disk>
            <local_plain_disk>
                <type>local</type>
                <path>/var/lib/clickhouse/uk_sst_plain/</path>
            </local_plain_disk>
            <encrypted_disk>
                <type>encrypted</type>
                <disk>local_plain_disk</disk>
                <path>encrypted/</path>
                <key>1234567812345678</key>
            </encrypted_disk>
            <uk_plain_rewritable>
                <type>object_storage</type>
                <object_storage_type>local</object_storage_type>
                <path>/var/lib/clickhouse/disks/uk_plain_rewritable/</path>
                <metadata_type>plain_rewritable</metadata_type>
            </uk_plain_rewritable>
        </disks>
        <policies>
            <!-- Extends the built-in `default` policy so a UNIQUE KEY table can
                 be switched to S3 via `MODIFY SETTING storage_policy`. This is
                 the only supported route: UK tables reject `ALTER ... PARTITION`
                 (so no `MOVE PARTITION`), and `MODIFY SETTING disk` resolves to
                 a single-disk temp policy that fails checkCompatibleWith.
                 The policy therefore must (a) keep a `default` volume/disk so
                 checkCompatibleWith accepts it, and (b) put the S3 volume first
                 so *new* inserts land on S3. `move_factor = 0` disables
                 background moves. -->
            <s3_extending>
                <volumes>
                    <s3>
                        <disk>s3_disk</disk>
                    </s3>
                    <default>
                        <disk>default</disk>
                    </default>
                </volumes>
                <move_factor>0.0</move_factor>
            </s3_extending>
            <plain_rewritable_extending>
                <volumes>
                    <plain_rewritable>
                        <disk>uk_plain_rewritable</disk>
                    </plain_rewritable>
                    <default>
                        <disk>default</disk>
                    </default>
                </volumes>
                <move_factor>0.0</move_factor>
            </plain_rewritable_extending>
            <uk_reload>
                <volumes>
                    <!-- uk_reload_extra_volume -->
                    <default>
                        <disk>default</disk>
                    </default>
                </volumes>
                <move_factor>0.0</move_factor>
            </uk_reload>
        </policies>
    </storage_configuration>
</clickhouse>

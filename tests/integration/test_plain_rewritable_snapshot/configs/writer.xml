        <policies>
            <snapshot>
                <volumes>
                    <main>
                        <disk>disk_snapshot</disk>
                    </main>
                </volumes>
            </snapshot>
            <snapshot_delayed>
                <volumes>
                    <main>
                        <disk>disk_snapshot_delayed</disk>
                    </main>
                </volumes>
            </snapshot_delayed>
            <no_snapshot>
                <volumes>
                    <main>
                        <disk>disk_no_snapshot</disk>
                    </main>
                </volumes>

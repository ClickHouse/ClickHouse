<clickhouse>
    <users>
        <default remove="remove">
        </default>
        <admin>
            <password>qwerty</password>
            <access_management>1</access_management>
            <readonly>0</readonly>
        </admin>
        <!-- Local `janedoe` exists in `users.xml`, and a remote `janedoe` exists in
             the LDAP fixture. The test asserts EXECUTE AS picks the local one. The
             local user is granted `local_only_role` defined at runtime, which is the
             property the precedence-preservation test verifies. -->
        <janedoe>
            <password>local_password</password>
            <access_management>0</access_management>
            <readonly>0</readonly>
            <!-- Tells this principal apart from the LDAP `janedoe` after `EXECUTE AS`. -->
            <profile>local_janedoe_profile</profile>
        </janedoe>
        <!-- Same name as an LDAP user the handoff test materialises then deletes from the directory; its
             profile shows that `EXECUTE AS` fell through to this local user once the directory refused the
             cached LDAP entry. -->
        <handoff>
            <password>local_password</password>
            <access_management>0</access_management>
            <readonly>0</readonly>
            <profile>handoff_profile</profile>
        </handoff>
    </users>
    <profiles>
        <local_janedoe_profile>
            <max_result_rows>12345</max_result_rows>
        </local_janedoe_profile>
        <handoff_profile>
            <max_result_rows>54321</max_result_rows>
        </handoff_profile>
    </profiles>
</clickhouse>

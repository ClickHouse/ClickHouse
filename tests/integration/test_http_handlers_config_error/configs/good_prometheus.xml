<clickhouse>
    <prometheus>
        <port>9363</port>
        <handlers>
            <my_metrics>
                <url>/metrics</url>
                <handler>
                    <type>expose_metrics</type>
                    <metrics>true</metrics>
                    <events>true</events>
                    <asynchronous_metrics>true</asynchronous_metrics>
                </handler>
            </my_metrics>
        </handlers>
    </prometheus>
</clickhouse>

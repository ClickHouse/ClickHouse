<clickhouse>
    <max_server_memory_usage>2000000000</max_server_memory_usage>
    <memory_worker_use_cgroup>false</memory_worker_use_cgroup>
    <cgroups_memory_usage_observer_wait_time>0</cgroups_memory_usage_observer_wait_time>
    <!-- The test fills the memory tracker up to a known headroom with SYSTEM ALLOCATE MEMORY, and
         still needs to run its own small queries against the nearly-full server. -->
    <allow_system_allocate_memory>1</allow_system_allocate_memory>
    <users_to_ignore_early_memory_limit_check>default</users_to_ignore_early_memory_limit_check>
</clickhouse>

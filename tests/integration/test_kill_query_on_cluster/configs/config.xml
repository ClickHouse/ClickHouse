<clickhouse>
    <!-- 0 is the default; it is written out so the hardened arm can flip it with replace_in_config. -->
    <distributed_ddl_use_initial_user_and_roles>0</distributed_ddl_use_initial_user_and_roles>
    <remote_servers>
        <default>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>node1</host>
                    <port>9000</port>
                </replica>
                <replica>
                    <host>node2</host>
                    <port>9000</port>
                </replica>
            </shard>
        </default>
    </remote_servers>
    <!-- Replicated storage so a user created on node1 exists on node2 as well. -->
    <user_directories replace="replace">
        <replicated>
            <zookeeper_path>/clickhouse/access</zookeeper_path>
        </replicated>
    </user_directories>
</clickhouse>

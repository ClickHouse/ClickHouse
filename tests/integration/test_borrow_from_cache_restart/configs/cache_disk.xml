<clickhouse>
    <storage_configuration>
        <disks>
            <!-- Registers the filesystem cache `borrowed_cache` that the borrow_from_cache disk
                 references by name. Removing this file before a restart makes the cache absent,
                 reproducing the load-order race that a restart can otherwise hit. -->
            <borrowed_cache>
                <type>cache</type>
                <disk>obj_local</disk>
                <path>borrowed_cache/</path>
                <max_size>104857600</max_size>
                <load_metadata_asynchronously>0</load_metadata_asynchronously>
            </borrowed_cache>

            <!-- A borrow_from_cache disk defined in the configuration, so that it is registered
                 before table loading starts: engines that take a disk directly (the log family)
                 can only reference a disk by name, and a custom DDL disk defined inline by another
                 table is not registered yet when such a table is attached.
                 It lives in this file (and not in base.xml) on purpose: removing this file to make
                 the cache absent must remove the disk referencing it as well, otherwise startup
                 would abort on the missing cache instead of exercising the read-only path. -->
            <borrowed_cfg>
                <type>object_storage</type>
                <object_storage_type>borrow_from_cache</object_storage_type>
                <metadata_type>memory</metadata_type>
                <cache_name>borrowed_cache</cache_name>
            </borrowed_cfg>
        </disks>
    </storage_configuration>
</clickhouse>

<clickhouse>
    <enable_system_unfreeze>true</enable_system_unfreeze>
    <filesystem_caches_path>/var/lib/clickhouse/filesystem_caches/</filesystem_caches_path>
    <custom_cached_disks_base_directory>/var/lib/clickhouse/custom_cached/</custom_cached_disks_base_directory>
    <custom_local_disks_base_directory>/var/lib/clickhouse/custom_local/</custom_local_disks_base_directory>

    <storage_configuration>
        <disks>
            <obj_local>
                <type>object_storage</type>
                <object_storage_type>local</object_storage_type>
                <path>obj_local/</path>
            </obj_local>

            <!-- A borrow_from_cache disk defined in the configuration, so that it is registered
                 before table loading starts: engines that take a disk directly (the log family)
                 can only reference a disk by name, and a custom DDL disk defined inline by another
                 table is not registered yet when such a table is attached.
                 It deliberately lives in this persistent file while the cache it references is
                 registered by the removable cache_disk.xml: removing only the cache must leave the
                 server able to start, bringing this disk up with data writes blocked instead of
                 aborting on the missing cache. -->
            <borrowed_cfg>
                <type>object_storage</type>
                <object_storage_type>borrow_from_cache</object_storage_type>
                <metadata_type>memory</metadata_type>
                <cache_name>borrowed_cache</cache_name>
            </borrowed_cfg>
        </disks>
    </storage_configuration>
</clickhouse>

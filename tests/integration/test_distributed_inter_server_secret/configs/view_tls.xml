<clickhouse>
    <tcp_port_secure>9440</tcp_port_secure>
    <openSSL replace="replace">
        <server>
            <certificateFile>/etc/clickhouse-server/config.d/server-cert.pem</certificateFile>
            <privateKeyFile>/etc/clickhouse-server/config.d/server-key.pem</privateKeyFile>
            <verificationMode>none</verificationMode>
        </server>
        <client>
            <caConfig>/etc/clickhouse-server/config.d/ca-cert.pem</caConfig>
            <verificationMode>strict</verificationMode>
            <!-- The delegation check must verify the name even when ordinary connections skip that check. -->
            <extendedVerification>false</extendedVerification>
        </client>
    </openSSL>
    <remote_servers>
        <view_tls>
            <secret>test_secret</secret>
            <shard>
                <replica>
                    <host>integration-tests.clickhouse.com</host>
                    <port>9440</port>
                    <secure>1</secure>
                </replica>
            </shard>
        </view_tls>
        <view_tls_wrong_name>
            <secret>test_secret</secret>
            <shard>
                <replica>
                    <host>n2</host>
                    <port>9440</port>
                    <secure>1</secure>
                </replica>
            </shard>
        </view_tls_wrong_name>
    </remote_servers>
</clickhouse>

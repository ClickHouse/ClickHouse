<clickhouse>
    <storage_configuration>
        <disks>
            <obj_local>
                <type>object_storage</type>
                <object_storage_type>local</object_storage_type>
                <path>obj_local/</path>
            </obj_local>
            <borrowed_cache>
                <type>cache</type>
                <disk>obj_local</disk>
                <path>borrowed_cache/</path>
                <max_size>104857600</max_size>
                <load_metadata_asynchronously>0</load_metadata_asynchronously>
            </borrowed_cache>
            <borrowed_disk>
                <type>object_storage</type>
                <object_storage_type>borrow_from_cache</object_storage_type>
                <cache_name>borrowed_cache</cache_name>
            </borrowed_disk>
            <borrowed_disk_ro>
                <type>object_storage</type>
                <object_storage_type>borrow_from_cache</object_storage_type>
                <cache_name>borrowed_cache</cache_name>
                <read_only>1</read_only>
            </borrowed_disk_ro>
        </disks>
        <policies>
            <borrowed_policy>
                <volumes>
                    <main>
                        <disk>borrowed_disk</disk>
                    </main>
                </volumes>
            </borrowed_policy>
            <borrowed_policy_ro>
                <volumes>
                    <main>
                        <disk>borrowed_disk_ro</disk>
                    </main>
                </volumes>
            </borrowed_policy_ro>
        </policies>
    </storage_configuration>

    <remote_servers>
        <test_cluster>
            <shard>
                <replica>
                    <host>not_existing</host>
                    <port>9000</port>
                </replica>
            </shard>
        </test_cluster>
    </remote_servers>
</clickhouse>

<clickhouse>
    <profiles>
        <default>
            <allow_experimental_pulsar_storage_engine>1</allow_experimental_pulsar_storage_engine>
            <stream_like_engine_allow_direct_select>1</stream_like_engine_allow_direct_select>
            <!-- Smaller than the number of consumers of the table created in the test, so that the
                 default block size derived as `max_insert_block_size / pulsar_num_consumers`
                 rounds down to zero unless it is clamped. -->
            <max_insert_block_size>2</max_insert_block_size>
        </default>
    </profiles>
</clickhouse>

<clickhouse>
    <storage_configuration>
        <disks>
            <jbod1>
                <path>/var/lib/clickhouse/jbod1/</path>
            </jbod1>
            <jbod2>
                <path>/var/lib/clickhouse/jbod2/</path>
            </jbod2>
            <jbod3>
                <path>/var/lib/clickhouse/jbod3/</path>
            </jbod3>
            <jbod4>
                <path>/var/lib/clickhouse/jbod4/</path>
            </jbod4>
        </disks>
        <policies>
            <jbod4>
                <volumes>
                    <main>
                        <disk>jbod1</disk>
                        <disk>jbod2</disk>
                        <disk>jbod3</disk>
                        <disk>jbod4</disk>
                    </main>
                </volumes>
            </jbod4>
        </policies>
    </storage_configuration>
</clickhouse>

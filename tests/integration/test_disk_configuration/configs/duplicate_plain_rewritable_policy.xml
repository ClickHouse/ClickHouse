<clickhouse>
    <storage_configuration>
        <disks>
            <!-- Both disks keep their objects under one local directory. Their `key_compatibility_prefix` differ, so do
                 their `getPath`, but `plain_rewritable` metadata lists and addresses the objects under the common key
                 prefix of the object storage, which is the same for both. The second disk is read-only, as the
                 registration of the disks already rejects two writable plain disks over one prefix. -->
            <plain_rewritable_compat_a>
                <type>object_storage</type>
                <object_storage_type>local</object_storage_type>
                <metadata_type>plain_rewritable</metadata_type>
                <path>/var/lib/clickhouse/disks/shared_plain_rewritable/</path>
                <key_compatibility_prefix>compat_a/</key_compatibility_prefix>
            </plain_rewritable_compat_a>
            <plain_rewritable_compat_b>
                <type>object_storage</type>
                <object_storage_type>local</object_storage_type>
                <metadata_type>plain_rewritable</metadata_type>
                <path>/var/lib/clickhouse/disks/shared_plain_rewritable/</path>
                <key_compatibility_prefix>compat_b/</key_compatibility_prefix>
                <read_only>true</read_only>
            </plain_rewritable_compat_b>
        </disks>
        <policies>
            <plain_rewritable_compat_prefix_alias>
                <volumes>
                    <a>
                        <disk>plain_rewritable_compat_a</disk>
                    </a>
                    <b>
                        <disk>plain_rewritable_compat_b</disk>
                    </b>
                </volumes>
            </plain_rewritable_compat_prefix_alias>
        </policies>
    </storage_configuration>
</clickhouse>

<clickhouse>
    <storage_configuration>
        <disks>
            <!-- Same bucket and prefix as `s3_plain_bucket_root`, so the two disks share a storage namespace. -->
            <s3_plain_bucket_root_alias>
                <type>s3_plain</type>
                <endpoint>http://minio1:9001/root/data/disks/shared_plain/</endpoint>
                <access_key_id>minio</access_key_id>
                <secret_access_key>ClickHouse_Minio_P@ssw0rd</secret_access_key>
                <readonly>true</readonly>
            </s3_plain_bucket_root_alias>
        </disks>
        <policies>
            <object_storage_same_bucket>
                <volumes>
                    <original>
                        <disk>s3_plain_bucket_root</disk>
                    </original>
                    <alias>
                        <disk>s3_plain_bucket_root_alias</disk>
                    </alias>
                </volumes>
            </object_storage_same_bucket>
        </policies>
    </storage_configuration>
</clickhouse>

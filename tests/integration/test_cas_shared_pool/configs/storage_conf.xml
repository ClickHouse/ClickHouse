<clickhouse>
    <storage_configuration>
        <disks>
            <disk_cas_shared>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>cas</metadata_type>
                <!-- A single shared bucket path. BOTH servers load this same config, so they mount
                     the SAME pool (the bucket is the single source of truth; no Keeper). -->
                <!-- RustFS (not MinIO): the CA mount capability probe requires enforced conditional-DELETE
                     semantics (CasProbe step 6); MinIO OSS silently honors a mismatched-token DELETE and the
                     fail-closed probe aborts server startup (PR#2073 CI triage). -->
                <endpoint>http://rustfs1:11121/test/shared_pool/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse</secret_access_key>
                <!-- Two servers mounting one pool: this acknowledgement is mandatory; without it the
                     second mounter refuses to attach (see PoolMeta ownership check). -->
                <!-- Background reachability GC enabled on BOTH servers, running aggressively so a
                     sweep happens during the test. The grace window must be short enough to reclaim
                     within the test, but the sweep must NOT reclaim a blob the OTHER server's live
                     part still references. -->
                <gc_enabled>1</gc_enabled>
                <gc_interval_sec>1</gc_interval_sec>
            </disk_cas_shared>
        </disks>
        <policies>
            <cas_shared>
                <volumes>
                    <main>
                        <disk>disk_cas_shared</disk>
                    </main>
                </volumes>
            </cas_shared>
        </policies>
    </storage_configuration>
</clickhouse>

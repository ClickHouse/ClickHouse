<clickhouse>
    <logger>
        <level>trace</level>
        <console>1</console>
    </logger>

    <tcp_port>9101</tcp_port>
    <listen_host>0.0.0.0</listen_host>

    <upstreams>
        <clusters>
            <cluster_a>
                <!-- The replica intentionally omits <tcp_port>; the proxy must reject this at startup. -->
                <replica>
                    <host>node1</host>
                </replica>
            </cluster_a>
        </clusters>
    </upstreams>

    <routing>
        <default>
            <action>
                <route_to>cluster_a</route_to>
            </action>
        </default>
    </routing>
</clickhouse>

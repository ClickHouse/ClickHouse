<clickhouse>
    <!-- Loaded by old servers too: only settings that the old version knows may appear here, an unknown one makes the profile fail to load. -->
    <profiles>
        <default>
            <allow_database_iceberg>1</allow_database_iceberg>
            <allow_insert_into_iceberg>1</allow_insert_into_iceberg>
        </default>
    </profiles>
    <users>
        <default>
            <named_collection_control>1</named_collection_control>
        </default>
    </users>
</clickhouse>

<clickhouse>
    <!-- Allow the resolver name, but not the raw-IP target used by the host-filter test. -->
    <remote_url_allow_hosts>
        <host>resolver:8080</host>
    </remote_url_allow_hosts>
    <!-- Keep retries low so the test fails fast. -->
    <s3_retry_attempts>1</s3_retry_attempts>
    <s3_max_redirects>0</s3_max_redirects>
</clickhouse>

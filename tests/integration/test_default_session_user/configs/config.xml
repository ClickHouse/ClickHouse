<clickhouse>
    <default_session_user>global_default_user</default_session_user>

    <!-- gRPC is not a composable protocol, so only the global setting applies to it. -->
    <grpc_port>9100</grpc_port>

    <!-- Arrow Flight is not a composable protocol either, so only the global setting applies to it. -->
    <arrowflight_port>9110</arrowflight_port>

    <!-- Serve keeper-style prometheus metrics; the composable `prometheus` endpoints
         below go through the `KeeperPrometheusHandler-factory` because of this. -->
    <prometheus>
        <keeper_metrics_only>true</keeper_metrics_only>
    </prometheus>

    <!-- A custom `http_handlers` section that exposes the web terminal via a `rule`.
         A composable HTTP endpoint that references it must still honor the endpoint's
         own `default_session_user`. -->
    <http_handlers_custom_webterminal>
        <rule>
            <url>/webterminal</url>
            <handler>
                <type>webterminal</type>
            </handler>
        </rule>
    </http_handlers_custom_webterminal>

    <!-- A rule with a fixed user (`handler.user`): the handler authenticates as that
         user regardless of the request, so it must keep working on an endpoint that
         prohibits anonymous logins with an empty `default_session_user`. The default
         handlers are also included to check that the prohibition still applies to them. -->
    <http_handlers_fixed_user>
        <rule>
            <url>/fixed</url>
            <methods>GET</methods>
            <handler>
                <type>predefined_query_handler</type>
                <query>SELECT currentUser()</query>
                <user>fixed_handler_user</user>
            </handler>
        </rule>
        <defaults/>
    </http_handlers_fixed_user>

    <session_log>
        <database>system</database>
        <table>session_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
    </session_log>

    <protocols>
        <tcp_defuser>
            <type>tcp</type>
            <host>0.0.0.0</host>
            <port>9101</port>
            <default_session_user>proto_tcp_user</default_session_user>
            <description>native protocol with its own default session user</description>
        </tcp_defuser>
        <tcp_base>
            <type>tcp</type>
            <host>0.0.0.0</host>
            <port>9102</port>
            <description>native protocol without an endpoint-level default session user</description>
        </tcp_base>
        <tcp_endpoint_defuser>
            <impl>tcp_base</impl>
            <host>0.0.0.0</host>
            <port>9103</port>
            <default_session_user>proto_endpoint_user</default_session_user>
            <description>endpoint of tcp_base with its own default session user</description>
        </tcp_endpoint_defuser>
        <tcp_no_anonymous>
            <type>tcp</type>
            <host>0.0.0.0</host>
            <port>9104</port>
            <default_session_user></default_session_user>
            <description>native protocol that rejects connections without a user name</description>
        </tcp_no_anonymous>
        <http_defuser>
            <type>http</type>
            <host>0.0.0.0</host>
            <port>8124</port>
            <default_session_user>proto_http_user</default_session_user>
            <description>http protocol with its own default session user</description>
        </http_defuser>
        <http_webterminal>
            <type>http</type>
            <host>0.0.0.0</host>
            <port>8125</port>
            <default_session_user>proto_webterminal_user</default_session_user>
            <description>http protocol whose web terminal uses its own default session user</description>
        </http_webterminal>
        <http_custom_webterminal>
            <type>http</type>
            <host>0.0.0.0</host>
            <port>8128</port>
            <default_session_user>proto_custom_webterminal_user</default_session_user>
            <handlers>http_handlers_custom_webterminal</handlers>
            <description>http protocol serving the web terminal via a custom handlers section</description>
        </http_custom_webterminal>
        <http_reload_effective>
            <type>http</type>
            <host>0.0.0.0</host>
            <port>8126</port>
            <default_session_user>reload_effective_before</default_session_user>
            <description>http-reload-effective</description>
        </http_reload_effective>
        <http_reload_shadow_base>
            <type>http</type>
            <host>0.0.0.0</host>
            <default_session_user>reload_shadow_base_before</default_session_user>
            <description>http-reload-shadow-base</description>
        </http_reload_shadow_base>
        <http_reload_shadow_endpoint>
            <impl>http_reload_shadow_base</impl>
            <host>0.0.0.0</host>
            <port>8127</port>
            <default_session_user>reload_shadow_endpoint_user</default_session_user>
            <description>http-reload-shadow-endpoint</description>
        </http_reload_shadow_endpoint>
        <mysql_defuser>
            <type>mysql</type>
            <host>0.0.0.0</host>
            <port>9106</port>
            <default_session_user>proto_mysql_user</default_session_user>
            <description>mysql protocol with its own default session user</description>
        </mysql_defuser>
        <postgres_defuser>
            <type>postgres</type>
            <host>0.0.0.0</host>
            <port>9107</port>
            <default_session_user>proto_pg_user</default_session_user>
            <description>postgres protocol with its own default session user</description>
        </postgres_defuser>
        <prometheus_defuser>
            <type>prometheus</type>
            <host>0.0.0.0</host>
            <port>9108</port>
            <default_session_user>proto_prometheus_user</default_session_user>
            <description>keeper-metrics-only prometheus protocol with its own default session user</description>
        </prometheus_defuser>
        <http_fixed_no_anonymous>
            <type>http</type>
            <host>0.0.0.0</host>
            <port>8129</port>
            <default_session_user></default_session_user>
            <handlers>http_handlers_fixed_user</handlers>
            <description>http protocol with a fixed-user handler and anonymous logins prohibited</description>
        </http_fixed_no_anonymous>
        <prometheus_no_anonymous>
            <type>prometheus</type>
            <host>0.0.0.0</host>
            <port>9109</port>
            <default_session_user></default_session_user>
            <description>keeper-metrics-only prometheus protocol that rejects anonymous scrapes</description>
        </prometheus_no_anonymous>
    </protocols>
</clickhouse>

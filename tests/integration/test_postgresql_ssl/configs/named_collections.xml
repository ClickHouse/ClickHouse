<clickhouse>
    <named_collections>
        <pg_ssl>
            <user>postgres</user>
            <password>ClickHouse_PostgreSQL_P@ssw0rd</password>
            <host>postgres1</host>
            <port>5432</port>
            <database>postgres</database>
            <table>test_table</table>
        </pg_ssl>
        <pg_ssl_cert>
            <user>postgres</user>
            <password>ClickHouse_PostgreSQL_P@ssw0rd</password>
            <host>postgres1</host>
            <port>5432</port>
            <database>certdb</database>
            <table>cert_table</table>
        </pg_ssl_cert>
        <!-- The `PostgreSQL` database engine wraps a whole database, so its named
             collection must not carry a `table` key (that key is only valid for the
             table function / table engine that address a single table). -->
        <pg_ssl_db>
            <user>postgres</user>
            <password>ClickHouse_PostgreSQL_P@ssw0rd</password>
            <host>postgres1</host>
            <port>5432</port>
            <database>postgres</database>
        </pg_ssl_db>
        <!-- Certificate and key paths are only accepted from a named collection defined
             in the server configuration file, i.e. from here. The files are written by
             the test fixture before the first connection is made. -->
        <pg_ssl_paths>
            <user>postgres</user>
            <password>ClickHouse_PostgreSQL_P@ssw0rd</password>
            <host>postgres1</host>
            <port>5432</port>
            <database>postgres</database>
            <table>test_table</table>
            <sslmode>verify-full</sslmode>
            <sslrootcert>/var/lib/clickhouse/pg_certs/postgresql-ca.crt</sslrootcert>
        </pg_ssl_paths>
        <pg_ssl_cert_paths>
            <user>postgres</user>
            <password>ClickHouse_PostgreSQL_P@ssw0rd</password>
            <host>postgres1</host>
            <port>5432</port>
            <database>certdb</database>
            <table>cert_table</table>
            <sslmode>verify-full</sslmode>
            <sslrootcert>/var/lib/clickhouse/pg_certs/postgresql-ca.crt</sslrootcert>
            <sslcert>/var/lib/clickhouse/pg_certs/postgresql-client.crt</sslcert>
            <sslkey>/var/lib/clickhouse/pg_certs/postgresql-client.key</sslkey>
        </pg_ssl_cert_paths>
        <!-- A credential the operator locked with `overridable="false"` cannot be
             replaced from a query, not even through the contents form. -->
        <pg_ssl_locked_paths>
            <user>postgres</user>
            <password>ClickHouse_PostgreSQL_P@ssw0rd</password>
            <host>postgres1</host>
            <port>5432</port>
            <database>postgres</database>
            <table>test_table</table>
            <sslmode>verify-full</sslmode>
            <sslrootcert overridable="false">/var/lib/clickhouse/pg_certs/postgresql-ca.crt</sslrootcert>
        </pg_ssl_locked_paths>
    </named_collections>
</clickhouse>

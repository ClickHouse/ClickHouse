<clickhouse>
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>

    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>8001</port>

        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
        <!-- "group" is a histogram-family label, but histograms and dimensional metrics are disabled,
             so no exported sample can contain a "group" label and it is safe as a constant label. -->
        <histograms>false</histograms>
        <dimensional_metrics>false</dimensional_metrics>
        <labels>
            <group>prod</group>
        </labels>
    </prometheus>
</clickhouse>

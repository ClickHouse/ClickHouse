<clickhouse>
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>

    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>8001</port>

        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
        <histograms>true</histograms>
        <labels>
            <!-- "group" is a per-sample label of histogram families (e.g. http_pool_tcp_buf_bytes),
                 and histograms are exposed here, so it must be rejected as a constant label to avoid
                 emitting a repeated label name. -->
            <group>prod</group>
        </labels>
    </prometheus>
</clickhouse>

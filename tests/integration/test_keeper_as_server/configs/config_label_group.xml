<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>8001</port>
        <keeper_metrics_only>true</keeper_metrics_only>
        <metrics>true</metrics>
        <asynchronous_metrics>true</asynchronous_metrics>
        <histograms>true</histograms>
        <!-- "group" is a per-sample label of *server* histogram families (e.g. http_pool_tcp_buf_bytes),
             which a keeper_metrics_only endpoint never exposes, so it must be accepted as a constant label. -->
        <labels>
            <group>prod</group>
        </labels>
    </prometheus>

    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>warning</raft_logs_level>
        </coordination_settings>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>node_keeper_label_group</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>
</clickhouse>

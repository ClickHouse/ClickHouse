<clickhouse>
    <!-- One local user per LDAP server definition in ldap_servers.xml. All of them bind to the
         directory as `janedoe` (password `qwerty`); the user name only selects the transport. -->
    <users>
        <user_ldaps>
            <ldap>
                <server>ldaps</server>
            </ldap>
        </user_ldaps>
        <user_ldaps_tls13>
            <ldap>
                <server>ldaps_tls13</server>
            </ldap>
        </user_ldaps_tls13>
        <user_ldaps_max_tls12>
            <ldap>
                <server>ldaps_max_tls12</server>
            </ldap>
        </user_ldaps_max_tls12>
        <user_ldaps_max_tls11>
            <ldap>
                <server>ldaps_max_tls11</server>
            </ldap>
        </user_ldaps_max_tls11>
        <user_ldaps_no_ca>
            <ldap>
                <server>ldaps_no_ca</server>
            </ldap>
        </user_ldaps_no_ca>
        <user_ldaps_never>
            <ldap>
                <server>ldaps_never</server>
            </ldap>
        </user_ldaps_never>
        <user_starttls>
            <ldap>
                <server>starttls</server>
            </ldap>
        </user_starttls>
        <user_unreachable>
            <ldap>
                <server>unreachable</server>
            </ldap>
        </user_unreachable>
        <user_stalled_bind>
            <ldap>
                <server>stalled_bind</server>
            </ldap>
        </user_stalled_bind>
        <user_stalled_search>
            <ldap>
                <server>stalled_search</server>
            </ldap>
        </user_stalled_search>
        <user_bad_tls_range>
            <ldap>
                <server>bad_tls_range</server>
            </ldap>
        </user_bad_tls_range>
        <user_bad_timeout>
            <ldap>
                <server>bad_timeout</server>
            </ldap>
        </user_bad_timeout>
    </users>
</clickhouse>

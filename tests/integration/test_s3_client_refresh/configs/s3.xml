<clickhouse>
    <s3>
        <use_environment_credentials>0</use_environment_credentials>
        <endpoint_override>
            <endpoint>http://minio1:9001/root/refresh/endpoint/</endpoint>
            <use_environment_credentials>0</use_environment_credentials>
        </endpoint_override>
        <conflicting_keys>
            <endpoint>http://minio1:9001/root/refresh/keys/</endpoint>
            <access_key_id>invalid</access_key_id>
            <secret_access_key>invalid</secret_access_key>
        </conflicting_keys>
    </s3>
    <named_collections>
        <refresh_env>
            <url>http://minio1:9001/root/refresh/</url>
            <use_environment_credentials>1</use_environment_credentials>
            <format>TSV</format>
        </refresh_env>
    </named_collections>
</clickhouse>

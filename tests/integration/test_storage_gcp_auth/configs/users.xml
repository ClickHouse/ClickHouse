<clickhouse>
    <profiles>
        <default>
            <enable_s3_requests_logging>1</enable_s3_requests_logging>
            <!-- These named collections authenticate via the GCP metadata service, which is server-managed and
                 blocked for user queries by default. Allow it here; `test_impersonation_is_server_managed`
                 uses a separate user with the restriction left in place. -->
            <s3_allow_server_credentials_in_user_queries>1</s3_allow_server_credentials_in_user_queries>
        </default>
        <restricted>
            <s3_allow_server_credentials_in_user_queries>0</s3_allow_server_credentials_in_user_queries>
        </restricted>
    </profiles>
    <users>
        <default>
            <password></password>
            <profile>default</profile>
            <named_collection_control>1</named_collection_control>
        </default>
        <restricted_user>
            <password></password>
            <profile>restricted</profile>
            <named_collection_control>1</named_collection_control>
            <access_management>1</access_management>
        </restricted_user>
    </users>
</clickhouse>

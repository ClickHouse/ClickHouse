<clickhouse>
    <!-- On-disk stores for all three SQL-object families, so their disk
         storages (not the <memory/>-style overrides used elsewhere) are exercised. -->
    <user_defined_path>/var/lib/clickhouse/user_defined/</user_defined_path>
    <!-- Two levels below an existing directory, so creating this store has to create, and
         persist the entry of, more than one directory. -->
    <workload_path>/var/lib/clickhouse/workload/entities/local/</workload_path>
    <named_collections_storage>
        <type>local</type>
    </named_collections_storage>
</clickhouse>

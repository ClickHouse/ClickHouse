# Dictionary of the `avro_*_fuzzer` targets: schema JSON, Object Container File structure and the binary encoding.

# Object Container File: magic, metadata keys, codecs
magic="Obj\x01"
"avro.schema"
"avro.codec"
"avro.codec\x00"
"null"
"deflate"
"snappy"
"bzip2"
"xz"
"zstandard"
"zstd"


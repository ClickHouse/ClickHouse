# Binary encoding: zigzag varints at the edges of `int` and `long`
"\x00"
"\x01"
"\x02"
"\x7e"
"\x7f"
"\x80\x01"
"\xfe\xff\xff\xff\x0f"
"\xff\xff\xff\xff\x0f"
"\xff\xff\xff\xff\xff\x01"
"\xfe\xff\xff\xff\xff\xff\xff\xff\xff\x01"
"\xff\xff\xff\xff\xff\xff\xff\xff\xff\x01"
"\x80\x80\x80\x80\x80\x80\x80\x80\x80\x80"

# Binary encoding: block headers of arrays and maps (a negative count is followed by the byte size)
"\x01\x02"
"\x03\x02"
"\xff\xff\xff\xff\xff\xff\xff\xff\xff\x01"

# Sync marker shaped data and block header shapes
"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"

# `AvroConfluent` framing: magic byte and big-endian schema id
"\x00\x00\x00\x00\x01"
"\x00\x00\x00\x00\x02"
"\x00\x00\x00\x00\x00"
"\x00\xff\xff\xff\xff"

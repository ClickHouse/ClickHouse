# BinaryTypeIndex values from DataTypesBinaryEncoding.h
# Each entry is a single-byte type index for the binary type encoding format.

# Scalar types
# Nothing
"\x00"
# UInt8
"\x01"
# UInt16
"\x02"
# UInt32
"\x03"
# UInt64
"\x04"
# UInt128
"\x05"
# UInt256
"\x06"
# Int8
"\x07"
# Int16
"\x08"
# Int32
"\x09"
# Int64
"\x0A"
# Int128
"\x0B"
# Int256
"\x0C"
# Float32
"\x0D"
# Float64
"\x0E"
# Date
"\x0F"
# Date32
"\x10"
# DateTime (no timezone)
"\x11"
# DateTime (with timezone)
"\x12"
# DateTime64(P)
"\x13"
# DateTime64(P, timezone)
"\x14"
# String
"\x15"
# FixedString(N)
"\x16"
# Enum8
"\x17"
# Enum16
"\x18"
# Decimal32(P, S)
"\x19"
# Decimal64(P, S)
"\x1A"
# Decimal128(P, S)
"\x1B"
# Decimal256(P, S)
"\x1C"
# UUID
"\x1D"
# Array(T)
"\x1E"
# Tuple (unnamed)
"\x1F"
# Tuple (named)
"\x20"
# Set
"\x21"
# Interval
"\x22"
# Nullable(T)
"\x23"
# Function
"\x24"
# AggregateFunction
"\x25"
# LowCardinality(T)
"\x26"
# Map(K, V)
"\x27"
# IPv4
"\x28"
# IPv6
"\x29"
# Variant
"\x2A"
# Dynamic
"\x2B"
# Custom type
"\x2C"
# Bool
"\x2D"
# SimpleAggregateFunction
"\x2E"
# Nested
"\x2F"
# JSON
"\x30"
# BFloat16
"\x31"
# Time
"\x32"
# Time64(P)
"\x34"
# QBit(T, N)
"\x36"
# QBit(T, N, stride)
"\x37"

# VarUInt encodings for small counts (1-byte encoding for values 0-127)
# count = 0
"\x00"
# count = 1
"\x01"
# count = 2
"\x02"
# count = 3
"\x03"
# count = 8
"\x08"
# count = 16
"\x10"
# count = 127
"\x7F"

# Interval kind bytes
# Second
"\x03"
# Minute
"\x04"
# Hour
"\x05"
# Day
"\x06"

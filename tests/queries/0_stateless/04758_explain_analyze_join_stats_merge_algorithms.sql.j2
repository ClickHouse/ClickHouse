-- Tags: no-parallel-replicas
-- no-parallel-replicas: EXPLAIN ANALYZE rejects distributed plans (NOT_IMPLEMENTED).

-- Pins which groups `EXPLAIN ANALYZE` reports for the algorithms outside the hash join family, over
-- every kind each of them accepts: `grace_hash` adds the bucket and spill groups, `partial_merge` the
-- on-disk ones. The hash join family is in `04510_explain_analyze_join_stats`.
--
-- The parallel merge algorithms are told apart from their single-stream counterparts by the `Sharding:`
-- group. `parallel_full_sorting_merge` shards only when neither side is already sorted, hence
-- `optimize_read_in_order = 0`; `parallel_sorted_merge` requires the tables' native order. `ASOF` is
-- never sharded, its trailing key is an inequality, so it gets its own case asserting the group is absent.

SET enable_analyzer = 1;
-- `sorted_merge` variants are selectable only when the planner can use the tables' primary-key order.
-- Pin the settings randomized by the flaky-check job so their coverage does not depend on its seed.
SET optimize_read_in_order = 1, query_plan_read_in_order = 1,
    query_plan_join_shard_by_pk_ranges = 0, query_plan_join_swap_table = 0,
    enable_parallel_replicas = 0;

DROP TABLE IF EXISTS t1;
DROP TABLE IF EXISTS t2;
CREATE TABLE t1 (x UInt64, t UInt64) ENGINE = MergeTree ORDER BY x;
CREATE TABLE t2 (x UInt64, t UInt64) ENGINE = MergeTree ORDER BY x;
INSERT INTO t1 SELECT number % 500, number FROM numbers(1000);
INSERT INTO t2 SELECT number % 500, number FROM numbers(1000);

{% set all_kinds = [
    'ALL INNER JOIN t2 ON t1.x = t2.x',
    'ALL LEFT JOIN t2 ON t1.x = t2.x',
    'ALL RIGHT JOIN t2 ON t1.x = t2.x',
    'ALL FULL JOIN t2 ON t1.x = t2.x',
] -%}

{% set cases = [
    ('grace_hash', ', max_bytes_before_external_join = 1',
        all_kinds + [
            'ANY INNER JOIN t2 ON t1.x = t2.x',
            'ANY LEFT JOIN t2 ON t1.x = t2.x',
            'ANY RIGHT JOIN t2 ON t1.x = t2.x',
            'SEMI LEFT JOIN t2 ON t1.x = t2.x',
            'SEMI RIGHT JOIN t2 ON t1.x = t2.x',
            'ANTI LEFT JOIN t2 ON t1.x = t2.x',
            'ANTI RIGHT JOIN t2 ON t1.x = t2.x',
        ],
        "countIf(explain LIKE '%Left: rows%') = 1 AND countIf(explain LIKE '%Right: rows%') = 1 AND countIf(explain LIKE '%matched %') = 2 AND countIf(explain LIKE '%match rate%') = 2 AND countIf(explain LIKE '%unique keys%') = 1 AND countIf(explain LIKE '%· memory %') = 1 AND countIf(explain LIKE '%buckets%') = 1 AND countIf(explain LIKE '%rehashes%') = 1 AND countIf(explain LIKE '%Spill:%') = 1"),

    ('partial_merge', '',
        all_kinds + [
            'ANY INNER JOIN t2 ON t1.x = t2.x',
            'ANY LEFT JOIN t2 ON t1.x = t2.x',
            'SEMI LEFT JOIN t2 ON t1.x = t2.x',
        ],
        "countIf(explain LIKE '%Left: rows%') = 1 AND countIf(explain LIKE '%Right: rows%') = 1 AND countIf(explain LIKE '%matched %') = 2 AND countIf(explain LIKE '%match rate%') = 2 AND countIf(explain LIKE '%· size %') = 1 AND countIf(explain LIKE '%· blocks %') = 1 AND countIf(explain LIKE '%storage%') = 1 AND countIf(explain LIKE '%sort time%') = 2"),

    ('full_sorting_merge', '',
        all_kinds + [
            'ANY INNER JOIN t2 ON t1.x = t2.x',
            'ANY LEFT JOIN t2 ON t1.x = t2.x',
            'ANY RIGHT JOIN t2 ON t1.x = t2.x',
            'ASOF JOIN t2 ON t1.x = t2.x AND t1.t >= t2.t',
            'ASOF LEFT JOIN t2 ON t1.x = t2.x AND t1.t >= t2.t',
        ],
        "countIf(explain LIKE '%Left: rows%') = 1 AND countIf(explain LIKE '%Right: rows%') = 1 AND countIf(explain LIKE '%matched %') = 2 AND countIf(explain LIKE '%match rate%') = 2"),

    ('sorted_merge', '',
        all_kinds + [
            'ANY INNER JOIN t2 ON t1.x = t2.x',
            'ANY LEFT JOIN t2 ON t1.x = t2.x',
            'ANY RIGHT JOIN t2 ON t1.x = t2.x',
            'ASOF JOIN t2 ON t1.x = t2.x AND t1.t >= t2.t',
            'ASOF LEFT JOIN t2 ON t1.x = t2.x AND t1.t >= t2.t',
        ],
        "countIf(explain LIKE '%Left: rows%') = 1 AND countIf(explain LIKE '%Right: rows%') = 1 AND countIf(explain LIKE '%matched %') = 2 AND countIf(explain LIKE '%match rate%') = 2 AND countIf(explain LIKE '%Sharding:%') = 0"),

    ('parallel_full_sorting_merge', ', max_threads = 8, optimize_read_in_order = 0',
        all_kinds + [
            'ANY INNER JOIN t2 ON t1.x = t2.x',
            'ANY LEFT JOIN t2 ON t1.x = t2.x',
            'ANY RIGHT JOIN t2 ON t1.x = t2.x',
        ],
        "countIf(explain LIKE '%Left: rows%') = 1 AND countIf(explain LIKE '%Right: rows%') = 1 AND countIf(explain LIKE '%matched %') = 2 AND countIf(explain LIKE '%match rate%') = 2 AND countIf(explain LIKE '%Sharding:%') = 1"),

    ('parallel_sorted_merge', ', max_threads = 8',
        all_kinds + [
            'ANY INNER JOIN t2 ON t1.x = t2.x',
            'ANY LEFT JOIN t2 ON t1.x = t2.x',
            'ANY RIGHT JOIN t2 ON t1.x = t2.x',
        ],
        "countIf(explain LIKE '%Left: rows%') = 1 AND countIf(explain LIKE '%Right: rows%') = 1 AND countIf(explain LIKE '%matched %') = 2 AND countIf(explain LIKE '%match rate%') = 2 AND countIf(explain LIKE '%Sharding:%') = 1"),

    ('parallel_sorted_merge', ', max_threads = 8',
        [
            'ASOF JOIN t2 ON t1.x = t2.x AND t1.t >= t2.t',
            'ASOF LEFT JOIN t2 ON t1.x = t2.x AND t1.t >= t2.t',
        ],
        "countIf(explain LIKE '%Left: rows%') = 1 AND countIf(explain LIKE '%Right: rows%') = 1 AND countIf(explain LIKE '%matched %') = 2 AND countIf(explain LIKE '%match rate%') = 2 AND countIf(explain LIKE '%Sharding:%') = 0"),

    ('parallel_full_sorting_merge', ', max_threads = 8, optimize_read_in_order = 0',
        [
            'ASOF JOIN t2 ON t1.x = t2.x AND t1.t >= t2.t',
            'ASOF LEFT JOIN t2 ON t1.x = t2.x AND t1.t >= t2.t',
        ],
        "countIf(explain LIKE '%Left: rows%') = 1 AND countIf(explain LIKE '%Right: rows%') = 1 AND countIf(explain LIKE '%matched %') = 2 AND countIf(explain LIKE '%match rate%') = 2 AND countIf(explain LIKE '%Sharding:%') = 0"),
] -%}

{% for algo, extra, combos, checks in cases -%}
{% for jc in combos -%}
SELECT {{ checks }}
FROM (EXPLAIN ANALYZE SELECT * FROM t1 {{ jc }} SETTINGS join_algorithm = '{{ algo }}'{{ extra }});
{% endfor -%}
{% endfor -%}

DROP TABLE t1;
DROP TABLE t2;

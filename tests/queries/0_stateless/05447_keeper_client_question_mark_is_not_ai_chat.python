import os
import pty
import select
import shlex
import sys
import time

TIMEOUT_SECONDS = 60


def read_until(master, output, predicate, deadline):
    while not predicate(output):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return output, False
        ready, _, _ = select.select([master], [], [], remaining)
        if not ready:
            continue
        try:
            data = os.read(master, 4096)
        except OSError:
            return output, False
        if not data:
            return output, False
        output += data.decode(errors="replace")
    return output, True


def main():
    victim = sys.argv[1]
    args = shlex.split(os.environ["CLICKHOUSE_KEEPER_CLIENT"])

    pid, master = pty.fork()
    if pid == 0:
        os.execv(args[0], args)

    deadline = time.monotonic() + TIMEOUT_SECONDS
    try:
        output, ok = read_until(master, "", lambda o: ":)" in o, deadline)
        if not ok:
            print("FAIL: no prompt")
            return

        # The line is rejected as a syntax error. Had the `?` been taken away from it, the node
        # would have been removed without any output, and the error would never come.
        os.write(master, f"? rm {victim}\n".encode())
        output, ok = read_until(master, output, lambda o: "Syntax error" in o, deadline)
        if not ok:
            print("FAIL: no syntax error for the line")
            return
        print("OK")
    finally:
        os.close(master)
        os.waitpid(pid, 0)


if __name__ == "__main__":
    main()

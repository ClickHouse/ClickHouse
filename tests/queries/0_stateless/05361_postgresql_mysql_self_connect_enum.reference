--- PostgreSQL
k	name	id	n
UInt32	Enum8(\'a\' = 1, \'b\' = 2, \'c\' = 3)	Enum16(\'neg\' = -1000, \'one\' = 1, \'two\' = 2)	Nullable(Enum8(\'b\' = 1, \'c\' = 2))
1	a	one	b
2	b	two	\N
3	c	neg	c
['a','b','c']	['neg','one','two']
--- PostgreSQL dictionary with Enum range columns
1	p	q	one-two
--- MySQL
k	name	id
UInt32	Enum8(\'a\' = 1, \'b\' = 2, \'c\' = 3)	Enum16(\'neg\' = -1000, \'one\' = 1, \'two\' = 2)
1	a	one
2	b	two
3	c	neg
['a','b','c']	['neg','one','two']
--- a value that is not an element of the enum is rejected
rejected by PostgreSQL
rejected by MySQL
1

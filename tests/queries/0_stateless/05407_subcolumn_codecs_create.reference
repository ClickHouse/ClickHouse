CREATE TABLE default.t_subcolumn_codecs (`id` UInt64, `payload` Tuple(ts DateTime64(3), value Float64, meta Tuple(seq UInt64, flags Array(UInt8)), `with.dot` UInt32), `attrs` Map(UInt64, Float64), `pair` Tuple(UInt64, Float64), CODEC `payload.meta` (Delta, ZSTD(3)), CODEC `payload.ts` (DoubleDelta, ZSTD(1)), CODEC `payload.value` (Gorilla(8), ZSTD(1)), CODEC `payload.with.dot` (T64, LZ4HC(4)), CODEC `attrs.values` (Gorilla(8), LZ4HC(4)), CODEC `pair.2` (ZSTD(5)), INDEX idx_seq payload.meta.seq TYPE minmax GRANULARITY 1, CONSTRAINT c_value CHECK isFinite(payload.value)) ENGINE = MergeTree ORDER BY (id, payload.ts)

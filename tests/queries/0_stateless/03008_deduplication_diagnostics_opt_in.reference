mv_generates_several_blocks first stmt -- DEBUG (first) — a single query, only produces rows when counts mismatch WITH (SELECT count() FROM table_a_b) AS c_src, (SELECT count() FROM table_when_b_even_and_joined) AS c_dst, (c_src != 5 OR c_dst != 9) AS mismatch SELECT 'DEBUG first: src/dst count expected/actual', toString(5) || '/' || toString(9) || ' expected vs ' || toString(c_src) || '/' || toString(c_dst) || ' actual' WHERE mismatch UNION ALL SELECT 'DEBUG first: table_when_b_even_and_joined by _part ' || _part, toString(count()) FROM table_when_b_even_and_joined WHERE mismatch GROUP BY _part UNION ALL SELECT 'DEBUG first: table_when_b_even_and_joined row (' || toString(a_src) || ',' || toString(a_join) || ',' || toString(b) || ')', toString(count()) FROM table_when_b_even_and_joined WHERE mismatch GROUP BY a_src, a_join, b UNION ALL SELECT 'DEBUG first: system.parts ' || table || '/' || name, toString(rows) || ' rows, ' || toString(bytes_on_disk) || ' bytes' FROM system.parts WHERE active AND database = currentDatabase() AND table IN ('table_a_b', 'table_for_join_with', 'table_when_b_even_and_joined') AND mismatch UNION ALL SELECT 'DEBUG first: table def ' || name, engine || ' :: ' || create_table_query FROM system.tables WHERE database = currentDatabase() AND name IN ('table_a_b', 'table_for_join_with', 'table_when_b_even_and_joined', 'mv_b_even') AND mismatch UNION ALL SELECT 'DEBUG first: setting ' || name, value FROM system.settings WHERE name IN ( 'max_insert_threads', 'max_block_size', 'update_insert_deduplication_token_in_dependent_materialized_views', 'deduplicate_blocks_in_dependent_materialized_views' ) AND mismatch ORDER BY 1

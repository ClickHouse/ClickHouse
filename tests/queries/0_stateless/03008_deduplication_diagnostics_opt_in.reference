insert_several_blocks_into_table first stmt -- DEBUG (first) — a single query, only produces rows when counts mismatch WITH (SELECT count() FROM table_a_b) AS c_src, (SELECT count() FROM table_when_b_even) AS c_dst, (c_src != 4 OR c_dst != 2) AS mismatch SELECT 'DEBUG first: src/dst count expected/actual', toString(4) || '/' || toString(2) || ' expected vs ' || toString(c_src) || '/' || toString(c_dst) || ' actual' WHERE mismatch UNION ALL SELECT 'DEBUG first: table_when_b_even by _part ' || _part, toString(count()) FROM table_when_b_even WHERE mismatch GROUP BY _part UNION ALL SELECT 'DEBUG first: table_when_b_even row (' || toString(a) || ',' || toString(b) || ')', toString(count()) FROM table_when_b_even WHERE mismatch GROUP BY a, b UNION ALL SELECT 'DEBUG first: system.parts ' || table || '/' || name, toString(rows) || ' rows, ' || toString(bytes_on_disk) || ' bytes' FROM system.parts WHERE active AND database = currentDatabase() AND table IN ('table_a_b', 'table_when_b_even') AND mismatch UNION ALL SELECT 'DEBUG first: setting ' || name, value FROM system.settings WHERE name IN ( 'max_insert_threads', 'max_block_size', 'update_insert_deduplication_token_in_dependent_materialized_views', 'deduplicate_blocks_in_dependent_materialized_views' ) AND mismatch ORDER BY 1

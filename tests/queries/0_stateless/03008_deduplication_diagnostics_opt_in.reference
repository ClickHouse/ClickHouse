insert_several_blocks_into_table first stmt WITH (SELECT count() FROM table_when_b_even) AS c_dst SELECT a, b, count() FROM table_when_b_even WHERE c_dst != 5 GROUP BY a, b ORDER BY a, b
insert_several_blocks_into_table first stmt WITH (SELECT count() FROM table_when_b_even) AS c_dst SELECT 'DEBUG: Active parts in system.parts' WHERE c_dst != 5
insert_several_blocks_into_table first stmt WITH (SELECT count() FROM table_when_b_even) AS c_dst SELECT table, name, rows, bytes_on_disk FROM system.parts WHERE active AND database = currentDatabase() AND table IN ('table_a_b', 'table_when_b_even') AND c_dst != 5 ORDER BY table, name
insert_several_blocks_into_table first stmt WITH (SELECT count() FROM table_when_b_even) AS c_dst SELECT 'DEBUG: Relevant settings from system.settings' WHERE c_dst != 5

insert_several_blocks_into_table first stmt -- DEBUG (first) — only printed when counts mismatch WITH (SELECT count() FROM table_a_b) AS c_src SELECT 'DEBUG first: Checking source table table_a_b counts' WHERE c_src != 10
insert_several_blocks_into_table first stmt WITH (SELECT count() FROM table_a_b) AS c_src SELECT 'DEBUG first src expected/actual', toUInt64(10) AS expected, c_src AS actual WHERE c_src != 10
insert_several_blocks_into_table first stmt WITH (SELECT count() FROM table_when_b_even) AS c_dst SELECT 'DEBUG first: Checking destination table table_when_b_even counts' WHERE c_dst != 5
insert_several_blocks_into_table first stmt WITH (SELECT count() FROM table_when_b_even) AS c_dst SELECT 'DEBUG first dst expected/actual', toUInt64(5) AS expected, c_dst AS actual WHERE c_dst != 5
insert_several_blocks_into_table first stmt WITH (SELECT count() FROM table_when_b_even) AS c_dst SELECT 'DEBUG first: Distribution across parts in table_when_b_even' WHERE c_dst != 5
insert_several_blocks_into_table first stmt WITH (SELECT count() FROM table_when_b_even) AS c_dst SELECT '_part', _part, count() FROM table_when_b_even WHERE c_dst != 5 GROUP BY _part ORDER BY _part
insert_several_blocks_into_table first stmt WITH (SELECT count() FROM table_when_b_even) AS c_dst SELECT 'DEBUG: Sample rows from table_when_b_even' WHERE c_dst != 5
insert_several_blocks_into_table first stmt WITH (SELECT count() FROM table_when_b_even) AS c_dst SELECT a, b FROM table_when_b_even WHERE c_dst != 5 ORDER BY a, b

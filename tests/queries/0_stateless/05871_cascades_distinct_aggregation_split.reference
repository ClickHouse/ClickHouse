-- 7. uniqExact keeps a hash of a String, GROUP BY compares the strings: no split
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Expression ((Before GROUP BY + Change column names to column identifiers))
          ReadFromMergeTree (ParallelRead default.t_distinct_split)
-- 7b. an aggregation in the order of the key takes 0. and -0. for one value, uniqExact does not: no split
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Expression ((Before GROUP BY + Change column names to column identifiers))
          ReadFromMergeTree (ParallelRead default.t_distinct_split)
-- 8. a forced shuffle: the aggregation by x must shuffle all the rows, so the states of one million values cost less
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Expression ((Before GROUP BY + Change column names to column identifiers))
          ReadFromMergeTree (ParallelRead default.t_distinct_split)
-- 9. no distinct count for the column: the default estimate (a tenth of the rows) gives the split
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        MergingAggregated
          ShuffleExchange
            Aggregating
              Expression ((Before GROUP BY + Change column names to column identifiers))
                ReadFromMergeTree (ParallelRead default.t_distinct_split)
-- 10. two nodes, almost every row has its own value: uniqExact on one node costs less than a shuffle of the rows
Expression ((Project names + Projection))
  Aggregating
    Expression ((Before GROUP BY + Change column names to column identifiers))
      ReadFromMergeTree (default.t_distinct_split_narrow)
-- 10b. the same without radix partitioning: the hash sets of uniqExact on one node cost more than the shuffle
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Aggregating
          Expression ((Before GROUP BY + Change column names to column identifiers))
            ShuffleExchange
              ReadFromMergeTree (ParallelRead default.t_distinct_split_narrow)
-- 11. no hint: the distinct count comes from the statistics of the table
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Aggregating
          Expression ((Before GROUP BY + Change column names to column identifiers))
            ShuffleExchange
              ReadFromMergeTree (ParallelRead default.t_distinct_split_measured)
-- 12. the table of case 10 on eight nodes: the split, with a shuffle of the rows
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Aggregating
          Expression ((Before GROUP BY + Change column names to column identifiers))
            ShuffleExchange
              ReadFromMergeTree (ParallelRead default.t_distinct_split_narrow)
-- 13. the same when an exchange is very expensive: one node reads the table and computes uniqExact
Expression ((Project names + Projection))
  Aggregating
    Expression ((Before GROUP BY + Change column names to column identifiers))
      ReadFromMergeTree (default.t_distinct_split_narrow)
-- 14. a ROLLUP finalizes the states of uniqExact, so its one row holds no values and is broadcast to the nodes of the join
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Expression (Before GROUP BY)
          JoinLogical (Broadcast HashJoin )
            Expression (Change column names to column identifiers)
              ReadFromMergeTree (ParallelRead default.t_distinct_split)
            Expression ((Change column names to column identifiers + (Project names + Projection)))
              BroadcastExchange
                Rollup
                  GatherExchange
                    Aggregating
                      Expression ((Before GROUP BY + Change column names to column identifiers))
                        ReadFromMergeTree (ParallelRead default.t_distinct_split_narrow)

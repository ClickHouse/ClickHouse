-- 1. many distinct values: an aggregation by x on every node, a shuffle by x, then the count
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        MergingAggregated
          ShuffleExchange
            Aggregating
              Expression ((Before GROUP BY + Change column names to column identifiers))
                ReadFromMergeTree (ParallelRead default.t_distinct_split)
-- 2. the same query with the setting off: the states of uniqExact go to one node
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Expression ((Before GROUP BY + Change column names to column identifiers))
          ReadFromMergeTree (ParallelRead default.t_distinct_split)
-- 3. a Nullable argument: the aggregation above the shuffle is count(n), which does not count the NULL group
Expression ((Project names + Projection))
Actions: INPUT : 0 -> uniqExact(__table1.n) UInt64 : 0
         ALIAS uniqExact(__table1.n) :: 0 -> countDistinct(n) UInt64 : 1
Positions: 1
  MergingAggregated
  Keys:
  Aggregates:
      uniqExact(__table1.n)
        Function: count(Nullable(Int32)) → UInt64
        Arguments: __table1.n
  Mode: memory-efficient
    GatherExchange
      Aggregating
      Keys:
      Aggregates:
          uniqExact(__table1.n)
            Function: count(Nullable(Int32)) → UInt64
            Arguments: __table1.n
      Skip merging: 0
        MergingAggregated
        Keys: __table1.n
          ShuffleExchange
            Aggregating
            Keys: __table1.n
            Skip merging: 0
              Expression ((Before GROUP BY + Change column names to column identifiers))
              Actions: INPUT : 0 -> n Nullable(Int32) : 0
                       ALIAS n :: 0 -> __table1.n Nullable(Int32) : 1
              Positions: 1
                ReadFromMergeTree (ParallelRead default.t_distinct_split)
                ReadType: Default
                Parts: 2
                Granules: 2

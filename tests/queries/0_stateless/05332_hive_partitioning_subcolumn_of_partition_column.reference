SELECT count() FROM file(currentDatabase() || '/05332/t=(1,2)/data.parquet', Parquet, 't Tuple(a Int64, b Int64), v Int64') WHERE t.a = 1 AND v >= 0 SETTINGS input_format_parquet_filter_push_down = 1;

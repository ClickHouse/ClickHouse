-- LIKE without a fixed prefix on a key column runs first
          Prewhere filter column: and(like(k, \'%X%\'), like(v, \'%AB%\')) (removed)
197
-- LIKE with a fixed prefix is a key condition and stays last
          Prewhere filter column: and(like(v, \'%AB%\'), like(k, \'K1%X\')) (removed)
47
-- The next key column is not moved to the end either, as the first key column has no key condition
          Prewhere filter column: and(like(k, \'%X%\'), greaterOrEquals(d, _CAST(1577836800_DateTime(\'UTC\'), \'DateTime(\'UTC\')\')), like(v, \'%AB%\')) (removed)
197
-- match without a fixed prefix runs first, with one it stays last
          Prewhere filter column: and(match(k, \'X\'), like(v, \'%AB%\')) (removed)
197
          Prewhere filter column: and(like(v, \'%AB%\'), match(k, \'^K1\')) (removed)
473
-- The join runtime filter on the large column runs after the LIKE
            Prewhere filter column: and(like(k, \'%X%\'), __applyFilter(_runtime_filter, v)) (removed)
10

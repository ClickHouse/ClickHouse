-- Tags: no-old-analyzer

-- `RIGHT` and `FULL` joins on an `ON` condition with no join key, evaluated by the block nested
-- loop operator. Their result is the matched pairs plus the build rows that matched nothing, which
-- the operator emits from a scan over the per-build-row match flags once every probe stream is
-- done; `FULL` also keeps the unmatched probe rows. Both are checked against rewrites that express
-- the same join without the operator: a cross join with a filter for the matched pairs, and a
-- `NOT IN` anti-join for the rows of either side that the filter matched nowhere.

SET join_algorithm = 'direct,parallel_hash,hash';
SET cross_to_inner_join_rewrite = 0;
SET join_use_nulls = 0;

DROP TABLE IF EXISTS bnl_rf_probe;
DROP TABLE IF EXISTS bnl_rf_build;

CREATE TABLE bnl_rf_probe (id Int32, x Nullable(Int32), s String) ENGINE = MergeTree ORDER BY id;
CREATE TABLE bnl_rf_build (id Int32, y Nullable(Int32), s String) ENGINE = MergeTree ORDER BY id;
INSERT INTO bnl_rf_probe VALUES (1, 1, 'a'), (2, 5, 'ab'), (3, NULL, 'b'), (4, 9, ''), (5, 3, 'abc'), (6, -2, 'A');
INSERT INTO bnl_rf_build VALUES (11, 2, 'a%'), (12, 4, 'b%'), (13, NULL, '%'), (14, 8, 'z%'), (15, -2, '');

{% for condition in [
    'l.x < r.y',
    'l.x + l.id > r.y',
    'sipHash64(l.x, r.y) % 4 = 0',
    'l.s LIKE r.s',
    'l.x + r.y < -1000000'
] -%}

SELECT '{{ condition }}';

SELECT 'right routed', count() FROM (EXPLAIN SELECT count() FROM bnl_rf_probe l RIGHT JOIN bnl_rf_build r ON {{ condition }})
WHERE explain LIKE '%BlockNestedLoopJoin%';
SELECT 'right',
    (SELECT arraySort(groupArray((l.id, r.id))) FROM bnl_rf_probe l RIGHT JOIN bnl_rf_build r ON {{ condition }})
  = (WITH matched AS (SELECT l.id AS lid, r.id AS rid FROM bnl_rf_probe l CROSS JOIN bnl_rf_build r WHERE {{ condition }})
     SELECT arraySort(groupArray((lid, rid))) FROM (
        SELECT lid, rid FROM matched
        UNION ALL
        SELECT 0 AS lid, id AS rid FROM bnl_rf_build WHERE id NOT IN (SELECT rid FROM matched))) AS ok;

SELECT 'full routed', count() FROM (EXPLAIN SELECT count() FROM bnl_rf_probe l FULL JOIN bnl_rf_build r ON {{ condition }})
WHERE explain LIKE '%BlockNestedLoopJoin%';
SELECT 'full',
    (SELECT arraySort(groupArray((l.id, r.id))) FROM bnl_rf_probe l FULL JOIN bnl_rf_build r ON {{ condition }})
  = (WITH matched AS (SELECT l.id AS lid, r.id AS rid FROM bnl_rf_probe l CROSS JOIN bnl_rf_build r WHERE {{ condition }})
     SELECT arraySort(groupArray((lid, rid))) FROM (
        SELECT lid, rid FROM matched
        UNION ALL
        SELECT id AS lid, 0 AS rid FROM bnl_rf_probe WHERE id NOT IN (SELECT lid FROM matched)
        UNION ALL
        SELECT 0 AS lid, id AS rid FROM bnl_rf_build WHERE id NOT IN (SELECT rid FROM matched))) AS ok;

-- The same `FULL` result as the union of the `LEFT` result - which the operator produces without
-- the match flags - and the anti-join of the build side.
SELECT 'full is left plus unmatched build',
    (SELECT arraySort(groupArray((l.id, r.id))) FROM bnl_rf_probe l FULL JOIN bnl_rf_build r ON {{ condition }})
  = (WITH matched AS (SELECT l.id AS lid, r.id AS rid FROM bnl_rf_probe l CROSS JOIN bnl_rf_build r WHERE {{ condition }})
     SELECT arraySort(groupArray((lid, rid))) FROM (
        SELECT l.id AS lid, r.id AS rid FROM bnl_rf_probe l LEFT JOIN bnl_rf_build r ON {{ condition }}
        UNION ALL
        SELECT 0 AS lid, id AS rid FROM bnl_rf_build WHERE id NOT IN (SELECT rid FROM matched))) AS ok;

{% endfor -%}

-- The padded side with `join_use_nulls`: an unmatched build row carries NULL in the probe columns
-- rather than the type's default, because the pre-join actions made them `Nullable`.
{% for join_use_nulls in [0, 1] -%}

SELECT 'join_use_nulls = {{ join_use_nulls }}';
SET join_use_nulls = {{ join_use_nulls }};
SELECT * FROM bnl_rf_probe l RIGHT JOIN bnl_rf_build r ON l.x < r.y ORDER BY ALL;
SELECT '-';
SELECT * FROM bnl_rf_probe l FULL JOIN bnl_rf_build r ON l.x + r.y < -1000000 ORDER BY ALL;
SELECT '--';

{% endfor -%}
SET join_use_nulls = 0;

-- A result that does not fit one block, with more than one probe stream: the unmatched build rows
-- are cut to the block size too, and the flags are read only once every probe stream is done.
SELECT 'chunked',
    (SELECT sum(cityHash64(l.number, r.number)) FROM numbers(300) l FULL JOIN numbers(70) r ON l.number > r.number + 250
     SETTINGS max_block_size = 13, max_joined_block_size_rows = 5, max_threads = 1)
  = (SELECT sum(cityHash64(l.number, r.number)) FROM numbers(300) l FULL JOIN numbers(70) r ON l.number > r.number + 250
     SETTINGS max_threads = 8) AS ok;
SELECT 'chunked count', count() FROM numbers(300) l FULL JOIN numbers(70) r ON l.number > r.number + 250
SETTINGS max_joined_block_size_rows = 5;
SELECT 'right chunked count', count() FROM numbers(300) l RIGHT JOIN numbers(70) r ON l.number > r.number + 250
SETTINGS max_joined_block_size_rows = 5, max_threads = 4;

DROP TABLE bnl_rf_probe;
DROP TABLE bnl_rf_build;

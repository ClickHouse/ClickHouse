-- Sampling appends bounds to the predicate's key condition. Pin those bounds and the selected granules in
-- both primary-index representations and sort directions. Count projections, trivial counts and PREWHERE are
-- disabled, so the counts are plain reads of the selected granules, and the query condition cache is
-- disabled, so the marks do not depend on earlier reads of the same predicate.
SET explain_query_plan_default = 'legacy';
SET use_query_condition_cache = 0;
SET optimize_use_projections = 0;
SET optimize_trivial_count_query = 0;
SET optimize_trivial_count_with_sparsity_filter = 0;
SET optimize_move_to_prewhere = 0;

{#- Each check prints the predicate, the count with index analysis, the count of a full scan and the marks
    selected by index analysis; with `condition`, it also prints the key conditions. `settings` apply to the
    whole check. -#}
{% macro check(table, predicate, settings = '', condition = false) -%}
SELECT '{{ predicate | replace("\\", "\\\\") | replace("'", "\\'") }}', (SELECT count() FROM {{ table }} WHERE {{ predicate }}),
    (SELECT count() FROM {{ table }} WHERE {{ predicate }} SETTINGS use_primary_key = 0, use_partition_pruning = 0, use_skip_indexes = 0),
    (SELECT sum(marks) FROM (EXPLAIN ESTIMATE SELECT 1 FROM {{ table }} WHERE {{ predicate }}))
    {%- if condition %}, (SELECT arrayStringConcat(groupArray(trimLeft(explain)), ' | ') FROM (EXPLAIN indexes = 1 SELECT 1 FROM {{ table }} WHERE {{ predicate }}) WHERE trimLeft(explain) LIKE 'Condition:%'){% endif %}
    {%- if settings %} SETTINGS {{ settings }}{% endif %}
FORMAT TSVRaw;
{%- endmacro %}

CREATE TABLE test_multi_atom_sampling_asc (x UInt8) ENGINE = MergeTree ORDER BY (intDiv(x, 16), x) SAMPLE BY x
SETTINGS index_granularity = 8, index_granularity_bytes = 0, min_rows_for_wide_part = 0, min_bytes_for_wide_part = 0, add_minmax_index_for_numeric_columns = 0, allow_experimental_reverse_key = 1;
INSERT INTO test_multi_atom_sampling_asc SELECT number FROM numbers(256);

CREATE TABLE test_multi_atom_sampling_desc (x UInt8) ENGINE = MergeTree ORDER BY (intDiv(x, 16) DESC, x DESC) SAMPLE BY x
SETTINGS index_granularity = 8, index_granularity_bytes = 0, min_rows_for_wide_part = 0, min_bytes_for_wide_part = 0, add_minmax_index_for_numeric_columns = 0, allow_experimental_reverse_key = 1;
INSERT INTO test_multi_atom_sampling_desc SELECT number FROM numbers(256);

-- For each sort direction, the checks run with `use_lightweight_primary_key_index_analysis` = 0 and 1, within
-- that with `analyze_index_with_multiple_key_columns_per_condition` = 0 and 1, and within that with the two
-- `SAMPLE` clauses. The key condition does not depend on the primary-index representation, so it is shown for
-- the first one only.
{% for table in ['test_multi_atom_sampling_asc', 'test_multi_atom_sampling_desc'] -%}
{% for sparse, multiple_atoms, sample in product([0, 1], [0, 1], ['1/2 OFFSET 1/4', '3/10 OFFSET 1/5']) -%}
{{ check(table ~ ' SAMPLE ' ~ sample, 'x >= 32 AND x < 224', settings = 'use_lightweight_primary_key_index_analysis = ' ~ sparse ~ ', analyze_index_with_multiple_key_columns_per_condition = ' ~ multiple_atoms, condition = sparse == 0) }}
{% endfor -%}
{% endfor -%}

#!/usr/bin/expect -f

# A line typed after a leading `?` is a question for the AI chat, never SQL. In a client built with
# the AI chat the `?` switches the line editor into the AI-chat mode (no provider is configured here,
# so the question is answered with a complaint about that). A client built without it has no such
# mode: there the `?` must stay a part of the line, which then fails to parse as SQL - it used to be
# swallowed as a mode switch, and the rest of the line ran as SQL. This test runs in both builds.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0
set history_file $CLICKHOUSE_TMP/$basename.history

log_user 0
set timeout 60
match_max 100000
expect_after {
    -i $any_spawn_id eof     { exp_continue }
    -i $any_spawn_id timeout { exit 1 }
}

spawn bash -c "source $basedir/../shell_config.sh ; unset OPENAI_API_KEY ANTHROPIC_API_KEY ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --history_file=$history_file"
expect ":) "

# The result of the query would be `marker42`; its text never is, so seeing it means it ran.
# The input is typed and awaited in its echo before it is submitted, so that the `\r` arrives in a
# read of its own and is taken as a submission.
send -- "?"
send -- "SELECT 'mark' || 'er42'"
expect -ex "er42'"
send -- "\r"
expect {
    -ex "marker42" { exit 1 }
    -re {:[)?] }   {}
}

# Back to the SQL mode, if the client has one to leave: a backspace on the empty `:?` line. On an
# empty SQL line it does nothing.
send -- "\177"
send -- "SELECT 'do' || 'ne7';"
expect -ex "ne7';"
send -- "\r"
expect {
    -ex "marker42" { exit 1 }
    -ex "done7"    {}
}

# Quit: `Ctrl-C` abandons the line, and `Ctrl-D` then exits from the empty prompt it redraws (the
# echo of the `^C` separates that prompt from the earlier ones).
send -- "\3"
expect {
    eof      {}
    -ex "^C" {
        expect {
            eof          {}
            -re {:[)?]}  { send -- "\4" ; expect eof }
        }
    }
}

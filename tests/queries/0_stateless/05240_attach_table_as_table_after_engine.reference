ATTACH TABLE l ENGINE = Memory AS t
ATTACH TABLE l ENGINE = Memory AS t SETTINGS x = 1
ATTACH TABLE l ENGINE = TimeSeries AS db.t SETTINGS x = 864000
CREATE TABLE l AS t ENGINE = Memory
CREATE TABLE l AS t ENGINE = Memory
ATTACH TABLE l AS REPLICATED
ATTACH TABLE l AS NOT REPLICATED
ATTACH TABLE l ENGINE = TimeSeries TAGS tg AS t
ATTACH TABLE l ENGINE = TimeSeries SAMPLES dt TAGS tg METRIC FAMILIES mt AS t SETTINGS x = 1

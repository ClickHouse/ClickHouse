-- A lambda on the left of `IN` has no result type until it is rejected as an ordinary function
-- argument, so none of the row-wise rewrites for a non-constant right-hand side may inspect it.
-- Every shape below must report an error instead of reading a null type.

-- { echoOn }

SET enable_analyzer = 1;
-- Array-returning right-hand side.
SELECT (y -> 1) IN [materialize(1), 2]; -- { serverError ILLEGAL_TYPE_OF_ARGUMENT }
SELECT (y -> 1) IN arrayMap(x -> x, [materialize(1), 2]); -- { serverError ILLEGAL_TYPE_OF_ARGUMENT }
SELECT (y -> 1) NOT IN [materialize(1), 2]; -- { serverError ILLEGAL_TYPE_OF_ARGUMENT }
SELECT (y -> 1) IN [materialize(1), 2] SETTINGS transform_null_in = 1; -- { serverError ILLEGAL_TYPE_OF_ARGUMENT }
-- Array-typed column right-hand side.
SELECT (y -> 1) IN (arr) FROM (SELECT [number] AS arr FROM numbers(1)); -- { serverError ILLEGAL_TYPE_OF_ARGUMENT }
-- Tuple-returning right-hand side.
SELECT (y -> 1) IN (materialize((1, 2))); -- { serverError ILLEGAL_TYPE_OF_ARGUMENT }
SELECT (y -> 1) IN (if(materialize(1), (1, 2), (3, 4))); -- { serverError ILLEGAL_TYPE_OF_ARGUMENT }
-- Scalar-returning right-hand side.
SELECT (y -> 1) IN (materialize(1)); -- { serverError ILLEGAL_TYPE_OF_ARGUMENT }
SELECT (y -> 1) NOT IN (materialize(1)); -- { serverError ILLEGAL_TYPE_OF_ARGUMENT }
SELECT (y -> 1) IN (materialize(1)) SETTINGS transform_null_in = 1; -- { serverError ILLEGAL_TYPE_OF_ARGUMENT }
-- Row-dependent right-hand side.
SELECT number FROM numbers(3) WHERE (y -> 1) IN (number % 2, number % 3); -- { serverError ILLEGAL_TYPE_OF_ARGUMENT }
SELECT number FROM numbers(3) WHERE (y -> 1) IN [number % 2, number % 3]; -- { serverError ILLEGAL_TYPE_OF_ARGUMENT }

#!/usr/bin/env bash

# Harness for the `remove_orphan_files` tests: one Iceberg table at a time on local or S3 storage, planted
# orphan files, and the metric rows of the last run. Source after shell_config.sh.

# The orphans the tests plant are fresh, so the minimum retention is off.
CH="${CLICKHOUSE_CLIENT} --session_timezone=UTC --allow_insert_into_iceberg=1 --allow_iceberg_remove_orphan_files=1 --iceberg_orphan_files_min_retention_seconds=0"
LOCAL_ROOT="${CLICKHOUSE_USER_FILES_UNIQUE:?}"
S3_ROOT="${CLICKHOUSE_TEST_UNIQUE_NAME}"
trap 'rm -rf "${LOCAL_ROOT}"' EXIT

STORAGE=""
TABLE=""
# Local table directory and its metadata directory.
DIR=""
META=""
OUT=""

# (Re)creates ${TABLE} with extra table settings $1 (leading comma); over an existing directory
# `IF NOT EXISTS` attaches to the data already there.
create()
{
    local engine
    if [ "${STORAGE}" = local ]; then
        engine="IcebergLocal('${DIR}/', 'Parquet')"
    else
        engine="IcebergS3(s3_conn, filename = '${S3_ROOT}/${TABLE}/', format = Parquet)"
    fi
    $CH -q "DROP TABLE IF EXISTS ${TABLE}"
    $CH -q "CREATE TABLE IF NOT EXISTS ${TABLE} (x Int) ENGINE = ${engine}
            SETTINGS iceberg_format_version = ${FORMAT_VERSION:-2}, allow_experimental_iceberg_compaction = 0 $1"
}

# $1 storage, $2 table name, $3 rows to insert one per commit, $4 extra table settings (leading comma).
# Drops the previous table. FORMAT_VERSION defaults to 2.
populate()
{
    [ -n "${TABLE}" ] && $CH -q "DROP TABLE IF EXISTS ${TABLE}"
    STORAGE=$1
    TABLE="t_$2_$1_${CLICKHOUSE_DATABASE}"
    DIR="${LOCAL_ROOT}/${TABLE}"
    META="${DIR}/metadata"
    create "$4"
    $CH -q "$(for i in $(seq "$3"); do echo "INSERT INTO ${TABLE} VALUES ($i);"; done)"
}

# Plants an unreferenced file at the table-relative path $1.
add_orphan()
{
    if [ "${STORAGE}" = local ]; then
        mkdir -p "$(dirname "${DIR}/$1")"
        echo orphan_data > "${DIR}/$1"
    else
        $CH -q "INSERT INTO FUNCTION s3(s3_conn, filename = '${S3_ROOT}/${TABLE}/$1', format = RawBLOB, structure = 'data String')
                SELECT 'orphan_data' SETTINGS s3_truncate_on_insert = 1"
    fi
}

# Table-relative paths of every object under the table.
list_files()
{
    if [ "${STORAGE}" = local ]; then
        (cd "${DIR}" && find . -type f | sed 's|^\./||' | sort)
    else
        $CH -q "SELECT replaceOne(_path, 'test/${S3_ROOT}/${TABLE}/', '') AS p
                FROM s3(s3_conn, filename = '${S3_ROOT}/${TABLE}/**', format = One) ORDER BY p"
    fi
}

exists()
{
    if list_files | grep -qxF "$1"; then echo "$1 present"; else echo "$1 absent"; fi
}

data()
{
    $CH -q "SELECT groupArray(x) FROM (SELECT x FROM ${TABLE} ORDER BY x)"
}

# Waits past the second the newest file was written in, then prints a timestamp older than it.
now_ts()
{
    sleep 1.1
    $CH -q "SELECT toString(now())"
}

# Runs the command with arguments $1 (extra client options in $2) and keeps its metric rows in OUT.
remove_orphans()
{
    # shellcheck disable=SC2086
    OUT=$($CH $2 -q "ALTER TABLE ${TABLE} EXECUTE remove_orphan_files($1)")
}

# Prints "<metric> <value>" from the last run.
metric()
{
    awk -F'\t' -v m="$1" '$1 == m { print m, $2 }' <<< "${OUT}"
}

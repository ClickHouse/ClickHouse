-- with the filter: the first join is the one by k
Expression ((Project names + Projection))
  Aggregating
    Expression ((Before GROUP BY + ))
      Expression (Post Join Actions)
        Join (JOIN FillRightFirst)
          Expression (Left Pre Join Actions)
            Expression (Post Join Actions)
              Join (JOIN FillRightFirst)
                Expression (Left Pre Join Actions)
                  Expression ((WHERE + (Change column names to column identifiers + (Project names + (Projection + Change column names to column identifiers)))))
                    Filter (((WHERE + (Change column names to column identifiers + (Project names + (Projection + Change column names to column identifiers)))))[split])
                      ReadFromMergeTree (default.t_passed_key_left)
                Expression (Right Pre Join Actions)
                  Expression (Change column names to column identifiers)
                    ReadFromMergeTree (default.t_passed_key_right)
          Expression (Right Pre Join Actions)
            Expression (Change column names to column identifiers)
              ReadFromMergeTree (default.t_passed_key_third)
-- without the filter: the same join order
Expression ((Project names + Projection))
  Aggregating
    Expression (Before GROUP BY)
      Expression (Post Join Actions)
        Join (JOIN FillRightFirst)
          Expression (Left Pre Join Actions)
            Expression (Post Join Actions)
              Join (JOIN FillRightFirst)
                Expression (Left Pre Join Actions)
                  Expression ((Change column names to column identifiers + (Project names + (Projection + Change column names to column identifiers))))
                    ReadFromMergeTree (default.t_passed_key_left)
                Expression (Right Pre Join Actions)
                  Expression (Change column names to column identifiers)
                    ReadFromMergeTree (default.t_passed_key_right)
          Expression (Right Pre Join Actions)
            Expression (Change column names to column identifiers)
              ReadFromMergeTree (default.t_passed_key_third)

-- Tags: no-old-analyzer

-- The build side of a block nested loop join is memory-bounded: it is compressed once it grows
-- past `cross_join_min_rows_to_compress`, and streamed to a temporary file once it holds more than
-- `max_bytes_before_external_join`. Neither changes the result.
--
-- That the spill really happens - and so that the comparisons below do not hold vacuously - is what
-- `05024_block_nested_loop_join_spill_accounting` asserts.
--
-- `partial_merge` keeps `INNER` from taking the `CROSS JOIN` + filter route, so every kind below is
-- answered by the operator.

SET cross_to_inner_join_rewrite = 0;
SET join_use_nulls = 0;
SET join_algorithm = 'partial_merge';

DROP TABLE IF EXISTS bnl_spill_probe;
DROP TABLE IF EXISTS bnl_spill_build;

CREATE TABLE bnl_spill_probe (id Int32, x Int32) ENGINE = MergeTree ORDER BY id;
CREATE TABLE bnl_spill_build (id Int32, y Int32, s String) ENGINE = MergeTree ORDER BY id;
INSERT INTO bnl_spill_probe SELECT number, number % 9 FROM numbers(40);
INSERT INTO bnl_spill_build SELECT number, number % 6, repeat('x', number % 11) FROM numbers(30);

-- One kind per way the probe reads the store: `FULL` walks every pair and then scans the store a
-- second time for the build rows nothing matched, `LEFT ANY` abandons the walk as soon as a probe row
-- is settled, and `RIGHT SEMI` claims build rows and answers from the match flags alone. `INNER`,
-- `LEFT`, `RIGHT` and `LEFT ANTI` each read the store one of those three ways.
--
-- `LEFT ANY` and `RIGHT SEMI` take one pair per row of the side that drives them, and which pair that
-- is stays open - the probe streams race for a build row. For those two only the driving side's rows
-- are compared; `FULL` emits a fixed set of pairs.
{% for kind, emitted in [
    ('FULL', '(l.id, r.id)'),
    ('LEFT ANY', 'l.id'),
    ('RIGHT SEMI', 'r.id')] -%}

SELECT '{{ kind }}';

SELECT 'routed', count() FROM (
    EXPLAIN SELECT count() FROM bnl_spill_probe l {{ kind }} JOIN bnl_spill_build r ON l.x < r.y)
WHERE explain LIKE '%BlockNestedLoopJoin%';

-- A build side split into several blocks, all of them written to disk and read back for every probe
-- chunk, answers exactly as one that stayed in memory.
SELECT 'spilled',
    (SELECT arraySort(groupArray({{ emitted }})) FROM bnl_spill_probe l {{ kind }} JOIN bnl_spill_build r ON l.x < r.y
     SETTINGS max_bytes_before_external_join = 1, max_block_size = 6)
  = (SELECT arraySort(groupArray({{ emitted }})) FROM bnl_spill_probe l {{ kind }} JOIN bnl_spill_build r ON l.x < r.y
     SETTINGS max_bytes_before_external_join = 0, max_bytes_ratio_before_external_join = 0) AS ok;

SELECT 'compressed',
    (SELECT arraySort(groupArray({{ emitted }})) FROM bnl_spill_probe l {{ kind }} JOIN bnl_spill_build r ON l.x < r.y
     SETTINGS cross_join_min_rows_to_compress = 1, max_block_size = 6)
  = (SELECT arraySort(groupArray({{ emitted }})) FROM bnl_spill_probe l {{ kind }} JOIN bnl_spill_build r ON l.x < r.y
     SETTINGS max_bytes_before_external_join = 0, max_bytes_ratio_before_external_join = 0) AS ok;

{% endfor -%}

-- Each build stream spills to a temporary file of its own, so a spilled block's place in the store is
-- its file and its position in that file rather than the order it arrived in. Two build streams that
-- both store blocks are what that needs, and a `UNION ALL` of two sources is how to get them: each
-- branch is a stream of its own with rows of its own, and `max_threads = 2` leaves the pipeline no
-- reason to resize them - a resize would hand the blocks to whichever stream asked first instead.
{% set union_build = "(SELECT number % 6 AS y FROM numbers(15) UNION ALL SELECT number % 6 AS y FROM numbers(15, 15))" -%}
SELECT 'many files',
    (SELECT arraySort(groupArray((l.id, r.y))) FROM bnl_spill_probe l FULL JOIN {{ union_build }} r
     ON l.x < r.y SETTINGS max_bytes_before_external_join = 1, max_threads = 2, max_block_size = 6)
  = (SELECT arraySort(groupArray((l.id, r.y))) FROM bnl_spill_probe l FULL JOIN {{ union_build }} r
     ON l.x < r.y SETTINGS max_bytes_before_external_join = 0, max_bytes_ratio_before_external_join = 0) AS ok
-- Swapping the inputs would build the probe table instead, which is one stream and so one file.
SETTINGS query_plan_join_swap_table = 'false';

DROP TABLE bnl_spill_probe;
DROP TABLE bnl_spill_build;

SELECT count(), sum(c) FROM t_exclusion_search_unknown_atoms
WHERE b BETWEEN 2000 AND 7000
SETTINGS merge_tree_generic_exclusion_search_max_steps = 500, log_comment = '05232_unknown_atoms range budget';

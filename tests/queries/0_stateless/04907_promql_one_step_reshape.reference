-- sum by (dc) (m)
[('dc','a')]	3
[('dc','b')]	3
-- max by (dc) (m)
[('dc','a')]	2
[('dc','b')]	3
-- count by (dc) (m)
[('dc','a')]	2
[('dc','b')]	1
-- group by (dc) (m)
[('dc','a')]	1
[('dc','b')]	1
-- quantile by (dc) (0.5, m)
[('dc','a')]	1.5
[('dc','b')]	3
-- sum without (host) (m)
[('dc','a')]	3
[('dc','b')]	3
-- bare sum(m)
[]	6
-- c > 0
[('__name__','c'),('k','k2')]	5
-- c == 5
[('__name__','c'),('k','k2')]	5
-- c != 0
[('__name__','c'),('k','k2')]	5
[('__name__','c'),('k','k3')]	-2
-- c <= -2
[('__name__','c'),('k','k3')]	-2
-- 0 < c (scalar on the left)
[('__name__','c'),('k','k2')]	5
-- c > 100 (all rows dropped, empty result)
-- lm unless on (p) rm
[('__name__','lm'),('p','p1')]	5
[('__name__','lm'),('p','p3')]	7
-- lm unless on (p) (rm > 100) : right side empty, nothing removed
[('__name__','lm'),('p','p1')]	5
[('__name__','lm'),('p','p2')]	6
[('__name__','lm'),('p','p3')]	7
-- sum by (ns, pod) (max by (ns, pod) (pending)) > 0 unless on (ns, pod) (succeeded == 1)
[('ns','x'),('pod','p1')]	1
-- range: sum by (dc) (m)
[('dc','a')]	[('1970-01-01 00:01:40.000',3),('1970-01-01 00:01:50.000',3),('1970-01-01 00:02:00.000',3)]
[('dc','b')]	[('1970-01-01 00:01:40.000',3),('1970-01-01 00:01:50.000',3),('1970-01-01 00:02:00.000',3)]
-- range: c > 0
[('__name__','c'),('k','k2')]	[('1970-01-01 00:01:40.000',5),('1970-01-01 00:01:50.000',5),('1970-01-01 00:02:00.000',5)]
-- range: lm unless on (p) rm
[('__name__','lm'),('p','p1')]	[('1970-01-01 00:01:40.000',5),('1970-01-01 00:01:50.000',5),('1970-01-01 00:02:00.000',5)]
[('__name__','lm'),('p','p3')]	[('1970-01-01 00:01:40.000',7),('1970-01-01 00:01:50.000',7),('1970-01-01 00:02:00.000',7)]

-- database engine
Remote
-- SHOW TABLES lists the remote tables
t
-- each table is exposed as a Distributed storage
Distributed
-- DESCRIBE reflects the remote structure
id	UInt64
s	String
-- SELECT is forwarded to the remote server
1	a
2	b
3	c
-- INSERT is forwarded to the remote server
1	a
2	b
3	c
4	d
-- SHOW CREATE TABLE preserves column defaults, aliases and materialized expressions
ALIAS a + 2
DEFAULT a + 1
MATERIALIZED a + 3
-- EXISTS TABLE for an existing and a missing table
1
0
-- a SELECT from a missing table reports UNKNOWN_TABLE and must not recurse into the name hints
1
-- a database that refers to itself is rejected instead of recursing (prints 1 if the expected error is raised)
1
-- a chain of Remote databases that refers to itself terminates instead of recursing
1
-- a remote failure on table resolution is reported as the real error, not as UNKNOWN_TABLE
1
0
-- DDL against a Remote database is not supported (prints 1 if the expected error is raised)
1
1
-- the password is masked in SHOW CREATE DATABASE (0 = not leaked, 1 = [HIDDEN] shown)
0
1

#!/usr/bin/expect -f

# The client no longer pings the server before every query; it checks without a round trip whether
# the connection is still usable. A connection that the server really has closed must still be
# re-established transparently: closing it makes the socket readable, which is what the check looks
# for. `idle_connection_timeout = 0` makes the server close the connection as soon as it becomes
# idle, and the delay below makes sure the client sees the closed socket rather than racing with it.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0

log_user 0
set timeout 60
match_max 100000
expect_after {
    # Do not ignore eof from expect
    -i $any_spawn_id eof { exp_continue }
    # A default timeout action is to do nothing, change it to fail
    -i $any_spawn_id timeout { exit 1 }
}

spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT"
expect ":) "

send -- "SET idle_connection_timeout = 0\r"
expect ":) "

send -- "SELECT 'first_query'\r"
expect "first_query"
expect ":) "

# The server closes the connection right after the query, because it is idle. Wait until the client
# socket has certainly become readable.
sleep 3

# The client must notice the closed connection and reconnect, instead of running into an error.
send -- "SELECT 'second_query'\r"
expect "Connected to"
expect "second_query"
expect ":) "

send -- "\4"
expect eof

-- two info series with the same identifying labels at the same time
info(metric) from 0 to 600 step 300
info(metric2) from 0 to 600 step 300
[('__name__','metric2'),('instance','a'),('job','1'),('v','x')]	[(0,7)]
info(other) from 0 to 600 step 300
[('__name__','other'),('instance','c'),('job','3')]	[(0,1),(300000,1),(600000,1)]
-- a label selector whose every matcher matches the empty string
info(metric, {__name__!="metric"}) from 0 to 600 step 300
[('__name__','metric'),('data','info'),('instance','a'),('job','1')]	[(0,1),(300000,1),(600000,1)]
info(metric, {__name__!="metric", data=~".*"}) from 0 to 600 step 300
[('__name__','metric'),('data','info'),('instance','a'),('job','1')]	[(0,1),(300000,1),(600000,1)]
info(metric, {}) from 0 to 600 step 300
[('__name__','metric'),('data','info'),('instance','a'),('job','1')]	[(0,1),(300000,1),(600000,1)]
-- an info series appearing and disappearing within the range, a base series with only one identifying label
info(metric) from 0 to 600 step 300
[('__name__','metric'),('data','mid'),('instance','a'),('job','1')]	[(300000,1)]
[('__name__','metric'),('instance','a'),('job','1')]	[(0,0),(600000,2)]
info(job_only) from 0 to 600 step 300
[('__name__','job_only'),('data','job only'),('job','1')]	[(0,3),(300000,3),(600000,3)]
info({__name__=~"metric|job_only"}) from 0 to 600 step 300
[('__name__','job_only'),('job','1')]	[(0,3),(300000,3),(600000,3)]
[('__name__','metric'),('data','mid'),('instance','a'),('job','1')]	[(300000,1)]
[('__name__','metric'),('instance','a'),('job','1')]	[(0,0),(600000,2)]
label values with special characters are matched literally
[('__name__','metric'),('data','x'),('instance','a.b'),('job','j"1')]

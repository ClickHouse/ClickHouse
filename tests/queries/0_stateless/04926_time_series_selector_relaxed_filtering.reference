-- a matrix result gets an explicit timestamp filter: no out-of-range samples leak
[('__name__','foo'),('env','dev')]	[('1970-01-01 00:04:10.000',20)]
[('__name__','foo'),('env','prod')]	[('1970-01-01 00:03:20.000',2),('1970-01-01 00:05:00.000',3)]
[('__name__','foo'),('env','dev')]	[('1970-01-01 00:04:10.000',20)]
[('__name__','foo'),('env','prod')]	[('1970-01-01 00:03:20.000',2),('1970-01-01 00:05:00.000',3)]

1	0
-- PromQL results are identical with relaxed and exact filtering
[]	1970-01-01 00:04:10.000	22
[]	1970-01-01 00:04:10.000	22
[('env','dev')]	1970-01-01 00:06:40.000	1
[('env','prod')]	1970-01-01 00:06:40.000	1
[('env','dev')]	1970-01-01 00:06:40.000	1

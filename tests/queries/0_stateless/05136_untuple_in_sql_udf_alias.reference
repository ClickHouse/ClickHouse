-- UDF with alias
scope.app	scope.endpoint
web-api	/pay
-- same expression without UDF
scope.app	scope.endpoint
web-api	/pay
-- nested UDF with alias
scope.app	scope.endpoint
web-api	/pay
-- WITH lambda with alias
scope.app	scope.endpoint
web-api	/pay
-- result columns are addressable by the aliased names
scope.app	scope.endpoint
web-api	/pay
-- alias on a column, UDF over a table
scope.app	scope.endpoint
cli	/login
web-api	/pay
-- untuple nested inside the body keeps its own naming
t
('web-api','/pay')
-- alias inside the UDF body is used when the call has none
innerscope.app	innerscope.endpoint
web-api	/pay
-- alias of the call takes priority over the alias inside the body
scope.app	scope.endpoint
web-api	/pay
-- the outermost alias wins across nested UDFs
midscope.app	midscope.endpoint
web-api	/pay
scope.app	scope.endpoint
web-api	/pay
-- matcher body ignores the alias
a	b
1	2
-- an APPLY lambda inside the body is not a call: its columns keep their own names and values
tupleElement((a), \'1\')	tupleElement((b), \'1\')
1	2
tupleElement((a), \'1\')	tupleElement((b), \'1\')
1	2
-- without an alias the columns are named after the call, so calls with different arguments do not collide
tupleElement(test_pair_05136(1), \'1\')	tupleElement(test_pair_05136(2), \'1\')
1	2
tupleElement(test_pair_05136(1), \'1\')	tupleElement(test_pair_05136(2), \'1\')
1	2
tupleElement(test_pair_05136(a), \'1\')	tupleElement(test_pair_05136(plus(a, 1)), \'1\')
1	2
tupleElement(test_scope_nested_05136(\'web-api\', \'/pay\'), \'app\')	tupleElement(test_scope_nested_05136(\'web-api\', \'/pay\'), \'endpoint\')	tupleElement(test_scope_nested_05136(\'cli\', \'/login\'), \'app\')	tupleElement(test_scope_nested_05136(\'cli\', \'/login\'), \'endpoint\')
web-api	/pay	cli	/login
tupleElement(lambda_pair(1), \'1\')	tupleElement(lambda_pair(2), \'1\')
1	2
-- names inside the body are untouched: tuple fields are still named after the parameter
1
Tuple(\n    x UInt8)	Tuple(\n    x UInt8)
s.x

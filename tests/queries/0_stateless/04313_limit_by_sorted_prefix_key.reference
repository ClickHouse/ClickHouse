-- { echo }


SELECT number AS a, number + 1 AS b, number % 3 AS g FROM numbers(15) ORDER BY g, number LIMIT 1 BY g SETTINGS enable_analyzer = 1;
0	1	0
1	2	1
2	3	2
SELECT number AS a, number + 1 AS b, number % 3 AS g FROM numbers(15) ORDER BY g, number LIMIT -1 BY g SETTINGS enable_analyzer = 1;
12	13	0
13	14	1
14	15	2

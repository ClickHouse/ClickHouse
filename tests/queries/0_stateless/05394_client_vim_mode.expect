#!/usr/bin/expect -f

# Editing with the `--vim` keymap of the client. Every query is edited so that its result differs
# from any text displayed while typing it, so that matching the result checks the edit.
# Escape is followed by a pause much longer than the escape delay of the vim mode (10 ms), so that it
# is not read as Meta. The pause is short, so that the test fits into the time limit of the fast test.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0
set history_file $CLICKHOUSE_TMP/$basename.history

log_user 0
set timeout 60
match_max 100000

expect_after {
    # Do not ignore eof from expect
    -i $any_spawn_id eof { exp_continue }
    # A default timeout action is to do nothing, change it to fail
    -i $any_spawn_id timeout { exit 1 }
}

proc escape {} {
    send -- "\033"
    sleep 0.1
}

# Ctrl-J submits the query: Enter inserts a new line in the vim mode.
proc submit {} {
    send -- "\n"
}

spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --history_file=$history_file --vim"
expect ":) "

# `;` before any `f`, `F`, `t` or `T` fails and cancels the pending operator, so `w` only moves.
# This must run before any find in the session.
send -- "SELECT 1000+123"
escape
send -- "07ld;wx"
submit
expect "1000123"
expect ":) "

# Multibyte characters: Escape, a motion and a deletion around `é`.
send -- "SELECT concat('ab', 'éa')"
escape
send -- "hhx"
submit
expect "abé"
expect ":) "

# `dh` deletes the character before the cursor.
send -- "SELECT 1000+123"
escape
send -- "dh"
submit
expect "1013"
expect ":) "

# `dl` deletes the last character.
send -- "SELECT 2000+456"
escape
send -- "dl"
submit
expect "2045"
expect ":) "

# `de` deletes the last character when it is the end of the word.
send -- "SELECT 4000+12"
escape
send -- "de"
submit
expect "4001"
expect ":) "

# `dj` deletes the current and the next line.
send -- "SELECT 3000 + 1\r+ 7\r+ 8"
escape
send -- "kdj"
submit
expect "3001"
expect ":) "

# A query submitted with a pending operator does not leave it to the next input,
# which starts in insert mode.
send -- "SELECT 5000+1"
escape
send -- "d"
submit
expect "5001"
expect ":) "
send -- "SELECT 5000+2"
submit
expect "5002"
expect ":) "

# A paste in normal mode, and with a pending motion, inserts the text.
send -- "SELECT 6000+1 "
escape
send -- "\033\[200~2\033\[201~"
submit
expect "6012"
expect ":) "

send -- "SELECT 7000+1 "
escape
send -- "f\033\[200~3\033\[201~"
submit
expect "7013"
expect ":) "

# Repeating `t` and `T` with `;` skips the previous match.
send -- "SELECT concat('a,b,c', '!')"
escape
send -- "0f't,;x"
submit
expect "a,,c!"
expect ":) "

send -- "SELECT concat('x,y,z', '?')"
escape
send -- "0f';T,;x"
submit
expect "x,,z?"
expect ":) "

# `t` selects the character under the cursor when the target is right after it.
send -- "SELECT 1100+21"
escape
send -- "hdt1"
submit
expect "1101"
expect ":) "

send -- "SELECT 2100+21"
escape
send -- "hct14"
submit
expect "2141"
expect ":) "

# The character of `r` and `f` can be a multibyte one.
send -- "SELECT concat('ab', 'c')"
escape
send -- "0f'lré"
submit
expect "ébc"
expect ":) "

send -- "SELECT concat('éqz', 'w')"
escape
send -- "0féx"
submit
expect "qzw"
expect ":) "

# An operator applies to the Enter motion linewise.
send -- "SELECT 8000\r+ 3\r+ 9\r+ 20"
escape
send -- "kkd\r"
submit
expect "8020"
expect ":) "

send -- "SELECT 9000\r+ 3\r+ 9\r+ 40"
escape
send -- "kkc\r+ 1"
submit
expect "9041"
expect ":) "

# `dd` and `dG` on the last line leave the cursor on the first non-blank of the remaining last line.
send -- "SELECT 1200\r+ 34"
escape
send -- "ddwi9"
submit
expect "91200"
expect ":) "

send -- "SELECT 1300\r+ 34"
escape
send -- "dGwi9"
submit
expect "91300"
expect ":) "

# Ctrl-P in insert mode recalls the previous query and keeps editing it at its end.
send -- "SELECT 1400+1"
submit
expect "1401"
expect ":) "
send -- "\x10"
send -- "0"
submit
expect "1410"
expect ":) "

# Ctrl-P in normal mode recalls the previous query with the cursor on its last character.
send -- "SELECT 1500+12"
submit
expect "1512"
expect ":) "
escape
send -- "\x10"
send -- "x"
submit
expect "1501"
expect ":) "

# The regular history search (Ctrl-T) works in normal mode and stays in normal mode.
send -- "SELECT 1600+17"
submit
expect "1617"
expect ":) "
send -- "SELECT 3"
escape
send -- "\x14"
send -- "1600"
expect "1600+17"
send -- "\r"
send -- "\$x"
submit
expect "1601"
expect ":) "

# `x` on a one-character buffer leaves the buffer empty.
send -- "X"
escape
send -- "x"
send -- "iSELECT 1700+1"
submit
expect "1701"
expect ":) "

# `dd` on the last (and only) line leaves the buffer empty.
send -- "SELECT garbage"
escape
send -- "dd"
send -- "iSELECT 1800+2"
submit
expect "1802"
expect ":) "

# Enter on an empty buffer inserts a new line.
send -- "\r"
send -- "SELECT 1900+3"
submit
expect "1903"
expect ":) "

# A counted Enter past the last line stays inside the buffer: on a one-line buffer and on an
# empty buffer there is no next line, so it neither moves nor deletes anything.
send -- "SELECT 2100+56"
escape
send -- "d20\r20\rx"
submit
expect "2105"
expect ":) "

escape
send -- "d20\r20\r"
send -- "iSELECT 2200+1"
submit
expect "2201"
expect ":) "

# A counted Enter stops on the last line.
send -- "SELECT 2300\r+ 4\r+ 50"
escape
send -- "gg20\rwx"
submit
expect "2304"
expect ":) "

# A count on `$` moves to the end of a following line.
send -- "SELECT 2500 + 1\r+ 2\r+ 30"
escape
send -- "gg2\$x"
submit
expect "2531"
expect ":) "

# `D` and `C` take the count of `$`.
send -- "SELECT 2600 + 7\r+ 2\r+ 30"
escape
send -- "ggf72D"
submit
expect "2630"
expect ":) "

send -- "SELECT 2800 + 7\r+ 2\r+ 30"
escape
send -- "ggf72C1"
submit
expect "2831"
expect ":) "

# Over several lines from the start of a line, `D` is linewise.
send -- "garbage\r+ more\rSELECT 2700+5"
escape
send -- "gg2DA0"
submit
expect "2750"
expect ":) "

# A count on `$` fails on the last line.
send -- "SELECT 2900+56"
escape
send -- "2Dx"
submit
expect "2905"
expect ":) "

# `db` and `cb` from the start of a line keep the preceding line break.
send -- "SELECT 3100 -- note\r+ 23"
escape
send -- "0db"
submit
expect "3123"
expect ":) "

send -- "SELECT 3200 -- note\r+ 45"
escape
send -- "0cb1"
submit
expect "3245"
expect ":) "

# From the start of a line to the start of a previous one, `db` is linewise.
send -- "SELECT 3300\rgarbage\r+ 6"
escape
send -- "0db"
submit
expect "3306"
expect ":) "

# `G` moves to the first non-blank of the last line.
send -- "SELECT 3400\r  + 23"
escape
send -- "ggGi+ 1 -- "
submit
expect "3401"
expect ":) "

# `%` uses the first bracket after the cursor on the line.
send -- "SELECT 3500 + plus(20, 30)"
escape
send -- "0fpc%7"
submit
expect "3507"
expect ":) "

# `~` takes a count and moves the cursor forward.
send -- "SELECT 'abcd'"
escape
send -- "0fa3~"
submit
expect "ABCd"
expect ":) "

send -- "SELECT 'wxyz'"
escape
send -- "0fw~~"
submit
expect "WXyz"
expect ":) "

# `2S` changes two lines, like `2cc`.
send -- "garbage\r+ 23\r+ 45"
escape
send -- "gg2SSELECT 3600"
submit
expect "3645"
expect ":) "

# `%` and the bracket text objects ignore brackets inside quotes.
send -- "SELECT (length(')') + 20) + 3700"
escape
send -- "0f(c%5"
submit
expect "3705"
expect ":) "

send -- "SELECT length(')') + 3800"
escape
send -- "0f(ci('abc'"
submit
expect "3803"
expect ":) "

# Counted word objects continue across lines.
send -- "SELECT 3900 - 200\r- 30"
escape
send -- "gg0f2d2aw"
submit
expect "3870"
expect ":) "

send -- "SELECT 4000 - 200\r- 30"
escape
send -- "gg0f2d3iw"
submit
expect "3970"
expect ":) "

# An empty line is a word for `w`.
send -- "SELECT 4100\r\r+ 234"
escape
send -- "ggwwxi+ 1 -- "
escape
submit
expect "4335"
expect ":) "

# A line number past the end moves to the first non-blank of the last line.
send -- "SELECT 4200\r+ 234"
escape
send -- "gg99Gi+1 -- "
escape
submit
expect "4201"
expect ":) "

send -- "SELECT 4300\r+ 345"
escape
send -- "gg99ggi+2 -- "
escape
submit
expect "4302"
expect ":) "

# `j` and `k` keep the column relative to the input text, which does not include the prompt.
send -- "SELECT 4400\r+ 234"
escape
send -- "ggji+1 -- "
escape
submit
expect "4401"
expect ":) "

send -- "SELECT 4500\r+ 234"
escape
send -- "gg7ljkx"
submit
expect "734"
expect ":) "

# `aw` on trailing whitespace takes the line break and the word on the next line.
send -- "SELECT 4600  \r- 234"
escape
send -- "gg\$caw- "
escape
submit
expect "4366"
expect ":) "

# `aw` on an empty line takes it and the following word.
send -- "SELECT 4700 +\r\r- 234"
escape
send -- "ggjdaw"
submit
expect "4934"
expect ":) "

# Without a count, `aw` on a word takes the trailing whitespace only up to the end of the line.
send -- "SELECT 1000 -- comment word  \r+ 30"
escape
send -- "gg0fwdaw"
submit
expect "1030"
expect ":) "

# `%` does not match comparison operators: it uses the next parenthesis.
send -- "SELECT 1000 + if(1 > 0, (20 + 3), 40)"
escape
send -- "0f>c%, 7"
escape
submit
expect "1007"
expect ":) "

# A key without a binding cancels the pending operator, so the following motion only moves.
send -- "SELECT 1000 + 123"
escape
send -- "0f1dzwwx"
submit
expect "1023"
expect ":) "

# After `di` or `da`, a key that is not a text object cancels the command instead of running as a motion.
send -- "SELECT 1000+123"
escape
send -- "0f1di\$lx"
submit
expect "223"
expect ":) "

send -- "SELECT 2000+123"
escape
send -- "dihx"
submit
expect "2012"
expect ":) "

# `cw` on an empty line keeps the line break.
send -- "SELECT 1000\r\r+ 123"
escape
send -- "ggjcw-- comment"
escape
submit
expect "1123"
expect ":) "

# An operator applies to the Backspace motion, which wraps to the previous line.
send -- "SELECT 1000+123"
escape
send -- "d\x7f"
submit
expect "1013"
expect ":) "

send -- "SELECT 2000+123"
escape
# A separate `send`: old Tcl versions (e.g. on macOS) read all hex digits after `\x`.
send -- "c\x7f"
send -- "9"
escape
submit
expect "2193"
expect ":) "

send -- "SELECT 3000\r456"
escape
send -- "0d\x7f"
submit
expect "3000456"
expect ":) "

# A command that is not a motion cancels the pending operator instead of editing the text.
send -- "SELECT 1000+123"
escape
send -- "dxx"
submit
expect "1012"
expect ":) "

send -- "SELECT 2000+123"
escape
send -- "dr7"
submit
expect "2123"
expect ":) "

# Deleting the last character of a line followed by the empty last line keeps the cursor on that line.
send -- "SELECT 1000\r+ 234\r"
escape
send -- "k\$xi+1 -- "
escape
submit
expect "1003"
expect ":) "

# `x` that empties the last line keeps the cursor on that line.
send -- "SELECT 1000\r+1"
escape
send -- "02xi+ 23"
escape
submit
expect "1023"
expect ":) "

# After `$`, `j` and `k` go to the end of a line of a different length.
send -- "SELECT 100\r+ 23456789123"
escape
send -- "gg\$jxi+1 -- "
escape
submit
expect "234567992"
expect ":) "

send -- "SELECT 1 + 50000\r+ 2"
escape
send -- "\$kxi7"
escape
submit
expect "50073"
expect ":) "

# `ciw` and `ciW` on an empty line keep the line break and enter insert mode.
send -- "SELECT 1000\r\r+ 123"
escape
send -- "ggjciw-- comment"
escape
submit
expect "1123"
expect ":) "

send -- "SELECT 2000\r\r+ 123"
escape
send -- "ggjciW-- comment"
escape
submit
expect "2123"
expect ":) "

send -- "SELECT 3000 + 1\r"
escape
send -- "ciw+ 4"
escape
submit
expect "3005"
expect ":) "

# A counted operator on the Backspace motion continues across the line break.
send -- "SELECT 1000\r+ 2345"
escape
send -- "0d4\x7f"
send -- "i9"
escape
submit
expect "2364"
expect ":) "

# A counted `iw` or `iW` on an empty line also takes the following chunks.
send -- "SELECT 1000\r\r+ 23"
escape
send -- "ggj2ciw+ 1 --"
escape
submit
expect "1001"
expect ":) "

send -- "SELECT 2000\r\r+1 + 23"
escape
send -- "ggjd2iW"
submit
expect "2023"
expect ":) "

# `%` that scans from outside quotes onto a quoted bracket ignores quoted brackets.
send -- "SELECT 1000, '(' || 'a' || ')'"
escape
send -- "0f1%r9"
submit
expect "9000"
expect ":) "

# `cl` on an empty line selects nothing, but still enters insert mode.
send -- "SELECT 5000\r\r+ 23"
escape
send -- "ggjcl+ 9"
escape
submit
expect "5032"
expect ":) "

# `j` and `k` keep the display column: a wide character takes two columns.
send -- "SELECT concat('x',\r '你好abcd')"
escape
send -- "gg7ljx"
submit
expect "x你好acd"
expect ":) "

send -- "SELECT concat('ab你好cd',\r'0123456789abcdefghijk')"
escape
send -- "4hkx"
submit
expect "ab你cd0123456789abcdefghijk"
expect ":) "

# A tab takes several columns, so `j` from the third column lands on it.
# The tab is pasted: typing it would trigger completion.
send -- "SELECT 1000 +\r\033\[200~\t23\033\[201~"
escape
send -- "gg2ljx"
submit
expect "1023"
expect ":) "

# A counted `iw` skips the line break at the end of a non-empty line: the next chunk is the word on the next line.
send -- "SELECT 6100 + 7\r- 2345"
escape
send -- "gg\$d2iw"
submit
expect "8445"
expect ":) "

# An exclusive `w` or `W` motion that ends in the first column of a line keeps the line break before it.
send -- "SELECT 6200 -- note\r\r+ 34"
escape
send -- "gg\$d2w"
submit
expect "6234"
expect ":) "

send -- "SELECT 6300 -- note\r\r+ 34"
escape
send -- "gg\$d2W"
submit
expect "6334"
expect ":) "

# A linewise delete leaves the cursor on the first non-blank of the remaining line.
send -- "SELECT 6500\r  +234\rgarbage"
escape
send -- "ddwr-"
submit
expect "6466"
expect ":) "

send -- "SELECT 6600\r  +234\rgarbage"
escape
send -- "dGwr-"
submit
expect "6566"
expect ":) "

# `ce` and `cE` on an empty last line, and in an empty buffer, enter insert mode.
send -- "SELECT 6700\r"
escape
send -- "ce+ 9"
escape
submit
expect "6709"
expect ":) "

send -- "SELECT 6710\r"
escape
send -- "cE+ 9"
escape
submit
expect "6719"
expect ":) "

escape
send -- "ceSELECT 6720+1"
escape
submit
expect "6721"
expect ":) "

# A counted word object with too few chunks cancels the operation.
send -- "SELECT 6800 + 123"
escape
send -- "d2iw"
submit
expect "6923"
expect ":) "

send -- "SELECT 6810 + 123"
escape
send -- "d2aw"
submit
expect "6933"
expect ":) "

# A counted `iw` that ends on an empty line joins it with the previous line and keeps its line break.
send -- "SELECT 6900 -- note\r\r+ 234"
escape
send -- "gg\$d2iw"
submit
expect "7134"
expect ":) "

send -- "SELECT 6910 -- note\r\r+ 234"
escape
send -- "gg\$d2iW"
submit
expect "7144"
expect ":) "

# `v` after the operator makes a linewise motion characterwise exclusive.
send -- "SELECT 7000\r+ 123\r+ 234\r+ 345"
escape
send -- "ggj2ldvj"
submit
expect "7579"
expect ":) "

send -- "SELECT 7100\r+ 123\r+ 234\r345"
escape
send -- "ggj2ldvG"
submit
expect "7445"
expect ":) "

# A forced characterwise motion that ends in the first column ends at the end of the previous line.
send -- "SELECT 7200 -- note\r+ 234"
escape
send -- "gg\$dvG"
submit
expect "7434"
expect ":) "

# `v` also forces the doubled operators: up to the first non-blank of the line.
send -- "SELECT 7300 +\r1 + 234"
escape
send -- "G4ldvd"
submit
expect "7534"
expect ":) "

send -- "SELECT 7400 +\r1 + 234"
escape
send -- "G4lcvc9"
escape
submit
expect "16634"
expect ":) "

# `dvl` on the last character of a line deletes nothing, also not the line break.
send -- "SELECT 7500 -- note\r+ 234"
escape
send -- "gg\$dvl"
submit
expect "7734"
expect ":) "

send -- "SELECT 7600+123"
escape
send -- "dvl"
submit
expect "7723"
expect ":) "

# `dvl` within the line is inclusive, and exclusive when the count reaches past the end of the line.
send -- "SELECT 7700+1956"
escape
send -- "hhhdvl"
submit
expect "7756"
expect ":) "

send -- "SELECT 7800+1234"
escape
send -- "h5dvl"
submit
expect "7924"
expect ":) "

# Whitespace at the end of a line ends a counted word object before the line break.
send -- "SELECT 40000 -- note  \r+ 234"
escape
send -- "gg0fnd2iw"
submit
expect "40234"
expect ":) "

send -- "SELECT 40100 -- note  \r+ 234"
escape
send -- "gg0fnd2iW"
submit
expect "40334"
expect ":) "

send -- "SELECT 40200 -- note word  \r+ 234"
escape
send -- "gg0fnd2aw"
submit
expect "40434"
expect ":) "

# A counted `aw` that does not end with whitespace takes the whitespace before the word instead.
send -- "SELECT 40300 -- a note\r+ 234"
escape
send -- "gg0fad2aw"
submit
expect "40534"
expect ":) "

# A counted `aw` skips the line break at the end of a non-empty line, like `iw`.
send -- "SELECT 40400 -- a note\r+ 7\r+ 50"
escape
send -- "gg0fad3aw"
submit
expect "40450"
expect ":) "

# `w` that stops at the end of the input is inclusive, so `v` makes it exclusive.
send -- "SELECT 40500+123"
escape
send -- "dvw"
submit
expect "40623"
expect ":) "

send -- "SELECT 40900 -- note\r+ 234"
escape
send -- "gg0fndvw"
submit
expect "41134"
expect ":) "

# `v` makes the inclusive text objects exclusive.
send -- "SELECT 40600+123"
escape
send -- "dviw"
submit
expect "40603"
expect ":) "

send -- "SELECT 40700+(23)"
escape
send -- "dvi("
submit
expect "40703"
expect ":) "

send -- "SELECT 40800+(23)"
escape
send -- "cvi(9"
escape
submit
expect "40893"
expect ":) "

# A forced characterwise `gg` leaves the `g` prefix mode, so the next command runs.
send -- "SELECT 41000 +\r23 +\r234"
escape
send -- "d2vggi9"
escape
submit
expect "41094"
expect ":) "

# Counted `dd`, `cc` and `S` fail on the last line.
send -- "SELECT 41200\r+ 34"
escape
send -- "2dd"
submit
expect "41234"
expect ":) "

send -- "SELECT 41300\r+ 34"
escape
send -- "2cc9"
escape
submit
expect "41334"
expect ":) "

send -- "SELECT 41400\r+ 34"
escape
send -- "2S9"
escape
submit
expect "41434"
expect ":) "

# A counted `aw` without enough words before the end of the input cancels the operation.
send -- "SELECT 42000 + 123\r"
escape
send -- "k\$c2aw9"
escape
submit
expect "42123"
expect ":) "

send -- "SELECT 42100 + 123\r"
escape
send -- "k\$d2aw"
submit
expect "42223"
expect ":) "

# `aw` on whitespace without a following word cancels the operation.
send -- "SELECT 42200 + 123  "
escape
send -- "caw9"
escape
submit
expect "42323"
expect ":) "

# The inner object of a multiline block keeps the brackets on their own lines.
send -- "SELECT plus(\r42300,\r234\r) + 7"
escape
send -- "ggci(9100, 1 -- note"
escape
submit
expect "9108"
expect ":) "

send -- "SELECT (42400\r+ 234\r) + 7"
escape
send -- "ggci(42500"
escape
submit
expect "42507"
expect ":) "

send -- "SELECT plus(\r  42600,\r  234\r  ) + 7"
escape
send -- "ggci(42600, 9"
escape
submit
expect "42616"
expect ":) "

# `cv0` on an empty line keeps its line break.
send -- "SELECT 42700\r\r+ 234"
escape
send -- "ggjcv0-- note"
escape
submit
expect "42934"
expect ":) "

# An apostrophe in a comment does not hide the brackets after it.
send -- "SELECT (42800 -- it's a comment\r+ 234) + 7"
escape
send -- "ggci(42900"
escape
submit
expect "42907"
expect ":) "

send -- "SELECT (43000 // it's a comment\r+ 234) + 7"
escape
send -- "ggci(43100"
escape
submit
expect "43107"
expect ":) "

send -- "SELECT (43200 /* outer /* inner */ it's still a comment */\r+ 234) + 7"
escape
send -- "ggci(43300"
escape
submit
expect "43307"
expect ":) "

send -- "\4"
expect eof

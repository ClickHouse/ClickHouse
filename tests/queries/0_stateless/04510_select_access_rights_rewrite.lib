test_all_columns()
{
    cleanup_objects
    echo "all_columns"
    $CLICKHOUSE_CLIENT --query "CREATE TABLE table1_04510(d Date, a String, b UInt8) ENGINE = MergeTree ORDER BY d"
    assert_has "$(error_as_user "SELECT * FROM table1_04510")" "it's necessary to have the grant SELECT ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SHOW COLUMNS ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    assert_has "$(error_as_user "SELECT * FROM table1_04510")" "it's necessary to have the grant SELECT(d, a, b) ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT(d) ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    assert_has "$(error_as_user "SELECT * FROM table1_04510")" "it's necessary to have the grant SELECT(d, a, b) ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT(a) ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    assert_has "$(error_as_user "SELECT * FROM table1_04510")" "it's necessary to have the grant SELECT(d, a, b) ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT(b) ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    [ "$(query_as_user "SELECT * FROM table1_04510")" = "" ]
    echo "OK"
}


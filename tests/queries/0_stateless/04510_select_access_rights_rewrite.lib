test_alias()
{
    cleanup_objects
    echo "alias"
    $CLICKHOUSE_CLIENT --query "CREATE TABLE table1_04510(x Int32, y Int32) ENGINE = MergeTree ORDER BY tuple()"
    assert_has "$(error_as_user "SELECT x, y, x + y AS s FROM table1_04510")" "it's necessary to have the grant SELECT ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SHOW COLUMNS ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    assert_has "$(error_as_user "SELECT x, y, x + y AS s FROM table1_04510")" "it's necessary to have the grant SELECT(x, y) ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT(x, y) ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    [ "$(query_as_user "SELECT x, y, x + y AS s FROM table1_04510")" = "" ]
    echo "OK"
}

test_alias_columns()
{
    cleanup_objects
    echo "alias_columns"
    $CLICKHOUSE_CLIENT --query "CREATE TABLE table1_04510(x Int32, y Int32, s Int32 ALIAS x + y) ENGINE = MergeTree ORDER BY tuple()"
    assert_has "$(error_as_user "SELECT * FROM table1_04510")" "it's necessary to have the grant SELECT ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SHOW COLUMNS ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    assert_has "$(error_as_user "SELECT * FROM table1_04510")" "it's necessary to have the grant SELECT(x, y) ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT(x, y) ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    [ "$(query_as_user "SELECT * FROM table1_04510")" = "" ]
    assert_has "$(error_as_user "SELECT s FROM table1_04510")" "it's necessary to have the grant SELECT(s) ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT(s) ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    [ "$(query_as_user "SELECT s FROM table1_04510")" = "" ]
    $CLICKHOUSE_CLIENT --query "REVOKE SELECT(x, y) ON ${CLICKHOUSE_DATABASE}.table1_04510 FROM ${user_name}"
    [ "$(query_as_user "SELECT s FROM table1_04510")" = "" ]
    echo "OK"
}

test_materialized_columns()
{
    cleanup_objects
    echo "materialized_columns"
    $CLICKHOUSE_CLIENT --query "CREATE TABLE table1_04510(x Int32, y Int32, p Int32 MATERIALIZED x * y) ENGINE = MergeTree ORDER BY tuple()"
    assert_has "$(error_as_user "SELECT * FROM table1_04510")" "it's necessary to have the grant SELECT ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SHOW COLUMNS ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    assert_has "$(error_as_user "SELECT * FROM table1_04510")" "it's necessary to have the grant SELECT(x, y) ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT(x, y) ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    [ "$(query_as_user "SELECT * FROM table1_04510")" = "" ]
    assert_has "$(error_as_user "SELECT p FROM table1_04510")" "it's necessary to have the grant SELECT(p) ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT(p) ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    [ "$(query_as_user "SELECT p FROM table1_04510")" = "" ]
    $CLICKHOUSE_CLIENT --query "REVOKE SELECT(x, y) ON ${CLICKHOUSE_DATABASE}.table1_04510 FROM ${user_name}"
    [ "$(query_as_user "SELECT p FROM table1_04510")" = "" ]
    echo "OK"
}

test_select_join()
{
    cleanup_objects
    echo "select_join"
    $CLICKHOUSE_CLIENT --query "
        CREATE TABLE table1_04510(d Date, a String, b UInt8) ENGINE = MergeTree ORDER BY d;
        CREATE TABLE table2_04510(d Date, x UInt32, y UInt8) ENGINE = MergeTree ORDER BY d;
    "
    err="$(error_as_user "SELECT * FROM table1_04510 JOIN table2_04510 USING(d)")"
    assert_join_hint "$err" "table1_04510" "__none__" || assert_join_hint "$err" "table2_04510" "__none__"
    $CLICKHOUSE_CLIENT --query "
        GRANT SHOW COLUMNS ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name};
        GRANT SHOW COLUMNS ON ${CLICKHOUSE_DATABASE}.table2_04510 TO ${user_name};
    "
    err="$(error_as_user "SELECT * FROM table1_04510 JOIN table2_04510 USING(d)")"
    assert_join_hint "$err" "table1_04510" "d, a, b" || assert_join_hint "$err" "table2_04510" "d, x, y"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT(d, x, y) ON ${CLICKHOUSE_DATABASE}.table2_04510 TO ${user_name}"
    err="$(error_as_user "SELECT * FROM table1_04510 JOIN table2_04510 USING(d)")"
    assert_join_hint "$err" "table1_04510" "d, a, b"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT(d, a, b) ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    [ "$(query_as_user "SELECT * FROM table1_04510 JOIN table2_04510 USING(d)")" = "" ]
    $CLICKHOUSE_CLIENT --query "REVOKE SELECT ON ${CLICKHOUSE_DATABASE}.table2_04510 FROM ${user_name}"
    err="$(error_as_user "SELECT * FROM table1_04510 JOIN table2_04510 USING(d)")"
    assert_join_hint "$err" "table2_04510" "d, x, y"
    echo "OK"
}

test_select_union()
{
    cleanup_objects
    echo "select_union"
    $CLICKHOUSE_CLIENT --query "
        CREATE TABLE table1_04510(a String, b UInt8) ENGINE = MergeTree ORDER BY tuple();
        CREATE TABLE table2_04510(a String, b UInt8) ENGINE = MergeTree ORDER BY tuple();
    "
    assert_has "$(error_as_user "SELECT * FROM table1_04510 UNION ALL SELECT * FROM table2_04510")" "it's necessary to have the grant SELECT ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "
        GRANT SHOW COLUMNS ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name};
        GRANT SHOW COLUMNS ON ${CLICKHOUSE_DATABASE}.table2_04510 TO ${user_name};
    "
    assert_has "$(error_as_user "SELECT * FROM table1_04510 UNION ALL SELECT * FROM table2_04510")" "it's necessary to have the grant SELECT(a, b) ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT(a, b) ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    assert_has "$(error_as_user "SELECT * FROM table1_04510 UNION ALL SELECT * FROM table2_04510")" "it's necessary to have the grant SELECT(a, b) ON ${CLICKHOUSE_DATABASE}.table2_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT(a, b) ON ${CLICKHOUSE_DATABASE}.table2_04510 TO ${user_name}"
    [ "$(query_as_user "SELECT * FROM table1_04510 UNION ALL SELECT * FROM table2_04510")" = "" ]
    $CLICKHOUSE_CLIENT --query "REVOKE SELECT ON ${CLICKHOUSE_DATABASE}.table1_04510 FROM ${user_name}"
    assert_has "$(error_as_user "SELECT * FROM table1_04510 UNION ALL SELECT * FROM table2_04510")" "it's necessary to have the grant SELECT(a, b) ON ${CLICKHOUSE_DATABASE}.table1_04510"
    echo "OK"
}

test_select_count()
{
    cleanup_objects
    echo "select_count"
    $CLICKHOUSE_CLIENT --query "CREATE TABLE table1_04510(x String, y UInt8) ENGINE = MergeTree ORDER BY tuple()"
    assert_has "$(error_as_user "SELECT count() FROM table1_04510")" "it's necessary to have the grant SELECT ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT(x) ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    [ "$(query_as_user "SELECT count() FROM table1_04510")" = "0" ]
    $CLICKHOUSE_CLIENT --query "REVOKE SELECT(x) ON ${CLICKHOUSE_DATABASE}.table1_04510 FROM ${user_name}"
    assert_has "$(error_as_user "SELECT count() FROM table1_04510")" "it's necessary to have the grant SELECT ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT(y) ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    [ "$(query_as_user "SELECT count() FROM table1_04510")" = "0" ]
    $CLICKHOUSE_CLIENT --query "REVOKE SELECT(y) ON ${CLICKHOUSE_DATABASE}.table1_04510 FROM ${user_name}"
    assert_has "$(error_as_user "SELECT count() FROM table1_04510")" "it's necessary to have the grant SELECT ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    [ "$(query_as_user "SELECT count() FROM table1_04510")" = "0" ]
    echo "OK"
}

test_select_where()
{
    cleanup_objects
    echo "select_where"
    $CLICKHOUSE_CLIENT --query "
        CREATE TABLE table1_04510(a String, b UInt8) ENGINE = MergeTree ORDER BY b;
        INSERT INTO table1_04510 VALUES ('xxx', 0), ('yyy', 1), ('zzz', 0);
    "
    assert_has "$(error_as_user "SELECT a FROM table1_04510 WHERE b = 0")" "it's necessary to have the grant SELECT ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SHOW COLUMNS ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    assert_has "$(error_as_user "SELECT a FROM table1_04510 WHERE b = 0")" "it's necessary to have the grant SELECT(a, b) ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "
        GRANT SELECT(a) ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name};
        GRANT SELECT(b) ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name};
    "
    [ "$(query_as_user "SELECT a FROM table1_04510 WHERE b = 0")" = $'xxx\nzzz' ]
    $CLICKHOUSE_CLIENT --query "REVOKE SELECT ON ${CLICKHOUSE_DATABASE}.table1_04510 FROM ${user_name}"
    assert_has "$(error_as_user "SELECT a FROM table1_04510 WHERE b = 0")" "it's necessary to have the grant SELECT(a, b) ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    [ "$(query_as_user "SELECT a FROM table1_04510 WHERE b = 0")" = $'xxx\nzzz' ]
    echo "OK"
}


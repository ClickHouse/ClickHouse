#!/usr/bin/env bash

user_name="user_04510_a_${CLICKHOUSE_DATABASE}"

query_as_user()
{
    local query="$1"
    $CLICKHOUSE_CLIENT_BINARY --database="${CLICKHOUSE_DATABASE}" --user="${user_name}" --enable_analyzer=1 --query="$query"
}

error_as_user()
{
    local query="$1"
    $CLICKHOUSE_CLIENT_BINARY --database="${CLICKHOUSE_DATABASE}" --user="${user_name}" --enable_analyzer=1 --query="$query" 2>&1 || true
}

cleanup_objects()
{
    $CLICKHOUSE_CLIENT --query "
        CREATE USER OR REPLACE ${user_name};
        DROP ROW POLICY IF EXISTS pol1_04510 ON table1_04510;
        DROP TABLE IF EXISTS table1_04510;
        DROP TABLE IF EXISTS table2_04510;
    "
}

assert_has()
{
    local haystack="$1"
    local needle="$2"
    grep -Fq "$needle" <<<"$haystack"
}

assert_join_hint()
{
    local err="$1"
    local table="$2"
    local columns="$3"

    python3 - <<'PY' "$err" "$table" "$columns" "$CLICKHOUSE_DATABASE"
import re
import sys
err, table, columns, database = sys.argv[1:]
match = re.search(r"it's necessary to have the grant SELECT(?:\(([^)]*)\))? ON " + re.escape(f"{database}.{table}"), err)
if not match:
    raise SystemExit(1)
if columns == "__none__":
    raise SystemExit(0)
if match.group(1) is None:
    raise SystemExit(1)
got = {x.strip() for x in match.group(1).split(",")}
expected = {x.strip() for x in columns.split(",")}
raise SystemExit(0 if got == expected else 1)
PY
}

test_single_column()
{
    cleanup_objects
    echo "single_column"
    $CLICKHOUSE_CLIENT --query "CREATE TABLE table1_04510(d Date, a String, b UInt8) ENGINE = MergeTree ORDER BY d"
    assert_has "$(error_as_user "SELECT a FROM table1_04510")" "it's necessary to have the grant SELECT ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SHOW COLUMNS ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    assert_has "$(error_as_user "SELECT a FROM table1_04510")" "it's necessary to have the grant SELECT(a) ON ${CLICKHOUSE_DATABASE}.table1_04510"
    $CLICKHOUSE_CLIENT --query "GRANT SELECT(a) ON ${CLICKHOUSE_DATABASE}.table1_04510 TO ${user_name}"
    [ "$(query_as_user "SELECT a FROM table1_04510")" = "" ]
    $CLICKHOUSE_CLIENT --query "REVOKE SELECT(a) ON ${CLICKHOUSE_DATABASE}.table1_04510 FROM ${user_name}"
    assert_has "$(error_as_user "SELECT a FROM table1_04510")" "it's necessary to have the grant SELECT(a) ON ${CLICKHOUSE_DATABASE}.table1_04510"
    echo "OK"
}


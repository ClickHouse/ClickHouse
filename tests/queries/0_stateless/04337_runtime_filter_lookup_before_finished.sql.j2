-- Tags: long
-- long: the race needs many JOIN repetitions, which pushes a single debug run over the
-- `flaky check` 180s per-run limit; `long` exempts that limit and runs the test fewer times
-- under flaky check, without weakening the reproducer (all pins and the 8-part build side stay).

-- Regression test for the LOGICAL_ERROR "Trying to lookup values in runtime filter before
-- building it was finished" (server abort in debug/sanitizer builds).
--
-- A JOIN runtime filter is built on the right (build) side by N parallel streams; it only
-- becomes "finished" after the last stream merges. With join_overflow_mode='break' and a tiny
-- max_bytes_in_join the join stops reading the build side early, so the probe (left) side can
-- call IRuntimeFilter::find() while the filter is still unfinished. The query result is
-- intentionally not checked: join_overflow_mode='break' makes it non-deterministic, and the
-- point of the test is that find() must not throw. The race is probabilistic, so the query is
-- repeated; without the fix at least one repetition aborts the server with very high probability.
--
-- The per-repetition cost is dominated by the probe-side scan, so the probe is kept small to
-- stay fast under the debug/sanitizer `flaky check` (which runs the test many times with
-- randomized settings and enforces a 180s per-run limit). The repetitions are what make the
-- race reliable, so many cheap ones are used; only the per-repetition probe scan is trimmed.

DROP TABLE IF EXISTS rf_probe;
DROP TABLE IF EXISTS rf_build;

CREATE TABLE rf_probe (k UInt64) ENGINE = MergeTree ORDER BY k SETTINGS index_granularity = 128;
CREATE TABLE rf_build (k UInt64) ENGINE = MergeTree ORDER BY k SETTINGS index_granularity = 128;

-- Stop merges so the build side keeps several parts -> several parallel build streams (the
-- filter has more than one stream to merge, which is what opens the unfinished window).
SYSTEM STOP MERGES rf_probe;
SYSTEM STOP MERGES rf_build;

INSERT INTO rf_probe SELECT number FROM numbers(60000);
INSERT INTO rf_probe SELECT number FROM numbers(60000);

{% for p in range(8) -%}
INSERT INTO rf_build SELECT number + {{ p * 25000 }} FROM numbers(25000);
{% endfor %}

SET enable_analyzer = 1;
SET enable_join_runtime_filters = 1;
SET enable_parallel_replicas = 0;
SET join_algorithm = 'hash';
SET join_overflow_mode = 'break';
SET max_bytes_in_join = 1;
SET max_threads = 16;
SET max_block_size = 8192;
-- Pin the external-join spill threshold. The `flaky check` harness randomizes
-- max_bytes_before_external_join between 0 and 1000000000, and 0 closes the early-break window
-- and prevents the race from reproducing at all. Pin it to the harness's own nonzero value so
-- the reproducer is not silently disabled on randomized runs (a tiny value instead would force
-- grace-hash spilling and raise LIMIT_EXCEEDED before find() is ever reached).
SET max_bytes_before_external_join = 1000000000;
-- Pin the join build/probe side. The `flaky check` harness randomizes
-- query_plan_join_swap_table between 'auto' and 'false'; under 'auto' this ALL INNER JOIN
-- swaps whenever the left estimate is smaller (rf_probe = 120000 < rf_build = 200000), which
-- would build the filter from rf_probe and lose the unfinished-merge window this test stresses.
-- Pin to 0 (false) so rf_build always stays on the build side.
SET query_plan_join_swap_table = 0;
-- A fabricated probe-side row count from randomized join-order statistics can land at or below
-- the threshold, in which case no runtime filter is built and find() is never reached.
SET query_plan_optimize_join_order_randomize = 0;
SET join_runtime_filter_min_probe_rows = 0;

{% for i in range(60) -%}
SELECT count() FROM rf_probe AS l JOIN rf_build AS r ON l.k = r.k FORMAT Null;
{% endfor %}

SELECT 'ok';

DROP TABLE rf_probe;
DROP TABLE rf_build;

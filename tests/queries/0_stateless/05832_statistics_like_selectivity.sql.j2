-- PREWHERE order follows the statistics estimate of `LIKE`: a pattern without wildcards (also with `ESCAPE`) is estimated
-- as an equality, a pattern of only `%` as matching every non-NULL value, and other patterns, as well as the
-- `startsWith`/`endsWith` family that `LIKE 'p%'`/`LIKE '%s'` are rewritten to, by a default share of the non-NULL rows.

SET allow_statistics = 1, use_statistics = 1, materialize_statistics_on_insert = 1;
SET min_marks_per_part_to_load_statistics = 0;
SET optimize_move_to_prewhere = 1, allow_reorder_prewhere_conditions = 1;
SET explain_query_plan_default = 'legacy';

DROP TABLE IF EXISTS tab;

-- Compact parts: PREWHERE conditions are ordered by estimated rows alone.
CREATE TABLE tab (x UInt64, s String, n LowCardinality(Nullable(String)), f Nullable(FixedString(4)), e Nullable(Enum8('a' = 1, 'b' = 2)), a Array(UInt64))
ENGINE = MergeTree ORDER BY tuple()
SETTINGS auto_statistics_types = 'basic, uniq_v2', min_bytes_for_wide_part = 1000000000000, min_rows_for_wide_part = 1000000000000;

-- `s` has 10000 distinct values, `n`, `f` and `e` are NULL in 99% of the rows (the same rows).
INSERT INTO tab SELECT number, toString(number), if(number % 100 = 0, toString(number), NULL),
    if(number % 100 = 0, toFixedString(toString(number), 4), NULL), if(number % 100 = 0, 'a', NULL), [number % 10] FROM numbers(10000);

-- Each query prints 1 when the condition containing `first` comes before the one containing `second`.
-- The pattern is written first: PREWHERE keeps a condition that can throw (`ESCAPE`, `Enum`) behind the ones before it.
-- The `Array` overload of `startsWith` is not a LIKE and stays an unknown condition, after `less`.
{% for name, condition, first, second in [
    ("exact LIKE", "s LIKE '1234' AND x < 50", "like(", "less("),
    ("exact LIKE ESCAPE", "s LIKE '12#%' ESCAPE '#' AND x < 50", "like(", "less("),
    ("exact NOT LIKE", "s NOT LIKE '1234' AND x < 9950", "less(", "notLike("),
    ("exact ILIKE empty", "s ILIKE '' AND x < 50", "ilike(", "less("),
    ("exact FixedString LIKE", "f LIKE '1200' AND x < 5", "like(", "less("),
    ("LIKE %", "n LIKE '%' AND x < 500", "like(", "less("),
    ("LIKE % lower bound", "n LIKE '%' AND x < 50", "less(", "like("),
    ("ILIKE %", "n ILIKE '%' AND x < 500", "ilike(", "less("),
    ("ILIKE % lower bound", "n ILIKE '%' AND x < 50", "less(", "ilike("),
    ("NOT ILIKE %", "n NOT ILIKE '%' AND x < 50", "notILike(", "less("),
    ("prefix LIKE", "s LIKE '12%' AND x < 2000", "startsWith(", "less("),
    ("prefix LIKE lower bound", "s LIKE '12%' AND x < 500", "less(", "startsWith("),
    ("suffix LIKE", "s LIKE '%12' AND x < 2000", "endsWith(", "less("),
    ("suffix LIKE lower bound", "s LIKE '%12' AND x < 500", "less(", "endsWith("),
    ("prefix LIKE on NULLs", "n LIKE '12%' AND x < 50", "startsWith(", "less("),
    ("prefix LIKE on NULLs lower bound", "n LIKE '12%' AND x < 5", "less(", "startsWith("),
    ("NOT LIKE on NULLs", "n NOT LIKE '%12%' AND x < 500", "notLike(", "less("),
    ("NOT LIKE chain on NULLs", "n NOT LIKE '%1%' AND n NOT LIKE '%2%' AND x < 500", "notLike(", "less("),
    ("NOT LIKE chain on NULLs lower bound", "n NOT LIKE '%1%' AND n NOT LIKE '%2%' AND x < 50", "less(", "notLike("),
    ("startsWithUTF8", "startsWithUTF8(s, '12') AND x < 2000", "startsWithUTF8(", "less("),
    ("startsWith empty", "startsWith(n, '') AND x < 500", "startsWith(", "less("),
    ("startsWith empty lower bound", "startsWith(n, '') AND x < 50", "less(", "startsWith("),
    ("FixedString LIKE %", "f LIKE '%' AND x < 500", "like(", "less("),
    ("FixedString LIKE % lower bound", "f LIKE '%' AND x < 50", "less(", "like("),
    ("FixedString startsWith empty", "startsWith(f, '') AND x < 500", "startsWith(", "less("),
    ("FixedString startsWith empty lower bound", "startsWith(f, '') AND x < 50", "less(", "startsWith("),
    ("Enum LIKE %", "e LIKE '%' AND x < 500", "like(", "less("),
    ("Enum LIKE % lower bound", "e LIKE '%' AND x < 50", "less(", "like("),
    ("startsWith Array", "startsWith(a, [1]) AND x < 2000", "less(", "startsWith("),
] -%}
SELECT '{{ name }}', position(p, '{{ first }}') > 0 AND position(p, '{{ first }}') < position(p, '{{ second }}') FROM (
    SELECT arrayStringConcat(extractAll(arrayStringConcat(groupArray(explain), '\n'), 'Prewhere filter column: ([^\n]+)'), ' | ') AS p
    FROM (EXPLAIN actions = 1 SELECT count() FROM tab WHERE {{ condition }} SETTINGS optimize_rewrite_like_perfect_affix = 1));
{% endfor -%}

DROP TABLE tab;

--- user-named element wins over array sizes ---
memory	Array(UInt64)	[]
memory	Array(UInt64)	[100,200]
memory	Array(UInt64)	[300]
wide	Array(UInt64)	[]
wide	Array(UInt64)	[100,200]
wide	Array(UInt64)	[300]
compact	Array(UInt64)	[]
compact	Array(UInt64)	[100,200]
compact	Array(UInt64)	[300]
length	0
length	1
length	2
length no rewrite	0
length no rewrite	1
length no rewrite	2
c	Array(Tuple(\n    size0 UInt64))						0
c.size0	Array(UInt64)						1
--- the shadowed element and its own subcolumns are consistent ---
['abc']	[3]
--- JSON path wins over an automatic name in the same namespace ---
Array(Dynamic)	[7]
Array(Array(Dynamic))	Array(Array(Dynamic))
Array(Dynamic)	[9]
1	1
1	0	1
arr	Array(JSON)						0
arr2	Array(Array(JSON))						0
tup	Tuple(\n    x Array(JSON))						0
tup.x	Array(JSON)						1

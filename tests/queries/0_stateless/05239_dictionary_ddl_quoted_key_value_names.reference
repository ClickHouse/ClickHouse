CREATE DICTIONARY d (`k` UInt64) PRIMARY KEY k SOURCE(CLICKHOUSE(`my key` 1)) LIFETIME(MIN 0 MAX 0) LAYOUT(FLAT())
CREATE DICTIONARY d (`k` UInt64) PRIMARY KEY k SOURCE(`my src`(HOST 1)) LIFETIME(MIN 0 MAX 0) LAYOUT(FLAT())
CREATE DICTIONARY d (`k` UInt64) PRIMARY KEY k SOURCE(CLICKHOUSE(DB (`my src` (X 1)))) LIFETIME(MIN 0 MAX 0) LAYOUT(FLAT())
CREATE DICTIONARY d (`k` UInt64) PRIMARY KEY k SOURCE(CLICKHOUSE(HOST 1)) LIFETIME(MIN 0 MAX 0) LAYOUT(`my layout`())
CREATE DICTIONARY d (`k` UInt64) PRIMARY KEY k SOURCE(`my src`(`my key` (`my nested` (X 1)))) LIFETIME(MIN 0 MAX 0) LAYOUT(`my layout`())
CREATE DICTIONARY d (`k` UInt64) PRIMARY KEY k SOURCE(CLICKHOUSE(HOST \'localhost\' PORT 9000)) LIFETIME(MIN 1 MAX 2) LAYOUT(FLAT())
CREATE DICTIONARY d (`k` UInt64) PRIMARY KEY k SOURCE(NULL()) LIFETIME(MIN 0 MAX 0) LAYOUT(FLAT())

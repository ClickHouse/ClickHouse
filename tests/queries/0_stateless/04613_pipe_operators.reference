-- The resulting AST is the same as with nested subqueries
SELECT * FROM (SELECT * FROM (SELECT customer, sum(amount) AS total FROM (SELECT * FROM (SELECT * FROM orders) WHERE equals(cancelled, 0)) GROUP BY customer) ORDER BY total DESC) LIMIT 3
SELECT * FROM (SELECT * EXCEPT cancelled FROM (SELECT * REPLACE (plus(amount, 1) AS amount) FROM (SELECT * FROM orders))) AS t ALL LEFT JOIN big_orders AS b USING (customer)
SELECT * FROM (SELECT * FROM (SELECT * FROM orders) ORDER BY amount DESC) LIMIT 1, 2
WITH 100 AS threshold SELECT count() AS c FROM (WITH 100 AS threshold SELECT * FROM (WITH 100 AS threshold SELECT * FROM orders) WHERE greaterOrEquals(amount, threshold))
-- WITH RECURSIVE stays visible across pipe operators (requires the analyzer)

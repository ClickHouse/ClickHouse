oracle_plus_nullable_ip4	1
oracle_plus_lc_ip4	1
oracle_multiply_nullable_ip4	1
oracle_multiply_lc_ip4	1
oracle_multiply_nullable_ip6	1
-- numeric constant over an IP key, single-value granules
oracle_plus_const_left_ipkey	1
oracle_minus_const_left_ipkey	1

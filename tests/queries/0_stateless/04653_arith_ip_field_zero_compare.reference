oracle_plus_const_right_ipkey	1
oracle_minus_const_right_ipkey	1
oracle_multiply_const_right_ipkey	1
-- multiplying an IP key by a numeric constant must prune like the identical numeric key
oracle_multiply_ip4key	1
prune_multiply_ip4key_2of4	1
prune_multiply_u32key_2of4	1
oracle_multiply_ip6key	1
prune_multiply_ip6key_2of4	1

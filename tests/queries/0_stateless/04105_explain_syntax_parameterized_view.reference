SELECT *\nFROM\n(\n    SELECT number\n    FROM numbers(_CAST(15, \'UInt64\'))\n    WHERE greater(number, 10)\n) AS `04105_pv`
SELECT *\nFROM\n(\n    SELECT number\n    FROM numbers(_CAST(20, \'UInt64\'))\n    WHERE greater(number, _CAST(5, \'UInt64\'))\n) AS `04105_pv_multi`
SELECT *\nFROM\n(\n    SELECT number\n    FROM\n    (\n        SELECT number\n        FROM numbers(_CAST(5, \'UInt64\'))\n    ) AS `04105_pv_nested_inner`\n    WHERE greater(number, 0)\n) AS `04105_pv_nested_outer`
SELECT *\nFROM `04105_plain_view`
SELECT *\nFROM\n(\n    SELECT number\n    FROM\n    (\n        SELECT number\n        FROM numbers(_CAST(12, \'UInt64\'))\n        WHERE greater(number, 10)\n    ) AS `04105_pv`\n)
SELECT *\nFROM `04105_join_target`\nALL INNER JOIN\n(\n    SELECT number\n    FROM numbers(_CAST(10, \'UInt64\'))\n    WHERE greater(number, 10)\n) AS `04105_pv` USING (number)
SELECT t.number\nFROM\n(\n    SELECT number\n    FROM numbers(_CAST(10, \'UInt64\'))\n    WHERE greater(number, 10)\n) AS t
SELECT *\nFROM numbers(3)\nSETTINGS allow_experimental_analyzer = 1
SELECT *\nFROM `04105_modifiers_pv`(equals(n, 1))\nFINAL
SELECT count()\nFROM `04105_modifiers_pv`(equals(n, 1))\nSAMPLE 5 / 10
SELECT *\nFROM `04105_pv_security_none`(equals(n, 1))
SELECT *\nFROM `04105_pv_security_definer`(equals(n, 1))

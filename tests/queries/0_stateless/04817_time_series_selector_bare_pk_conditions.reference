-- timeSeriesSelector returns the same samples as a direct filtered read of the samples table
101	1970-01-01 00:01:40.000	1
101	1970-01-01 00:03:20.000	2
102	1970-01-01 00:02:30.000	10
102	1970-01-01 00:04:10.000	20
(direct read for comparison)
101	1970-01-01 00:01:40.000	1
101	1970-01-01 00:03:20.000	2
102	1970-01-01 00:02:30.000	10
102	1970-01-01 00:04:10.000	20
-- the SELECT over the samples table uses bare columns, time range first
1	1
-- a samples table whose physical type differs (here: by timezone only): bare conditions, cast in the outer SELECT
id	time_series
UInt64	Array(Tuple(DateTime64(3), Float64))
101	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',2)]
102	[('1970-01-01 00:02:30.000',10),('1970-01-01 00:04:10.000',20)]
-- the bare bucket condition comes before the id IN condition, and the time_series cast is in the outer SELECT
1	1

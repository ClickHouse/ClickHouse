ATTACH TABLE ts ENGINE = TimeSeries TAGS `inner` SETTINGS max_threads = 1
ATTACH TABLE ts ENGINE = TimeSeries SAMPLES s METRIC FAMILIES `Inner` SETTINGS max_threads = 1
ATTACH TABLE ts ENGINE = TimeSeries TAGS `engine` SAMPLES s
ATTACH TABLE ts ENGINE = TimeSeries TAGS `ttl` SETTINGS max_threads = 1
ATTACH TABLE ts ENGINE = TimeSeries TAGS `settings` COMMENT \'c\'
ATTACH TABLE ts ENGINE = TimeSeries TAGS inner.t SETTINGS max_threads = 1
ATTACH TABLE ts ENGINE = TimeSeries TAGS INNER ENGINE = Memory
CREATE MATERIALIZED VIEW mv TO inner AS SELECT 1
CREATE MATERIALIZED VIEW mv TO ttl AS SELECT 1
http_requests	counter	Total requests

SELECT\n    k,\n    r.k,\n    name\nFROM n\nALL INNER JOIN r ON equals(k, r.k)\nWHERE and(equals(k, r.k), equals(name, \'A\'))
SELECT\n    k,\n    r.k,\n    name\nFROM n\nALL INNER JOIN r ON equals(k, r.k)\nWHERE and(equals(k, r.k), like(name, \'A%\'))
SELECT\n    k,\n    r.k,\n    name\nFROM n\nALL INNER JOIN r ON equals(k, r.k)\nWHERE and(equals(k, r.k), notLike(name, \'A%\'))

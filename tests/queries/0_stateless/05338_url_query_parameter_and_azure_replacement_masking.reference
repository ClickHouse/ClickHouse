SELECT * FROM url(url_creds, url = 'https://example.com/data.csv?token=[HIDDEN]')
CREATE TABLE test_url (`key` UInt64) ENGINE = URL('https://example.com/data.csv?password=[HIDDEN]', 'CSV')

    `f` UInt64 COMMENT 'f newer comment' SETTINGS (max_compress_block_size = 4096),
    `g` UInt64 COMMENT 'g new comment' STATISTICS(uniq),
    `h` String EPHEMERAL COMMENT 'h comment',
    `i` UInt64 COMMENT 'i comment' CODEC(ZSTD(1)),
    `j` UInt64 COMMENT 'j comment' TTL d + toIntervalDay(2),
    `k` UInt64 COMMENT 'k comment' SETTINGS (max_compress_block_size = 1024),
    `s` UInt64 COMMENT 's comment' STATISTICS(tdigest)
)
ENGINE = MergeTree
ORDER BY a
SETTINGS index_granularity = 8192

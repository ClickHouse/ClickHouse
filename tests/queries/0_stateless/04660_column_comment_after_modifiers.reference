CREATE TABLE default.t_column_comment_order_pk
(
    `a` UInt64 COMMENT 'a comment',
    `b` UInt64
)
ENGINE = MergeTree
PRIMARY KEY tuple(a)
ORDER BY tuple(a)
SETTINGS index_granularity = 8192
CREATE TABLE t\n(\n    `a` UInt64 COMMENT \'a comment\' CODEC(ZSTD)\n)\nENGINE = Memory
CREATE TABLE t\n(\n    `a` UInt64 COMMENT \'a comment\' STATISTICS(tdigest)\n)\nENGINE = MergeTree\nORDER BY a
CREATE TABLE t\n(\n    `a` DateTime COMMENT \'a comment\' TTL a + toIntervalDay(1)\n)\nENGINE = MergeTree\nORDER BY a
CREATE TABLE t\n(\n    `a` String COMMENT \'a comment\' COLLATE utf8_bin\n)\nENGINE = Memory
CREATE TABLE t\n(\n    `a` String TTL now() COLLATE utf8_bin\n)\nENGINE = MergeTree\nORDER BY a
ALTER TABLE t\n    (MODIFY COLUMN `a` UInt64 COMMENT \'a comment\' CODEC(ZSTD))
ALTER TABLE t\n    (MODIFY COLUMN `a` COMMENT \'a comment\' SETTINGS (max_compress_block_size = 1024))
ALTER TABLE t\n    (MODIFY COLUMN `a` COMMENT \'a comment\' STATISTICS(tdigest))
CREATE TABLE t\n(\n    `a` String COMMENT \'a comment\' COLLATE utf8_bin\n)\nENGINE = Memory
CREATE TABLE t\n(\n    `a` String TTL now() COLLATE utf8_bin\n)\nENGINE = MergeTree\nORDER BY a

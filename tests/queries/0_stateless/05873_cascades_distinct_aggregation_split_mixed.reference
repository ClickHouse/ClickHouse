-- 1. a Nullable argument between two other aggregates: their states for each value of n, then count(n) and the merges
Expression ((Project names + Projection))
Actions: INPUT : 0 -> sum(__table1.y) UInt64 : 0
         INPUT : 1 -> uniqExact(__table1.n) UInt64 : 1
         INPUT :: 2 -> count() UInt64 : 2
         ALIAS sum(__table1.y) :: 0 -> sum(y) UInt64 : 3
         ALIAS uniqExact(__table1.n) :: 1 -> countDistinct(n) UInt64 : 0
Positions: 3 0 2
  MergingAggregated
  Keys:
  Aggregates:
      sum(__table1.y)
        Function: sumMerge(AggregateFunction(sum, UInt64)) → UInt64
        Arguments: sum(__table1.y)
      uniqExact(__table1.n)
        Function: count(Nullable(Int32)) → UInt64
        Arguments: __table1.n
      count()
        Function: countMerge(AggregateFunction(count)) → UInt64
        Arguments: count()
  Mode: memory-efficient
    GatherExchange
      Aggregating
      Keys:
      Aggregates:
          sum(__table1.y)
            Function: sumMerge(AggregateFunction(sum, UInt64)) → UInt64
            Arguments: sum(__table1.y)
          uniqExact(__table1.n)
            Function: count(Nullable(Int32)) → UInt64
            Arguments: __table1.n
          count()
            Function: countMerge(AggregateFunction(count)) → UInt64
            Arguments: count()
      Skip merging: 0
        MergingAggregated
        Keys: __table1.n
        Aggregates:
            sum(__table1.y)
              Function: sumState(UInt64) → AggregateFunction(sum, UInt64)
              Arguments: __table1.y
            count()
              Function: countState() → AggregateFunction(count)
              Arguments: none
          ShuffleExchange
            Aggregating
            Keys: __table1.n
            Aggregates:
                sum(__table1.y)
                  Function: sumState(UInt64) → AggregateFunction(sum, UInt64)
                  Arguments: __table1.y
                count()
                  Function: countState() → AggregateFunction(count)
                  Arguments: none
            Skip merging: 0
              Expression ((Before GROUP BY + Change column names to column identifiers))
              Actions: INPUT : 0 -> y UInt64 : 0
                       INPUT : 1 -> n Nullable(Int32) : 1
                       ALIAS y :: 0 -> __table1.y UInt64 : 2
                       ALIAS n :: 1 -> __table1.n Nullable(Int32) : 0
              Positions: 2 0
                ReadFromMergeTree (ParallelRead default.t_distinct_mixed)
                ReadType: Default
                Parts: 2
                Granules: 2

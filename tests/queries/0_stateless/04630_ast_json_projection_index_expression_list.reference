CREATE TABLE t (`a` UInt64, PROJECTION p INDEX a TYPE commit_order) ENGINE = MergeTree ORDER BY a
CREATE TABLE t (`a` UInt64, `b` UInt64, PROJECTION p INDEX a, b TYPE commit_order) ENGINE = MergeTree ORDER BY a
CREATE TABLE t (`a` UInt64, PROJECTION p (SELECT a ORDER BY a)) ENGINE = MergeTree ORDER BY a

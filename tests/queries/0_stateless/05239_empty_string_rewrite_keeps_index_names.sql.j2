-- https://github.com/ClickHouse/ClickHouse/issues/112636
-- `optimize_empty_string_comparisons` renames `s = ''` in a query, while a key or a skip index is matched to the query
-- by the name of its expression as declared, so an index declared on such a comparison was skipped. The declaration
-- now also answers to the rewritten name, wherever the query is matched: locally, through a subquery, on a shard.

SET enable_analyzer = 1;
SET explain_query_plan_default = 'legacy';
SET optimize_empty_string_comparisons = 1;

DROP TABLE IF EXISTS tab;
DROP TABLE IF EXISTS dist;

{% for index_type in ['minmax', 'set(100)', 'bloom_filter', 'tokenbf_v1(512, 3, 0)'] -%}
SELECT '{{ index_type }}';
CREATE TABLE tab (s String, INDEX idx if(s = '', 'abc', s) TYPE {{ index_type }}) ENGINE = MergeTree ORDER BY tuple() SETTINGS index_granularity = 2;
INSERT INTO tab VALUES (''), ('x'), ('y'), ('z');
SELECT count() FROM tab WHERE if(s = '', 'abc', s) = 'abc';
SELECT trimLeft(explain) FROM (EXPLAIN indexes = 1 SELECT count() FROM tab WHERE if(s = '', 'abc', s) = 'abc') WHERE explain LIKE '%Name: idx%' OR explain LIKE '%Granules:%';
DROP TABLE tab;

{% endfor -%}
SELECT 'primary key';
CREATE TABLE tab (s String) ENGINE = MergeTree ORDER BY if(s = '', 'abc', s) SETTINGS index_granularity = 2;
INSERT INTO tab VALUES (''), ('x'), ('y'), ('z');
SELECT count() FROM tab WHERE if(s = '', 'abc', s) = 'abc';
SELECT trimLeft(explain) FROM (EXPLAIN indexes = 1 SELECT count() FROM tab WHERE if(s = '', 'abc', s) = 'abc') WHERE explain LIKE '%Granules:%';
-- The shard analyzes the query again and matches its own key.
CREATE TABLE dist AS tab ENGINE = Distributed(test_shard_localhost, currentDatabase(), tab);
SELECT count() FROM dist WHERE if(s = '', 'abc', s) = 'abc' SETTINGS force_primary_key = 1;
DROP TABLE dist;
DROP TABLE tab;

SELECT 'partition key';
CREATE TABLE tab (s String) ENGINE = MergeTree ORDER BY tuple() PARTITION BY if(s = '', 'abc', s);
INSERT INTO tab VALUES (''), ('x'), ('y'), ('z');
SELECT count() FROM tab WHERE if(s = '', 'abc', s) = 'abc';
SELECT trimLeft(explain) FROM (EXPLAIN indexes = 1 SELECT s FROM tab WHERE if(s = '', 'abc', s) = 'abc') WHERE explain LIKE '%Parts:%';
SELECT count() FROM tab WHERE if(s = '', 'abc', s) = 'abc' SETTINGS force_index_by_date = 1;
DROP TABLE tab;

SELECT 'bloom filter on a map built by a lambda';
-- The comparison is typed inside the lambda; the map entry paths of the bloom filter look the map up by name too.
CREATE TABLE tab (m Map(String, String), INDEX idx mapValues(mapFilter((k, v) -> v != '', m)) TYPE bloom_filter) ENGINE = MergeTree ORDER BY tuple() SETTINGS index_granularity = 2;
INSERT INTO tab VALUES (map('k', 'abc')), (map('k', 'abc')), (map('k', 'v')), (map('k', ''));
SELECT count() FROM (EXPLAIN QUERY TREE SELECT count() FROM tab WHERE mapFilter((k, v) -> v != '', m)['k'] = 'abc') WHERE explain LIKE '%function_name: notEmpty%';
SELECT count() FROM tab WHERE mapFilter((k, v) -> v != '', m)['k'] = 'abc' SETTINGS force_data_skipping_indices = 'idx';
SELECT trimLeft(explain) FROM (EXPLAIN indexes = 1 SELECT count() FROM tab WHERE mapFilter((k, v) -> v != '', m)['k'] = 'abc') WHERE explain LIKE '%Name: idx%' OR explain LIKE '%Granules:%';
SELECT count() FROM tab WHERE mapContainsValue(mapFilter((k, v) -> v != '', m), 'abc') SETTINGS force_data_skipping_indices = 'idx';
SELECT trimLeft(explain) FROM (EXPLAIN indexes = 1 SELECT count() FROM tab WHERE mapContainsValue(mapFilter((k, v) -> v != '', m), 'abc')) WHERE explain LIKE '%Granules:%';
DROP TABLE tab;

SELECT 'index on an alias column';
CREATE TABLE tab (s String, a String ALIAS if(s = '', 'abc', s), INDEX idx a TYPE minmax) ENGINE = MergeTree ORDER BY tuple() SETTINGS index_granularity = 2;
INSERT INTO tab VALUES (''), ('x'), ('y'), ('z');
SELECT count() FROM tab WHERE a = 'abc';
SELECT trimLeft(explain) FROM (EXPLAIN indexes = 1 SELECT count() FROM tab WHERE a = 'abc') WHERE explain LIKE '%Name: idx%' OR explain LIKE '%Granules:%';

SELECT 'through a subquery and a Distributed table';
SELECT count() FROM system.one WHERE 1 IN (SELECT count() FROM tab WHERE a = 'abc' SETTINGS force_data_skipping_indices = 'idx');
CREATE TABLE dist AS tab ENGINE = Distributed(test_shard_localhost, currentDatabase(), tab);
SELECT count() FROM dist WHERE a = 'abc' SETTINGS force_data_skipping_indices = 'idx';
DROP TABLE dist;

SELECT 'controls';
-- The query is still rewritten; the index answers to both spellings, so the setting no longer decides.
SELECT count() FROM (EXPLAIN QUERY TREE SELECT count() FROM tab WHERE a = 'abc') WHERE explain LIKE '%function_name: empty%';
SELECT trimLeft(explain) FROM (EXPLAIN indexes = 1 SELECT count() FROM tab WHERE a = 'abc' SETTINGS optimize_empty_string_comparisons = 0) WHERE explain LIKE '%Granules:%';
SELECT trimLeft(explain) FROM (EXPLAIN indexes = 1 SELECT count() FROM tab WHERE if(empty(s), 'abc', s) = 'abc' SETTINGS optimize_empty_string_comparisons = 0) WHERE explain LIKE '%Granules:%';
-- A different expression still does not match: the index answers to its two spellings, not to the table.
SELECT count() FROM (EXPLAIN indexes = 1 SELECT count() FROM tab WHERE if(s = 'x', 'abc', s) = 'abc') WHERE explain LIKE '%Name: idx%';
DROP TABLE tab;

explain syntax select negate(1), negate(-1), - -1, -(-1), (-1) in (-1);
SELECT\n    negate(1),\n    negate(-1),\n    negate(-1),\n    negate(-1),\n    in(-1, -1)\nFROM system.one
explain syntax select negate(1.), negate(-1.), - -1., -(-1.), (-1.) in (-1.);
SELECT\n    negate(1.),\n    negate(-1.),\n    negate(-1.),\n    negate(-1.),\n    in(-1., -1.)\nFROM system.one

(0,0,0,2,5,0,[(0,2)],[0.5,1.5],[],[],[])	(6,0,0,-2,-5,-0,[(0,2)],[-0.5,-1.5],[],[],[])	(0,0,0,inf,inf,nan,[],[],[],[],[])
-- NULL handling: NULL in -> NULL out for all four
\N	\N	\N	\N
-- row-wise NULLs inside Nullable columns are kept per row (the first row is e1 + e1)
(0,0,0,8,20,0,[(0,2)],[2,6],[],[],[])
\N
-- the counter reset hint of `sum`: two NotCounterReset samples (flags 4) keep the hint (flags 4)
(4,0,0,12,31,0,[(0,2)],[3,9],[],[],[])
-- aggregate level: `timeSeriesHistogramSumOverGroup` / `timeSeriesHistogramAvgOverGroup` over e1, e2
-- sum = (count 12, sum 31, buckets x3, x9); avg = sum/2 = (count 6, sum 15.5, buckets x1.5, x4.5)
(0,0,0,12,31,0,[(0,2)],[3,9],[],[],[])	(0,0,0,6,15.5,0,[(0,2)],[1.5,4.5],[],[],[])
-- a single-sample group is the sample itself
(0,0,0,4,10,0,[(0,2)],[1,3],[],[],[])	(0,0,0,4,10,0,[(0,2)],[1,3],[],[],[])
-- custom-bucket group: sum/avg over c1, c2
(0,-53,0,12,31,0,[(0,3)],[1,5,6],[],[],[1,2,4])	(0,-53,0,6,15.5,0,[(0,3)],[0.5,2.5,3],[],[],[1,2,4])
-- schema-incompatible group (exp + custom): NULL for both (upstream drops the group element)
\N	\N
-- an empty group produces NULL
\N	\N
-- Kahan accumulation: big (count 1, sum 1e16) + two smalls (count 1, sum 1): the naive sum loses
-- the ones (ulp(1e16) = 2); Kahan keeps them: sum = 1e16+2, avg = 3333333333333334 (naive ...3333.5)
(0,0,0,3,10000000000000002,0,[(0,1)],[10000000000000002],[],[],[])	(0,0,0,1,3333333333333334,0,[(0,1)],[3333333333333334],[],[],[])
-- overflow: two samples with count = sum = bucket = 1.5e308; the `sum` overflows to +Inf
-- (upstream keeps it), while `avg` switches to the incremental mean and stays finite (1.5e308)
(0,0,0,inf,inf,0,[(0,1)],[inf],[],[],[])	(0,0,0,1.5e308,1.5e308,0,[(0,1)],[1.5e308],[],[],[])

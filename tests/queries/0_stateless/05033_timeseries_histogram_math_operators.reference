-- add: e1 + e2 = (count 12, sum 31, buckets x3, x9); the counter reset hint stays `unknown` (0)
(0,0,0,12,31,0,[(0,2)],[3,9],[],[],[])
-- sub: e2 - e1 = (count 4, sum 11, buckets x1, x3); the hint is set to gauge (flags 6)
(6,0,0,4,11,0,[(0,2)],[1,3],[],[],[])
-- schema mismatch: s1 (schema 1, buckets (0.71,1]x1, (1,1.41]x1, (1.41,2]x6) + e1: s1 is reduced
-- to schema 0 (buckets x1, x7) before adding: (count 12, sum 31, buckets x2, x10)
(0,0,0,12,31,0,[(0,2)],[2,10],[],[],[])
-- custom buckets, same bounds [1,2,4]: c1 + c2 = buckets [1,5,6] over (-Inf,1], (1,2], (2,4]
(0,-53,0,12,31,0,[(0,3)],[1,5,6],[],[],[1,2,4])
-- custom buckets, mismatched bounds [1,2,4] vs [2,4,8]: the bounds are intersected to [2,4]
-- (upstream nhcbBoundsReconciled); c1 maps to [4,0,0], c3 stays [5,7,0] -> [9,7]
(0,-53,0,8,24,0,[(0,2)],[9,7],[],[],[2,4])
-- exp + custom: schema-incompatible -> NULL (upstream drops the sample)
\N	\N
-- zero-threshold reconciliation: zt 0.6 (zero count 1) + zt 0.0: the threshold adjusts up
-- to the bucket bound 1.0 and covered buckets fold into the zero count: zc = 1+1+1 = 3, (1,2] bucket: 3+1 = 4
(0,0,1,6,15,3,[(1,1)],[4],[],[],[])	(0,0,1,6,15,3,[(1,1)],[4],[],[],[])
-- mul by scalar 2 / by -2 (a negative factor marks the result as a gauge, flags 6)
(0,0,0,8,20,0,[(0,2)],[2,6],[],[],[])	(6,0,0,-8,-20,-0,[(0,2)],[-2,-6],[],[],[])
-- div by scalar 2 / by -2 / by 0 (division by zero removes all buckets; the scalar fields

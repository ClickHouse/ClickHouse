#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# Regression test for a post-auth type confusion in asynchronous inserts over the native TCP protocol.
#
# The serialization kind of every column of a block is chosen by the peer that sends the block.
# A client that selects `Sparse` or `Replicated` for a column of `INSERT ... FORMAT Native` puts a
# `ColumnSparse` / `ColumnReplicated` into a block that keeps the declared type of the column. With
# `async_insert = 1` such a block was queued as is, and the flush copied it into a full column with
# `insertRangeFrom`, whose `assert_cast` (a plain `static_cast` in release builds) reinterpreted it.
#
# No sender of such a block needs another kind than the default one, so the server must accept
# only that one, at any nesting depth, in every block a peer sends: the data of an `INSERT`,
# external tables and scalars. The scenarios below send well-formed blocks, so nothing but the
# kind can reject them: all expect INCORRECT_DATA (code 117) and a server that stays alive, and
# an ordinary block is still inserted.
#
# The client speaks the raw native protocol pinned to revision 54482
# (DBMS_MIN_REVISION_WITH_REPLICATED_SERIALIZATION), so the set of exchanged,
# revision-gated fields is fixed and does not drift.

import os
import socket
import struct
import uuid

CLICKHOUSE_HOST = os.environ.get("CLICKHOUSE_HOST", "127.0.0.1")
CLICKHOUSE_PORT = int(os.environ.get("CLICKHOUSE_PORT_TCP", "9000"))
CLICKHOUSE_DATABASE = os.environ.get("CLICKHOUSE_DATABASE", "default")
CLIENT_NAME = "async insert serialization kind"

REVISION = 54482

# KindStackBinarySerializationType
KIND_STACK_DEFAULT = 0
KIND_STACK_SPARSE = 1
KIND_STACK_REPLICATED = 4
KIND_STACK_COMBINATION = 5

# Protocol::Client
CLIENT_DATA = 2
CLIENT_SCALAR = 7

# Protocol::Server
SERVER_EXCEPTION = 2
SERVER_PROGRESS = 3
SERVER_END_OF_STREAM = 5
SERVER_PROFILE_EVENTS = 14

END_OF_GRANULE_FLAG = 1 << 62

ROWS = 4


def writeVarUInt(x, ba):
    for _ in range(0, 9):
        byte = x & 0x7F
        if x > 0x7F:
            byte |= 0x80
        ba.append(byte)
        x >>= 7
        if x == 0:
            return


def writeStringBinary(s, ba):
    b = bytes(s, "utf-8") if isinstance(s, str) else s
    writeVarUInt(len(b), ba)
    ba.extend(b)


def readStrict(s, size=1):
    res = bytearray()
    while size:
        cur = s.recv(size)
        if not cur:
            raise EOFError("Connection closed by server")
        size -= len(cur)
        res.extend(cur)
    return res


def readUInt(s, size=1):
    res = readStrict(s, size)
    val = 0
    for i in range(len(res)):
        val += res[i] << (i * 8)
    return val


def readUInt8(s):
    return readUInt(s)


def readUInt32(s):
    return readUInt(s, 4)


def readVarUInt(s):
    x = 0
    for i in range(9):
        byte = readStrict(s)[0]
        x |= (byte & 0x7F) << (7 * i)
        if not byte & 0x80:
            return x
    return x


def readStringBinary(s):
    size = readVarUInt(s)
    return readStrict(s, size).decode("utf-8")


def sendHello(s):
    ba = bytearray()
    writeVarUInt(0, ba)  # Hello
    writeStringBinary(CLIENT_NAME, ba)
    writeVarUInt(24, ba)  # major
    writeVarUInt(9, ba)  # minor
    writeVarUInt(REVISION, ba)
    writeStringBinary(CLICKHOUSE_DATABASE, ba)  # database
    writeStringBinary("default", ba)  # user
    writeStringBinary("", ba)  # password
    s.sendall(ba)


def receiveHello(s):
    assert readVarUInt(s) == 0  # Hello
    readStringBinary(s)  # server name
    readVarUInt(s)  # major
    readVarUInt(s)  # minor
    readVarUInt(s)  # revision
    readVarUInt(s)  # parallel replicas protocol version (>= 54471)
    readStringBinary(s)  # timezone (>= 54058)
    readStringBinary(s)  # display name (>= 54372)
    readVarUInt(s)  # version patch (>= 54401)
    readStringBinary(s)  # proto_send chunked (>= 54470)
    readStringBinary(s)  # proto_recv chunked (>= 54470)
    for _ in range(readVarUInt(s)):  # password complexity rules (>= 54461)
        readStringBinary(s)
        readStringBinary(s)
    readStrict(s, 8)  # nonce, UInt64 (>= 54462)
    # Server settings in STRINGS_WITH_FLAGS format: (name, flags, value)* terminated
    # by an empty name (>= 54474).
    while True:
        if readStringBinary(s) == "":  # setting name
            break
        readVarUInt(s)  # flags
        readStringBinary(s)  # value
    readVarUInt(s)  # query plan serialization version (>= 54477)
    readVarUInt(s)  # cluster function protocol version (>= 54479)


def sendAddendum(s):
    ba = bytearray()
    writeStringBinary("", ba)  # quota key (>= 54458)
    writeStringBinary("notchunked", ba)  # proto_send chunked (>= 54470)
    writeStringBinary("notchunked", ba)  # proto_recv chunked (>= 54470)
    writeVarUInt(0, ba)  # parallel replicas protocol version (>= 54471)
    s.sendall(ba)


def serializeClientInfo(ba, query_id):
    ba.append(1)  # INITIAL_QUERY
    writeStringBinary("default", ba)  # initial_user
    writeStringBinary(query_id, ba)  # initial_query_id
    writeStringBinary("127.0.0.1:9000", ba)  # initial_address
    ba.extend([0] * 8)  # initial_query_start_time_microseconds (>= 54449)
    ba.append(1)  # interface = TCP
    writeStringBinary("os_user", ba)
    writeStringBinary("client_hostname", ba)
    writeStringBinary(CLIENT_NAME, ba)
    writeVarUInt(24, ba)  # client major
    writeVarUInt(9, ba)  # client minor
    writeVarUInt(REVISION, ba)  # client tcp protocol version
    writeStringBinary("", ba)  # quota key (>= 54060)
    writeVarUInt(0, ba)  # distributed_depth (>= 54448)
    writeVarUInt(1, ba)  # client version patch (>= 54401)
    ba.append(0)  # opentelemetry: no trace id (>= 54442)
    writeVarUInt(0, ba)  # parallel replicas: collaborate_with_initiator (>= 54453)
    writeVarUInt(0, ba)  # parallel replicas: obsolete count
    writeVarUInt(0, ba)  # parallel replicas: number_of_current_replica
    writeVarUInt(0, ba)  # script query number (>= 54475)
    writeVarUInt(0, ba)  # script line number (>= 54475)
    ba.append(0)  # jwt: none (>= 54476)


def sendQuery(s, query):
    ba = bytearray()
    query_id = uuid.uuid4().hex
    writeVarUInt(1, ba)  # Query
    writeStringBinary(query_id, ba)
    serializeClientInfo(ba, query_id)
    # Skip the slow text stack trace symbolization; readException discards the trace anyway.
    # It must be a protocol setting: an inline SETTINGS clause does not reach the reply path.
    writeStringBinary("calculate_text_stack_trace", ba)
    writeVarUInt(1, ba)  # is_important
    writeStringBinary("0", ba)
    writeStringBinary("", ba)  # end of per-query settings
    writeStringBinary("", ba)  # interserver externally granted roles (>= 54472)
    writeStringBinary("", ba)  # interserver secret (>= 54441)
    writeVarUInt(2, ba)  # stage = Complete
    ba.append(0)  # no compression
    writeStringBinary(query, ba)
    writeStringBinary("", ba)  # query parameters terminator (>= 54459)
    s.sendall(ba)


def serializeBlockInfo(ba):
    writeVarUInt(1, ba)  # field 1
    ba.append(0)  # is_overflows = false
    writeVarUInt(2, ba)  # field 2
    ba.extend(struct.pack("<i", -1))  # bucket_num = -1
    writeVarUInt(0, ba)  # end of block info


def readBlockInfo(s):
    while True:
        field_num = readVarUInt(s)
        if field_num == 0:
            break
        if field_num == 1:
            readUInt8(s)  # is_overflows
        elif field_num == 2:
            readUInt32(s)  # bucket_num
        elif field_num == 3:  # out_of_order_buckets (>= 54480)
            for _ in range(readVarUInt(s)):
                readUInt32(s)
        else:
            raise RuntimeError("Unknown BlockInfo field {}".format(field_num))


def emptyBlock():
    ba = bytearray()
    writeVarUInt(2, ba)  # Data
    writeStringBinary("", ba)
    serializeBlockInfo(ba)
    writeVarUInt(0, ba)  # columns
    writeVarUInt(0, ba)  # rows
    return bytes(ba)


def readException(s):
    code = readUInt32(s)
    readStringBinary(s)  # name
    text = readStringBinary(s)
    readStringBinary(s)  # trace
    readUInt8(s)  # has_nested
    return code, text


def readKindStack(s):
    kind = readUInt8(s)
    if kind == KIND_STACK_COMBINATION:  # number of kinds and the kinds themselves
        readStrict(s, readVarUInt(s))


def readHeader(s):
    packet_type = receiveReply(s)
    if packet_type == SERVER_EXCEPTION:
        code, text = readException(s)
        raise RuntimeError("Unexpected exception {}: {}".format(code, text))
    assert packet_type == 1, "Expected Data (header) packet, got {}".format(packet_type)
    readStringBinary(s)  # external table name
    readBlockInfo(s)
    columns = readVarUInt(s)
    rows = readVarUInt(s)
    assert rows == 0, "Expected an empty header block, got {} rows".format(rows)
    # Consume the per-column descriptor so the stream stays aligned.
    for _ in range(columns):
        readStringBinary(s)  # column name
        readStringBinary(s)  # column type
        if readUInt8(s):  # has custom serialization (>= 54454)
            readKindStack(s)


def skipProfileEvents(s):
    fixed_sizes = {"DateTime": 4, "UInt64": 8, "Int64": 8}
    readStringBinary(s)  # external table name
    readBlockInfo(s)
    columns = readVarUInt(s)
    rows = readVarUInt(s)
    for _ in range(columns):
        readStringBinary(s)  # column name
        column_type = readStringBinary(s)
        assert readUInt8(s) == 0  # has custom serialization (>= 54454)
        if column_type == "String":
            for _ in range(rows):
                readStringBinary(s)
        elif column_type.startswith("Enum8("):
            readStrict(s, rows)
        else:
            readStrict(s, rows * fixed_sizes[column_type])


def receiveReply(s):
    """Skips the reports of a running `INSERT` and returns the type of the packet that ends it."""
    while True:
        packet_type = readVarUInt(s)
        if packet_type == SERVER_PROFILE_EVENTS:
            skipProfileEvents(s)
        elif packet_type == SERVER_PROGRESS:
            # read_rows, read_bytes, total_rows_to_read, total_bytes_to_read (>= 54463),
            # written_rows, written_bytes (>= 54420), elapsed_ns (>= 54460)
            for _ in range(7):
                readVarUInt(s)
        else:
            return packet_type


def dataBlockPrefix(column_type, table_name="", packet_type=CLIENT_DATA):
    """The beginning of a Data or Scalar packet with one column `x`, up to its serialization kinds."""
    ba = bytearray()
    writeVarUInt(packet_type, ba)
    writeStringBinary(table_name, ba)  # empty for the data of an INSERT
    serializeBlockInfo(ba)
    writeVarUInt(1, ba)  # columns
    writeVarUInt(ROWS, ba)
    writeStringBinary("x", ba)  # column name
    writeStringBinary(column_type, ba)
    return ba


def sparseOffsets():
    """SparseOffsets substream: rows 0 and 1 are non-default, the trailing defaults close the granule."""
    ba = bytearray()
    writeVarUInt(0, ba)
    writeVarUInt(0, ba)
    writeVarUInt((ROWS - 2) | END_OF_GRANULE_FLAG, ba)
    return ba


def sparseBlock(table_name=""):
    ba = dataBlockPrefix("UInt64", table_name)
    ba.append(1)  # has_custom serialization
    ba.append(KIND_STACK_SPARSE)
    ba.extend(sparseOffsets())
    ba.extend(struct.pack("<2Q", 42, 43))  # SparseElements substream
    return bytes(ba)


def replicatedBlock(table_name="", packet_type=CLIENT_DATA):
    num_elements = 2
    ba = dataBlockPrefix("UInt64", table_name, packet_type)
    ba.append(1)  # has_custom serialization
    ba.append(KIND_STACK_REPLICATED)
    # ReplicatedIndexes substream: row count, index type size, in-range indexes.
    writeVarUInt(ROWS, ba)
    ba.append(8)  # sizeof(UInt64)
    for i in range(ROWS):
        ba.extend(struct.pack("<Q", i % num_elements))
    # ReplicatedElements substream: element count, nested values.
    writeVarUInt(num_elements, ba)
    ba.extend(struct.pack("<2Q", 42, 43))
    return bytes(ba)


def sparseTupleElementBlock():
    # Kind stacks are per tuple element, so a nested column can be sparse under a default tuple.
    ba = dataBlockPrefix("Tuple(UInt64, UInt64)")
    ba.append(1)  # has_custom serialization
    ba.append(KIND_STACK_DEFAULT)  # the tuple
    ba.append(KIND_STACK_SPARSE)  # element 0
    ba.append(KIND_STACK_DEFAULT)  # element 1
    ba.extend(sparseOffsets())
    ba.extend(struct.pack("<2Q", 42, 43))  # SparseElements substream of element 0
    ba.extend(struct.pack("<{}Q".format(ROWS), *range(ROWS)))  # element 1
    return bytes(ba)


def denseBlock():
    ba = dataBlockPrefix("UInt64")
    ba.append(0)  # no custom serialization
    ba.extend(struct.pack("<{}Q".format(ROWS), *range(1, ROWS + 1)))
    return bytes(ba)


def asyncInsert(s, table, block):
    sendHello(s)
    receiveHello(s)
    sendAddendum(s)
    # input_format_defaults_for_omitted_fields=0 suppresses the TableColumns packet
    # (mirrors 02010_lc_native).
    sendQuery(
        s,
        "INSERT INTO {}.{} "
        "SETTINGS input_format_defaults_for_omitted_fields = 0, async_insert = 1, wait_for_async_insert = 1 "
        "FORMAT Native".format(CLICKHOUSE_DATABASE, table),
    )

    # Finish external tables and read the insert sample-block header.
    s.sendall(emptyBlock())
    readHeader(s)

    # The whole data at once: the server may close the connection as soon as it rejects the block.
    # The trailing empty block makes a server that accepts the block queue it and wait for the flush.
    s.sendall(block + emptyBlock())
    return receiveReply(s)


def selectWithData(s, packet):
    """A `SELECT` that comes with an external table or a scalar."""
    sendHello(s)
    receiveHello(s)
    sendAddendum(s)
    sendQuery(s, "SELECT 1")
    s.sendall(packet + emptyBlock())
    return receiveReply(s)


def expectException(name, s, packet_type, kind):
    assert packet_type == SERVER_EXCEPTION, "Expected Exception packet, got {}".format(
        packet_type
    )
    code, text = readException(s)
    assert code == 117, "Expected INCORRECT_DATA (117), got {}: {}".format(code, text)
    assert (
        "Unexpected serialization kind {} in the received data".format(kind) in text
    ), text
    print("{}: caught expected exception INCORRECT_DATA".format(name))


def expectRejected(name, table, block, kind):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(60)
        s.connect((CLICKHOUSE_HOST, CLICKHOUSE_PORT))
        expectException(name, s, asyncInsert(s, table, block), kind)


def expectRejectedInSelect(name, packet, kind):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(60)
        s.connect((CLICKHOUSE_HOST, CLICKHOUSE_PORT))
        expectException(name, s, selectWithData(s, packet), kind)


def expectInserted(name, table, block):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(60)
        s.connect((CLICKHOUSE_HOST, CLICKHOUSE_PORT))
        packet_type = asyncInsert(s, table, block)
        if packet_type == SERVER_EXCEPTION:
            code, text = readException(s)
            raise RuntimeError("Unexpected exception {}: {}".format(code, text))
        assert (
            packet_type == SERVER_END_OF_STREAM
        ), "Expected EndOfStream packet, got {}".format(packet_type)
        print("{}: inserted".format(name))


def main():
    expectRejected("sparse", "tab", sparseBlock(), "Sparse")
    expectRejected("replicated", "tab", replicatedBlock(), "Replicated")
    expectRejected(
        "sparse tuple element", "tab_tuple", sparseTupleElementBlock(), "Sparse"
    )

    # The other blocks a client can send: an external table and a scalar.
    expectRejectedInSelect("sparse external table", sparseBlock("e"), "Sparse")
    expectRejectedInSelect(
        "replicated scalar", replicatedBlock("s", CLIENT_SCALAR), "Replicated"
    )

    # The gate must not reject what every client sends.
    expectInserted("default", "tab", denseBlock())


if __name__ == "__main__":
    main()

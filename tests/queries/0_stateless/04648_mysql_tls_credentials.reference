--- mysql table function
SELECT * FROM mysql(creds, ssl_ca_pem = '[HIDDEN]', `table` = 't', ssl_key_pem = '[HIDDEN]', password = '[HIDDEN]')
--- MySQL table engine
CREATE TABLE t (`x` Int32) ENGINE = MySQL(creds, ssl_cert_pem = '[HIDDEN]', `table` = 't', ssl_key_pem = '[HIDDEN]')
--- MySQL database engine
CREATE DATABASE d ENGINE = MySQL(creds, ssl_ca_pem = '[HIDDEN]', database = 'db', ssl_key_pem = '[HIDDEN]')
--- MySQL dictionary source
CREATE DICTIONARY d (`id` UInt32) PRIMARY KEY id SOURCE(MYSQL(NAME creds DB 'db' SSL_CERT_PEM '[HIDDEN]' SSL_KEY_PEM '[HIDDEN]')) LIFETIME(MIN 0 MAX 0) LAYOUT(FLAT())
--- mysql table function, positional arguments
SELECT * FROM mysql('127.0.0.1:3306', 'db', 't', 'u', '[HIDDEN]', ssl_ca_pem = '[HIDDEN]', ssl_key_pem = '[HIDDEN]')
--- MySQL table engine, positional arguments
CREATE TABLE t (`x` Int32) ENGINE = MySQL('127.0.0.1:3306', 'db', 't', 'u', '[HIDDEN]', ssl_cert_pem = '[HIDDEN]')
--- MySQL database engine, positional arguments
CREATE DATABASE d ENGINE = MySQL('127.0.0.1:3306', 'db', 'u', '[HIDDEN]', ssl_ca_pem = '[HIDDEN]')
--- key given as a constant expression
SELECT * FROM mysql(creds, concat('ssl_ca', '_pem') = '[HIDDEN]', `table` = 't')
--- key given as a constant expression, positional arguments
SELECT * FROM mysql('127.0.0.1:3306', 'db', 't', 'u', '[HIDDEN]', upper('ssl_key_pem') = '[HIDDEN]')

-- sort_by_label(mem, 'dc', 'host'): sort by 'dc' then 'host'; missing 'dc' sorts first (empty string)
[('__name__','mem'),('host','only')]	2023-11-14 22:13:20.000	14
[('__name__','mem'),('dc','eu'),('host','z')]	2023-11-14 22:13:20.000	13
[('__name__','mem'),('dc','us'),('host','a')]	2023-11-14 22:13:20.000	12
[('__name__','mem'),('dc','us'),('host','b')]	2023-11-14 22:13:20.000	11

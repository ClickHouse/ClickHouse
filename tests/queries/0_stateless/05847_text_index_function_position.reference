>= 0, no index	[1,2,3,4,5,6]
not	[2,3,4,5,6]
not, no index	[2,3,4,5,6]
empty needle	[1,2,3,4,5,6]
empty needle, no index	[1,2,3,4,5,6]
start position	[]
start position, no index	[]

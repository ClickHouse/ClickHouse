> -0	[1]
0 <	[1]
1 <=	[1]
0 !=	[1]
no index	[1]
-- conditions that only imply the needle being found
bare	[1,2]
bare, no index	[1,2]
= 5	[1,2]
= 5, no index	[1,2]
= 3	[]
= 3, no index	[]
> 4	[1,2]
> 4, no index	[1,2]
no tokens	[1]
no tokens, no index	[1]
between	[1]
-- conditions that accept 0 cannot use the index
= 0	[2,3,4,5,6]
= 0, no index	[2,3,4,5,6]

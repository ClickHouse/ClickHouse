Basic
   ┏━━━━━━━┳━━━━━━━━━━━┓
   ┃ x     ┃ t         ┃
   ┃       ┣━━━┳━━━━━━━┫
   ┃       ┃ a ┃ b     ┃
   ┡━━━━━━━╇━━━╇━━━━━━━┩
1. │ hello │ 1 │ world │
   └───────┴───┴───────┘
   ┌─x─────┬─t─────────┐
   ├───────┼─a─┬─b─────┤
1. │ hello │ 1 │ world │
   └───────┴───┴───────┘
    x       t        
            a   b    

1.  hello   1   world 
Numbers are right-aligned
   ┏━━━━━━━━━━━━━━┳━━━━┓
   ┃ t            ┃  n ┃
   ┣━━━━━━━━┳━━━━━┫    ┃
   ┃ number ┃ s   ┃    ┃
   ┡━━━━━━━━╇━━━━━╇━━━━┩
1. │  12345 │ abc │ 42 │
   └────────┴─────┴────┘
Nested tuples
   ┏━━━━━━━┳━━━━━━━━━━━━━━━━━━━┓
   ┃ x     ┃ t                 ┃
   ┃       ┣━━━┳━━━━━━━━━━━━━━━┫
   ┃       ┃ a ┃ f             ┃
   ┃       ┃   ┣━━━━━━━┳━━━━━━━┫
   ┃       ┃   ┃ b     ┃ e     ┃
   ┃       ┃   ┣━━━┳━━━┫       ┃
   ┃       ┃   ┃ c ┃ d ┃       ┃
   ┡━━━━━━━╇━━━╇━━━╇━━━╇━━━━━━━┩
1. │ hello │ 1 │ 2 │ 3 │ world │
   └───────┴───┴───┴───┴───────┘
   ┌─x─────┬─t─────────────────┐
   ├───────┼─a─┬─f─────────────┤
   ├───────┼───┼─b─────┬─e─────┤
   ├───────┼───┼─c─┬─d─┼───────┤
1. │ hello │ 1 │ 2 │ 3 │ world │
   └───────┴───┴───┴───┴───────┘
    x       t                
            a   f            
                b       e    
                c   d        

1.  hello   1   2   3   world 

#!/usr/bin/expect -f
# Tags: no-fasttest
# no-fasttest: the AI agent of the client is not compiled in the fast test build.

# A lone repeat alias (`/` or `.`) in the AI-chat forms repeats the last SQL query, like in the SQL
# mode, instead of being sent to the agent as a question. No AI provider is configured here, so a
# line that reached the agent would be answered with a complaint about the provider instead.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0
set history_file $CLICKHOUSE_TMP/$basename.history

log_user 0
set timeout 60
match_max 100000
expect_after {
    -i $any_spawn_id eof     { exp_continue }
    -i $any_spawn_id timeout { exit 1 }
}

spawn bash -c "source $basedir/../shell_config.sh ; unset OPENAI_API_KEY ANTHROPIC_API_KEY ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --history_file=$history_file"
expect ":) "

send -- "SELECT 'repeated' || 'result'"
expect -ex "result'"
send -- "\r"
expect "repeatedresult"
expect ":) "

# A leading `?` switches the line editor into the AI-chat mode instead of being inserted.
# (`-ex`: a `?` in a glob pattern would match any character.)
send -- "?"
expect -ex ":?"
send -- "/"
expect -ex "/"
send -- "\r"
expect {
    "not available" { exit 1 }
    "repeatedresult" {}
}
expect -ex ":?"

# Surrounding whitespace and a trailing `;` are allowed, and `.` is the other alias.
send -- " . ;"
expect -ex ";"
send -- "\r"
expect {
    "not available" { exit 1 }
    "repeatedresult" {}
}
expect -ex ":?"

# Quit: `Ctrl-C` abandons the line, and `Ctrl-D` then exits from the empty prompt it redraws (the
# echo of the `^C` separates that prompt from the earlier ones).
send -- "\3"
expect {
    eof      {}
    -ex "^C" {
        expect {
            eof          {}
            -re {:[)?]}  { send -- "\4" ; expect eof }
        }
    }
}

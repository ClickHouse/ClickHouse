SELECT number\nFROM\n(\n    SELECT number\n    FROM numbers(_CAST(15, \'UInt64\'))\n    WHERE greater(number, 10)\n) AS `04105_pv`
SELECT number\nFROM\n(\n    SELECT number\n    FROM numbers(_CAST(20, \'UInt64\'))\n    WHERE greater(number, _CAST(5, \'UInt64\'))\n) AS `04105_pv_multi`
SELECT number\nFROM\n(\n    SELECT number\n    FROM\n    (\n        SELECT number\n        FROM numbers(_CAST(5, \'UInt64\'))\n        WHERE greater(number, 0)\n    ) AS `04105_pv_nested_inner`\n    WHERE greater(number, 0)\n) AS `04105_pv_nested_outer`
SELECT x\nFROM\n(\n    SELECT 1 AS x\n) AS `04105_plain_view`
SELECT number\nFROM\n(\n    SELECT number\n    FROM\n    (\n        SELECT number\n        FROM numbers(_CAST(12, \'UInt64\'))\n        WHERE greater(number, 10)\n    ) AS `04105_pv`\n)
SELECT number\nFROM `04105_join_target`\nALL INNER JOIN\n(\n    SELECT number\n    FROM numbers(_CAST(10, \'UInt64\'))\n    WHERE greater(number, 10)\n) AS `04105_pv` USING (number)
SELECT number\nFROM\n(\n    SELECT number\n    FROM numbers(_CAST(10, \'UInt64\'))\n    WHERE greater(number, 10)\n) AS t
SELECT *\nFROM numbers(3)\nSETTINGS allow_experimental_analyzer = 1
SELECT x\nFROM\n(\n    SELECT x\n    FROM default.`04105_modifiers_t`\n    WHERE greater(x, _CAST(1, \'UInt64\'))\n) AS `04105_modifiers_pv`\nFINAL
SELECT count()\nFROM\n(\n    SELECT x\n    FROM default.`04105_modifiers_t`\n    WHERE greater(x, _CAST(1, \'UInt64\'))\n) AS `04105_modifiers_pv`\nSAMPLE 5 / 10
SELECT x\nFROM\n(\n    SELECT x\n    FROM default.`04105_security_t`\n    WHERE greater(x, _CAST(1, \'UInt64\'))\n) AS `04105_pv_security_none`
SELECT x\nFROM\n(\n    SELECT x\n    FROM default.`04105_security_t`\n    WHERE greater(x, _CAST(1, \'UInt64\'))\n) AS `04105_pv_security_definer`

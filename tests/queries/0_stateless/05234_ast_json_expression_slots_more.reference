SELECT count() OVER (ORDER BY b ASC ROWS BETWEEN 1 PRECEDING AND CURRENT ROW), a FROM t1 INNER JOIN t2 ON t1.k = t2.k ORDER BY a ASC WITH FILL FROM 1 TO 10 STEP 2 INTERPOLATE (`b` AS b + 1)
CREATE TABLE t (`a` UInt8 DEFAULT 1 TTL d + toIntervalDay(1), `d` Date) ENGINE = MergeTree ORDER BY a TTL d + toIntervalMonth(1) WHERE a > 0
INSERT INTO t FORMAT Values
INSERT INTO t FROM INFILE \'f.csv\'

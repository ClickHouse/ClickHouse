CREATE TABLE default.t_nested_parens_src\n(\n    `x` UInt64,\n    `y` UInt64\n)\nENGINE = MergeTree\nPARTITION BY (x + (1))\nORDER BY y\nSETTINGS index_granularity = 8192
CREATE TABLE default.t_parens_ttl\n(\n    `x` UInt64,\n    `d` Date\n)\nENGINE = MergeTree\nORDER BY x\nTTL (d + toIntervalYear(10))\nSETTINGS index_granularity = 8192

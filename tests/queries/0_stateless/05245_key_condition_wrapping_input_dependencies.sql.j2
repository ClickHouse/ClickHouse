-- Tags: no-random-settings, no-random-merge-tree-settings
-- The part and granule counts require fixed index and query-plan settings.

SET explain_query_plan_default = 'legacy';
SET analyze_index_with_multiple_key_columns_per_condition = 1;
SET use_query_condition_cache = 0;
SET allow_statistics = 1;
SET materialize_statistics_on_insert = 1;

{#- Each check prints the predicate, the count with index analysis, the count of a full scan and the marks
    selected by index analysis (with `indexes`, the parts and granules selected by each index instead).
    `settings` apply to the whole check. -#}
{% macro check(table, predicate, settings = '', indexes = false) -%}
SELECT '{{ predicate | replace("\\", "\\\\") | replace("'", "\\'") }}', (SELECT count() FROM {{ table }} WHERE {{ predicate }}),
    (SELECT count() FROM {{ table }} WHERE {{ predicate }} SETTINGS use_primary_key = 0, use_partition_pruning = 0, use_skip_indexes = 0),
    {% if indexes -%}
    (SELECT arrayStringConcat(groupArray(trimLeft(explain)), ' ') FROM (EXPLAIN indexes = 1 SELECT 1 FROM {{ table }} WHERE {{ predicate }}) WHERE match(trimLeft(explain), '^(Min-Max|Partition|Statistics|PrimaryKey|Skip|Name:|Parts:|Granules:)'))
    {%- else -%}
    (SELECT sum(marks) FROM (EXPLAIN ESTIMATE SELECT 1 FROM {{ table }} WHERE {{ predicate }}))
    {%- endif %}
    {%- if settings %} SETTINGS {{ settings }}{% endif %}
FORMAT TSVRaw;
{%- endmacro %}

-- Statistics use an input-only key expression. Each predicate must constrain its own column without
-- introducing dependencies on the other inputs. The checks run without and with statistics-based part
-- pruning.
CREATE TABLE wrapping_inputs (id UInt64, x UInt64, y UInt64) ENGINE = MergeTree ORDER BY id
SETTINGS auto_statistics_types = 'basic', add_minmax_index_for_numeric_columns = 0;
SYSTEM STOP MERGES wrapping_inputs;
INSERT INTO wrapping_inputs SELECT number, 0, 1 FROM numbers(64);
INSERT INTO wrapping_inputs SELECT number + 64, 1, 0 FROM numbers(64);
{{ check('wrapping_inputs', 'x = 1 AND y = 0', settings = 'use_statistics_for_part_pruning = 0', indexes = true) }}
{{ check('wrapping_inputs', 'x = 1 AND y = 0', settings = 'use_statistics_for_part_pruning = 1', indexes = true) }}

-- The aliased derived key improves pruning through `x`. Unrelated input keys remain in the expression, and
-- the derived candidate must remain available to both comparisons and sets. Each predicate runs without and
-- with `analyze_index_with_multiple_key_columns_per_condition`.
CREATE TABLE wrapping_derived (u UInt16, x UInt16, y UInt16) ENGINE = MergeTree ORDER BY (u, toUInt8(x) AS bucket, x, y)
SETTINGS index_granularity = 1, primary_key_ratio_of_unique_prefix_values_to_skip_suffix_columns = 0, add_minmax_index_for_numeric_columns = 0;
INSERT INTO wrapping_derived SELECT 0, number, 7 FROM numbers(512);
{{ check('wrapping_derived', 'u = 0 AND x = 257 AND y = 7', settings = 'analyze_index_with_multiple_key_columns_per_condition = 0') }}
{{ check('wrapping_derived', 'u = 0 AND x = 257 AND y = 7') }}
{{ check('wrapping_derived', 'u = 0 AND x IN (257, 259) AND y = 7', settings = 'analyze_index_with_multiple_key_columns_per_condition = 0') }}
{{ check('wrapping_derived', 'u = 0 AND x IN (257, 259) AND y = 7') }}

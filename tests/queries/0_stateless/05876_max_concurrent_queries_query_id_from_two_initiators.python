#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# A table's max_concurrent_queries must count two unrelated queries as two, whatever their secondary queries
# carry. A client chooses the query_id, so two queries sent to two initiators can reach a server reading for
# both with the same initial_query_id, and a client can also send such secondary queries itself. This script
# does the latter over the raw native protocol: both queries below carry the same initial_query_id and the
# same initial query start time.
#
# The ClientInfo layout is the one of revision 54484, as in 05061_query_log_interface_enum_unknown.

import os
import socket
import time
import urllib.parse
import urllib.request
import uuid

CLICKHOUSE_HOST = os.environ.get("CLICKHOUSE_HOST", "127.0.0.1")
CLICKHOUSE_PORT = int(os.environ.get("CLICKHOUSE_PORT_TCP", "9000"))
CLICKHOUSE_DATABASE = os.environ.get("CLICKHOUSE_DATABASE", "default")
CLICKHOUSE_URL = os.environ["CLICKHOUSE_URL"]
TABLE = os.environ["TABLE"]
CLIENT_NAME = "two initiators"

REVISION = 54484
TOO_MANY_SIMULTANEOUS_QUERIES = 202


def writeVarUInt(x, ba):
    for _ in range(0, 9):
        byte = x & 0x7F
        if x > 0x7F:
            byte |= 0x80
        ba.append(byte)
        x >>= 7
        if x == 0:
            return


def writeStringBinary(s, ba):
    b = bytes(s, "utf-8")
    writeVarUInt(len(b), ba)
    ba.extend(b)


def readStrict(s, size=1):
    res = bytearray()
    while size:
        cur = s.recv(size)
        if not cur:
            raise EOFError("Connection closed by server")
        size -= len(cur)
        res.extend(cur)
    return res


def readVarUInt(s):
    x = 0
    for i in range(9):
        byte = readStrict(s)[0]
        x |= (byte & 0x7F) << (7 * i)
        if not byte & 0x80:
            return x
    return x


def readStringBinary(s):
    size = readVarUInt(s)
    return readStrict(s, size).decode("utf-8")


def sendHello(s):
    ba = bytearray()
    writeVarUInt(0, ba)  # Hello
    writeStringBinary(CLIENT_NAME, ba)
    writeVarUInt(24, ba)  # major
    writeVarUInt(9, ba)  # minor
    writeVarUInt(REVISION, ba)
    writeStringBinary(CLICKHOUSE_DATABASE, ba)
    writeStringBinary("default", ba)  # user
    writeStringBinary("", ba)  # password
    s.sendall(ba)


def receiveHello(s):
    assert readVarUInt(s) == 0  # Hello
    readStringBinary(s)  # server name
    readVarUInt(s)  # major
    readVarUInt(s)  # minor
    readVarUInt(s)  # revision
    readVarUInt(s)  # parallel replicas protocol version (>= 54471)
    readStringBinary(s)  # timezone (>= 54058)
    readStringBinary(s)  # display name (>= 54372)
    readVarUInt(s)  # version patch (>= 54401)
    readStringBinary(s)  # proto_send chunked (>= 54470)
    readStringBinary(s)  # proto_recv chunked (>= 54470)
    for _ in range(readVarUInt(s)):  # password complexity rules (>= 54461)
        readStringBinary(s)
        readStringBinary(s)
    readStrict(s, 8)  # nonce, UInt64 (>= 54462)
    while True:  # server settings in STRINGS_WITH_FLAGS format (>= 54474)
        if readStringBinary(s) == "":
            break
        readVarUInt(s)  # flags
        readStringBinary(s)  # value
    readVarUInt(s)  # query plan serialization version (>= 54477)
    readVarUInt(s)  # cluster function protocol version (>= 54479)


def sendAddendum(s):
    ba = bytearray()
    writeStringBinary("", ba)  # quota key (>= 54458)
    writeStringBinary("notchunked", ba)  # proto_send chunked (>= 54470)
    writeStringBinary("notchunked", ba)  # proto_recv chunked (>= 54470)
    writeVarUInt(0, ba)  # parallel replicas protocol version (>= 54471)
    s.sendall(ba)


def serializeClientInfo(ba, initial_query_id, initial_query_start_time_us):
    ba.append(2)  # SECONDARY_QUERY
    writeStringBinary("default", ba)  # initial_user
    writeStringBinary(initial_query_id, ba)
    writeStringBinary("127.0.0.1:9000", ba)  # initial_address
    ba.extend(initial_query_start_time_us.to_bytes(8, "little", signed=True))  # (>= 54449)
    ba.append(1)  # interface = TCP
    writeStringBinary("os_user", ba)
    writeStringBinary("client_hostname", ba)
    writeStringBinary(CLIENT_NAME, ba)
    writeVarUInt(24, ba)  # client major
    writeVarUInt(9, ba)  # client minor
    writeVarUInt(REVISION, ba)  # client tcp protocol version
    writeStringBinary("", ba)  # quota key (>= 54060)
    writeVarUInt(1, ba)  # distributed_depth (>= 54448)
    writeVarUInt(1, ba)  # client version patch (>= 54401)
    ba.append(0)  # opentelemetry: no trace id (>= 54442)
    writeVarUInt(0, ba)  # parallel replicas: collaborate_with_initiator (>= 54453)
    writeVarUInt(0, ba)  # parallel replicas: obsolete count
    writeVarUInt(0, ba)  # parallel replicas: number_of_current_replica
    writeVarUInt(0, ba)  # script query number (>= 54475)
    writeVarUInt(0, ba)  # script line number (>= 54475)
    ba.append(0)  # jwt: none (>= 54476)


def startQuery(query, query_id, initial_query_id, initial_query_start_time_us, settings):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(300)
    s.connect((CLICKHOUSE_HOST, CLICKHOUSE_PORT))
    sendHello(s)
    receiveHello(s)
    sendAddendum(s)

    ba = bytearray()
    writeVarUInt(1, ba)  # Query
    writeStringBinary(query_id, ba)
    serializeClientInfo(ba, initial_query_id, initial_query_start_time_us)
    for key, value in settings.items():
        writeStringBinary(key, ba)
        writeVarUInt(1, ba)  # is_important
        writeStringBinary(str(value), ba)
    writeStringBinary("", ba)  # end of per-query settings
    writeStringBinary("", ba)  # interserver externally granted roles (>= 54472)
    writeStringBinary("", ba)  # interserver secret (>= 54441)
    writeVarUInt(2, ba)  # stage = Complete
    ba.append(0)  # no compression
    writeStringBinary(query, ba)
    writeStringBinary("", ba)  # query parameters terminator (>= 54459)

    # The empty block that ends the external tables.
    writeVarUInt(2, ba)  # Data
    writeStringBinary("", ba)
    writeVarUInt(1, ba)  # block info field 1
    ba.append(0)  # is_overflows = false
    writeVarUInt(2, ba)  # block info field 2
    ba.extend((-1).to_bytes(4, "little", signed=True))  # bucket_num = -1
    writeVarUInt(0, ba)  # end of block info
    writeVarUInt(0, ba)  # columns
    writeVarUInt(0, ba)  # rows
    s.sendall(ba)
    return s


def sql(query):
    params = urllib.parse.urlencode({"database": CLICKHOUSE_DATABASE})
    with urllib.request.urlopen(CLICKHOUSE_URL + "?" + params, data=query.encode("utf-8"), timeout=60) as response:
        return response.read().decode("utf-8").strip()


def waitUntil(condition, what):
    for _ in range(600):
        if sql(condition) == "1":
            return
        time.sleep(0.1)
    raise RuntimeError(what)


def exceptionCode(query_id):
    # The socket is kept open until the query has logged its terminal row: closing it cancels the query.
    for _ in range(600):
        sql("SYSTEM FLUSH LOGS query_log")
        code = sql(
            "SELECT any(exception_code) FROM system.query_log WHERE event_date >= yesterday() "
            "AND type != 'QueryStart' AND query_id = '{}' HAVING count() > 0".format(query_id)
        )
        if code != "":
            return int(code)
        time.sleep(0.1)
    raise RuntimeError("query {} logged no terminal row".format(query_id))


def check(label, query, settings, initial_query_id, start_time_us, expected):
    query_id = uuid.uuid4().hex
    s = startQuery(query, query_id, initial_query_id, start_time_us, settings)
    code = exceptionCode(query_id)
    s.close()
    if code != expected:
        raise RuntimeError("{}: expected exception code {}, got {}".format(label, expected, code))


def main():
    common = {
        "enable_parallel_replicas": 0,
        "automatic_parallel_replicas_mode": 0,
        "use_query_condition_cache": 0,
        "max_block_size": 1024,
        "max_execution_time": 300,
        "function_sleep_max_microseconds_per_block": 60000000,
    }
    modes = [
        ("plain read", {"make_distributed_plan": 0}),
        (
            "dispatched plan",
            {
                "make_distributed_plan": 1,
                "distributed_plan_execute_locally": 0,
                "max_rows_to_group_by": 0,
                "distributed_plan_max_rows_to_broadcast": 0,
                "distributed_plan_default_reader_bucket_count": 2,
            },
        ),
    ]
    # Only the first 30000 keys sleep, so the query holding the slot reads for ~30 s.
    slow = "SELECT count() FROM {} WHERE k < 150000 AND (k >= 30000 OR NOT sleepEachRow(0.001))".format(TABLE)
    fast = "SELECT count() FROM {} WHERE k < 150000".format(TABLE)

    for label, mode in modes:
        settings = dict(common, **mode)
        shared_query_id = "{}_{}".format(CLICKHOUSE_DATABASE, uuid.uuid4().hex)
        start_time_us = int(time.time() * 1000000)

        holder_id = uuid.uuid4().hex
        holder = startQuery(slow, holder_id, shared_query_id, start_time_us, settings)
        waitUntil(
            "SELECT count() > 0 FROM system.processes WHERE initial_query_id = '{}' AND read_rows > 0".format(
                shared_query_id
            ),
            "{}: the query holding the slot never read the table".format(label),
        )

        check(label, fast, settings, shared_query_id, start_time_us, TOO_MANY_SIMULTANEOUS_QUERIES)
        print("{}: another query with the same initial_query_id and start time is refused".format(label))

        sql("KILL QUERY WHERE query_id = '{}' SYNC FORMAT Null".format(holder_id))
        holder.close()


if __name__ == "__main__":
    main()

-- Tags: no-random-settings, no-random-merge-tree-settings
-- no-random-settings, no-random-merge-tree-settings: granule counts may differ with random settings.

-- `analyze_index_with_multiple_key_columns_per_condition = 0` keeps at most one atom per predicate
-- leaf. Set membership of a tuple of key columns then keeps only the per-component mapping; a key
-- column of type `Tuple` is still used for such a leaf when there is no per-component mapping at all.
-- `NOT IN` selects every granule on this data, so its condition shows that the leaf still builds its atom.

SET analyze_index_with_multiple_key_columns_per_condition = 0;
SET optimize_rewrite_has_to_in = 0;
SET explain_query_plan_default = 'legacy';

{#- Each check prints the predicate, the count with index analysis, the count of a full scan and the marks
    selected by index analysis; with `condition`, it also prints the key condition. -#}
{% macro check(table, predicate, condition = false) -%}
SELECT '{{ predicate | replace("\\", "\\\\") | replace("'", "\\'") }}', (SELECT count() FROM {{ table }} WHERE {{ predicate }}),
    (SELECT count() FROM {{ table }} WHERE {{ predicate }} SETTINGS use_primary_key = 0, use_partition_pruning = 0, use_skip_indexes = 0),
    (SELECT sum(marks) FROM (EXPLAIN ESTIMATE SELECT 1 FROM {{ table }} WHERE {{ predicate }}))
    {%- if condition %}, (SELECT arrayStringConcat(groupArray(trimLeft(explain)), ' | ') FROM (EXPLAIN indexes = 1 SELECT 1 FROM {{ table }} WHERE {{ predicate }}) WHERE trimLeft(explain) LIKE 'Condition:%'){% endif %}
FORMAT TSVRaw;
{%- endmacro %}

CREATE TABLE test_tuple_membership_setting_off (s String, x UInt8) ENGINE = MergeTree ORDER BY tuple(s, x)
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_tuple_membership_setting_off VALUES ('a', 1), ('b', 5), ('c', 9);

{{ check('test_tuple_membership_setting_off', "(s, x) IN (('b', 5))", condition = true) }}
{{ check('test_tuple_membership_setting_off', "(s, x) NOT IN (('b', 5))", condition = true) }}
{{ check('test_tuple_membership_setting_off', "has([('b', 5)], (s, x))") }}

-- The tuple of the predicate reaches only a `Tuple`-typed key column, so that mapping is the only
-- one this leaf has. It constrains a single key column and is kept with the setting off.
CREATE TABLE test_tuple_membership_setting_off_packed (s String, x UInt8, y UInt8) ENGINE = MergeTree
ORDER BY (tuple(s, x), y) SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_tuple_membership_setting_off_packed VALUES ('a', 1, 1), ('b', 5, 2), ('c', 9, 3);

{{ check('test_tuple_membership_setting_off_packed', "(s, x) IN (('b', 5))", condition = true) }}
{{ check('test_tuple_membership_setting_off_packed', "(s, x) NOT IN (('b', 5))", condition = true) }}
{{ check('test_tuple_membership_setting_off_packed', "has([('b', 5)], (s, x))") }}

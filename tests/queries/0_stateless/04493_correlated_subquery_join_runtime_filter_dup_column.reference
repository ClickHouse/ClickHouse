-- { echoOn }
SELECT l.a, l.a2
FROM (SELECT number AS a, number + 10 AS a2 FROM numbers(5)) AS l
LEFT ANTI JOIN (SELECT number, *, number + 10 AS c FROM numbers(3)) AS r
    ON l.a = r.number AND l.a2 = r.c
ORDER BY l.a;
3	13
4	14

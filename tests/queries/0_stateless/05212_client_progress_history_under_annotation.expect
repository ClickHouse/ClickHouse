#!/usr/bin/expect -f

# Regression test for the resource usage annotation rendered on top of the progress bar
# (once the query is at least halfway done): the cells it covers must keep the colors of
# the bar history, instead of being repainted with the current state only. The query is a
# hash join whose build side is read through a throttler (yellow) and whose probe side is
# CPU-bound (green), so the history under the annotation is mixed, and the annotation must
# be rendered with both background colors.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0
set local_path $CLICKHOUSE_TMP/$basename.path
# The path comes from the environment: it is not sent to the shell as text, but inherited by the
# spawned `bash` as a variable and expanded there inside double quotes, so no quoting is needed.
set env(CLICKHOUSE_LOCAL_PATH) $local_path
file delete -force -- $local_path

log_user 0
set timeout 120
match_max 100000
# The annotation is shown only when the progress bar is wider than twice the annotation, and
# the bar has to be wide enough for the throttled prefix to span more than one cell.
set stty_init "rows 25 cols 240"

expect_after {
    -i $any_spawn_id eof { exp_continue }
    -i $any_spawn_id timeout { exit 1 }
}

spawn bash --noprofile --norc -c "PS1='bash) ' bash --noprofile --norc"
send "source $basedir/../shell_config.sh\r"
expect "bash) "

send "\$CLICKHOUSE_LOCAL --path \"\$CLICKHOUSE_LOCAL_PATH\" --query 'CREATE TABLE t (n UInt64) ENGINE = MergeTree ORDER BY (); INSERT INTO t SELECT number FROM numbers(3000000)' && echo created\r"
expect "created"
expect "bash) "

# The build side of the join (`t`, a few seconds at 3 MB/s) is read before the probe side
# (`numbers`, CPU-bound), so the bar starts yellow and turns green later.
send "\$CLICKHOUSE_LOCAL --path \"\$CLICKHOUSE_LOCAL_PATH\" --progress --max_threads 1 --max_local_read_bandwidth 3000000 --query 'SELECT count() FROM numbers(100000000) AS a INNER JOIN t AS b ON a.number = b.n WHERE NOT ignore(sipHash64(a.number))' >/dev/null 2>&1\r"

# Past 50% the annotation is rendered at the left, on top of the bar, with a black-on-green
# (`30;42`) or black-on-yellow (`30;43`) background. A single background for the whole
# annotation would be the current state only; the history under it has both.
expect -re {\x1b\[30;42m[^\x1b]*\x1b\[0m\x1b\[30;43m|\x1b\[30;43m[^\x1b]*\x1b\[0m\x1b\[30;42m}

send "\3"
expect "bash) "

send "exit\r"
expect eof

file delete -force -- $local_path

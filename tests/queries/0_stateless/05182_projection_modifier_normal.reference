-- { echoOn }

-- The projection reads more marks than the base table, so it is used only when forced. The result is the same.
EXPLAIN indexes = 1, projections = 1 SELECT value FROM t_normal WHERE key < 10;
Output: value

ReadFromMergeTree (default.t_normal)
   Read type: Default
   Parts: 1 | Granules: 1
   Output: value
   Prewhere filter
   Prewhere filter column:  key < 10
   Indexes:
     PrimaryKey
       Keys:
         key
       Condition: (key in (-Inf, 9])
       Parts: 1/1
       Granules: 1/13
       Search Algorithm: binary search
     Ranges: 1
   Projections:
     Name: p_other
       Description: Projection p_other is usable but requires reading 13 marks, which is not better than the original table with 1 marks
       Condition: true
       Parts: 1
       Marks: 13
       Ranges: 1
       Rows: 100000
       Filtered Parts: 0
     Name: p_value
       Description: Projection p_value is usable but requires reading 13 marks, which is not better than the original table with 1 marks
       Condition: true
       Parts: 1
       Marks: 13
       Ranges: 1
       Rows: 100000
       Filtered Parts: 0
EXPLAIN indexes = 1, projections = 1 SELECT value FROM t_normal PROJECTION p_other WHERE key < 10;
Output: value

ReadFromMergeTree (p_other)
   Read type: Default
   Parts: 1 | Granules: 13
   Output: key, value
   Prewhere filter
   Prewhere filter column:  key < 10
   Indexes:
     PrimaryKey
       Condition: true
       Parts: 1/1
       Granules: 13/13
     Ranges: 1
SELECT sum(value) FROM t_normal WHERE key < 10;
90
SELECT sum(value) FROM t_normal PROJECTION p_other WHERE key < 10;
90
-- The modifier wins over the preferred projection setting.
EXPLAIN indexes = 1, projections = 1 SELECT value FROM t_normal PROJECTION p_other WHERE key < 10 SETTINGS preferred_optimize_projection_name = 'p_value';
Output: value

ReadFromMergeTree (p_other)
   Read type: Default
   Parts: 1 | Granules: 13
   Output: key, value
   Prewhere filter
   Prewhere filter column:  key < 10
   Indexes:
     PrimaryKey
       Condition: true
       Parts: 1/1
       Granules: 13/13
     Ranges: 1
-- The force settings see the projection as used.
SELECT sum(value) FROM t_normal PROJECTION p_other WHERE key < 10 SETTINGS force_optimize_projection = 1, force_optimize_projection_name = 'p_other';
90
-- Only the first optimization pass depends on this setting, the projection is still applied.
SELECT sum(value) FROM t_normal PROJECTION p_other WHERE key < 10 SETTINGS query_plan_enable_optimizations = 0;
90

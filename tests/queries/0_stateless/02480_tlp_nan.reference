SELECT sqrt(-1) as x, not(x), not(not(x)), (not(x)) IS NULL;
nan	0	1	0
SELECT -inf as x, not(x), not(not(x)), (not(x)) IS NULL;
-inf	0	1	0
SELECT NULL as x, not(x), not(not(x)), (not(x)) IS NULL;
\N	\N	\N	1
SELECT inf as x, not(x), not(not(x)), (not(x)) IS NULL;
inf	0	1	0
SELECT nan as x, not(x), not(not(x)), (not(x)) IS NULL;
nan	0	1	0

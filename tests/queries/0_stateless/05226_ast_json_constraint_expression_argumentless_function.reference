CREATE TABLE t (`a` UInt8 CODEC(LZ4), `b` UInt8 STATISTICS(tdigest), INDEX i a TYPE minmax GRANULARITY 1, CONSTRAINT c CHECK a > 0, CONSTRAINT d CHECK a IN (SELECT 1), CONSTRAINT e CHECK greater()) ENGINE = MergeTree ORDER BY a
CREATE TABLE t (`a` UInt8, CONSTRAINT c CHECK COLUMNS(\'a\') APPLY (x -> (x > 0)), CONSTRAINT d CHECK COLUMNS(\'a\') APPLY quantile(0.5)) ENGINE = MergeTree ORDER BY a
1	1	1	1

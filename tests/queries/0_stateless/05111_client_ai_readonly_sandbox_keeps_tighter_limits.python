# The sandbox of the unconfirmed read-only tool caps `max_execution_time` at 30 seconds. It is a
# cap, not a value to install: a session that already limits its queries more strictly must keep
# its own limit, or the queries the agent runs on its own behalf would be the one thing in the
# session allowed to run longer than the user permitted. `max_execution_time` is a `Seconds`
# setting backed by microseconds, so the check has to be made in microseconds - compared in whole
# seconds a sub-second limit rounds down to zero, reads as "no limit at all" and gets widened to
# the full 30 seconds.
#
# The agent is asked to run `SELECT getSetting('max_execution_time')` through `run_readonly_query`,
# which answers with the value the sandbox actually installed for it.
import json
import os
import pty
import select
import shlex
import signal
import threading
import time
from http.server import BaseHTTPRequestHandler, HTTPServer

TIMEOUT_SECONDS = 120

# How long a client may take to end after its terminal was closed, before it is killed.
TEARDOWN_SECONDS = 30

# `clickhouse-test` prints this file when the test fails, and it names it after the test case -
# the `.sh` wrapper - not after this script. Writing anywhere else means the trace of a failure in
# CI is collected and then never shown, which is the only record of what the client did.
DEBUG_LOG = os.path.join(
    os.environ["CLICKHOUSE_TMP"],
    os.path.basename(os.path.abspath(__file__)).removesuffix(".python") + ".sh.debuglog",
)

# Set when the pseudo-terminal reaches end of file: the client is gone. Every later read then
# returns at once and every write is silently discarded, so without noticing it the test runs to
# the end and reports every expectation as unmet, saying nothing about the client having died.
client_gone = False

FINAL_ANSWER = "MOCK-DONE"

QUERY = "SELECT getSetting('max_execution_time')"

# The `max_execution_time` of the session, the value the sandbox must leave the autonomous query
# with, and - where the limit is tight enough for the query to run into it - the failure that
# proves the same thing. Everything at or below the 30-second cap is the user's own limit and is
# kept; only an absent or looser limit is replaced by the cap.
#
# The autonomous query runs under the limit the sandbox installed, so with a sub-second one it may
# legitimately not finish: the server then reports the maximum it exceeded, which names the same
# sub-second value. Either outcome proves the point and neither is possible had the sandbox
# widened the limit to the 30-second cap, so both are accepted and reported alike.
CASES = [
    ("subsecond", "0.5", "0.5", "maximum: 500.000 ms"),
    ("under_the_cap", "10", "10", None),
    ("unlimited", "0", "30", None),
    ("over_the_cap", "120", "30", None),
]


class Handler(BaseHTTPRequestHandler):
    """A mock OpenAI-compatible provider. It answers with one `run_readonly_query` tool call and
    finishes with a plain text message."""

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        request = json.loads(self.rfile.read(length))
        self.server.last_request = request

        # The number of tool calls already made is the number of tool results in the history.
        done = sum(1 for m in request["messages"] if m.get("role") == "tool")
        if done == 0:
            message = {
                "role": "assistant",
                "content": None,
                "tool_calls": [
                    {
                        "id": "call_limit",
                        "type": "function",
                        "function": {
                            "name": "run_readonly_query",
                            "arguments": json.dumps({"query": QUERY}),
                        },
                    }
                ],
            }
            finish_reason = "tool_calls"
        else:
            message = {"role": "assistant", "content": FINAL_ANSWER}
            finish_reason = "stop"

        body = json.dumps(
            {
                "id": "chatcmpl-1",
                "object": "chat.completion",
                "created": 1,
                "model": "gpt-4o",
                "choices": [
                    {"index": 0, "message": message, "finish_reason": finish_reason}
                ],
                "usage": {
                    "prompt_tokens": 1,
                    "completion_tokens": 1,
                    "total_tokens": 2,
                },
            }
        ).encode()

        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


def make_config(port):
    """A client configuration that points the AI agent at the mock provider. The credentials come
    from the configuration and not from the environment, so the agent does not ask for the
    confirmation of using an API key found there."""
    path = os.path.join(
        os.environ["CLICKHOUSE_TMP"],
        os.path.basename(os.path.abspath(__file__)).removesuffix(".python") + ".config.xml",
    )
    with open(path, "w") as f:
        f.write(
            "<clickhouse><ai>"
            "<provider>openai</provider>"
            "<api_key>mock-key</api_key>"
            f"<base_url>http://127.0.0.1:{port}/v1</base_url>"
            "<model>gpt-4o</model>"
            "<max_steps>5</max_steps>"
            "</ai></clickhouse>"
        )
    return path


def drain(master, debug_log_fd, idle):
    global client_gone
    while True:
        r, _, _ = select.select([master], [], [], idle)
        if not r:
            break
        try:
            chunk = os.read(master, 65536)
        except OSError:
            client_gone = True
            break
        if not chunk:
            client_gone = True
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()


def read_until(master, debug_log_fd, predicate, timeout):
    global client_gone
    output = ""
    deadline = time.time() + timeout
    while time.time() < deadline:
        r, _, _ = select.select([master], [], [], 0.3)
        if not r:
            continue
        try:
            chunk = os.read(master, 65536)
        except OSError:
            client_gone = True
            break
        if not chunk:
            client_gone = True
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()
        output += chunk.decode(errors="replace")
        if predicate(output):
            return output
    return output


def wait_for_client(child_pid):
    """Wait for the client to end after its terminal was closed, and make sure it is gone. A
    client that ignores the end of its terminal must not outlive its case, so the wait is bounded
    and ends in a kill rather than in hanging the test."""
    deadline = time.time() + TEARDOWN_SECONDS
    while time.time() < deadline:
        try:
            reaped, _ = os.waitpid(child_pid, os.WNOHANG)
        except ChildProcessError:
            return
        if reaped == child_pid:
            return
        time.sleep(0.05)
    try:
        os.kill(child_pid, signal.SIGKILL)
        os.waitpid(child_pid, 0)
    except (ChildProcessError, ProcessLookupError):
        pass


def report_client_if_gone(child_pid):
    """Print how the client ended if it is gone. The expected output has no such line, so it
    shows up in the diff of the failure instead of leaving only unmet expectations behind."""
    if not client_gone:
        return
    try:
        _, status = os.waitpid(child_pid, os.WNOHANG)
    except ChildProcessError:
        print("client_gone: already reaped")
        return
    if os.WIFSIGNALED(status):
        print(f"client_gone: killed by signal {os.WTERMSIG(status)}")
    elif os.WIFEXITED(status):
        print(f"client_gone: exited with code {os.WEXITSTATUS(status)}")
    else:
        print("client_gone: yes")


def run_case(server, config, name, session_limit):
    """Drive one session whose `max_execution_time` is `session_limit`, and return what the
    autonomous query of the agent saw."""
    global client_gone
    client_gone = False
    server.last_request = {}

    base = shlex.split(os.environ["CLICKHOUSE_LOCAL"])
    argv = base + [
        "--config-file",
        config,
        "--history_file=/dev/null",
        "--max_execution_time",
        session_limit,
        "--path",
        os.path.join(os.environ["CLICKHOUSE_TMP"], f"05111_local_db_{name}"),
    ]

    child_pid, master = pty.fork()
    if child_pid == 0:
        os.environ["TERM"] = "xterm"
        # An API key in the environment would take precedence over the configured mock provider.
        os.environ.pop("OPENAI_API_KEY", None)
        os.environ.pop("ANTHROPIC_API_KEY", None)
        os.execv(base[0], argv)
        return None

    debug_log_fd = open(DEBUG_LOG, "a")
    try:
        read_until(master, debug_log_fd, lambda o: ":)" in o, TIMEOUT_SECONDS)
        os.write(master, b"? what is the execution time limit\n")
        read_until(master, debug_log_fd, lambda o: FINAL_ANSWER in o, TIMEOUT_SECONDS)
        report_client_if_gone(child_pid)

        for message in server.last_request.get("messages", []):
            if message.get("role") == "tool" and message.get("tool_call_id") == "call_limit":
                return str(message.get("content"))
        return None
    finally:
        # There is no way to type an exit: after answering, the client is still in AI-chat mode,
        # where `exit` is a question for the agent and not a command. Closing the terminal is
        # what ends the client, and it is waited for: a request it still has in flight would
        # otherwise land on the mock provider after the next case has reset `last_request`, and
        # be read as that case's answer.
        drain(master, debug_log_fd, 1.0)
        os.close(master)
        debug_log_fd.close()
        wait_for_client(child_pid)


def main():
    server = HTTPServer(("127.0.0.1", 0), Handler)
    server.last_request = {}
    threading.Thread(target=server.serve_forever, daemon=True).start()
    config = make_config(server.server_port)

    try:
        for name, session_limit, expected, timeout_proof in CASES:
            answer = run_case(server, config, name, session_limit)
            if answer is None:
                print(f"{name}: NO RESULT")
                continue
            # The tool answers with a JSON object: `result` holds the rendered output of the query
            # - a header line and then the single value on a line of its own - and a query that
            # failed comes back as `error` with the message of the server instead.
            try:
                parsed = json.loads(answer)
            except json.JSONDecodeError:
                parsed = None
            if isinstance(parsed, dict):
                rendered = str(parsed.get("result", ""))
                error = str(parsed.get("error", ""))
            else:
                rendered = answer
                error = answer
            values = [line.strip() for line in rendered.splitlines() if line.strip()]
            if expected in values or (timeout_proof is not None and timeout_proof in error):
                print(f"{name}: {expected}")
            else:
                print(f"{name}: UNEXPECTED {answer[:200]}")
    finally:
        server.shutdown()


if __name__ == "__main__":
    main()

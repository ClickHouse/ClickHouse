-- shuffle join with aggregation
Query fragment 4 (main) · initiator · tasks=1
GatherSend (final_result)
  GatherReceive (exchange_3)

Query fragment 3 (stage_3) · worker · tasks=3
GatherSend (exchange_3)
  Expression ((Project names + Projection))
    Aggregating
      ShuffleReceive (exchange_2)

Query fragment 2 (stage_2) · worker · tasks=3
ShuffleSend (exchange_2)
  Expression (Before GROUP BY)
    JoinLogical
      ShuffleReceive (exchange_0)
      ShuffleReceive (exchange_1)

Query fragment 1 (stage_1) · worker · tasks=3
ShuffleSend (exchange_1)
  Expression (Change column names to column identifiers)
    ReadFromMergeTree (default.small)

Query fragment 0 (stage_0) · worker · tasks=3
ShuffleSend (exchange_0)
  Expression (Calculate left join keys)
    Expression (Change column names to column identifiers)
      ReadFromMergeTree (default.big)

Exchanges:
  exchange_0: hash(modulo(plus(__table1.bid, 1_UInt8), 5000_UInt16)), pipelined, F0 -> F2, buckets 3 -> 3
  exchange_1: hash(__table2.sid), pipelined, F1 -> F2, buckets 3 -> 3
  exchange_2: hash(__table2.sid), pipelined, F2 -> F3, buckets 3 -> 3
  exchange_3: gather, pipelined, F3 -> F4, buckets 3 -> 1
Dependencies:
  F4 <- F3 (exchange_3, streaming)
  F3 <- F2 (exchange_2, blocking: hash aggregation)
  F2 <- F0 (exchange_0, streaming)
  F2 <- F1 (exchange_1, blocking: build side of JoinLogical)
Levels: [F0, F1] -> [F2] -> [F3] -> [F4]
-- broadcast join
Query fragment 3 (main) · initiator · tasks=1
GatherSend (final_result)
  Expression ((Project names + Projection))
    MergingAggregated (merge)
      GatherReceive (exchange_2)

Query fragment 2 (stage_2) · worker · tasks=3
GatherSend (exchange_2)
  Aggregating (partial)
    Expression (Before GROUP BY)
      JoinLogical
        ShuffleReceive (exchange_0)
        BroadcastReceive (exchange_1)

Query fragment 1 (stage_1) · worker · tasks=1
BroadcastSend (exchange_1)
  Expression (Change column names to column identifiers)
    ReadFromMergeTree (default.small)

Query fragment 0 (stage_0) · worker · tasks=1
ShuffleSend (exchange_0)
  Expression (Change column names to column identifiers)
    ReadFromMergeTree (default.big)

Exchanges:
  exchange_0: any, pipelined, F0 -> F2, buckets 1 -> 3
  exchange_1: broadcast, pipelined, F1 -> F2, buckets 1 -> 3
  exchange_2: gather, pipelined, F2 -> F3, buckets 3 -> 1
Dependencies:
  F3 <- F2 (exchange_2, streaming)
  F2 <- F0 (exchange_0, blocking: hash aggregation)
  F2 <- F1 (exchange_1, blocking: build side of JoinLogical)
Levels: [F0, F1] -> [F2] -> [F3]
-- aggregation
Query fragment 2 (main) · initiator · tasks=1
GatherSend (final_result)
  GatherReceive (exchange_1)

Query fragment 1 (stage_1) · worker · tasks=3
GatherSend (exchange_1)
  Expression ((Project names + Projection))
    Aggregating
      ShuffleReceive (exchange_0)

Query fragment 0 (stage_0) · worker · tasks=3
ShuffleSend (exchange_0)
  Expression ((Before GROUP BY + Change column names to column identifiers))
    ReadFromMergeTree (default.big)

Exchanges:
  exchange_0: hash(modulo(__table1.bid, 10_UInt8)), pipelined, F0 -> F1, buckets 3 -> 3
  exchange_1: gather, pipelined, F1 -> F2, buckets 3 -> 1
Dependencies:
  F2 <- F1 (exchange_1, streaming)
  F1 <- F0 (exchange_0, blocking: hash aggregation)
Levels: [F0] -> [F1] -> [F2]
-- order by
Query fragment 1 (main) · initiator · tasks=1
GatherSend (final_result)
  Expression (Project names)
    GatherReceive (exchange_0)

Query fragment 0 (stage_0) · worker · tasks=3
GatherSend (exchange_0)
  Sorting (Sorting for ORDER BY)
    Expression ((Before ORDER BY + (Projection + Change column names to column identifiers)))
      ReadFromMergeTree (default.big)

Exchanges:
  exchange_0: gather sorted by __table1.bid DESC, pipelined, F0 -> F1, buckets 3 -> 1
Dependencies:
  F1 <- F0 (exchange_0, streaming)
Levels: [F0] -> [F1]

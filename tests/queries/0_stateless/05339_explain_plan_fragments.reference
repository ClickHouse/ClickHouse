-- shuffle join with aggregation
Fragment 4 (main, initiator, tasks=1)
GatherSend (final_result)
  GatherReceive (exchange_3)

Fragment 3 (stage_3, worker, tasks=3)
GatherSend (exchange_3)
  Expression ((Project names + Projection))
    Aggregating
      ShuffleReceive (exchange_2)

Fragment 2 (stage_2, worker, tasks=3)
ShuffleSend (exchange_2)
  Expression (Before GROUP BY)
    JoinLogical
      ShuffleReceive (exchange_0)
      ShuffleReceive (exchange_1)

Fragment 1 (stage_1, worker, tasks=3)
ShuffleSend (exchange_1)
  Expression (Change column names to column identifiers)
    ReadFromMergeTree (default.small)

Fragment 0 (stage_0, worker, tasks=3)
ShuffleSend (exchange_0)
  Expression (Calculate left join keys)
    Expression (Change column names to column identifiers)
      ReadFromMergeTree (default.big)

Exchanges:
  exchange_0: hash(modulo(plus(__table1.bid, 1_UInt8), 5000_UInt16)), pipelined, Fragment 0 -> Fragment 2, buckets 3 -> 3
  exchange_1: hash(__table2.sid), pipelined, Fragment 1 -> Fragment 2, buckets 3 -> 3
  exchange_2: hash(__table2.sid), pipelined, Fragment 2 -> Fragment 3, buckets 3 -> 3
  exchange_3: gather, pipelined, Fragment 3 -> Fragment 4, buckets 3 -> 1
Dependencies:
  Fragment 4 <- Fragment 3 (exchange_3, streaming)
  Fragment 3 <- Fragment 2 (exchange_2, blocking: hash aggregation)
  Fragment 2 <- Fragment 0 (exchange_0, streaming)
  Fragment 2 <- Fragment 1 (exchange_1, blocking: build side of JoinLogical)
Levels: [0, 1] -> [2] -> [3] -> [4]
-- broadcast join
Fragment 3 (main, initiator, tasks=1)
GatherSend (final_result)
  Expression ((Project names + Projection))
    MergingAggregated (merge)
      GatherReceive (exchange_2)

Fragment 2 (stage_2, worker, tasks=3)
GatherSend (exchange_2)
  Aggregating (partial)
    Expression (Before GROUP BY)
      JoinLogical
        ShuffleReceive (exchange_0)
        BroadcastReceive (exchange_1)

Fragment 1 (stage_1, worker, tasks=1)
BroadcastSend (exchange_1)
  Expression (Change column names to column identifiers)
    ReadFromMergeTree (default.small)

Fragment 0 (stage_0, worker, tasks=1)
ShuffleSend (exchange_0)
  Expression (Change column names to column identifiers)
    ReadFromMergeTree (default.big)

Exchanges:
  exchange_0: any, pipelined, Fragment 0 -> Fragment 2, buckets 1 -> 3
  exchange_1: broadcast, pipelined, Fragment 1 -> Fragment 2, buckets 1 -> 3
  exchange_2: gather, pipelined, Fragment 2 -> Fragment 3, buckets 3 -> 1
Dependencies:
  Fragment 3 <- Fragment 2 (exchange_2, streaming)
  Fragment 2 <- Fragment 0 (exchange_0, blocking: hash aggregation)
  Fragment 2 <- Fragment 1 (exchange_1, blocking: build side of JoinLogical)
Levels: [0, 1] -> [2] -> [3]
-- aggregation
Fragment 2 (main, initiator, tasks=1)
GatherSend (final_result)
  GatherReceive (exchange_1)

Fragment 1 (stage_1, worker, tasks=3)
GatherSend (exchange_1)
  Expression ((Project names + Projection))
    Aggregating
      ShuffleReceive (exchange_0)

Fragment 0 (stage_0, worker, tasks=3)
ShuffleSend (exchange_0)
  Expression ((Before GROUP BY + Change column names to column identifiers))
    ReadFromMergeTree (default.big)

Exchanges:
  exchange_0: hash(modulo(__table1.bid, 10_UInt8)), pipelined, Fragment 0 -> Fragment 1, buckets 3 -> 3
  exchange_1: gather, pipelined, Fragment 1 -> Fragment 2, buckets 3 -> 1
Dependencies:
  Fragment 2 <- Fragment 1 (exchange_1, streaming)
  Fragment 1 <- Fragment 0 (exchange_0, blocking: hash aggregation)
Levels: [0] -> [1] -> [2]
-- order by
Fragment 1 (main, initiator, tasks=1)
GatherSend (final_result)
  Expression (Project names)
    GatherReceive (exchange_0)

Fragment 0 (stage_0, worker, tasks=3)
GatherSend (exchange_0)
  Sorting (Sorting for ORDER BY)
    Expression ((Before ORDER BY + (Projection + Change column names to column identifiers)))
      ReadFromMergeTree (default.big)

Exchanges:
  exchange_0: gather sorted by __table1.bid DESC, pipelined, Fragment 0 -> Fragment 1, buckets 3 -> 1
Dependencies:
  Fragment 1 <- Fragment 0 (exchange_0, streaming)
Levels: [0] -> [1]
-- make_distributed_plan = 0
Expression ((Project names + Projection))
  Aggregating
    Expression ((Before GROUP BY + Change column names to column identifiers))
      ReadFromMergeTree (default.big)
-- make_distributed_plan = 0, without fragments
Expression ((Project names + Projection))
  Aggregating
    Expression ((Before GROUP BY + Change column names to column identifiers))
      ReadFromMergeTree (default.big)
-- fallback to local execution
Expression ((Project names + Projection))
  TotalsHaving
    Aggregating
      Expression ((Before GROUP BY + Change column names to column identifiers))
        ReadFromMergeTree (default.big)

Not distributed: make_distributed_plan does not support WITH TOTALS
-- errors

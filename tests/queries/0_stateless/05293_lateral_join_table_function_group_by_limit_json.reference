-- (1)
SELECT *\nFROM t\nINNER JOIN lateral(1, 2) ON true
SELECT *\nFROM t\nINNER JOIN lateral(numbers(3)) AS l ON t.id = l.number
SELECT *\nFROM t, lateral(1)
SELECT *\nFROM t\nINNER JOIN LATERAL\n(\n    SELECT 1\n) AS s ON true
SELECT *\nFROM t\nLEFT JOIN LATERAL\n(\n    SELECT 1\n) AS s ON true

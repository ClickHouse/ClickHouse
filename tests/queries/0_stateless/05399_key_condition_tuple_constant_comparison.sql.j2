-- Tags: no-random-settings, no-random-merge-tree-settings
-- no-random-settings, no-random-merge-tree-settings: the selected marks may differ with random settings.

{#- Each check prints the predicate, the count with index analysis, the count of a full scan and the marks
    selected by index analysis. -#}
{% macro check(table, predicate) -%}
SELECT '{{ predicate | replace("\\", "\\\\") | replace("'", "\\'") }}', (SELECT count() FROM {{ table }} WHERE {{ predicate }}),
    (SELECT count() FROM {{ table }} WHERE {{ predicate }} SETTINGS use_primary_key = 0, use_partition_pruning = 0, use_skip_indexes = 0),
    (SELECT sum(marks) FROM (EXPLAIN ESTIMATE SELECT 1 FROM {{ table }} WHERE {{ predicate }}))
FORMAT TSVRaw;
{%- endmacro %}

-- Tuple equality compares the elements of the two sides by position, each with its own semantics: a `FixedString`
-- element matches every `String` that differs from it in trailing zero bytes, and element names do not take part.
-- Index analysis reads a tuple constant the same way, both for a key column holding the tuple and for a key
-- expression computed from it.

SET analyze_index_with_multiple_key_columns_per_condition = 1;

-- `('abc', 1)` and `('abc\0', 1)` both equal `(toFixedString('abc', 8), 1)`, which no atom over a single value
-- describes.
CREATE TABLE t_padding (t Tuple(String, UInt8)) ENGINE = MergeTree ORDER BY t SETTINGS index_granularity = 1;
INSERT INTO t_padding SELECT (['abc', 'abc\0', 'abd', 'abd\0'][number % 4 + 1], toUInt8(1)) FROM numbers(8);
{{ check('t_padding', "t = (toFixedString('abc', 8), toUInt8(1))") }}
{{ check('t_padding', "t != (toFixedString('abc', 8), toUInt8(1))") }}

CREATE TABLE t_padding_hash (t Tuple(String, UInt8)) ENGINE = MergeTree ORDER BY (t.2, cityHash64(t))
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO t_padding_hash SELECT t FROM t_padding;
{{ check('t_padding_hash', "t = (toFixedString('abc', 8), toUInt8(1))") }}

-- The padding widens the match at any depth of tuples.
CREATE TABLE t_padding_nested (t Tuple(Tuple(String, UInt8), UInt8)) ENGINE = MergeTree ORDER BY (t.2, cityHash64(t))
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO t_padding_nested SELECT (t, toUInt8(2)) FROM t_padding;
{{ check('t_padding_nested', "t = ((toFixedString('abc', 8), toUInt8(1)), toUInt8(2))") }}

-- Arrays compare in the common type of both sides, which drops the padding, so only `['abc']` matches and the key
-- expression prunes.
CREATE TABLE t_padding_array (a Array(String)) ENGINE = MergeTree ORDER BY (length(a), cityHash64(a))
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO t_padding_array SELECT [t.1] FROM t_padding;
{{ check('t_padding_array', "a = [toFixedString('abc', 8)]") }}

-- `(1, 2)` of `Tuple(a, b)` equals `(1, 2)` of `Tuple(b, a)`, while `CAST` between the two types swaps the elements.
CREATE TABLE t_names (t Tuple(b UInt8, a UInt8)) ENGINE = MergeTree ORDER BY (t.1 + t.2, cityHash64(t))
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO t_names SELECT if(number % 2, (1, 2), (2, 1)) FROM numbers(8);
{{ check('t_names', "t = CAST((1, 2), 'Tuple(a UInt8, b UInt8)')") }}

-- Names do not take part in nested tuples or in tuples inside arrays either.
CREATE TABLE t_names_nested (t Tuple(Tuple(b UInt8, a UInt8), UInt8)) ENGINE = MergeTree ORDER BY (t.2, cityHash64(t))
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO t_names_nested SELECT (t, toUInt8(3)) FROM t_names;
{{ check('t_names_nested', "t = CAST(((1, 2), 3), 'Tuple(Tuple(a UInt8, b UInt8), UInt8)')") }}

CREATE TABLE t_names_array (a Array(Tuple(b UInt8, a UInt8))) ENGINE = MergeTree ORDER BY (length(a), cityHash64(a))
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO t_names_array SELECT [t] FROM t_names;
{{ check('t_names_array', "a = CAST([(1, 2)], 'Array(Tuple(a UInt8, b UInt8))')") }}

-- https://github.com/ClickHouse/ClickHouse/issues/131545
untuple_value(11).1	untuple_value(22).1
11	22
-- the inner query alone
untuple_value(11).1	untuple_value(22).1
11	22
-- column arguments
untuple_value(number).1	untuple_value(plus(number, 1)).1
0	1
1	2
-- nested function
untuple_value_nested(11).1	untuple_value_nested(22).1
11	22
-- lambda arguments
untuple_map(lambda(tuple(x), plus(x, 1)), [1]).1	untuple_map(lambda(tuple(x), plus(x, 2)), [1]).1
[2]	[3]
map(lambda(tuple(x), plus(x, number)), [1])	map(lambda(tuple(x), multiply(x, number)), [1])
[1]	[0]
[2]	[1]
-- a lambda argument called in the body
apply_lambda(lambda(tuple(y), untuple(tuple(y))), 11).1	apply_lambda(lambda(tuple(y), untuple(tuple(y))), 22).1
11	22
wrap_apply_lambda(11).1	wrap_apply_lambda(22).1
11	22
-- a WITH lambda keeps its name: stored view definitions keep WITH lambdas
tupleElement((x), \'1\')
11
-- an alias still names the columns
a.1	b.1
11	22
-- view
tupleElement((11), \'1\')	tupleElement((22), \'1\')
11	22
-- remote()
untuple_value(plus(dummy, 11)).1	untuple_value(plus(dummy, 22)).1
11	22
-- names inside the body keep the parameter name
1
{"number":0}

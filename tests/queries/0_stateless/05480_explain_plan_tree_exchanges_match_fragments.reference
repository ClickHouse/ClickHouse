-- shuffle join, the key has the same name on both sides
Exchanges:
  exchange_0: hash(k), streaming, F0 -> F2, buckets 3 -> 3
  exchange_1: hash(k), streaming, F1 -> F2, buckets 3 -> 3
  exchange_2: hash(k), streaming, F2 -> F3, buckets 3 -> 3
  exchange_3: gather, streaming, F3 -> F4, buckets 3 -> 1
Levels: [F0, F1] -> [F2] -> [F3] -> [F4]
tree: same sections
-- broadcast join
Exchanges:
  exchange_0: any, streaming, F0 -> F2, buckets 1 -> 3
  exchange_1: broadcast, streaming, F1 -> F2, buckets 1 -> 3
  exchange_2: gather, streaming, F2 -> F3, buckets 3 -> 1
Levels: [F0, F1] -> [F2] -> [F3]
tree: same sections
-- aggregation
Exchanges:
  exchange_0: hash(k MOD 10), streaming, F0 -> F1, buckets 3 -> 3
  exchange_1: gather, streaming, F1 -> F2, buckets 3 -> 1
Levels: [F0] -> [F1] -> [F2]
tree: same sections
-- order by, a merging gather
Exchanges:
  exchange_0: gather sorted by k DESC, streaming, F0 -> F1, buckets 3 -> 1
Levels: [F0] -> [F1]
tree: same sections
-- shuffle join without pretty
Exchanges:
  exchange_0: hash(__table1.k), streaming, F0 -> F2, buckets 3 -> 3
  exchange_1: hash(__table2.k), streaming, F1 -> F2, buckets 3 -> 3
  exchange_2: hash(__table1.k), streaming, F2 -> F3, buckets 3 -> 3
  exchange_3: gather, streaming, F3 -> F4, buckets 3 -> 1
Levels: [F0, F1] -> [F2] -> [F3] -> [F4]
tree: same sections

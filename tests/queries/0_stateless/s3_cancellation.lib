#!/usr/bin/env bash

query_id="${CLICKHOUSE_TEST_UNIQUE_NAME}_check"
output="${CLICKHOUSE_TMP}/${CLICKHOUSE_TEST_UNIQUE_NAME}.out"
error="${CLICKHOUSE_TMP}/${CLICKHOUSE_TEST_UNIQUE_NAME}.err"
client_pid=""
cancel_number=0
read_options=()

query()
{
    # shellcheck disable=SC2086
    timeout 120 $CLICKHOUSE_CLIENT --allow_repeated_settings --async_insert=0 --send_logs_level=none \
        --enable_filesystem_cache=0 --enable_filesystem_cache_on_write_operations=0 \
        --use_page_cache_for_object_storage=0 --use_page_cache_for_disks_without_file_cache=0 "${read_options[@]}" "$@"
}

state()
{
    local database=${2:-$database} check_query=""
    if [[ "${3:-}" == check ]]; then
        check_query="CHECK TABLE ${database}.$1 SETTINGS check_query_single_value_result=1"
    fi
    query --query "SELECT
        (SELECT (count(), sum(n)) FROM ${database}.$1),
        (SELECT arraySort(groupArray(name)) FROM system.parts
         WHERE database='${database}' AND table='$1' AND active),
        (SELECT arraySort(groupArray((name, is_broken, exception_code, exception))) FROM system.projection_parts
         WHERE database='${database}' AND table='$1' AND active),
        (SELECT arraySort(groupArray((name, reason))) FROM system.detached_parts
         WHERE database='${database}' AND table='$1'),
        (SELECT count() FROM system.replication_queue
         WHERE database='${database}' AND table='$1' AND type='GET_PART');
        ${check_query}"
}

cancel_at()
{
    local statement=$1 failpoint=$2 method=$3 gate=${4:-}
    query_id="${CLICKHOUSE_TEST_UNIQUE_NAME}_check_$((++cancel_number))"
    local expected_error=QUERY_WAS_CANCELLED timeout_seconds=0 result=0
    if [[ "$method" == timeout ]]; then
        expected_error=TIMEOUT_EXCEEDED
        timeout_seconds=5
    elif [[ "$method" == injected ]]; then
        expected_error=FAULT_INJECTED
    fi
    local enable="SYSTEM ENABLE FAILPOINT ${gate:-$failpoint};"
    if [[ "$method" == injected ]]; then
        enable+="SYSTEM ENABLE FAILPOINT query_status_cancel_with_injected_exception;"
    fi
    query --query "$enable"
    query --query_id "$query_id" --max_threads=1 --max_execution_time="$timeout_seconds" \
        --timeout_overflow_mode=throw --query "$statement" >"$output" 2>"$error" &
    client_pid=$!
    if [[ -n "$gate" ]]; then
        # Arm the nested serialization pause only after checking the parent part.
        query --query "SYSTEM WAIT FAILPOINT ${gate} PAUSE;
            SYSTEM ENABLE FAILPOINT ${failpoint}; SYSTEM DISABLE FAILPOINT ${gate}"
    fi
    local wait_and_cancel="SYSTEM WAIT FAILPOINT ${failpoint} PAUSE;"
    if [[ "$method" != timeout ]]; then
        wait_and_cancel+="KILL QUERY WHERE query_id='${query_id}' ASYNC FORMAT Null;"
    fi
    local cancelled
    cancelled=$(query --query "${wait_and_cancel}
        SELECT count() FROM system.processes WHERE query_id='${query_id}' AND is_cancelled")
    local deadline=$((SECONDS + 60))
    while [[ "$cancelled" != 1 ]]; do
        (( SECONDS < deadline )) || return 1
        sleep 0.1
        cancelled=$(query --query "SELECT count() FROM system.processes WHERE query_id='${query_id}' AND is_cancelled")
    done
    local disable="SYSTEM DISABLE FAILPOINT ${failpoint};"
    if [[ "$method" == injected ]]; then
        disable+="SYSTEM DISABLE FAILPOINT query_status_cancel_with_injected_exception;"
    fi
    query --query "$disable"
    wait "$client_pid" || result=$?
    client_pid=""
    if (( result == 0 )) || [[ -s "$output" ]] \
        || ! grep -Eq "^Code: [0-9]+\..* \(${expected_error}\)( |$)" "$error"; then
        cat "$output" "$error"
        echo "Expected ${expected_error} with no result rows, client exit status: ${result}"
        return 1
    fi
    if [[ "$method" == injected ]]; then
        grep -q 'Injected query cancellation exception' "$error"
    fi
}

assert_preserved()
{
    local table=$1 before=$2 after database=${3:-$database}
    local expected="$before"$'\n1'
    after=$(state "$table" "$database" check)
    if [[ "$after" != "$expected" ]]; then
        diff -u <(printf '%s\n' "$expected") <(printf '%s\n' "$after")
        return 1
    fi
}

disable_failpoints()
{
    local statements="" failpoint
    for failpoint in "${failpoints[@]}"; do
        statements+="SYSTEM DISABLE FAILPOINT ${failpoint};"
    done
    query --query "$statements"
}

SELECT * FROM mysql(nc_mysql, \'[HIDDEN]\')	1	1
SELECT * FROM postgresql(nc_pg, \'[HIDDEN]\')	1	1
SELECT * FROM mysql(nc_mysql, \'[HIDDEN]\')	1	1

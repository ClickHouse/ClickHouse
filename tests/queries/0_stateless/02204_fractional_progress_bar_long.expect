#!/usr/bin/expect -f
# Tags: no-tsan, no-asan, no-ubsan, no-msan, no-debug, no-fasttest

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0

log_user 0
set timeout 60
match_max 100000

expect_after {
    # Do not ignore eof from expect
    -i $any_spawn_id eof { exp_continue }
    # A default timeout action is to do nothing, change it to fail
    -i $any_spawn_id timeout { exit 1 }
}

# The progress bar is only drawn when the terminal has room for it.
set stty_init "rows 25 cols 120"
spawn clickhouse-local --progress --query "SELECT sum(number % 100000000 = 12345678 ? sleep(0.1) : 1) FROM numbers(1000000000)"

expect {
    "▏" { exit 0 }
    "▎" { exit 0 }
    "▍" { exit 0 }
    "▌" { exit 0 }
    "▋" { exit 0 }
    "▋" { exit 0 }
    "▊" { exit 0 }
    "▉" { exit 0 }
    timeout { exit 1 }
}

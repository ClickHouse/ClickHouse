-- Tags: no-random-settings, no-random-merge-tree-settings
-- no-random-settings, no-random-merge-tree-settings: the selected marks and EXPLAIN output may differ with
-- random settings.

SET explain_query_plan_default = 'legacy';
-- The sparsity-stats trivial count would answer both counts of the `empty(s)` / `notEmpty(s)` checks from
-- per-column counters, with neither index analysis nor a scan, so they would not test the key condition.
SET optimize_trivial_count_with_sparsity_filter = 0;

{#- Each check prints the predicate, the count with index analysis, the count of a full scan and the marks
    selected by index analysis; with `condition`, it also prints the key condition. -#}
{% macro check(table, predicate, condition = false) -%}
SELECT '{{ predicate | replace("\\", "\\\\") | replace("'", "\\'") }}', (SELECT count() FROM {{ table }} WHERE {{ predicate }}),
    (SELECT count() FROM {{ table }} WHERE {{ predicate }} SETTINGS use_primary_key = 0, use_partition_pruning = 0, use_skip_indexes = 0),
    (SELECT sum(marks) FROM (EXPLAIN ESTIMATE SELECT 1 FROM {{ table }} WHERE {{ predicate }}))
    {%- if condition %}, (SELECT arrayStringConcat(groupArray(trimLeft(explain)), ' | ') FROM (EXPLAIN indexes = 1 SELECT 1 FROM {{ table }} WHERE {{ predicate }}) WHERE trimLeft(explain) LIKE 'Condition:%'){% endif %}
FORMAT TSVRaw;
{%- endmacro %}

-- Pruning-power floor: these are the classic single-atom scenarios; the pinned marks must keep showing
-- real pruning so that it cannot be lost silently.

CREATE TABLE test_floor_main (ts DateTime('UTC')) ENGINE = MergeTree ORDER BY (toYYYYMM(ts), toDate(ts), ts)
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_floor_main SELECT toDateTime('2026-03-30 00:00:00', 'UTC') + INTERVAL intDiv(number, 4) DAY + INTERVAL (number % 4) * 6 HOUR FROM numbers(24);

-- Direct predicates on key expressions. The preimage optimization rewrites them into `ts`
-- ranges before index analysis; the pruning must stay as good as with the original predicates.
{{ check('test_floor_main', "toDate(ts) = toDate('2026-03-31')", condition = true) }}
{{ check('test_floor_main', "toYYYYMM(ts) = 202604") }}
{{ check('test_floor_main', "toDate(ts) IN (toDate('2026-03-31'), toDate('2026-04-02'))") }}

-- Monotonic constant wrapping.
CREATE TABLE test_floor_wrap (ts DateTime('UTC')) ENGINE = MergeTree ORDER BY toDate(ts)
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_floor_wrap SELECT toDateTime('2026-03-01 00:00:00', 'UTC') + INTERVAL intDiv(number, 4) DAY + INTERVAL (number % 4) * 6 HOUR FROM numbers(24);

{{ check('test_floor_wrap', "ts > toDateTime('2026-03-04 06:00:00', 'UTC')") }}

-- Injective deterministic wrapping: equality and negated equality both produce exact
-- atoms on concat(s, '_x') (the negated one cannot exclude granules at this size
-- because adjacent mark ranges overlap at the point, but the atom must stay exact).
CREATE TABLE test_floor_concat (s String) ENGINE = MergeTree ORDER BY concat(s, '_x')
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_floor_concat VALUES ('a'), ('b'), ('c'), ('d');

{{ check('test_floor_concat', "s = 'b'") }}
{{ check('test_floor_concat', "s != 'b'", condition = true) }}

-- IN and has over a direct key column.
CREATE TABLE test_floor_direct (x UInt32) ENGINE = MergeTree ORDER BY x
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_floor_direct SELECT number FROM numbers(16);

{{ check('test_floor_direct', "x IN (3, 7, 11)") }}
{{ check('test_floor_direct', "has([3, 7, 11], x)") }}

-- isNull / isNotNull over a Nullable key column. The two parts stay separate, so the selected marks do not
-- depend on a background merge.
CREATE TABLE test_floor_nullable (ts Nullable(DateTime('UTC'))) ENGINE = MergeTree ORDER BY ts
SETTINGS allow_nullable_key = 1, index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
SYSTEM STOP MERGES test_floor_nullable;
INSERT INTO test_floor_nullable SELECT toDateTime('2026-03-01 00:00:00', 'UTC') + INTERVAL number DAY FROM numbers(8);
INSERT INTO test_floor_nullable VALUES (NULL), (NULL);

{{ check('test_floor_nullable', "isNull(ts)") }}
{{ check('test_floor_nullable', "isNotNull(ts)") }}

-- empty / notEmpty over a String key.
CREATE TABLE test_floor_str (s String) ENGINE = MergeTree ORDER BY s
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_floor_str VALUES (''), ('a'), ('b'), ('c');

{{ check('test_floor_str', "empty(s)") }}
{{ check('test_floor_str', "notEmpty(s)") }}

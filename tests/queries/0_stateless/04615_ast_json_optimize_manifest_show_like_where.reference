OPTIMIZE TABLE t MANIFEST
OPTIMIZE TABLE db.t FINAL DEDUPLICATE CLEANUP MANIFEST
SHOW FULL TABLES
SHOW FULL TEMPORARY TABLES
SHOW FULL TABLES FROM db NOT LIKE \'t%\' LIMIT 5
SHOW FULL DICTIONARIES
SHOW TABLES WHERE name = \'x\'
SHOW FULL COLUMNS FROM t ILIKE \'x%\'
SHOW COLUMNS FROM t WHERE field = \'a\'

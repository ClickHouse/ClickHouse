--- A: Float32, values=(1.5), (nan)
WHERE f != 1.5 -> rows=1 pruned_files=0
WHERE NOT (f <= 1.5) -> rows=1 pruned_files=0
WHERE NOT (f < 2) -> rows=1 pruned_files=0
WHERE f > 2 -> rows=0 pruned_files=1
--- B: Float64, values=(1.5), (nan)
WHERE f != 1.5 -> rows=1 pruned_files=0
WHERE NOT (f <= 1.5) -> rows=1 pruned_files=0
WHERE NOT (f < 2) -> rows=1 pruned_files=0
WHERE f > 2 -> rows=0 pruned_files=1
--- C: Float64, values=(1.5), (1.5)
WHERE f != 1.5 -> rows=0 pruned_files=1
WHERE NOT (f <= 1.5) -> rows=0 pruned_files=1
WHERE NOT (f < 2) -> rows=0 pruned_files=1
--- D: Float64, values=(1.5), (nan), then (2.5), (3.5), then OPTIMIZE TABLE ... MANIFEST
nan_value_counts=[(1,0)]
nan_value_counts=[(1,1)]
WHERE f != 1.5 -> rows=3 pruned_files=0
--- E: Float32, values=(1.5), (nan), then MODIFY COLUMN f Float64, then (10.5), (20.5)
WHERE f != 1.5 -> rows=3 pruned_files=0
WHERE f < 2 -> rows=1 pruned_files=1
WHERE f > 15 -> rows=1 pruned_files=1

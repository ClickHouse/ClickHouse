-- the TTL of a user-declared recent samples engine is derived from the setting
MergeTree PARTITION BY toStartOfDay(timestamp) ORDER BY (id, timestamp) TTL toDateTime(timestamp) + toIntervalSecond(432000) SETTINGS index_granularity = 8192, ttl_only_drop_parts = 1

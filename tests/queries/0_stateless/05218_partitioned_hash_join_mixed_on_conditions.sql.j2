-- A mixed ON condition is an equality key plus a condition over columns of both sides, such as
-- `t1.key = t2.key AND t1.a < t2.a`. Under `join_algorithm = 'partitioned_hash'` every kind and
-- strictness that `hash` supports with such a condition must return what `hash` returns: ALL
-- INNER/LEFT/RIGHT/FULL, ANY INNER/LEFT/RIGHT, SEMI LEFT/RIGHT, ANTI LEFT/RIGHT. INNER and LEFT run the
-- residual filter over the partitioned table; RIGHT and FULL need per-row used flags and run the
-- standard join behind the partitioned interface. The query log check at the end asserts that the
-- partitioned join ran every labelled query. ANY and SEMI shapes pick an arbitrary passing row per key,
-- so their checksums use only the columns that the key determines.

SET enable_analyzer = 1;
SET allow_experimental_join_condition = 1;
SET query_plan_join_swap_table = 0;
SET query_plan_optimize_join_order_randomize = 0;
-- The runner randomizes `max_bytes_before_external_join`; any non-zero spill budget would wrap the join
-- in `SpillingHashJoin`.
SET max_bytes_before_external_join = 0;
SET max_bytes_ratio_before_external_join = 0;
SET max_bytes_in_join = 0;
-- The ProfileEvents assertions below read this server's query_log; with parallel replicas the
-- join builds (and their events) can land on other replicas.
SET enable_parallel_replicas = 0;

DROP TABLE IF EXISTS t1;
DROP TABLE IF EXISTS t2;

CREATE TABLE t1 (key String, attr String, a UInt64, b UInt64, c Nullable(UInt64)) ENGINE = MergeTree ORDER BY key;
INSERT INTO t1 VALUES ('key1', 'a', 1, 1, 2), ('key1', 'b', 2, 3, 2), ('key1', 'c', 3, 2, 1), ('key1', 'd', 4, 7, 2), ('key1', 'e', 5, 5, 5), ('key2', 'a2', 1, 1, 1), ('key4', 'f', 2, 3, 4);
CREATE TABLE t2 (key String, attr String, a UInt64, b UInt64, c Nullable(UInt64)) ENGINE = MergeTree ORDER BY key;
INSERT INTO t2 VALUES ('key1', 'A', 1, 2, 1), ('key1', 'B', 2, 1, 2), ('key1', 'C', 3, 4, 5), ('key1', 'D', 4, 1, 6), ('key3', 'a3', 1, 1, 1), ('key4', 'F', 1, 1, 1);

SELECT '-- the rows of two shapes, so the checksums below are anchored to visible data';
SELECT t1.*, t2.* FROM t1 LEFT JOIN t2 ON t1.key = t2.key AND t1.a < t2.a ORDER BY ALL SETTINGS join_algorithm = 'partitioned_hash';
SELECT t1.*, t2.* FROM t1 FULL JOIN t2 ON t1.key = t2.key AND (t1.b + t2.b == t1.c + t2.c) ORDER BY ALL SETTINGS join_algorithm = 'partitioned_hash';

SELECT '-- every kind and strictness, three conditions: count, and whether hash and partitioned_hash agree';
{% for join_type, projection in [
    ('LEFT', 't1.key, t1.attr, t2.key, t2.attr'),
    ('INNER', 't1.key, t1.attr, t2.key, t2.attr'),
    ('RIGHT', 't1.key, t1.attr, t2.key, t2.attr'),
    ('FULL', 't1.key, t1.attr, t2.key, t2.attr'),
    ('ANY LEFT', 't1.key, t1.attr, t2.key'),
    ('ANY INNER', 't1.key, t1.attr, t2.key'),
    ('ANY RIGHT', 't1.key, t2.key, t2.attr'),
    ('SEMI LEFT', 't1.key, t1.attr'),
    ('SEMI RIGHT', 't2.key, t2.attr'),
    ('ANTI LEFT', 't1.key, t1.attr, t2.key, t2.attr'),
    ('ANTI RIGHT', 't1.key, t1.attr, t2.key, t2.attr')] -%}
{% for condition in [
    't1.key = t2.key AND t1.a < t2.a',
    't1.key = t2.key AND (t1.b + t2.b == t1.c + t2.c)',
    '(t1.a < t2.a OR lower(t1.attr) == lower(t2.attr)) AND t1.key = t2.key'] -%}
SELECT '{{ join_type }} | {{ condition }}', h.1, h = pa FROM (SELECT
    (SELECT (count(), arraySort(groupArray(({{ projection }})))) FROM t1 {{ join_type }} JOIN t2 ON {{ condition }} SETTINGS join_algorithm = 'hash') AS h,
    (SELECT (count(), arraySort(groupArray(({{ projection }})))) FROM t1 {{ join_type }} JOIN t2 ON {{ condition }} SETTINGS join_algorithm = 'partitioned_hash') AS pa)
SETTINGS log_comment = '05218 mixed';
{% endfor -%}
{% endfor -%}

SELECT '-- a subquery inside the condition';
SELECT 'LEFT | subquery', h.1, h = pa FROM (SELECT
    (SELECT (count(), arraySort(groupArray((t1.key, t1.attr, t2.key, t2.attr)))) FROM t1 LEFT JOIN t2 ON t1.key = t2.key AND (t1.a = 2 OR (t2.a IN (SELECT a FROM t1 WHERE a = 3))) SETTINGS join_algorithm = 'hash') AS h,
    (SELECT (count(), arraySort(groupArray((t1.key, t1.attr, t2.key, t2.attr)))) FROM t1 LEFT JOIN t2 ON t1.key = t2.key AND (t1.a = 2 OR (t2.a IN (SELECT a FROM t1 WHERE a = 3))) SETTINGS join_algorithm = 'partitioned_hash') AS pa)
SETTINGS log_comment = '05218 mixed';

SELECT '-- join_use_nulls: the other side becomes Nullable and the residual still decides the match';
{% for join_type in ['LEFT', 'RIGHT', 'FULL', 'INNER', 'ANY LEFT', 'SEMI LEFT', 'ANTI LEFT'] -%}
SELECT '{{ join_type }} | join_use_nulls', h.1, h = pa FROM (SELECT
    (SELECT (count(), arraySort(groupArray((t1.key, t1.attr, t2.key, toTypeName(t2.key), {% if join_type in ['LEFT', 'RIGHT', 'FULL', 'INNER', 'ANTI LEFT'] %}t2.attr{% else %}0{% endif %})))) FROM t1 {{ join_type }} JOIN t2 ON t1.key = t2.key AND t1.c >= t2.c SETTINGS join_algorithm = 'hash', join_use_nulls = 1) AS h,
    (SELECT (count(), arraySort(groupArray((t1.key, t1.attr, t2.key, toTypeName(t2.key), {% if join_type in ['LEFT', 'RIGHT', 'FULL', 'INNER', 'ANTI LEFT'] %}t2.attr{% else %}0{% endif %})))) FROM t1 {{ join_type }} JOIN t2 ON t1.key = t2.key AND t1.c >= t2.c SETTINGS join_algorithm = 'partitioned_hash', join_use_nulls = 1) AS pa)
SETTINGS log_comment = '05218 mixed';
{% endfor -%}

SELECT '-- a build large enough to partition, and probe blocks the residual filter stops at max_joined_block_size_rows';
{% for join_type, projection in [('LEFT', 'p.k, p.v, b.v'), ('ANY LEFT', 'p.k, p.v, b.k'), ('SEMI LEFT', 'p.k, p.v'), ('ANTI LEFT', 'p.k, p.v'), ('ANY INNER', 'p.k, p.v, b.k')] -%}
SELECT '{{ join_type }} | large', h.1, h = pa FROM (SELECT
    (SELECT (count(), sum(cityHash64({{ projection }}))) FROM (SELECT number % 1000 AS k, number AS v FROM numbers(20000)) AS p {{ join_type }} JOIN (SELECT number % 1000 AS k, number * 3 AS v FROM numbers(300000)) AS b ON p.k = b.k AND p.v * 50 < b.v SETTINGS join_algorithm = 'hash', max_joined_block_size_rows = 7, max_block_size = 64) AS h,
    (SELECT (count(), sum(cityHash64({{ projection }}))) FROM (SELECT number % 1000 AS k, number AS v FROM numbers(20000)) AS p {{ join_type }} JOIN (SELECT number % 1000 AS k, number * 3 AS v FROM numbers(300000)) AS b ON p.k = b.k AND p.v * 50 < b.v SETTINGS join_algorithm = 'partitioned_hash', max_joined_block_size_rows = 7, max_block_size = 64) AS pa)
SETTINGS log_comment = '05218 mixed';
{% endfor -%}

SELECT '-- a shape hash rejects with a mixed condition is rejected the same way';
SELECT count() FROM t1 ASOF LEFT JOIN t2 ON (t1.key = t2.key) AND (t1.a <= t2.a) AND (t1.a * 10 != t2.a) SETTINGS join_algorithm = 'partitioned_hash'; -- { serverError INVALID_JOIN_ON_EXPRESSION }

SYSTEM FLUSH LOGS query_log;

SELECT '-- every labelled query ran the partitioned join';
SELECT count() > 0, countIf(ProfileEvents['HashJoinPartitions'] = 0)
FROM system.query_log
WHERE current_database = currentDatabase() AND type = 'QueryFinish' AND log_comment = '05218 mixed';

DROP TABLE t1;
DROP TABLE t2;

SELECT extract(materialize(\'aBcd\'), \'(?i:(b))\') AS `extract(materialize(\'aBcd\'), \'(?i:(b)).*$\')`
FROM system.one AS __table1
SELECT extract(materialize(\'abcd\'), \'(a)(?:b)\') AS `extract(materialize(\'abcd\'), \'(a)(?:b).*$\')`
FROM system.one AS __table1
SELECT extract(materialize(\'aBcd\'), \'(?i)b.*$\') AS `extract(materialize(\'aBcd\'), \'(?i)b.*$\')`
FROM system.one AS __table1
SELECT extract(materialize(\'aBcd\'), \'(?i:b).*$\') AS `extract(materialize(\'aBcd\'), \'(?i:b).*$\')`
FROM system.one AS __table1

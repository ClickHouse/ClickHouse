#!/usr/bin/expect -f
# Tags: no-fasttest
# no-fasttest: three paced queries of about 3 seconds each.

# The live IO meter of https://github.com/ClickHouse/ClickHouse/issues/116565, asserted on the
# rendered progress line itself (ClientBase::onProfileEvents -> ProgressIndication::writeProgress).
# Network throughput is part of the IO sum, so this assertion needs no disk, O_DIRECT, or taskstats
# and runs on every platform; the disk carrier is asserted through the same client path by
# 05026_client_io_progress_line_disk.expect, and its server-side counter flow by
# 05026_client_disk_io_progress_streaming.sql.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0
set history_file $CLICKHOUSE_TMP/$basename.history

log_user 0
set timeout 60
match_max 100000
# The profiling suffix `(... CPU, ... IO)` is dropped when it does not fit next to the progress bar,
# and the width is re-read from the pty on every render - so make the pty wide.
set stty_init "rows 60 columns 300"

expect_after {
    # Do not ignore eof from expect
    -i $any_spawn_id eof { exp_continue }
    # A default timeout action is to do nothing, change it to fail
    -i $any_spawn_id timeout { exit 1 }
}

# CLICKHOUSE_CLIENT_EXPECT_OPT is not used because it forces --progress no.
spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_OPT --disable_suggestion --no-warnings --progress-table off --enable-progress-table-toggle 0 --highlight 0 --history_file=$history_file"
expect ":) "

# Fails when every whole progress line after 200 of the 300 rows shows 10 KB/s of IO or more.
# A stray write of the server shows only as a short decaying spike, so it does not fail.
proc fail_on_sustained_io {} {
    set late 0
    set late_low 0
    expect {
        -re {Progress: ([0-9]+)\.[0-9]+ rows([^\r\n]*)\r} {
            if {$expect_out(1,string) >= 200} {
                incr late
                set rate 0
                if {[regexp {([0-9.]+) ([A-Za-z]*)B/s IO} $expect_out(2,string) -> value prefix]} {
                    set rate [expr {$value * [dict get {{} 1 K 1e3 M 1e6 G 1e9 T 1e12} $prefix]}]
                }
                if {$rate < 10000} { incr late_low }
            }
            exp_continue
        }
        "rows in set." {}
    }
    if {$late > 0 && $late_low == 0} { exit 1 }
}

# An idle query sends only progress-reporting packets, which must not count as IO.
# With `interactive_delay` of 10 ms they are about 100 KB/s.
send -- "SELECT sleepEachRow(0.01) FROM numbers(300) SETTINGS max_block_size = 1, interactive_delay = 10000 FORMAT Null\r"
fail_on_sustained_io
expect ":) "

# The same for a distributed query: the remote server returns no rows, so the initiator
# receives only `Progress` and `ProfileEvents` packets from it, about 40 KB/s here.
send -- "SELECT * FROM remote('127.0.0.1', numbers(300)) WHERE sleepEachRow(0.01) != 0 SETTINGS prefer_localhost_replica = 0, max_block_size = 1, interactive_delay = 10000 FORMAT Null\r"
fail_on_sustained_io
expect ":) "

# ~30 MB stream paced to ~3 seconds, so ProfileEvents packets carry nonzero
# `NativeProtocolDataBytes` deltas; `FORMAT Null` intentionally leaves the meter at zero.
send -- "SELECT randomString(100000) AS s, sleepEachRow(0.01) FROM numbers(300) INTO OUTFILE '/dev/null' APPEND FORMAT TSV SETTINGS max_block_size = 10\r"
expect -re {[0-9.]+ [A-Za-z]*B/s IO}
expect "rows in set."
expect ":) "

send -- "\4"
expect eof

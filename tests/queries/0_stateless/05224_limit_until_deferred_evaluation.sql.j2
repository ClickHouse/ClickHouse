-- The start at row six is aligned with a chunk boundary at each block size.
{% for block_size in [1, 2, 3] %}
SET max_block_size = {{ block_size }};
SELECT 'max_block_size = {{ block_size }}';

-- `UNTIL` is not evaluated in chunks before the start, but is evaluated in later active chunks.
SELECT groupArray(number) FROM
    (SELECT number FROM numbers(12) ORDER BY number
     LIMIT AFTER number = 6 UNTIL throwIf(number < 6) + (number = 9));

-- A missing, constant-false, or null start never needs the end expression.
SELECT groupArray(number) FROM
    (SELECT number FROM numbers(12) ORDER BY number LIMIT AFTER number = 20 UNTIL throwIf(number < 12));
SELECT groupArray(number) FROM
    (SELECT number FROM numbers(12) ORDER BY number LIMIT AFTER 0 UNTIL throwIf(number < 12));
SELECT groupArray(number) FROM
    (SELECT number FROM numbers(12) ORDER BY number LIMIT AFTER NULL UNTIL throwIf(number < 12));

-- `AFTER` is not evaluated in chunks after the start, even when later chunks have an end condition.
SELECT groupArray(number) FROM
    (SELECT number FROM numbers(12) ORDER BY number
     LIMIT AFTER throwIf(number >= 9) + (number = 6) UNTIL number = 10);

-- Both expressions are skipped once the row count or the end condition finishes the range.
SELECT groupArray(number) FROM
    (SELECT number FROM numbers(12) ORDER BY number
     LIMIT 1 AFTER number = 6 UNTIL throwIf(number < 6 OR number >= 9));
SELECT groupArray(number) FROM
    (SELECT number FROM numbers(12) ORDER BY number
     LIMIT AFTER number = 6 UNTIL throwIf(number < 6 OR number >= 9) + (number = 6));

-- The end stage receives columns that are not needed by the start expression.
SELECT groupArray(number) FROM
    (SELECT number FROM (SELECT number, number * 2 AS end_value FROM numbers(12)) ORDER BY number
     LIMIT AFTER number = 6 UNTIL end_value = 18);

-- A shared stateful expression is evaluated once per chunk, including the starting chunk.
SELECT groupArray(number) FROM
    (SELECT number FROM numbers(12) ORDER BY number
     LIMIT AFTER rowNumberInAllBlocks() = 6 UNTIL rowNumberInAllBlocks() >= 9);

-- Identical boundary expressions use the same computed result on the starting row.
SELECT groupArray(number) FROM
    (SELECT number FROM numbers(12) ORDER BY number
     LIMIT AFTER rowNumberInAllBlocks() = 6 UNTIL rowNumberInAllBlocks() = 6);

-- Constant boundaries also work when neither stage needs input columns.
SELECT groupArray(number) FROM (SELECT number FROM numbers(12) LIMIT AFTER 1 UNTIL 1);
SELECT groupArray(number) FROM (SELECT number FROM numbers(12) LIMIT 2 AFTER 1 UNTIL 0);
SELECT groupArray(number) FROM (SELECT number FROM numbers(12) LIMIT AFTER 0 UNTIL 1);

-- Repeated ranges apply constant and nullable boundaries on every chunk.
SELECT groupArray(number) FROM (SELECT number FROM numbers(12) LIMIT AFTER 1 ALL UNTIL 1);
SELECT groupArray(number) FROM
    (SELECT number FROM numbers(12) ORDER BY number LIMIT 1 AFTER 1 ALL UNTIL number >= 3);
SELECT groupArray(number) FROM
    (SELECT number FROM numbers(12) ORDER BY number LIMIT 2 AFTER number IN (2, 6) ALL UNTIL 0);
SELECT groupArray(number) FROM
    (SELECT number FROM numbers(12) ORDER BY number
     LIMIT 2 AFTER nullIf(toNullable(number IN (2, 6)), 0) ALL UNTIL nullIf(toNullable(number = 3), 0));

-- Without a start condition, end evaluation begins with the first chunk.
SELECT groupArray(number) FROM
    (SELECT number FROM numbers(12) ORDER BY number LIMIT UNTIL throwIf(number >= 6) + (number = 2));
{% endfor %}

-- The end expression runs on the whole starting chunk, including rows before its start match.
SELECT count() FROM
    (SELECT number FROM numbers(12) ORDER BY number LIMIT AFTER number = 7 UNTIL throwIf(number = 6))
SETTINGS max_block_size = 3; -- { serverError FUNCTION_THROW_IF_VALUE_IS_NON_ZERO }

-- End expression errors in later active chunks propagate to the caller.
SELECT count() FROM
    (SELECT number FROM numbers(12) ORDER BY number LIMIT AFTER number = 6 UNTIL throwIf(number = 9))
SETTINGS max_block_size = 3; -- { serverError FUNCTION_THROW_IF_VALUE_IS_NON_ZERO }

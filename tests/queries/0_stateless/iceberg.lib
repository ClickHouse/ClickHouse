#!/usr/bin/env bash

# Helpers for Iceberg tests that read or hand-edit table metadata. Source after shell_config.sh.

# Prints the version N of a v<N>[-<uuid>].metadata.json path.
function iceberg_metadata_version()
{
    basename "$1" | sed -nE 's/^v([0-9]+)(-.*)?\.metadata\.json$/\1/p'
}

# Prints the path of the newest v<N>[-<uuid>].metadata.json in the metadata directory $1.
function iceberg_latest_metadata()
{
    local file latest="" latest_version=-1 version
    for file in "$1"/v*.metadata.json; do
        version=$(iceberg_metadata_version "${file}")
        [ -n "${version}" ] && [ "${version}" -gt "${latest_version}" ] && { latest=${file}; latest_version=${version}; }
    done
    [ -n "${latest}" ] || { echo "no metadata file in $1" >&2; return 1; }
    echo "${latest}"
}

# Writes stdin as the next metadata version in the metadata directory $1 and prints its path.
# Always a new version: a version the server has already read is served from the metadata files cache.
function iceberg_write_next_metadata()
{
    local latest next
    latest=$(iceberg_latest_metadata "$1") || return 1
    next="$1/v$(( $(iceberg_metadata_version "${latest}") + 1 )).metadata.json"
    cat > "${next}.tmp" && mv "${next}.tmp" "${next}" && echo "${next}"
}

# Applies the jq filter $2 (extra jq arguments after it) to the newest metadata in the metadata directory $1
# and commits the result as the next version; prints its path.
function iceberg_edit_metadata()
{
    local dir=$1 filter=$2 latest edited
    shift 2
    latest=$(iceberg_latest_metadata "${dir}") || return 1
    edited=$(jq "$@" "${filter}" "${latest}") || return 1
    iceberg_write_next_metadata "${dir}" <<< "${edited}"
}

# Prints the S3 object $1 (relative to the `s3_conn` named collection).
function s3_cat()
{
    ${CLICKHOUSE_CLIENT} --query "SELECT * FROM s3(s3_conn, filename = '$1', format = RawBLOB) FORMAT RawBLOB"
}

SELECT 1	SELECT -1	1	1	1
SELECT CASE WHEN a THEN 1 ELSE 2 END	SELECT CASE WHEN a THEN -1 ELSE -2 END	1	1	1
SELECT x FROM t WHERE 1 < a	SELECT x FROM t WHERE -1 < a	1	1	1
SELECT x FROM t LIMIT 10	SELECT x FROM t LIMIT -10	1	1	1
SELECT x - 1 FROM t	SELECT x + 1 FROM t	0	0	0
SELECT x - 1 FROM t	SELECT x 1 FROM t	0	0	0
SELECT ?
SELECT CASE WHEN a THEN ? ELSE ? END

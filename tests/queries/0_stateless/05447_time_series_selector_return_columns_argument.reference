-- the same samples are returned whatever the layout and the requested columns are
buckets as samples	[('1970-01-01 00:01:40.000',1),('1970-01-01 01:06:40.000',2)]
buckets as rows	1970-01-01 00:01:40.000	1
buckets as rows	1970-01-01 01:06:40.000	2

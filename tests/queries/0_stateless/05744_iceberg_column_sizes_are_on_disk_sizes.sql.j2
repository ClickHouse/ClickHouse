-- Tags: no-fasttest, need-query-parameters
-- Tag no-fasttest: Iceberg needs Avro.

-- `data_file.column_sizes` is the size the column occupies inside the data file, so every entry must
-- repeat what the Parquet footer of the file it names says. An in-memory size passes neither check:
-- `s` holds 1000000 bytes of one repeated character, which compresses to a fraction of the file, and
-- the sum over a file cannot exceed the file itself.
-- Blocks of 1000 rows that the insert pipeline does not squash make the writer roll over at exactly
-- 4000 rows, so the commit holds three data files. Both format versions, local and S3 storage.
-- The Iceberg field ids are 1 for `id` and 2 for `s`, in schema order.

SET allow_insert_into_iceberg = 1;
SET iceberg_insert_max_rows_in_data_file = 4000, max_block_size = 1000, max_insert_block_size = 1000,
    min_insert_block_size_rows = 0, min_insert_block_size_bytes = 0, max_insert_threads = 1;

{% macro engine(storage, table) -%}
{% if storage == 'local' -%}
IcebergLocal({CLICKHOUSE_DATABASE:String} || '/{{ table }}/')
{%- else -%}
IcebergS3(s3_conn, filename = {CLICKHOUSE_DATABASE:String} || '/{{ table }}/')
{%- endif %}
{%- endmacro %}

{% macro data_file_footers(storage, table) -%}
{% if storage == 'local' -%}
file({CLICKHOUSE_DATABASE:String} || '/{{ table }}/data/*.parquet', ParquetMetadata)
{%- else -%}
s3(s3_conn, filename = {CLICKHOUSE_DATABASE:String} || '/{{ table }}/data/*.parquet', format = ParquetMetadata)
{%- endif %}
{%- endmacro %}

{% for storage in ['local', 's3'] -%}
{% for fv in [1, 2] -%}
{% set t = 't_' ~ storage ~ '_v' ~ fv -%}
DROP TABLE IF EXISTS {{ t }};
CREATE TABLE {{ t }} (id Int32, s String) ENGINE = {{ engine(storage, t) }} ORDER BY id SETTINGS iceberg_format_version = {{ fv }};
INSERT INTO {{ t }} SELECT number, repeat('x', 100) FROM numbers(10000);
-- Data files; files whose sizes match the footer; files whose sizes sum to at most the file size.
SELECT '{{ t }}', count(), countIf(f.column_sizes = p.sizes), countIf(arraySum(mapValues(f.column_sizes)) <= f.file_size_in_bytes)
FROM (SELECT * FROM system.iceberg_files WHERE database = currentDatabase() AND table = '{{ t }}') AS f
JOIN (
    SELECT _file, mapFromArrays(arrayMap(c -> transform(c.name, ['id', 's'], [1, 2], 0), columns)::Array(Int32), arrayMap(c -> c.total_compressed_size, columns)::Array(Int64)) AS sizes
    FROM {{ data_file_footers(storage, t) }}
) AS p ON p._file = basename(f.file_path);
SELECT count(), uniqExact(s) FROM {{ t }};
DROP TABLE {{ t }};

{% endfor -%}
{% endfor -%}

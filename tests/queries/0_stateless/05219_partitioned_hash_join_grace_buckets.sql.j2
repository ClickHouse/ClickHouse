-- `GraceHashJoin` builds every bucket in an in-memory join. When `join_algorithm` lists
-- `partitioned_hash` and the shape allows it, that join is a `PartitionedHashJoin`: when `grace_hash`
-- is chosen outright, and when the spilling wrapper of `partitioned_hash` switches to grace under
-- `max_bytes_before_external_join`. Either way the result must be what `hash` returns. The bucket
-- limits are tight enough to make the first bucket rebucket (which hands its blocks back out of the
-- partitioned join) and every later bucket load from disk; the query log check at the end asserts
-- that buckets were written and that partitioned joins built them.

SET enable_analyzer = 1;
SET query_plan_join_swap_table = 0;
SET query_plan_optimize_join_order_randomize = 0;
SET allow_experimental_join_condition = 1;
SET max_bytes_before_external_join = 0;
SET max_bytes_ratio_before_external_join = 0;
SET max_bytes_in_join = 0;
SET max_rows_in_join = 0;
-- The ProfileEvents assertions below read this server's query_log; with parallel replicas the
-- join builds (and their events) can land on other replicas.
SET enable_parallel_replicas = 0;

SELECT '-- grace_hash chosen outright, buckets on the partitioned join';
{% for join_type, projection, condition in [
    ('INNER', 'a.k, a.v, b.x', 'a.k = b.k'),
    ('LEFT', 'a.k, a.v, b.x', 'a.k = b.k'),
    ('RIGHT', 'a.k, a.v, b.x', 'a.k = b.k'),
    ('FULL', 'a.k, a.v, b.x', 'a.k = b.k'),
    ('ANY LEFT', 'a.k, a.v, b.k', 'a.k = b.k'),
    ('SEMI LEFT', 'a.k, a.v', 'a.k = b.k'),
    ('ANTI LEFT', 'a.k, a.v', 'a.k = b.k'),
    ('SEMI RIGHT', 'b.k, b.x', 'a.k = b.k'),
    ('ANTI RIGHT', 'b.k, b.x', 'a.k = b.k'),
    ('LEFT', 'a.k, a.v, b.x', 'a.k = b.k AND a.v * 2 < b.x'),
    ('RIGHT', 'a.k, a.v, b.x', 'a.k = b.k AND a.v * 2 < b.x'),
    ('SEMI LEFT', 'a.k, a.v', 'a.k = b.k AND a.v * 2 < b.x')] -%}
{% for initial_buckets in [1, 4] -%}
SELECT '{{ join_type }} | {{ condition }} | initial buckets {{ initial_buckets }}', h.1, h = pa FROM (SELECT
    (SELECT (count(), sum(cityHash64({{ projection }}))) FROM (SELECT number % 5000 AS k, number AS v FROM numbers(20000)) AS a {{ join_type }} JOIN (SELECT number AS k, number * 7 AS x FROM numbers(6000)) AS b ON {{ condition }} SETTINGS join_algorithm = 'hash') AS h,
    (SELECT (count(), sum(cityHash64({{ projection }}))) FROM (SELECT number % 5000 AS k, number AS v FROM numbers(20000)) AS a {{ join_type }} JOIN (SELECT number AS k, number * 7 AS x FROM numbers(6000)) AS b ON {{ condition }} SETTINGS join_algorithm = 'grace_hash,partitioned_hash', max_bytes_in_join = 300000, grace_hash_join_initial_buckets = {{ initial_buckets }}) AS pa)
SETTINGS log_comment = '05219 grace buckets';
{% endfor -%}
{% endfor -%}

SELECT '-- the spilling wrapper of partitioned_hash switches to grace, whose buckets are partitioned joins';
SELECT 'INNER | spill switch', h.1, h = pa FROM (SELECT
    (SELECT (count(), sum(cityHash64(a.k, b.x))) FROM (SELECT number AS k FROM numbers(30000)) AS a INNER JOIN (SELECT number AS k, number * 7 AS x FROM numbers(30000)) AS b ON a.k = b.k SETTINGS join_algorithm = 'hash') AS h,
    (SELECT (count(), sum(cityHash64(a.k, b.x))) FROM (SELECT number AS k FROM numbers(30000)) AS a INNER JOIN (SELECT number AS k, number * 7 AS x FROM numbers(30000)) AS b ON a.k = b.k SETTINGS join_algorithm = 'partitioned_hash', max_bytes_before_external_join = 100000, grace_hash_join_initial_buckets = 1) AS pa)
SETTINGS log_comment = '05219 spill switch';
SELECT 'FULL | spill switch', h.1, h = pa FROM (SELECT
    (SELECT (count(), sum(cityHash64(a.k, b.x))) FROM (SELECT number * 2 AS k FROM numbers(30000)) AS a FULL JOIN (SELECT number * 3 AS k, number * 7 AS x FROM numbers(30000)) AS b ON a.k = b.k SETTINGS join_algorithm = 'hash') AS h,
    (SELECT (count(), sum(cityHash64(a.k, b.x))) FROM (SELECT number * 2 AS k FROM numbers(30000)) AS a FULL JOIN (SELECT number * 3 AS k, number * 7 AS x FROM numbers(30000)) AS b ON a.k = b.k SETTINGS join_algorithm = 'partitioned_hash', max_bytes_before_external_join = 100000, grace_hash_join_initial_buckets = 1) AS pa)
SETTINGS log_comment = '05219 spill switch';

SYSTEM FLUSH LOGS query_log;

SELECT '-- every grace query wrote buckets and built them with the partitioned join';
SELECT count() > 0, countIf(ProfileEvents['ExternalJoinWritePart'] = 0), countIf(ProfileEvents['HashJoinPartitions'] = 0)
FROM system.query_log
WHERE current_database = currentDatabase() AND type = 'QueryFinish' AND log_comment = '05219 grace buckets';

SELECT '-- every spill query switched to grace and built its buckets with the partitioned join';
SELECT count() > 0, countIf(ProfileEvents['JoinSpillingHashJoinSwitchedToGraceJoin'] = 0), countIf(ProfileEvents['HashJoinPartitions'] = 0)
FROM system.query_log
WHERE current_database = currentDatabase() AND type = 'QueryFinish' AND log_comment = '05219 spill switch';

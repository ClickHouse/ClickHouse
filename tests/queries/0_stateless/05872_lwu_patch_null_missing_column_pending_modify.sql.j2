-- A NULL written by a lightweight update into a column the data part does not store, before a pending
-- MODIFY COLUMN from a Nullable type to a non-Nullable one, reads as the new DEFAULT, as for a stored column.
-- One table per column: patch parts cannot be read with more than one pending MODIFY COLUMN.

SET enable_lightweight_update = 1;
SET enable_nullable_tuple_type = 1;

{% set columns = [
    ('s', 'Nullable(String)', "'old'", 'String', "'abc'", "'u'", 's'),
    ('d', 'Nullable(String)', "'old'", 'String', "concat('d', toString(id))", "'u'", 'd'),
    ('lc', 'LowCardinality(Nullable(String))', "'old'", 'LowCardinality(String)', "'abc'", "'u'", 'lc'),
    ('x', 'Nullable(Tuple(a Nullable(UInt64)))', 'tuple(1)', 'Tuple(a Nullable(UInt64))', 'tuple(7)', 'tuple(5)', 'x'),
    ('arr', 'Nullable(String)', "'[9]'", 'Array(UInt8)', '[7]', "'[5]'", 'arr'),
    ('v', 'Nullable(String)', "'old'", 'Variant(String, UInt64)', "'abc'", "'u'", 'v, isNull(v)'),
    ('y', 'Nullable(Tuple(a UInt64))', 'tuple(1)', 'Tuple(a UInt64)', 'tuple(7)', 'tuple(5)', 'y.a'),
] -%}

{% for version in ['v1', 'v2'] -%}
{% for col, old_type, old_default, new_type, new_default, value, expr in columns -%}

-- {{ col }} ({{ version }}): the MODIFY is pending while the table is read.
DROP TABLE IF EXISTS t_pending_{{ col }}_{{ version }} SYNC;
CREATE TABLE t_pending_{{ col }}_{{ version }} (id UInt64) ENGINE = MergeTree ORDER BY id
SETTINGS enable_block_number_column = 1, enable_block_offset_column = 1, patch_parts_version = '{{ version }}';
INSERT INTO t_pending_{{ col }}_{{ version }} VALUES (1), (2), (3);
SYSTEM STOP MERGES t_pending_{{ col }}_{{ version }};
ALTER TABLE t_pending_{{ col }}_{{ version }} ADD COLUMN {{ col }} {{ old_type }} DEFAULT {{ old_default }};
UPDATE t_pending_{{ col }}_{{ version }} SET {{ col }} = NULL WHERE id = 1;
UPDATE t_pending_{{ col }}_{{ version }} SET {{ col }} = {{ value }} WHERE id = 2;
ALTER TABLE t_pending_{{ col }}_{{ version }} MODIFY COLUMN {{ col }} {{ new_type }} DEFAULT {{ new_default }}
SETTINGS alter_sync = 0, mutations_sync = 0;
{% if col == 'v' -%}
-- A newer update writes a NULL that the new type holds.
UPDATE t_pending_{{ col }}_{{ version }} SET v = NULL WHERE id = 3;
{% endif -%}
SELECT 'pending {{ col }} {{ version }}',
    (SELECT count() FROM system.mutations WHERE database = currentDatabase() AND table = 't_pending_{{ col }}_{{ version }}' AND NOT is_done),
    (SELECT count() FROM system.parts_columns WHERE database = currentDatabase() AND table = 't_pending_{{ col }}_{{ version }}'
        AND active AND name NOT LIKE 'patch-%' AND column = '{{ col }}');
SELECT '{{ col }} {{ version }}', id, {{ expr }} FROM t_pending_{{ col }}_{{ version }} ORDER BY id;
{% if col == 's' -%}
SELECT '{{ col }} {{ version }} prewhere', id FROM t_pending_{{ col }}_{{ version }} WHERE s = 'abc' ORDER BY id
SETTINGS optimize_move_to_prewhere = 1, query_plan_optimize_prewhere = 1;
{% endif -%}
DROP TABLE t_pending_{{ col }}_{{ version }} SYNC;

-- {{ col }} ({{ version }}): the MODIFY mutation completes and stores the converted column.
DROP TABLE IF EXISTS t_done_{{ col }}_{{ version }} SYNC;
CREATE TABLE t_done_{{ col }}_{{ version }} (id UInt64) ENGINE = MergeTree ORDER BY id
SETTINGS enable_block_number_column = 1, enable_block_offset_column = 1, patch_parts_version = '{{ version }}';
INSERT INTO t_done_{{ col }}_{{ version }} VALUES (1), (2), (3);
ALTER TABLE t_done_{{ col }}_{{ version }} ADD COLUMN {{ col }} {{ old_type }} DEFAULT {{ old_default }};
UPDATE t_done_{{ col }}_{{ version }} SET {{ col }} = NULL WHERE id = 1;
UPDATE t_done_{{ col }}_{{ version }} SET {{ col }} = {{ value }} WHERE id = 2;
ALTER TABLE t_done_{{ col }}_{{ version }} MODIFY COLUMN {{ col }} {{ new_type }} DEFAULT {{ new_default }} SETTINGS mutations_sync = 2;
SELECT 'done {{ col }} {{ version }}', is_done, latest_fail_reason FROM system.mutations
WHERE database = currentDatabase() AND table = 't_done_{{ col }}_{{ version }}' AND command LIKE '%MODIFY COLUMN%';
SELECT 'done {{ col }} {{ version }} stored', count() FROM system.parts_columns
WHERE database = currentDatabase() AND table = 't_done_{{ col }}_{{ version }}' AND active AND name NOT LIKE 'patch-%' AND column = '{{ col }}';
SELECT 'done {{ col }} {{ version }}', id, {{ 'x, x.a' if col == 'x' else expr }} FROM t_done_{{ col }}_{{ version }} ORDER BY id;
{% if col == 'x' -%}
SELECT 'done {{ col }} {{ version }} where', id FROM t_done_{{ col }}_{{ version }} WHERE x.a = 7 ORDER BY id;
{% endif -%}
DROP TABLE t_done_{{ col }}_{{ version }} SYNC;

{% endfor -%}

-- killed ({{ version }}): two patches older than the pending MODIFY, with different old types (the MODIFY between them was killed).
DROP TABLE IF EXISTS t_killed_{{ version }} SYNC;
CREATE TABLE t_killed_{{ version }} (id UInt64) ENGINE = MergeTree ORDER BY id
SETTINGS enable_block_number_column = 1, enable_block_offset_column = 1, patch_parts_version = '{{ version }}';
INSERT INTO t_killed_{{ version }} VALUES (1), (2), (3);
SYSTEM STOP MERGES t_killed_{{ version }};
ALTER TABLE t_killed_{{ version }} ADD COLUMN arr Nullable(String) DEFAULT '[9]';
UPDATE t_killed_{{ version }} SET arr = NULL WHERE id = 1;
ALTER TABLE t_killed_{{ version }} MODIFY COLUMN arr LowCardinality(Nullable(String)) DEFAULT '[9]' SETTINGS alter_sync = 0, mutations_sync = 0;
KILL MUTATION WHERE database = currentDatabase() AND table = 't_killed_{{ version }}' SYNC FORMAT Null;
UPDATE t_killed_{{ version }} SET arr = '[5]' WHERE id = 2;
ALTER TABLE t_killed_{{ version }} MODIFY COLUMN arr Array(UInt8) DEFAULT [7] SETTINGS alter_sync = 0, mutations_sync = 0;
SELECT 'killed {{ version }} patch type', type FROM system.parts_columns
WHERE database = currentDatabase() AND table = 't_killed_{{ version }}' AND active AND name LIKE 'patch-%' AND column = 'arr'
ORDER BY type;
SELECT 'killed {{ version }}', id, arr FROM t_killed_{{ version }} ORDER BY id;
DROP TABLE t_killed_{{ version }} SYNC;

{% endfor -%}

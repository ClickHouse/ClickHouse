-- `join_algorithm = 'auto'` runs `JoinSwitcher`: an in-memory join that drains onto `MergeJoin` once the
-- right side exceeds `max_rows_in_join` or `max_bytes_in_join`. When the list names `hash` as
-- well, the in-memory join is a `HashJoin`, and a shape `MergeJoin` declines runs the
-- partitioned join alone. A join that stays in memory and one that switches must both return what
-- `hash` returns. The log checks at the end assert that the partitioned join built every in-memory case
-- and that every switch started from it.

SET enable_analyzer = 1;
SET query_plan_join_swap_table = 0;
SET query_plan_optimize_join_order_randomize = 0;
SET max_bytes_before_external_join = 0;
SET max_bytes_ratio_before_external_join = 0;
SET max_bytes_in_join = 0;
SET max_rows_in_join = 0;
-- The ProfileEvents assertions below read this server's query_log; with parallel replicas the
-- join builds (and their events) can land on other replicas.
SET enable_parallel_replicas = 0;
-- Parallel fill can race with the switch; keep that path covered.
SET parallel_hash_join_threshold = 1;
SET max_threads = 8;
-- The runtime-filter pass keeps only the algorithms that can apply a filter, and `auto` is not one of them:
-- with filters on, `auto,hash` on an INNER join runs the partitioned join alone.
SET enable_join_runtime_filters = 0;

-- `ANY INNER` picks one of four left payloads per key; check membership without pinning a winner.
SELECT '-- auto stays in memory';
{% for join_type, projection in [
    ('INNER', 'a.k, a.v, b.x'),
    ('LEFT', 'a.k, a.v, b.x'),
    ('RIGHT', 'a.k, a.v, b.x'),
    ('FULL', 'a.k, a.v, b.x'),
    ('ANY LEFT', 'a.k, a.v, b.k'),
    ('ANY INNER', 'a.k, a.v, b.k'),
    ('SEMI LEFT', 'a.k, a.v'),
    ('ANTI LEFT', 'a.k, a.v'),
    ('SEMI RIGHT', 'b.k, b.x'),
    ('ANTI RIGHT', 'b.k, b.x')] -%}
SELECT '{{ join_type }} | auto,hash', pa FROM (SELECT
    (SELECT (count(), {% if join_type == 'ANY INNER' %}sum(cityHash64(a.k, b.k)), countIf(a.v < 20000 AND a.v % 5000 = a.k AND a.k = b.k) = count(){% else %}sum(cityHash64({{ projection }})){% endif %}) FROM (SELECT number % 5000 AS k, number AS v FROM numbers(20000)) AS a {{ join_type }} JOIN (SELECT number AS k, number * 7 AS x FROM numbers(6000)) AS b ON a.k = b.k SETTINGS join_algorithm = 'auto,hash') AS pa)
SETTINGS log_comment = '05220 auto in memory';
{% endfor -%}

-- After the switch, `MergeJoin` emits one row per matching left row for `ANY INNER`,
-- so the full probe payload fingerprint is deterministic.
SELECT '-- auto switches to MergeJoin at max_rows_in_join';
{% for join_type, projection in [
    ('INNER', 'a.k, a.v, b.x'),
    ('LEFT', 'a.k, a.v, b.x'),
    ('RIGHT', 'a.k, a.v, b.x'),
    ('FULL', 'a.k, a.v, b.x'),
    ('ANY LEFT', 'a.k, a.v, b.k'),
    ('ANY INNER', 'a.k, a.v, b.k'),
    ('SEMI LEFT', 'a.k, a.v')] -%}
SELECT '{{ join_type }} | auto,hash | max_rows_in_join', pa FROM (SELECT
    (SELECT (count(), sum(cityHash64({{ projection }}))) FROM (SELECT number % 5000 AS k, number AS v FROM numbers(20000)) AS a {{ join_type }} JOIN (SELECT number AS k, number * 7 AS x FROM numbers(6000)) AS b ON a.k = b.k SETTINGS join_algorithm = 'auto,hash', max_rows_in_join = 100) AS pa)
SETTINGS log_comment = '05220 auto switch';
{% endfor -%}

SYSTEM FLUSH LOGS query_log, text_log;

SELECT '-- every in-memory query built its table with the partitioned join';
SELECT count() > 0, countIf(ProfileEvents['HashJoinPartitions'] = 0)
FROM system.query_log
WHERE current_database = currentDatabase() AND type = 'QueryFinish' AND log_comment = '05220 auto in memory';

SELECT '-- every switching query started from the partitioned join';
SELECT count() > 0, count() = (
    SELECT uniqExact(query_id) FROM system.text_log
    WHERE logger_name = 'JoinSwitcher' AND message LIKE 'Memory limit reached with HashJoin%'
        AND query_id IN (SELECT query_id FROM system.query_log WHERE current_database = currentDatabase() AND type = 'QueryFinish' AND log_comment = '05220 auto switch'))
FROM system.query_log
WHERE current_database = currentDatabase() AND type = 'QueryFinish' AND log_comment = '05220 auto switch';

#!/usr/bin/env bash

# A mock of the Unity catalog REST API for tests of `DataLakeCatalog` with `catalog_type = 'unity'`.

UNITY_CATALOG_MOCK_DATABASES=()

# Starts the mock and stops it when the test exits.
# $1 is Python code that defines `routes`, a dict from path to JSON answer.
function start_unity_catalog_mock()
{
    UNITY_CATALOG_MOCK_PORT=$(python3 -c "
import socket
s = socket.socket()
s.bind(('127.0.0.1', 0))
print(s.getsockname()[1])
s.close()
")

    python3 -c "
import json
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
from urllib.parse import urlparse, parse_qs

# Column c of type Nullable(Int32), for use in routes.
integer_column = {'name': 'c', 'nullable': True,
                  'type_json': json.dumps({'name': 'c', 'type': 'integer', 'nullable': True, 'metadata': {}})}

$1

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        url = urlparse(self.path)
        params = parse_qs(url.query)

        # Keys of routes are paths under this prefix.
        path = url.path.removeprefix('/api/2.1/unity-catalog')

        # Second request for same table has these parameters. Its key is (path, 'as_managed').
        if (params.get('read_streaming_table_as_managed') == ['true']
                and params.get('read_materialized_view_as_managed') == ['true']):
            path = (path, 'as_managed')

        answer = {} if path == '/ready' else routes.get(path, (404, {}))

        # Answer is a dict for HTTP 200, or a tuple (HTTP code, dict).
        code, body = answer if isinstance(answer, tuple) else (200, answer)
        body = json.dumps(body).encode()

        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass

ThreadingHTTPServer(('127.0.0.1', $UNITY_CATALOG_MOCK_PORT), Handler).serve_forever()
" &
    UNITY_CATALOG_MOCK_PID=$!
    trap stop_unity_catalog_mock EXIT

    for _ in {1..100}; do
        if [ "$(${CLICKHOUSE_CURL} -s -o /dev/null -w "%{http_code}" "http://127.0.0.1:${UNITY_CATALOG_MOCK_PORT}/ready")" = "200" ]; then
            break
        fi
        sleep 0.1
    done
}

# Creates database $1 on the mock, with warehouse `wh`. An optional $2 is the value of `use_unity_catalog_v2`.
# The database is dropped when the test exits.
function create_unity_database()
{
    local settings="catalog_type = 'unity', warehouse = 'wh'"
    if [ -n "${2:-}" ]; then
        settings+=", use_unity_catalog_v2 = $2"
    fi

    UNITY_CATALOG_MOCK_DATABASES+=("$1")
    ${CLICKHOUSE_CLIENT} --allow_database_unity_catalog=1 --query "
        CREATE DATABASE $1 ENGINE = DataLakeCatalog('http://127.0.0.1:${UNITY_CATALOG_MOCK_PORT}/api/2.1/unity-catalog')
        SETTINGS ${settings}"
}

function stop_unity_catalog_mock()
{
    kill "$UNITY_CATALOG_MOCK_PID" 2>/dev/null
    for database in "${UNITY_CATALOG_MOCK_DATABASES[@]}"; do
        ${CLICKHOUSE_CLIENT} --query "DROP DATABASE IF EXISTS ${database}" 2>/dev/null
    done
}

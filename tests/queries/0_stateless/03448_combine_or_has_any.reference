-- server constants in the needles of a distributed query are calculated on each remote server
SELECT count() AS `count()`\nFROM remote(\'127.0.0.{1,2}\', system.one) AS __table1\nWHERE or(hasAny(array(toString(__table1.dummy)), array(hostName())), hasAny(array(toString(__table1.dummy)), array(concat(hostName(), \'x\'))))
2

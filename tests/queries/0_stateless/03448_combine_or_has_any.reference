1
-- a chain of deterministic needles and a server constant merges only the deterministic ones
SELECT count() AS `count()`\nFROM remote(\'127.0.0.{1,2}\', system.one) AS __table1\nWHERE or(hasAny(array(toUInt64(plus(__table1.dummy, 1))), _CAST([2, 3], \'Array(UInt64)\')), hasAny(array(toUInt64(plus(__table1.dummy, 1))), array(toUInt64(shardNum()))))
1	1
-- a server constant in the haystack is calculated on each remote server too
1	1
-- a server constant in the needles of a view subquery is calculated on each remote server
2
-- a Distributed table query calculates the server constants on each shard too

-- the setting is taken from the scope of each subquery
SELECT __table1.id AS id\nFROM\n(\n    SELECT\n        __table2.id AS id,\n        __table2.letters AS letters\n    FROM default.t3448 AS __table2\n    WHERE hasAny(__table2.letters, _CAST([\'a\', \'i\'], \'Array(String)\'))\n    SETTINGS optimize_or_has_any_chain = 1\n) AS __table1\nWHERE or(hasAny(__table1.letters, _CAST([\'u\'], \'Array(String)\')), hasAny(__table1.letters, _CAST([\'z\'], \'Array(String)\')))\nSETTINGS optimize_or_has_any_chain = 0
SELECT __table1.id AS id\nFROM\n(\n    SELECT\n        __table2.id AS id,\n        __table2.letters AS letters\n    FROM default.t3448 AS __table2\n    WHERE or(hasAny(__table2.letters, _CAST([\'a\'], \'Array(String)\')), hasAny(__table2.letters, _CAST([\'i\'], \'Array(String)\')))\n    SETTINGS optimize_or_has_any_chain = 0\n) AS __table1\nWHERE hasAny(__table1.letters, _CAST([\'u\', \'z\'], \'Array(String)\'))\nSETTINGS optimize_or_has_any_chain = 1
SELECT __table1.id AS id\nFROM default.t3448 AS __table1\nWHERE in(__table1.id, (\n    SELECT __table1.id AS id\n    FROM default.t3448 AS __table1\n    WHERE hasAny(__table1.letters, _CAST([\'a\', \'i\'], \'Array(String)\'))\n    SETTINGS optimize_or_has_any_chain = 1\n))\nSETTINGS optimize_or_has_any_chain = 0
SELECT __table1.id AS id\nFROM\n(\n    SELECT __table2.id AS id\n    FROM default.t3448 AS __table2\n    WHERE hasAny(__table2.letters, _CAST([\'a\', \'i\'], \'Array(String)\'))\n    SETTINGS optimize_or_has_any_chain = 1\n) AS __table1\nSETTINGS compatibility = \'26.9\'

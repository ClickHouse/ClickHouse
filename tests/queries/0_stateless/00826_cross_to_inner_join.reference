--- cross ---
SELECT *\nFROM t1_00826\nCROSS JOIN t2_00826\nWHERE equals(t1_00826.a, t2_00826.a)\nORDER BY ALL ASC
--- cross nullable ---
SELECT *\nFROM t1_00826, t2_00826\nWHERE equals(t1_00826.a, t2_00826.a)\nORDER BY ALL ASC
--- cross nullable vs not nullable ---
SELECT *\nFROM t1_00826\nCROSS JOIN t2_00826\nWHERE equals(t1_00826.a, t2_00826.b)\nORDER BY ALL ASC
--- cross self ---
SELECT *\nFROM t1_00826 AS x\nCROSS JOIN t1_00826 AS y\nWHERE and(equals(x.a, y.a), equals(x.b, y.b))\nORDER BY ALL ASC
--- cross one table expr ---
SELECT *\nFROM t1_00826\nCROSS JOIN t2_00826\nWHERE equals(t1_00826.a, t1_00826.b)\nORDER BY ALL ASC
--- cross multiple ands ---
SELECT *\nFROM t1_00826\nCROSS JOIN t2_00826\nWHERE and(equals(t1_00826.a, t2_00826.a), equals(t1_00826.b, t2_00826.b))\nORDER BY ALL ASC
--- cross and inside and ---
SELECT *\nFROM t1_00826\nCROSS JOIN t2_00826\nWHERE and(equals(t1_00826.a, t2_00826.a), and(equals(t1_00826.a, t2_00826.a), and(equals(t1_00826.a, t2_00826.a), equals(t1_00826.b, t2_00826.b))))\nORDER BY ALL ASC
--- cross split conjunction ---
SELECT *\nFROM t1_00826\nCROSS JOIN t2_00826\nWHERE and(equals(t1_00826.a, t2_00826.a), equals(t1_00826.b, t2_00826.b), greaterOrEquals(t1_00826.a, 1), greater(t2_00826.b, 0))\nORDER BY ALL ASC
--- and or ---
SELECT *\nFROM t1_00826\nCROSS JOIN t2_00826\nWHERE and(equals(t1_00826.a, t2_00826.a), equals(t1_00826.b, t2_00826.b), or(greaterOrEquals(t1_00826.a, 1), equals(t2_00826.b, 1)))\nORDER BY ALL ASC
--- arithmetic expr ---
SELECT *\nFROM t1_00826\nCROSS JOIN t2_00826\nWHERE and(equals(plus(t1_00826.a, 1), plus(t2_00826.a, t2_00826.b)), greater(plus(plus(plus(t1_00826.a, t1_00826.b), t2_00826.a), t2_00826.b), 5))\nORDER BY ALL ASC
--- is null or ---
SELECT *\nFROM t1_00826\nCROSS JOIN t2_00826\nWHERE and(equals(t1_00826.b, t2_00826.a), or(isNull(t2_00826.b), greater(t2_00826.b, t2_00826.a)))\nORDER BY ALL ASC
--- do not rewrite alias ---
SELECT a AS b\nFROM t1_00826\nCROSS JOIN t2_00826\nWHERE and(equals(t1_00826.b, t2_00826.a), greater(b, 0))\nORDER BY ALL ASC
--- comma ---
SELECT *\nFROM t1_00826, t2_00826\nWHERE equals(t1_00826.a, t2_00826.a)\nORDER BY ALL ASC
--- comma nullable ---
SELECT *\nFROM t1_00826, t2_00826\nWHERE equals(t1_00826.b, t2_00826.b)\nORDER BY ALL ASC
--- comma and or ---
SELECT *\nFROM t1_00826, t2_00826\nWHERE and(equals(t1_00826.a, t2_00826.a), or(isNull(t2_00826.b), less(t2_00826.b, 2)))\nORDER BY ALL ASC

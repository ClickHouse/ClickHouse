-- every setting, changed or not
compress	0	0	default
max_bytes_to_keep	8192	1	definition
max_rows_to_keep	0	0	default
min_bytes_to_keep	4096	1	definition
min_rows_to_keep	0	0	default
-- only what something other than the default set
max_bytes_to_keep	8192	1	definition
min_bytes_to_keep	4096	1	definition
-- CHANGED is about who set it, not whether the value differs
max_rows_to_keep	0	1	definition
-- one setting, by name
min_bytes_to_keep	4096	1	definition
-- ILIKE is case-insensitive
min_bytes_to_keep	4096	1	definition
-- NOT inverts it
max_bytes_to_keep	8192	1	definition
-- IN is accepted in place of FROM
min_bytes_to_keep	4096	1	definition
-- a setting is findable by a name it answers to, not only the one it is declared under
enable_block_number_column	1	1	definition
enable_block_number_column	1	1	definition
enable_block_number_column	1	1	definition
-- a database-qualified name parses and resolves
-- the statements sharing its prefix still parse as themselves
mt
add_http_cors_header	Bool	0
-- the AST survives a JSON round trip, as it does for SHOW COLUMNS
SHOW TABLE SETTINGS FROM tbl
SHOW CHANGED TABLE SETTINGS FROM db.tbl LIKE \'a%\'
SHOW TABLE SETTINGS FROM tbl NOT ILIKE \'x%\'
-- and a payload the parser could never have produced is rejected

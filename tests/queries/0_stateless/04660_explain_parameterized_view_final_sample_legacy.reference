-- without FINAL / SAMPLE the view body is still expanded
SELECT
    k,
    v
FROM
(
    SELECT
        k,
        v
    FROM default.t_04660
    WHERE equals(k, _CAST(1, \'UInt64\'))
) AS pv_04660

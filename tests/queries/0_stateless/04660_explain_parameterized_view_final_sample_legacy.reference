-- legacy EXPLAIN SYNTAX keeps the parameterized view call intact
SELECT\n    k,\n    v\nFROM pv_04660(equals(p, 1))\nFINAL
SELECT\n    k,\n    v\nFROM pv_04660(equals(p, 1))\nSAMPLE 1 / 2

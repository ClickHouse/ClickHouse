CREATE TABLE t (`x` UInt64 STATISTICS(tdigest)) ENGINE = MergeTree ORDER BY x
CREATE TABLE t (`x` UInt64 STATISTICS(uniq(2))) ENGINE = MergeTree ORDER BY x
CREATE TABLE t (`x` UInt64 CODEC(Delta(8), LZ4)) ENGINE = MergeTree ORDER BY x
CREATE TABLE t (`x` UInt64, INDEX i x TYPE minmax GRANULARITY 1) ENGINE = MergeTree ORDER BY x

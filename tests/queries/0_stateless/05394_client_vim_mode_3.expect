#!/usr/bin/expect -f

# Editing with the `--vim` keymap of the client. Every query is edited so that its result differs
# from any text displayed while typing it, so that matching the result checks the edit.
# Escape is followed by a pause much longer than the escape delay of the vim mode (10 ms), so that it
# is not read as Meta. The pause is short, and the cases are split between `05394_client_vim_mode_{1,2,3,4,5}.expect`,
# so that each test fits into the time limit of the fast test (60 seconds), also on macOS.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0
set history_file $CLICKHOUSE_TMP/$basename.history

log_user 0
set timeout 60
match_max 100000

expect_after {
    # Do not ignore eof from expect
    -i $any_spawn_id eof { exp_continue }
    # A default timeout action is to do nothing, change it to fail
    -i $any_spawn_id timeout { exit 1 }
}

proc escape {} {
    send -- "\033"
    sleep 0.1
}

# Ctrl-J submits the query: Enter inserts a new line in the vim mode.
proc submit {} {
    send -- "\n"
}

spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --history_file=$history_file --vim"
expect ":) "

# After `$`, `j` and `k` go to the end of a line of a different length.
send -- "SELECT 100\r+ 23456789123"
escape
send -- "gg\$jxi+1 -- "
escape
submit
expect "234567992"
expect ":) "

send -- "SELECT 1 + 50000\r+ 2"
escape
send -- "\$kxi7"
escape
submit
expect "50073"
expect ":) "

# `ciw` and `ciW` on an empty line keep the line break and enter insert mode.
send -- "SELECT 1000\r\r+ 123"
escape
send -- "ggjciw-- comment"
escape
submit
expect "1123"
expect ":) "

send -- "SELECT 2000\r\r+ 123"
escape
send -- "ggjciW-- comment"
escape
submit
expect "2123"
expect ":) "

send -- "SELECT 3000 + 1\r"
escape
send -- "ciw+ 4"
escape
submit
expect "3005"
expect ":) "

# A counted operator on the Backspace motion continues across the line break.
send -- "SELECT 1000\r+ 2345"
escape
send -- "0d4\x7f"
send -- "i9"
escape
submit
expect "2364"
expect ":) "

# A counted `iw` or `iW` on an empty line also takes the following chunks.
send -- "SELECT 1000\r\r+ 23"
escape
send -- "ggj2ciw+ 1 --"
escape
submit
expect "1001"
expect ":) "

send -- "SELECT 2000\r\r+1 + 23"
escape
send -- "ggjd2iW"
submit
expect "2023"
expect ":) "

# `%` that scans from outside quotes onto a quoted bracket ignores quoted brackets.
send -- "SELECT 1000, '(' || 'a' || ')'"
escape
send -- "0f1%r9"
submit
expect "9000"
expect ":) "

# `cl` on an empty line selects nothing, but still enters insert mode.
send -- "SELECT 5000\r\r+ 23"
escape
send -- "ggjcl+ 9"
escape
submit
expect "5032"
expect ":) "

# `j` and `k` keep the display column: a wide character takes two columns.
send -- "SELECT concat('x',\r '你好abcd')"
escape
send -- "gg7ljx"
submit
expect "x你好acd"
expect ":) "

send -- "SELECT concat('ab你好cd',\r'0123456789abcdefghijk')"
escape
send -- "4hkx"
submit
expect "ab你cd0123456789abcdefghijk"
expect ":) "

# A tab takes several columns, so `j` from the third column lands on it.
# The tab is pasted: typing it would trigger completion.
send -- "SELECT 1000 +\r\033\[200~\t23\033\[201~"
escape
send -- "gg2ljx"
submit
expect "1023"
expect ":) "

# A counted `iw` skips the line break at the end of a non-empty line: the next chunk is the word on the next line.
send -- "SELECT 6100 + 7\r- 2345"
escape
send -- "gg\$d2iw"
submit
expect "8445"
expect ":) "

# An exclusive `w` or `W` motion that ends in the first column of a line keeps the line break before it.
send -- "SELECT 6200 -- note\r\r+ 34"
escape
send -- "gg\$d2w"
submit
expect "6234"
expect ":) "

send -- "SELECT 6300 -- note\r\r+ 34"
escape
send -- "gg\$d2W"
submit
expect "6334"
expect ":) "

# A linewise delete leaves the cursor on the first non-blank of the remaining line.
send -- "SELECT 6500\r  +234\rgarbage"
escape
send -- "ddwr-"
submit
expect "6466"
expect ":) "

send -- "SELECT 6600\r  +234\rgarbage"
escape
send -- "dGwr-"
submit
expect "6566"
expect ":) "

# `ce` and `cE` on an empty last line, and in an empty buffer, enter insert mode.
send -- "SELECT 6700\r"
escape
send -- "ce+ 9"
escape
submit
expect "6709"
expect ":) "

send -- "SELECT 6710\r"
escape
send -- "cE+ 9"
escape
submit
expect "6719"
expect ":) "

escape
send -- "ceSELECT 6720+1"
escape
submit
expect "6721"
expect ":) "

# A counted word object with too few chunks cancels the operation.
send -- "SELECT 6800 + 123"
escape
send -- "d2iw"
submit
expect "6923"
expect ":) "

send -- "SELECT 6810 + 123"
escape
send -- "d2aw"
submit
expect "6933"
expect ":) "

# A counted `iw` that ends on an empty line joins it with the previous line and keeps its line break.
send -- "SELECT 6900 -- note\r\r+ 234"
escape
send -- "gg\$d2iw"
submit
expect "7134"
expect ":) "

send -- "SELECT 6910 -- note\r\r+ 234"
escape
send -- "gg\$d2iW"
submit
expect "7144"
expect ":) "

# `v` after the operator makes a linewise motion characterwise exclusive.
send -- "SELECT 7000\r+ 123\r+ 234\r+ 345"
escape
send -- "ggj2ldvj"
submit
expect "7579"
expect ":) "

send -- "SELECT 7100\r+ 123\r+ 234\r345"
escape
send -- "ggj2ldvG"
submit
expect "7445"
expect ":) "

# A forced characterwise motion that ends in the first column ends at the end of the previous line.
send -- "SELECT 7200 -- note\r+ 234"
escape
send -- "gg\$dvG"
submit
expect "7434"
expect ":) "

# `v` also forces the doubled operators: up to the first non-blank of the line.
send -- "SELECT 7300 +\r1 + 234"
escape
send -- "G4ldvd"
submit
expect "7534"
expect ":) "

send -- "SELECT 7400 +\r1 + 234"
escape
send -- "G4lcvc9"
escape
submit
expect "16634"
expect ":) "

send -- "\4"
expect eof

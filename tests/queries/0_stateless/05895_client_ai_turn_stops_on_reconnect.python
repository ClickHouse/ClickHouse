# A turn of the AI agent of the client is bound to the session it started on. The conversation of
# the turn holds what the agent learned on that session, and the checks of the unconfirmed
# read-only tool were done on it, while a reconnect makes a new session, possibly on another server
# (several configured hosts, a load balancer). So when the client connects again in the middle of a
# turn, the turn stops: the queries of the agent are not sent on the new connection, and the model
# is not called again.
#
# The reconnect is made here by the server closing the connection as idle: the session sets
# `idle_connection_timeout` to one second, and the mock provider takes several seconds to answer
# once the agent has run its first query. The model asks for one read-only query after another and
# never stops by itself, so without the binding the queries it asks for after the reconnect would
# run on the new connection, and the turn would go on until the model runs out of tool calls.
import json
import os
import pty
import select
import shlex
import signal
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, HTTPServer

TIMEOUT_SECONDS = 180

# How long a client may take to end after its terminal was closed, before it is killed.
TEARDOWN_SECONDS = 30

# `clickhouse-test` prints this file when the test fails, and it names it after the test case -
# the `.sh` wrapper - not after this script. Writing anywhere else means the trace of a failure in
# CI is collected and then never shown, which is the only record of what the client did.
DEBUG_LOG = os.path.join(
    os.environ["CLICKHOUSE_TMP"],
    os.path.basename(os.path.abspath(__file__)).removesuffix(".python") + ".sh.debuglog",
)

# Set when the pseudo-terminal reaches end of file: the client is gone. Every later read then
# returns at once and every write is silently discarded, so without noticing it the test runs to
# the end and reports every expectation as unmet, saying nothing about the client having died.
client_gone = False

FINAL_ANSWER = "MOCK-DONE"

# The notice of the agent about the turn it stopped.
STOP_NOTICE = "so the turn was stopped"

# The server closes the connection after it was idle for this long.
IDLE_CONNECTION_TIMEOUT_SECONDS = 1

# The model takes this long to answer once it has seen the result of a query, for the server to
# close the connection in the meantime. The server polls the connection once in a timeout, so it
# closes it in two timeouts at the latest; the rest is the margin for a slow build under load.
MODEL_THINKS_SECONDS = 5

# The model asks for this many queries before it gives its final answer. The connection is closed
# while it thinks about the first result at the latest, so the turn stops long before that.
MAX_TOOL_CALLS = 6


def tool_succeeded(result):
    return '"success":true' in result.replace(" ", "")


class Handler(BaseHTTPRequestHandler):
    """A mock OpenAI-compatible provider. It asks for one `run_readonly_query` call after another,
    whatever the results are, and thinks for a while before each one but the first."""

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        request = json.loads(self.rfile.read(length))

        results = [str(m.get("content")) for m in request["messages"] if m.get("role") == "tool"]
        self.server.results = results
        self.server.requests += 1

        if len(results) >= MAX_TOOL_CALLS:
            message = {"role": "assistant", "content": FINAL_ANSWER}
            finish_reason = "stop"
        else:
            if results:
                time.sleep(MODEL_THINKS_SECONDS)
            message = {
                "role": "assistant",
                "content": None,
                "tool_calls": [
                    {
                        "id": f"call_{len(results) + 1}",
                        "type": "function",
                        "function": {
                            "name": "run_readonly_query",
                            "arguments": json.dumps(
                                {"query": f"SELECT number + {len(results) + 1} FROM numbers(1)"}
                            ),
                        },
                    }
                ],
            }
            finish_reason = "tool_calls"

        body = json.dumps(
            {
                "id": "chatcmpl-1",
                "object": "chat.completion",
                "created": 1,
                "model": "gpt-4o",
                "choices": [{"index": 0, "message": message, "finish_reason": finish_reason}],
                "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2},
            }
        ).encode()

        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


def make_config(port):
    """A client configuration that points the AI agent at the mock provider. The credentials come
    from the configuration and not from the environment, so the agent does not ask for the
    confirmation of using an API key found there."""
    path = os.path.join(
        os.environ["CLICKHOUSE_TMP"],
        os.path.basename(os.path.abspath(__file__)).removesuffix(".python") + ".config.xml",
    )
    with open(path, "w") as f:
        f.write(
            "<clickhouse><ai>"
            "<provider>openai</provider>"
            "<api_key>mock-key</api_key>"
            f"<base_url>http://127.0.0.1:{port}/v1</base_url>"
            "<model>gpt-4o</model>"
            "</ai></clickhouse>"
        )
    return path


def client_argv(config):
    """The interactive client of the test environment. The configuration file of the environment is
    replaced by the one of the mock provider rather than added to it: the client accepts one."""
    argv = shlex.split(os.environ["CLICKHOUSE_CLIENT_BINARY"])
    for option in shlex.split(os.environ["CLICKHOUSE_CLIENT_EXPECT_OPT"]):
        if option.startswith("--config-file"):
            continue
        argv.append(option)
    return argv + [f"--config-file={config}", "--history_file=/dev/null"]


def read_until(master, debug_log_fd, predicate, timeout):
    global client_gone
    output = ""
    deadline = time.time() + timeout
    while time.time() < deadline:
        r, _, _ = select.select([master], [], [], 0.3)
        if not r:
            continue
        try:
            chunk = os.read(master, 65536)
        except OSError:
            client_gone = True
            break
        if not chunk:
            client_gone = True
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()
        output += chunk.decode(errors="replace")
        if predicate(output):
            return output
    return output


def report_client_if_gone(child_pid):
    """Print how the client ended if it is gone. The expected output has no such line, so it
    shows up in the diff of the failure instead of leaving only unmet expectations behind."""
    if not client_gone:
        return
    try:
        _, status = os.waitpid(child_pid, os.WNOHANG)
    except ChildProcessError:
        print("client_gone: already reaped")
        return
    if os.WIFSIGNALED(status):
        print(f"client_gone: killed by signal {os.WTERMSIG(status)}")
    elif os.WIFEXITED(status):
        print(f"client_gone: exited with code {os.WEXITSTATUS(status)}")
    else:
        print("client_gone: yes")


def wait_for_client(child_pid):
    """Wait for the client to end after its terminal was closed, and make sure it is gone."""
    deadline = time.time() + TEARDOWN_SECONDS
    while time.time() < deadline:
        try:
            reaped, _ = os.waitpid(child_pid, os.WNOHANG)
        except ChildProcessError:
            return
        if reaped == child_pid:
            return
        time.sleep(0.05)
    try:
        os.kill(child_pid, signal.SIGKILL)
        os.waitpid(child_pid, 0)
    except (ChildProcessError, ProcessLookupError):
        pass


def main():
    server = HTTPServer(("127.0.0.1", 0), Handler)
    server.results = []
    server.requests = 0
    threading.Thread(target=server.serve_forever, daemon=True).start()

    argv = client_argv(make_config(server.server_port))

    child_pid, master = pty.fork()
    if child_pid == 0:
        os.environ["TERM"] = "xterm"
        # An API key in the environment would take precedence over the configured mock provider.
        os.environ.pop("OPENAI_API_KEY", None)
        os.environ.pop("ANTHROPIC_API_KEY", None)
        os.execv(argv[0], argv)
        return

    debug_log_fd = open(DEBUG_LOG, "a")
    try:
        read_until(master, debug_log_fd, lambda o: ":)" in o, TIMEOUT_SECONDS)

        # Applied with a `SET` in the session rather than on the command line, where the test
        # environment may already pass some of the settings. The client sends the settings of the
        # session with every query of the user and of the agent, so a connection it makes later is
        # closed as idle as well.
        os.write(
            master,
            f"SET idle_connection_timeout = {IDLE_CONNECTION_TIMEOUT_SECONDS}\n".encode(),
        )
        # Both the answer and the prompt that follows it: the question must not be typed before
        # the client is reading a line again, or it would be submitted as a part of the statement.
        read_until(
            master,
            debug_log_fd,
            lambda o: "Ok." in o and ":)" in o.split("Ok.", 1)[1],
            TIMEOUT_SECONDS,
        )

        os.write(master, b"? read the numbers\n")
        output = read_until(
            master,
            debug_log_fd,
            lambda o: FINAL_ANSWER in o or STOP_NOTICE in o,
            TIMEOUT_SECONDS,
        )
        report_client_if_gone(child_pid)

        # The model is not called again after the turn was stopped. The mock provider counts a
        # request when it arrives, before it thinks, so a short wait is enough to see one.
        requests_at_the_stop = server.requests
        later_output = read_until(master, debug_log_fd, lambda o: FINAL_ANSWER in o, 3)

        print("turn stopped:", "yes" if STOP_NOTICE in output else "no")
        print(
            "final answer of the model shown:",
            "yes" if FINAL_ANSWER in output + later_output else "no",
        )
        print(
            "model called after the turn was stopped:",
            "yes" if server.requests != requests_at_the_stop else "no",
        )

        # The results the model has seen. Once a query has failed, the connection is gone, and a
        # query that succeeded after that was run on another connection.
        results = list(server.results)
        failures = [i for i, result in enumerate(results) if not tool_succeeded(result)]
        run_on_a_new_connection = (
            sum(tool_succeeded(result) for result in results[failures[0] + 1 :]) if failures else 0
        )
        print("queries run on a new connection:", run_on_a_new_connection)
        if len(results) >= MAX_TOOL_CALLS:
            print(f"the model ran out of tool calls: {[result[:200] for result in results]}")
    finally:
        # The client is in AI-chat mode after the question, where `exit` is a question as well,
        # so it is ended by closing its terminal rather than by typing anything.
        os.close(master)
        debug_log_fd.close()
        wait_for_client(child_pid)
        server.shutdown()


if __name__ == "__main__":
    main()

SELECT i\nFROM cnf_test\nWHERE not(or(greater(i, 1), greater(i, 2)))
SELECT i\nFROM cnf_test\nWHERE not(and(greater(i, 1), greater(i, 2)))
SELECT i\nFROM cnf_test\nWHERE or(and(greater(i, 1), greater(i, 2)), and(greater(i, 3), greater(i, 4)), and(greater(i, 5), greater(i, 6)))
SELECT i\nFROM cnf_test\nWHERE not(and(or(greater(i, 1), greater(i, 2)), or(greater(i, 3), greater(i, 4)), or(greater(i, 5), greater(i, 6))))
SELECT i\nFROM cnf_test\nWHERE or(and(greater(i, 1), greater(i, 2), greater(i, 7)), and(greater(i, 3), greater(i, 4), greater(i, 8)), and(greater(i, 5), greater(i, 6)))
SELECT i\nFROM cnf_test\nWHERE and(or(greater(i, 1), greater(i, 2), greater(i, 7)), or(greater(i, 3), greater(i, 4), greater(i, 8)), not(or(greater(i, 5), greater(i, 6))))

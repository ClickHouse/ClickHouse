-- Tags: no-random-settings, no-random-merge-tree-settings
-- no-random-settings, no-random-merge-tree-settings: the selected marks and EXPLAIN output may differ with
-- random settings.

SET explain_query_plan_default = 'legacy';

-- Counting from partition values or implicit projections would bypass the reads we want to observe.
SET optimize_trivial_count_query = 0;
SET optimize_use_implicit_projections = 0;

{#- Each check prints the predicate, the count with index analysis, the count of a full scan and the parts
    and granules selected by each index; with `condition`, it also prints the key conditions. -#}
{% macro check(table, predicate, condition = false) -%}
SELECT '{{ predicate | replace("\\", "\\\\") | replace("'", "\\'") }}', (SELECT count() FROM {{ table }} WHERE {{ predicate }}),
    (SELECT count() FROM {{ table }} WHERE {{ predicate }} SETTINGS use_primary_key = 0, use_partition_pruning = 0, use_skip_indexes = 0),
    (SELECT arrayStringConcat(groupArray(trimLeft(explain)), ' ') FROM (EXPLAIN indexes = 1 SELECT 1 FROM {{ table }} WHERE {{ predicate }}) WHERE match(trimLeft(explain), '^(Min-Max|Partition|Statistics|PrimaryKey|Skip|Name:|Parts:|Granules:)'))
    {%- if condition %}, (SELECT arrayStringConcat(groupArray(trimLeft(explain)), ' | ') FROM (EXPLAIN indexes = 1 SELECT 1 FROM {{ table }} WHERE {{ predicate }}) WHERE trimLeft(explain) LIKE 'Condition:%'){% endif %}
FORMAT TSVRaw;
{%- endmacro %}

CREATE TABLE test_part_prune (ts DateTime('UTC'), x UInt32) ENGINE = MergeTree
PARTITION BY (toYYYYMM(ts), toDate(ts)) ORDER BY x SETTINGS index_granularity = 1;
-- 6 days spanning a month boundary, 4 rows per day: 6 partitions.
INSERT INTO test_part_prune SELECT toDateTime('2026-03-30 00:00:00', 'UTC') + INTERVAL intDiv(number, 4) DAY + INTERVAL (number % 4) * 6 HOUR, number FROM numbers(24);
SELECT count() FROM system.parts WHERE database = currentDatabase() AND table = 'test_part_prune' AND active;

-- Point predicate on ts prunes partitions via both partition subexpressions.
{{ check('test_part_prune', "ts = toDateTime('2026-03-31 06:00:00', 'UTC')", condition = true) }}
-- Range predicate and IN over ts.
{{ check('test_part_prune', "ts >= toDateTime('2026-04-02 00:00:00', 'UTC')") }}
{{ check('test_part_prune', "ts IN (toDateTime('2026-03-31 06:00:00', 'UTC'), toDateTime('2026-04-02 12:00:00', 'UTC'))") }}
-- Direct predicate on a partition subexpression. The preimage optimization rewrites it into a
-- `ts` range before index analysis; partition and minmax pruning must stay equivalent.
{{ check('test_part_prune', "toDate(ts) = toDate('2026-03-31')") }}
-- Negated predicates must not drop partitions containing other matching rows.
{{ check('test_part_prune', "ts != toDateTime('2026-03-31 06:00:00', 'UTC')") }}
{{ check('test_part_prune', "ts NOT IN (toDateTime('2026-03-31 06:00:00', 'UTC'), toDateTime('2026-04-02 12:00:00', 'UTC'))") }}

-- moduloLegacy in the partition key with modulo predicates.
CREATE TABLE test_part_modulo (k UInt64) ENGINE = MergeTree PARTITION BY moduloLegacy(k, 10) ORDER BY k
SETTINGS index_granularity = 1;
INSERT INTO test_part_modulo SELECT number FROM numbers(30);
{{ check('test_part_modulo', 'k % 10 = 3') }}
{{ check('test_part_modulo', 'k = 13', condition = true) }}

Replicated
CREATE TABLE ctas (`x` UInt8) ENGINE = Memory AS SELECT 1 AS x
CREATE MATERIALIZED VIEW mv TO INNER (`x` UInt8) ENGINE = Memory AS SELECT x FROM db_replicated.ctas SETTINGS send_profile_traces = 0
ALTER TABLE mv (MODIFY QUERY (SELECT x FROM db_replicated.ctas WHERE x > 0 SETTINGS send_profile_traces = 1)) SETTINGS allow_experimental_alter_materialized_view_structure = 1

#!/usr/bin/expect -f
# The client announces the endpoint it connects to once per connection. A server that requires a
# password rejects the first attempt, which the client makes without one, and then prompts for the
# password and attempts the very same endpoint again - the endpoint must not be announced twice.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0
set history_file $CLICKHOUSE_TMP/$basename.history
set user "user_$env(CLICKHOUSE_DATABASE)"

log_user 0
set timeout 60
match_max 100000

expect_after {
    # Do not ignore eof from expect
    -i $any_spawn_id eof { exp_continue }
    # A default timeout action is to do nothing, change it to fail
    -i $any_spawn_id timeout { exit 1 }
}

spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --history_file=$history_file"
expect ":) "

send -- "DROP USER IF EXISTS $user\r"
expect "Ok."
# Wait for the prompt to be redrawn before sending the next command, otherwise
# the input can race the readline redraw and get lost.
expect ":) "

send -- "CREATE USER $user IDENTIFIED WITH plaintext_password BY 'qwerty'\r"
expect "Ok."
expect ":) "

send -- "GRANT SELECT ON *.* TO $user\r"
expect "Ok."
expect ":) "

send -- "exit\r"
expect eof

# No password is given, so the first attempt fails and the client asks for one.
spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --history_file=$history_file --user $user"
expect -ex "Connecting to"
expect -ex "Password for user"
send -- "qwerty\r"

expect {
    -ex "Connecting to" {
        send_user "The endpoint was announced twice.\n"
        exit 1
    }
    -ex "Connected to ClickHouse server" { }
}

expect ":) "
send -- "exit\r"
expect eof

spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --history_file=$history_file"
expect ":) "

send -- "DROP USER $user\r"
expect "Ok."
expect ":) "

send -- "exit\r"
expect eof

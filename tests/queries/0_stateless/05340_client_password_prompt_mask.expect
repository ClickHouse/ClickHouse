#!/usr/bin/expect -f
# The password prompt echoes every typed character as a mask: "●" in a UTF-8 locale or "*" otherwise.
# The line editing characters erase the characters together with their masks.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0
set history_file $CLICKHOUSE_TMP/$basename.history
set user "user_$env(CLICKHOUSE_DATABASE)"
# The prompt with this user name contains a character two columns wide: U+4E2D, sent and matched as UTF-8 bytes.
# Command line arguments are converted by Tcl, so bash makes the bytes of this name with $'...' there.
set wide_user "user_\xE4\xB8\xAD_$env(CLICKHOUSE_DATABASE)"

log_user 0
set timeout 60
match_max 100000

expect_after {
    # Do not ignore eof from expect
    -i $any_spawn_id eof { exp_continue }
    # A default timeout action is to do nothing, change it to fail
    -i $any_spawn_id timeout { exit 1 }
}

spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --history_file=$history_file"
fconfigure $spawn_id -encoding binary
expect ":) "

send -- "DROP USER IF EXISTS $user, `$wide_user`\r"
expect "Ok."
# Wait for the prompt to be redrawn before sending the next command, otherwise
# the input can race the readline redraw and get lost.
expect ":) "

send -- "CREATE USER $user, `$wide_user` IDENTIFIED WITH plaintext_password BY 'qwerty'\r"
expect "Ok."
expect ":) "

send -- "exit\r"
expect eof

# In a UTF-8 locale, the mask is U+25CF BLACK CIRCLE. Match the output as bytes to not depend on the locale of `expect`.
set bullet "\xE2\x97\x8F"
set prompt "Password for user ($wide_user): "
# The wide character takes three bytes and two columns.
set prompt_width [expr {[string length $prompt] - 1}]
spawn bash -c "source $basedir/../shell_config.sh ; stty iutf8 cols 200 ; LC_ALL=C.UTF-8 \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --history_file=$history_file --user user_\$'\\xE4\\xB8\\xAD'_$env(CLICKHOUSE_DATABASE) --ask-password"
fconfigure $spawn_id -encoding binary
expect -ex $prompt
# A character of two bytes gets one mask.
send -- "q\xC3\xA9"
expect -ex "$bullet$bullet"
# Backspace erases the last character: moves the cursor to its mask and clears the line from there.
send -- "\x7f"
expect -ex "\x1b\[[expr {$prompt_width + 2}]G\x1b\[K"
send -- "werty"
expect -ex "$bullet$bullet$bullet$bullet$bullet"
send -- "\r"
expect "Connected to ClickHouse server"
expect ":) "
send -- "exit\r"
expect eof

# Otherwise, the mask is an asterisk. The terminal is narrow, so that the masks wrap to the next line.
set prompt "Password for user ($user): "
set prompt_length [string length $prompt]
set width [expr {$prompt_length + 3}]
spawn bash -c "source $basedir/../shell_config.sh ; stty -iutf8 cols $width ; LC_ALL=C \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --history_file=$history_file --user $user --ask-password"
fconfigure $spawn_id -encoding binary
expect -ex $prompt
send -- "ab-cd"
expect -ex "*****"
# Ctrl+W erases the word "cd", which is on the second line.
send -- "\x17"
expect -ex "\x1b\[2G\x1b\[K\x1b\[1G\x1b\[K"
# Ctrl+W erases "ab-": the cursor moves up to the last column of the first line.
send -- "\x17"
expect -ex "\x1b\[A\x1b\[${width}G\x1b\[K\x1b\[[expr {$prompt_length + 2}]G\x1b\[K\x1b\[[expr {$prompt_length + 1}]G\x1b\[K"
# Ctrl+V makes the next character literal, here Ctrl+U, which gets a mask.
send -- "\x16\x15"
expect -ex "*"
# Ctrl+U erases the whole input.
send -- "\x15"
expect -ex "\x1b\[[expr {$prompt_length + 1}]G\x1b\[K"
# Ctrl+R prints the prompt and the masks again on a new line.
send -- "qw\x12"
expect -ex "\n$prompt**"
send -- "erty\r"
expect "Connected to ClickHouse server"
expect ":) "
send -- "exit\r"
expect eof

spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --history_file=$history_file"
fconfigure $spawn_id -encoding binary
expect ":) "

send -- "DROP USER $user, `$wide_user`\r"
expect "Ok."
expect ":) "

send -- "exit\r"
expect eof

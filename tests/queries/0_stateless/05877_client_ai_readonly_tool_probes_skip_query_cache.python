# Before the unconfirmed read-only tool runs a query, the client asks the server what the tables of
# the query are - their engines, the expressions stored in them, their row policies. These lookups
# are queries of the session, and a session can have the query result cache on, also for the
# queries that read `system` tables (`query_cache_system_table_handling = 'save'`). The key of that
# cache is the query and not the state it reads, and DDL does not invalidate it, so the lookup of a
# table would be answered with the engine the table had when the lookup was first made: a `Memory`
# table that was replaced by a view under the same name would still be taken for the `Memory`
# table, and the view would be read without confirmation.
#
# The lookups must not use the cache. This script is one session with the cache on, in which the
# agent is made to read a table through the read-only tool; the `.sh` wrapper runs it twice, on the
# table and on the view that replaced it. The cache is the one of the server, shared by the two
# sessions, so the lookup of the second session is the very query the first one made.
import json
import os
import pty
import select
import shlex
import signal
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, HTTPServer

TIMEOUT_SECONDS = 120

# How long a client may take to end after its terminal was closed, before it is killed.
TEARDOWN_SECONDS = 30

# `clickhouse-test` prints this file when the test fails, and it names it after the test case -
# the `.sh` wrapper - not after this script. Writing anywhere else means the trace of a failure in
# CI is collected and then never shown, which is the only record of what the client did.
DEBUG_LOG = os.path.join(
    os.environ["CLICKHOUSE_TMP"],
    os.path.basename(os.path.abspath(__file__)).removesuffix(".python") + ".sh.debuglog",
)

# Set when the pseudo-terminal reaches end of file: the client is gone. Every later read then
# returns at once and every write is silently discarded, so without noticing it the test runs to
# the end and reports every expectation as unmet, saying nothing about the client having died.
client_gone = False

FINAL_ANSWER = "MOCK-DONE"

# The settings are applied with a `SET` in the session rather than on the command line, where the
# test environment may already pass some of them.
CACHE_SETTINGS = (
    "SET use_query_cache = 1, query_cache_system_table_handling = 'save', "
    "query_cache_nondeterministic_function_handling = 'save'"
)


class Handler(BaseHTTPRequestHandler):
    """A mock OpenAI-compatible provider. It answers with one `run_readonly_query` tool call and
    finishes with a plain text message."""

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        request = json.loads(self.rfile.read(length))

        results = [str(m.get("content")) for m in request["messages"] if m.get("role") == "tool"]
        if results:
            self.server.result = results[-1]
            message = {"role": "assistant", "content": FINAL_ANSWER}
            finish_reason = "stop"
        else:
            message = {
                "role": "assistant",
                "content": None,
                "tool_calls": [
                    {
                        "id": "call_read",
                        "type": "function",
                        "function": {
                            "name": "run_readonly_query",
                            "arguments": json.dumps({"query": self.server.query}),
                        },
                    }
                ],
            }
            finish_reason = "tool_calls"

        body = json.dumps(
            {
                "id": "chatcmpl-1",
                "object": "chat.completion",
                "created": 1,
                "model": "gpt-4o",
                "choices": [{"index": 0, "message": message, "finish_reason": finish_reason}],
                "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2},
            }
        ).encode()

        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


def make_config(port):
    """A client configuration that points the AI agent at the mock provider. The credentials come
    from the configuration and not from the environment, so the agent does not ask for the
    confirmation of using an API key found there."""
    path = os.path.join(
        os.environ["CLICKHOUSE_TMP"],
        os.path.basename(os.path.abspath(__file__)).removesuffix(".python") + ".config.xml",
    )
    with open(path, "w") as f:
        f.write(
            "<clickhouse><ai>"
            "<provider>openai</provider>"
            "<api_key>mock-key</api_key>"
            f"<base_url>http://127.0.0.1:{port}/v1</base_url>"
            "<model>gpt-4o</model>"
            "</ai></clickhouse>"
        )
    return path


def client_argv(config):
    """The interactive client of the test environment. The configuration file of the environment is
    replaced by the one of the mock provider rather than added to it: the client accepts one."""
    argv = shlex.split(os.environ["CLICKHOUSE_CLIENT_BINARY"])
    for option in shlex.split(os.environ["CLICKHOUSE_CLIENT_EXPECT_OPT"]):
        if option.startswith("--config-file"):
            continue
        argv.append(option)
    return argv + [f"--config-file={config}", "--history_file=/dev/null"]


def read_until(master, debug_log_fd, predicate, timeout):
    global client_gone
    output = ""
    deadline = time.time() + timeout
    while time.time() < deadline:
        r, _, _ = select.select([master], [], [], 0.3)
        if not r:
            continue
        try:
            chunk = os.read(master, 65536)
        except OSError:
            client_gone = True
            break
        if not chunk:
            client_gone = True
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()
        output += chunk.decode(errors="replace")
        if predicate(output):
            return output
    return output


def report_client_if_gone(child_pid):
    """Print how the client ended if it is gone. The expected output has no such line, so it
    shows up in the diff of the failure instead of leaving only unmet expectations behind."""
    if not client_gone:
        return
    try:
        _, status = os.waitpid(child_pid, os.WNOHANG)
    except ChildProcessError:
        print("client_gone: already reaped")
        return
    if os.WIFSIGNALED(status):
        print(f"client_gone: killed by signal {os.WTERMSIG(status)}")
    elif os.WIFEXITED(status):
        print(f"client_gone: exited with code {os.WEXITSTATUS(status)}")
    else:
        print("client_gone: yes")


def wait_for_client(child_pid):
    """Wait for the client to end after its terminal was closed, and make sure it is gone."""
    deadline = time.time() + TEARDOWN_SECONDS
    while time.time() < deadline:
        try:
            reaped, _ = os.waitpid(child_pid, os.WNOHANG)
        except ChildProcessError:
            return
        if reaped == child_pid:
            return
        time.sleep(0.05)
    try:
        os.kill(child_pid, signal.SIGKILL)
        os.waitpid(child_pid, 0)
    except (ChildProcessError, ProcessLookupError):
        pass


def main():
    label, query = sys.argv[1], sys.argv[2]

    server = HTTPServer(("127.0.0.1", 0), Handler)
    server.query = query
    server.result = None
    threading.Thread(target=server.serve_forever, daemon=True).start()

    argv = client_argv(make_config(server.server_port))

    child_pid, master = pty.fork()
    if child_pid == 0:
        os.environ["TERM"] = "xterm"
        # An API key in the environment would take precedence over the configured mock provider.
        os.environ.pop("OPENAI_API_KEY", None)
        os.environ.pop("ANTHROPIC_API_KEY", None)
        os.execv(argv[0], argv)
        return

    debug_log_fd = open(DEBUG_LOG, "a")
    try:
        read_until(master, debug_log_fd, lambda o: ":)" in o, TIMEOUT_SECONDS)

        os.write(master, CACHE_SETTINGS.encode() + b"\n")
        # Both the answer and the prompt that follows it: the question must not be typed before
        # the client is reading a line again, or it would be submitted as a part of the statement.
        read_until(
            master,
            debug_log_fd,
            lambda o: "Ok." in o and ":)" in o.split("Ok.", 1)[1],
            TIMEOUT_SECONDS,
        )

        os.write(master, b"? look at the table\n")
        read_until(master, debug_log_fd, lambda o: FINAL_ANSWER in o, TIMEOUT_SECONDS)
        report_client_if_gone(child_pid)

        result = server.result
        if result is None:
            print(f"{label}: NO RESULT")
        elif '"success":true' in result.replace(" ", ""):
            print(f"{label}: READ")
        elif "`View` engine" in result and "run_query" in result:
            # Refused by the client, and for the engine of the table: the lookup saw the view.
            print(f"{label}: REFUSED AS A VIEW")
        else:
            print(f"{label}: UNEXPECTED {result[:300]}")
    finally:
        # The client is in AI-chat mode after the question, where `exit` is a question as well,
        # so it is ended by closing its terminal rather than by typing anything.
        os.close(master)
        debug_log_fd.close()
        wait_for_client(child_pid)
        server.shutdown()


if __name__ == "__main__":
    main()

import multiprocessing
import os
import pty
import select
import shlex
import time

TIMEOUT_SECONDS = 30

# How long to keep reading after the last keystroke while waiting for the expected output. The
# model is seeded from `system.user_query_log` by a background query, which can take a while on
# slow (sanitizer) builds.
FINAL_WAIT_SECONDS = 20

DEBUG_LOG = os.path.join(
    os.environ["CLICKHOUSE_TMP"],
    os.path.basename(os.path.abspath(__file__)).strip(".python") + ".debuglog",
)

# The gray SGR sequence replxx uses for the as-you-type hint (Color::GRAY -> "0;1;30").
HINT_COLOR = "\x1b[0;1;30m"


def read_until(master, debug_log_fd, predicate, timeout):
    output = ""
    deadline = time.time() + timeout
    while time.time() < deadline:
        r, _, _ = select.select([master], [], [], 0.3)
        if not r:
            if predicate(output):
                return output
            continue
        try:
            chunk = os.read(master, 4096)
        except OSError:
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()
        output += chunk.decode(errors="replace")
        if predicate(output):
            return output
    return output


def drain(master, debug_log_fd, idle):
    output = ""
    while True:
        r, _, _ = select.select([master], [], [], idle)
        if not r:
            break
        try:
            chunk = os.read(master, 4096)
        except OSError:
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()
        output += chunk.decode(errors="replace")
    return output


def run_case(program, argv, name, keystrokes, check, state=None):
    """Fork a PTY, wait for the prompt, send keystrokes (with a pause between them so the
    background seeding finishes and replxx repaints), then run `check` over the output."""
    shell_pid, master = pty.fork()
    if shell_pid == 0:
        os.environ["TERM"] = "xterm"
        os.execv(program, argv)
        return

    debug_log_fd = open(DEBUG_LOG, "a")
    try:
        read_until(master, debug_log_fd, lambda o: ":)" in o, TIMEOUT_SECONDS)

        output = ""
        for keys in keystrokes:
            os.write(master, keys)
            output += drain(master, debug_log_fd, 1.0)

        if not check(output):
            output += read_until(
                master, debug_log_fd, lambda extra: check(output + extra), FINAL_WAIT_SECONDS
            )

        ok = check(output)
        print(f"{name}: {'OK' if ok else 'FAIL'}")
        state.value = 0 if ok else 1
    finally:
        os.close(master)
        debug_log_fd.close()


def run_with_timeout(program, argv, name, keystrokes, check):
    for attempt in range(5):
        state = multiprocessing.Value("i", -1)
        process = multiprocessing.Process(
            target=run_case,
            args=(program, argv, name, keystrokes, check),
            kwargs={"state": state},
        )
        process.start()
        process.join(TIMEOUT_SECONDS + FINAL_WAIT_SECONDS)
        if process.is_alive():
            process.terminate()
        if state.value in (0, 1):
            return
        # transient timeout on a loaded machine - retry
    print(f"{name}: FAIL")


def main():
    base = shlex.split(os.environ["CLICKHOUSE_CLIENT"])
    # Connect as the prepared test user (see the .sh part): a user with zero grants whose query
    # history consists of a single distinctive query, `SELECT anyHeavy(1)`. The model seeds from
    # `system.user_query_log` in the background, which requires no grants.
    args = base + [
        "--user",
        os.environ["TEST_USER"],
        "--autocomplete_model",
        "1",
        "--hints",
        "1",
    ]

    # Right after "SELECT " there is no prefix for the static dictionary to match, so any gray ghost
    # text with the full "anyHeavy" can only come from the model seeded with the user's history: the
    # session itself has not run any query. "SELECT" is typed as a separate keystroke group to give
    # the background seeding an extra drain period before the hint-triggering space. The whole case
    # is retried a few times, so a seeding that lost the race with the keystrokes only delays the
    # test, it does not fail it.
    run_with_timeout(
        args[0],
        args,
        "history_seed_ghost",
        [b"", b"SELECT", b" "],
        lambda o: (HINT_COLOR + "anyHeavy") in o,
    )


if __name__ == "__main__":
    # The cases fork a PTY and pass a `check` closure to the worker; that requires the "fork" start
    # method (the closure is not picklable, as "spawn"/"forkserver" would need). Python 3.14 made
    # "forkserver" the default on Linux, so request "fork" explicitly.
    multiprocessing.set_start_method("fork", force=True)
    main()

SET max_threads = 2;
SET max_block_size = 8192;
SET enable_adaptive_aggregator = 1;
SET adaptive_aggregator_freeze_threshold = 128;
SET adaptive_aggregator_freeze_threshold_bytes = 0;
SET collect_hash_table_stats_during_aggregation = 0;
SET group_by_two_level_threshold = 10000000;
SET group_by_two_level_threshold_bytes = 500000000;
SET max_bytes_ratio_before_external_group_by = 0;
SET min_count_to_compile_aggregate_expression = 0;

-- Staged arguments mix numeric, constant, nullable, and dictionary-encoded columns. Compiled
-- functions can share a batch with interpreted functions after conversion materializes the arguments.

{% for compiled, execution in [(0, 'interpreted'), (1, 'compiled')] %}
SET compile_aggregate_expressions = {{ compiled }};
{% for threshold, phase in [(0, 'merge'), (1, 'pressure')] %}
SET max_bytes_before_external_group_by = {{ threshold }};
SELECT '{{ execution }} {{ phase }}', count() = 8192,
    countIf(total != 8 * k + 229376 OR constant_total != 8
        OR isNull(first_present) OR first_present != k + 8192
        OR last_digit != if(k % 2, '9', '8')) = 0
FROM
(
    SELECT toUInt64(number % 8192) AS k, sum(number) AS total, sum(toUInt64(1)) AS constant_total,
        min(if(number < 8192, NULL, toNullable(number))) AS first_present,
        max(toLowCardinality(toString(number % 10))) AS last_digit
    FROM numbers_mt(65536)
    GROUP BY k
);
{% endfor %}
{% endfor %}

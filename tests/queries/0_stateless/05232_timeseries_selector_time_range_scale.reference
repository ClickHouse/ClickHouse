-- The returned columns keep the types of the table
id	Tuple(UInt64, LowCardinality(UUID))					
timestamp	DateTime64(1, \'UTC\')					
value	Float64					
-- [1000.5, 1002.5] selects the samples at 1001.5 and 1002 in DateTime64(1)
1970-01-01 00:16:41.5	2
1970-01-01 00:16:42.0	3
-- A scale greater than 3 in the arguments is kept
1970-01-01 00:16:41.5	2
-- Arguments with a smaller scale than the table are widened to the scale of the table
id	Tuple(UInt64, LowCardinality(UUID))					
timestamp	DateTime64(6, \'UTC\')					
value	Float64					
1970-01-01 00:16:41.000001	2
-- The time range lies between two consecutive timestamps of a DateTime64(1) table
0
-- Arguments with a scale greater than 9 on a table with a recent samples table: the range is compared with the TTL without overflow
2

-- 5. three tables: all reads use the same ranges
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Expression (Before GROUP BY)
          JoinLogical (Shuffle HashJoin (co-located by keyRanges(#0; 3 borders))  swapped)
            Expression (Change column names to column identifiers)
              ReadFromMergeTree (RangePartitionedRead default.t_range_join_events)
            JoinLogical (Shuffle HashJoin (co-located by keyRanges(#0; 3 borders))  swapped)
              Expression (Change column names to column identifiers)
                ReadFromMergeTree (RangePartitionedRead default.t_range_join_details)
              Expression (Change column names to column identifiers)
                ReadFromMergeTree (RangePartitionedRead default.t_range_join_groups)
40500	337104750	117519
40500	337104750	117519
-- 6. a filter on the key: the ranges divide the selected marks
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Expression ((Before GROUP BY + ))
          JoinLogical (Shuffle HashJoin (co-located by keyRanges(#0; 3 borders)) )
            Expression ((WHERE + Change column names to column identifiers))
              ReadFromMergeTree (RangePartitionedRead default.t_range_join_events)
            Filter ((WHERE + Change column names to column identifiers))
              ReadFromMergeTree (RangePartitionedRead default.t_range_join_groups)
41000	335479500
41000	335479500
-- 7. the join column is not the first key column: no ranges
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Expression (Before GROUP BY)
          JoinLogical (Broadcast HashJoin )
            Expression (Change column names to column identifiers)
              ReadFromMergeTree (ParallelRead default.t_range_join_events)
            Expression (Change column names to column identifiers)
              ReadFromMergeTree (ReplicatedRead default.t_range_join_details)
4000
4000

-- 1. inner join of two tables
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Expression (Before GROUP BY)
          JoinLogical (Shuffle HashJoin (co-located by keyRanges(#0; 3 borders)) )
            Expression (Change column names to column identifiers)
              ReadFromMergeTree (RangePartitionedRead default.t_range_join_events)
            Expression (Change column names to column identifiers)
              ReadFromMergeTree (RangePartitionedRead default.t_range_join_groups)
49000	400475500
49000	400475500
-- 2. left join
49000	400475500	0
49000	400475500	0
-- 3. right join
50500	400475500	1501
50500	400475500	1501
-- 4. full join
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Expression (Before GROUP BY)
          JoinLogical (Shuffle HashJoin (co-located by keyRanges(#0; 3 borders)) )
            Expression (Change column names to column identifiers)
              ReadFromMergeTree (RangePartitionedRead default.t_range_join_events)
            Expression (Change column names to column identifiers)
              ReadFromMergeTree (RangePartitionedRead default.t_range_join_groups)
50500	400475500	1501

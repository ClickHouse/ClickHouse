-- A block of 20000 rows is sorted by a packed key of its leading integer columns, and column by column with a LIMIT:
-- both must give the same order, for ORDER BY, for the stable sort of INSERT and for external DISTINCT.

SET optimize_sorting_by_input_stream_properties = 0;

DROP TABLE IF EXISTS src;
CREATE TABLE src ENGINE = Memory AS SELECT
    number AS n,
    reinterpretAsUUID(sipHash128(n % 50)) AS uid,
    sipHash64(n % 50) AS uh,
    toInt64(sipHash64(n % 37)) AS ih,
    toUInt16(n % 300) AS small,
    toInt8(toInt16(n % 200) - 100) AS i8,
    toInt32(toInt64(n % 101) - 50) AS neg,
    toDecimal64(toInt64(n % 1000) - 500, 3) AS dc,
    toDateTime64('2026-01-01 00:00:00', 3, 'UTC') + toIntervalMillisecond(n * 7 % 997) AS ts,
    toDate('2026-01-01') + n % 17 AS d,
    toDateTime('2026-01-01 00:00:00', 'UTC') + n % 23 AS dt,
    CAST(['a', 'b', 'c'][n % 3 + 1], 'Enum8(\'a\' = -3, \'b\' = 0, \'c\' = 5)') AS e,
    toBool(n % 5 = 0) AS b,
    toIPv4(n % 13) AS ip,
    toUInt8(n % 64) AS cat,
    toUInt32(intHash32(n) % 1000 * 1000003) AS spread,
    sipHash64(n) AS wide,
    if(n % 10 = 0, sipHash64(n), sipHash64(n % 100)) AS mix,
    sipHash64(sipHash64(n) % 1000) AS rep,
    n DIV 7 AS inc,
    toInt64(20000) - toInt64(n) AS rev,
    if(n = 64, 0, n + 1) AS late1,
    if(n = 19999, 0, n + 1) AS late2,
    materialize(toUInt8(5)) AS c5
FROM numbers(20000) SETTINGS max_block_size = 20000, max_insert_block_size = 20000, min_insert_block_size_rows = 20000, max_insert_threads = 1;

SELECT 'blocks', groupUniqArray(blockSize()) FROM src;

-- ORDER BY: `toString(n)` makes the order total and is never packed. The LIMIT leaves out the last row.
{% for k in ['uid, ts', 'uh, ts', 'ih DESC, neg', 'small, d', 'i8, dc DESC', 'e, b, dt', 'ip, cat', 'cat, uh, ts', 'uid, uh, ts', 'uid, uh, ih, ts', 'spread, ts', 'spread DESC, dc', 'wide, cat', 'c5, small', 'inc, ts', 'rev, ts', 'n DESC, ts', 'uid DESC, ts DESC', 'cat, toString(n)', 'mix, ts', 'rep, ts'] -%}
SELECT '{{ k }}', arrayPopBack((SELECT groupArray(n) FROM (SELECT n FROM src ORDER BY {{ k }}, toString(n))))
    = (SELECT groupArray(n) FROM (SELECT n FROM src ORDER BY {{ k }}, toString(n) LIMIT 19999));
{% endfor -%}

-- The last column is already in order (`n` increases, `rev` decreases), in the reverse order, or out of order in one row.
{% for k in ['cat, n', 'uid, n', 'spread, n', 'small, rev DESC', 'c5, n', 'cat, rev', 'cat, n DESC', 'cat, late1', 'cat, late2'] -%}
SELECT '{{ k }}', arrayPopBack((SELECT groupArray(n) FROM (SELECT n FROM src ORDER BY {{ k }})))
    = (SELECT groupArray(n) FROM (SELECT n FROM src ORDER BY {{ k }} LIMIT 19999));
{% endfor -%}

-- INSERT: the rows come in the order of `n`, so the stable order is (sorting key, n), and every row is written once.
{% set insert_keys = ['uid, ts', 'uid, cat', 'uh, ts', 'ih DESC, neg', 'cat, uh', 'cat, uh, ts', 'i8, dc DESC', 'spread, cat', 'spread DESC, dc', 'inc, ts', 'rev, ts', 'small, identity(1), d', 'mix, ts', 'rep, ts', 'b, inc', 'uid, inc', 'spread, inc', 'small, rev DESC', 'cat, rev', 'cat DESC, rev', 'cat, late1', 'cat, late2'] -%}
DROP TABLE IF EXISTS {% for k in insert_keys %}t{{ loop.index }}{{ ', ' if not loop.last }}{% endfor %};
{% for k in insert_keys -%}
{% set columns = k | replace(' DESC', '') | replace('identity(1), ', '') -%}
CREATE TABLE t{{ loop.index }} ENGINE = MergeTree ORDER BY ({{ k }}) SETTINGS optimize_row_order = 0, allow_experimental_reverse_key = 1 EMPTY AS SELECT n, {{ columns }} FROM src;
INSERT INTO t{{ loop.index }} SELECT n, {{ columns }} FROM src SETTINGS max_block_size = 20000, min_insert_block_size_rows = 20000, max_insert_block_size = 20000, max_insert_threads = 1, max_threads = 1;
SELECT 'INSERT {{ k }}', arrayPopBack((SELECT groupArray(n) FROM (SELECT n FROM t{{ loop.index }} ORDER BY _part, _part_offset)))
    = (SELECT groupArray(n) FROM (SELECT n FROM src ORDER BY {{ k }}, n LIMIT 19999))
    AND (SELECT (count(), sum(cityHash64(n))) FROM t{{ loop.index }}) = (SELECT (count(), sum(cityHash64(n))) FROM src);
{% endfor -%}
DROP TABLE {% for k in insert_keys %}t{{ loop.index }}{{ ', ' if not loop.last }}{% endfor %};

-- External DISTINCT keeps the first row of each range of equal rows.
SELECT 'DISTINCT cat, uh',
    (SELECT (count(), sum(cityHash64(cat, uh))) FROM (SELECT DISTINCT cat, uh FROM src
        SETTINGS max_bytes_before_external_distinct = 1, max_bytes_ratio_before_external_distinct = 0, max_untracked_memory = 0, max_block_size = 20000))
    = (SELECT (count(), sum(cityHash64(cat, uh))) FROM (SELECT DISTINCT cat, uh FROM src
        SETTINGS max_bytes_before_external_distinct = 0, max_bytes_ratio_before_external_distinct = 0));

DROP TABLE src;

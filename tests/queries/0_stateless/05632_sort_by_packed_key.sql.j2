-- Blocks of 20000 rows are sorted by a packed key of their leading integer columns, blocks of 128 rows column by column:
-- both must give the same order, for ORDER BY, for the stable sort of INSERT and for external DISTINCT.

SET optimize_sorting_by_input_stream_properties = 0;

DROP VIEW IF EXISTS v;
CREATE VIEW v AS SELECT
    number AS n,
    reinterpretAsUUID(sipHash128(n % 50)) AS uid,
    sipHash64(n % 50) AS uh,
    toInt64(sipHash64(n % 37)) AS ih,
    toUInt16(n % 300) AS small,
    toInt8(toInt16(n % 200) - 100) AS i8,
    toInt32(toInt64(n % 101) - 50) AS neg,
    toDecimal64(toInt64(n % 1000) - 500, 3) AS dc,
    toDateTime64('2026-01-01 00:00:00', 3, 'UTC') + toIntervalMillisecond(n * 7 % 997) AS ts,
    toDate('2026-01-01') + n % 17 AS d,
    toDateTime('2026-01-01 00:00:00', 'UTC') + n % 23 AS dt,
    CAST(['a', 'b', 'c'][n % 3 + 1], 'Enum8(\'a\' = -3, \'b\' = 0, \'c\' = 5)') AS e,
    toBool(n % 5 = 0) AS b,
    toIPv4(n % 13) AS ip,
    toUInt8(n % 64) AS cat,
    toUInt32(intHash32(n) % 1000 * 1000003) AS spread,
    sipHash64(n) AS wide,
    if(n % 10 = 0, sipHash64(n), sipHash64(n % 100)) AS mix,
    sipHash64(sipHash64(n) % 1000) AS rep,
    n DIV 7 AS inc,
    toInt64(20000) - toInt64(n) AS rev,
    materialize(toUInt8(5)) AS c5
FROM numbers(20000);

-- ORDER BY: `toString(n)` makes the order total and is never packed.
{% for k in ['uid, ts', 'uh, ts', 'ih DESC, neg', 'small, d', 'i8, dc DESC', 'e, b, dt', 'ip, cat', 'cat, uh, ts', 'uid, uh, ts', 'uid, uh, ih, ts', 'spread, ts', 'spread DESC, dc', 'wide, cat', 'c5, small', 'inc, ts', 'rev, ts', 'n DESC, ts', 'uid DESC, ts DESC', 'cat, toString(n)', 'mix, ts', 'rep, ts'] -%}
SELECT '{{ k }}', (SELECT groupArray(n) FROM (SELECT n FROM v ORDER BY {{ k }}, toString(n) SETTINGS max_block_size = 20000))
    = (SELECT groupArray(n) FROM (SELECT n FROM v ORDER BY {{ k }}, toString(n) SETTINGS max_block_size = 128));
{% endfor -%}

-- INSERT: the rows come in the order of `n`, so the stable order is (sorting key, n), and every row is written once.
{% for k in ['uid, ts', 'uid, cat', 'uh, ts', 'ih DESC, neg', 'cat, uh', 'cat, uh, ts', 'i8, dc DESC', 'spread, cat', 'spread DESC, dc', 'inc, ts', 'rev, ts', 'small, identity(1), d', 'mix, ts', 'rep, ts'] -%}
DROP TABLE IF EXISTS t;
CREATE TABLE t ENGINE = MergeTree ORDER BY ({{ k }}) SETTINGS optimize_row_order = 0, allow_experimental_reverse_key = 1 EMPTY AS SELECT * FROM v;
INSERT INTO t SELECT * FROM v SETTINGS max_block_size = 20000, min_insert_block_size_rows = 20000, max_insert_block_size = 20000, max_insert_threads = 1, max_threads = 1;
SELECT 'INSERT {{ k }}', (SELECT groupArray(n) FROM (SELECT n FROM t ORDER BY _part, _part_offset))
    = (SELECT groupArray(n) FROM (SELECT n FROM t ORDER BY _part, {{ k }}, n SETTINGS max_block_size = 128))
    AND (SELECT (count(), sum(cityHash64(n))) FROM t) = (SELECT (count(), sum(cityHash64(n))) FROM v);
{% endfor -%}
DROP TABLE t;

-- External DISTINCT keeps the first row of each range of equal rows.
SELECT 'DISTINCT cat, uh',
    (SELECT (count(), sum(cityHash64(cat, uh))) FROM (SELECT DISTINCT cat, uh FROM v
        SETTINGS max_bytes_before_external_distinct = 1, max_bytes_ratio_before_external_distinct = 0, max_untracked_memory = 0, max_block_size = 20000))
    = (SELECT (count(), sum(cityHash64(cat, uh))) FROM (SELECT DISTINCT cat, uh FROM v
        SETTINGS max_bytes_before_external_distinct = 0, max_bytes_ratio_before_external_distinct = 0));

DROP VIEW v;

-- Q18
DelayedCreatingSets
  Expression (Project names)
    Limit (preliminary LIMIT)
      Limit (TopN merge Sorting for ORDER BY)
        GatherExchange
          Sorting
            Expression ((Before ORDER BY + Projection))
              Aggregating
                Expression ((Before GROUP BY + ))
                  JoinLogical (Shuffle HashJoin  swapped)
                    Expression ((WHERE + Change column names to column identifiers))
                      ShuffleExchange
                        ReadFromMergeTree (ParallelRead default.lineitem)
                    ShuffleExchange
                      JoinLogical (Shuffle HashJoin  swapped)
                        Expression ((WHERE + Change column names to column identifiers))
                          ShuffleExchange
                            ReadFromMergeTree (ParallelRead default.orders)
                        Expression (Change column names to column identifiers)
                          ShuffleExchange
                            ReadFromMergeTree (ParallelRead default.customer)
-- Q18 rewrite_in_to_join
Expression (Project names)
  Limit (preliminary LIMIT)
    Limit (TopN merge Sorting for ORDER BY)
      GatherExchange
        Sorting
          Expression ((Before ORDER BY + Projection))
            Aggregating
              Expression ((Before GROUP BY + WHERE))
                JoinLogical (Shuffle HashJoin  swapped)
                  JoinLogical (Shuffle HashJoin  swapped)
                    Expression (Change column names to column identifiers)
                      ShuffleExchange
                        ReadFromMergeTree (ParallelRead default.lineitem)
                    ShuffleExchange
                      JoinLogical (Shuffle HashJoin  swapped)
                        Expression (Change column names to column identifiers)
                          ShuffleExchange
                            ReadFromMergeTree (ParallelRead default.orders)
                        Expression (Change column names to column identifiers)
                          ShuffleExchange
                            ReadFromMergeTree (ParallelRead default.customer)
                  Expression (Create result for always true EXISTS expression)
                    Filter (((WHERE + (Renaming correlated columns to equivalent expressions in subquery + (Change column names to column identifiers + (Project names + (Projection + (Change column names to column identifiers + (Project names + Projection))))))) + HAVING))
                      Aggregating
                        Expression ((((WHERE + (Renaming correlated columns to equivalent expressions in subquery + (Change column names to column identifiers + (Project names + (Projection + (Change column names to column identifiers + (Project names + Projection))))))) + HAVING) + (Before GROUP BY + Change column names to column identifiers)))
                          ShuffleExchange
                            ReadFromMergeTree (ParallelRead default.lineitem)

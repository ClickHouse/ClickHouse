-- Q18
DelayedCreatingSets
  Expression (Project names)
    Limit (preliminary LIMIT)
      Limit (TopN merge Sorting for ORDER BY)
        GatherExchange
          Sorting
            Expression ((Before ORDER BY + Projection))
              Aggregating
                JoinLogical (Shuffle HashJoin  swapped)
                  ShuffleExchange
                    Aggregating
                      Expression ((WHERE + Change column names to column identifiers))
                        ReadFromMergeTree (ParallelRead default.lineitem)
                  ShuffleExchange
                    JoinLogical (Shuffle HashJoin  swapped)
                      Expression ((WHERE + Change column names to column identifiers))
                        ShuffleExchange
                          ReadFromMergeTree (ParallelRead default.orders)
                      Expression (Change column names to column identifiers)
                        ShuffleExchange
                          ReadFromMergeTree (ParallelRead default.customer)
-- Q18 rewrite_in_to_join
Expression (Project names)
  Limit (preliminary LIMIT)
    Limit (TopN merge Sorting for ORDER BY)
      GatherExchange
        Sorting
          Expression ((Before ORDER BY + Projection))
            Aggregating
              Expression ((Before GROUP BY + WHERE))
                JoinLogical (Shuffle HashJoin )
                  JoinLogical (Shuffle HashJoin  swapped)
                    Expression (Change column names to column identifiers)
                      ShuffleExchange
                        ReadFromMergeTree (ParallelRead default.lineitem)
                    ShuffleExchange
                      JoinLogical (Shuffle HashJoin  swapped)
                        Expression (Change column names to column identifiers)
                          ShuffleExchange
                            ReadFromMergeTree (ParallelRead default.orders)
                        Expression (Change column names to column identifiers)
                          ShuffleExchange
                            ReadFromMergeTree (ParallelRead default.customer)
                  Expression ((Create the result of IN for the matched rows + (Project names + Projection)))
                    Filter (HAVING)
                      Aggregating
                        Expression ((Before GROUP BY + Change column names to column identifiers))
                          ShuffleExchange
                            ReadFromMergeTree (ParallelRead default.lineitem)
-- customer distribution by nation: pushed (variant A) under the same SF100 hints
Expression (Project names)
  Expression ((Before ORDER BY + Projection))
    Sorting
      Aggregating
        JoinLogical (Local HashJoin  swapped)
          Expression (Change column names to column identifiers)
            ReadFromMergeTree (default.nation)
          GatherExchange
            Aggregating
              Expression (Change column names to column identifiers)
                ReadFromMergeTree (ParallelRead default.customer)

-- Outer columns named like the join's synthesized keys (internal __actionName).

SELECT a, (SELECT isNull(a))
FROM (SELECT toNullable(number) AS a FROM numbers(2)) AS o
GROUP BY a, isNull(a), __actionName('x', 'isNull(__table3.a)_0') WITH ROLLUP
ORDER BY a NULLS LAST
SETTINGS group_by_use_nulls = 1;

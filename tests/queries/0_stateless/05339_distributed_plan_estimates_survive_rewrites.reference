-- shuffled join and distributed reads keep their estimates
Expression ((Project names + Projection)) (rows: <unknown>, cost: <unknown>)
  MergingAggregated (merge) (rows: ~1.0)
    GatherExchange (rows: <unknown>, cost: <unknown>)
      Aggregating (partial) (rows: <unknown>, cost: <unknown>)
        Expression (Before GROUP BY) (rows: ~100000.0)
          JoinLogical (rows: ~100000.0, cost: 100000.0)
            ShuffleExchange (by hash([__table1.k])) (rows: <unknown>, cost: <unknown>)
              Expression (Change column names to column identifiers) (rows: ~100000.0, source: primary_index)
                ReadFromMergeTree (default.t_sr_big) (rows: <unknown>, cost: <unknown>)
            ShuffleExchange (by hash([__table2.k])) (rows: <unknown>, cost: <unknown>)
              Expression (Change column names to column identifiers) (rows: ~1000.0, source: primary_index)
                ReadFromMergeTree (default.t_sr_small) (rows: <unknown>, cost: <unknown>)
-- shuffled aggregation with a known group count
GatherExchange (rows: ~1000.0, source: hint)
  Expression ((Project names + Projection)) (rows: ~1000.0, source: hint)
    MergingAggregated (merge) (rows: ~1000.0, source: hint)
      ShuffleExchange (by hash([__table1.k])) (rows: <unknown>, cost: <unknown>)
        Aggregating (partial) (rows: <unknown>, cost: <unknown>)
          Expression ((Before GROUP BY + Change column names to column identifiers)) (rows: ~100000.0, source: hint)
            ReadFromMergeTree (default.t_sr_big) (rows: <unknown>, cost: <unknown>)
-- shuffled aggregation without a group count: unknown, not the input rows
GatherExchange (rows: <unknown>, source: primary_index)
  Expression ((Project names + Projection)) (rows: <unknown>, source: primary_index)
    MergingAggregated (merge) (rows: <unknown>, source: primary_index)
      ShuffleExchange (by hash([__table1.k])) (rows: <unknown>, cost: <unknown>)
        Aggregating (partial) (rows: <unknown>, cost: <unknown>)
          Expression ((Before GROUP BY + Change column names to column identifiers)) (rows: ~100000.0, source: primary_index)
            ReadFromMergeTree (default.t_sr_big) (rows: <unknown>, cost: <unknown>)
-- global aggregation: one row
Expression ((Project names + Projection)) (rows: <unknown>, cost: <unknown>)
  MergingAggregated (merge) (rows: ~1.0, source: primary_index)
    GatherExchange (rows: <unknown>, cost: <unknown>)
      Aggregating (partial) (rows: <unknown>, cost: <unknown>)
        Expression ((Before GROUP BY + Change column names to column identifiers)) (rows: ~100000.0, source: primary_index)
          ReadFromMergeTree (default.t_sr_big) (rows: <unknown>, cost: <unknown>)

-- { echoOn }
SET enable_analyzer = 1;
EXPLAIN QUERY TREE SELECT encrypt('aes-256-ofb', (SELECT 'qwerty'), '12345678901234567890123456789012'), encrypt('aes-256-ofb', (SELECT 'asdf'), '12345678901234567890123456789012');
QUERY id: 0
  PROJECTION COLUMNS
    encrypt(\'aes-256-ofb\', [HIDDEN id: 1], [HIDDEN id: 2]) Nullable(String)
    encrypt(\'aes-256-ofb\', [HIDDEN id: 4], [HIDDEN id: 2]) Nullable(String)
  PROJECTION
    LIST id: 1, nodes: 2
      CONSTANT id: 2, constant_value: [HIDDEN id: 3], constant_value_type: Nullable(String)
      CONSTANT id: 3, constant_value: [HIDDEN id: 5], constant_value_type: Nullable(String)
  JOIN TREE
    TABLE id: 4, alias: __table1, table_name: system.one
-- The session setting alone must not reveal secrets: the `display_secrets_in_show_and_select`
-- server setting and the `displaySecretsInShowAndSelect` privilege are also required, and the
-- stateless test server has neither.
SET format_display_secrets_in_show_and_select = 1;
EXPLAIN QUERY TREE SELECT encrypt('aes-256-ofb', (SELECT 'qwerty'), '12345678901234567890123456789012'), encrypt('aes-256-ofb', (SELECT 'asdf'), '12345678901234567890123456789012');
QUERY id: 0
  PROJECTION COLUMNS
    encrypt(\'aes-256-ofb\', [HIDDEN id: 1], [HIDDEN id: 2]) Nullable(String)
    encrypt(\'aes-256-ofb\', [HIDDEN id: 4], [HIDDEN id: 2]) Nullable(String)
  PROJECTION
    LIST id: 1, nodes: 2
      CONSTANT id: 2, constant_value: [HIDDEN id: 3], constant_value_type: Nullable(String)
      CONSTANT id: 3, constant_value: [HIDDEN id: 5], constant_value_type: Nullable(String)
  JOIN TREE
    TABLE id: 4, alias: __table1, table_name: system.one

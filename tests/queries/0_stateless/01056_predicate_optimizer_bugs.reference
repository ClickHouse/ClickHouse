SELECT ccc\nFROM\n(\n    (\n        SELECT 1 AS ccc\n        FROM system.one\n    )\n    UNION ALL\n    (\n        SELECT *\n        FROM\n        (\n            SELECT 2 AS ccc\n            FROM system.one\n        )\n        ANY INNER JOIN\n        (\n            SELECT 2 AS ccc\n            FROM system.one\n        ) USING (ccc)\n    )\n)\nWHERE greater(ccc, 1)
2
SELECT\n    ts,\n    id,\n    id_b,\n    b.ts,\n    b.id,\n    id_c\nFROM\n(\n    SELECT\n        ts,\n        id,\n        id_b\n    FROM A\n) AS a\nALL LEFT JOIN B AS b ON equals(b.id, a.id_b)\nWHERE lessOrEquals(a.ts, toDateTime(\'1970-01-01 03:00:00\'))
SELECT\n    ts AS `--a.ts`,\n    id AS `--a.id`,\n    id_b AS `--a.id_b`,\n    b.ts AS `--b.ts`,\n    b.id AS `--b.id`,\n    id_c AS `--b.id_c`\nFROM\n(\n    SELECT\n        ts,\n        id,\n        id_b\n    FROM A\n) AS a\nALL LEFT JOIN B AS b ON equals(`--b.id`, `--a.id_b`)\nWHERE lessOrEquals(`--a.ts`, toDateTime(\'1970-01-01 03:00:00\'))

SELECT\n    k,\n    v,\n    d,\n    i\nFROM\n(\n    SELECT\n        tupleElement(t, 1) AS k,\n        tupleElement(t, 2) AS v,\n        runningDifference(v) AS d,\n        runningDifference(cityHash64(tupleElement(t, 1))) AS i\n    FROM\n    (\n        SELECT arrayJoin(array(_CAST((\'a\', 1), \'Tuple(String, UInt8)\'), _CAST((\'a\', 2), \'Tuple(String, UInt8)\'), _CAST((\'a\', 3), \'Tuple(String, UInt8)\'), _CAST((\'b\', 11), \'Tuple(String, UInt8)\'), _CAST((\'b\', 13), \'Tuple(String, UInt8)\'), _CAST((\'b\', 15), \'Tuple(String, UInt8)\'))) AS t\n        FROM system.one\n    )\n)\nWHERE equals(i, 0)
a	1	0	0
a	2	1	0
a	3	1	0
b	13	2	0
b	15	2	0
SELECT\n    co,\n    co2,\n    co3,\n    num\nFROM\n(\n    SELECT\n        co,\n        co2,\n        co3,\n        count() AS num\n    FROM\n    (\n        SELECT\n            plus(dummy, 1) AS co,\n            plus(dummy, 2) AS co2,\n            plus(dummy, 3) AS co3\n        FROM system.one\n    )\n    GROUP BY\n        co,\n        co2,\n        co3\n        WITH CUBE\n)\nWHERE and(notEquals(co, 0), notEquals(co2, 2))
1	0	3	1
1	0	0	1
SELECT name\nFROM\n(\n    SELECT name\n    FROM system.settings\n)\nANY INNER JOIN\n(\n    SELECT name\n    FROM system.settings\n) USING (name)\nWHERE equals(name, \'enable_optimize_predicate_expression\')
enable_optimize_predicate_expression

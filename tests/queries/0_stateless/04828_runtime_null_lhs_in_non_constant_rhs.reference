-- A left-hand side of type `Nullable(Nothing)`, such as `materialize(NULL)` or a column
-- holding only `NULL`, is `NULL` in every row, so under compare-nulls semantics
-- (`transform_null_in = 1` or explicit `nullIn`) the row-wise rewrite of a non-constant RHS
-- must decide by `NULL` presence among the set elements, exactly like a literal `NULL`
-- left-hand side, instead of building an `array(...)` of the elements, which would fail
-- with `NO_COMMON_TYPE` for a heterogeneous RHS such as this one.

-- { echoOn }

-- Heterogeneous non-constant RHS with a runtime NULL element in row 0.
SELECT nullIn(x, (1, CAST(if(number = 0, NULL, 'x') AS Nullable(String)), CAST(number AS Nullable(UInt64)))) FROM (SELECT materialize(NULL) AS x, number FROM numbers(2)) SETTINGS use_variant_as_common_type = 0, enable_analyzer = 0;
1
0
SELECT nullIn(x, (1, CAST(if(number = 0, NULL, 'x') AS Nullable(String)), CAST(number AS Nullable(UInt64)))) FROM (SELECT materialize(NULL) AS x, number FROM numbers(2)) SETTINGS use_variant_as_common_type = 0, enable_analyzer = 1;
1
0
SELECT nullIn(x, (1, CAST(if(number = 0, NULL, 'x') AS Nullable(String)), CAST(number AS Nullable(UInt64)))) FROM (SELECT materialize(NULL) AS x, number FROM numbers(2)) SETTINGS use_variant_as_common_type = 1, enable_analyzer = 0;
1
0
SELECT nullIn(x, (1, CAST(if(number = 0, NULL, 'x') AS Nullable(String)), CAST(number AS Nullable(UInt64)))) FROM (SELECT materialize(NULL) AS x, number FROM numbers(2)) SETTINGS use_variant_as_common_type = 1, enable_analyzer = 1;
1
0
SELECT notNullIn(x, (1, CAST(if(number = 0, NULL, 'x') AS Nullable(String)), CAST(number AS Nullable(UInt64)))) FROM (SELECT materialize(NULL) AS x, number FROM numbers(2)) SETTINGS use_variant_as_common_type = 0, enable_analyzer = 0;
0
1
SELECT notNullIn(x, (1, CAST(if(number = 0, NULL, 'x') AS Nullable(String)), CAST(number AS Nullable(UInt64)))) FROM (SELECT materialize(NULL) AS x, number FROM numbers(2)) SETTINGS use_variant_as_common_type = 0, enable_analyzer = 1;
0
1
-- A literal NULL element among the set elements: `NULL` is always present.
SELECT nullIn(materialize(NULL), (NULL, number)) FROM numbers(2) SETTINGS enable_analyzer = 0;
1
1
SELECT nullIn(materialize(NULL), (NULL, number)) FROM numbers(2) SETTINGS enable_analyzer = 1;
1
1
-- No NULL among the set elements.
SELECT nullIn(materialize(NULL), (number, number + 1)) FROM numbers(2) SETTINGS enable_analyzer = 0;
0
0
SELECT nullIn(materialize(NULL), (number, number + 1)) FROM numbers(2) SETTINGS enable_analyzer = 1;
0
0
-- Scalar non-constant RHS.
SELECT nullIn(materialize(NULL), materialize(5)), nullIn(materialize(NULL), if(number = 0, NULL, 1)) FROM numbers(2) SETTINGS enable_analyzer = 0;
0	1
0	0
SELECT nullIn(materialize(NULL), materialize(5)), nullIn(materialize(NULL), if(number = 0, NULL, 1)) FROM numbers(2) SETTINGS enable_analyzer = 1;
0	1
0	0
-- Without compare-nulls semantics the result stays NULL.
SELECT materialize(NULL) IN (1, number) FROM numbers(2) SETTINGS transform_null_in = 0, enable_analyzer = 0;
\N
\N
SELECT materialize(NULL) IN (1, number) FROM numbers(2) SETTINGS transform_null_in = 0, enable_analyzer = 1;
\N
\N

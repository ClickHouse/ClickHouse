--- a dictionary name that depends on the context
CREATE TABLE w_context (value String) AS view(SELECT dictGet(if(currentUser() = 'user', 'db.d_allowed', 'db.d'), 'value', toUInt64(1)) AS value)

SELECT * FROM w_context
a

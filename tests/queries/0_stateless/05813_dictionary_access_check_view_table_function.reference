--- a table that does not exist where the table is created, e.g. on the initiator of ON CLUSTER
CREATE TABLE w_missing (x UInt64) AS view(SELECT x FROM db.missing_table)

CREATE TABLE cluster_db.w_missing ON CLUSTER test_shard_localhost (x UInt64) AS view(SELECT x FROM db.missing_table)


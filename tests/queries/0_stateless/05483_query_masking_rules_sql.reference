-- masking of the server logs, query_log and exception messages
server log masked
[qmr_masked]
-- config rules are applied before SQL rules
[qmr_after_config]
-- SQL rules are applied in the order of their names
[qmr_ordered]
-- ALTER
[qmr_new]
<db>_r1_renamed	[qmr_new]
<db>_r1_renamed	[qmr_masked]
-- introspection: the REGEXP is a secret
<db>_r1_renamed	1	[HIDDEN]	[qmr_masked]
CREATE QUERY MASKING RULE <db>_r1_renamed REGEXP '[HIDDEN]' REPLACE '[qmr_masked]'
<db>_r1_renamed
-- errors
CANNOT_COMPILE_REGEXP
missing )
0
-- privileges
ACCESS_DENIED
QUERY MASKING RULE ADMIN
ACCESS_DENIED
QUERY MASKING RULE ADMIN
ACCESS_DENIED
ACCESS_DENIED
<db>_by_user
<db>_r1_renamed
-- query_log
select masked	1	0
create hides the regexp	3	0
not masked after drop	1

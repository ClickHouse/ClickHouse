CREATE MATERIALIZED VIEW v TO dst AS SELECT 1
CREATE MATERIALIZED VIEW v REFRESH EVERY 1 HOUR APPEND TO dst AS SELECT 1
CREATE TABLE t ENGINE = TimeSeries SAMPLES db.d TAGS db.t METRICS db.m
CREATE WINDOW VIEW wv ENGINE = Memory WATERMARK ASCENDING AS SELECT count() FROM t GROUP BY tumble(now(), toIntervalSecond(1))
CREATE WINDOW VIEW wv TO dst WATERMARK toIntervalSecond(3) ALLOWED_LATENESS toIntervalSecond(5) AS SELECT count() FROM t GROUP BY tumble(now(), toIntervalSecond(1))

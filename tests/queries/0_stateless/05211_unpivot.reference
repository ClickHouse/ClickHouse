2	jan	10
-- the name column is a String, the value column takes the common type of the listed columns
String	Nullable(Int32)
-- the result can be aliased and referred to by that alias
jan	110
mar	330
-- a subquery, a table function and a single column all work as the source
a	1
b	2
number	0
number	1

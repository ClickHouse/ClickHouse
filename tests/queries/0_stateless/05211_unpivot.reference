-- the clause survives formatting
SELECT *\nFROM monthly_sales UNPIVOT (sales FOR month IN (jan, feb))
SELECT *\nFROM monthly_sales UNPIVOT INCLUDE NULLS (sales FOR month IN (jan AS x, feb)) AS u
SELECT *\nFROM monthly_sales\nFINAL\nSAMPLE 1 / 2 UNPIVOT (sales FOR month IN (jan, feb)) AS u
SELECT *\nFROM monthly_sales\nSTREAM UNPIVOT (sales FOR month IN (jan, feb))
-- the clause survives an AST JSON round trip
SELECT * FROM monthly_sales UNPIVOT (sales FOR month IN (jan, feb))
SELECT * FROM monthly_sales UNPIVOT INCLUDE NULLS (sales FOR month IN (jan AS x, feb)) AS u

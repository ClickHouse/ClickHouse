-- the listed columns become rows, the rest are kept
1	electronics	feb	200
1	electronics	jan	100
1	electronics	mar	300
2	clothes	jan	10
2	clothes	mar	30
-- a column can be renamed, and only the listed ones are turned into rows
1	electronics	300	february	200
1	electronics	300	january	100
2	clothes	30	january	10
-- NULL values are dropped by default and kept with INCLUDE NULLS
1	feb	200
1	jan	100
2	jan	10
1	feb	200
1	jan	100
2	jan	10
1	feb	200
1	jan	100
2	feb	\N
2	jan	10
-- the name column is a String, the value column takes the common type of the listed columns
String	Nullable(Int32)
-- the result can be aliased and referred to by that alias
jan	110
mar	330
-- a subquery, a table function and a single column all work as the source
a	1
b	2
number	0
number	1
1	electronics	200	300	jan	100
2	clothes	\N	30	jan	10
-- the clause survives formatting
SELECT *\nFROM monthly_sales UNPIVOT (sales FOR month IN (jan, feb))
SELECT *\nFROM monthly_sales UNPIVOT INCLUDE NULLS (sales FOR month IN (jan AS x, feb)) AS u
SELECT *\nFROM monthly_sales\nFINAL\nSAMPLE 1 / 2 UNPIVOT (sales FOR month IN (jan, feb)) AS u
SELECT *\nFROM monthly_sales\nSTREAM UNPIVOT (sales FOR month IN (jan, feb))
-- the clause survives an AST JSON round trip
SELECT * FROM monthly_sales UNPIVOT (sales FOR month IN (jan, feb))
SELECT * FROM monthly_sales UNPIVOT INCLUDE NULLS (sales FOR month IN (jan AS x, feb)) AS u
-- errors
1	1
0

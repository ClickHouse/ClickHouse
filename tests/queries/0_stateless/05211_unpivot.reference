-- the listed columns become rows, the rest are kept
1	electronics	feb	200
1	electronics	jan	100
1	electronics	mar	300
2	clothes	jan	10
2	clothes	mar	30
-- a column can be renamed, and only the listed ones are turned into rows
1	electronics	300	february	200
1	electronics	300	january	100
2	clothes	30	january	10
-- NULL values are dropped by default and kept with INCLUDE NULLS
1	feb	200
1	jan	100

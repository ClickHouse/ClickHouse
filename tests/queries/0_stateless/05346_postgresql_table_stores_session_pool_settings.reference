--- values taken from the session are stored
SETTINGS postgresql_connection_pool_size = 3, postgresql_connection_pool_auto_close_connection = true
--- values equal to the server's are not stored

--- a stated value is kept as stated
SETTINGS postgresql_connection_pool_size = 5
--- an ATTACH with the full definition stores them too
SETTINGS postgresql_connection_pool_size = 3
--- the table keeps the stored value when attached in a session without it
PostgreSQL connection pool size: 3

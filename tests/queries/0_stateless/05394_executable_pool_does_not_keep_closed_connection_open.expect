#!/usr/bin/expect -f

# A process started by the server (here an `executable_pool` dictionary source) must not inherit
# the client connections that are open at that moment. Otherwise it keeps the socket open after the
# server closes the connection, the client never sees the close and its next query hangs.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0

log_user 0
set timeout 60
match_max 100000
expect_after {
    # Do not ignore eof from expect
    -i $any_spawn_id eof { exp_continue }
    # A default timeout action is to do nothing, change it to fail
    -i $any_spawn_id timeout { exit 1 }
}

spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT"
expect ":) "

# A new pool, so that the query below starts its process while this connection is open.
send -- "SYSTEM RELOAD DICTIONARY executable_pool_simple\r"
expect ":) "

# Takes effect from the next query: the server closes the connection as soon as it is idle.
send -- "SET idle_connection_timeout = 0\r"
expect ":) "

send -- "SELECT dictGet('executable_pool_simple', 'a', toUInt64(1))\r"
expect "1 a"
expect ":) "

sleep 3

# The close must reach the client although the process started above is still running.
send -- "SELECT 'after_close'\r"
expect "Connected to"
expect "after_close"
expect ":) "

send -- "\4"
expect eof

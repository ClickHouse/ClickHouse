-- the generated TTL of the inner samples table
AggregatingMergeTree PARTITION BY toYYYYMM(toDateTime(bucket, \'UTC\')) ORDER BY (id, bucket) TTL toDateTime64(bucket, 0, \'UTC\') + toIntervalSecond(180) GROUP BY id, bucket SET samples = arrayFilter((s, d) -> (d != 0), timeSeriesGroupArray(samples), arrayShiftLeft(arrayDifference(s -> (reinterpret(s.1, \'Int64\') - positiveModulo(reinterpret(s.1, \'Int64\'), 20000)), timeSeriesGroupArray(samples)), 1, 1)), min_time = min(min_time), max_time = max(max_time), toDateTime64(bucket, 0, \'UTC\') + toIntervalSecond(3660) GROUP BY id, bucket SET samples = arrayFilter((s, d) -> (d != 0), timeSeriesGroupArray(samples), arrayShiftLeft(arrayDifference(s -> (reinterpret(s.1, \'Int64\') - positiveModulo(reinterpret(s.1, \'Int64\'), 60000)), timeSeriesGroupArray(samples)), 1, 1)), min_time = min(min_time), max_time = max(max_time) SETTINGS index_granularity = 256, index_granularity_bytes = 524288
-- the stored definition is read back, a copy of the table generates the same TTL
2
-- a copy pinned to a version without buckets of samples does not inherit the setting
1
0
-- a copy pinned to a version without the downsampling setting does not inherit it
1
0
-- the rows past both offsets keep the last sample of each 60 second interval
1970-01-01 00:00:00.000	[('1970-01-01 00:00:59.000',6)]
1970-01-01 00:01:00.000	[('1970-01-01 00:01:30.000',8)]
1970-01-01 00:02:00.000	[('1970-01-01 00:02:11.000',10)]
-- a late sample in a reduced interval is reduced by the next merge
1970-01-01 00:00:00.000	[('1970-01-01 00:00:59.000',6)]
1970-01-01 00:01:00.000	[('1970-01-01 00:01:40.000',0)]
1970-01-01 00:02:00.000	[('1970-01-01 00:02:11.000',10)]
-- a merge of a reduced row keeps it
1970-01-01 00:00:00.000	[('1970-01-01 00:00:59.000',6)]
1970-01-01 00:01:00.000	[('1970-01-01 00:01:40.000',0)]
1970-01-01 00:02:00.000	[('1970-01-01 00:02:11.000',10)]
-- the rows past the first offset only keep the last sample of each 20 second interval
[(19,19),(20,20),(59,59)]
-- the intervals count from the Unix epoch for any type and timezone of the timestamps: the same offsets are kept
[6,13,20,27,34,41,48,55,62,69]
2
[6,13,20,27,34,41,48,55,62,69]
[6,13,20,27,34,41,48,55,62,69]
-- the timestamps keep their full range: a bucket before 1970 is reduced on the epoch grid, a bucket after 2106 is not expired
1969-12-31 23:59:00.000	3	[-41,-21,-1]
2110-01-01 00:00:00.000	60	[4417977600,4417977601,4417977602]
-- sub-millisecond timestamps on either side of an interval boundary both survive
2	[1,2]
2	[1,2]
-- the recent samples table keeps every sample
0

-- Tags: no-parallel-replicas
-- no-parallel-replicas: EXPLAIN ANALYZE rejects distributed plans (NOT_IMPLEMENTED).

-- `EXPLAIN ANALYZE matches = 1` must report the same matched-row counts for the same data whatever
-- the join kind, and `not collected` where an exact count cannot be derived. Hash join family only;
-- the merge and grace algorithms are in `04759_explain_analyze_join_matched_rows_merge_algorithms`.
--
-- 1000 rows per side, keys 0..99 shared: 439 left and 521 right rows match, so a metric falling back
-- to the row count, to zero, or to the other side cannot pass. `right_unique_keys` makes the build
-- promote `ALL` to `RightAny`; `left_small`/`right_small` are the same shape at a tenth of the size.
-- The joins select `count()`: with no right column in the output the probe materializes nothing.

SET enable_analyzer = 1;
-- Swapping the sides moves `columns_added_by_join` and flips which side owns the output filter.
SET query_plan_join_swap_table = 0;
-- A runtime filter would drop non-matching left rows before the probe, changing `Left: rows`.
SET enable_join_runtime_filters = 0;
SET join_use_nulls = 0;

DROP TABLE IF EXISTS left_side;
DROP TABLE IF EXISTS right_dup_keys;
DROP TABLE IF EXISTS right_unique_keys;
DROP TABLE IF EXISTS left_small;
DROP TABLE IF EXISTS right_small;
CREATE TABLE left_side (k UInt64, v UInt64) ENGINE = MergeTree ORDER BY k;
CREATE TABLE right_dup_keys (k UInt64, v UInt64) ENGINE = MergeTree ORDER BY k;
CREATE TABLE right_unique_keys (k UInt64, v UInt64) ENGINE = MergeTree ORDER BY k;
CREATE TABLE left_small (k UInt64, v UInt64) ENGINE = MergeTree ORDER BY k;
CREATE TABLE right_small (k UInt64, v UInt64) ENGINE = MergeTree ORDER BY k;

INSERT INTO left_side SELECT number % 100, number FROM numbers(439);
INSERT INTO left_side SELECT 1000 + number, number FROM numbers(561);
INSERT INTO right_dup_keys SELECT number % 100, number FROM numbers(521);
INSERT INTO right_dup_keys SELECT 2000 + number, number FROM numbers(479);
INSERT INTO right_unique_keys SELECT number, number FROM numbers(100);
INSERT INTO right_unique_keys SELECT 2000 + number, number FROM numbers(479);
INSERT INTO left_small SELECT number % 10, number FROM numbers(50);
INSERT INTO left_small SELECT 1000 + number, number FROM numbers(50);
INSERT INTO right_small SELECT number % 10, number FROM numbers(60);
INSERT INTO right_small SELECT 2000 + number, number FROM numbers(50);

SELECT 'ground truth: rows, matched';
SELECT count(), countIf(k IN (SELECT k FROM right_dup_keys)) FROM left_side;
SELECT count(), countIf(k IN (SELECT k FROM left_side)) FROM right_dup_keys;
SELECT count(), countIf(k IN (SELECT k FROM right_unique_keys)) FROM left_side;
SELECT count(), countIf(k IN (SELECT k FROM left_side)) FROM right_unique_keys;
SELECT count(), countIf(k IN (SELECT k FROM right_small)) FROM left_small;
SELECT count(), countIf(k IN (SELECT k FROM left_small)) FROM right_small;

{% set all_kinds = ['ALL INNER', 'ALL LEFT', 'ALL RIGHT', 'ALL FULL'] -%}
{% set any_kinds = ['ANY INNER', 'ANY LEFT', 'ANY RIGHT'] -%}
{% set semi_anti_kinds = ['SEMI LEFT', 'SEMI RIGHT', 'ANTI LEFT', 'ANTI RIGHT'] -%}
{% set asof_kinds = ['ASOF', 'ASOF LEFT'] -%}

{% set cases = [
    ('hash', "join_algorithm = 'hash'",
        all_kinds + any_kinds + semi_anti_kinds + asof_kinds),

    ('parallel_hash', "join_algorithm = 'parallel_hash', parallel_hash_join_threshold = 1, max_threads = 8",
        all_kinds + any_kinds + semi_anti_kinds + asof_kinds),
] -%}

{% for algo, settings, kinds in cases -%}
SELECT '{{ algo }}';
{% for kind in kinds -%}
SELECT '{{ kind }}' AS kind,
    maxIf(extract(explain, 'matched (not collected|[0-9]+)'), explain LIKE '%Left: rows%') AS matched_left,
    maxIf(extract(explain, 'matched (not collected|[0-9]+)'), explain LIKE '%Right: rows%') AS matched_right
FROM (EXPLAIN ANALYZE matches = 1 SELECT count() FROM left_side AS l {{ kind }} JOIN right_dup_keys AS r ON l.k = r.k{% if kind.startswith('ASOF') %} AND l.v >= r.v{% endif %} SETTINGS {{ settings }});
{% endfor -%}
{% endfor -%}

-- `any_join_distinct_right_table_keys` is the only way to reach `RightAny`, including `FULL RightAny`,
-- which a plain `ANY FULL JOIN` cannot express.
SELECT 'RightAny';
{% for kind in ['ANY INNER', 'ANY LEFT', 'ANY RIGHT', 'ANY FULL'] -%}
SELECT '{{ kind }}' AS kind,
    maxIf(extract(explain, 'matched (not collected|[0-9]+)'), explain LIKE '%Left: rows%') AS matched_left,
    maxIf(extract(explain, 'matched (not collected|[0-9]+)'), explain LIKE '%Right: rows%') AS matched_right
FROM (EXPLAIN ANALYZE matches = 1 SELECT count() FROM left_side AS l {{ kind }} JOIN right_dup_keys AS r ON l.k = r.k SETTINGS join_algorithm = 'hash', any_join_distinct_right_table_keys = 1);
{% endfor -%}

-- `ALL` promoted to `RightAny` by the build must still be counted as `ALL`, the maps are `MapsAll`.
SELECT 'unique right keys';
{% for kind in ['ALL INNER', 'ALL LEFT'] -%}
SELECT '{{ kind }}' AS kind,
    maxIf(extract(explain, 'matched (not collected|[0-9]+)'), explain LIKE '%Left: rows%') AS matched_left,
    maxIf(extract(explain, 'matched (not collected|[0-9]+)'), explain LIKE '%Right: rows%') AS matched_right
FROM (EXPLAIN ANALYZE matches = 1 SELECT count() FROM left_side AS l {{ kind }} JOIN right_unique_keys AS r ON l.k = r.k SETTINGS join_algorithm = 'hash');
{% endfor -%}

-- One output row per chunk exercises the per-chunk ref bookkeeping. It costs a chunk per output row,
-- hence the smaller tables; `max_joined_block_size_rows` must stay below the right rows per key,
-- otherwise a left row fits in one chunk and nothing is split.
SELECT 'single-row chunks';
{% for kind in all_kinds -%}
SELECT '{{ kind }}' AS kind,
    maxIf(extract(explain, 'matched (not collected|[0-9]+)'), explain LIKE '%Left: rows%') AS matched_left,
    maxIf(extract(explain, 'matched (not collected|[0-9]+)'), explain LIKE '%Right: rows%') AS matched_right
FROM (EXPLAIN ANALYZE matches = 1 SELECT count() FROM left_small AS l {{ kind }} JOIN right_small AS r ON l.k = r.k SETTINGS joined_block_split_single_row = 1, max_joined_block_size_rows = 1);
{% endfor -%}

-- A residual `ON` condition routes the probe through a separate loop. `l.v + 1000 >= r.v` holds for
-- every equal-key pair, so the counts stay the same.
SELECT 'residual condition';
{% for kind in ['ALL LEFT', 'ALL RIGHT', 'ALL FULL'] -%}
SELECT '{{ kind }}' AS kind,
    maxIf(extract(explain, 'matched (not collected|[0-9]+)'), explain LIKE '%Left: rows%') AS matched_left,
    maxIf(extract(explain, 'matched (not collected|[0-9]+)'), explain LIKE '%Right: rows%') AS matched_right
FROM (EXPLAIN ANALYZE matches = 1 SELECT count() FROM left_side AS l {{ kind }} JOIN right_dup_keys AS r ON l.k = r.k AND l.v + 1000 >= r.v SETTINGS join_algorithm = 'hash');
{% endfor -%}

-- With a right column in the output the refs are recorded for materialization anyway.
SELECT 'right column in the output';
{% for kind in ['ALL INNER', 'ALL LEFT', 'ALL FULL'] -%}
SELECT '{{ kind }}' AS kind,
    maxIf(extract(explain, 'matched (not collected|[0-9]+)'), explain LIKE '%Left: rows%') AS matched_left,
    maxIf(extract(explain, 'matched (not collected|[0-9]+)'), explain LIKE '%Right: rows%') AS matched_right
FROM (EXPLAIN ANALYZE matches = 1 SELECT sum(r.v) FROM left_side AS l {{ kind }} JOIN right_dup_keys AS r ON l.k = r.k SETTINGS join_algorithm = 'hash');
{% endfor -%}

DROP TABLE left_side;
DROP TABLE right_dup_keys;
DROP TABLE right_unique_keys;
DROP TABLE left_small;
DROP TABLE right_small;

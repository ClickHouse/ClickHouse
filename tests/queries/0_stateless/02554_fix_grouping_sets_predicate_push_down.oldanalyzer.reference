---Explain Syntax---
SELECT\n    day_,\n    type_1\nFROM\n(\n    SELECT\n        day_,\n        if(equals(type_1, \'\'), \'all\', type_1) AS type_1\n    FROM\n    (\n        SELECT\n            day_,\n            type_1\n        FROM test_grouping_sets_predicate\n        WHERE equals(day_, \'2023-01-05\')\n        GROUP BY\n            GROUPING SETS (\n                (day_, type_1),\n                (day_))\n        HAVING equals(if(equals(type_1, \'\'), \'all\', type_1), \'all\')\n    ) AS t\n    WHERE equals(if(equals(type_1, \'\'), \'all\', type_1) AS type_1, \'all\')\n)\nWHERE equals(type_1, \'all\')


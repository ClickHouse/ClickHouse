=== a lengthless POST with a pipelined request smuggled as the unread body gets one response and a closed connection ===
responses: 1
status-200: 1
connection-close: 1
smuggled-query-executed: False
timed-out: False
=== same for PUT ===
responses: 1
status-200: 1
connection-close: 1
smuggled-query-executed: False
timed-out: False
=== control: with Content-Length the connection stays reusable for a second request ===
responses: 2
status-200: 2
first-response-closed: False

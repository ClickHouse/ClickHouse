#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# Regression test for a serialized query plan whose `ActionsDAG` has a `COLUMN` node without a value.
#
# With `process_query_plan_packet` enabled, a client can send a `QueryPlan` packet. A `COLUMN` node
# carries its constant value only when bit 0 of its column flags is set. `ActionsDAG::deserialize`
# accepted a `COLUMN` node with the bit clear, and building the header of the `Expression` step
# then dereferenced the missing column. Such a plan must be rejected with INCORRECT_DATA (code 117),
# and the server must stay alive.
#
# The client speaks the raw native protocol pinned to revision 54482, so the set of exchanged,
# revision-gated fields is fixed and does not drift.

import os
import socket
import uuid

CLICKHOUSE_HOST = os.environ.get("CLICKHOUSE_HOST", "127.0.0.1")
CLICKHOUSE_PORT = int(os.environ.get("CLICKHOUSE_PORT_TCP", "9000"))
CLICKHOUSE_DATABASE = os.environ.get("CLICKHOUSE_DATABASE", "default")
CLIENT_NAME = "serialized plan column without value"

REVISION = 54482

STAGE_QUERY_PLAN = 7
PACKET_QUERY_PLAN = 13
PACKET_DATA = 2

BINARY_TYPE_UINT8 = 0x01

# ActionsDAG::ActionType
ACTION_COLUMN = 1


def writeVarUInt(x, ba):
    for _ in range(0, 9):
        byte = x & 0x7F
        if x > 0x7F:
            byte |= 0x80
        ba.append(byte)
        x >>= 7
        if x == 0:
            return


def writeStringBinary(s, ba):
    b = bytes(s, "utf-8") if isinstance(s, str) else s
    writeVarUInt(len(b), ba)
    ba.extend(b)


def readStrict(s, size=1):
    res = bytearray()
    while size:
        cur = s.recv(size)
        if not cur:
            raise EOFError("Connection closed by server")
        size -= len(cur)
        res.extend(cur)
    return res


def readUInt(s, size=1):
    res = readStrict(s, size)
    val = 0
    for i in range(len(res)):
        val += res[i] << (i * 8)
    return val


def readUInt32(s):
    return readUInt(s, 4)


def readVarUInt(s):
    x = 0
    for i in range(9):
        byte = readStrict(s)[0]
        x |= (byte & 0x7F) << (7 * i)
        if not byte & 0x80:
            return x
    return x


def readStringBinary(s):
    size = readVarUInt(s)
    return readStrict(s, size).decode("utf-8")


def sendHello(s):
    ba = bytearray()
    writeVarUInt(0, ba)  # Hello
    writeStringBinary(CLIENT_NAME, ba)
    writeVarUInt(24, ba)  # major
    writeVarUInt(9, ba)  # minor
    writeVarUInt(REVISION, ba)
    writeStringBinary(CLICKHOUSE_DATABASE, ba)  # database
    writeStringBinary("default", ba)  # user
    writeStringBinary("", ba)  # password
    s.sendall(ba)


def receiveHello(s):
    """Returns the query plan serialization version advertised by the server."""
    assert readVarUInt(s) == 0  # Hello
    readStringBinary(s)  # server name
    readVarUInt(s)  # major
    readVarUInt(s)  # minor
    readVarUInt(s)  # revision
    readVarUInt(s)  # parallel replicas protocol version (>= 54471)
    readStringBinary(s)  # timezone (>= 54058)
    readStringBinary(s)  # display name (>= 54372)
    readVarUInt(s)  # version patch (>= 54401)
    readStringBinary(s)  # proto_send chunked (>= 54470)
    readStringBinary(s)  # proto_recv chunked (>= 54470)
    for _ in range(readVarUInt(s)):  # password complexity rules (>= 54461)
        readStringBinary(s)
        readStringBinary(s)
    readStrict(s, 8)  # nonce, UInt64 (>= 54462)
    # Server settings in STRINGS_WITH_FLAGS format: (name, flags, value)* terminated
    # by an empty name (>= 54474).
    while True:
        if readStringBinary(s) == "":  # setting name
            break
        readVarUInt(s)  # flags
        readStringBinary(s)  # value
    query_plan_version = readVarUInt(s)  # query plan serialization version (>= 54477)
    readVarUInt(s)  # cluster function protocol version (>= 54479)
    return query_plan_version


def sendAddendum(s):
    ba = bytearray()
    writeStringBinary("", ba)  # quota key (>= 54458)
    writeStringBinary("notchunked", ba)  # proto_send chunked (>= 54470)
    writeStringBinary("notchunked", ba)  # proto_recv chunked (>= 54470)
    writeVarUInt(0, ba)  # parallel replicas protocol version (>= 54471)
    s.sendall(ba)


def serializeClientInfo(ba, query_id):
    ba.append(1)  # INITIAL_QUERY
    writeStringBinary("default", ba)  # initial_user
    writeStringBinary(query_id, ba)  # initial_query_id
    writeStringBinary("127.0.0.1:9000", ba)  # initial_address
    ba.extend([0] * 8)  # initial_query_start_time_microseconds (>= 54449)
    ba.append(1)  # interface = TCP
    writeStringBinary("os_user", ba)
    writeStringBinary("client_hostname", ba)
    writeStringBinary(CLIENT_NAME, ba)
    writeVarUInt(24, ba)  # client major
    writeVarUInt(9, ba)  # client minor
    writeVarUInt(REVISION, ba)  # client tcp protocol version
    writeStringBinary("", ba)  # quota key (>= 54060)
    writeVarUInt(0, ba)  # distributed_depth (>= 54448)
    writeVarUInt(1, ba)  # client version patch (>= 54401)
    ba.append(0)  # opentelemetry: no trace id (>= 54442)
    writeVarUInt(0, ba)  # parallel replicas: collaborate_with_initiator (>= 54453)
    writeVarUInt(0, ba)  # parallel replicas: obsolete count
    writeVarUInt(0, ba)  # parallel replicas: number_of_current_replica
    writeVarUInt(0, ba)  # script query number (>= 54475)
    writeVarUInt(0, ba)  # script line number (>= 54475)
    ba.append(0)  # jwt: none (>= 54476)


def sendQuery(s, query):
    ba = bytearray()
    query_id = uuid.uuid4().hex
    writeVarUInt(1, ba)  # Query
    writeStringBinary(query_id, ba)
    serializeClientInfo(ba, query_id)
    writeStringBinary("", ba)  # empty per-query settings
    writeStringBinary("", ba)  # interserver externally granted roles (>= 54472)
    writeStringBinary("", ba)  # interserver secret (>= 54441)
    writeVarUInt(STAGE_QUERY_PLAN, ba)
    ba.append(0)  # no compression
    writeStringBinary(query, ba)
    writeStringBinary("", ba)  # query parameters terminator (>= 54459)
    s.sendall(ba)


def readException(s):
    code = readUInt32(s)
    readStringBinary(s)  # name
    text = readStringBinary(s)
    readStringBinary(s)  # trace
    readStrict(s)  # has_nested
    return code, text


def expectIncorrectData(s, must_contain):
    packet_type = readVarUInt(s)
    assert packet_type == 2, "Expected Exception packet, got {}".format(packet_type)
    code, text = readException(s)
    assert code == 117, "Expected INCORRECT_DATA (117), got {}: {}".format(code, text)
    assert must_contain in text, text


def sendEmptyBlock(s):
    ba = bytearray()
    writeVarUInt(PACKET_DATA, ba)
    writeStringBinary("", ba)  # external table name
    writeVarUInt(1, ba)  # block info field 1
    ba.append(0)  # is_overflows = false
    writeVarUInt(2, ba)  # block info field 2
    ba.extend((-1).to_bytes(4, "little", signed=True))  # bucket_num = -1
    writeVarUInt(0, ba)  # end of block info
    writeVarUInt(0, ba)  # columns
    writeVarUInt(0, ba)  # rows
    s.sendall(ba)


def queryPlanPacket(query_plan_version, dag_node):
    """A plan `Expression(ReadNothing)` whose DAG has the single node `dag_node`, which is also its output."""
    ba = bytearray()
    writeVarUInt(PACKET_QUERY_PLAN, ba)
    writeVarUInt(query_plan_version, ba)
    writeVarUInt(0, ba)  # max_threads
    ba.append(0)  # concurrency_control

    writeVarUInt(1, ba)  # children of the root step

    # ReadNothing with an empty header.
    writeVarUInt(0, ba)  # children
    writeStringBinary("ReadNothing", ba)
    writeVarUInt(0, ba)  # step version
    writeStringBinary("", ba)  # step description
    writeVarUInt(0, ba)  # header columns
    writeStringBinary("", ba)  # step settings terminator

    # Expression producing one UInt8 column `y`.
    writeStringBinary("Expression", ba)
    writeVarUInt(0, ba)  # step version
    writeStringBinary("", ba)  # step description
    writeVarUInt(1, ba)  # header columns
    writeStringBinary("y", ba)
    ba.append(BINARY_TYPE_UINT8)
    writeStringBinary("", ba)  # step settings terminator

    writeVarUInt(1, ba)  # DAG nodes
    ba.extend(dag_node)
    writeVarUInt(0, ba)  # DAG inputs
    writeVarUInt(1, ba)  # DAG outputs
    writeVarUInt(0, ba)  # output node id

    writeVarUInt(0, ba)  # sets
    return bytes(ba)


def dagNode(action_type, column_flags):
    ba = bytearray()
    ba.append(action_type)
    writeStringBinary("y", ba)  # result name
    ba.append(BINARY_TYPE_UINT8)  # result type
    writeVarUInt(0, ba)  # children
    ba.append(column_flags)
    return bytes(ba)


def runScenario(name, dag_node, must_contain):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(30)
        s.connect((CLICKHOUSE_HOST, CLICKHOUSE_PORT))
        sendHello(s)
        query_plan_version = receiveHello(s)
        sendAddendum(s)
        sendQuery(s, "SELECT 1")
        s.sendall(queryPlanPacket(query_plan_version, dag_node))
        sendEmptyBlock(s)
        expectIncorrectData(s, must_contain)
        print("{}: caught expected exception INCORRECT_DATA".format(name))


def main():
    # The reported vector: a COLUMN node with the "column is present" flag clear.
    runScenario(
        "column without value",
        dagNode(ACTION_COLUMN, 0),
        "Deserialized column y has no value",
    )

    # An action type that `serialize` never writes.
    runScenario(
        "unknown action type",
        dagNode(200, 0),
        "Unknown action type 200",
    )


if __name__ == "__main__":
    main()

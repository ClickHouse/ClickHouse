# With the `aiGenerate` function of the server as the model backend, the model answers with text,
# and a tool call is a block of that text. So that a block the model does not mean as a call - an
# example of the syntax, a block of a query result it repeats - is not run, the tags of a call
# carry a random token of the conversation, which the model gets in the system prompt:
# `<tool_call-TOKEN>{...}</tool_call-TOKEN>`. A bare `<tool_call>` block is a part of the text.
#
# Here the mock provider answers the first request with both kinds of blocks: a bare one for one
# schema tool and one with the token for another. Only the second one is a call, so the next
# request carries one tool result, and the bare block is in the transcript as quoted text.
import json
import os
import pty
import re
import select
import shlex
import signal
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, HTTPServer

TIMEOUT_SECONDS = 120

# How long a client may take to end after its terminal was closed, before it is killed.
TEARDOWN_SECONDS = 30

# `clickhouse-test` prints this file when the test fails, and it names it after the test case -
# the `.sh` wrapper - not after this script. Writing anywhere else means the trace of a failure in
# CI is collected and then never shown, which is the only record of what the client did.
DEBUG_LOG = os.path.join(
    os.environ["CLICKHOUSE_TMP"],
    os.path.basename(os.path.abspath(__file__)).removesuffix(".python") + ".sh.debuglog",
)

# Set when the pseudo-terminal reaches end of file: the client is gone. Every later read then
# returns at once and every write is silently discarded, so without noticing it the test runs to
# the end and reports every expectation as unmet, saying nothing about the client having died.
client_gone = False

FINAL_ANSWER = "MOCK-DONE"

COLLECTION = "ai_call_token_nc"

# A bare block, which the transcript of the next request holds as quoted text: `<` and `>` of a
# text the transport did not write itself are entities there.
BARE_BLOCK = '<tool_call>{"name": "list_tables", "arguments": {"database": "system"}}</tool_call>'
BARE_BLOCK_QUOTED = '&lt;tool_call&gt;{"name": "list_tables", "arguments": {"database": "system"}}&lt;/tool_call&gt;'


def strings_of(value):
    """Every string of the request, whatever its layout: the system prompt and the transcript."""
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for item in value.values():
            yield from strings_of(item)
    elif isinstance(value, list):
        for item in value:
            yield from strings_of(item)


class Handler(BaseHTTPRequestHandler):
    """A mock OpenAI-compatible provider, reached by `aiGenerate` on the server side."""

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        raw = self.rfile.read(length).decode(errors="replace")
        try:
            text = "\n".join(strings_of(json.loads(raw)))
        except ValueError:
            text = raw

        token = re.search(r"<tool_call-([0-9a-f]+)>", text)
        # The entries of the transcript with the results of the calls. The text of the user and
        # the results themselves are indented there, so they cannot begin a line with it.
        tool_results = len(re.findall(r"^Tool result \[call_\d+\]:", text, flags=re.MULTILINE))

        self.server.requests += 1
        if token is None:
            self.server.token_in_prompt = False
            content = FINAL_ANSWER
        elif tool_results == 0:
            content = (
                "An example of the syntax, which is not a call:\n"
                + BARE_BLOCK
                + "\n"
                + f'<tool_call-{token.group(1)}>{{"name": "list_databases", "arguments": {{}}}}</tool_call-{token.group(1)}>'
            )
        else:
            self.server.tool_results = tool_results
            self.server.bare_block_is_quoted_text = BARE_BLOCK_QUOTED in text
            content = FINAL_ANSWER

        body = json.dumps(
            {
                "id": "chatcmpl-1",
                "object": "chat.completion",
                "created": 1,
                "model": "chat-model",
                "choices": [
                    {
                        "index": 0,
                        "message": {"role": "assistant", "content": content},
                        "finish_reason": "stop",
                    }
                ],
                "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2},
            }
        ).encode()

        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


def read_until(master, debug_log_fd, predicate, timeout):
    global client_gone
    output = ""
    deadline = time.time() + timeout
    while time.time() < deadline:
        r, _, _ = select.select([master], [], [], 0.3)
        if not r:
            continue
        try:
            chunk = os.read(master, 65536)
        except OSError:
            client_gone = True
            break
        if not chunk:
            client_gone = True
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()
        output += chunk.decode(errors="replace")
        if predicate(output):
            return output
    return output


def report_client_if_gone(child_pid):
    """Print how the client ended if it is gone. The expected output has no such line, so it
    shows up in the diff of the failure instead of leaving only unmet expectations behind."""
    if not client_gone:
        return
    try:
        _, status = os.waitpid(child_pid, os.WNOHANG)
    except ChildProcessError:
        print("client_gone: already reaped")
        return
    if os.WIFSIGNALED(status):
        print(f"client_gone: killed by signal {os.WTERMSIG(status)}")
    elif os.WIFEXITED(status):
        print(f"client_gone: exited with code {os.WEXITSTATUS(status)}")
    else:
        print("client_gone: yes")


def wait_for_client(child_pid):
    """Wait for the client to end after its terminal was closed, and make sure it is gone."""
    deadline = time.time() + TEARDOWN_SECONDS
    while time.time() < deadline:
        try:
            reaped, _ = os.waitpid(child_pid, os.WNOHANG)
        except ChildProcessError:
            return
        if reaped == child_pid:
            return
        time.sleep(0.05)
    try:
        os.kill(child_pid, signal.SIGKILL)
        os.waitpid(child_pid, 0)
    except (ChildProcessError, ProcessLookupError):
        pass


def main():
    server = HTTPServer(("127.0.0.1", 0), Handler)
    server.requests = 0
    server.token_in_prompt = True
    server.tool_results = None
    server.bare_block_is_quoted_text = None
    threading.Thread(target=server.serve_forever, daemon=True).start()

    base = shlex.split(os.environ["CLICKHOUSE_LOCAL"])
    path = os.path.join(os.environ["CLICKHOUSE_TMP"], "05896_local_db")
    common = ["--history_file=/dev/null", "--path", path]

    # The credentials the server-side function resolves are a named collection, created in the
    # same `--path` the session below opens.
    subprocess.run(
        base
        + common
        + [
            "--query",
            f"CREATE NAMED COLLECTION IF NOT EXISTS {COLLECTION} AS provider = 'openai', "
            f"endpoint = 'http://127.0.0.1:{server.server_port}/v1/chat/completions', "
            "model = 'chat-model', api_key = 'fake-key'",
        ],
        check=True,
    )

    # There is no client-side provider here - no `ai` section in the configuration and no API key
    # in the environment - so the model is reached through the server-side function.
    argv = base + common + [f"--ai_function_text_default_credentials={COLLECTION}"]

    child_pid, master = pty.fork()
    if child_pid == 0:
        os.environ["TERM"] = "xterm"
        # A key in the environment would be inferred into a client-side provider, and the
        # server-side function would never be reached.
        os.environ.pop("OPENAI_API_KEY", None)
        os.environ.pop("ANTHROPIC_API_KEY", None)
        os.execv(argv[0], argv)
        return

    debug_log_fd = open(DEBUG_LOG, "a")
    try:
        read_until(master, debug_log_fd, lambda o: ":)" in o, TIMEOUT_SECONDS)
        os.write(master, b"? list the databases\n")
        output = read_until(master, debug_log_fd, lambda o: FINAL_ANSWER in o, TIMEOUT_SECONDS)
        report_client_if_gone(child_pid)

        print("answered:", "yes" if FINAL_ANSWER in output else "no")
        print("token of the conversation in the prompt:", "yes" if server.token_in_prompt else "no")
        print("calls run in the first step:", server.tool_results)
        print("bare block is quoted text of the transcript:", server.bare_block_is_quoted_text)
        print("requests to the model:", server.requests)
    finally:
        # The client is in AI-chat mode after the question, where `exit` is a question as well,
        # so it is ended by closing its terminal rather than by typing anything.
        os.close(master)
        debug_log_fd.close()
        wait_for_client(child_pid)
        server.shutdown()


if __name__ == "__main__":
    main()

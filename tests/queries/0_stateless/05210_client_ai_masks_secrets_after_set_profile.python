# The result of a query the agent runs with the user's confirmation is fed back to the model, so a
# `SHOW CREATE TABLE` of an external-engine table would hand the credentials of its connection to
# the AI provider in a session that displays secrets. The client therefore turns the display off
# for the query - but only for a session that really does display them, which it has to establish
# first.
#
# It used to establish it from its own settings whenever `apply_settings_from_server = 1`, on the
# grounds that the settings of the server reach such a client anyway. A `SET profile` does not: the
# server applies the profile without reporting its settings back, so after one the local value is
# stale in exactly the direction that matters, and the client concluded "this session does not
# display secrets" for a session that does. The cached answer of the server had the same hole: it
# was asked once and kept across the profile switch.
#
# So the session here asks the agent twice: once before the profile is applied, which is what makes
# the client ask the server and cache the answer, and once after it. The second query reports the
# value of `format_display_secrets_in_show_and_select` it actually ran under, which must be off.
import json
import os
import pty
import select
import shlex
import signal
import termios
import threading
import time
from http.server import BaseHTTPRequestHandler, HTTPServer

TIMEOUT_SECONDS = 120

# The two waits around the switch back to SQL mode: a prompt repaint and a `SET`, both immediate.
# They get a much shorter budget than a turn of the model, so that a backspace lost after all
# reports what it did to the session instead of spending the whole budget of the test twice over
# and failing as "runs too long" - which says nothing about the client.
MODE_SWITCH_TIMEOUT_SECONDS = 30

# How long a client may take to end after its terminal was closed, before it is killed.
TEARDOWN_SECONDS = 30

# `clickhouse-test` prints this file when the test fails, and it names it after the test case -
# the `.sh` wrapper - not after this script. Writing anywhere else means the trace of a failure in
# CI is collected and then never shown, which is the only record of what the client did.
DEBUG_LOG = os.path.join(
    os.environ["CLICKHOUSE_TMP"],
    os.path.basename(os.path.abspath(__file__)).removesuffix(".python") + ".sh.debuglog",
)

# Set when the pseudo-terminal reaches end of file: the client is gone. Every later read then
# returns at once and every write is silently discarded, so without noticing it the test runs to
# the end and reports every expectation as unmet, saying nothing about the client having died.
client_gone = False

FINAL_ANSWER = "MOCK-DONE"

PROFILE = os.environ["CLICKHOUSE_AI_TEST_PROFILE"]

# The marker is built by the query, so the value below is the one the query ran under and not a
# fragment of the query text echoed back in the summary the tool returns.
MARKER = "secrets-displayed-"
PROBE = f"SELECT concat('{MARKER}', toString(toUInt8(getSetting('format_display_secrets_in_show_and_select'))))"

# One confirmed `run_query` call per turn. The first one is not an assertion about secrets: it is
# what makes the client ask the server about the setting and cache the answer, so that the second
# turn has a cached pre-profile answer to get wrong.
CASES = [
    ("before_profile", "SELECT 1"),
    ("after_profile", PROBE),
]


class Handler(BaseHTTPRequestHandler):
    """A mock OpenAI-compatible provider. It answers with one `run_query` tool call per turn and
    finishes each turn with a plain text message.

    The call has to be the only one of its turn, and the turn - not the whole conversation, which
    is kept across `?` invocations - is what the case is keyed on. Counting the tool results of the
    whole history instead makes the agent run every case in the first turn, one call after the
    other, because it asks again as soon as a result comes back; the profile is then applied while
    the client is waiting for a confirmation, the answer to it is read as a `y`/`n` and the whole
    test passes without ever reaching the case it is about."""

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        request = json.loads(self.rfile.read(length))
        self.server.last_request = request

        messages = request["messages"]
        turn = sum(1 for m in messages if m.get("role") == "user")
        last_question = max(i for i, m in enumerate(messages) if m.get("role") == "user")
        answered = any(m.get("role") == "tool" for m in messages[last_question:])

        if not answered and 0 < turn <= len(CASES):
            name, query = CASES[turn - 1]
            message = {
                "role": "assistant",
                "content": None,
                "tool_calls": [
                    {
                        "id": f"call_{name}",
                        "type": "function",
                        "function": {"name": "run_query", "arguments": json.dumps({"query": query})},
                    }
                ],
            }
            finish_reason = "tool_calls"
        else:
            message = {"role": "assistant", "content": FINAL_ANSWER}
            finish_reason = "stop"

        body = json.dumps(
            {
                "id": "chatcmpl-1",
                "object": "chat.completion",
                "created": 1,
                "model": "gpt-4o",
                "choices": [{"index": 0, "message": message, "finish_reason": finish_reason}],
                "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2},
            }
        ).encode()

        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


def make_config(port):
    """A client configuration that points the AI agent at the mock provider. The credentials come
    from the configuration and not from the environment, so the agent does not ask for the
    confirmation of using an API key found there."""
    path = os.path.join(
        os.environ["CLICKHOUSE_TMP"],
        os.path.basename(os.path.abspath(__file__)).removesuffix(".python") + ".config.xml",
    )
    with open(path, "w") as f:
        f.write(
            "<clickhouse><ai>"
            "<provider>openai</provider>"
            "<api_key>mock-key</api_key>"
            f"<base_url>http://127.0.0.1:{port}/v1</base_url>"
            "<model>gpt-4o</model>"
            f"<max_steps>{len(CASES) + 5}</max_steps>"
            "</ai></clickhouse>"
        )
    return path


def client_argv(config):
    """The interactive client of the test environment. The configuration file of the environment is
    replaced by the one of the mock provider rather than added to it: the client accepts one."""
    argv = shlex.split(os.environ["CLICKHOUSE_CLIENT_BINARY"])
    for option in shlex.split(os.environ["CLICKHOUSE_CLIENT_EXPECT_OPT"]):
        if option.startswith("--config-file"):
            continue
        argv.append(option)
    return argv + [f"--config-file={config}", "--history_file=/dev/null"]


def drain(master, debug_log_fd, idle):
    global client_gone
    while True:
        r, _, _ = select.select([master], [], [], idle)
        if not r:
            break
        try:
            chunk = os.read(master, 65536)
        except OSError:
            client_gone = True
            break
        if not chunk:
            client_gone = True
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()


def wait_for_line_editor(master, timeout=TIMEOUT_SECONDS):
    """Wait until the client is reading a line, which is the only state in which a control
    character typed into its terminal reaches it.

    While a query runs, the terminal is in the raw mode of `TerminalKeystrokeInterceptor`, whose
    thread reads and swallows what is typed; the interceptor then leaves that mode with
    `tcsetattr(TCSAFLUSH)`, which discards whatever is still unread; and in the canonical mode
    that follows, the line discipline of the terminal handles the backspace below itself - it is
    the `ERASE` character, the line it would erase from is empty, so it is dropped there as well.
    Only a backspace typed while `replxx` reads a line is both kept and delivered.

    The three states are told apart by `VMIN` and `VTIME`: the interceptor sets them to 0 and 1,
    `replxx` to 1 and 0, and the canonical mode keeps `ICANON` on. A build slow enough to still be
    in one of the first two when the answer of the model is already printed loses the backspace,
    stays in AI chat mode, sends the statement that follows to the model as a question, and runs
    both waits after it into their timeouts - which is what this test did in CI."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        attributes = termios.tcgetattr(master)
        reading = not attributes[3] & termios.ICANON
        reading = reading and attributes[6][termios.VMIN] == 1 and attributes[6][termios.VTIME] == 0
        if reading:
            return True
        time.sleep(0.01)
    return False


def read_until(master, debug_log_fd, predicate, timeout):
    global client_gone
    output = ""
    deadline = time.time() + timeout
    while time.time() < deadline:
        r, _, _ = select.select([master], [], [], 0.3)
        if not r:
            continue
        try:
            chunk = os.read(master, 65536)
        except OSError:
            client_gone = True
            break
        if not chunk:
            client_gone = True
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()
        output += chunk.decode(errors="replace")
        if predicate(output):
            return output
    return output


def report_client_if_gone(child_pid):
    """Print how the client ended if it is gone, so a client that died shows up in the diff of the
    failure instead of leaving only unmet expectations behind."""
    if not client_gone:
        return
    try:
        _, status = os.waitpid(child_pid, os.WNOHANG)
    except ChildProcessError:
        print("client_gone: already reaped")
        return
    if os.WIFSIGNALED(status):
        print(f"client_gone: killed by signal {os.WTERMSIG(status)}")
    elif os.WIFEXITED(status):
        print(f"client_gone: exited with code {os.WEXITSTATUS(status)}")
    else:
        print("client_gone: yes")


def wait_for_client(child_pid):
    """Wait for the client to end after its terminal was closed, and make sure it is gone."""
    deadline = time.time() + TEARDOWN_SECONDS
    while time.time() < deadline:
        try:
            reaped, _ = os.waitpid(child_pid, os.WNOHANG)
        except ChildProcessError:
            return
        if reaped == child_pid:
            return
        time.sleep(0.05)
    try:
        os.kill(child_pid, signal.SIGKILL)
        os.waitpid(child_pid, 0)
    except (ChildProcessError, ProcessLookupError):
        pass


def ask_agent(master, debug_log_fd, question):
    """Ask one question and confirm the query the agent wants to run. The turn ends with the text
    answer of the model, which is what says the tool result is already in the history."""
    os.write(master, b"?" + question.encode() + b"\n")
    read_until(master, debug_log_fd, lambda o: "Run this query?" in o, TIMEOUT_SECONDS)
    os.write(master, b"y\n")
    read_until(master, debug_log_fd, lambda o: FINAL_ANSWER in o, TIMEOUT_SECONDS)


def run_session(server, config):
    """Drive one interactive session: ask the agent, apply the profile, ask it again. Returns the
    results of the tool calls of the last request, keyed by the id of the call."""
    global client_gone
    client_gone = False
    server.last_request = {}

    argv = client_argv(config)
    child_pid, master = pty.fork()
    if child_pid == 0:
        os.environ["TERM"] = "xterm"
        # An API key in the environment would take precedence over the configured mock provider.
        os.environ.pop("OPENAI_API_KEY", None)
        os.environ.pop("ANTHROPIC_API_KEY", None)
        os.execv(argv[0], argv)
        return {}

    debug_log_fd = open(DEBUG_LOG, "a")
    try:
        read_until(master, debug_log_fd, lambda o: ":)" in o, TIMEOUT_SECONDS)
        ask_agent(master, debug_log_fd, " look around")

        # A backspace on the empty AI-chat line leaves the mode and restores the SQL prompt, which
        # is the only way back: in AI-chat mode a line is a question and not a query. The profile
        # has to be applied by the user, because that is what a `SET profile` the client does not
        # see is - the agent is not allowed to change the session either way.
        wait_for_line_editor(master)
        os.write(master, b"\x7f")
        # Which mode the client is in is what the prompt painted LAST says: when a turn ends the
        # client paints the SQL prompt and repaints it as the AI one right away, so a wait for the
        # SQL prompt alone can match that stale paint and return before the backspace was even
        # processed.
        read_until(
            master,
            debug_log_fd,
            lambda o: o.rfind(":)") > o.rfind(":?"),
            MODE_SWITCH_TIMEOUT_SECONDS,
        )
        os.write(master, f"SET profile = '{PROFILE}'\n".encode())
        # Both the answer and the prompt that follows it: the next question must not be typed
        # before the client is reading a line again.
        applied = read_until(
            master,
            debug_log_fd,
            lambda o: "Ok." in o and ":)" in o.split("Ok.", 1)[1],
            MODE_SWITCH_TIMEOUT_SECONDS,
        )
        # The test is about the session the profile changed. A statement that reached the model
        # instead of the server leaves the session as it was, and the check of the second turn
        # then holds for a session where the secrets were never turned on - a pass that asserts
        # nothing. Say it here, so that such a run is a failure and names its reason.
        print("profile:", "applied" if "Ok." in applied else "NOT APPLIED")

        ask_agent(master, debug_log_fd, " look again")
        report_client_if_gone(child_pid)
        return collect(server.last_request)
    finally:
        # There is no way to type an exit: the client is in AI-chat mode again, where a line is a
        # question for the agent and not a command. Closing the terminal is what ends the client.
        drain(master, debug_log_fd, 1.0)
        os.close(master)
        debug_log_fd.close()
        wait_for_client(child_pid)


def collect(request):
    """The results of the tool calls of the request, keyed by the id of the call."""
    results = {}
    for message in request.get("messages", []):
        if message.get("role") == "tool":
            results[message.get("tool_call_id")] = str(message.get("content"))
    return results


def outcome(name, answer):
    """What the tool reported for one case: whether it ran at all, and - for the probe - the value
    of the setting the query ran under."""
    if answer is None:
        return "NO RESULT"
    if '"success":true' not in answer.replace(" ", ""):
        return f"NOT RUN {answer[:200]}"
    if name == "before_profile":
        return "OK"
    if f"{MARKER}0" in answer:
        return "masked"
    if f"{MARKER}1" in answer:
        return "UNMASKED"
    return f"UNEXPECTED {answer[:500]}"


def main():
    server = HTTPServer(("127.0.0.1", 0), Handler)
    server.last_request = {}
    threading.Thread(target=server.serve_forever, daemon=True).start()
    config = make_config(server.server_port)

    try:
        results = run_session(server, config)
        for name, _ in CASES:
            print(f"{name}: {outcome(name, results.get(f'call_{name}'))}")
    finally:
        server.shutdown()


if __name__ == "__main__":
    main()

-- Tags: no-fasttest, no-msan
-- no-fasttest, no-msan: the Vortex format is not included in the fast test and MSan builds
-- The input format readers convert a column to the requested type with one shared function: named tuple elements
-- are matched by name, a missing element or column gets the default of its type, NULLs are paired by name, and the
-- value of a NULL row is never converted: the row gets the default of the requested type.

SET engine_file_truncate_on_insert = 1;

{% set ci = 'input_format_parquet_case_insensitive_column_matching = 1, input_format_orc_case_insensitive_column_matching = 1, input_format_arrow_case_insensitive_column_matching = 1' -%}
{% for format in ['Parquet', 'ORC', 'Arrow', 'Vortex'] -%}
SELECT '{{ format }}';
INSERT INTO FUNCTION file(currentDatabase() || '_05618.{{ format }}', '{{ format }}') SELECT
    number AS id,
    CAST((toInt32(number), if(number = 0, NULL, toInt32(number + 10))), 'Tuple(a Int32, b Nullable(Int32))') AS t,
    if(number = 0, [(1, 'a'), (2, 'b')], [])::Array(Tuple(a Int32, c String)) AS l,
    map(CAST(tuple(toInt32(number)), 'Tuple(a Int32)'), 'v') AS mk,
    [(1, 'p'), (3, 'r')]::Array(Tuple(x Int32, y String)) AS n,
    map(CAST(tuple(if(number = 0, tuple(1), NULL)), 'Tuple(b Nullable(Tuple(a Int32)))'), 'v') AS mb,
    [CAST(tuple('5'), 'Tuple(s Nullable(String))'), NULL][number + 1] AS p
FROM numbers(2);

SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(q Nullable(Int32)), z Enum8(\'x\' = 5, \'y\' = 7), mk Map(Tuple(z Nullable(Int32)), String), n Nested(y String, q Nullable(Int32))') ORDER BY id SETTINGS flatten_nested = 0;
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(b Nullable(Int32), a Int32, e Enum8(\'x\' = 5, \'y\' = 7))') ORDER BY id;
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(b Int32), mb Map(Tuple(b Tuple(q Int32)), String)') ORDER BY id SETTINGS input_format_null_as_default = 1;
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(b Int32)') ORDER BY id SETTINGS input_format_null_as_default = 0; -- { serverError CANNOT_INSERT_NULL_IN_ORDINARY_COLUMN }
{% if format != 'Parquet' -%}
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, mb Map(Tuple(b Tuple(q Int32)), String)') ORDER BY id SETTINGS input_format_null_as_default = 0; -- { serverError CANNOT_INSERT_NULL_IN_ORDINARY_COLUMN }
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, l Array(Tuple(q Nullable(Int32)))') ORDER BY id;
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, p Tuple(s Int32)') ORDER BY id SETTINGS input_format_null_as_default = 1;
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, p Nullable(Tuple(s String))') ORDER BY id SETTINGS input_format_null_as_default = 0;
{% endif -%}
{% if format != 'Vortex' -%}
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, T Tuple(A Int32)') ORDER BY id SETTINGS {{ ci }};
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(b Nullable(Int32), B Int32)') ORDER BY id SETTINGS {{ ci }}, input_format_null_as_default = 1;
{% endif -%}
{% if format in ['ORC', 'Arrow'] -%}
INSERT INTO FUNCTION file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}')
SELECT id, c0, (toDate32('2000-01-01'), toDate32('2200-01-01'))::Tuple(A Date32, a Date32) AS c1, (toInt128(id), toInt256(id + 10))::Tuple(A Int128, a Int256) AS c2,
    (11, 22)::Tuple(AB Int32, ab Int32) AS c3, (11, 22)::Tuple(Ab Int32, AB Int32) AS c4, 11 AS AB, 22 AS ab,
    tuple(toDate32('2200-01-01'))::Tuple(a Date32) AS S, tuple(toDate32('2000-01-01'))::Tuple(a Date32) AS s
FROM values('id UInt32, c0 Tuple(A Nullable(Tuple(b UInt32)), a Tuple(b UInt32))', (1, tuple(tuple(11), tuple(21))), (2, tuple(NULL, tuple(22))));
SELECT * FROM file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}', 'id UInt32, c0 Tuple(a Tuple(b UInt32))') ORDER BY id SETTINGS {{ ci }};
SELECT * FROM file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}', 'id UInt32, c0 Tuple(A Nullable(Tuple(b UInt32)), a Tuple(b UInt32))') ORDER BY id SETTINGS {{ ci }}, input_format_null_as_default = 1;
SELECT * FROM file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}', 'id UInt32, c1 Tuple(A DateTime(\'UTC\'), a Int32), c2 Tuple(A Int128, a Int256)') ORDER BY id SETTINGS {{ ci }};
SELECT * FROM file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}', 'id UInt32, c3 Tuple(Ab Int32, aB Int32)') ORDER BY id SETTINGS {{ ci }}; -- { serverError AMBIGUOUS_COLUMN_NAME }
SELECT * FROM file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}', 'id UInt32, `c3.Ab` Int32') ORDER BY id SETTINGS {{ ci }}; -- { serverError AMBIGUOUS_COLUMN_NAME }
SELECT * FROM file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}', 'id UInt32, Ab Int32') ORDER BY id SETTINGS {{ ci }}; -- { serverError AMBIGUOUS_COLUMN_NAME }
SELECT * FROM file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}', 'id UInt32, c3 Tuple(ab Int32, AB Int32), `c4.Ab` Int32, `c4.AB` Int32, `c1.a` Int32, `c1.A` DateTime(\'UTC\'), ab Int32, AB Int32') ORDER BY id SETTINGS {{ ci }}, date_time_overflow_behavior = 'saturate';
SELECT * FROM file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}', 'id UInt32, `c1.A` DateTime(\'UTC\'), `s.A` DateTime(\'UTC\'), s Tuple(A DateTime(\'UTC\')), `S.a` Int32, S Tuple(a Int32)') ORDER BY id SETTINGS {{ ci }};
SELECT * FROM file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}', 'id UInt32, `S.A` DateTime(\'UTC\'), `s.a` Int32') ORDER BY id SETTINGS {{ ci }}; -- { serverError VALUE_IS_OUT_OF_RANGE_OF_DATA_TYPE }
SELECT * FROM file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}', 'id UInt32, `c2.A` Int128, `c2.a` Int256') ORDER BY id;
{% if format == 'ORC' -%}
SELECT * FROM file(currentDatabase() || '_05618_ci.ORC', 'ORC', 'id UInt32, `S.a` Int32, `S.A` DateTime(\'UTC\')') ORDER BY id SETTINGS {{ ci }};
{% endif -%}
{% endif -%}
{% if format == 'Vortex' -%}
INSERT INTO FUNCTION file(currentDatabase() || '_05618_ci.Vortex', 'Vortex') SELECT 1 AS id, tuple(toDate32('2200-01-01'))::Tuple(A Date32) AS S;
SELECT * FROM file(currentDatabase() || '_05618_ci.Vortex', 'Vortex', 'id UInt32, `S.A` DateTime(\'UTC\')') SETTINGS {{ ci }}; -- { serverError VALUE_IS_OUT_OF_RANGE_OF_DATA_TYPE }
{% endif -%}
{% endfor -%}

{% for format in ['Parquet', 'ORC', 'Arrow', 'Native', 'Vortex'] -%}
SELECT '{{ format }} NULL rows';
INSERT INTO FUNCTION file(currentDatabase() || '_05618_null.{{ format }}', '{{ format }}') SELECT
    number AS id,
    [CAST('7', 'Nullable(String)'), NULL][number + 1] AS e1,
    [CAST(2, 'Nullable(Int8)'), NULL][number + 1] AS e2,
    [CAST('b', 'Nullable(Enum8(\'a\' = 1, \'b\' = 2))'), NULL][number + 1] AS e3,
    [CAST(tuple('9'), 'Nullable(Tuple(s String))'), NULL][number + 1] AS e4,
    map('k', CAST(NULL, 'Nullable(Int8)')) AS e5,
    [('k', CAST(NULL, 'Nullable(Int8)'))]::Array(Tuple(String, Nullable(Int8))) AS e6,
    (['k'], [CAST(NULL, 'Nullable(Int8)')])::Tuple(Array(String), Array(Nullable(Int8))) AS e7
FROM numbers(2);
SELECT * FROM file(currentDatabase() || '_05618_null.{{ format }}', '{{ format }}', 'id UInt64, e1 Int32, e2 Enum8(\'a\' = 1, \'b\' = 2), e3 Enum8(\'a\' = 1, \'b\' = 2), e4 Tuple(s Int32)') ORDER BY id;
SELECT * FROM file(currentDatabase() || '_05618_null.{{ format }}', '{{ format }}', 'id UInt64, e1 Int32 DEFAULT 42, e4 Nullable(Tuple(s Int32))') ORDER BY id;
SELECT * FROM file(currentDatabase() || '_05618_null.{{ format }}', '{{ format }}', 'id UInt64, e1 Nullable(Int32)') ORDER BY id;
{% if format != 'Parquet' -%}
SELECT * FROM file(currentDatabase() || '_05618_null.{{ format }}', '{{ format }}', 'id UInt64, e5 Array(Tuple(String, Int8)), e6 Map(String, Int8), e7 Map(String, Int8)') ORDER BY id SETTINGS input_format_null_as_default = 1;
{% endif -%}
{% if format == 'Native' -%}
SELECT * FROM file(currentDatabase() || '_05618_null.Native', 'Native', 'id UInt64, e3 Enum8(\'a\' = 1, \'b\' = 2), e4 Nullable(Tuple(s LowCardinality(String))), e5 Map(String, Int8)') ORDER BY id SETTINGS input_format_null_as_default = 1, input_format_native_allow_types_conversion = 0;
SELECT * FROM file(currentDatabase() || '_05618_null.Native', 'Native', 'id UInt64, e1 Int32') SETTINGS input_format_native_allow_types_conversion = 0; -- { serverError TYPE_MISMATCH }
SELECT * FROM file(currentDatabase() || '_05618_null.Native', 'Native', 'id UInt64, e5 Array(Tuple(String, Int8))') SETTINGS input_format_native_allow_types_conversion = 0; -- { serverError TYPE_MISMATCH }
{% endif -%}
{% endfor -%}
INSERT INTO FUNCTION file(currentDatabase() || '_05618_dict.ORC', 'ORC') SELECT number AS id, [CAST('7', 'Nullable(String)'), NULL][number + 1] AS e1
FROM numbers(2) SETTINGS output_format_orc_dictionary_key_size_threshold = 1;
SELECT * FROM file(currentDatabase() || '_05618_dict.ORC', 'ORC', 'id UInt64, e1 Int32') ORDER BY id SETTINGS input_format_orc_dictionary_as_low_cardinality = 1, input_format_null_as_default = 1;
SELECT * FROM file(currentDatabase() || '_05618_dict.ORC', 'ORC', 'id UInt64, e1 String DEFAULT \'fallback\'') ORDER BY id SETTINGS input_format_orc_dictionary_as_low_cardinality = 1, input_format_null_as_default = 1;
SELECT * FROM file(currentDatabase() || '_05618_dict.ORC', 'ORC', 'id UInt64, e1 String') SETTINGS input_format_orc_dictionary_as_low_cardinality = 1, input_format_null_as_default = 0; -- { serverError CANNOT_INSERT_NULL_IN_ORDINARY_COLUMN }
INSERT INTO FUNCTION file(currentDatabase() || '_05618_dot.ORC', 'ORC') SELECT number AS id,
    [CAST((toDate32('2200-01-01'), tuple(1), 7), 'Tuple(`a.b` Date32, a Tuple(b Int32), `Null` UInt8)'), NULL][number + 1] AS d
FROM numbers(2);
SELECT * FROM file(currentDatabase() || '_05618_dot.ORC', 'ORC', 'id UInt64, `d.a.b` DateTime(\'UTC\')') ORDER BY id; -- { serverError VALUE_IS_OUT_OF_RANGE_OF_DATA_TYPE }
SELECT * FROM file(currentDatabase() || '_05618_dot.ORC', 'ORC', 'id UInt64, `d.null` UInt8, `d.Null` UInt8') ORDER BY id;
SELECT * FROM file(currentDatabase() || '_05618_dot.ORC', 'ORC', 'id UInt64, `d.null` UInt8, `d.a.b` Date32') ORDER BY id SETTINGS input_format_orc_case_insensitive_column_matching = 1;
SELECT count() FROM file(currentDatabase() || '_05618_null.Parquet', 'Parquet', 'e2 Enum8(\'a\' = 1, \'b\' = 2)') WHERE e2 = 'a' SETTINGS input_format_parquet_dictionary_filter_push_down = 0;
SELECT count() FROM file(currentDatabase() || '_05618_null.Parquet', 'Parquet', 'e2 Enum8(\'a\' = 1, \'b\' = 2)') WHERE e2 = 'a' SETTINGS input_format_parquet_dictionary_filter_push_down = 1048576;

INSERT INTO FUNCTION file(currentDatabase() || '_05618_positional.Native', 'Native') SELECT CAST((1, NULL), 'Tuple(a Int32, b Nullable(Int32))') AS t;
SELECT * FROM file(currentDatabase() || '_05618_positional.Native', 'Native', 't Tuple(x Int64, y Int64)');
SELECT * FROM file(currentDatabase() || '_05618_positional.Native', 'Native', 't Tuple(b Int32, a Nullable(Int32))') SETTINGS input_format_null_as_default = 1, input_format_native_allow_types_conversion = 0;
SELECT * FROM file(currentDatabase() || '_05618_positional.Native', 'Native', 't Tuple(a Int32)') SETTINGS input_format_native_allow_types_conversion = 0; -- { serverError TYPE_MISMATCH }
SELECT * FROM file(currentDatabase() || '_05618_positional.Native', 'Native', 't Tuple(a Int32, b Nullable(Int32), c Int32)') SETTINGS input_format_native_allow_types_conversion = 0; -- { serverError TYPE_MISMATCH }
INSERT INTO FUNCTION file(currentDatabase() || '_05618_geo.Native', 'Native') SELECT
    [(0., 0.), (1., 1.)]::LineString AS l, [[(0., 0.), (1., 0.), (1., 1.)]]::Polygon AS p, (1., 2.)::Point AS pt,
    [l] AS al, (p, 1) AS tp, map('k', l) AS ml;
SELECT * FROM file(currentDatabase() || '_05618_geo.Native', 'Native', 'l MultiLineString, p MultiPolygon, pt MultiPoint, al Array(MultiLineString), tp Tuple(MultiPolygon, UInt8), ml Map(String, MultiLineString)');

INSERT INTO FUNCTION file(currentDatabase() || '_05618_union.ORC', 'ORC') SELECT
    number AS id,
    [CAST(CAST(tuple(NULL), 'Tuple(a Nullable(Int8))'), 'Variant(Tuple(a Nullable(Int8)), String)'), NULL][number + 1] AS v1,
    CAST([1, NULL]::Array(Nullable(Int8)), 'Variant(Array(Nullable(Int8)), String)') AS v2,
    CAST(CAST(('hello', 42), 'Tuple(A String, a Int32)'), 'Variant(Tuple(A String, a Int32), UInt64)') AS v3,
    CAST(CAST((11, 'x'), 'Tuple(AB Int32, ab String)'), 'Variant(Tuple(AB Int32, ab String), UInt64)') AS v4,
    [CAST(CAST((11, 22), 'Tuple(AB Int32, ab Int32)'), 'Variant(Tuple(AB Int32, ab Int32), Tuple(Ab String))'),
     CAST(CAST(tuple('x'), 'Tuple(Ab String)'), 'Variant(Tuple(AB Int32, ab Int32), Tuple(Ab String))')][number + 1] AS v5
FROM numbers(2) SETTINGS allow_suspicious_variant_types = 1;
SELECT * FROM file(currentDatabase() || '_05618_union.ORC', 'ORC', 'id UInt64, v1 Variant(Tuple(a Int8), String), v2 Variant(Array(Int8), String)') ORDER BY id SETTINGS input_format_null_as_default = 1;
SELECT * FROM file(currentDatabase() || '_05618_union.ORC', 'ORC', 'id UInt64, v3 Variant(Tuple(A String, a Int64), UInt64), v4 Variant(Tuple(ab String, AB Int64), UInt64)') ORDER BY id SETTINGS input_format_orc_case_insensitive_column_matching = 1;
SELECT * FROM file(currentDatabase() || '_05618_union.ORC', 'ORC', 'id UInt64, v4 Variant(Tuple(Ab Int64, aB String), UInt64)') ORDER BY id SETTINGS input_format_orc_case_insensitive_column_matching = 1; -- { serverError AMBIGUOUS_COLUMN_NAME }
SELECT id, v5 FROM file(currentDatabase() || '_05618_union.ORC', 'ORC', 'id UInt64, v5 Variant(Tuple(AB Int64, ab Int32), Tuple(Ab String))') ORDER BY id SETTINGS input_format_orc_case_insensitive_column_matching = 1, allow_suspicious_variant_types = 1;
SELECT id, v5 FROM file(currentDatabase() || '_05618_union.ORC', 'ORC') ORDER BY id SETTINGS input_format_orc_case_insensitive_column_matching = 1, allow_suspicious_variant_types = 1;
SELECT id, c3, c4 FROM file(currentDatabase() || '_05618_ci.ORC', 'ORC', 'id UInt32, c3 Tuple(ab Int32, AB Int32), c4 Tuple(AB Int32, Ab Int32)') WHERE c3.ab = 22 AND c4.AB = 22 ORDER BY id SETTINGS input_format_orc_case_insensitive_column_matching = 1, input_format_orc_filter_push_down = 1, optimize_functions_to_subcolumns = 1;
SELECT count() FROM file(currentDatabase() || '_05618_ci.ORC', 'ORC', 'id UInt32, c3 Tuple(ab Int32, AB Int32), c4 Tuple(AB Int32, Ab Int32)') WHERE c3.ab = 11 OR c4.AB = 11 SETTINGS input_format_orc_case_insensitive_column_matching = 1, input_format_orc_filter_push_down = 1, optimize_functions_to_subcolumns = 1, log_comment = '05618_orc_push_down';
INSERT INTO FUNCTION file(currentDatabase() || '_05618_pd.ORC', 'ORC') SELECT toInt32(11) AS AB, toInt32(22) AS ab, CAST(tuple(11), 'Tuple(a Int32)') AS T, CAST(tuple(22), 'Tuple(a Int32)') AS t;
SELECT * FROM file(currentDatabase() || '_05618_pd.ORC', 'ORC', 'AB Int32, ab Int32, T Tuple(a Int32), t Tuple(a Int32)') WHERE ab = 22 AND t.a = 22 SETTINGS input_format_orc_case_insensitive_column_matching = 1, input_format_orc_filter_push_down = 1, optimize_functions_to_subcolumns = 1;
SELECT * FROM file(currentDatabase() || '_05618_pd.ORC', 'ORC', 'ab Int32, AB Int32, t Tuple(a Int32), T Tuple(a Int32)') WHERE AB = 11 AND T.a = 11 SETTINGS input_format_orc_case_insensitive_column_matching = 1, input_format_orc_filter_push_down = 1, optimize_functions_to_subcolumns = 1;
SELECT * FROM file(currentDatabase() || '_05618_pd.ORC', 'ORC', 'AB Int32, ab Int32, T Tuple(a Int32), t Tuple(a Int32)') WHERE ab = 11 OR t.a = 11 SETTINGS input_format_orc_case_insensitive_column_matching = 1, input_format_orc_filter_push_down = 1, optimize_functions_to_subcolumns = 1, log_comment = '05618_orc_push_down';
SELECT * FROM file(currentDatabase() || '_05618_pd.ORC', 'ORC', 'ab Int32, AB Int32, t Tuple(a Int32), T Tuple(a Int32)') WHERE AB = 22 OR T.a = 22 SETTINGS input_format_orc_case_insensitive_column_matching = 1, input_format_orc_filter_push_down = 1, optimize_functions_to_subcolumns = 1, log_comment = '05618_orc_push_down';
SYSTEM FLUSH LOGS query_log;
SELECT read_rows FROM system.query_log WHERE current_database = currentDatabase() AND log_comment = '05618_orc_push_down' AND type = 'QueryFinish';

SELECT CAST(CAST(tuple(1), 'Tuple(a Int32)'), 'Tuple(b Int32)');

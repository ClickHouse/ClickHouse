-- Tags: no-fasttest, no-msan
-- no-fasttest, no-msan: the Vortex format is not included in the fast test and MSan builds
-- The input format readers convert a column to the requested type with one shared function: named tuple elements
-- are matched by name, a missing element or column gets the default of its type, and NULLs are paired by name.

SET engine_file_truncate_on_insert = 1;

{% set ci = 'input_format_parquet_case_insensitive_column_matching = 1, input_format_orc_case_insensitive_column_matching = 1, input_format_arrow_case_insensitive_column_matching = 1' -%}
{% for format in ['Parquet', 'ORC', 'Arrow', 'Vortex'] -%}
SELECT '{{ format }}';
INSERT INTO FUNCTION file(currentDatabase() || '_05618.{{ format }}', '{{ format }}') SELECT
    number AS id,
    CAST((toInt32(number), if(number = 0, NULL, toInt32(number + 10))), 'Tuple(a Int32, b Nullable(Int32))') AS t,
    if(number = 0, [(1, 'a'), (2, 'b')], [])::Array(Tuple(a Int32, c String)) AS l,
    map(CAST(tuple(toInt32(number)), 'Tuple(a Int32)'), 'v') AS mk,
    [(1, 'p'), (3, 'r')]::Array(Tuple(x Int32, y String)) AS n,
    map(CAST(tuple(if(number = 0, tuple(1), NULL)), 'Tuple(b Nullable(Tuple(a Int32)))'), 'v') AS mb,
    [CAST(tuple('5'), 'Tuple(s Nullable(String))'), NULL][number + 1] AS p
FROM numbers(2);

SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(q Nullable(Int32)), z Enum8(\'x\' = 5, \'y\' = 7), mk Map(Tuple(z Nullable(Int32)), String), n Nested(y String, q Nullable(Int32))') ORDER BY id SETTINGS flatten_nested = 0;
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(b Nullable(Int32), a Int32, e Enum8(\'x\' = 5, \'y\' = 7))') ORDER BY id;
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(b Int32), mb Map(Tuple(b Tuple(q Int32)), String)') ORDER BY id SETTINGS input_format_null_as_default = 1;
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(b Int32)') ORDER BY id SETTINGS input_format_null_as_default = 0; -- { serverError CANNOT_INSERT_NULL_IN_ORDINARY_COLUMN }
{% if format != 'Parquet' -%}
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, mb Map(Tuple(b Tuple(q Int32)), String)') ORDER BY id SETTINGS input_format_null_as_default = 0; -- { serverError CANNOT_INSERT_NULL_IN_ORDINARY_COLUMN }
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, l Array(Tuple(q Nullable(Int32)))') ORDER BY id;
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, p Tuple(s Int32)') ORDER BY id SETTINGS input_format_null_as_default = 1;
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, p Nullable(Tuple(s String))') ORDER BY id SETTINGS input_format_null_as_default = 0;
{% endif -%}
{% if format != 'Vortex' -%}
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, T Tuple(A Int32)') ORDER BY id SETTINGS {{ ci }};
SELECT * FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(b Nullable(Int32), B Int32)') ORDER BY id SETTINGS {{ ci }}, input_format_null_as_default = 1;
{% endif -%}
{% if format in ['ORC', 'Arrow'] -%}
INSERT INTO FUNCTION file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}')
SELECT id, c0 FROM values('id UInt32, c0 Tuple(A Nullable(Tuple(b UInt32)), a Tuple(b UInt32))', (1, tuple(tuple(11), tuple(21))), (2, tuple(NULL, tuple(22))));
SELECT * FROM file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}', 'id UInt32, c0 Tuple(a Tuple(b UInt32))') ORDER BY id SETTINGS {{ ci }};
SELECT * FROM file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}', 'id UInt32, c0 Tuple(A Nullable(Tuple(b UInt32)), a Tuple(b UInt32))') ORDER BY id SETTINGS {{ ci }}, input_format_null_as_default = 1;
{% endif -%}
{% endfor -%}

SELECT CAST(CAST(tuple(1), 'Tuple(a Int32)'), 'Tuple(a Int32, e Enum8(\'x\' = 5, \'y\' = 7))');
SELECT CAST(CAST(tuple(1), 'Tuple(a Int32)'), 'Tuple(b Int32)');

DROP TABLE IF EXISTS t_05618;
CREATE TABLE t_05618 (id UInt64, t Tuple(a Int32)) ENGINE = MergeTree ORDER BY id;
INSERT INTO t_05618 VALUES (1, (11));
ALTER TABLE t_05618 MODIFY COLUMN t Tuple(a Int32, e Enum8('x' = 5, 'y' = 7)) SETTINGS mutations_sync = 2;
SELECT * FROM t_05618;
DROP TABLE t_05618;

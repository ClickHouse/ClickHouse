-- Tags: no-fasttest, no-msan
-- no-fasttest, no-msan: the Vortex format is not included in the fast test and MSan builds
-- Every input format reader matches the elements of a requested named Tuple by name, also when none of them is in
-- the file, fills a missing element with the default of its type and pairs NULLs with defaults by name.

-- { echo }

SET engine_file_truncate_on_insert = 1;

{% for format in ['Parquet', 'ORC', 'Arrow', 'Vortex'] -%}

INSERT INTO FUNCTION file(currentDatabase() || '_05618.{{ format }}', '{{ format }}') SELECT
    number AS id,
    CAST((toInt32(number), if(number = 0, NULL, toInt32(number + 10))), 'Tuple(a Int32, b Nullable(Int32))') AS t,
    if(number = 0, [(1, 'a'), (2, 'b')], [])::Array(Tuple(a Int32, c String)) AS l,
    if(number = 0, map('k1', (1, 'a'), 'k2', (2, 'b')), map())::Map(String, Tuple(a Int32, c String)) AS m,
    map(CAST(tuple(toInt32(number)), 'Tuple(a Int32)'), 'v') AS mk,
    [(1, 'p'), (3, 'r')]::Array(Tuple(x Int32, y String)) AS n,
    map(CAST(tuple(if(number = 0, tuple(1), NULL)), 'Tuple(b Nullable(Tuple(a Int32)))'), 'v') AS mb
FROM numbers(2);

SELECT id, t FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(q Nullable(Int32))') ORDER BY id;
SELECT id, t FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(b Nullable(Int32), a Int32, e Enum8(\'x\' = 5, \'y\' = 7))') ORDER BY id;
SELECT id, t FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(b Nullable(Int32), a Int32)') ORDER BY id;
SELECT id, t FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(b Int32)') ORDER BY id SETTINGS input_format_null_as_default = 1;
SELECT id, t FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(b Int32)') ORDER BY id SETTINGS input_format_null_as_default = 0; -- { serverError CANNOT_INSERT_NULL_IN_ORDINARY_COLUMN }
SELECT id, l FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, l Array(Tuple(q Nullable(Int32)))') ORDER BY id;
SELECT id, l FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, l Array(Tuple(c String, e Enum8(\'x\' = 5, \'y\' = 7)))') ORDER BY id;
SELECT id, m FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, m Map(String, Tuple(q Nullable(String)))') ORDER BY id;
SELECT id, mk FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, mk Map(Tuple(z Nullable(Int32)), String)') ORDER BY id;
SELECT id, z FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, z Enum8(\'x\' = 5, \'y\' = 7)') ORDER BY id;
SELECT id, n FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, n Nested(y String, q Nullable(Int32))') ORDER BY id SETTINGS flatten_nested = 0;
{% if format != 'Vortex' -%}
SELECT id, T FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, T Tuple(A Int32)') ORDER BY id SETTINGS input_format_parquet_case_insensitive_column_matching = 1, input_format_orc_case_insensitive_column_matching = 1, input_format_arrow_case_insensitive_column_matching = 1;
{% endif -%}
SELECT id, t FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, t Tuple(Int32, Nullable(Int32))') ORDER BY id;
SELECT id, mb FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, mb Map(Tuple(b Tuple(q Int32)), String)') ORDER BY id SETTINGS input_format_null_as_default = 1;
{% if format != 'Parquet' -%}
SELECT id, mb FROM file(currentDatabase() || '_05618.{{ format }}', '{{ format }}', 'id UInt64, mb Map(Tuple(b Tuple(q Int32)), String)') ORDER BY id SETTINGS input_format_null_as_default = 0; -- { serverError CANNOT_INSERT_NULL_IN_ORDINARY_COLUMN }
{% endif -%}
{% if format in ['ORC', 'Arrow'] -%}

-- Case-insensitive matching of fields whose names differ only by case: an exact spelling wins.
INSERT INTO FUNCTION file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}')
SELECT id, c0 FROM values('id UInt32, c0 Tuple(A Nullable(Tuple(b UInt32)), a Tuple(b UInt32))', (1, tuple(tuple(11), tuple(21))), (2, tuple(NULL, tuple(22))));
SELECT id, c0 FROM file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}', 'id UInt32, c0 Tuple(A Nullable(Tuple(b UInt32)), a Tuple(b UInt32))') ORDER BY id SETTINGS input_format_orc_case_insensitive_column_matching = 1, input_format_arrow_case_insensitive_column_matching = 1;
SELECT id, c0 FROM file(currentDatabase() || '_05618_ci.{{ format }}', '{{ format }}', 'id UInt32, c0 Tuple(a Tuple(b UInt32))') ORDER BY id SETTINGS input_format_orc_case_insensitive_column_matching = 1, input_format_arrow_case_insensitive_column_matching = 1;
{% endif -%}

{% endfor -%}

-- A missing Enum element gets the default of its type in CAST too; disjoint names in CAST stay positional.
SELECT CAST(CAST(tuple(1), 'Tuple(a Int32)'), 'Tuple(a Int32, e Enum8(\'x\' = 5, \'y\' = 7))');
SELECT CAST(CAST(tuple(1), 'Tuple(a Int32)'), 'Tuple(b Int32)');

DROP TABLE IF EXISTS t_05618;
CREATE TABLE t_05618 (id UInt64, t Tuple(a Int32)) ENGINE = MergeTree ORDER BY id;
INSERT INTO t_05618 VALUES (1, (11));
ALTER TABLE t_05618 MODIFY COLUMN t Tuple(a Int32, e Enum8('x' = 5, 'y' = 7)) SETTINGS mutations_sync = 2;
SELECT * FROM t_05618;
DROP TABLE t_05618;

--- cross ---
SELECT\n    a,\n    b,\n    t2_00826.a,\n    t2_00826.b\nFROM t1_00826\nALL INNER JOIN t2_00826 ON equals(a, t2_00826.a)\nWHERE equals(a, t2_00826.a)\nORDER BY ALL ASC
--- cross nullable ---
SELECT\n    a,\n    b,\n    t2_00826.a,\n    t2_00826.b\nFROM t1_00826\nALL INNER JOIN t2_00826 ON equals(a, t2_00826.a)\nWHERE equals(a, t2_00826.a)\nORDER BY ALL ASC
--- cross nullable vs not nullable ---
SELECT\n    a,\n    b,\n    t2_00826.a,\n    t2_00826.b\nFROM t1_00826\nALL INNER JOIN t2_00826 ON equals(a, t2_00826.b)\nWHERE equals(a, t2_00826.b)\nORDER BY ALL ASC
--- cross self ---
SELECT\n    a,\n    b,\n    y.a,\n    y.b\nFROM t1_00826 AS x\nALL INNER JOIN t1_00826 AS y ON and(equals(a, y.a), equals(b, y.b))\nWHERE and(equals(a, y.a), equals(b, y.b))\nORDER BY ALL ASC
--- cross one table expr ---
SELECT\n    a,\n    b,\n    t2_00826.a,\n    t2_00826.b\nFROM t1_00826\nCROSS JOIN t2_00826\nWHERE equals(a, b)\nORDER BY ALL ASC
--- cross multiple ands ---
SELECT\n    a,\n    b,\n    t2_00826.a,\n    t2_00826.b\nFROM t1_00826\nALL INNER JOIN t2_00826 ON and(equals(a, t2_00826.a), equals(b, t2_00826.b))\nWHERE and(equals(a, t2_00826.a), equals(b, t2_00826.b))\nORDER BY ALL ASC
--- cross and inside and ---
SELECT\n    a,\n    b,\n    t2_00826.a,\n    t2_00826.b\nFROM t1_00826\nALL INNER JOIN t2_00826 ON and(equals(a, t2_00826.a), equals(a, t2_00826.a), equals(a, t2_00826.a), equals(b, t2_00826.b))\nWHERE and(equals(a, t2_00826.a), and(equals(a, t2_00826.a), and(equals(a, t2_00826.a), equals(b, t2_00826.b))))\nORDER BY ALL ASC
--- cross split conjunction ---
SELECT\n    a,\n    b,\n    t2_00826.a,\n    t2_00826.b\nFROM t1_00826\nALL INNER JOIN t2_00826 ON and(equals(a, t2_00826.a), equals(b, t2_00826.b))\nWHERE and(equals(a, t2_00826.a), equals(b, t2_00826.b), greaterOrEquals(a, 1), greater(t2_00826.b, 0))\nORDER BY ALL ASC
--- and or ---
SELECT\n    a,\n    b,\n    t2_00826.a,\n    t2_00826.b\nFROM t1_00826\nALL INNER JOIN t2_00826 ON and(equals(a, t2_00826.a), equals(b, t2_00826.b))\nWHERE and(equals(a, t2_00826.a), equals(b, t2_00826.b), or(greaterOrEquals(a, 1), equals(t2_00826.b, 1)))\nORDER BY ALL ASC
--- arithmetic expr ---
SELECT\n    a,\n    b,\n    t2_00826.a,\n    t2_00826.b\nFROM t1_00826\nALL INNER JOIN t2_00826 ON equals(plus(a, 1), plus(t2_00826.a, t2_00826.b))\nWHERE and(equals(plus(a, 1), plus(t2_00826.a, t2_00826.b)), greater(plus(plus(plus(a, b), t2_00826.a), t2_00826.b), 5))\nORDER BY ALL ASC
--- is null or ---
SELECT\n    a,\n    b,\n    t2_00826.a,\n    t2_00826.b\nFROM t1_00826\nALL INNER JOIN t2_00826 ON equals(b, t2_00826.a)\nWHERE and(equals(b, t2_00826.a), or(isNull(t2_00826.b), greater(t2_00826.b, t2_00826.a)))\nORDER BY ALL ASC
--- do not rewrite alias ---
SELECT a AS b\nFROM t1_00826\nCROSS JOIN t2_00826\nWHERE and(equals(b, t2_00826.a), greater(a AS b, 0))\nORDER BY ALL ASC
--- comma ---
SELECT\n    a,\n    b,\n    t2_00826.a,\n    t2_00826.b\nFROM t1_00826\nALL INNER JOIN t2_00826 ON equals(a, t2_00826.a)\nWHERE equals(a, t2_00826.a)\nORDER BY ALL ASC
--- comma nullable ---
SELECT\n    a,\n    b,\n    t2_00826.a,\n    t2_00826.b\nFROM t1_00826\nALL INNER JOIN t2_00826 ON equals(b, t2_00826.b)\nWHERE equals(b, t2_00826.b)\nORDER BY ALL ASC
--- comma and or ---
SELECT\n    a,\n    b,\n    t2_00826.a,\n    t2_00826.b\nFROM t1_00826\nALL INNER JOIN t2_00826 ON equals(a, t2_00826.a)\nWHERE and(equals(a, t2_00826.a), or(isNull(t2_00826.b), less(t2_00826.b, 2)))\nORDER BY ALL ASC

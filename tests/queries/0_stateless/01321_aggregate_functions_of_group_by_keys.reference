SELECT\n    min(modulo(number, 2)) AS a,\n    max(modulo(number, 3)) AS b\nFROM numbers(10000000)\nGROUP BY\n    modulo(number, 2),\n    modulo(number, 3)\nORDER BY\n    a ASC,\n    b ASC
SELECT\n    any(modulo(number, 2)) AS a,\n    anyLast(modulo(number, 3)) AS b\nFROM numbers(10000000)\nGROUP BY\n    modulo(number, 2),\n    modulo(number, 3)\nORDER BY\n    a ASC,\n    b ASC

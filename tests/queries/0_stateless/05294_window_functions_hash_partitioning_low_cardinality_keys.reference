    = (SELECT sum(cityHash64(*)) FROM (SELECT n, s, sum(x) OVER w, count() OVER w FROM t_hash_window_low_cardinality WINDOW w AS (PARTITION BY s)) SETTINGS query_plan_window_functions_hash_partitioning = 1);

    = (SELECT sum(cityHash64(*)) FROM (SELECT n, sum(x) OVER w, count() OVER w FROM t_hash_window_low_cardinality WINDOW w AS (PARTITION BY s, nu32, u8)) SETTINGS query_plan_window_functions_hash_partitioning = 1);

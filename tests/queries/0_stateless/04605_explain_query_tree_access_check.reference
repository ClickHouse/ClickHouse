-- No privileges: every EXPLAIN variant and SELECT must be denied
SELECT: ACCESS_DENIED
EXPLAIN SYNTAX: ACCESS_DENIED
EXPLAIN PLAN: ACCESS_DENIED
EXPLAIN QUERY TREE: ACCESS_DENIED
EXPLAIN PIPELINE: ACCESS_DENIED
SUBQUERY IN WHERE: ACCESS_DENIED
COUNT: ACCESS_DENIED
-- Full SELECT grant: EXPLAIN QUERY TREE is allowed
EXPLAIN QUERY TREE: OK
-- Column-level grant: allowed for granted columns, denied otherwise (as for a plain SELECT)
EXPLAIN QUERY TREE (y): OK
EXPLAIN QUERY TREE (z): ACCESS_DENIED
EXPLAIN QUERY TREE (*): ACCESS_DENIED
COUNT: OK

CREATE OR REPLACE TABLE syntaxerrors ADD ENUM VALUES ('Five'); -- { clientError SYNTAX_ERROR }
ALTER TABLE syntaxerrors ADD ENUM VALUES ('Five'); -- { clientError SYNTAX_ERROR }
ALTER TABLE syntaxerrors ADD COLUMN z ADD ENUM VALUES ('Five'); -- { clientError SYNTAX_ERROR }
ALTER TABLE syntaxerrors MODIFY COLUMN x ADD ENUM VALUES('Hundred' = 100), ADD COLUMN z ADD ENUM VALUES ('Five'); -- { clientError SYNTAX_ERROR }
ALTER TABLE syntaxerrors MODIFY COLUMN x RESET SETTING min_compress_block_size ADD ENUM VALUES('Hundred' = 100); -- { clientError SYNTAX_ERROR }
ALTER TABLE syntaxerrors MODIFY COLUMN x Nullable(Enum ('c')) ADD ENUM VALUES('Hundred' = 100); -- { clientError SYNTAX_ERROR }
SELECT '======= ADD ENUM VALUES SYNTAX ERRORS ===============';
ALTER TABLE syntaxerrors MODIFY COLUMN x ADD ENUM VALUES(, 'Hundred' = 100); -- { clientError SYNTAX_ERROR }
ALTER TABLE syntaxerrors MODIFY COLUMN x ADD ENUM VALUES('Hundred' = 100,); -- { clientError SYNTAX_ERROR }

-- The alter must not rewrite data on MergeTree: a rewrite would give the active parts a
-- mutation-version suffix (`all_1_1_0` -> `all_1_1_0_2`), so the parts check below expects
-- no part name with more than 4 components. `mutations_sync = 2` makes a hypothetical rewrite
-- finish before the check, so the check cannot pass by racing an unfinished mutation.
-- Do not assert on `system.mutations` here: `SharedMergeTree` accounts even a metadata-only
-- alter there, while `MergeTree` and `ReplicatedMergeTree` do not.
SELECT '======= MERGETREE ===============';
CREATE OR REPLACE TABLE enum_mt (x Enum8('a' = 1), v Int32) ENGINE = MergeTree ORDER BY v;
INSERT INTO enum_mt VALUES (1, 10);
ALTER TABLE enum_mt MODIFY COLUMN x ADD ENUM VALUES('b' = 2) SETTINGS mutations_sync = 2;
INSERT INTO enum_mt VALUES (2, 20);
SELECT x, v FROM enum_mt ORDER BY v;
SELECT count() FROM system.parts WHERE database = currentDatabase() AND table = 'enum_mt' AND active AND length(splitByChar('_', name)) > 4;
SELECT name, type FROM system.columns WHERE database = currentDatabase() AND table = 'enum_mt' AND name = 'x';
DROP TABLE enum_mt;

-- Extending an enum in the sorting key goes through the key-conversion safety check of MergeTree.
SELECT '======= MERGETREE SORTING KEY ===============';
CREATE OR REPLACE TABLE enum_mt_key (x Enum8('a' = 1)) ENGINE = MergeTree ORDER BY x;
INSERT INTO enum_mt_key VALUES (1);
ALTER TABLE enum_mt_key MODIFY COLUMN x ADD ENUM VALUES('b' = 2);
INSERT INTO enum_mt_key VALUES (2);
SELECT * FROM enum_mt_key ORDER BY x;
DROP TABLE enum_mt_key;

SELECT '======= MERGETREE PARTITION KEY ===============';
CREATE OR REPLACE TABLE enum_mt_part (x Enum8('a' = 1), v Int32) ENGINE = MergeTree PARTITION BY x ORDER BY v;
INSERT INTO enum_mt_part VALUES (1, 10);
ALTER TABLE enum_mt_part MODIFY COLUMN x ADD ENUM VALUES('b' = 2);
INSERT INTO enum_mt_part VALUES (2, 20);
SELECT x, v FROM enum_mt_part ORDER BY v;
DROP TABLE enum_mt_part;

-- The new enum type must propagate through ZooKeeper metadata to the other replica.
SELECT '======= REPLICATED MERGETREE ===============';
DROP TABLE IF EXISTS enum_rmt1 SYNC;
DROP TABLE IF EXISTS enum_rmt2 SYNC;
CREATE TABLE enum_rmt1 (x Enum8('a' = 1), v Int32) ENGINE = ReplicatedMergeTree('/clickhouse/tables/{database}/04307/enum_rmt', 'r1') ORDER BY v;
CREATE TABLE enum_rmt2 (x Enum8('a' = 1), v Int32) ENGINE = ReplicatedMergeTree('/clickhouse/tables/{database}/04307/enum_rmt', 'r2') ORDER BY v;
INSERT INTO enum_rmt1 VALUES (1, 10);
ALTER TABLE enum_rmt1 MODIFY COLUMN x ADD ENUM VALUES('b' = 2) SETTINGS mutations_sync = 2;
INSERT INTO enum_rmt1 VALUES (2, 20);
SYSTEM SYNC REPLICA enum_rmt2;
SELECT x, v FROM enum_rmt2 ORDER BY v;
SELECT count() FROM system.parts WHERE database = currentDatabase() AND table = 'enum_rmt1' AND active AND length(splitByChar('_', name)) > 4;
-- No unfinished mutations may remain after the alter. Do not count finished ones:
-- `SharedMergeTree` accounts even a metadata-only alter in `system.mutations`, while
-- `MergeTree` and `ReplicatedMergeTree` do not. `mutations_sync = 2` on the alter above
-- makes this deterministic: anything the alter created has finished by this point.
SELECT count() FROM system.mutations WHERE database = currentDatabase() AND table = 'enum_rmt1' AND NOT is_done;
SELECT name, type FROM system.columns WHERE database = currentDatabase() AND table = 'enum_rmt2' AND name = 'x';
DROP TABLE enum_rmt1 SYNC;
DROP TABLE enum_rmt2 SYNC;

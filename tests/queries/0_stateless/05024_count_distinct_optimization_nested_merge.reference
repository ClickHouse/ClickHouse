-- { echoOn }
SELECT uniqExact(c0) FROM merge(currentDatabase(), '^(m_inner|t_mem)$')
    SETTINGS distributed_group_by_no_merge = 1;
10
SELECT uniqExact(c0) FROM merge(currentDatabase(), '^(m_inner|t_mem)$');
10

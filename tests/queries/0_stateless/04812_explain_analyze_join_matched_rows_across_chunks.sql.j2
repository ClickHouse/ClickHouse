-- Tags: no-parallel-replicas
-- no-parallel-replicas: EXPLAIN ANALYZE rejects distributed plans (NOT_IMPLEMENTED).

-- Rows of one equal range can be spread over several chunks, and a merge join sees them as separate
-- fragments. Every row here has a partner, so `matched` must equal `rows` on both sides whatever
-- `max_block_size` cuts the chunks at. Ten inserts per side make the sorted inputs arrive as several
-- chunks. The runs are 100 rows per key on the left and 60 on the right, so the three block sizes
-- below cover the three distinct shapes: 8 splits the equal range on both sides, 64 splits only the
-- left one, and 1000 splits neither. `parallel_full_sorting_merge` is the same assertion over a
-- sharded plan, in `04813_explain_analyze_join_matched_rows_across_chunks_parallel`.

SET enable_analyzer = 1;
SET query_plan_join_swap_table = 0;
SET enable_join_runtime_filters = 0;
SET join_use_nulls = 0;

DROP TABLE IF EXISTS left_side;
DROP TABLE IF EXISTS right_side;
CREATE TABLE left_side (k UInt64) ENGINE = Memory;
CREATE TABLE right_side (k UInt64) ENGINE = Memory;

{% for _ in range(10) -%}
INSERT INTO left_side SELECT number % 4 FROM numbers(40);
INSERT INTO right_side SELECT number % 4 FROM numbers(24);
{% endfor %}
SELECT 'ground truth: rows, matched';
SELECT count(), countIf(k IN (SELECT k FROM right_side)) FROM left_side;
SELECT count(), countIf(k IN (SELECT k FROM left_side)) FROM right_side;

{% set kinds = ['ALL INNER', 'ALL LEFT', 'ALL RIGHT', 'ALL FULL', 'ANY INNER', 'ANY LEFT', 'ANY RIGHT'] -%}

SELECT 'full_sorting_merge';
{% for kind in kinds -%}
{% for block_size in [8, 64, 1000] -%}
SELECT '{{ kind }}' AS kind, {{ block_size }} AS max_block_size,
    maxIf(extract(explain, 'rows ([0-9]+)'), explain LIKE '%Left: rows%')
        = maxIf(extract(explain, 'matched (not collected|[0-9]+)'), explain LIKE '%Left: rows%') AS all_left_rows_matched,
    maxIf(extract(explain, 'rows ([0-9]+)'), explain LIKE '%Right: rows%')
        = maxIf(extract(explain, 'matched (not collected|[0-9]+)'), explain LIKE '%Right: rows%') AS all_right_rows_matched
FROM (EXPLAIN ANALYZE matches=1 SELECT count() FROM left_side AS l {{ kind }} JOIN right_side AS r ON l.k = r.k SETTINGS join_algorithm = 'full_sorting_merge', max_block_size = {{ block_size }});
{% endfor -%}
{% endfor -%}

DROP TABLE left_side;
DROP TABLE right_side;

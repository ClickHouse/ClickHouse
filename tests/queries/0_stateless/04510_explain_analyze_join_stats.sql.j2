SET enable_analyzer = 1;

DROP TABLE IF EXISTS t1;
DROP TABLE IF EXISTS t2;
CREATE TABLE t1 (x UInt64, t UInt64) ENGINE = MergeTree ORDER BY x;
CREATE TABLE t2 (x UInt64, t UInt64) ENGINE = MergeTree ORDER BY x;
INSERT INTO t1 SELECT number % 500, number FROM numbers(1000);
INSERT INTO t2 SELECT number % 500, number FROM numbers(1000);

{% set all_kinds = [
    'ALL INNER JOIN t2 ON t1.x = t2.x',
    'ALL LEFT JOIN t2 ON t1.x = t2.x',
    'ALL RIGHT JOIN t2 ON t1.x = t2.x',
    'ALL FULL JOIN t2 ON t1.x = t2.x',
] -%}

{% set cases = [
    ('hash', '',
        all_kinds + [
            'ANY INNER JOIN t2 ON t1.x = t2.x',
            'ANY LEFT JOIN t2 ON t1.x = t2.x',
            'ANY RIGHT JOIN t2 ON t1.x = t2.x',
            'SEMI LEFT JOIN t2 ON t1.x = t2.x',
            'SEMI RIGHT JOIN t2 ON t1.x = t2.x',
            'ANTI LEFT JOIN t2 ON t1.x = t2.x',
            'ANTI RIGHT JOIN t2 ON t1.x = t2.x',
            'ASOF JOIN t2 ON t1.x = t2.x AND t1.t >= t2.t',
            'ASOF LEFT JOIN t2 ON t1.x = t2.x AND t1.t >= t2.t',
        ],
        "countIf(explain LIKE '%Left: rows%') = 1 AND countIf(explain LIKE '%Right: rows%') = 1 AND countIf(explain LIKE '%matched %') = 2 AND countIf(explain LIKE '%match rate%') = 2 AND countIf(explain LIKE '%unique keys%') = 1 AND countIf(explain LIKE '%· memory %') = 1"),

    ('parallel_hash', '',
        all_kinds + [
            'ANY INNER JOIN t2 ON t1.x = t2.x',
            'ANY LEFT JOIN t2 ON t1.x = t2.x',
            'ANY RIGHT JOIN t2 ON t1.x = t2.x',
            'SEMI LEFT JOIN t2 ON t1.x = t2.x',
            'SEMI RIGHT JOIN t2 ON t1.x = t2.x',
            'ANTI LEFT JOIN t2 ON t1.x = t2.x',
            'ANTI RIGHT JOIN t2 ON t1.x = t2.x',
        ],
        "countIf(explain LIKE '%Left: rows%') = 1 AND countIf(explain LIKE '%Right: rows%') = 1 AND countIf(explain LIKE '%matched %') = 2 AND countIf(explain LIKE '%match rate%') = 2 AND countIf(explain LIKE '%unique keys%') = 1 AND countIf(explain LIKE '%· memory %') = 1"),

    ('grace_hash', ', max_bytes_before_external_join = 1',
        all_kinds + [
            'ANY INNER JOIN t2 ON t1.x = t2.x',
            'ANY LEFT JOIN t2 ON t1.x = t2.x',
            'ANY RIGHT JOIN t2 ON t1.x = t2.x',
            'SEMI LEFT JOIN t2 ON t1.x = t2.x',
            'SEMI RIGHT JOIN t2 ON t1.x = t2.x',
            'ANTI LEFT JOIN t2 ON t1.x = t2.x',
            'ANTI RIGHT JOIN t2 ON t1.x = t2.x',
        ],
        "countIf(explain LIKE '%Left: rows%') = 1 AND countIf(explain LIKE '%Right: rows%') = 1 AND countIf(explain LIKE '%matched %') = 2 AND countIf(explain LIKE '%match rate%') = 2 AND countIf(explain LIKE '%unique keys%') = 1 AND countIf(explain LIKE '%· memory %') = 1 AND countIf(explain LIKE '%buckets%') = 1 AND countIf(explain LIKE '%rehashes%') = 1 AND countIf(explain LIKE '%Spill:%') = 1"),

    ('partial_merge', '',
        all_kinds + [
            'ANY INNER JOIN t2 ON t1.x = t2.x',
            'ANY LEFT JOIN t2 ON t1.x = t2.x',
            'SEMI LEFT JOIN t2 ON t1.x = t2.x',
        ],
        "countIf(explain LIKE '%Left: rows%') = 1 AND countIf(explain LIKE '%Right: rows%') = 1 AND countIf(explain LIKE '%matched %') = 2 AND countIf(explain LIKE '%match rate%') = 2 AND countIf(explain LIKE '%· size %') = 1 AND countIf(explain LIKE '%· blocks %') = 1 AND countIf(explain LIKE '%storage%') = 1 AND countIf(explain LIKE '%sort time%') = 2"),

    ('full_sorting_merge', '',
        all_kinds + [
            'ANY INNER JOIN t2 ON t1.x = t2.x',
            'ANY LEFT JOIN t2 ON t1.x = t2.x',
            'ANY RIGHT JOIN t2 ON t1.x = t2.x',
            'ASOF JOIN t2 ON t1.x = t2.x AND t1.t >= t2.t',
            'ASOF LEFT JOIN t2 ON t1.x = t2.x AND t1.t >= t2.t',
        ],
        "countIf(explain LIKE '%Left: rows%') = 1 AND countIf(explain LIKE '%Right: rows%') = 1 AND countIf(explain LIKE '%matched %') = 2 AND countIf(explain LIKE '%match rate%') = 2"),
] -%}

{% for algo, extra, combos, checks in cases -%}
{% for jc in combos -%}
SELECT {{ checks }}
FROM (EXPLAIN ANALYZE SELECT * FROM t1 {{ jc }} SETTINGS join_algorithm = '{{ algo }}'{{ extra }});
{% endfor -%}
{% endfor -%}

DROP TABLE t1;
DROP TABLE t2;

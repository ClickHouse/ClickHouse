#!/usr/bin/env python3

import os
import socket
import sys
import threading
import traceback
import urllib.request
from http.server import BaseHTTPRequestHandler, HTTPServer


def is_ipv6(host):
    try:
        socket.inet_aton(host)
        return False
    except:
        return True


def get_local_port(host, ipv6):
    family = socket.AF_INET6 if ipv6 else socket.AF_INET
    with socket.socket(family) as fd:
        fd.bind((host, 0))
        return fd.getsockname()[1]


CLICKHOUSE_HOST = os.environ.get("CLICKHOUSE_HOST", "localhost")
CLICKHOUSE_PORT_HTTP = os.environ.get("CLICKHOUSE_PORT_HTTP", "8123")

# The dictionary source is served from this script, so the address has to be reachable
# from the clickhouse server under test.
HTTP_SERVER_HOST = socket.getaddrinfo(
    os.environ.get("CLICKHOUSE_HOST", "127.0.0.1"), None
)[0][4][0]
IS_IPV6 = is_ipv6(HTTP_SERVER_HOST)
HTTP_SERVER_PORT = get_local_port(HTTP_SERVER_HOST, IS_IPV6)
HTTP_SERVER_ADDRESS = (HTTP_SERVER_HOST, HTTP_SERVER_PORT)

if IS_IPV6:
    HTTP_SERVER_URL_STR = f"http://[{HTTP_SERVER_ADDRESS[0]}]:{HTTP_SERVER_ADDRESS[1]}/"
else:
    HTTP_SERVER_URL_STR = f"http://{HTTP_SERVER_ADDRESS[0]}:{HTTP_SERVER_ADDRESS[1]}/"

CSV_DATA = "Hello,1\n"


def get_ch_answer(query):
    url = os.environ.get(
        "CLICKHOUSE_URL",
        "http://{host}:{port}".format(
            host=f"[{CLICKHOUSE_HOST}]" if IS_IPV6 else CLICKHOUSE_HOST,
            port=CLICKHOUSE_PORT_HTTP,
        ),
    )
    return urllib.request.urlopen(url, data=query.encode()).read().decode()


def check_answer(query, answer):
    ch_answer = get_ch_answer(query)
    if ch_answer.strip() != answer.strip():
        print("FAIL on query:", query, file=sys.stderr)
        print("Expected answer:", answer, file=sys.stderr)
        print("Fetched answer :", ch_answer, file=sys.stderr)
        raise Exception("Fail on query")


class HttpProcessor(BaseHTTPRequestHandler):
    def _set_headers(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/csv")
        self.send_header("Content-Length", len(CSV_DATA.encode()))
        self.end_headers()

    def do_HEAD(self):
        self._set_headers()

    def do_GET(self):
        self._set_headers()
        self.wfile.write(CSV_DATA.encode())

    def log_message(self, format, *args):
        return


class HTTPServerV6(HTTPServer):
    address_family = socket.AF_INET6


def start_server():
    """Serve the dictionary source until the test exits.

    The number of source reads is not fixed: a `direct` dictionary re-reads its source on
    every lookup, so serving a counted number of requests would hang whenever that count
    is short.
    """
    httpd = (HTTPServerV6 if IS_IPV6 else HTTPServer)(
        HTTP_SERVER_ADDRESS, HttpProcessor
    )
    thread = threading.Thread(target=httpd.serve_forever)
    thread.daemon = True
    return thread


def create_dict(name, layout, lifetime):
    get_ch_answer(f"DROP DICTIONARY IF EXISTS {name}")
    get_ch_answer(
        """CREATE DICTIONARY {name} (word String, counter UInt32)
        PRIMARY KEY word
        SOURCE(HTTP(url '{url}' format 'CSV'))
        LAYOUT({layout})
        {lifetime}""".format(
            name=name,
            url=HTTP_SERVER_URL_STR + "test.csv",
            layout=layout,
            lifetime=lifetime,
        )
    )


def main():
    start_server().start()

    # `merge` wraps every child's output in `materialize`, which rejects a header carrying rows.
    # `LIFETIME` is rejected as redundant for the `direct` layout, which reads its source every time.
    create_dict("dict_direct", "direct()", "")
    check_answer("SELECT * FROM merge(currentDatabase(), '^dict_direct$')", "Hello\t1")
    check_answer("SELECT * FROM dict_direct", "Hello\t1")

    # A layout that builds its own header from the dictionary structure stays unaffected.
    create_dict("dict_hashed", "complex_key_hashed()", "LIFETIME(0)")
    check_answer("SELECT * FROM merge(currentDatabase(), '^dict_hashed$')", "Hello\t1")
    check_answer("SELECT * FROM dict_hashed", "Hello\t1")

    print("PASSED")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        exc_type, exc_value, exc_traceback = sys.exc_info()
        traceback.print_tb(exc_traceback, file=sys.stderr)
        print(exc_value, file=sys.stderr)
        sys.stderr.flush()
        os._exit(1)

-- { echo }

DROP TABLE IF EXISTS t_map_bf;
DROP TABLE IF EXISTS t_map_b;
CREATE TABLE t_map_bf
(
    `id` UInt32,
    `m` Map(String, String),
    INDEX idx_mk mapKeys(m) TYPE binary_fuse_filter(0.05) GRANULARITY 1
)
ENGINE = MergeTree
ORDER BY id
SETTINGS index_granularity = 1;
CREATE TABLE t_map_b
(
    `id` UInt32,
    `m` Map(String, String),
    INDEX idx_mk mapKeys(m) TYPE bloom_filter(0.05) GRANULARITY 1
)
ENGINE = MergeTree
ORDER BY id
SETTINGS index_granularity = 1;
INSERT INTO t_map_bf VALUES (0, {'K0': 'V0'}), (1, {'K1': 'V1'});
INSERT INTO t_map_b VALUES (0, {'K0': 'V0'}), (1, {'K1': 'V1'});
SELECT count() FROM t_map_bf WHERE m['K0'] = 'V0' SETTINGS force_data_skipping_indices = 'idx_mk';
1
SELECT count() FROM t_map_b WHERE m['K0'] = 'V0' SETTINGS force_data_skipping_indices = 'idx_mk';
1
SELECT count() FROM t_map_bf WHERE m['K9'] = 'V9' SETTINGS force_data_skipping_indices = 'idx_mk';
0
SELECT count() FROM t_map_b WHERE m['K9'] = 'V9' SETTINGS force_data_skipping_indices = 'idx_mk';
0
DROP TABLE t_map_bf;
DROP TABLE t_map_b;
-- mapContains / mapContainsKey / mapContainsValue named function coverage
DROP TABLE IF EXISTS t_map_named_bf;
DROP TABLE IF EXISTS t_map_named_b;
CREATE TABLE t_map_named_bf
(
    `k` UInt64,
    `m` Map(String, String),
    INDEX idx_mk mapKeys(m) TYPE binary_fuse_filter(0.025) GRANULARITY 1,
    INDEX idx_mv mapValues(m) TYPE binary_fuse_filter(0.025) GRANULARITY 1
)
ENGINE = MergeTree
ORDER BY k
SETTINGS index_granularity = 1;
CREATE TABLE t_map_named_b
(
    `k` UInt64,
    `m` Map(String, String),
    INDEX idx_mk mapKeys(m) TYPE bloom_filter(0.025) GRANULARITY 1,
    INDEX idx_mv mapValues(m) TYPE bloom_filter(0.025) GRANULARITY 1
)
ENGINE = MergeTree
ORDER BY k
SETTINGS index_granularity = 1;
INSERT INTO t_map_named_bf SELECT number, map('K0', 'V0', 'K1', 'V1') FROM numbers(200);
INSERT INTO t_map_named_b SELECT number, map('K0', 'V0', 'K1', 'V1') FROM numbers(200);
OPTIMIZE TABLE t_map_named_bf FINAL;
OPTIMIZE TABLE t_map_named_b FINAL;
SELECT count() FROM t_map_named_bf WHERE mapContains(m, 'K0') SETTINGS force_data_skipping_indices = 'idx_mk';
200
SELECT count() FROM t_map_named_b WHERE mapContains(m, 'K0') SETTINGS force_data_skipping_indices = 'idx_mk';
200
SELECT count() FROM t_map_named_bf WHERE mapContains(m, 'K9') SETTINGS force_data_skipping_indices = 'idx_mk';
0
SELECT count() FROM t_map_named_b WHERE mapContains(m, 'K9') SETTINGS force_data_skipping_indices = 'idx_mk';
0
SELECT count() FROM t_map_named_bf WHERE mapContainsKey(m, 'K0') SETTINGS force_data_skipping_indices = 'idx_mk';
200
SELECT count() FROM t_map_named_b WHERE mapContainsKey(m, 'K0') SETTINGS force_data_skipping_indices = 'idx_mk';
200
SELECT count() FROM t_map_named_bf WHERE mapContainsKey(m, 'K9') SETTINGS force_data_skipping_indices = 'idx_mk';
0
SELECT count() FROM t_map_named_b WHERE mapContainsKey(m, 'K9') SETTINGS force_data_skipping_indices = 'idx_mk';
0
SELECT count() FROM t_map_named_bf WHERE mapContainsValue(m, 'V0') SETTINGS force_data_skipping_indices = 'idx_mv';
200
SELECT count() FROM t_map_named_b WHERE mapContainsValue(m, 'V0') SETTINGS force_data_skipping_indices = 'idx_mv';
200
SELECT count() FROM t_map_named_bf WHERE mapContainsValue(m, 'V9') SETTINGS force_data_skipping_indices = 'idx_mv';
0
SELECT count() FROM t_map_named_b WHERE mapContainsValue(m, 'V9') SETTINGS force_data_skipping_indices = 'idx_mv';
0
DROP TABLE t_map_named_bf;
DROP TABLE t_map_named_b;
DROP TABLE IF EXISTS t_arr_bf;
DROP TABLE IF EXISTS t_arr_b;
CREATE TABLE t_arr_bf
(
    `id` UInt32,
    `a` Array(String),
    INDEX idx_a a TYPE binary_fuse_filter(0.05) GRANULARITY 1
)
ENGINE = MergeTree
ORDER BY id
SETTINGS index_granularity = 1;
CREATE TABLE t_arr_b
(
    `id` UInt32,
    `a` Array(String),
    INDEX idx_a a TYPE bloom_filter(0.05) GRANULARITY 1
)
ENGINE = MergeTree
ORDER BY id
SETTINGS index_granularity = 1;
INSERT INTO t_arr_bf VALUES (0, ['p', 'q']), (1, ['r']);
INSERT INTO t_arr_b VALUES (0, ['p', 'q']), (1, ['r']);
SELECT count() FROM t_arr_bf WHERE hasAny(a, ['p']) SETTINGS force_data_skipping_indices = 'idx_a';
1
SELECT count() FROM t_arr_b WHERE hasAny(a, ['p']) SETTINGS force_data_skipping_indices = 'idx_a';
1
SELECT count() FROM t_arr_bf WHERE hasAny(a, ['zzz']) SETTINGS force_data_skipping_indices = 'idx_a';
0
SELECT count() FROM t_arr_b WHERE hasAny(a, ['zzz']) SETTINGS force_data_skipping_indices = 'idx_a';
0
SELECT count() FROM t_arr_bf WHERE hasAll(a, ['p', 'q']) SETTINGS force_data_skipping_indices = 'idx_a';
1
SELECT count() FROM t_arr_b WHERE hasAll(a, ['p', 'q']) SETTINGS force_data_skipping_indices = 'idx_a';
1
SELECT count() FROM t_arr_bf WHERE hasAll(a, ['p', 'zzz']) SETTINGS force_data_skipping_indices = 'idx_a';
0
SELECT count() FROM t_arr_b WHERE hasAll(a, ['p', 'zzz']) SETTINGS force_data_skipping_indices = 'idx_a';
0
DROP TABLE t_arr_bf;
DROP TABLE t_arr_b;
DROP TABLE IF EXISTS t_tpl_bf;
DROP TABLE IF EXISTS t_tpl_b;
CREATE TABLE t_tpl_bf
(
    `id` UInt32,
    `x` UInt64,
    `y` UInt64,
    INDEX idx_xy tuple(x, y) TYPE binary_fuse_filter(0.05) GRANULARITY 1
)
ENGINE = MergeTree
ORDER BY id
SETTINGS index_granularity = 1;
CREATE TABLE t_tpl_b
(
    `id` UInt32,
    `x` UInt64,
    `y` UInt64,
    INDEX idx_xy tuple(x, y) TYPE bloom_filter(0.05) GRANULARITY 1
)
ENGINE = MergeTree
ORDER BY id
SETTINGS index_granularity = 1;
INSERT INTO t_tpl_bf VALUES (0, 10, 20), (1, 30, 40);
INSERT INTO t_tpl_b VALUES (0, 10, 20), (1, 30, 40);
SELECT count() FROM t_tpl_bf WHERE x = 10 AND y = 20 SETTINGS force_data_skipping_indices = 'idx_xy';
1
SELECT count() FROM t_tpl_b WHERE x = 10 AND y = 20 SETTINGS force_data_skipping_indices = 'idx_xy';
1
SELECT count() FROM t_tpl_bf WHERE x = 99 AND y = 99 SETTINGS force_data_skipping_indices = 'idx_xy';
0
SELECT count() FROM t_tpl_b WHERE x = 99 AND y = 99 SETTINGS force_data_skipping_indices = 'idx_xy';
0
DROP TABLE t_tpl_bf;
DROP TABLE t_tpl_b;
-- The false positive rate argument is optional.
DROP TABLE IF EXISTS t_default_bf;
CREATE TABLE t_default_bf
(
    `k` UInt64,
    INDEX idx_k k TYPE binary_fuse_filter GRANULARITY 1
)
ENGINE = MergeTree
ORDER BY tuple()
SETTINGS index_granularity = 64;
INSERT INTO t_default_bf SELECT number FROM numbers(200);
SELECT count() FROM t_default_bf WHERE k = 137 SETTINGS force_data_skipping_indices = 'idx_k';
1
SELECT count() FROM t_default_bf WHERE k IN (1000000, 1000001) SETTINGS force_data_skipping_indices = 'idx_k';
0
DROP TABLE t_default_bf;

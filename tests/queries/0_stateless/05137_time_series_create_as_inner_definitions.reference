-- the other table must be a TimeSeries table
-- declared engines without keys get the generated keys
AggregatingMergeTree PARTITION BY toYYYYMM(bucket) ORDER BY (id, bucket) SETTINGS index_granularity = 512, index_granularity_bytes = 524288
AggregatingMergeTree PARTITION BY toStartOfInterval(bucket, toIntervalHour(5)) ORDER BY (id, bucket) TTL bucket + toIntervalSecond(346500) SETTINGS index_granularity = 256, index_granularity_bytes = 262144, ttl_only_drop_parts = 1
AggregatingMergeTree PRIMARY KEY metric_name ORDER BY (metric_name, id) SETTINGS index_granularity = 8192, allow_dimensions_outside_sorting_key = 1
ReplacingMergeTree ORDER BY metric_family_name
-- a customized `min_time` column is not copied if the new table does not store `min_time`/`max_time`
`id` Tuple(UInt64, LowCardinality(UUID)) DEFAULT tuple(sipHash64(metric_name), toLowCardinality(reinterpretAsUUID(sipHash128(tags)))), `metric_name` LowCardinality(String), `tags` Map(LowCardinality(String), String)
AggregatingMergeTree PRIMARY KEY metric_name ORDER BY (metric_name, id) SETTINGS index_granularity = 8192, allow_dimensions_outside_sorting_key = 1
-- `tags_to_columns` written in the query replaces the copied one: the column of a removed tag is not copied,
-- the column of an added tag is generated
`id` Tuple(UInt64, LowCardinality(UUID)) DEFAULT tuple(sipHash64(metric_name), toLowCardinality(reinterpretAsUUID(sipHash128(tags)))), `metric_name` LowCardinality(String), `instance` String, `region` String, `tags` Map(LowCardinality(String), String), `min_time` SimpleAggregateFunction(min, Nullable(DateTime64(3))), `max_time` SimpleAggregateFunction(max, Nullable(DateTime64(3)))
-- the customized parts are copied, the generated parts follow the settings of the new table: `min_time`/`max_time`
-- are not aggregated, so the tags engine is ReplacingMergeTree with them in the sorting key, and keeps its settings
`id` UInt64, `samples` SimpleAggregateFunction(timeSeriesGroupArray, Array(Tuple(timestamp DateTime64(6), value Float64))) CODEC(ZSTD(1)), `bucket` DateTime64(6) CODEC(DoubleDelta, ZSTD(1)), `min_time` SimpleAggregateFunction(min, DateTime64(6)) CODEC(DoubleDelta, ZSTD(1)), `max_time` SimpleAggregateFunction(max, DateTime64(6)) CODEC(DoubleDelta, ZSTD(1)), `extra` SimpleAggregateFunction(anyLast, UInt8)
`id` UInt64 DEFAULT sipHash64(tags), `metric_name` LowCardinality(String), `tags` Map(LowCardinality(String), String), `min_time` Nullable(DateTime64(6)), `max_time` Nullable(DateTime64(6))
ReplacingMergeTree PRIMARY KEY metric_name ORDER BY (metric_name, id, min_time, max_time) SETTINGS index_granularity = 1024, min_bytes_for_wide_part = 0, allow_nullable_key = 1
-- the types declared in the query win over the types of the other table, the other types are inherited: the timestamps and
-- values are DateTime64(3) and Float32 as declared, `id` is UInt64 as in `ts_src`. The declared samples column replaces the copied one
`id` UInt64, `samples` SimpleAggregateFunction(timeSeriesGroupArray, Array(Tuple(timestamp DateTime64(3), value Float32))), `bucket` DateTime64(3) CODEC(DoubleDelta, ZSTD(1)), `min_time` SimpleAggregateFunction(min, DateTime64(3)) CODEC(DoubleDelta, ZSTD(1)), `max_time` SimpleAggregateFunction(max, DateTime64(3)) CODEC(DoubleDelta, ZSTD(1))
`id` UInt64, `samples` SimpleAggregateFunction(timeSeriesGroupArray, Array(Tuple(timestamp DateTime64(3) CODEC(DoubleDelta, ZSTD(1)), value Float32 CODEC(ZSTD(3))))), `bucket` DateTime64(3) CODEC(DoubleDelta, ZSTD(1)), `min_time` SimpleAggregateFunction(min, DateTime64(3)) CODEC(DoubleDelta, ZSTD(1)), `max_time` SimpleAggregateFunction(max, DateTime64(3)) CODEC(DoubleDelta, ZSTD(1))
`id` UInt64 DEFAULT sipHash64(tags), `metric_name` LowCardinality(String), `tags` Map(LowCardinality(String), String), `min_time` SimpleAggregateFunction(min, Nullable(DateTime64(3))), `max_time` SimpleAggregateFunction(max, Nullable(DateTime64(3)))
-- `id_generator` of the other table was written for its `id` type, so it is copied only if the `id` type stays the same

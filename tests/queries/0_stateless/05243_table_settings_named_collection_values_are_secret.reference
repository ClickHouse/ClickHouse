-- the reader may read every system table, and still sees no collection
0
-- nor may it read the table's definition, which would name the collection
ACCESS_DENIED
-- so system.table_settings names the settings the collection supplied, and hides their values
kafka_broker_list	[HIDDEN]	1	named_collection
kafka_format	[HIDDEN]	1	named_collection
kafka_group_name	[HIDDEN]	1	named_collection
kafka_topic_list	[HIDDEN]	1	named_collection
-- and a setting the table's own clause states is reported as before
kafka_max_block_size	4242	0	definition

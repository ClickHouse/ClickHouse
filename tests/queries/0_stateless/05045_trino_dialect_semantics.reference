-- ... and a set operation keeps the numeric supertype, not Variant
Nullable(Float64)
-- ... and hold for a wrapping INSERT ... SELECT
\N
-- LEFT JOIN UNNEST over an empty array yields NULL, not the default
1	10
1	20

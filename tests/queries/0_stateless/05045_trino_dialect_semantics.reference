-- CROSS JOIN UNNEST of arrays of different lengths pads with NULLs
1	x
2	y
3	\N
-- the column aliases of a joined UNNEST are reachable through its table alias
a	1
b	2
-- array_agg keeps NULL elements
[1,NULL,2]
[1,NULL]
-- the aggregates return NULL over an empty input, also with DISTINCT

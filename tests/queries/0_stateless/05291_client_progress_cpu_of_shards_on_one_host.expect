#!/usr/bin/expect -f

# Regression test for the CPU figure of a distributed query whose shards share one host name:
# the server forwards the `ProfileEvents` of every shard to the client, and one packet can carry
# several `INCREMENT` rows of the same host - the rows of the initiator and of every remote shard
# of the same server, and several queued snapshots of one shard. The client must sum them up:
# keeping only the last row per host understates the CPU usage and makes it incomparable to the
# `waited` figure, which is summed up.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0

log_user 0
set timeout 60
match_max 100000
# The resource usage annotation is shown only when the progress bar is wider than twice the
# annotation, so the terminal has to be wide enough for it to fit.
set stty_init "rows 25 cols 240"

expect_after {
    -i $any_spawn_id eof { exp_continue }
    -i $any_spawn_id timeout { exit 1 }
}

spawn bash --noprofile --norc -c "PS1='bash) ' bash --noprofile --norc"
send "source $basedir/../shell_config.sh\r"
expect "bash) "

# Four shards on the same server, each of them run through its own connection (the local replica
# is not preferred), each one busy on a single thread: together they use about 4 cores, all of them
# reported under the same host name. The query does not end by itself and is cancelled as soon as
# the figure is seen. Parallel replicas are pinned off, so that each shard is read by one thread.
send "\$CLICKHOUSE_CLIENT --progress --max_threads 1 --prefer_localhost_replica 0 --enable_parallel_replicas 0 --automatic_parallel_replicas_mode 0 --query \"SELECT count() FROM remote('127.0.0.1,127.0.0.1,127.0.0.1,127.0.0.1', numbers(1000000000000)) WHERE NOT ignore(sipHash64(number))\" >/dev/null 2>&1\r"

# At least 3 cores. The shards use about 4 cores in total, and so does the figure when all the
# rows are summed up, while keeping only the last row per host shows at most about 2.5 cores.
expect -re {\(([3-9]|[1-9][0-9]+)\.[0-9] CPU}

send "\3"
expect "bash) "

send "exit\r"
expect eof

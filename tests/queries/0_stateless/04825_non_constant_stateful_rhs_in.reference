-- The row-wise rewrite of `IN` with a non-constant RHS must evaluate the RHS expression
-- exactly once per row, even though the rewrite refers to it multiple times
-- (`tupleElement(rhs, 1)`, `tupleElement(rhs, 2)`, ...). If the RHS were reevaluated
-- independently for each reference, a stateful RHS such as `if(rand64() % 2 = 0, (1, 3), (3, 1))`
-- could produce a mixed element set like `(1, 1)`, and `3 IN rhs` would sometimes be `0`.
-- With a single evaluation, `3` is a member of both `(1, 3)` and `(3, 1)`, so the result is always `1`.

-- { echoOn }

-- Tuple-valued stateful RHS, literal tuple arguments.
SELECT min(3 IN (if(rand64() % 2 = 0, (1, 3), (3, 1)))), max(3 IN (if(rand64() % 2 = 0, (1, 3), (3, 1)))) FROM numbers(100000) SETTINGS enable_analyzer = 1;
1	1
-- Tuple-typed stateful RHS (not a literal `tuple` function): goes through the
-- `tupleElement`-expansion path driven by the RHS type.
SELECT min(3 IN (if(rand64() % 2 = 0, materialize((1, 3)), materialize((3, 1))))), max(3 IN (if(rand64() % 2 = 0, materialize((1, 3)), materialize((3, 1))))) FROM numbers(100000) SETTINGS enable_analyzer = 1;
1	1
-- Array-valued stateful RHS.
SELECT min(3 IN (if(rand64() % 2 = 0, [1, 3], [3, 1]))), max(3 IN (if(rand64() % 2 = 0, [1, 3], [3, 1]))) FROM numbers(100000) SETTINGS enable_analyzer = 1;
1	1
-- Stateful nullable LHS: the rewrite refers to the LHS from both `isNull` and `has`.
-- A single evaluation returns `NULL` or `1` per row, never `0`.
SELECT min(if(rand64() % 2 = 0, NULL, toNullable(3)) IN (materialize(1), materialize(3))), max(if(rand64() % 2 = 0, NULL, toNullable(3)) IN (materialize(1), materialize(3))) FROM numbers(100000) SETTINGS enable_analyzer = 1;
1	1
-- `min`/`max` ignore NULL, so they alone cannot detect a regression that rewrites the NULL
-- rows to a non-NULL value. Assert explicitly that both NULL and `1` results are present
-- and that no row produced `0`.
SELECT countIf(isNull(if(rand64() % 2 = 0, NULL, toNullable(3)) IN (materialize(1), materialize(3)))) > 0, countIf(if(rand64() % 2 = 0, NULL, toNullable(3)) IN (materialize(1), materialize(3)) = 1) > 0, countIf(if(rand64() % 2 = 0, NULL, toNullable(3)) IN (materialize(1), materialize(3)) = 0) FROM numbers(100000) SETTINGS enable_analyzer = 1;
1	1	0

#!/usr/bin/expect -f

# Regression test: the single-line continuation probe
# `ClientBase::queryNeedsContinuation` must follow the same per-statement dialect
# transitions as the multi-statement executor. A buffer that switches dialect
# mid-stream with `SET dialect = ...` and ends with an incomplete statement in the
# new dialect must continue (fold onto the next line), not commit and run the
# earlier statements. Started from the default (clickhouse) dialect,
# `SET dialect = 'kusto'` switches the statements that follow to Kusto; if the
# probe kept using the SQL parser it would fail on the `let`, decide the buffer is
# complete, and submit it -- executing the `SET` and `let x = 1` even though the
# final `print` is still incomplete.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0
set history_file $CLICKHOUSE_TMP/$basename.history

log_user 0
set timeout 60
match_max 100000

expect_after {
    # Do not ignore eof from expect
    -i $any_spawn_id eof { exp_continue }
    # A default timeout action is to do nothing, change it to fail
    -i $any_spawn_id timeout { exit 1 }
}

spawn bash -c "source $basedir/../shell_config.sh ; TERM=xterm \$CLICKHOUSE_LOCAL --format PrettyCompact --allow_experimental_kusto_dialect 1 --disable_suggestion --enable-progress-table-toggle=0 --history_file=$history_file"
expect ":) "

# The buffer switches to Kusto mid-stream and ends with an incomplete `print`
# (no expression yet). Because the probe reparses `let x = 1; print` under Kusto
# after the `SET`, it sees the final `print` is incomplete and continues on the
# next line instead of submitting. If it were submitted, the `print` would report
# a syntax error (and the `SET` + `let x = 1` would already have run).
send -- "SET dialect = 'kusto'; let x = 1; print\r"
# Give the client time to react to the <ENTER> on its own: two lines sent back to
# back arrive in a single read and are inserted as one pasted block, which would
# fold the buffer regardless of what the continuation probe decides.
sleep 1
# Complete the query on the continuation line. The whole buffer now runs as one:
# `SET` switches to Kusto, `let x = 1` binds `x`, and `print x` prints 1.
send -- "x\r"
expect {
    "Syntax error" { exit 1 }
    "Unknown expression identifier" { exit 1 }
    "│ 1 │" {}
}
expect ":) "

send -- "\4"
expect eof

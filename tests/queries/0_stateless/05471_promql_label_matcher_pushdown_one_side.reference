req i1
req{job="api"} * on(job) group_left(owner) info
info api
req api
info * on(job) group_right(owner) req{job="api"}
info api
req api
req{instance="i1"} / ignoring(team) group_left sum without (team) (lim)
lim i1
req i1
(req{instance="i1"} - ignoring(team) lim) / on(instance) lim
lim
lim i1
req i1
req{instance="i1"} / on(instance) label_replace(lim, "x", "y", "", "")
lim
req i1
rate({__name__=~"m1|m2", a="2"}[1m]) / on(a) m3
2
m3

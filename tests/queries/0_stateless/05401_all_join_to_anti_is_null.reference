-- LEFT ALL JOIN
Strictness: ANTI
[5,6,7,8,9]
-- RIGHT ALL JOIN
Strictness: ANTI
[5,6,7,8,9]
-- IS NULL AND another condition
Strictness: ANTI
[7,8,9]
-- IS NOT NULL is not converted to SEMI: ALL JOIN keeps every match
Strictness: ALL
[0,0,1,1,2,2,3,3,4,4]
-- Nullable keys
Strictness: ANTI
[0,5,6,7,8,9]
-- <=> matches NULL keys, so it is not converted
Strictness: ALL
[0,0,0,0,0,5,6,7,8,9]
-- Dynamic holds NULL without being Nullable, so it is not converted
Strictness: ALL
[0,1,3,4,5,6,7,8,9]

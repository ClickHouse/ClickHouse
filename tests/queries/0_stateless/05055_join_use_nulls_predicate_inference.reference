-- LEFT JOIN, predicate on the right key only, join_use_nulls = 1: lk is inferred
Condition: (_CAST(lk, \'Nullable(UInt64)\') in [80, 80])
Condition: (toNullable(rk) in [80, 80])
-- the same at join_use_nulls = 0, which already inferred it
Condition: (lk in [80, 80])
Condition: (rk in [80, 80])
-- RIGHT JOIN, predicate on the left key only, join_use_nulls = 1: rk is inferred
Condition: (toNullable(lk) in [80, 80])
Condition: (_CAST(rk, \'Nullable(UInt64)\') in [80, 80])
Type: INNER
-- FULL JOIN converted to RIGHT, join_use_nulls = 1: lk is inferred, rk is filtered directly
Condition: (_CAST(lk, \'Nullable(UInt64)\') in [80, 80])
Condition: (toNullable(rk) in [80, 80])
Type: RIGHT
-- FULL JOIN converted to LEFT, join_use_nulls = 1: rk is inferred, lk is filtered directly
Condition: (toNullable(lk) in [80, 80])
Condition: (_CAST(rk, \'Nullable(UInt64)\') in [80, 80])
Type: LEFT
-- FULL JOIN converted to INNER, join_use_nulls = 1: each key is inferred next to its own predicate
Condition: and((_CAST(lk, \'Nullable(UInt64)\') in [80, 80]), (toNullable(lk) in [80, 80]))
Condition: and((_CAST(rk, \'Nullable(UInt64)\') in [80, 80]), (toNullable(rk) in [80, 80]))
Type: INNER
-- a predicate on a non-key column infers nothing, so lk stays unconstrained
Condition: true
Condition: true
-- a LEFT JOIN that is not converted keeps its not-matched rows, so nothing may be inferred
Condition: true
Condition: true

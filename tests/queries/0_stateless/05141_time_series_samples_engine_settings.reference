-- the defaults: one partition per month for the samples table, 5-hour partitions for the recent samples table
recentsamples	AggregatingMergeTree PARTITION BY toStartOfInterval(toDateTime(bucket, \'UTC\'), toIntervalHour(5)) ORDER BY (id, bucket) TTL toDateTime(bucket) + toIntervalSecond(346500) SETTINGS index_granularity = 256, index_granularity_bytes = 131072, ttl_only_drop_parts = 1
samples	AggregatingMergeTree PARTITION BY toYYYYMM(toDateTime(bucket, \'UTC\')) ORDER BY (id, bucket) SETTINGS index_granularity = 256, index_granularity_bytes = 524288
202601	1
202602	2
-- the settings define the partition keys and the index granularity
recentsamples	AggregatingMergeTree PARTITION BY toStartOfHour(bucket) ORDER BY (id, bucket) TTL toDateTime(bucket) + toIntervalSecond(346500) SETTINGS index_granularity = 8192, index_granularity_bytes = 65536, ttl_only_drop_parts = 1
samples	AggregatingMergeTree PARTITION BY toStartOfWeek(bucket) ORDER BY (id, bucket) SETTINGS index_granularity = 1024, index_granularity_bytes = 4194304
-- the settings override the engine declaration, the declared values are kept if the settings are not set
recentsamples	AggregatingMergeTree PARTITION BY toDate(bucket) ORDER BY (id, bucket) TTL toDateTime(bucket) + toIntervalSecond(346500) SETTINGS index_granularity_bytes = 131072, index_granularity = 256, ttl_only_drop_parts = 1
samples	AggregatingMergeTree PARTITION BY toStartOfWeek(bucket) ORDER BY (id, bucket) SETTINGS index_granularity_bytes = 2097152, index_granularity = 256
-- the samples tables require an engine of the AggregatingMergeTree family

-- formatting
SELECT (arr[i])[j]
SELECT (((arr[i])[j])[k])[l]
SELECT arrayMap(x -> (x[1]), arr)
SELECT arrayMap(x -> arrayMap(y -> (y[1]), x), arr)
SELECT arrayMap(x -> ((x[2])[3]), arr[1])
SELECT arrayMap(x1 -> (x1[x]), arr)
SELECT arr
SELECT\n    arrayMap(x -> (x[1]), arr) AS y,\n    (arr[1])[2] AS z
SELECT f(arrayMap(x -> (x[1]), arr))[2]

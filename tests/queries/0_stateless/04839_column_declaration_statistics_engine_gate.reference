CREATE TABLE default.t_stats_gate_local\n(\n    `x` UInt64 STATISTICS(tdigest)\n)\nENGINE = MergeTree\nORDER BY x\nSETTINGS index_granularity = 8192
CREATE TABLE default.t_stats_gate_local\n(\n    `x` UInt64 STATISTICS(tdigest),\n    `y` UInt64 STATISTICS(tdigest)\n)\nENGINE = MergeTree\nORDER BY x\nSETTINGS index_granularity = 8192

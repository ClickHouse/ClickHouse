-- Tags: no-debug, long, no-distributed-cache, no-azure-blob-storage
-- - no-debug - debug build uses S3 and this in combination works very slow
-- - no-distributed-cache - distributed cache does not support adaptive buffers

-- `max_memory_ratio_to_activate_adaptive_write_buffer` must be the thing that makes a wide write of a
-- many-column table fit into a small memory budget. The column-count trigger is disabled throughout, so
-- with the ratio set to 0 the wide write needs a budget of over a gigabyte for the preallocated write
-- buffers, while a tiny ratio switches the same write to adaptive buffers and it fits into tens of
-- megabytes. Modelled on 03770_min_columns_to_activate_adaptive_write_buffer, which covers the
-- column-count trigger the same way.

-- Note, the test avoids vertical merges (enable_vertical_merge_algorithm=0), since they write column by column and do not have excessive memory usage.

SET optimize_trivial_insert_select = 0;

{% for v in [0, 1] %}
drop table if exists metric_ratio_{{ v }};

create table metric_ratio_{{ v }}
(
{% for i in range(300) %}
    m{{i}} UInt64,
{% endfor %}
)
engine=MergeTree order by () settings min_columns_to_activate_adaptive_write_buffer=0, max_memory_ratio_to_activate_adaptive_write_buffer={{ '0.000000001' if v == 1 else '0' }}, min_bytes_for_wide_part=1e9, enable_vertical_merge_algorithm=0, auto_statistics_types='';

insert into metric_ratio_{{ v }} select * from generateRandom() limit 1 settings max_memory_usage = '50Mi' /* usually few 10MiB */;
optimize table metric_ratio_{{ v }} final;
truncate table metric_ratio_{{ v }};
alter table metric_ratio_{{ v }} modify setting min_bytes_for_wide_part=0;
insert into metric_ratio_{{ v }} select * from generateRandom() limit 1 settings max_memory_usage = '{{ 50 if v == 1 else 1500 }}Mi' /* w/o adaptive buffers uses ~3 (for regular) and ~600MiB-1GiB (for encrypted disks), w/ 100MiB for regular and ~200-400MiB for encrypted disks */;
optimize table metric_ratio_{{ v }} final;
drop table metric_ratio_{{ v }};
{% endfor %}

-- Flush system tables all at once
system flush logs part_log;
select
  table,
  part_type,
  merge_algorithm,
  max2(
    peak_memory_usage,
    multiIf(
      -- see comments for max_memory_usage
      part_type = 'Compact', 200e6,
      table = 'metric_ratio_1', 200e6,
      table = 'metric_ratio_0', 1.5e9,
      0.
    )
  )
from system.part_log
where event_date >= yesterday() AND event_time >= now() - 600 AND database = currentDatabase() and event_type = 'MergeParts'
order by event_time_microseconds;

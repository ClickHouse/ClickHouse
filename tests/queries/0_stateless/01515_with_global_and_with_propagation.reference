WITH\n    1 AS x\nSELECT x\nFROM system.one
WITH\n    1 AS x\nSELECT *\nFROM\n(\n    SELECT x\n    FROM system.one\n)
WITH\n    1 AS x\nSELECT\n    *,\n    x\nFROM\n(\n    WITH\n        2 AS x\n    SELECT x AS y\n    FROM system.one\n)
(\n    WITH\n        1 AS x\n    SELECT x\n    FROM system.one\n)\nUNION ALL\n(\n    WITH\n        1 AS x\n    SELECT x\n    FROM system.one\n)
(\n    WITH\n        1 AS x\n    SELECT x\n    FROM system.one\n)\nUNION ALL\n(\n    WITH\n        2 AS x\n    SELECT x\n    FROM system.one\n)
WITH\n    5 AS q1,\n    x AS\n    (\n        SELECT\n            plus(number, 100) AS b,\n            number AS a\n        FROM numbers(10)\n        WHERE greater(number, q1)\n    )\nSELECT *\nFROM x

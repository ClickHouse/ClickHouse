SELECT max(multiply(log(2), number)) AS k\nFROM numbers(10000000)\nGROUP BY\n    modulo(number, 2),\n    modulo(number, 3),\n    modulo(plus(modulo(number, 2), modulo(number, 3)), 2)\nORDER BY k ASC
SELECT avg(multiply(log(2), number)) AS k\nFROM numbers(10000000)\nGROUP BY\n    modulo(number, 5),\n    multiply(modulo(number, 5), modulo(number, 5))\nORDER BY k ASC
SELECT avg(multiply(log(2), number)) AS k\nFROM numbers(10000000)\nGROUP BY\n    multiply(modulo(number, 2), modulo(number, 3)),\n    modulo(number, 3)\nORDER BY k ASC
SELECT avg(multiply(log(2), number)) AS k\nFROM numbers(10000000)\nGROUP BY\n    multiply(modulo(number, 2), modulo(number, 3)),\n    modulo(number, 3),\n    modulo(number, 2)\nORDER BY k ASC
SELECT avg(multiply(log(2), number)) AS k\nFROM numbers(10000000)\nGROUP BY\n    modulo(modulo(number, 2), 3),\n    modulo(number, 2)\nORDER BY k ASC

#!/usr/bin/env bash
# Helpers of the tests whose distributed queries run their tasks on the stateless workers of the test cluster.

# Runs the tasks on the workers and pins what `clickhouse-test` randomizes.
DISTRIBUTED_PLAN_SETTINGS="make_distributed_plan = 1, distributed_plan_execute_locally = 0, distributed_plan_fallback_to_local_execution = 0,
    enable_analyzer = 1, enable_parallel_replicas = 0, automatic_parallel_replicas_mode = 0, enable_cascades_optimizer = 0,
    max_rows_to_group_by = 0"
# A reader of `WHERE sleepEachRow(s) = 0` sleeps 1000 * s seconds per block of 1000 rows.
SLOW_READER_SETTINGS="max_threads = 1, max_block_size = 1000, function_sleep_max_microseconds_per_block = 0"
# The recent part of `system.text_log`, followed by `AND <condition>`.
TEXT_LOG="system.text_log WHERE event_date >= yesterday() AND event_time >= now() - INTERVAL 10 MINUTE"

# Polls until the query `$1` returns 1, for at most 60 seconds.
function wait_for()
{
    local deadline=$((SECONDS + 60))
    while (( SECONDS < deadline ))
    do
        $CLICKHOUSE_CLIENT --query "SYSTEM FLUSH LOGS text_log"
        [[ $($CLICKHOUSE_CLIENT --query "$1") == 1 ]] && return 0
        sleep 0.1
    done
    echo "Timed out waiting for: $1"
    return 1
}

# Prints `$1: 1` once the query `$2` returns 1, or `$1: 0` after 60 seconds.
function expect_eventually()
{
    if wait_for "$2" > /dev/null; then echo "$1: 1"; else echo "$1: 0"; fi
}

# Waits until `main` and a reader of the distributed query `$1` run.
function wait_for_running_tasks()
{
    wait_for "SELECT countIf(query = 'main') = 1 AND countIf(query LIKE 'stage_0_%') > 0 FROM system.processes
        WHERE initial_query_id = '$1' AND query_id != '$1'"
}

# Prints the unique id of the distributed query `$1`: the workers know its tasks as `<unique id>::<task>`.
function unique_id_of()
{
    local line="FROM $TEXT_LOG AND query_id = '$1' AND message LIKE 'Starting distributed query, unique id: %'"
    wait_for "SELECT count() > 0 $line" > /dev/null
    $CLICKHOUSE_CLIENT --query "SELECT extract(any(message), 'unique id: (\\\\S+)') $line"
}

# Cases of `run_case`, for `print_cases`; the query ids of a test run start with `CASE_RUN`.
CASES=()
CASE_RUN="${CLICKHOUSE_DATABASE}_${RANDOM}${RANDOM}"

# Runs the query `$2` locally, then distributed with the settings `$3` and `distributed_plan_task_dispatch_batching` off and on,
# as the case `$1`.
function run_case()
{
    local name=$1 query=$2 settings=${3:+, $3} id="${CASE_RUN}_${#CASES[@]}" expected off on
    expected=$($CLICKHOUSE_CLIENT --query "$query SETTINGS make_distributed_plan = 0")
    off=$($CLICKHOUSE_CLIENT --query_id "${id}_off" --query "$query SETTINGS $DISTRIBUTED_PLAN_SETTINGS$settings, distributed_plan_task_dispatch_batching = 0")
    on=$($CLICKHOUSE_CLIENT --query_id "${id}_on" --query "$query SETTINGS $DISTRIBUTED_PLAN_SETTINGS$settings, distributed_plan_task_dispatch_batching = 1")
    CASES+=("('$name', '${id}_on', '${id}_off', $([[ $off == "$expected" && $on == "$expected" ]] && echo 1 || echo 0))")
}

# Prints a row per case: the coordinator's profile events of the run with batching, its task queries, the requests of the run
# without batching, and whether both results equal the local one.
function print_cases()
{
    $CLICKHOUSE_CLIENT --query "SYSTEM FLUSH LOGS query_log"
    $CLICKHOUSE_CLIENT --query "
        WITH
            initiators AS (SELECT query_id, ProfileEvents AS events FROM system.query_log
                WHERE event_date >= yesterday() AND event_time >= now() - INTERVAL 30 MINUTE AND type = 'QueryFinish'
                    AND current_database = currentDatabase() AND startsWith(query_id, '$CASE_RUN')),
            task_queries AS (SELECT initial_query_id, count() AS ran FROM system.query_log
                WHERE event_date >= yesterday() AND event_time >= now() - INTERVAL 30 MINUTE AND type = 'QueryFinish'
                    AND startsWith(initial_query_id, '$CASE_RUN') AND query_id != initial_query_id
                GROUP BY initial_query_id)
        SELECT cases.name AS case,
            on_run.events['DistributedPlanRemoteTasks'] AS tasks,
            on_run.events['DistributedPlanRemoteTasksSent'] AS sent,
            on_tasks.ran AS ran,
            on_run.events['DistributedPlanHostsUsed'] AS workers,
            on_run.events['DistributedPlanTaskBatches'] AS batches,
            off_run.events['DistributedPlanTaskBatches'] AS batches_without_batching,
            cases.result_same AS result_same
        FROM VALUES('name String, on_id String, off_id String, result_same UInt8', $(IFS=,; echo "${CASES[*]}")) AS cases
        LEFT JOIN initiators AS on_run ON on_run.query_id = cases.on_id
        LEFT JOIN initiators AS off_run ON off_run.query_id = cases.off_id
        LEFT JOIN task_queries AS on_tasks ON on_tasks.initial_query_id = cases.on_id
        ORDER BY case
        FORMAT TSVWithNames"
}

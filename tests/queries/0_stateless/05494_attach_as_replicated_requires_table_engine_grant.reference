-- without TABLE ENGINE grants, both directions are refused
TABLE ENGINE ON ReplicatedMergeTree
TABLE ENGINE ON ReplicatedReplacingMergeTree
TABLE ENGINE ON MergeTree
-- the refused queries keep the stored definitions
mt	MergeTree
rmt	ReplicatedMergeTree
rpl	ReplacingMergeTree
-- TABLE ENGINE ON ReplicatedMergeTree allows only the conversion to ReplicatedMergeTree
TABLE ENGINE ON ReplicatedReplacingMergeTree
TABLE ENGINE ON MergeTree
mt	ReplicatedMergeTree
1
-- TABLE ENGINE ON MergeTree allows the conversion back
mt	MergeTree
1

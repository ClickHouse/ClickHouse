--- postgresql table function
SELECT * FROM postgresql(creds, sslrootcert_pem = '[HIDDEN]', `table` = 't', sslkey_pem = '[HIDDEN]', password = '[HIDDEN]')
--- PostgreSQL table engine
CREATE TABLE t (`x` Int32) ENGINE = PostgreSQL(creds, sslcert_pem = '[HIDDEN]', `table` = 't', sslkey_pem = '[HIDDEN]')
--- PostgreSQL database engine
CREATE DATABASE d ENGINE = PostgreSQL(creds, sslrootcert_pem = '[HIDDEN]', database = 'db', sslkey_pem = '[HIDDEN]')
--- MaterializedPostgreSQL database engine
CREATE DATABASE d ENGINE = MaterializedPostgreSQL(creds, sslrootcert_pem = '[HIDDEN]', database = 'db', sslkey_pem = '[HIDDEN]')
--- PostgreSQL dictionary source
CREATE DICTIONARY d (`id` UInt32) PRIMARY KEY id SOURCE(POSTGRESQL(NAME creds DB 'db' SSLCERT_PEM '[HIDDEN]' SSLKEY_PEM '[HIDDEN]')) LIFETIME(MIN 0 MAX 0) LAYOUT(FLAT())
--- postgresql table function, positional arguments
SELECT * FROM postgresql('127.0.0.1:5432', 'db', 't', 'u', '[HIDDEN]', sslmode = 'verify-full', sslrootcert_pem = '[HIDDEN]', sslkey_pem = '[HIDDEN]')
--- PostgreSQL table engine, positional arguments
CREATE TABLE t (`x` Int32) ENGINE = PostgreSQL('127.0.0.1:5432', 'db', 't', 'u', '[HIDDEN]', sslcert_pem = '[HIDDEN]')
--- PostgreSQL database engine, positional arguments
CREATE DATABASE d ENGINE = PostgreSQL('127.0.0.1:5432', 'db', 'u', '[HIDDEN]', sslrootcert_pem = '[HIDDEN]')
--- MaterializedPostgreSQL table engine, positional arguments
CREATE TABLE t (`x` Int32) ENGINE = MaterializedPostgreSQL('127.0.0.1:5432', 'db', 't', 'u', '[HIDDEN]', sslrootcert_pem = '[HIDDEN]') ORDER BY x
--- key given as a constant expression
SELECT * FROM postgresql(creds, concat('sslrootcert', '_pem') = '[HIDDEN]', `table` = 't')
--- key given as a constant expression, positional arguments
SELECT * FROM postgresql('127.0.0.1:5432', 'db', 't', 'u', '[HIDDEN]', upper('sslkey_pem') = '[HIDDEN]')

-- `AS` without `ENGINE`: the engine is taken from `ts_src` and the settings are merged the same way
TimeSeries
`id` Tuple(UInt64, LowCardinality(UUID)) DEFAULT tuple(sipHash64(metric_name), toLowCardinality(reinterpretAsUUID(sipHash128(tags)))), `metric_name` LowCardinality(String), `job` String, `tags` Map(LowCardinality(String), String), INDEX tags_idx tags TYPE text(tokenizer = \'keyValuePairs\') GRANULARITY 100000000
`id` Tuple(UInt64, LowCardinality(UUID)), `min_time` SimpleAggregateFunction(min, DateTime64(3)), `max_time` SimpleAggregateFunction(max, DateTime64(3)), `sample_kinds` SimpleAggregateFunction(groupBitOr, UInt8)
-- the copied `tags_to_columns` fills the dedicated column
m1	j1
-- a custom SAMPLES engine with its own primary key survives the copy
ReplacingMergeTree(timestamp) PRIMARY KEY id ORDER BY (id, timestamp)
-- a tags engine with arguments keeps allow_nullable_key
ReplacingMergeTree(v) PRIMARY KEY metric_name ORDER BY (metric_name, id) SETTINGS allow_nullable_key = 1, index_granularity = 8192
-- a tags engine of another kind keeps allow_nullable_key
MergeTree PRIMARY KEY metric_name ORDER BY (metric_name, id) SETTINGS allow_nullable_key = 1, index_granularity = 8192
-- the generated tags engine keeps allow_nullable_key
ReplacingMergeTree PRIMARY KEY metric_name ORDER BY (metric_name, id) SETTINGS allow_nullable_key = 1, index_granularity = 8192
-- allow_nullable_key generated for min_time and max_time goes away with them
ReplacingMergeTree(v) PRIMARY KEY metric_name ORDER BY (metric_name, id, min_time, max_time) SETTINGS allow_nullable_key = 1, index_granularity = 8192
ReplacingMergeTree(v) PRIMARY KEY metric_name ORDER BY (metric_name, id) SETTINGS index_granularity = 8192

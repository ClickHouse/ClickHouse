-- the setting is experimental
SUPPORT_IS_DISABLED
SUPPORT_IS_DISABLED
-- a table with a bucket map needs the number of buckets
requires `bucket_map_buckets`
-- a new map splits the buckets evenly between the shards
format version: 1
buckets: 4
0 1 1
2 3 2

-- table functions do not take a bucket map and do not create it
is not supported by table function
is not supported by table function
is not supported by table function
is not supported by table function
bucket_map
-- a row goes to the shard of the bucket sharding_key % buckets
shard_0	[0,1,4,5]
shard_1	[2,3,6,7]
0	4	[(0,1,1),(2,3,2)]	
-- shards are skipped by the bucket map
1	5
1	1
2	2
1	5
-- a changed map is loaded and routes the new rows
shard_0	[0,1,4,5,8,12]
shard_1	[2,3,6,7,9,10,11,13,14,15]
2	13
-- a map that cannot be parsed is not loaded
1	[(0,0,1),(1,3,2)]
-- a map with a shard that the cluster does not have is rejected
assigns buckets to shard 3, but cluster test_cluster_two_shards_different_databases has 2 shards
-- a map with a different number of buckets is rejected, the loaded map keeps routing
1
4	4	[(0,1,1),(2,3,2)]
shard_0	[0,1,4,5,8,12,101]
6	4	[(0,0,1),(1,3,2)]	
-- the table is attached without the experimental setting
shard_1	[2,3,6,7,9,10,11,13,14,15,102]
-- a map with a different number of buckets is rejected after the table is attached again
1	4
-- INSERT SELECT from a Distributed table of the same cluster goes through the bucket map
shard_0	[0,1,4,5,8,12,101,201]
1
-- INSERT SELECT from a table with a bucket map into an ordinary Distributed table goes through the shard weights
shard_1	[201]
1

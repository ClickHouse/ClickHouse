--- values taken from the session are stored
SETTINGS postgresql_connection_pool_size = 3, postgresql_connection_pool_auto_close_connection = true
--- values equal to the server's are not stored

--- also when the session sets them

--- a stated value is a setting of the database and is kept as stated
PostgreSQL connection pool size: 5
SETTINGS postgresql_connection_pool_size = 5
--- a value reset with DEFAULT keeps the default of the engine
PostgreSQL connection pool size: 16
SETTINGS postgresql_connection_pool_size = DEFAULT
--- an ATTACH with the full definition stores them too
SETTINGS postgresql_connection_pool_size = 3
--- the database keeps the stored values when attached in a session without them
PostgreSQL connection pool size: 5
SETTINGS postgresql_connection_pool_size = 5
PostgreSQL connection pool size: 3
--- an ATTACH with the full definition of a detached database adds nothing, since the metadata file is kept


--- a RESTORE keeps the definition from the backup

--- a stated value is held to the constraints of the user
SETTING_CONSTRAINT_VIOLATION
SETTING_CONSTRAINT_VIOLATION
SETTINGS postgresql_connection_pool_size = 4

SELECT\n    `--t1.a` AS `t1.a`,\n    `--t1.b` AS `t1.b`,\n    `--t2.a` AS `t2.a`,\n    `--t2.b` AS `t2.b`,\n    `toNullable(10)` AS `t3.toNullable(10)`,\n    `--t3.a` AS `t3.a`,\n    `--t3.b` AS `t3.b`,\n    `isZeroOrNull(10)` AS `t3.isZeroOrNull(10)`,\n    `10` AS `t3.10`,\n    `assumeNotNull(materialize(10))` AS `t3.assumeNotNull(materialize(10))`,\n    `isNotNull(10)` AS `t3.isNotNull(10)`,\n    x AS `t3.x`\nFROM\n(\n    SELECT\n        b AS `--t1.b`,\n        a AS `--t1.a`,\n        t2.b AS `--t2.b`,\n        t2.a AS `--t2.a`\n    FROM t1\n    ALL INNER JOIN\n    (\n        SELECT\n            a,\n            b\n        FROM t2\n    ) AS t2 ON equals(if(greater(t2.b AS `--t2.b`, 0), t2.a AS `--t2.a`, 0), a AS `--t1.a`)\n    WHERE equals(if(greater(t2.b AS `--t2.b`, 0), t2.a AS `--t2.a`, 0), a AS `--t1.a`)\n) AS `--.s`\nCROSS JOIN\n(\n    SELECT\n        x,\n        `assumeNotNull(materialize(10))`,\n        `isNotNull(10)`,\n        `10`,\n        `isZeroOrNull(10)`,\n        `toNullable(10)`,\n        b AS `--t3.b`,\n        a AS `--t3.a`\n    FROM\n    (\n        SELECT\n            toNullable(10),\n            a,\n            b,\n            isZeroOrNull(10),\n            10,\n            10 AS `10_1`,\n            10 AS `10_2`,\n            assumeNotNull(materialize(10)),\n            isNotNull(10),\n            a AS x\n        FROM t3__fuzz_0\n        WHERE equals(plus(toNullable(toUInt256(1)), a), b)\n    ) AS t3\n) AS `--.t`\nWHERE equals(if(greater(`--t2.b`, 0), `--t2.a`, 0), `--t1.a`)\nORDER BY\n    x ASC NULLS FIRST,\n    `--t2.a` DESC NULLS LAST,\n    `--t1.a` DESC NULLS FIRST
SELECT *\nFROM t1, t2,\n(\n    SELECT\n        toNullable(10),\n        *,\n        isZeroOrNull(10),\n        10,\n        *,\n        10,\n        *,\n        *,\n        10,\n        *,\n        *,\n        *,\n        assumeNotNull(materialize(10)),\n        isNotNull(10),\n        a AS x\n    FROM t3__fuzz_0\n    WHERE equals(plus(toNullable(toUInt256(1)), a), b)\n) AS t3\nWHERE equals(if(greater(t2.b, 0), t2.a, 0), t1.a)\nORDER BY\n    t3.x ASC NULLS FIRST,\n    t2.a DESC NULLS LAST,\n    t1.a DESC NULLS FIRST

-- Tags: no-random-settings, no-random-merge-tree-settings
-- no-random-settings, no-random-merge-tree-settings: the selected marks and EXPLAIN output may differ with
-- random settings.

SET explain_query_plan_default = 'legacy';

{#- Each check prints the predicate, the count with index analysis, the count of a full scan and the parts
    and granules selected by each index; with `condition`, it also prints the key conditions. `settings`
    apply to the whole check. -#}
{% macro check(table, predicate, settings = '', condition = false) -%}
SELECT '{{ predicate | replace("\\", "\\\\") | replace("'", "\\'") }}', (SELECT count() FROM {{ table }} WHERE {{ predicate }}),
    (SELECT count() FROM {{ table }} WHERE {{ predicate }} SETTINGS use_primary_key = 0, use_partition_pruning = 0, use_skip_indexes = 0),
    (SELECT arrayStringConcat(groupArray(trimLeft(explain)), ' ') FROM (EXPLAIN indexes = 1 SELECT 1 FROM {{ table }} WHERE {{ predicate }}) WHERE match(trimLeft(explain), '^(Min-Max|Partition|Statistics|PrimaryKey|Skip|Name:|Parts:|Granules:)'))
    {%- if condition %}, (SELECT arrayStringConcat(groupArray(trimLeft(explain)), ' | ') FROM (EXPLAIN indexes = 1 SELECT 1 FROM {{ table }} WHERE {{ predicate }}) WHERE trimLeft(explain) LIKE 'Condition:%'){% endif %}
    {%- if settings %} SETTINGS {{ settings }}{% endif %}
FORMAT TSVRaw;
{%- endmacro %}

-- Multi-expression minmax skip index: one predicate on ts constrains both index columns.
CREATE TABLE test_skip_mm (id UInt32, ts DateTime('UTC'), INDEX mm (toDate(ts), ts) TYPE minmax GRANULARITY 1) ENGINE = MergeTree
ORDER BY id SETTINGS index_granularity = 4, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_skip_mm SELECT number, toDateTime('2026-03-01 00:00:00', 'UTC') + INTERVAL intDiv(number, 4) DAY + INTERVAL (number % 4) * 6 HOUR FROM numbers(24);
{{ check('test_skip_mm', "ts = toDateTime('2026-03-02 06:00:00', 'UTC')", condition = true) }}
{{ check('test_skip_mm', "ts > toDateTime('2026-03-04 00:00:00', 'UTC')") }}

-- Disjunctions over two indexed columns with multi-atom expansion per branch.
-- The partial-disjunction machinery uses the unexpanded predicate template. Multi-atom
-- groups must keep their original leaf positions even when the expanded RPN is larger.
-- The checks pin `use_skip_indexes_for_disjunctions`, so that they keep covering this machinery.
CREATE TABLE test_skip_disj (id UInt32, ta DateTime('UTC'), tb DateTime('UTC'), INDEX ia (toDate(ta), ta) TYPE minmax GRANULARITY 1, INDEX ib (toDate(tb), tb) TYPE minmax GRANULARITY 1)
ENGINE = MergeTree ORDER BY id SETTINGS index_granularity = 4, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_skip_disj SELECT number, toDateTime('2026-03-01 00:00:00', 'UTC') + INTERVAL number HOUR, toDateTime('2026-06-01 00:00:00', 'UTC') + INTERVAL number HOUR FROM numbers(48);
-- Small disjunction (within the 32-element template limit).
{% set small = "ta = toDateTime('2026-03-01 05:00:00', 'UTC') OR tb = toDateTime('2026-06-02 07:00:00', 'UTC') OR ta = toDateTime('2026-03-02 11:00:00', 'UTC')" -%}
{{ check('test_skip_disj', small, settings = 'use_skip_indexes_for_disjunctions = 1') }}
-- The 12-leaf disjunction has 23 template elements; its expanded RPN has more than 32 elements.
{% set large = "ta = toDateTime('2026-03-01 01:00:00', 'UTC') OR tb = toDateTime('2026-06-01 02:00:00', 'UTC') OR ta = toDateTime('2026-03-01 03:00:00', 'UTC') OR tb = toDateTime('2026-06-01 04:00:00', 'UTC') OR ta = toDateTime('2026-03-01 05:00:00', 'UTC') OR tb = toDateTime('2026-06-01 06:00:00', 'UTC') OR ta = toDateTime('2026-03-01 07:00:00', 'UTC') OR tb = toDateTime('2026-06-01 08:00:00', 'UTC') OR ta = toDateTime('2026-03-01 09:00:00', 'UTC') OR tb = toDateTime('2026-06-01 10:00:00', 'UTC') OR ta = toDateTime('2026-03-01 11:00:00', 'UTC') OR tb = toDateTime('2026-06-01 12:00:00', 'UTC')" -%}
{{ check('test_skip_disj', large, settings = 'use_skip_indexes_for_disjunctions = 1') }}

-- Set skip index goes through the single-atom adapter of RPNBuilder.
CREATE TABLE test_skip_set (id UInt32, s String, INDEX st (s) TYPE set(10) GRANULARITY 1) ENGINE = MergeTree
ORDER BY id SETTINGS index_granularity = 4, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_skip_set SELECT number, char(97 + number % 8) FROM numbers(32);
{{ check('test_skip_set', "s = 'c'") }}

-- FINAL with skip indexes in exact mode; the check pins both settings.
-- Merges are stopped so that the two overlapping parts, whose granules the checks print, stay separate.
CREATE TABLE test_skip_final (id UInt32, ts DateTime('UTC'), INDEX mm (toDate(ts), ts) TYPE minmax GRANULARITY 1) ENGINE = ReplacingMergeTree
ORDER BY id SETTINGS index_granularity = 4, add_minmax_index_for_numeric_columns = 0;
SYSTEM STOP MERGES test_skip_final;
INSERT INTO test_skip_final SELECT number, toDateTime('2026-03-01 00:00:00', 'UTC') + INTERVAL intDiv(number, 4) DAY + INTERVAL (number % 4) * 6 HOUR FROM numbers(24);
INSERT INTO test_skip_final SELECT number, toDateTime('2026-03-01 00:00:00', 'UTC') + INTERVAL intDiv(number, 4) DAY + INTERVAL (number % 4) * 6 HOUR FROM numbers(24);
{{ check('test_skip_final FINAL', "ts > toDateTime('2026-03-04 00:00:00', 'UTC')", settings = 'use_skip_indexes_if_final = 1, use_skip_indexes_if_final_exact_mode = 1') }}

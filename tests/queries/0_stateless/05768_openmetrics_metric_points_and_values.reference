--- stateset: the states of one metric point are written together at each timestamp
# TYPE mode stateset
mode{mode="a"} 1 1
mode{mode="b"} 0 1
mode{mode="a"} 0 2
mode{mode="b"} 1 2
# EOF
--- gauge: the fragments of one series are merged
# TYPE g gauge
g{l="a"} 1 1
g{l="a"} 3 2
g{l="b"} 2 1
# EOF
--- counter: many fragments of one series are written in timestamp order
# TYPE c counter
c_total 0 0
c_total 1 1
c_total 2 2
c_total 3 3
c_total 4 4
c_total 5 5
# EOF
--- typed values are validated
--- values that the types allow
# TYPE g gaugehistogram
g_gsum -1.5 1
# EOF
# TYPE t gauge
t -1.5 1
t NaN 2
# EOF
--- input: independent families named like siblings
x	x	gauge	[('1970-01-01 00:00:01.000',2)]
x_sum	x_sum	gauge	[('1970-01-01 00:00:01.000',1)]

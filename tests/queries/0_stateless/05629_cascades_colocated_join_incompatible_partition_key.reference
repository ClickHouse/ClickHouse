-- 3. a floating-point key: not co-located, because equal keys can be in different partitions
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Expression (Before GROUP BY)
          JoinLogical (Broadcast HashJoin )
            Expression (Change column names to column identifiers)
              ReadFromMergeTree (ParallelRead default.t_coloc_float_left)
            Expression (Change column names to column identifiers)
              ReadFromMergeTree (ReplicatedRead default.t_coloc_float_right)
1999	1999000
1999	1999000

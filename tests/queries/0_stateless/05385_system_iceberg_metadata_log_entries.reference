--- system.iceberg_metadata_log_entries schema ---
database	String
table	String
timestamp	DateTime64(3)
file	String
latest_snapshot_id	Nullable(UInt64)
latest_schema_id	Nullable(Int32)
latest_sequence_number	Nullable(Int64)

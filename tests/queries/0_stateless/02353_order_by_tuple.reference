SELECT\n number AS a,\n modulo(number, 2) AS b\nFROM numbers(10)\nORDER BY\n number AS a DESC NULLS FIRST WITH FILL FROM 2 TO 1 STEP -1,\n modulo(number, 2) AS b DESC NULLS FIRST WITH FILL FROM 2 TO 1 STEP -1\nSETTINGS enable_analyzer = 0

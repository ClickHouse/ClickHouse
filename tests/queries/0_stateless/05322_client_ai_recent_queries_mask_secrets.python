import json
import os
import pty
import select
import shlex
import threading
import time
from http.server import BaseHTTPRequestHandler, HTTPServer

TIMEOUT_SECONDS = 60

# `clickhouse-test` prints this file when the test fails, and it names it after the test case -
# the `.sh` wrapper - not after this script. Writing anywhere else means the trace of a failure in
# CI is collected and then never shown, which is the only record of what the client did.
DEBUG_LOG = os.path.join(
    os.environ["CLICKHOUSE_TMP"],
    os.path.basename(os.path.abspath(__file__)).removesuffix(".python") + ".sh.debuglog",
)

# Set when the pseudo-terminal reaches end of file: the client is gone. Every later read then
# returns at once and every write is silently discarded, so without noticing it the test runs to
# the end and reports every expectation as unmet, saying nothing about the client having died.
client_gone = False

# The reply of the mock provider: no tool calls, so the agent finishes the turn right away.
ANSWER = "MOCK-ANSWER"

USER = "u_05322_mask_secrets"
SECRET = "SECRET05322PASSWORD"

requests = []


class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        requests.append(json.loads(self.rfile.read(length)))

        body = json.dumps(
            {
                "id": "chatcmpl-1",
                "object": "chat.completion",
                "created": 1,
                "model": "gpt-4o",
                "choices": [
                    {
                        "index": 0,
                        "message": {"role": "assistant", "content": ANSWER},
                        "finish_reason": "stop",
                    }
                ],
                "usage": {
                    "prompt_tokens": 1,
                    "completion_tokens": 1,
                    "total_tokens": 2,
                },
            }
        ).encode()

        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


def make_config(port):
    """A client configuration that points the AI agent at the mock provider. The credentials
    come from the configuration and not from the environment, so the agent does not ask for
    the confirmation of using an API key found in the environment."""
    path = os.path.join(
        os.environ["CLICKHOUSE_TMP"],
        os.path.basename(os.path.abspath(__file__)).strip(".python") + ".config.xml",
    )
    with open(path, "w") as f:
        f.write(
            "<clickhouse><ai>"
            "<provider>openai</provider>"
            "<api_key>mock-key</api_key>"
            f"<base_url>http://127.0.0.1:{port}/v1</base_url>"
            "<model>gpt-4o</model>"
            "</ai></clickhouse>"
        )
    return path


def drain(master, debug_log_fd, idle):
    global client_gone
    output = ""
    while True:
        r, _, _ = select.select([master], [], [], idle)
        if not r:
            break
        try:
            chunk = os.read(master, 4096)
        except OSError:
            client_gone = True
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()
        output += chunk.decode(errors="replace")
    return output


def read_until(master, debug_log_fd, predicate, timeout):
    global client_gone
    output = ""
    deadline = time.time() + timeout
    while time.time() < deadline:
        r, _, _ = select.select([master], [], [], 0.3)
        if not r:
            if predicate(output):
                return output
            continue
        try:
            chunk = os.read(master, 4096)
        except OSError:
            client_gone = True
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()
        output += chunk.decode(errors="replace")
        if predicate(output):
            return output
    return output


def report_client_if_gone(child_pid):
    """Print how the client ended if it is gone. The expected output has no such line, so it
    shows up in the diff of the failure instead of leaving only unmet expectations behind."""
    if not client_gone:
        return
    try:
        _, status = os.waitpid(child_pid, os.WNOHANG)
    except ChildProcessError:
        print("client_gone: already reaped")
        return
    if os.WIFSIGNALED(status):
        print(f"client_gone: killed by signal {os.WTERMSIG(status)}")
    elif os.WIFEXITED(status):
        print(f"client_gone: exited with code {os.WEXITSTATUS(status)}")
    else:
        print("client_gone: yes")


def main():
    server = HTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()

    base = shlex.split(os.environ["CLICKHOUSE_LOCAL"])
    argv = base + [
        "--config-file",
        make_config(server.server_port),
        "--history_file=/dev/null",
    ]

    child_pid, master = pty.fork()
    if child_pid == 0:
        os.environ["TERM"] = "xterm"
        # An API key in the environment would take precedence over the configured mock provider.
        os.environ.pop("OPENAI_API_KEY", None)
        os.environ.pop("ANTHROPIC_API_KEY", None)
        os.execv(base[0], argv)
        return

    debug_log_fd = open(DEBUG_LOG, "a")
    try:
        read_until(master, debug_log_fd, lambda o: ":)" in o, TIMEOUT_SECONDS)

        # A query with a secret part. The recent queries are sent to the provider of the model with
        # the next question, so the password must be masked like in `system.query_log`. Whether
        # the statement succeeds in `clickhouse-local` does not matter: it is recorded either way.
        os.write(master, b"CREATE USER " + USER.encode() + b" IDENTIFIED WITH plaintext_password BY '" + SECRET.encode() + b"'\n")
        # Wait for the outcome of that line before typing the next one: `replxx` submits everything
        # already buffered as a single statement, and the prompt is repainted while the line is
        # being typed, so it cannot be waited for (see 05054_client_ai_recent_queries_syntax_error).
        # The query is done when its summary is printed; then let the new prompt settle, since
        # keystrokes that arrive while the terminal is being switched back to `replxx` are mangled.
        read_until(master, debug_log_fd, lambda o: "Elapsed:" in o or "Code:" in o, TIMEOUT_SECONDS)
        drain(master, debug_log_fd, 1.0)

        os.write(master, b"? what did I just do\n")
        read_until(master, debug_log_fd, lambda o: ANSWER in o, TIMEOUT_SECONDS)
        report_client_if_gone(child_pid)

        question = ""
        if requests:
            for message in requests[-1]["messages"]:
                if message["role"] == "user":
                    question = str(message["content"])
                    break

        ok = (
            "<recent_queries>" in question
            and USER in question
            and SECRET not in json.dumps(requests)
        )
        print(f"recent_queries_mask_secrets: {'OK' if ok else 'FAIL'}")
        if not ok:
            debug_log_fd.write("requests: " + repr(requests) + "\n")
    finally:
        os.write(master, b"exit\n")
        drain(master, debug_log_fd, 1.0)
        os.close(master)
        debug_log_fd.close()
        server.shutdown()


if __name__ == "__main__":
    main()

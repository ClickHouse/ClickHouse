-- The optimized JSON-to-JSON conversion must store the same values as format+parse, including the Boolean
-- byte. JSON text shows any nonzero Bool as `true` and hides the stored value, so this test reads the
-- numeric value of the converted path under both json_use_optimized_type_conversion values and prints only
-- the cases that differ; the reference is empty. Covers the Bool-vs-UInt8 distinction.

SET session_timezone = 'UTC';

DROP TABLE IF EXISTS bool_results;
CREATE TABLE bool_results (optimized UInt8, name String, result String) ENGINE = Memory;

{% macro check(name, src, dst, json, expr) -%}
{% for optimized in [1, 0] -%}
INSERT INTO bool_results
SELECT {{ optimized }}, '{{ name }}', toString(({{ expr }}))
FROM (SELECT CAST(CAST('{{ json }}' AS {{ src }}) AS {{ dst }}) AS j)
SETTINGS json_use_optimized_type_conversion = {{ optimized }};
{% endfor -%}
{%- endmacro %}

-- A UInt8 typed path changed to Bool: equals treats UInt8 and Bool as the same type, so the path must not
-- be reused unchanged. Reparsing it (forced here by the extra path b) normalizes the value.
{{ check('UInt8 to Bool with new path', 'JSON(a UInt8)', 'JSON(a Bool, b Int8)', '{"a": 42}', 'toUInt8(j.a)') }}
{{ check('UInt8 to Bool', 'JSON(a UInt8)', 'JSON(a Bool)', '{"a": 42}', 'toUInt8(j.a)') }}
{{ check('UInt8 to Bool to shared data', 'JSON(max_dynamic_paths = 0, a UInt8)', 'JSON(max_dynamic_paths = 0, a Bool)', '{"a": 42}', 'toUInt8(j.a)') }}
{{ check('Array(UInt8) to Array(Bool)', 'JSON(a Array(UInt8))', 'JSON(a Array(Bool))', '{"a": [42, 0]}', 'arrayMap(x -> toUInt8(x), j.a)') }}

-- A UInt8-to-Bool change hidden under a Variant alternative or a nested JSON typed path (equals treats the
-- wrappers as unchanged) must still be normalized, so the path is compared by its textual type.
{{ check('UInt8 to Bool under Variant alternative', 'JSON(a Variant(Array(UInt8), String))', 'JSON(a Variant(Array(Bool), String), b Int8)', '{"a": [42, 0]}', "arrayMap(x -> toUInt8(x), variantElement(j.a, 'Array(Bool)'))") }}
{{ check('UInt8 to Bool under nested JSON path', 'JSON(a JSON(b UInt8))', 'JSON(a JSON(b Bool), z Int8)', '{"a": {"b": 42}}', 'toUInt8(j.a.b)') }}

SELECT name, optimized, result FROM bool_results
WHERE name IN (SELECT name FROM bool_results GROUP BY name HAVING uniqExact(result) > 1)
ORDER BY name, optimized DESC;

DROP TABLE bool_results;

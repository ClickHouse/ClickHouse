-- Float64 ASC, 1 PRECEDING AND 1 FOLLOWING
-inf	1	[-inf]
0	2	[0,1]
1	4	[0,1,1.5,2]
1.5	3	[1,1.5,2]
2	3	[1,1.5,2]
inf	1	[inf]
nan	2	[nan,nan]
nan	2	[nan,nan]
-- Float64 ASC, CURRENT ROW AND 1 FOLLOWING
-inf	1	[-inf]
0	2	[0,1]
1	3	[1,1.5,2]
1.5	2	[1.5,2]
2	1	[2]
inf	1	[inf]
nan	2	[nan,nan]
nan	2	[nan,nan]
-- Float64 ASC, 1 PRECEDING AND CURRENT ROW
-inf	1	[-inf]
0	1	[0]
1	2	[0,1]
1.5	2	[1,1.5]
2	3	[1,1.5,2]
inf	1	[inf]
nan	2	[nan,nan]
nan	2	[nan,nan]
-- Float32 ASC, 1 PRECEDING AND 1 FOLLOWING
0	2	[0,1]
1	4	[0,1,1.5,2]
1.5	3	[1,1.5,2]
2	3	[1,1.5,2]
inf	1	[inf]
nan	1	[nan]
-- Nullable(Float64) ASC NULLS LAST, 1 PRECEDING AND 1 FOLLOWING
0	2	[0,1]
1	4	[0,1,1.5,2]
1.5	3	[1,1.5,2]
2	3	[1,1.5,2]
inf	1	[inf]
nan	2	[nan,nan]
nan	2	[nan,nan]
\N	2	[]
\N	2	[]
-- Float64 DESC, 1 PRECEDING AND 1 FOLLOWING: NaN sorts last under DESC too and keeps its own frame
inf	1	[inf]
2	3	[2,1.5,1]
1.5	3	[2,1.5,1]
1	4	[2,1.5,1,0]
0	2	[1,0]
-inf	1	[-inf]
nan	2	[nan,nan]
nan	2	[nan,nan]
-- Float64 ASC NULLS FIRST, 1 PRECEDING AND 1 FOLLOWING: NaN sorts first and keeps its own frame
nan	2	[nan,nan]
nan	2	[nan,nan]
-inf	1	[-inf]
0	2	[0,1]
1	4	[0,1,1.5,2]
1.5	3	[1,1.5,2]
2	3	[1,1.5,2]
inf	1	[inf]

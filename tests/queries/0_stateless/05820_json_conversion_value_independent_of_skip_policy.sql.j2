-- A successful changed-path conversion must not depend on the error-handling policy
-- (type_json_skip_invalid_typed_paths) or on json_use_optimized_type_conversion: the CAST fast path must
-- agree with the parser, differing only in how failures are handled. Each case runs under (optimized,
-- strict), (optimized, skip) and (format+parse), printing only cases that differ; the reference is empty.

SET session_timezone = 'UTC';

DROP TABLE IF EXISTS k_results;
CREATE TABLE k_results (cfg String, name String, result String) ENGINE = Memory;

{% macro check(name, src, dst, json, expr) -%}
{% for cfg, settings in [
    ('opt_strict', 'json_use_optimized_type_conversion = 1, type_json_skip_invalid_typed_paths = 0'),
    ('opt_skip', 'json_use_optimized_type_conversion = 1, type_json_skip_invalid_typed_paths = 1'),
    ('legacy', 'json_use_optimized_type_conversion = 0'),
] -%}
INSERT INTO k_results
SELECT '{{ cfg }}', '{{ name }}', toString(({{ expr }}))
FROM (SELECT CAST(CAST('{{ json }}' AS {{ src }}) AS {{ dst }}) AS j)
SETTINGS {{ settings }};
{% endfor -%}
{%- endmacro %}

-- A number reaches Time/Time64 as ticks through the parser, not as whole seconds as a CAST reads it.
{{ check('Int64 to Time64', 'JSON(a Int64)', 'JSON(a Time64(3))', '{"a": 1}', 'j.a') }}
{{ check('Array(Int64) to Array(Time64)', 'JSON(a Array(Int64))', 'JSON(a Array(Time64(3)))', '{"a": [1, 2]}', 'j.a') }}
-- A Float32 keeps its shortest text widened to Float64, not its exact bits.
{{ check('Float32 to Float64', 'JSON(a Float32)', 'JSON(a Float64)', '{"a": 0.1}', 'reinterpretAsUInt64(j.a)') }}
{{ check('Array(Float32) to Array(Float64)', 'JSON(a Array(Float32))', 'JSON(a Array(Float64))', '{"a": [0.1, 0.2]}', 'arrayMap(x -> reinterpretAsUInt64(x), j.a)') }}
-- A structural source goes to String as JSON text, not ClickHouse array/tuple text.
{{ check('Array(String) to String', 'JSON(a Array(String))', 'JSON(a String)', '{"a": ["x", "y"]}', 'j.a') }}
-- A Decimal conversion reads text through the parser, not decimal arithmetic through a CAST.
{{ check('Float64 to Decimal64', 'JSON(a Float64)', 'JSON(a Decimal64(2))', '{"a": 0.58}', 'j.a') }}
{{ check('Decimal256 to Float64', 'JSON(a Decimal256(30))', 'JSON(a Float64)', '{"a": 0.1}', 'j.a') }}
{{ check('Decimal64(2) to Decimal64(4)', 'JSON(a Decimal64(2))', 'JSON(a Decimal64(4))', '{"a": 1.25}', 'j.a') }}
-- A date/time destination reads the text through the parser, not the source's internal value through a CAST.
{{ check('Time to DateTime', 'JSON(a Time)', 'JSON(a DateTime)', '{"a": "00:00:01"}', 'j.a') }}
{{ check('Date to DateTime', 'JSON(a Date)', 'JSON(a DateTime)', '{"a": "2024-01-15"}', 'j.a') }}

SELECT name, cfg, result FROM k_results
WHERE name IN (SELECT name FROM k_results GROUP BY name HAVING uniqExact(result) > 1)
ORDER BY name, cfg;

DROP TABLE k_results;

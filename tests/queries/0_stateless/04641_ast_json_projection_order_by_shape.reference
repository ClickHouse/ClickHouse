CREATE TABLE t (`a` UInt64, PROJECTION p (SELECT a ORDER BY a)) ENGINE = MergeTree ORDER BY a
CREATE TABLE t (`a` UInt64, `b` UInt64, PROJECTION p (SELECT a, b ORDER BY a, b)) ENGINE = MergeTree ORDER BY a
CREATE TABLE t (`a` UInt64, PROJECTION p (SELECT a ORDER BY a + 1)) ENGINE = MergeTree ORDER BY a
ALTER TABLE t (ADD PROJECTION p (SELECT a, b ORDER BY b, a))

SELECT ipcryptEncrypt(toIPv4(\'192.168.1.1\'), \'[HIDDEN]\') FORMAT `Null`
SELECT ipcryptDecrypt(\'::1\', \'[HIDDEN]\') FORMAT `Null`
SELECT ipcryptPrefixEncrypt(toIPv4(\'192.168.1.1\'), \'[HIDDEN]\') FORMAT `Null`
SELECT ipcryptPrefixDecrypt(\'10.0.0.1\', \'[HIDDEN]\') FORMAT `Null`
SELECT ipcryptEncrypt(key = \'[HIDDEN]\', \'[HIDDEN]\') FORMAT `Null`
SELECT ipcryptDecrypt(key = \'[HIDDEN]\') FORMAT `Null`

#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# The time limit for receiving external tables is the `max_execution_time` the query runs with,
# which includes its `SETTINGS` clause. `clickhouse-client` copies the settings of that clause into
# the `Query` packet, so the server gets them twice. This client sends the query text as it is,
# and the server learns the limit only when it parses the query.
#
# The same limit applies to the time the server waits for the data of an external table:
# a client that stops sending it gets an exception instead of holding the query for `receive_timeout`,
# also when `receive_timeout` is zero, which means no timeout, and when the client keeps sending `Ping` packets.
#
# With `timeout_overflow_mode = 'break'` external tables are read without the limit.

import os
import socket
import sys
import time
import uuid

CLICKHOUSE_HOST = os.environ.get("CLICKHOUSE_HOST", "127.0.0.1")
CLICKHOUSE_PORT = int(os.environ.get("CLICKHOUSE_PORT_TCP", "9000"))
CLICKHOUSE_DATABASE = os.environ.get("CLICKHOUSE_DATABASE", "default")
CLIENT_NAME = "external table time limit"

CLIENT_REVISION = 54449

TIMEOUT_EXCEEDED = 159
SOCKET_TIMEOUT = 209


def writeVarUInt(x, ba):
    for _ in range(0, 9):
        byte = x & 0x7F
        if x > 0x7F:
            byte |= 0x80

        ba.append(byte)

        x >>= 7
        if x == 0:
            return


def writeStringBinary(s, ba):
    b = bytes(s, "utf-8")
    writeVarUInt(len(b), ba)
    ba.extend(b)


def readStrict(s, size=1):
    res = bytearray()
    while size:
        cur = s.recv(size)
        if not cur:
            raise RuntimeError("Socket is closed")
        size -= len(cur)
        res.extend(cur)

    return res


def readUInt(s, size=1):
    res = readStrict(s, size)
    val = 0
    for i in range(len(res)):
        val += res[i] << (i * 8)
    return val


def readUInt8(s):
    return readUInt(s)


def readUInt32(s):
    return readUInt(s, 4)


def readVarUInt(s):
    x = 0
    for i in range(9):
        byte = readStrict(s)[0]
        x |= (byte & 0x7F) << (7 * i)

        if not byte & 0x80:
            return x

    return x


def readStringBinary(s):
    size = readVarUInt(s)
    return bytes(readStrict(s, size)).decode("utf-8")


def sendHello(s):
    ba = bytearray()
    writeVarUInt(0, ba)  # Hello
    writeStringBinary(CLIENT_NAME, ba)
    writeVarUInt(26, ba)
    writeVarUInt(9, ba)
    writeVarUInt(CLIENT_REVISION, ba)
    writeStringBinary(CLICKHOUSE_DATABASE, ba)
    writeStringBinary("default", ba)  # user
    writeStringBinary("", ba)  # password
    s.sendall(ba)


def receiveHello(s):
    packet_type = readVarUInt(s)
    assert packet_type == 0, packet_type
    readStringBinary(s)  # server name
    readVarUInt(s)  # version major
    readVarUInt(s)  # version minor
    readVarUInt(s)  # revision
    readStringBinary(s)  # timezone
    readStringBinary(s)  # display name
    readVarUInt(s)  # version patch


def serializeClientInfo(ba, query_id):
    writeStringBinary("default", ba)  # initial_user
    writeStringBinary(query_id, ba)  # initial_query_id
    writeStringBinary("127.0.0.1:9000", ba)  # initial_address
    ba.extend([0] * 8)  # initial_query_start_time_microseconds
    ba.append(1)  # TCP
    writeStringBinary("os_user", ba)  # os_user
    writeStringBinary("client_hostname", ba)  # client_hostname
    writeStringBinary(CLIENT_NAME, ba)  # client_name
    writeVarUInt(26, ba)
    writeVarUInt(9, ba)
    writeVarUInt(CLIENT_REVISION, ba)
    writeStringBinary("", ba)  # quota_key
    writeVarUInt(0, ba)  # distributed_depth
    writeVarUInt(1, ba)  # client_version_patch
    ba.append(0)  # No telemetry


def sendQuery(s, query):
    ba = bytearray()
    query_id = uuid.uuid4().hex
    writeVarUInt(1, ba)  # Query
    writeStringBinary(query_id, ba)

    ba.append(1)  # INITIAL_QUERY
    serializeClientInfo(ba, query_id)

    writeStringBinary("", ba)  # No settings
    writeStringBinary("", ba)  # No interserver secret
    writeVarUInt(2, ba)  # Stage - Complete
    ba.append(0)  # No compression
    writeStringBinary(query, ba)
    s.sendall(ba)


def serializeBlockInfo(ba):
    writeVarUInt(1, ba)
    ba.append(0)  # is_overflows
    writeVarUInt(2, ba)
    writeVarUInt(0, ba)
    ba.extend([0] * 4)  # bucket_num


def sendBlock(s, table_name, columns, rows, data=b""):
    ba = bytearray()
    writeVarUInt(2, ba)  # Data
    writeStringBinary(table_name, ba)
    serializeBlockInfo(ba)
    writeVarUInt(len(columns), ba)
    writeVarUInt(rows, ba)
    for name, type_name in columns:
        writeStringBinary(name, ba)
        writeStringBinary(type_name, ba)
    ba.extend(data)
    s.sendall(ba)


def sendEmptyBlock(s, table_name=""):
    sendBlock(s, table_name, [], 0)


def sendExternalTable(s, values):
    """Sends the table `ext` with one block per value. The fail point delays each of them by a second."""
    for value in values:
        sendBlock(s, "ext", [("x", "UInt64")], 1, value.to_bytes(8, "little"))
    sendEmptyBlock(s)


def readException(s):
    code = readUInt32(s)
    readStringBinary(s)  # name
    text = readStringBinary(s)
    readStringBinary(s)  # trace
    readUInt8(s)  # has_nested
    return code, text


def readResponse(s):
    """Returns either a description of the exception or `values <UInt64 values of the result>`."""
    values = []
    while True:
        packet_type = readVarUInt(s)
        if packet_type == 2:  # Exception
            code, text = readException(s)
            if code == SOCKET_TIMEOUT:
                # A read from the socket inside a packet is limited by the timeout of the socket.
                if "while reading from socket" in text:
                    return "exception SOCKET_TIMEOUT inside a packet"
                return "exception SOCKET_TIMEOUT"
            if code != TIMEOUT_EXCEEDED:
                return "exception {}".format(code)
            # The server also has the regular check of `max_execution_time`, which reports the same code.
            if "while reading external table data" in text:
                return "exception TIMEOUT_EXCEEDED while reading external table data"
            return "exception TIMEOUT_EXCEEDED"
        if packet_type == 1:  # Data
            readStringBinary(s)  # external table name
            # BlockInfo
            readVarUInt(s)
            readUInt8(s)  # is_overflows
            readVarUInt(s)
            readUInt32(s)  # bucket_num
            readVarUInt(s)
            columns = readVarUInt(s)
            rows = readVarUInt(s)
            for _ in range(columns):
                readStringBinary(s)  # name
                readStringBinary(s)  # type
                for _ in range(rows):
                    values.append(int.from_bytes(readStrict(s, 8), "little"))
            continue
        if packet_type == 3:  # Progress
            for _ in range(5):
                readVarUInt(s)
            continue
        if packet_type == 4:  # Pong
            continue
        if packet_type == 5:  # EndOfStream
            return "values {}".format(values)
        if packet_type == 6:  # ProfileInfo
            readVarUInt(s)  # rows
            readVarUInt(s)  # blocks
            readVarUInt(s)  # bytes
            readUInt8(s)  # applied_limit
            readVarUInt(s)  # rows_before_limit
            readUInt8(s)  # obsolete field
            continue
        raise RuntimeError("Unexpected packet type {}".format(packet_type))


def connect():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(60)
    s.connect((CLICKHOUSE_HOST, CLICKHOUSE_PORT))
    sendHello(s)
    receiveHello(s)
    return s


def sendPing(s):
    ba = bytearray()
    writeVarUInt(4, ba)  # Ping
    s.sendall(ba)


def setSessionSettings(s, settings):
    sendQuery(s, "SET " + settings)
    sendEmptyBlock(s)
    readResponse(s)


def clientStopsBetweenPackets(session_settings=None):
    with connect() as s:
        if session_settings:
            setSessionSettings(s, session_settings)
        sendQuery(s, "SELECT sum(x) FROM ext SETTINGS max_execution_time = 1")
        # One block, and neither the rest of the table nor the empty block that ends the external data.
        sendBlock(s, "ext", [("x", "UInt64")], 1, (1).to_bytes(8, "little"))
        return readResponse(s)


def clientStopsInsideAPacket(session_settings=None):
    with connect() as s:
        if session_settings:
            setSessionSettings(s, session_settings)
        sendQuery(s, "SELECT sum(x) FROM ext SETTINGS max_execution_time = 1")
        # The block declares one row, but its data is not sent.
        sendBlock(s, "ext", [("x", "UInt64")], 1)
        return readResponse(s)


def clientSendsOnlyPings():
    with connect() as s:
        sendQuery(s, "SELECT sum(x) FROM ext SETTINGS max_execution_time = 1")
        sendBlock(s, "ext", [("x", "UInt64")], 1, (1).to_bytes(8, "little"))
        # The server answers every `Ping`, so it never waits for a packet for long.
        for _ in range(10):
            sendPing(s)
            time.sleep(0.2)
        return readResponse(s)


def limitFromQuerySettings():
    with connect() as s:
        # The limit is only in the query text and is below one second.
        # The first block alone takes longer than that to receive.
        sendQuery(s, "SELECT sum(x) FROM ext SETTINGS max_execution_time = 0.5")
        sendExternalTable(s, [1, 2, 3])
        return readResponse(s)


def querySettingsOverrideSession():
    with connect() as s:
        setSessionSettings(s, "max_execution_time = 1")

        # Receiving the table takes two seconds, which is more than the limit of the session
        # and less than the limit of the query.
        sendQuery(s, "SELECT sum(x) FROM ext SETTINGS max_execution_time = 60")
        sendExternalTable(s, [1, 2])
        return readResponse(s)


def breakModeIsNotLimited():
    with connect() as s:
        sendQuery(
            s,
            "SELECT sum(x) FROM ext SETTINGS max_execution_time = 0.5, timeout_overflow_mode = 'break'",
        )
        sendExternalTable(s, [1, 2])
        response = readResponse(s)
        # What the query returns after its time is over is not the subject here.
        if "external table" in response:
            return response
        return "no exception while reading external table data"


def main():
    # The stalled client is checked without the fail point, and the slow server is checked with it.
    if sys.argv[1] == "stalled_client":
        zero_timeouts = "receive_timeout = 0, send_timeout = 0"
        print("between packets:", clientStopsBetweenPackets())
        print("inside a packet:", clientStopsInsideAPacket())
        print("between packets, no socket timeouts:", clientStopsBetweenPackets(zero_timeouts))
        print("inside a packet, no socket timeouts:", clientStopsInsideAPacket(zero_timeouts))
        print("only pings:", clientSendsOnlyPings())
    else:
        print("limit in the query:", limitFromQuerySettings())
        print("limit of the query over the limit of the session:", querySettingsOverrideSession())
        print("break mode:", breakModeIsNotLimited())


if __name__ == "__main__":
    main()

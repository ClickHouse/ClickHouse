no grants: SELECT count() FROM t -> ACCESS_DENIED
no grants: SELECT 1 FROM t LIMIT 1 -> ACCESS_DENIED
GRANT(j.a): SELECT count() FROM t -> 2
GRANT(j.a): SELECT 1 FROM t LIMIT 1 -> 1
GRANT(p.s): SELECT count() FROM t -> 2
GRANT(p.s): SELECT 1 FROM t LIMIT 1 -> 1
GRANT(secret.x): SELECT count() FROM t -> ACCESS_DENIED
GRANT(secret.x): SELECT 1 FROM t LIMIT 1 -> ACCESS_DENIED
alias GRANT(j.a): SELECT count() FROM a -> ACCESS_DENIED
alias GRANT(j.a): SELECT 1 FROM a LIMIT 1 -> ACCESS_DENIED
alias and target GRANT(j.a): SELECT count() FROM a -> 2
alias and target GRANT(j.a): SELECT 1 FROM a LIMIT 1 -> 1
alias GRANT(j.a), target GRANT(j): SELECT count() FROM a -> 2
alias GRANT(j.a), target GRANT(j): SELECT 1 FROM a LIMIT 1 -> 1
alias GRANT ON a, target GRANT(p.s): SELECT count() FROM a -> 2
alias GRANT ON a, target GRANT(p.s): SELECT 1 FROM a LIMIT 1 -> 1
alias GRANT(p), target GRANT(p.s): SELECT count() FROM a -> 2
alias GRANT(p), target GRANT(p.s): SELECT 1 FROM a LIMIT 1 -> 1
alias GRANT(j), target GRANT(j.a): SELECT count() FROM a -> 2
alias GRANT(j), target GRANT(j.a): SELECT 1 FROM a LIMIT 1 -> 1
alias GRANT ON a REVOKE(p), target GRANT(p.s): SELECT count() FROM a -> ACCESS_DENIED
alias GRANT ON a REVOKE(p), target GRANT(p.s): SELECT 1 FROM a LIMIT 1 -> ACCESS_DENIED
alias GRANT(secret), target GRANT(p.s): SELECT count() FROM a -> ACCESS_DENIED
alias GRANT(secret), target GRANT(p.s): SELECT 1 FROM a LIMIT 1 -> ACCESS_DENIED
chain GRANT ON a1, GRANT(p) ON a2, GRANT(p.s) ON t: SELECT count() FROM a1 -> 2
chain GRANT ON a1, GRANT(p) ON a2, GRANT(p.s) ON t: SELECT 1 FROM a1 LIMIT 1 -> 1
chain GRANT ON a1, GRANT(secret) ON a2, GRANT(p.s) ON t: SELECT count() FROM a1 -> ACCESS_DENIED
chain GRANT ON a1, GRANT(secret) ON a2, GRANT(p.s) ON t: SELECT 1 FROM a1 LIMIT 1 -> ACCESS_DENIED

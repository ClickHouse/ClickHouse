SET enable_analyzer = 1;
SET join_algorithm = 'hash';
-- The conversion declines while a join or transfer limit is active, and the test profile sets all four.
SET max_rows_in_join = 0, max_bytes_in_join = 0, max_rows_to_transfer = 0, max_bytes_to_transfer = 0;

{% for reorder_limit in [0, 1, 16] %}

SET query_plan_optimize_join_order_limit = {{ reorder_limit }};

SELECT 1 FROM (SELECT 0 c0) tx
JOIN (SELECT 0 c0) ty ON TRUE
SEMI LEFT JOIN (SELECT 0 c0) tz ON ty.c0 = tz.c0
JOIN (SELECT 0 c0) tw ON abs(tx.c0)
SETTINGS query_plan_convert_join_to_in = 1
;

SELECT 1 FROM (SELECT 0 c0) tx
JOIN (SELECT 0 c0) ty ON TRUE
SEMI LEFT JOIN (SELECT 0 c0) tz ON ty.c0 = tz.c0
JOIN (SELECT 0 c0) tw ON abs(tx.c0)
SETTINGS query_plan_convert_join_to_in = 0
;

-- Only the equality link is convertible, so pin that it converts inside the mixed multi-join.
SELECT count() > 0 FROM (
    EXPLAIN actions = 1 SELECT 1 FROM (SELECT 0 c0) tx
    JOIN (SELECT 0 c0) ty ON TRUE
    SEMI LEFT JOIN (SELECT 0 c0) tz ON ty.c0 = tz.c0
    JOIN (SELECT 0 c0) tw ON abs(tx.c0)
    SETTINGS query_plan_convert_join_to_in = 1
) WHERE explain ILIKE '%CreatingSets%';

{% endfor %}

SET query_plan_convert_join_to_in = 1;

SELECT 1 FROM (SELECT 1 c0) tx SEMI LEFT JOIN (SELECT 1 c0) ty ON tx.c0 = ty.c0;

-- The result above is also what the unconverted join returns, so pin that the conversion fired.
SELECT count() > 0 FROM (
    EXPLAIN actions = 1 SELECT 1 FROM (SELECT 1 c0) tx SEMI LEFT JOIN (SELECT 1 c0) ty ON tx.c0 = ty.c0
) WHERE explain ILIKE '%CreatingSets%';

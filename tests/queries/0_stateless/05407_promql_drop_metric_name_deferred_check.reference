-- series with values at the same step are duplicates after the metric name is dropped
-- series with values at different steps are merged after the metric name is dropped
[('host','2')]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1)]
[('host','2')]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1),('1970-01-01 00:05:00.000',1)]
[]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1)]
[('host','2')]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1)]
[('host','3')]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1)]
[('host','2')]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1)]
[('host','2')]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1)]
-- series of one metric stay as they are
[('host','3')]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1)]
[]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1)]
[('host','3')]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1)]
[]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1)]
[]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1)]
[('host','3')]	[('1970-01-01 00:01:40.000',2),('1970-01-01 00:03:20.000',2)]
[('host','3')]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1)]
[('host','3')]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1)]
[('host','3'),('x','y')]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1)]
[('host','3')]	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:03:20.000',1)]

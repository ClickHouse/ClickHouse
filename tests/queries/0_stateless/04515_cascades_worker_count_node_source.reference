-- one worker: local plan, no exchange
Expression ((Project names + Projection))
  Aggregating
    Expression ((Before GROUP BY + Change column names to column identifiers))
      ReadFromMergeTree (default.t_worker_count)
-- four workers: distributed plan with shuffle and gather exchanges
GatherExchange
  Expression ((Project names + Projection))
    Aggregating
      Expression ((Before GROUP BY + Change column names to column identifiers))
        ShuffleExchange
          ReadFromMergeTree (ParallelRead default.t_worker_count)

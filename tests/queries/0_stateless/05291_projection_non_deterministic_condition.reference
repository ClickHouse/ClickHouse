-- aggregate projection, a group loses all of its rows only by mistake
rand in WHERE	100
rand in PREWHERE	100
rand in a lambda	100
rand in DISTINCT	100
rand in GROUP BY	200
rand, projection used	0
control: k < 50	50
control: projection used	1
-- projection index, rows out of 800 within 7 standard deviations of the expected count
b = 5 AND rand	1
rand in PREWHERE	1
rand in a lambda	1
rand under OR	1
b = 5 AND rand, projection used	1
control: b = 5	800

-- Tags: no-fasttest, need-query-parameters

-- ALTER TABLE ... DROP PARTITION on Iceberg tables removes exactly the rows of the named partition for every
-- supported partition transform, for scalar, tuple and expression partition values, for multi-column specs,
-- and rejects a value whose arity does not match the spec. Each scenario prints the rows left after each drop.

SET allow_insert_into_iceberg = 1;
-- The hour scenario names its partition with toRelativeHourNum, which in time zones with a historical
-- fractional offset (e.g. Asia/Singapore) does not split hours at the same instants as the Iceberg hour transform.
SET session_timezone = 'UTC';

-- The bucket number the multi_column scenario names as a plain tuple literal.
SELECT icebergBucket(4, 'banana');

{% macro engine(storage, table) -%}
{% if storage == 'local' -%}
IcebergLocal({CLICKHOUSE_DATABASE:String} || '/{{ table }}/')
{%- else -%}
IcebergS3(s3_conn, filename = {CLICKHOUSE_DATABASE:String} || '/{{ table }}/')
{%- endif %}
{%- endmacro %}

{# name, columns, partition spec, rows, partitions to drop one after another #}
{% set scenarios = [
    ('identity_scalar', 'a Int64, b String', 'identity(a)', "(1, 'x'), (2, 'y'), (3, 'z')", ['2']),
    ('identity_tuple', 'a Int64, b String', 'identity(a)', "(1, 'x'), (2, 'y'), (3, 'z')", ['tuple(2)']),
    ('bucket_expr', 'id Int64, k String', 'icebergBucket(4, k)',
        "(1, 'apple'), (2, 'banana'), (3, 'cherry'), (4, 'date')", ["tuple(icebergBucket(4, 'banana'))"]),
    ('truncate_literal', 'id Int64, k String', 'icebergTruncate(3, k)',
        "(1, 'apple'), (2, 'apricot'), (3, 'banana'), (4, 'blueberry')", ["'app'"]),
    ('truncate_expr', 'id Int64, k String', 'icebergTruncate(3, k)',
        "(1, 'apple'), (2, 'apricot'), (3, 'banana'), (4, 'blueberry')", ["tuple(icebergTruncate(3, 'apricot'))"]),
    ('year', 'id Int64, d Date', 'toYearNumSinceEpoch(d)',
        "(1, '2024-03-15'), (2, '2024-08-01'), (3, '2025-01-10'), (4, '2025-12-31')", ["tuple(toYearNumSinceEpoch(toDate('2024-06-01')))"]),
    ('month', 'id Int64, d Date', 'toMonthNumSinceEpoch(d)',
        "(1, '2025-01-05'), (2, '2025-01-29'), (3, '2025-02-10'), (4, '2025-03-15')", ["tuple(toMonthNumSinceEpoch(toDate('2025-01-15')))"]),
    ('day', 'id Int64, d Date', 'toRelativeDayNum(d)',
        "(1, '2025-05-01'), (2, '2025-05-01'), (3, '2025-05-02'), (4, '2025-05-03')", ["tuple(toRelativeDayNum(toDate('2025-05-01')))"]),
    ('hour', 'id Int64, ts DateTime', 'toRelativeHourNum(ts)',
        "(1, '2025-05-19 10:15:00'), (2, '2025-05-19 10:45:00'), (3, '2025-05-19 11:00:00'), (4, '2025-05-19 12:00:00')",
        ["tuple(toRelativeHourNum(toDateTime('2025-05-19 10:30:00')))"]),
    ('multi_column', 'a Int64, b String, payload String', 'identity(a), icebergBucket(4, b)',
        "(1, 'apple', 'p1'), (1, 'banana', 'p2'), (2, 'apple', 'p3'), (2, 'banana', 'p4'), (3, 'cherry', 'p5')",
        ["tuple(1, icebergBucket(4, 'apple'))", '(2, 3)']),
] %}

{% for storage in ['local', 's3'] -%}
SELECT '=== {{ storage }}';

{% for name, columns, partition_by, rows, drops in scenarios -%}
{% set t = 't_' ~ name ~ '_' ~ storage -%}
SELECT '--- {{ name }}';
DROP TABLE IF EXISTS {{ t }};
CREATE TABLE {{ t }} ({{ columns }}) ENGINE = {{ engine(storage, t) }} PARTITION BY ({{ partition_by }}) SETTINGS iceberg_format_version = 2;
INSERT INTO {{ t }} VALUES {{ rows }};
{% for partition in drops -%}
ALTER TABLE {{ t }} DROP PARTITION {{ partition }};
SELECT * FROM {{ t }} ORDER BY ALL;
{% endfor -%}
DROP TABLE {{ t }};

{% endfor -%}
{% set t = 't_arity_' ~ storage -%}
SELECT '--- arity_mismatch';
DROP TABLE IF EXISTS {{ t }};
CREATE TABLE {{ t }} (a Int64, b String) ENGINE = {{ engine(storage, t) }} PARTITION BY (a, b) SETTINGS iceberg_format_version = 2;
INSERT INTO {{ t }} VALUES (1, 'x');
ALTER TABLE {{ t }} DROP PARTITION 1; -- { serverError INVALID_PARTITION_VALUE }
DROP TABLE {{ t }};

{% endfor -%}

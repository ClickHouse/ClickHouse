-- Cascades: ANY LEFT JOIN (broadcast)
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Expression (Before GROUP BY)
          JoinLogical (Broadcast HashJoin )
            Expression (Change column names to column identifiers)
              ReadFromMergeTree (ParallelRead default.t_any_inner_l)
            Expression (Change column names to column identifiers)
              ReadFromMergeTree (ReplicatedRead default.t_any_inner_r)
-- Cascades: ANY INNER JOIN (shuffle)
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Expression (Before GROUP BY)
          JoinLogical (Shuffle HashJoin )
            Expression (Change column names to column identifiers)
              ShuffleExchange
                ReadFromMergeTree (ParallelRead default.t_any_inner_l)
            Expression (Change column names to column identifiers)
              ShuffleExchange
                ReadFromMergeTree (ParallelRead default.t_any_inner_r)

-- Tags: no-fasttest, no-msan
-- no-fasttest, no-msan: the ORC, Arrow and Vortex formats are not included in the fast test, and Vortex not in MSan builds
-- A member of a Nested column that the file lacks has the array sizes of the list in the file: one default per element.

SET engine_file_truncate_on_insert = 1;
SET flatten_nested = 1;

{% set ci = 'input_format_parquet_case_insensitive_column_matching = 1, input_format_orc_case_insensitive_column_matching = 1, input_format_arrow_case_insensitive_column_matching = 1' -%}
{% set allow_missing = {'Parquet': 'input_format_parquet_allow_missing_columns', 'ORC': 'input_format_orc_allow_missing_columns', 'Arrow': 'input_format_arrow_allow_missing_columns'} -%}
{% for format in ['Parquet', 'ORC', 'Arrow', 'Vortex'] -%}
{% set path = "currentDatabase() || '_05894." ~ format ~ "', '" ~ format ~ "'" -%}
SELECT '{{ format }}';
INSERT INTO FUNCTION file({{ path }}) SELECT
    number AS id,
    if(number = 0, [(1, tuple(11), [tuple(5), tuple(6)]), (2, tuple(12), [])], [])::Array(Tuple(p Int32, s Tuple(a Int32), l Array(Tuple(c Int32)))) AS n
FROM numbers(2);

SELECT 'alone', id, n.q FROM file({{ path }}, 'id UInt64, n Nested(p Int32, q Nullable(Int32))') ORDER BY id;
SELECT 'beside one', id, n.p, n.q FROM file({{ path }}, 'id UInt64, n Nested(p Int32, q Nullable(Int32))') ORDER BY id;
SELECT 'array join', id, n.p, n.q FROM file({{ path }}, 'id UInt64, n Nested(p Int32, q Nullable(Int32))') ARRAY JOIN n ORDER BY id, n.p;
SELECT 'through a tuple', id, `n.s.a`, `n.s.b` FROM file({{ path }}, 'id UInt64, `n.s.a` Array(Int32), `n.s.b` Array(Nullable(Int32))') ORDER BY id;
SELECT 'through an inner array', id, `n.l.d` FROM file({{ path }}, 'id UInt64, `n.l.d` Array(Array(Nullable(Int32)))') ORDER BY id;
SELECT 'default', id, `n.p`, `n.q` FROM file({{ path }}, 'id UInt64, `n.p` Array(Int32), `n.q` Array(Int32) DEFAULT arrayMap(x -> x * 10, `n.p`)') ORDER BY id SETTINGS input_format_defaults_for_omitted_fields = 1;
SELECT 'alone, default', id, `n.q` FROM file({{ path }}, 'id UInt64, `n.q` Array(Int32) DEFAULT [7]') ORDER BY id SETTINGS input_format_defaults_for_omitted_fields = 1;
SELECT 'through a tuple, alone, default', id, `n.s.b` FROM file({{ path }}, 'id UInt64, `n.s.b` Array(Int32) DEFAULT [7]') ORDER BY id SETTINGS input_format_defaults_for_omitted_fields = 1;
{% if format in allow_missing -%}
SELECT id, `n.q` FROM file({{ path }}, 'id UInt64, `n.q` Array(Nullable(Int32))') SETTINGS {{ allow_missing[format] }} = 0; -- { serverError THERE_IS_NO_COLUMN }
SELECT id, `n.s.b` FROM file({{ path }}, 'id UInt64, `n.s.b` Array(Nullable(Int32))') SETTINGS {{ allow_missing[format] }} = 0; -- { serverError THERE_IS_NO_COLUMN }
{% endif -%}
{% if format != 'Parquet' -%}
SELECT 'inner sizes', id, `n.l`, `n.l.size1` FROM file({{ path }}, 'id UInt64, `n.l` Array(Array(Tuple(c Int32))), `n.l.size1` Array(UInt64)') ORDER BY id;
{% endif -%}
{% if format != 'Vortex' -%}
SELECT 'case-insensitive', id, `N.q` FROM file({{ path }}, 'id UInt64, `N.q` Array(Nullable(Int32))') ORDER BY id SETTINGS {{ ci }};
{% endif -%}
{% endfor -%}

-- the union runs on every node, so the aggregation over it is split into partial and merge
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Union
          Expression ((Before GROUP BY + (Change column names to column identifiers + (Project names + (Projection + Change column names to column identifiers)))))
            ReadFromMergeTree (ParallelRead default.t_union_agg_left)
          Expression ((Before GROUP BY + (Change column names to column identifiers + (Project names + (Projection + Change column names to column identifiers)))))
            ReadFromMergeTree (ParallelRead default.t_union_agg_right)

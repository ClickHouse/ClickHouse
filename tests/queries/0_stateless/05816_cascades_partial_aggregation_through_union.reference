-- UNION DISTINCT
15	105
-- the union counts the rows of every branch: the plan does not depend on the branch order
Expression ((Project names + Projection))
  Aggregating
    Union
      Expression ((Before GROUP BY + (Change column names to column identifiers + (Project names + (Projection + Change column names to column identifiers)))))
        ReadFromMergeTree (default.t_union_agg_left)
      Expression ((Before GROUP BY + (Change column names to column identifiers + (Conversion before UNION + (Project names + (Projection + Change column names to column identifiers))))))
        ReadFromMergeTree (default.t_union_agg_unique)

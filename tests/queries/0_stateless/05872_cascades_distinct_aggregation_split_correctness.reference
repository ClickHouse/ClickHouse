-- a table sorted by an integer column, aggregation in order: the plan, the count with the setting on and off
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Aggregating
          Expression ((Before GROUP BY + Change column names to column identifiers))
            ShuffleExchange
              ReadFromMergeTree (ParallelRead default.t_distinct_values_by_int)

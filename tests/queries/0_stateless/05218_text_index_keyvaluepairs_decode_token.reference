-- quotes, backslashes and control bytes in a pair are escaped in the descriptions
Condition: (mode: All; tokens: [{"a\\"b": "c\\\\d"}])
Condition: (mode: All; tokens: [{"tab\\tkey": "new\\nline"}])
ReadFromTextIndexCount (Trivial count from text index (idx, token = {"a\\"b": "c\\\\d"}))
-- other tokenizers do not have the columns
part_name	String					
token	String					
dictionary_compression	Enum8(\'raw\' = 0, \'front_coded\' = 1)					
cardinality	UInt64					
num_posting_blocks	UInt64					
has_embedded_postings	UInt8					
has_raw_postings	UInt8					
has_compressed_postings	UInt8					
Condition: (mode: All; tokens: ["apple"])
ReadFromTextIndexCount (Trivial count from text index (idx, token = "apple"))

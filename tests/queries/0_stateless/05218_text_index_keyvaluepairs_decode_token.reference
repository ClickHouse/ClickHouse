-- the structure has the decoded parts of the token next to it
part_name	String					
token	String					
token_key	String					
token_value	String					
dictionary_compression	Enum8(\'raw\' = 0, \'front_coded\' = 1)					
cardinality	UInt64					
num_posting_blocks	UInt64					
has_embedded_postings	UInt8					
has_raw_postings	UInt8					
has_compressed_postings	UInt8					
-- every token decodes back to its pair; the duplicate key gives the same pair as its first occurrence
k	first	6B666972737402	1
k	second	6B7365636F6E6402	1
k	second	6B7365636F6E6403	1
level	error	6C6576656C6572726F720A	1
level	warn	6C6576656C7761726E0A	1
service	api	736572766963656170690E	2
-- the condition shows pairs instead of the encoded tokens
Condition: (mode: All; tokens: [{"level": "error"}])
Condition: (mode: All; tokens: [{"level": "warn"}, {"service": "api"}])
Condition: (mode: Any; tokens: [{"k": "second"}, {"level": "error"}])
-- so does the trivial count from the index
ReadFromTextIndexCount (Trivial count from text index (idx, token = {"level": "error"}))

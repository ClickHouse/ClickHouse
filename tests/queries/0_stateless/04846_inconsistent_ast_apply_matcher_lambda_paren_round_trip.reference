SELECT * APPLY (x -> COLUMNS(\'a\')) APPLY toString FROM t
SELECT * APPLY (x -> *) EXCEPT a FROM t
SELECT * APPLY (x -> t.*) REPLACE (a AS a) FROM t
SELECT * APPLY (x -> COLUMNS(\'a\') APPLY toString) APPLY length FROM t
SELECT * EXCEPT b APPLY (x -> (x + 1)) REPLACE (a AS a) FROM t
SELECT * APPLY (x -> (x + 1)) FROM t
SELECT * APPLY (x -> x) FROM t
SELECT * APPLY toString APPLY length FROM t
SELECT * APPLY sum FROM t

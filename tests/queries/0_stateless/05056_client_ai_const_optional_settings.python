# The AI agent attaches two settings to the queries it runs on its own that the query itself does
# not need: the `log_comment` marker that tells its queries from the user's in the query log, and
# `format_display_secrets_in_show_and_select = 0` for the results that can render the credentials
# of an external-engine table. A settings profile can make either of them `const` while leaving
# the session otherwise writable, and neither may then take the tools that do not need it down
# with it: the schema and documentation lookups have no secret to mask and nothing to mark.
import json
import os
import pty
import select
import shlex
import threading
import time
from http.server import BaseHTTPRequestHandler, HTTPServer

TIMEOUT_SECONDS = 120

# `clickhouse-test` prints this file when the test fails, and it names it after the test case -
# the `.sh` wrapper - not after this script. Writing anywhere else means the trace of a failure in
# CI is collected and then never shown, which is the only record of what the client did.
DEBUG_LOG = os.path.join(
    os.environ["CLICKHOUSE_TMP"],
    os.path.basename(os.path.abspath(__file__)).removesuffix(".python") + ".sh.debuglog",
)

# Set when the pseudo-terminal reaches end of file: the client is gone. Every later read then
# returns at once and every write is silently discarded, so without noticing it the test runs to
# the end and reports every expectation as unmet, saying nothing about the client having died.
client_gone = False

FINAL_ANSWER = "MOCK-DONE"

# The tools the agent is made to call, in order, and whether the session allows them to run.
# Only `show_create_table` needs the masking the profile forbids, so only it must fail.
CASES = [
    ("list_databases", {}, True),
    ("list_tables", {"database": "default"}, True),
    ("consult_documentation", {"name": "MergeTree"}, True),
    ("show_create_table", {"database": "default", "table": "plain"}, False),
]

SETUP = ["CREATE TABLE default.plain (x UInt32) ENGINE = MergeTree ORDER BY x"]

# The last request the mock provider received: it carries the results of every tool call and the
# tools the agent offered for the call.
last_request = {}


class Handler(BaseHTTPRequestHandler):
    """A mock OpenAI-compatible provider. It answers with one tool call per case, in order, and
    finishes with a plain text message."""

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        request = json.loads(self.rfile.read(length))
        last_request["value"] = request

        # The number of tool calls already made is the number of tool results in the history.
        done = sum(1 for m in request["messages"] if m.get("role") == "tool")
        if done < len(CASES):
            name, arguments, _ = CASES[done]
            message = {
                "role": "assistant",
                "content": None,
                "tool_calls": [
                    {
                        "id": f"call_{name}",
                        "type": "function",
                        "function": {"name": name, "arguments": json.dumps(arguments)},
                    }
                ],
            }
            finish_reason = "tool_calls"
        else:
            message = {"role": "assistant", "content": FINAL_ANSWER}
            finish_reason = "stop"

        body = json.dumps(
            {
                "id": "chatcmpl-1",
                "object": "chat.completion",
                "created": 1,
                "model": "gpt-4o",
                "choices": [
                    {"index": 0, "message": message, "finish_reason": finish_reason}
                ],
                "usage": {
                    "prompt_tokens": 1,
                    "completion_tokens": 1,
                    "total_tokens": 2,
                },
            }
        ).encode()

        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


def make_config(port):
    """A client configuration that points the AI agent at the mock provider, next to a users
    configuration whose profile forbids changing the two settings the agent would like to attach
    to its queries. The credentials come from the configuration and not from the environment, so
    the agent does not ask for the confirmation of using an API key found there."""
    base = os.path.join(
        os.environ["CLICKHOUSE_TMP"],
        os.path.basename(os.path.abspath(__file__)).strip(".python"),
    )

    with open(base + ".users.xml", "w") as f:
        f.write(
            "<clickhouse>"
            "<profiles><default>"
            # Enabled, so the agent has a reason to turn it off - and unable to be turned off.
            "<format_display_secrets_in_show_and_select>1</format_display_secrets_in_show_and_select>"
            "<constraints>"
            "<log_comment><const/></log_comment>"
            "<format_display_secrets_in_show_and_select><const/></format_display_secrets_in_show_and_select>"
            "</constraints>"
            "</default></profiles>"
            "<users><default>"
            "<password></password><networks><ip>::/0</ip></networks>"
            "<profile>default</profile><quota>default</quota>"
            "<access_management>1</access_management>"
            "</default></users>"
            "<quotas><default></default></quotas>"
            "</clickhouse>"
        )

    path = base + ".config.xml"
    with open(path, "w") as f:
        f.write(
            "<clickhouse>"
            f"<users_config>{os.path.basename(base)}.users.xml</users_config>"
            "<ai>"
            "<provider>openai</provider>"
            "<api_key>mock-key</api_key>"
            f"<base_url>http://127.0.0.1:{port}/v1</base_url>"
            "<model>gpt-4o</model>"
            f"<max_steps>{len(CASES) + 5}</max_steps>"
            "</ai></clickhouse>"
        )
    return path


def drain(master, debug_log_fd, idle):
    global client_gone
    while True:
        r, _, _ = select.select([master], [], [], idle)
        if not r:
            break
        try:
            chunk = os.read(master, 65536)
        except OSError:
            client_gone = True
            break
        if not chunk:
            client_gone = True
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()


def read_until(master, debug_log_fd, predicate, timeout):
    global client_gone
    output = ""
    deadline = time.time() + timeout
    while time.time() < deadline:
        r, _, _ = select.select([master], [], [], 0.3)
        if not r:
            continue
        try:
            chunk = os.read(master, 65536)
        except OSError:
            client_gone = True
            break
        if not chunk:
            client_gone = True
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()
        output += chunk.decode(errors="replace")
        if predicate(output):
            return output
    return output


def report_client_if_gone(child_pid):
    """Print how the client ended if it is gone. The expected output has no such line, so it
    shows up in the diff of the failure instead of leaving only unmet expectations behind."""
    if not client_gone:
        return
    try:
        _, status = os.waitpid(child_pid, os.WNOHANG)
    except ChildProcessError:
        print("client_gone: already reaped")
        return
    if os.WIFSIGNALED(status):
        print(f"client_gone: killed by signal {os.WTERMSIG(status)}")
    elif os.WIFEXITED(status):
        print(f"client_gone: exited with code {os.WEXITSTATUS(status)}")
    else:
        print("client_gone: yes")


def main():
    server = HTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()

    base = shlex.split(os.environ["CLICKHOUSE_LOCAL"])
    argv = base + [
        "--config-file",
        make_config(server.server_port),
        "--history_file=/dev/null",
        "--path",
        os.path.join(os.environ["CLICKHOUSE_TMP"], "05056_local_db"),
    ]

    child_pid, master = pty.fork()
    if child_pid == 0:
        os.environ["TERM"] = "xterm"
        # An API key in the environment would take precedence over the configured mock provider.
        os.environ.pop("OPENAI_API_KEY", None)
        os.environ.pop("ANTHROPIC_API_KEY", None)
        os.execv(base[0], argv)
        return

    debug_log_fd = open(DEBUG_LOG, "a")
    try:
        read_until(master, debug_log_fd, lambda o: ":)" in o, TIMEOUT_SECONDS)

        # Every statement waits for the timing line the interactive client prints when a query is
        # done. Waiting for the prompt instead would not do: `replxx` repaints it while the line
        # is being typed, so it is already there before the statement has run, and `replxx` submits
        # everything that is buffered when it starts reading as a single statement - the question
        # that follows would be merged into the setup and the `?` would never start the agent.
        for statement in SETUP:
            os.write(master, statement.encode() + b"\n")
            read_until(master, debug_log_fd, lambda o: "Elapsed:" in o, TIMEOUT_SECONDS)

        os.write(master, b"? look around\n")
        read_until(master, debug_log_fd, lambda o: FINAL_ANSWER in o, TIMEOUT_SECONDS)
        report_client_if_gone(child_pid)

        request = last_request.get("value", {})

        # The marker cannot be attached, so the tool that reads the query log is not offered: its
        # results could not be told from the queries of the user.
        offered = {
            tool.get("function", {}).get("name") for tool in request.get("tools", [])
        }
        print(
            f"read_query_log_offered: {'yes' if 'read_query_log' in offered else 'no'}"
        )

        results = {}
        for message in request.get("messages", []):
            if message.get("role") == "tool":
                results[message.get("tool_call_id")] = str(message.get("content"))

        for name, _, should_run in CASES:
            answer = results.get(f"call_{name}")
            if answer is None:
                print(f"{name}: NO RESULT")
                continue
            ran = '"success":true' in answer.replace(" ", "")
            if ran == should_run:
                print(f"{name}: {'OK' if ran else 'BLOCKED'}")
            else:
                print(f"{name}: UNEXPECTED {answer[:200]}")
    finally:
        os.write(master, b"exit\n")
        drain(master, debug_log_fd, 1.0)
        os.close(master)
        debug_log_fd.close()
        server.shutdown()


if __name__ == "__main__":
    main()

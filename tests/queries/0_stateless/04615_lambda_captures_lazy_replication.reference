['111','122']
['211','222']
-- arrayFilter and arrayExists with capture
[1,2,3,4]	0
[2,3,4]	1
[3,4]	1
[4]	1
-- nested lambda capturing outer lambda argument and outer capture
[['011','012'],['021','022']]
[['111','112'],['121','122']]
-- short-circuit function inside the lambda body
['0','0!']
['1','1!']
['2','2!']
-- capture produced by lazy ARRAY JOIN replication
['s01','s02']
['s01','s02']
['s11','s12']
['s11','s12']
-- arrayFold with capture
i0102
i1112
i2122
-- arrayFold whose lambda returns the capture directly
0
1
2
-- arrayFold with capture produced by lazy ARRAY JOIN replication
s0s0	s0
s0s0	s0
s1s1	s1
s1s1	s1
-- constant folding still works with all-const captures
[2,3]
[2,3]

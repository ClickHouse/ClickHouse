#!/usr/bin/expect -f
# Tags: no-fasttest
# Tag no-fasttest: the polyglot transpiler is Rust code, which is disabled in
# the fast-test build; there `--dialect polyglot` reports a different error.

# Regression test: continuation is disabled under the `polyglot` dialect. The
# transpiler receives the foreign-dialect text as one opaque string (it is not
# tokenized by the ClickHouse lexer), so the probe has no reliable signal that
# a statement is still being typed. <ENTER> must always commit the buffer and
# let the executor report the error -- in particular the unclosed-bracket
# heuristic (which is based on the ClickHouse lexer) must not keep the buffer
# open forever.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0
set history_file $CLICKHOUSE_TMP/$basename.history

log_user 0
set timeout 60
match_max 100000

expect_after {
    -i $any_spawn_id eof { exp_continue }
    -i $any_spawn_id timeout { exit 1 }
}

spawn bash -c "source $basedir/../shell_config.sh ; TERM=xterm \$CLICKHOUSE_LOCAL --format PrettyCompact --allow_experimental_polyglot_dialect 1 --disable_suggestion --enable-progress-table-toggle=0 --history_file=$history_file"
expect ":) "

# An unfinished statement with an unclosed bracket: it must be committed and
# reported, not folded (there is no way to know how the foreign dialect
# interprets the bracket).
send -- "SET dialect = 'polyglot'; SET polyglot_dialect = 'sqlite'; SELECT (\r"
expect -re {(Polyglot SQL transpilation error|Error while parsing the SQL query generated by polyglot|Syntax error)}
expect ":) "

# The same for a statement that simply ends too early.
send -- "SELECT * FROM\r"
expect -re {(Polyglot SQL transpilation error|Error while parsing the SQL query generated by polyglot|Syntax error)}
expect ":) "

# A complete statement still works.
send -- "SELECT 42\r"
expect "42"
expect ":) "

# The `SET` escape hatch back to SQL is still parsed as SQL.
send -- "SET dialect = 'clickhouse';\r"
expect ":) "

send -- "exit\r"
expect eof

--- FORMAT Values ---
('INSERT INTO FUNCTION `null`(\'x UInt64\') SELECT 1\nFROM system.one')
--- SETTINGS after FORMAT ---
{"explain":"INSERT INTO FUNCTION `null`('x UInt64')\nSETTINGS max_threads = 1\nSELECT 1\nFROM system.one"}

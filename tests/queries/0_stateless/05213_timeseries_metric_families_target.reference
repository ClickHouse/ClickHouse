--- a new table: the METRIC FAMILIES keyword, the .inner_id.metricfamilies inner table ---
METRIC FAMILIES INNER COLUMNS
METRIC FAMILIES INNER ENGINE = ReplacingMergeTree ORDER BY metric_family
1
0
http_requests_total	counter	requests	Total HTTP requests
the alias timeSeriesMetrics still works:
http_requests_total	counter	requests	Total HTTP requests
--- the old kind name in the AST JSON is understood ---
CREATE TABLE t ENGINE = TimeSeries METRIC FAMILIES db.m
the AST JSON of a table of an older version uses the old kind name:
1
CREATE TABLE t ENGINE = TimeSeries SETTINGS version = 3 METRICS db.m
--- a table of version 3 keeps the .inner_id.metrics inner table and the METRICS keyword ---
version = 3
METRICS INNER COLUMNS
METRICS INNER ENGINE = ReplacingMergeTree ORDER BY metric_family_name
1
0
--- a table of version 3 can be backed up and restored ---
version = 3
METRICS INNER COLUMNS
2
http_requests_total	counter
0
--- in an Ordinary database the inner tables are found by name, which depends on the version ---
.inner.metricfamilies.ts_latest
.inner.metrics.ts_v3
the inner tables are renamed together with the table and keep the version-specific name:
.inner.metricfamilies.ts_latest_renamed
.inner.metrics.ts_v3_renamed

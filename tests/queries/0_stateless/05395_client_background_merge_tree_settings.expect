#!/usr/bin/expect -f

# A background `CREATE TABLE` must get the engine settings given to the client with `--allow_merge_tree_settings`,
# like the same statement in the foreground.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0
set history_file $CLICKHOUSE_TMP/$basename.history

log_user 0
set timeout 60
expect_after {
    -i $any_spawn_id eof     { exp_continue }
    -i $any_spawn_id timeout { exit 1 }
}

# Give replxx time to consume text before sending carriage return on loaded machines.
proc submit {text} {
    send -- $text
    expect -ex $text
    send -- "\r"
}

# `\jobs` is the synchronization point for completion, retry to stay deterministic under heavy CI load.
proc wait_for_job_success {job_id} {
    set done_re [format {(?i)\[%s\][^\r\n]*(succeeded|completed)} $job_id]
    set waiting_re [format {(?i)\[%s\][^\r\n]*(starting|running)} $job_id]
    set failed_re [format {(?i)\[%s\][^\r\n]*(failed|cancel+ed)} $job_id]
    for {set attempt 0} {$attempt < 200} {incr attempt} {
        submit {\jobs}
        expect {
            -re $done_re {
                expect ":) "
                return
            }
            -re $waiting_re {
                expect ":) "
                after 100
            }
            -re $failed_re {
                exit 1
            }
        }
    }
    exit 1
}

spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --allow_merge_tree_settings --index_granularity=4096 --history_file=$history_file"
expect ":) "

submit {DROP TABLE IF EXISTS background_merge_tree_settings_05395}
expect ":) "

submit {\bg CREATE TABLE background_merge_tree_settings_05395 (x UInt8) ENGINE = MergeTree ORDER BY x}
expect -re {(?i)(job[^\r\n]*1[^\r\n]*start|start[^\r\n]*job[^\r\n]*1)}
expect ":) "
wait_for_job_success 1

submit {\fg 1}
expect -re {Background job[[:space:]]+1[[:space:]]+(succeeded|completed)}
expect ":) "

# The persisted table definition, not the statement text, shows the setting.
submit {SELECT extract(engine_full, 'index_granularity = [0-9]+') FROM system.tables WHERE database = currentDatabase() AND name = 'background_merge_tree_settings_05395' FORMAT TabSeparatedRaw}
expect -ex {index_granularity = 4096}
expect ":) "

submit {DROP TABLE background_merge_tree_settings_05395}
expect ":) "

send -- "\4"
expect eof

file delete -force $history_file

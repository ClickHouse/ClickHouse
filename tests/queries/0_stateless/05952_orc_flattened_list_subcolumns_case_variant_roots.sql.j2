-- Tags: no-fasttest
-- no-fasttest: the ORC, Arrow and Parquet formats are not included in the fast test
-- With case-insensitive matching, flattened subcolumns of a list of structs requested under different spellings of its
-- name are each read with their requested types.

SET engine_file_truncate_on_insert = 1;

{% set ci = 'input_format_parquet_case_insensitive_column_matching = 1, input_format_orc_case_insensitive_column_matching = 1, input_format_arrow_case_insensitive_column_matching = 1' -%}
{% for format in ['ORC', 'Arrow', 'Parquet'] -%}
SELECT '{{ format }}';
INSERT INTO FUNCTION file(currentDatabase() || '_05952.{{ format }}', '{{ format }}') SELECT
    [tuple(toIPv6('2001:db8::1'), toIPv6('2001:db8::2'))]::Array(Tuple(x IPv6, y IPv6)) AS s,
    [tuple(toDate32('2000-01-01'), toDate32('2200-01-01'))]::Array(Tuple(x Date32, y Date32)) AS d;
SELECT * FROM file(currentDatabase() || '_05952.{{ format }}', '{{ format }}', '`s.x` Array(IPv6), `S.Y` Array(IPv6)') SETTINGS {{ ci }};
SELECT * FROM file(currentDatabase() || '_05952.{{ format }}', '{{ format }}', '`S.Y` Array(IPv6), `s.x` Array(IPv6)') SETTINGS {{ ci }};
{# Parquet does not read a flattened `size0` request from the file: it is a missing column there. -#}
{% if format != 'Parquet' -%}
SELECT * FROM file(currentDatabase() || '_05952.{{ format }}', '{{ format }}', '`s.x` Array(IPv6), `S.size0` UInt64') SETTINGS {{ ci }};
{% endif -%}
SELECT * FROM file(currentDatabase() || '_05952.{{ format }}', '{{ format }}', '`d.x` Array(DateTime(\'UTC\')), `D.Y` Array(DateTime(\'UTC\'))') SETTINGS {{ ci }}, date_time_overflow_behavior = 'throw'; -- { serverError VALUE_IS_OUT_OF_RANGE_OF_DATA_TYPE }
{% endfor -%}
SELECT `s.x`, hex(`S.x`[1]) FROM file(currentDatabase() || '_05952.ORC', 'ORC', '`s.x` Array(IPv6), `S.x` Array(String)') SETTINGS input_format_orc_case_insensitive_column_matching = 1;
SELECT hex(`S.x`[1]), `s.x` FROM file(currentDatabase() || '_05952.ORC', 'ORC', '`S.x` Array(String), `s.x` Array(IPv6)') SETTINGS input_format_orc_case_insensitive_column_matching = 1;
SELECT hex(`S.x`[1]) FROM file(currentDatabase() || '_05952.ORC', 'ORC', '`S.x` Array(String)') SETTINGS input_format_orc_case_insensitive_column_matching = 1;

-- 23 additional_table_filters is resolved per table expression in the planner, after this pass has run
23	1	0
23	1	0
23 fused	0
-- 24 a row policy is an expression this pass never sees
24	1	0
24	1	0
24 fused	0
-- 25 sibling branches must read one snapshot of the table, not one each
25a fused	0
25b fused	1
-- 26 residuals over two tables lose their per-branch correlation inside the fused OR; over one table they do not
26a	120	120
26a	120	120
26a fused	0
26b	840	840
26b	840	840
26b fused	1
-- 27 a projection-alias override whose size would stop matching the grown projection
27	1	1
27	1	1
27 fused	0
-- 28 a branch with no WHERE of its own is refused: it is already read in full, or answered from part metadata, and it would leave the fused filter empty
28a	1000	1
28a	1000	1
28a fused	0
28b	1000	1	1
28b	1000	1	1
28b countIf	2
28b tables	2
-- 29 a limit that bounds the whole query is evaluated on the fused shape, where N bounded reads and joins have become one
29a	60	60
29a	60	60
29a fused	0
29b	50	33
29b	50	33
29b fused	0
29c max_rows_to_read	0
29c max_bytes_to_read	0
29c max_rows_to_read_leaf	0
29c max_bytes_to_read_leaf	0
29c max_temporary_columns	0
29c max_temporary_non_const_columns	0
29c max_bytes_in_join	0
29c none	1
-- 30 a projection is chosen against the own filter of a branch, and the fused OR implies none of them
30	250	250
30	250	250
30 fused	0
-- 31 for an absolute SAMPLE the sampled set is derived from the own key condition of a branch, which fusion replaces with the merged one, so any modifier is refused
31a	999	1000
31a	999	1000
31a fused	0
31b	999	1000
31b	999	1000
31b fused	0
-- 32 a limit on how far one read may span is evaluated on the fused read, which spans the union of the partitions the branches read
32a	50	50
32a	50	50
32a fused	0
32b	50	50
32b	50	50
32b fused	0
32c fused	1
-- 33 the implicit minmax_count projection is a separate member of the metadata, so a table with no projection of its own still loses an access path the rewrite cannot keep
33a	250	250
33a	250	250
33a fused	0
33b	250	250
33b	250	250
33b fused	0
33c fused	1
-- 34 the same limit also gates a table-wide concurrency slot on the marks one read selects, and the fused read selects the marks of the union, so it can have to take a slot neither branch read needed
34a	5	5
34a	5	5
34a fused	0
34b fused	1
-- 35 a branch aggregate whose own name is at the factory length limit: appending If exceeds it, and the factory answers an over-long name by throwing rather than by not resolving
35	1	1
35	1	1
35 tables	2
-- 36 cross_to_inner_join_rewrite = 2 rejects a comma join it cannot turn into an INNER JOIN, and it is reached only while the join tree is still a cross join
36 fused	0
36a fused	1
36b fused	1
-- 37 the fused residual widens the join build side, and a grace hash join raises rather than pass grace_hash_join_max_buckets
37	1000	1000	1000	1000	1000	1000	1000	1000
37 fused	8

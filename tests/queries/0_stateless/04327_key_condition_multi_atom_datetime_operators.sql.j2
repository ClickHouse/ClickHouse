-- Tags: no-random-settings, no-random-merge-tree-settings
-- no-random-settings, no-random-merge-tree-settings: the selected marks and EXPLAIN output may differ with
-- random settings.

SET explain_query_plan_default = 'legacy';

{#- Each check prints the predicate, the count with index analysis, the count of a full scan and the marks
    selected by index analysis; with `condition`, it also prints the key condition. -#}
{% macro check(table, predicate, condition = false) -%}
SELECT '{{ predicate | replace("\\", "\\\\") | replace("'", "\\'") }}', (SELECT count() FROM {{ table }} WHERE {{ predicate }}),
    (SELECT count() FROM {{ table }} WHERE {{ predicate }} SETTINGS use_primary_key = 0, use_partition_pruning = 0, use_skip_indexes = 0),
    (SELECT sum(marks) FROM (EXPLAIN ESTIMATE SELECT 1 FROM {{ table }} WHERE {{ predicate }}))
    {%- if condition %}, (SELECT arrayStringConcat(groupArray(trimLeft(explain)), ' | ') FROM (EXPLAIN indexes = 1 SELECT 1 FROM {{ table }} WHERE {{ predicate }}) WHERE trimLeft(explain) LIKE 'Condition:%'){% endif %}
FORMAT TSVRaw;
{%- endmacro %}

CREATE TABLE test_mt_dt (ts DateTime('UTC')) ENGINE = MergeTree ORDER BY (toYYYYMM(ts), toDate(ts), ts)
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_mt_dt SELECT toDateTime('2026-01-01 00:00:00', 'UTC') + INTERVAL number HOUR FROM numbers(24 * 40);

-- Equality: one predicate constrains all three key columns.
{{ check('test_mt_dt', "ts = toDateTime('2026-01-10 05:00:00', 'UTC')", condition = true) }}
-- Strict and non-strict ranges.
{{ check('test_mt_dt', "ts < toDateTime('2026-01-10 05:00:00', 'UTC')", condition = true) }}
{{ check('test_mt_dt', "ts <= toDateTime('2026-01-10 05:00:00', 'UTC')") }}
{{ check('test_mt_dt', "ts > toDateTime('2026-01-10 05:00:00', 'UTC')") }}
{{ check('test_mt_dt', "ts >= toDateTime('2026-01-10 05:00:00', 'UTC')") }}
{{ check('test_mt_dt', "ts BETWEEN toDateTime('2026-01-10 00:00:00', 'UTC') AND toDateTime('2026-01-11 00:00:00', 'UTC')") }}
-- IN with values spanning two months.
{{ check('test_mt_dt', "ts IN (toDateTime('2026-01-10 00:00:00', 'UTC'), toDateTime('2026-01-10 01:00:00', 'UTC'), toDateTime('2026-02-05 00:00:00', 'UTC'))") }}
-- has(const_array, key).
{{ check('test_mt_dt', "has([toDateTime('2026-01-10 05:00:00', 'UTC'), toDateTime('2026-02-05 00:00:00', 'UTC')], ts)") }}
-- Conjunction and disjunction of ranges.
{{ check('test_mt_dt', "ts >= toDateTime('2026-01-10 00:00:00', 'UTC') AND ts < toDateTime('2026-01-11 00:00:00', 'UTC')") }}
{{ check('test_mt_dt', "ts < toDateTime('2026-01-03 00:00:00', 'UTC') OR ts >= toDateTime('2026-02-08 00:00:00', 'UTC')") }}
-- NOT over a range is rewritten by inversion push-down.
{{ check('test_mt_dt', "NOT (ts < toDateTime('2026-01-10 05:00:00', 'UTC'))") }}
-- Nested AND of OR.
{{ check('test_mt_dt', "(ts < toDateTime('2026-01-02 00:00:00', 'UTC') OR ts >= toDateTime('2026-02-09 00:00:00', 'UTC')) AND ts != toDateTime('2026-01-01 05:00:00', 'UTC')") }}

-- indexHint prunes reads but does not filter rows, so the result reflects whole granules
-- that may contain the value; no ground-truth comparison is applicable.
SELECT min(ts), max(ts) FROM test_mt_dt WHERE indexHint(ts = toDateTime('2026-01-10 05:00:00', 'UTC'));

-- Constant folds.
{{ check('test_mt_dt', "0 AND ts = toDateTime('2026-01-10 05:00:00', 'UTC')") }}
{{ check('test_mt_dt', "1 OR ts = toDateTime('2026-01-10 05:00:00', 'UTC')") }}
{{ check('test_mt_dt', "NULL AND ts = toDateTime('2026-01-10 05:00:00', 'UTC')") }}

-- Negated equality: the direct key column atom is exact and may prune; rows sharing
-- toDate/toYYYYMM with the constant must survive.
{{ check('test_mt_dt', "ts != toDateTime('2026-01-10 05:00:00', 'UTC')") }}
-- Negated IN with a multi-element set.
{{ check('test_mt_dt', "ts NOT IN (toDateTime('2026-01-10 05:00:00', 'UTC'), toDateTime('2026-02-05 00:00:00', 'UTC'))") }}

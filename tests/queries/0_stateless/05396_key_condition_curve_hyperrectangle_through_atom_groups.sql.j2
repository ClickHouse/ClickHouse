-- Tags: no-random-settings, no-random-merge-tree-settings
-- no-random-settings, no-random-merge-tree-settings: the selected marks may differ with random settings.

{#- Each check prints the predicate, the count with index analysis, the count of a full scan and the marks
    selected by index analysis. -#}
{% macro check(table, predicate) -%}
SELECT '{{ predicate | replace("\\", "\\\\") | replace("'", "\\'") }}', (SELECT count() FROM {{ table }} WHERE {{ predicate }}),
    (SELECT count() FROM {{ table }} WHERE {{ predicate }} SETTINGS use_primary_key = 0, use_partition_pruning = 0, use_skip_indexes = 0),
    (SELECT sum(marks) FROM (EXPLAIN ESTIMATE SELECT 1 FROM {{ table }} WHERE {{ predicate }}))
FORMAT TSVRaw;
{%- endmacro %}

SET analyze_index_with_multiple_key_columns_per_condition = 1;

-- With `ORDER BY (mortonEncode(x, y), x + 1, y + 1)`, a leaf such as `x = 0` constrains both an argument of
-- the curve and `x + 1`, so its hyperrectangle is an atom of a group. A conjunction still checks the
-- intersection of the hyperrectangles of its leaves. Granule n holds the points (2^n, 0) and (0, 2^n): each
-- granule meets the strips `x = 0` and `y = 0`, but none meets [0, 0] × [0, 0].
CREATE TABLE t_curve (x UInt32, y UInt32) ENGINE = MergeTree ORDER BY (mortonEncode(x, y), x + 1, y + 1)
SETTINGS index_granularity = 2048, index_granularity_bytes = 0, min_bytes_for_wide_part = 0,
    add_minmax_index_for_numeric_columns = 0;
INSERT INTO t_curve SELECT
    if(number % 2048 < 1024, bitShiftLeft(toUInt32(1), intDiv(number, 2048)), 0),
    if(number % 2048 < 1024, 0, bitShiftLeft(toUInt32(1), intDiv(number, 2048)))
FROM numbers(30 * 2048);
{{ check('t_curve', "x = 0 AND y = 0") }}
-- The intersection reaches through a conjunction that holds another atom between the two leaves.
{{ check('t_curve', "x = 0 AND x + 1 < 100 AND y = 0") }}

-- An `OR` does not pass the hyperrectangle of one of its operands on: `(1, 1)` and `(2, 1)` both match.
CREATE TABLE t_curve_or (x UInt32, y UInt32) ENGINE = MergeTree ORDER BY (mortonEncode(x, y), x + 1, y + 1)
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO t_curve_or VALUES (0, 0), (1, 1), (2, 1), (4, 4);
{{ check('t_curve_or', "(x = 1 OR x = 2) AND y = 1") }}

#!/usr/bin/env python3

# Generate some random SQL queries.

import os
import random
import re
import string
import sys


def rand_word(max_len=8, alphabet=string.ascii_lowercase):
    length = 1 + int(random.random() * max_len)
    return "".join(random.choice(alphabet) for _ in range(length))


def one(value):
    return value() if callable(value) else value


def one_of(options):
    if isinstance(options, list):
        value = random.choice(options)
    else:
        value = options[random.choice(sorted(options))]
    return one(value)


def list_of(opt, *sources):
    max_count = opt.get("min", 1) + int(random.random() * opt.get("max", 4))
    ret = []
    while len(ret) < max_count:
        shuffled = list(sources)
        random.shuffle(shuffled)
        for source in shuffled:
            ret.append(one_of(source))
    return ", ".join(ret)


def file_read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def read_names(env_inline, env_file, default_file):
    text = os.environ.get(env_inline) or file_read(
        os.environ.get(env_file) or default_file
    )
    return [name for name in re.split(r"[\s;,]+", text) if name]


TYPE_CAST = {name: name for name in ["DateTime", "Date", "String"]}
TYPE = dict(TYPE_CAST)
TYPE.update(
    {
        name: name
        for name in [
            "Int8",
            "Int16",
            "Int32",
            "Int64",
            "UInt8",
            "UInt16",
            "UInt32",
            "UInt64",
            "Float32",
            "Float64",
        ]
    }
)
for name in list(TYPE.values()):
    TYPE[f"Nullable({name})"] = f"Nullable({name})"

FUNCTIONS = []
TABLE_FUNCTIONS = []
EXPRESSION = {}
QUERY_SELECT = {}


def gen_cast():
    return f"(CAST(({one_of(EXPRESSION)}) AS {one_of(TYPE_CAST)}))"


def gen_subselect():
    return list_of(
        {"max": 2},
        [
            lambda: f"( {one_of(QUERY_SELECT)} ) AS {rand_word()}",
            lambda: f"( {one_of(QUERY_SELECT)} ) ",
        ],
    )


def gen_number():
    return (
        random.choice(["", "-"])
        + rand_word(8, string.digits)
        + random.choice(["", "." + rand_word(6, string.digits)])
    )


def gen_string():
    alphabet = ["\\'" if chr(c) == "'" else chr(c) for c in range(32, 128)]
    return "'" + rand_word(8, alphabet) + "'"


def gen_array():
    return f"[{one_of(EXPRESSION)}]"


def gen_function():
    return f"{one_of(FUNCTIONS)}({list_of({'min': 0, 'max': 3}, EXPRESSION)})"


EXPRESSION.update(
    {
        "CAST": gen_cast,
        "SELECT": gen_subselect,
        "number": gen_number,
        "string": gen_string,
        "[]": "[]",
        "[x]": gen_array,
        "function()": gen_function,
        "'\\0'": "'\\0'",
        "''": "''",
        "NULL": "NULL",
    }
)

QUERY_SELECT.update(
    {
        "SELECT": lambda: "SELECT " + list_of({"max": 5}, EXPRESSION),
        "SELECT function()": lambda: "SELECT " + gen_function(),
        "SELECT table_function()": lambda: (
            f"SELECT * FROM {one_of(TABLE_FUNCTIONS)}"
            f"({list_of({'min': 0, 'max': 3}, EXPRESSION)})"
        ),
    }
)


def main():
    if os.environ.get("SQL_FUZZY_SRAND"):
        random.seed(
            int(os.environ["SQL_FUZZY_SRAND"]) + int(os.environ.get("SQL_FUZZY_RUN", 0))
        )

    # select name from system.functions format TSV;
    FUNCTIONS.extend(
        read_names(
            "SQL_FUZZY_FUNCTIONS", "SQL_FUZZY_FILE_FUNCTIONS", "clickhouse-functions"
        )
    )
    # select name from system.table_functions format TSV;
    TABLE_FUNCTIONS.extend(
        name
        for name in read_names(
            "SQL_FUZZY_TABLE_FUNCTIONS",
            "SQL_FUZZY_FILE_TABLE_FUNCTIONS",
            "clickhouse-table-functions",
        )
        if name != "numbers"  # too slow
    )

    for _ in range(int(os.environ.get("SQL_FUZZY_LINES", 100))):
        print(one_of(QUERY_SELECT) + ";")


if __name__ == "__main__":
    sys.setrecursionlimit(10000)
    main()

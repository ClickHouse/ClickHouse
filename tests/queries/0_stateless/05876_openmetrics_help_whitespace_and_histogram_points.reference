--- leading whitespace of the help text survives a round trip
{"metric_name":"mixed","help":" \t mixed, and trailing \t ","length(help)":25}
{"metric_name":"spaces","help":"  two leading spaces","length(help)":20}
{"metric_name":"tab","help":"\tleading tab","length(help)":12}
--- the separator before the help text is a single character, the rest is the text
{"help":"  x","length(help)":3}
{"help":"","length(help)":0}
{"help":"","length(help)":0}
--- a histogram point without the +Inf bucket is rejected
--- decreasing cumulative bucket counts are rejected
--- the count must equal the +Inf bucket
--- valid points: several label sets and timestamps, rows in any order
# TYPE h histogram
h_bucket{job="a",le="1"} 3 1
h_bucket{job="a",le="+Inf"} 3 1
h_count{job="a"} 3 1
h_sum{job="a"} 2.5 1
h_bucket{job="a",le="1"} 4 2
h_bucket{job="a",le="+Inf"} 5 2
h_count{job="a"} 5 2
h_sum{job="a"} 7 2
h_created{job="b"} 0 0
h_bucket{job="b",le="+Inf"} 0 1
# EOF

-- sort_desc(up): descending by value (30, 20, 10)
[('__name__','up'),('instance','host1')]	2023-11-14 22:13:20.000	30
[('__name__','up'),('instance','host3')]	2023-11-14 22:13:20.000	20
[('__name__','up'),('instance','host2')]	2023-11-14 22:13:20.000	10
-- sort(sort_desc(up)): ascending again (cancels out)
[('__name__','up'),('instance','host2')]	2023-11-14 22:13:20.000	10
[('__name__','up'),('instance','host3')]	2023-11-14 22:13:20.000	20

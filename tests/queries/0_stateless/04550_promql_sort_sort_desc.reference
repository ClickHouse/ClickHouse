-- sort on expression: sort(up * 2) ascending (20, 40, 60)
[('instance','host2')]	2023-11-14 22:13:20.000	20
[('instance','host3')]	2023-11-14 22:13:20.000	40
[('instance','host1')]	2023-11-14 22:13:20.000	60
-- sort_desc(sort_by_label(up, 'instance')): sort() must override the ordering mode entirely,
-- so this is descending by value (30, 20, 10), not descending by the 'instance' label
[('__name__','up'),('instance','host1')]	2023-11-14 22:13:20.000	30

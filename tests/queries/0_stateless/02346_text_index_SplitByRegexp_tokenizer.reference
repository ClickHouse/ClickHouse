class: hasAnyTokens([cyan]) -> (none)
negation: tokens of each row
1	['bar','baz','foo']
2	['hello','test']
3	['corge','quux','qux']
negation: hasAnyTokens([bar]) -> 1
1
negation: hasAnyTokens([test]) -> 2
2
negation: hasAnyTokens([world]) -> (none, WORLD was a separator)
negation: hasAllTokens([qux, corge]) -> 3
3
special: hasAnyTokens([C++]) -> 1 (no false positives)
1
special: hasAnyTokens([C#]) -> 2
2
special: hasAnyTokens([C]) -> 3, 4 (plain C only)
3
4
phrase: hasPhrase([C# and]) -> 2 (not row 1 with C++)
2
phrase: hasPhrase([C++ and]) -> 1
1

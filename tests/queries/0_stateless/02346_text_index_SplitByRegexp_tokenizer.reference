simple: hasAnyTokens([banana]) -> 1, 2
1
2
simple: hasAnyTokens([cherry, date]) -> 1, 2, 3
1
2
3
simple: hasAllTokens([banana, cherry]) -> 1
1
simple: hasAnyTokens([watermelon]) -> (none)
class: hasAnyTokens([green]) -> 1, 2
1
2
class: hasAnyTokens([blue]) -> 1, 3
1
3

#!/usr/bin/expect -f

# The client issues plain-SQL helper queries on its own behalf (the `system.documentation` lookup
# behind the interactive `help` command, autocomplete, the AI metadata query). They are sent with only
# the network-compression settings that the user changed explicitly (see `networkCompressionSettings`).
# Values that were merely derived from the `compatibility` setting must not be serialized: ordinary
# queries strip them (`ClientBase::settingsWithoutCompatibilityDerived`) and let the server re-derive
# them from `compatibility`, so under a profile that pins `network_compression_method` read-only an
# ordinary query works. Without the stripping, a session that only set `compatibility` would serialize
# an explicit `network_compression_method` on the helper queries and they would fail the constraint.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0
set history_file $CLICKHOUSE_TMP/$basename.history
set user "user_04665_$env(CLICKHOUSE_DATABASE)"

log_user 0
set timeout 60
match_max 100000
expect_after {
    # Do not ignore eof from expect
    -i $any_spawn_id eof { exp_continue }
    # A default timeout action is to do nothing, change it to fail
    -i $any_spawn_id timeout { exit 1 }
}

# Create a user whose profile pins the network compression settings read-only.
spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --history_file=$history_file"
expect ":) "
send -- "DROP USER IF EXISTS $user\r"
expect "Ok."
expect ":) "
send -- "CREATE USER $user SETTINGS network_compression_method READONLY, network_zstd_compression_level READONLY\r"
expect "Ok."
expect ":) "
send -- "GRANT SELECT ON system.documentation TO $user\r"
expect "Ok."
expect ":) "
send -- "GRANT SHOW TABLES ON $env(CLICKHOUSE_DATABASE).* TO $user\r"
expect "Ok."
expect ":) "
send -- "exit\r"
expect eof

# Connect as that user with only `compatibility` set (old enough that it derives
# `network_compression_method`/`network_zstd_compression_level` values different from the defaults).
spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --user $user --compatibility 26.6 --history_file=$history_file"
expect ":) "

# An ordinary query works: it serializes `compatibility` itself, not the derived values.
send -- "SELECT 'ordinary query works'\r"
expect "ordinary query works"
expect ":) "

# The help command's `system.documentation` helper queries must work as well: the derived network
# settings must not be serialized as explicit changes, or the read-only constraint rejects them.
send -- "help zzzzzzzzzzzznotanentity\r"
expect {
    "The help command failed:" { exit 1 }
    "No documentation found for 'zzzzzzzzzzzznotanentity'." { }
}
expect ":) "

send -- "exit\r"
expect eof

spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --history_file=$history_file"
expect ":) "
send -- "DROP USER $user\r"
expect "Ok."
expect ":) "
send -- "exit\r"
expect eof

-- common subexpression
select sum(flag) from (select and(a % 2 = 2, or(b % 3 = 1, or(a % 2 = 1, c % 5 = 1))) as flag from (select number as a, number + 1 as b, number + 2 as c from numbers_mt(30000)));
0
-- mixed lazy and non-lazy arguments, and a shared lazy argument

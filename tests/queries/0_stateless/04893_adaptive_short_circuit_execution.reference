0
-- mixed lazy and non-lazy arguments, and a shared lazy argument
select sum(flag) from (select and(number % 2 = 1, number, number % 3 = 1) as flag from numbers_mt(30000));
5000
select sum(flag) from (select or(number % 2 = 1, number, number % 3 = 1) as flag from numbers_mt(30000));
29999
WITH number % 2 = 1 AS shared select sum(and(number % 3 = 1, or(shared, shared))) from numbers_mt(30000);
5000
select sum(val) from (select multiIf(a%7=1, 1, b % 5 = 1 , 2, c % 3 = 1, 3, 4) as val from (select number as a, number + 1 as b, number + 2 as c from numbers_mt(30000)));
89999
SET short_circuit_function_evaluation= 'force_enable';
select sum(flag) from (select and(a != 1, intDiv(4, b) > 0) as flag from (select (number + 1) % 2 as a, number % 2 as b from numbers_mt(30000)));
15000
-- A comparison can throw as well: comparing decimals with different scales overflows for large values.
-- Only the rows surviving the first argument are small enough, so this argument must never be switched to
-- eager execution. Most of the rows survive, which is exactly when eager execution looks profitable.
select sum(flag) from (select and(a < 90, toDecimal64(a, 0) > toDecimal64(1, 17)) as flag from (select number % 101 as a from numbers_mt(30300)));
26400
SET short_circuit_function_evaluation= 'enable';
select sum(flag) from (select and(a != 1, intDiv(4, b) > 0) as flag from (select (number + 1) % 2 as a, number % 2 as b from numbers_mt(30000)));
15000
-- A comparison can throw as well: comparing decimals with different scales overflows for large values.
-- Only the rows surviving the first argument are small enough, so this argument must never be switched to
-- eager execution. Most of the rows survive, which is exactly when eager execution looks profitable.
select sum(flag) from (select and(a < 90, toDecimal64(a, 0) > toDecimal64(1, 17)) as flag from (select number % 101 as a from numbers_mt(30300)));
26400

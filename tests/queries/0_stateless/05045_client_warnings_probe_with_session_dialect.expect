#!/usr/bin/expect -f

# The client loads the server warnings with a plain-SQL probe of its own (`Client::loadWarningMessages`).
# The probe sends the session settings, because `system.warnings` is partly derived from the settings
# the server sees for the query. It must still parse under a session-level `dialect`, because the probe
# is ClickHouse SQL while `Connection::sendQuery` serializes every changed setting, so the server would
# otherwise try to parse it as Kusto.
#
# `showWarnings` swallows any exception from the probe, so a regression is silent: the warnings simply
# stop being displayed.
#
# There are two halves: the session-level `SET dialect` / `--dialect` case, and the case where the
# session never changes `dialect` but the authenticated user's profile defaults to a foreign one -
# only changed settings are serialized, so the override has to be unconditional. Both are pinned here.
#
# The warning to display: a query that changes an obsolete setting adds a server-wide warning.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0
set history_file $CLICKHOUSE_TMP/$basename.history
set user "user_$env(CLICKHOUSE_DATABASE)"
set profile "profile_$env(CLICKHOUSE_DATABASE)"

log_user 0
set timeout 60
match_max 100000
expect_after {
    # Do not ignore eof from expect
    -i $any_spawn_id eof { exp_continue }
    # A default timeout action is to do nothing, change it to fail
    -i $any_spawn_id timeout { exit 1 }
}

exec bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT -q 'SELECT 1 SETTINGS max_memory_usage_for_all_queries = 123' > /dev/null"

spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \${CLICKHOUSE_CLIENT_EXPECT_OPT/--no-warnings} --enable_kusto_dialect 1 --dialect kusto --history_file=$history_file"

expect "Warnings:"
expect " * Queries or settings profiles changed obsolete settings"
expect ":) "

send -- "\4"
expect eof

# Second half: no session-level `dialect` at all; the authenticated user's profile defaults to Kusto.
spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --history_file=$history_file"
expect ":) "

send -- "DROP USER IF EXISTS $user\r"
expect "Ok."
expect ":) "

send -- "DROP SETTINGS PROFILE IF EXISTS $profile\r"
expect "Ok."
expect ":) "

send -- "CREATE SETTINGS PROFILE $profile SETTINGS dialect = 'kusto', enable_kusto_dialect = 1\r"
expect "Ok."
expect ":) "

send -- "CREATE USER $user SETTINGS PROFILE '$profile'\r"
expect "Ok."
expect ":) "

send -- "GRANT SELECT ON *.* TO $user\r"
expect "Ok."
expect ":) "

send -- "\4"
expect eof

spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \${CLICKHOUSE_CLIENT_EXPECT_OPT/--no-warnings} --user $user --history_file=$history_file"

expect "Warnings:"
expect " * Queries or settings profiles changed obsolete settings"
expect ":) "

send -- "\4"
expect eof

spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_CLIENT_BINARY \$CLICKHOUSE_CLIENT_EXPECT_OPT --history_file=$history_file"
expect ":) "

send -- "DROP USER IF EXISTS $user\r"
expect "Ok."
expect ":) "

send -- "DROP SETTINGS PROFILE IF EXISTS $profile\r"
expect "Ok."
expect ":) "

send -- "\4"
expect eof

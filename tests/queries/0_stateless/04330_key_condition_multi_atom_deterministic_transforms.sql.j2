-- Tags: no-random-settings, no-random-merge-tree-settings
-- no-random-settings, no-random-merge-tree-settings: the selected marks and EXPLAIN output may differ with
-- random settings.

SET explain_query_plan_default = 'legacy';

{#- Each check prints the predicate, the count with index analysis, the count of a full scan and the marks
    selected by index analysis (with `indexes`, the parts and granules selected by each index instead); with
    `condition`, it also prints the key condition. -#}
{% macro check(table, predicate, condition = false, indexes = false) -%}
SELECT '{{ predicate | replace("\\", "\\\\") | replace("'", "\\'") }}', (SELECT count() FROM {{ table }} WHERE {{ predicate }}),
    (SELECT count() FROM {{ table }} WHERE {{ predicate }} SETTINGS use_primary_key = 0, use_partition_pruning = 0, use_skip_indexes = 0),
    {% if indexes -%}
    (SELECT arrayStringConcat(groupArray(trimLeft(explain)), ' ') FROM (EXPLAIN indexes = 1 SELECT 1 FROM {{ table }} WHERE {{ predicate }}) WHERE match(trimLeft(explain), '^(Min-Max|Partition|Statistics|PrimaryKey|Skip|Name:|Parts:|Granules:)'))
    {%- else -%}
    (SELECT sum(marks) FROM (EXPLAIN ESTIMATE SELECT 1 FROM {{ table }} WHERE {{ predicate }}))
    {%- endif %}
    {%- if condition %}, (SELECT arrayStringConcat(groupArray(trimLeft(explain)), ' | ') FROM (EXPLAIN indexes = 1 SELECT 1 FROM {{ table }} WHERE {{ predicate }}) WHERE trimLeft(explain) LIKE 'Condition:%'){% endif %}
FORMAT TSVRaw;
{%- endmacro %}

-- Both key columns are non-injective deterministic transforms of `ts`. Equality uses
-- the monotonic `toDate` candidate and the deterministic `cityHash64` candidate. For `!=`,
-- deterministic transforms produce relaxed atoms on both columns, which cannot prune
-- through negation.
CREATE TABLE test_det_multi (ts DateTime('UTC')) ENGINE = MergeTree ORDER BY (toDate(ts), cityHash64(ts))
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_det_multi SELECT toDateTime('2026-03-01 00:00:00', 'UTC') + INTERVAL intDiv(number, 4) DAY + INTERVAL (number % 4) * 6 HOUR FROM numbers(12);

{{ check('test_det_multi', "ts = toDateTime('2026-03-02 06:00:00', 'UTC')", condition = true) }}
{{ check('test_det_multi', "ts != toDateTime('2026-03-02 06:00:00', 'UTC')") }}

-- Injective transform: negated equality stays exact and can prune. It selects every granule on
-- this data, so the condition shows that the negated equality still builds its atom.
CREATE TABLE test_det_injective (s String) ENGINE = MergeTree ORDER BY concat(s, '_x')
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_det_injective VALUES ('a'), ('b'), ('c');

{{ check('test_det_injective', "s = 'a'") }}
{{ check('test_det_injective', "s != 'a'", condition = true) }}

-- The key transform throws for the constant: no atom, full scan, no exception.
CREATE TABLE test_det_throwing (s String) ENGINE = MergeTree ORDER BY toUUID(s)
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_det_throwing VALUES ('00000000-0000-0000-0000-000000000001'), ('00000000-0000-0000-0000-000000000002');

{{ check('test_det_throwing', "s = '00000000-0000-0000-0000-000000000001'") }}
{{ check('test_det_throwing', "s = 'not-a-uuid'", condition = true) }}

-- The transform produces NaN for the constant: the sqrt(c0) candidate is skipped,
-- but the direct c0 key column still prunes.
CREATE TABLE test_det_nan (c0 Int32) ENGINE = MergeTree ORDER BY (sqrt(c0), c0)
SETTINGS allow_suspicious_indices = 1, index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_det_nan SELECT number - 50 FROM numbers(100);

{{ check('test_det_nan', "c0 = -30", condition = true) }}
{{ check('test_det_nan', "c0 = 25") }}

-- intDiv key: equality prunes, negated equality is relaxed.
CREATE TABLE test_det_intdiv (x UInt32) ENGINE = MergeTree ORDER BY intDiv(x, 10)
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_det_intdiv SELECT number FROM numbers(100);

{{ check('test_det_intdiv', "x = 55") }}
{{ check('test_det_intdiv', "x != 55") }}

-- ALIAS node inside the key expression chain.
CREATE TABLE test_det_alias (ts DateTime('UTC')) ENGINE = MergeTree ORDER BY (toDate(ts) AS d, ts)
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_det_alias SELECT toDateTime('2026-03-01 00:00:00', 'UTC') + INTERVAL intDiv(number, 4) DAY + INTERVAL (number % 4) * 6 HOUR FROM numbers(12);

{{ check('test_det_alias', "ts = toDateTime('2026-03-02 06:00:00', 'UTC')", condition = true) }}

-- Tables created with moduloLegacy in the partition key accept modulo predicates.
CREATE TABLE test_det_modulo_legacy (k UInt64) ENGINE = MergeTree PARTITION BY moduloLegacy(k, 16) ORDER BY k
SETTINGS index_granularity = 1;
INSERT INTO test_det_modulo_legacy SELECT number FROM numbers(32);

{{ check('test_det_modulo_legacy', "k % 16 = 3", indexes = true) }}

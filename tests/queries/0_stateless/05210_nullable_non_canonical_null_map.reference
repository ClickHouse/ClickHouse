-- { echo }
-- Random settings limits: compile_expressions=(0, 0); ratio_of_defaults_for_sparse_serialization=(1.0, 1.0); optimize_multiif_to_if=(1, 1)
-- A null-map byte is a predicate, not a value: any non-zero byte means NULL. `if` writes 0 and 1, but
-- Native input keeps the bytes a sender wrote, so `t_bytes` carries them: `s` and `c` hold `id % 3`
-- (0, 1 and 2), `s2` and `u` twice that, `s3` the bytes 2, 4 and 6. Byte 0 marks the rows holding a
-- value; the others are equally NULL. Every query below tests nullness rather than the byte, so each
-- must answer as if the map held only 0 and 1.
CREATE TABLE t_bytes (id UInt64, s Nullable(String), s2 Nullable(String), s3 Nullable(String), u Nullable(UInt32), c Nullable(UInt8), w Nullable(UInt16)) ENGINE = Memory;
-- A Native block of three rows: per column its name, its type, its null map, then its values.
INSERT INTO t_bytes SELECT r + 3 * k, s, s2, s3, u, c, w FROM format(Native, concat('\x07\x03',
    '\x01r\x05UInt8', '\x00\x01\x02',
    '\x01s\x10Nullable(String)', '\x00\x01\x02', '\x01x\x01x\x01x',
    '\x02s2\x10Nullable(String)', '\x00\x02\x04', '\x01x\x01x\x01x',
    '\x02s3\x10Nullable(String)', '\x02\x04\x06', '\x01x\x01x\x01x',
    '\x01u\x10Nullable(UInt32)', '\x00\x02\x04', '\x07\x00\x00\x00\x07\x00\x00\x00\x07\x00\x00\x00',
    '\x01c\x0fNullable(UInt8)', '\x00\x01\x02', '\x01\x01\x01',
    '\x01w\x10Nullable(UInt16)', '\x00\x01\x02', '\xe8\x03\xe8\x03\xe8\x03')) ARRAY JOIN range(10) AS k;
-- The aggregates read the DISTINCT result from the outside: an `ORDER BY` on the DISTINCT itself
-- would sort the keys and answer from `compareAt`, which is nullness-based already.
SELECT count(), countIf(e IS NULL), arraySort(groupUniqArray(e)) FROM (SELECT DISTINCT s AS e FROM t_bytes);
2	1	['x']
SELECT 1 AS k, s AS e FROM t_bytes GROUP BY k, e ORDER BY e NULLS FIRST;
1	\N
1	x
-- No byte of `s2` and `u` equals 1. A reader that scans for the literal byte 1 then reports the block
-- as NULL-free and merges the NULL rows into the value.
SELECT e FROM (SELECT s2 AS e FROM t_bytes) GROUP BY e ORDER BY e NULLS FIRST;
\N
x
SELECT DISTINCT u FROM t_bytes ORDER BY 1 NULLS FIRST;
\N
7
SELECT DISTINCT tuple(s) FROM t_bytes ORDER BY 1;
('x')
(NULL)
-- A hash-only aggregate reaches the byte through `updateHashWithValue`, and keeps nothing but the
-- hash. The argument has to be a tuple: a Nullable argument's NULLs are dropped by the aggregate's
-- Null combinator and never reach the hash. Removing that tuple as an injective wrapper drops them
-- again (#114784, covered by 04927), so the elimination stays off here. Second column: the control.
SELECT uniqExact(tuple(s)), uniqExact(tuple(if(id % 2, NULL, 'x'))) FROM t_bytes SETTINGS optimize_injective_functions_inside_uniq = 0;
2	2
-- Negating a null map must negate its nullness, not its bits: `1 ^ 2` is truthy, which turned rows
-- holding 'x' into NULLs. Only the group whose condition byte is 2 was affected.
SELECT number % 3 AS c, countIf(v IS NULL) FROM (SELECT number, if(number % 3, toNullable('x'), NULL) AS v FROM numbers(30)) GROUP BY c ORDER BY c;
0	10
1	0
2	0
SELECT count(), countIf(e IS NULL), arraySort(groupUniqArray(e)) FROM (SELECT DISTINCT if(number % 3, NULL, CAST('x' AS LowCardinality(Nullable(String)))) AS e FROM numbers(30));
2	1	['x']
-- A NULL condition selects no branch. Only a three-argument `multiIf` is rewritten to `if`
-- (`MultiIfToIfPass`), so the five arguments here keep it on `multiIf`. Its columnar path is the one
-- that reads the condition's null map; the row-wise fallback is truthiness-based already.
SELECT r, count() FROM (SELECT multiIf(c, toUInt32(11), id % 7 = 0, toUInt32(33), toUInt32(22)) AS r FROM t_bytes) GROUP BY r ORDER BY r SETTINGS allow_execute_multiif_columnar = 1;
11	10
22	17
33	3
-- An aggregate whose result is Nullable must return NULL for a block in which every row is NULL. The
-- bytes of `s3` are 2, 4 and 6, so a reader looking for the literal byte 1 finds none, calls the block
-- non-NULL, and emits the nested aggregate's never-updated state.
SELECT max(s3) AS m, m IS NULL AS m_is_null FROM t_bytes;
\N	1
-- Two non-empty variants are needed to reach the general Variant null-map branch; with a single
-- variant and no existing NULLs a separate fast path applies, which is nullness-based already.
SELECT countIf(v IS NULL) FROM (SELECT if(number % 3, if(number % 2, 'x', toUInt8(7)), NULL) AS v FROM numbers(30));
10
-- Only a NULL that is NEW in the converted element is a conversion failure. 1000 overflows UInt8, so
-- the byte-0 rows are the only failures; a source NULL must stay a tuple holding NULL, not a NULL
-- tuple. The target element type must differ from the source, or the result map IS the source map.
SELECT countIf(tp IS NULL) FROM (SELECT accurateCastOrNull(tuple(w), 'Tuple(Nullable(UInt8))') AS tp FROM t_bytes);
10
-- Such a null map survives a write and read back, so it is not confined to expression results.
CREATE TABLE t_null_map_bytes (e Nullable(String)) ENGINE = MergeTree ORDER BY tuple();
INSERT INTO t_null_map_bytes SELECT s FROM t_bytes;
SELECT count(), countIf(e IS NULL), arraySort(groupUniqArray(e)) FROM (SELECT DISTINCT e FROM t_null_map_bytes);
2	1	['x']
DROP TABLE t_null_map_bytes;
-- A DIRECT layout reads its source rows on demand and passes them through, so the stored null map
-- reaches the reverse lookup's own comparison result. A NULL attribute must not match a value. The
-- caching layouts rebuild the map, which is why only DIRECT exposes this.
CREATE TABLE t_null_map_dict_src (id UInt64, attr Nullable(String)) ENGINE = MergeTree ORDER BY id;
INSERT INTO t_null_map_dict_src SELECT id, s FROM t_bytes;
CREATE DICTIONARY d_null_map_direct (id UInt64, attr Nullable(String)) PRIMARY KEY id SOURCE(CLICKHOUSE(TABLE 't_null_map_dict_src')) LAYOUT(DIRECT());
SELECT length(dictGetKeys('d_null_map_direct', 'attr', 'x'));
10
DROP DICTIONARY d_null_map_direct;
DROP TABLE t_null_map_dict_src;
-- Controls: a canonical 0/1 null map must be unaffected.
SELECT count(), countIf(e IS NULL), arraySort(groupUniqArray(e)) FROM (SELECT DISTINCT if(number % 2, NULL, 'x') AS e FROM numbers(30));
2	1	['x']
SELECT number % 2 AS c, countIf(v IS NULL) FROM (SELECT number, if(number % 2, toNullable('x'), NULL) AS v FROM numbers(30)) GROUP BY c ORDER BY c;
0	15
1	0
-- `if` writes the byte 1 for a NULL row, whatever its condition held.
SELECT arraySort(groupUniqArray(e.null)) FROM (SELECT if(number % 3, NULL, 'x') AS e FROM numbers(30));
[0,1]
-- A state written by an older server can hold the key byte 2 for a NULL. Reading it back writes 1.
CREATE TABLE t_state_null (e Nullable(String)) ENGINE = Memory;
INSERT INTO t_state_null SELECT arrayJoin(finalizeAggregation(CAST(unhex('010102'), 'AggregateFunction(groupUniqArray, Tuple(Nullable(String)))'))).1;
SELECT e.null, e FROM t_state_null;
1	\N
DROP TABLE t_state_null;
-- The reported query: DISTINCT and GROUP BY over one projection must agree.
SELECT
    (SELECT count() FROM (SELECT DISTINCT multiIf(number % 3, -9223372036854775808 < moduloLegacy(number, NULL), '^$') FROM numbers(150))) AS distinct_rows,
    (SELECT count() FROM (SELECT multiIf(number % 3, -9223372036854775808 < moduloLegacy(number, NULL), '^$') AS e FROM numbers(150) GROUP BY e)) AS group_by_rows;
2	2
DROP TABLE t_bytes;

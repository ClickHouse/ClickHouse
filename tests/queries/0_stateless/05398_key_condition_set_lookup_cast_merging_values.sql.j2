-- Tags: no-random-settings, no-random-merge-tree-settings
-- no-random-settings, no-random-merge-tree-settings: the selected marks may differ with random settings.

{#- Each check prints the predicate, the count with index analysis, the count of a full scan and the marks
    selected by index analysis. -#}
{% macro check(table, predicate) -%}
SELECT '{{ predicate | replace("\\", "\\\\") | replace("'", "\\'") }}', (SELECT count() FROM {{ table }} WHERE {{ predicate }}),
    (SELECT count() FROM {{ table }} WHERE {{ predicate }} SETTINGS use_primary_key = 0, use_partition_pruning = 0, use_skip_indexes = 0),
    (SELECT sum(marks) FROM (EXPLAIN ESTIMATE SELECT 1 FROM {{ table }} WHERE {{ predicate }}))
FORMAT TSVRaw;
{%- endmacro %}

-- `x IN (SELECT ...)` looks a value up by casting it into the type of the set. When that cast maps different values
-- onto one element, the element matches all of them, while index analysis converts the element into a single value
-- of the column, so the index must not prune by such a set. A set whose cast keeps the values apart still prunes.

SET analyze_index_with_multiple_key_columns_per_condition = 1;

-- A narrower `DateTime64` scale truncates: the `DateTime64(3)` element matches the `.123456` row.
CREATE TABLE t_scale (x DateTime64(6, 'UTC')) ENGINE = MergeTree ORDER BY x
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO t_scale SELECT toDateTime64('2026-01-01 00:00:00.123456', 6, 'UTC') + number FROM numbers(8);
{{ check('t_scale', "x IN (SELECT toDateTime64('2026-01-01 00:00:00.123', 3, 'UTC'))") }}
{{ check('t_scale', "x NOT IN (SELECT toDateTime64('2026-01-01 00:00:00.123', 3, 'UTC'))") }}

-- The key columns computed from `x` get their atoms from the set as well.
CREATE TABLE t_scale_derived (x DateTime64(6, 'UTC')) ENGINE = MergeTree ORDER BY (toDate(x), toString(x))
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO t_scale_derived SELECT x FROM t_scale;
{{ check('t_scale_derived', "x IN (SELECT toDateTime64('2026-01-01 00:00:00.123', 3, 'UTC'))") }}
{{ check('t_scale_derived', "x NOT IN (SELECT toDateTime64('2026-01-01 00:00:00.123', 3, 'UTC'))") }}

-- `DateTime` into `Date` drops the time: the element matches every time of its day.
CREATE TABLE t_date_time (dt DateTime('UTC')) ENGINE = MergeTree ORDER BY dt
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO t_date_time SELECT toDateTime('2026-01-01 10:00:00', 'UTC') + number * 21600 FROM numbers(8);
{{ check('t_date_time', "dt IN (SELECT toDate('2026-01-02'))") }}
{{ check('t_date_time', "dt IN (SELECT toDateTime64('2026-01-02 04:00:00', 3, 'UTC'))") }}

-- A narrower `Decimal` scale truncates.
CREATE TABLE t_decimal (d Decimal64(4)) ENGINE = MergeTree ORDER BY d
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO t_decimal SELECT toDecimal64(1.2345, 4) + number FROM numbers(8);
{{ check('t_decimal', "d IN (SELECT toDecimal64(1.23, 2))") }}
{{ check('t_decimal', "d IN (SELECT toDecimal128(1.2345, 6))") }}

-- `Bool` takes every nonzero number to `true`.
CREATE TABLE t_bool (x UInt8) ENGINE = MergeTree ORDER BY x
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO t_bool SELECT number FROM numbers(8);
{{ check('t_bool', "x IN (SELECT true)") }}
{{ check('t_bool', "x IN (SELECT toUInt32(5))") }}

-- Casting into `FixedString` pads `'abc'` and `'abc\0'` alike, also inside a tuple.
CREATE TABLE t_padding (t Tuple(String, UInt8)) ENGINE = MergeTree ORDER BY t SETTINGS index_granularity = 1;
INSERT INTO t_padding SELECT (['abc', 'abc\0', 'abd', 'abd\0'][number % 4 + 1], toUInt8(1)) FROM numbers(8);
{{ check('t_padding', "t IN (SELECT (toFixedString('abc', 8), toUInt8(1)))") }}

-- The lookup casts named tuples into each other by name. With some names apart it drops the elements without a
-- counterpart: `b` does not take part, so the element matches both rows with `a = 3`.
CREATE TABLE t_names (t Tuple(a UInt8, b UInt8)) ENGINE = MergeTree ORDER BY t
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO t_names SELECT (number % 4, number) FROM numbers(8);
{{ check('t_names', "t IN (SELECT CAST((3, 0), 'Tuple(a UInt8, c UInt8)'))") }}
{{ check('t_names', "t IN (SELECT CAST((7, 3), 'Tuple(b UInt8, a UInt8)'))") }}

-- An array casts element by element, and an array of pairs casts into a `Map` pair by pair.
CREATE TABLE t_array (a Array(Decimal64(4))) ENGINE = MergeTree ORDER BY a SETTINGS index_granularity = 1;
INSERT INTO t_array SELECT [d] FROM t_decimal;
{{ check('t_array', "a IN (SELECT [toDecimal64(1.23, 2)])") }}

CREATE TABLE t_pairs (a Array(Tuple(Decimal64(4), UInt8))) ENGINE = MergeTree ORDER BY a SETTINGS index_granularity = 1;
INSERT INTO t_pairs SELECT [(d, toUInt8(1))] FROM t_decimal;
{{ check('t_pairs', "a IN (SELECT map(toDecimal64(1.23, 2), toUInt8(1)))") }}

-- An `Enum` converts exactly into an integer that holds all its values, and a number renders into a `String`
-- exactly.
CREATE TABLE t_enum (e Enum8('a' = 1, 'b' = 2, 'c' = 3, 'd' = 4, 'e' = 5, 'f' = 6, 'g' = 7, 'h' = 8)) ENGINE = MergeTree ORDER BY e
SETTINGS index_granularity = 1;
INSERT INTO t_enum SELECT number + 1 FROM numbers(8);
{{ check('t_enum', "e IN (SELECT toUInt8(2))") }}
{{ check('t_bool', "x IN (SELECT '5')") }}

-- A number converts into an `Enum` by `static_cast`, so the element of value 1 matches 257 and every other
-- `1 + 256 * n`.
CREATE TABLE t_wide (x Int64) ENGINE = MergeTree ORDER BY x
SETTINGS index_granularity = 1, add_minmax_index_for_numeric_columns = 0;
INSERT INTO t_wide SELECT 1 + 256 * number FROM numbers(8);
{{ check('t_wide', "x IN (SELECT e FROM t_enum WHERE e = 'a')") }}

-- A `Dynamic` stores the key under its own type, and so does a `Variant` that has the key's type as an
-- alternative, so such a set prunes. The cast into any other `Variant` throws, and the query raises that
-- error as a full scan does, although no granule holds the element 100.
{{ check('t_bool', "x IN (SELECT CAST(toUInt8(5), 'Dynamic'))") }}
{{ check('t_bool', "x IN (SELECT CAST(toUInt8(5), 'Variant(UInt8, String)'))") }}
SELECT count() FROM t_bool WHERE x IN (SELECT CAST(toInt64(100), 'Variant(Int64, String)')); -- { serverError CANNOT_CONVERT_TYPE }

-- An enum label and its stored number identify different rows. Transforming the constant must
-- preserve its active type inside `Dynamic` and `Variant`, including the shared `Dynamic` variant.
-- The tested member has the label '37' and stored number 3; the zero-valued enum member lets
-- `accurateCastOrNull` prepare conversion to `String`. Each check pins the selected granules, and the
-- key condition pins the range endpoints of the equality checks, whose counts and granules would be
-- the same for the label and the number.
SET explain_query_plan_default = 'legacy';
SET enable_parallel_replicas = 0;
SET use_query_condition_cache = 0;
SET optimize_use_projections = 0;
SET optimize_trivial_count_query = 0;
SET optimize_trivial_count_with_sparsity_filter = 0;
SET optimize_move_to_prewhere = 0;
SET use_primary_key = 1;
SET use_skip_indexes = 0;
SET max_threads = 1;
SET analyze_index_with_multiple_key_columns_per_condition = 1;

{#- Each check prints the predicate, the count with index analysis, the count of a full scan and the marks
    selected by index analysis, and with `condition` also the key condition. `settings` apply to the whole
    check. -#}
{% macro check(table, predicate, settings = '', condition = false) -%}
SELECT '{{ predicate | replace("\\", "\\\\") | replace("'", "\\'") }}', (SELECT count() FROM {{ table }} WHERE {{ predicate }}),
    (SELECT count() FROM {{ table }} WHERE {{ predicate }} SETTINGS use_primary_key = 0, use_partition_pruning = 0, use_skip_indexes = 0),
    (SELECT sum(marks) FROM (EXPLAIN ESTIMATE SELECT 1 FROM {{ table }} WHERE {{ predicate }}))
    {%- if condition %}, (SELECT arrayStringConcat(groupArray(trimLeft(explain)), ' | ') FROM (EXPLAIN indexes = 1 SELECT 1 FROM {{ table }} WHERE {{ predicate }}) WHERE trimLeft(explain) LIKE 'Condition:%'){% endif %}
    {%- if settings %} SETTINGS {{ settings }}{% endif %}
FORMAT TSVRaw;
{%- endmacro %}

CREATE TABLE test_typed_constant_direct (v String) ENGINE = MergeTree ORDER BY v
SETTINGS index_granularity = 1, index_granularity_bytes = 0, min_rows_for_wide_part = 0, min_bytes_for_wide_part = 0, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_typed_constant_direct SELECT toString(number) FROM numbers(100);
{{ check('test_typed_constant_direct', "v = CAST(CAST('37' AS Enum8('zero' = 0, '37' = 3)) AS Dynamic)", settings = 'analyze_index_with_multiple_key_columns_per_condition = 0') }}
{{ check('test_typed_constant_direct', "v = CAST(CAST('37' AS Enum8('zero' = 0, '37' = 3)) AS Dynamic)", condition = true) }}
{{ check('test_typed_constant_direct', "v = CAST(CAST('37' AS Enum8('zero' = 0, '37' = 3)) AS Dynamic(max_types = 0))", condition = true) }}
{{ check('test_typed_constant_direct', "v = CAST(CAST('37' AS Enum8('zero' = 0, '37' = 3)) AS Variant(Array(UInt8), Enum8('zero' = 0, '37' = 3)))", condition = true) }}
{{ check('test_typed_constant_direct', "v = CAST(CAST('37' AS Enum16('zero' = 0, '37' = 3)) AS Dynamic)", condition = true) }}
{{ check('test_typed_constant_direct', "v = CAST(CAST('37' AS Enum16('zero' = 0, '37' = 3)) AS Dynamic(max_types = 0))", condition = true) }}
{{ check('test_typed_constant_direct', "v = CAST(CAST('37' AS Enum16('zero' = 0, '37' = 3)) AS Variant(Array(UInt8), Enum16('zero' = 0, '37' = 3)))", condition = true) }}

-- Derived-key cases put the constant on the left to exercise comparison normalization.
CREATE TABLE test_typed_constant_derived (v String) ENGINE = MergeTree ORDER BY (reverse(v), v)
SETTINGS index_granularity = 1, index_granularity_bytes = 0, min_rows_for_wide_part = 0, min_bytes_for_wide_part = 0, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_typed_constant_derived SELECT toString(number) FROM numbers(100);
{{ check('test_typed_constant_derived', "CAST(CAST('37' AS Enum8('zero' = 0, '37' = 3)) AS Dynamic) = v", settings = 'analyze_index_with_multiple_key_columns_per_condition = 0') }}
{{ check('test_typed_constant_derived', "CAST(CAST('37' AS Enum8('zero' = 0, '37' = 3)) AS Dynamic) = v", condition = true) }}
{{ check('test_typed_constant_derived', "CAST(CAST('37' AS Enum8('zero' = 0, '37' = 3)) AS Dynamic(max_types = 0)) = v", condition = true) }}
{{ check('test_typed_constant_derived', "CAST(CAST('37' AS Enum8('zero' = 0, '37' = 3)) AS Variant(Array(UInt8), Enum8('zero' = 0, '37' = 3))) = v", condition = true) }}
{{ check('test_typed_constant_derived', "CAST(CAST('37' AS Enum16('zero' = 0, '37' = 3)) AS Dynamic) = v", condition = true) }}
{{ check('test_typed_constant_derived', "CAST(CAST('37' AS Enum16('zero' = 0, '37' = 3)) AS Dynamic(max_types = 0)) = v", condition = true) }}
{{ check('test_typed_constant_derived', "CAST(CAST('37' AS Enum16('zero' = 0, '37' = 3)) AS Variant(Array(UInt8), Enum16('zero' = 0, '37' = 3))) = v", condition = true) }}

-- An inequality exercises the monotonic transform without considering deterministic equality atoms.
-- The relaxed bound includes '37', so pruning reads 32 one-row granules and filtering returns 31 rows.
CREATE TABLE test_typed_constant_monotonic (v String) ENGINE = MergeTree ORDER BY (toString(v), v)
SETTINGS index_granularity = 1, index_granularity_bytes = 0, min_rows_for_wide_part = 0, min_bytes_for_wide_part = 0, add_minmax_index_for_numeric_columns = 0;
INSERT INTO test_typed_constant_monotonic SELECT toString(number) FROM numbers(100);
{{ check('test_typed_constant_monotonic', "v < CAST(CAST('37' AS Enum8('zero' = 0, '37' = 3)) AS Dynamic)", condition = true) }}
{{ check('test_typed_constant_monotonic', "v < CAST(CAST('37' AS Enum8('zero' = 0, '37' = 3)) AS Dynamic(max_types = 0))") }}
{{ check('test_typed_constant_monotonic', "v < CAST(CAST('37' AS Enum8('zero' = 0, '37' = 3)) AS Variant(Array(UInt8), Enum8('zero' = 0, '37' = 3)))") }}
{{ check('test_typed_constant_monotonic', "v < CAST(CAST('37' AS Enum16('zero' = 0, '37' = 3)) AS Dynamic)") }}
{{ check('test_typed_constant_monotonic', "v < CAST(CAST('37' AS Enum16('zero' = 0, '37' = 3)) AS Dynamic(max_types = 0))") }}
{{ check('test_typed_constant_monotonic', "v < CAST(CAST('37' AS Enum16('zero' = 0, '37' = 3)) AS Variant(Array(UInt8), Enum16('zero' = 0, '37' = 3)))") }}

-- Random settings limits: optimize_or_like_chain=(1, None)

-- an `indexHint` in ON of a LEFT JOIN must not stop `full_sorting_merge`: it is always 1 and reads no column

SET join_algorithm = 'full_sorting_merge';

DROP TABLE IF EXISTS t_or_like_join_l;
DROP TABLE IF EXISTS t_or_like_join_r;
CREATE TABLE t_or_like_join_l (n UInt64, s String) ENGINE = MergeTree ORDER BY n;
CREATE TABLE t_or_like_join_r (n UInt64, v String) ENGINE = MergeTree ORDER BY n;
INSERT INTO t_or_like_join_l VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd');
INSERT INTO t_or_like_join_r VALUES (1, 'x'), (2, 'y'), (3, 'z'), (4, 'w');

SELECT 'or like chain';
SELECT l.s, r.v FROM t_or_like_join_l AS l LEFT JOIN t_or_like_join_r AS r ON l.n = r.n AND (r.v LIKE '%x%' OR r.v LIKE '%y%' OR r.v LIKE '%q%' OR r.v LIKE '%r%') ORDER BY l.s;

SELECT 'explicit indexHint';
SELECT l.s, r.v FROM t_or_like_join_l AS l LEFT JOIN t_or_like_join_r AS r ON l.n = r.n AND indexHint(r.v = 'x') ORDER BY l.s;

SELECT 'global right join swapped to left';
SELECT l.s, r.v FROM remote('127.0.0.{1,2}', currentDatabase(), t_or_like_join_l) AS l GLOBAL RIGHT JOIN t_or_like_join_r AS r ON l.n = r.n AND (l.s LIKE '%a%' OR l.s LIKE '%b%' OR l.s LIKE '%q%' OR l.s LIKE '%r%') ORDER BY r.v, l.s;

-- Every join kind each algorithm supports. `indexHint` keeps every row; the chain is on the side that is not preserved.
{% set kinds = ['INNER', 'LEFT', 'RIGHT', 'FULL', 'ANY INNER', 'ANY LEFT', 'ANY RIGHT', 'SEMI LEFT', 'ANTI LEFT', 'SEMI RIGHT', 'ANTI RIGHT', 'ASOF', 'ASOF LEFT'] -%}
{% set unsupported = {
    'hash': [],
    'parallel_hash': [],
    'grace_hash': ['ASOF', 'ASOF LEFT'],
    'partial_merge': ['ANY RIGHT', 'ANTI LEFT', 'SEMI RIGHT', 'ANTI RIGHT', 'ASOF', 'ASOF LEFT'],
    'full_sorting_merge': ['SEMI LEFT', 'ANTI LEFT', 'SEMI RIGHT', 'ANTI RIGHT'],
    'parallel_full_sorting_merge': ['SEMI LEFT', 'ANTI LEFT', 'SEMI RIGHT', 'ANTI RIGHT'],
} -%}
{% for algorithm, skip in unsupported.items() -%}
{% for kind in kinds if kind not in skip -%}
{% set c = 'l.s' if 'RIGHT' in kind else 'r.v' -%}
{% set on = 'l.n = r.n AND l.n >= r.n' if kind.startswith('ASOF') else 'l.n = r.n' -%}
SELECT '{{ algorithm }}', '{{ kind }}', 'indexHint', arraySort(groupArray((l.s, r.v))) FROM t_or_like_join_l AS l {{ kind }} JOIN t_or_like_join_r AS r ON {{ on }} AND indexHint({{ c }} = 'x') SETTINGS join_algorithm = '{{ algorithm }}';
{% if 'sorting' not in algorithm or kind in ['INNER', 'LEFT', 'RIGHT'] -%}
SELECT '{{ algorithm }}', '{{ kind }}', 'like', arraySort(groupArray((l.s, r.v))) FROM t_or_like_join_l AS l {{ kind }} JOIN t_or_like_join_r AS r ON {{ on }} AND ({{ c }} LIKE '%a%' OR {{ c }} LIKE '%b%' OR {{ c }} LIKE '%x%' OR {{ c }} LIKE '%y%') SETTINGS join_algorithm = '{{ algorithm }}';
{% endif -%}
{% endfor -%}
{% endfor %}
DROP DICTIONARY IF EXISTS d_or_like_join;
CREATE DICTIONARY d_or_like_join (n UInt64, v String) PRIMARY KEY n SOURCE(CLICKHOUSE(TABLE 't_or_like_join_r')) LAYOUT(FLAT()) LIFETIME(0);
{% for kind in ['INNER', 'LEFT'] -%}
SELECT 'direct', '{{ kind }}', 'indexHint', arraySort(groupArray((l.s, r.v))) FROM t_or_like_join_l AS l {{ kind }} JOIN d_or_like_join AS r ON l.n = r.n AND indexHint(r.v = 'x') SETTINGS join_algorithm = 'direct';
{% endfor %}
DROP DICTIONARY d_or_like_join;
DROP TABLE t_or_like_join_l;
DROP TABLE t_or_like_join_r;

-- The primary key range layers of a read must together return exactly the rows of the same read without
-- layers, for every key type the layer split accepts: FINAL, a split ordinary read, a join sharded by
-- primary key ranges and a distributed FINAL. Each row of the result is one key type, and every column
-- compares the layered read with the read without layers.

SET enable_parallel_replicas = 0;

{% set types = [
    ('int128', 'Int128', 'toInt128(number) - 500'),
    ('date', 'Date', "toDate('2020-01-01') + number"),
    ('date32', 'Date32', "toDate32('1950-01-01') + number"),
    ('datetime', "DateTime('UTC')", "toDateTime('2020-01-01 00:00:00', 'UTC') + number"),
    ('datetime64', "DateTime64(3, 'UTC')", "addMilliseconds(toDateTime64('2020-01-01 00:00:00', 3, 'UTC'), number)"),
    ('decimal', 'Decimal(9, 2)', 'toDecimal32(toString(toInt64(number) - 500), 2) / 4'),
    ('string', 'String', "leftPad(toString(number), 4, '0')"),
    ('fixedstring', 'FixedString(4)', "leftPad(toString(number), 4, '0')"),
    ('lowcardinality', 'LowCardinality(String)', "leftPad(toString(number), 4, '0')"),
    ('enum', "Enum8('a' = -2, 'b' = -1, 'c' = 0, 'd' = 1, 'e' = 2)", 'toInt8(number % 5) - 2'),
    ('uuid', 'UUID', "toUUID(concat('00000000-0000-0000-0000-', leftPad(toString(number), 12, '0')))"),
    ('ipv6', 'IPv6', 'toIPv6(IPv4NumToString(toUInt32(number)))'),
    ('bool', 'Bool', 'number % 2 = 0'),
    ('interval', 'IntervalSecond', 'toIntervalSecond(number)'),
    ('array', 'Array(UInt16)', '[toUInt16(intDiv(number, 10)), toUInt16(number % 10)]'),
    ('tuple', 'Tuple(String, UInt16)', "(leftPad(toString(intDiv(number, 10)), 3, '0'), toUInt16(number % 10))"),
] -%}

{% set layers_final = 'max_threads = 4, max_final_threads = 4, do_not_merge_across_partitions_select_final = 0, split_parts_ranges_into_intersecting_and_non_intersecting_final = 1' -%}
{% set distributed = 'distributed_plan_fallback_to_local_execution = 0, distributed_plan_default_reader_bucket_count = 4, distributed_plan_max_rows_to_broadcast = 0' -%}
{% set join = "join_algorithm = 'full_sorting_merge', max_threads = 4" -%}

CREATE TABLE results (name String, arm String, rows UInt64, hash UInt64) ENGINE = Memory;

{% for name, type, value in types -%}
CREATE TABLE t_{{ name }} (k {{ type }}, v UInt64, ver UInt64) ENGINE = ReplacingMergeTree(ver) ORDER BY k SETTINGS index_granularity = 2;
SYSTEM STOP MERGES t_{{ name }};
{% for batch in range(3) -%}
INSERT INTO t_{{ name }} SELECT {{ value }}, {{ batch }} * 10000 + number, {{ batch }} * 1000000 + number FROM numbers({{ batch * 200 }}, 600) SETTINGS optimize_on_insert = 0;
{% endfor -%}

INSERT INTO results SELECT '{{ name }}', 'final_layers', count(), sum(cityHash64(v)) FROM t_{{ name }} FINAL
SETTINGS {{ layers_final }}, split_intersecting_parts_ranges_into_layers_final = 1;
INSERT INTO results SELECT '{{ name }}', 'final', count(), sum(cityHash64(v)) FROM t_{{ name }} FINAL
SETTINGS {{ layers_final }}, split_intersecting_parts_ranges_into_layers_final = 0;

INSERT INTO results SELECT '{{ name }}', 'read_layers', count(), sum(cityHash64(v)) FROM t_{{ name }}
SETTINGS max_threads = 4, merge_tree_read_split_ranges_into_intersecting_and_non_intersecting_injection_probability = 1;
INSERT INTO results SELECT '{{ name }}', 'read', count(), sum(cityHash64(v)) FROM t_{{ name }}
SETTINGS max_threads = 4, merge_tree_read_split_ranges_into_intersecting_and_non_intersecting_injection_probability = 0;

INSERT INTO results SELECT '{{ name }}', 'join_layers', count(), sum(cityHash64(a.v, b.v)) FROM t_{{ name }} AS a JOIN t_{{ name }} AS b ON a.k = b.k
SETTINGS {{ join }}, query_plan_join_shard_by_pk_ranges = 1;
INSERT INTO results SELECT '{{ name }}', 'join', count(), sum(cityHash64(a.v, b.v)) FROM t_{{ name }} AS a JOIN t_{{ name }} AS b ON a.k = b.k
SETTINGS {{ join }}, query_plan_join_shard_by_pk_ranges = 0;

INSERT INTO results SELECT '{{ name }}', 'distributed_layers', count(), sum(cityHash64(v)) FROM t_{{ name }} FINAL
SETTINGS make_distributed_plan = 1, {{ distributed }};
INSERT INTO results SELECT '{{ name }}', 'distributed', count(), sum(cityHash64(v)) FROM t_{{ name }} FINAL
SETTINGS make_distributed_plan = 0;

INSERT INTO results SELECT '{{ name }}', 'explain', countIf(explain ILIKE '%FilterSortedStreamByRange%') > 0, 0
FROM (EXPLAIN PIPELINE SELECT count(), sum(cityHash64(v)) FROM t_{{ name }} FINAL
      SETTINGS {{ layers_final }}, split_intersecting_parts_ranges_into_layers_final = 1);

{% endfor -%}

-- A join sharded by the borders of two tables with different keys: some borders exist only in the other table's index.
CREATE TABLE t_other (k LowCardinality(String), v UInt64) ENGINE = MergeTree ORDER BY k SETTINGS index_granularity = 2;
SYSTEM STOP MERGES t_other;
INSERT INTO t_other SELECT leftPad(toString(number * 3), 4, '0'), number FROM numbers(100, 300);
INSERT INTO t_other SELECT leftPad(toString(number * 3), 4, '0'), number + 10000 FROM numbers(200, 300);
INSERT INTO results SELECT 'two_tables', 'join_layers', count(), sum(cityHash64(a.v, b.v)) FROM t_lowcardinality AS a JOIN t_other AS b ON a.k = b.k
SETTINGS {{ join }}, query_plan_join_shard_by_pk_ranges = 1;
INSERT INTO results SELECT 'two_tables', 'join', count(), sum(cityHash64(a.v, b.v)) FROM t_lowcardinality AS a JOIN t_other AS b ON a.k = b.k
SETTINGS {{ join }}, query_plan_join_shard_by_pk_ranges = 0;

SELECT
    name,
    anyIf((rows, hash), arm = 'final_layers') = anyIf((rows, hash), arm = 'final') AS final,
    anyIf((rows, hash), arm = 'read_layers') = anyIf((rows, hash), arm = 'read') AS read,
    anyIf((rows, hash), arm = 'join_layers') = anyIf((rows, hash), arm = 'join') AS join,
    anyIf((rows, hash), arm = 'distributed_layers') = anyIf((rows, hash), arm = 'distributed') AS distributed,
    anyIf(rows, arm = 'explain') AS has_layer_filter
FROM results
WHERE name != 'two_tables'
GROUP BY name
ORDER BY name;

SELECT name, anyIf((rows, hash), arm = 'join_layers') = anyIf((rows, hash), arm = 'join') AS join
FROM results
WHERE name = 'two_tables'
GROUP BY name;

{% for name, type, value in types -%}
DROP TABLE t_{{ name }};
{% endfor -%}
DROP TABLE t_other;
DROP TABLE results;

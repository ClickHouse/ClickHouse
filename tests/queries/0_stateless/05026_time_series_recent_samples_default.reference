-- a TimeSeries table gets the recent samples table by default
1
-- the default TTL of 4 days is pinned into the table definition at CREATE time
1
-- the recent samples inner table gets the default 5-hour partitioning, the pinned TTL and ttl_only_drop_parts
MergeTree PARTITION BY toStartOfInterval(toDateTime(timestamp), toIntervalHour(5)) ORDER BY (id, timestamp) TTL toDateTime(timestamp) + toIntervalSecond(345600) SETTINGS index_granularity = 8192, ttl_only_drop_parts = 1
-- inserted samples are copied to the recent samples table and short-range queries prefer it
1	1
1
42
-- an explicit recent_samples_ttl_seconds = 0 disables the recent samples table
0

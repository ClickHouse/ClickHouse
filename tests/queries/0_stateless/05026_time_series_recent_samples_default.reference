-- the recent samples inner table gets the default 5-hour partitioning without a wall-clock TTL
MergeTree PARTITION BY toStartOfInterval(toDateTime(timestamp), toIntervalHour(5)) ORDER BY (id, timestamp) SETTINGS index_granularity = 8192
-- inserted samples are copied to the recent samples table and short-range queries prefer it

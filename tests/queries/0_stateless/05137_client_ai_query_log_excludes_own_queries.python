# `read_query_log` hands the model the query history of the user, and the queries the agent ran
# itself must not be in it: the model would read its own earlier schema probes and documentation
# lookups as what the user wanted. The `log_comment` marker cannot carry that on its own - it is a
# setting, so a session that accepts no setting change leaves every query of the agent unmarked,
# and this tool deliberately reaches back into earlier sessions. The queries the agent runs
# internally therefore also run under a query id starting with `clickhouse-ai-agent-`, which no
# session can take away.
#
# Two independent sessions, each checking its own half:
#  - one whose settings profile holds `log_comment` `const`, so the agent works there without that
#    marker, asserting that its internal queries reach the query log without the `log_comment`
#    marker and with the query-id one - the state an earlier session used to leave behind
#    indistinguishable from the history of the user;
#  - one with no such profile, where the tool is offered, asserting that it returns the query of
#    the user and none of the agent's own.
#
# The query log of `clickhouse-local` does not outlive the process (the `system` database keeps no
# metadata under `--path`), so each session checks what it produced itself.
import json
import os
import pty
import re
import select
import shlex
import shutil
import threading
import time
from http.server import BaseHTTPRequestHandler, HTTPServer

TIMEOUT_SECONDS = 120

# The wait for a statement that had to be typed again. The first attempt gets the full timeout,
# because the client may be starting up or the server may be slow under a sanitizer; by the time a
# retry is needed the client has already answered once, so a much shorter wait is enough - and it
# keeps a lost signal from spending the whole budget of the test on one statement.
STATEMENT_RETRY_TIMEOUT_SECONDS = 30

# `clickhouse-test` prints this file when the test fails, and it names it after the test case -
# the `.sh` wrapper - not after this script.
DEBUG_LOG = os.path.join(
    os.environ["CLICKHOUSE_TMP"],
    os.path.basename(os.path.abspath(__file__)).removesuffix(".python") + ".sh.debuglog",
)

# Set when the pseudo-terminal reaches end of file: the client is gone. Every later read then
# returns at once and every write is silently discarded, so without noticing it the test runs to
# the end and reports every expectation as unmet, saying nothing about the client having died.
client_gone = False

FINAL_ANSWER = "MOCK-DONE"

# The query the user types. It must reach the log carrying neither marker, and come back from
# `read_query_log`: what is being tested is that the agent's own queries are filtered out, not
# that everything is.
USER_QUERY_MARKER = "user-typed-4f2a9c"
USER_QUERY = f"SELECT '{USER_QUERY_MARKER}' AS marker"

# `system.documentation` is only ever read by the agent (the `consult_documentation` tool and the
# `help` command), so it identifies the agent's internal traffic in the log.
AGENT_QUERY_PATTERN = "%system.documentation%"

# What the mock provider asks for. The first turn exercises the tools that run internally; a
# second turn, if the session has one, reads the log back - by then the queries of the first turn
# have been flushed into it, which is what makes the exclusion worth asserting.
INTERNAL_TOOL_CALLS = [
    ("list_tables", {"database": "default"}),
    ("consult_documentation", {"name": "MergeTree"}),
]
READ_QUERY_LOG_CALLS = [
    ("read_query_log", {"limit": 100}),
]


def internal_tools_only(_user_turns):
    """The plan of the first session: the tools that run internally, whatever turn it is. A line
    that reaches the model by accident must not be able to make it ask for `read_query_log`, which
    that session does not offer at all."""
    return INTERNAL_TOOL_CALLS


# Set once the queries of the first turn have been flushed into the query log. The plan below is
# keyed on it rather than on the number of turns in the conversation, so that the log is never read
# before there is something in it to exclude - counting turns would make a line that reached the
# model by accident bring the read forward.
log_is_flushed = {}


def then_read_the_log(_user_turns):
    """The plan of the second session, cumulative: the conversation of the agent persists across
    `?` invocations, so the provider sees the calls of the earlier turns in the history of the
    later ones. The log is read only after the flush."""
    if log_is_flushed.get("value"):
        return INTERNAL_TOOL_CALLS + READ_QUERY_LOG_CALLS
    return INTERNAL_TOOL_CALLS

# The four answers the probe query below returns, in order. Printed as its own line each, so a
# failure names which of them went wrong.
PROBE_ANSWERS = [
    "agent_internal_queries_are_logged",
    "agent_internal_queries_carry_the_log_comment_marker",
    "agent_internal_queries_carry_the_query_id_marker",
    "user_query_carries_neither_marker",
]

# The sentinel is split so that the query the client echoes back does not match the answer line:
# the echo contains the text of the query, quotes and `||` included, and the answer does not.
PROBE_SENTINEL = "PROBE-9b71c4"

# The same trick for the wait below, which asks whether the query of the user has reached the log.
READY_SENTINEL = "READY-2c8fd1"
READY_QUERY = (
    "SELECT 'READY' || '-2c8fd1: ' || toString(count()) FROM system.user_query_log "
    "WHERE type != 'QueryStart' AND query LIKE '%{user}%' FORMAT TSVRaw"
).format(user=USER_QUERY_MARKER)

# How many times the flush is repeated while waiting for that row. The flush is synchronous for
# what is already queued, so one is normally enough; the retries are what makes the wait a wait.
READY_ATTEMPTS = 10

# Stands in a turn's statement list for "wait until the query log can be read", rather than being
# a statement to type.
WAIT_FOR_THE_LOG = object()
PROBE_QUERY = (
    "WITH query LIKE '{agent}' AS is_agent_internal, "
    "query LIKE '%{user}%' AS is_user_typed, "
    "log_comment = 'clickhouse-ai-agent' AS has_log_comment_marker, "
    "startsWith(query_id, 'clickhouse-ai-agent-') AS has_query_id_marker "
    "SELECT 'PROBE' || '-9b71c4:'"
    " || ' ' || if(countIf(is_agent_internal) > 0, 'yes', 'no')"
    " || ' ' || if(countIf(is_agent_internal AND has_log_comment_marker) > 0, 'yes', 'no')"
    " || ' ' || if(countIf(is_agent_internal AND NOT has_query_id_marker) = 0, 'yes', 'no')"
    " || ' ' || if(countIf(is_user_typed AND (has_log_comment_marker OR has_query_id_marker)) = 0, 'yes', 'no')"
    " FROM system.user_query_log WHERE type != 'QueryStart' FORMAT TSVRaw"
).format(agent=AGENT_QUERY_PATTERN, user=USER_QUERY_MARKER)

# The last request the mock provider received: it carries the results of every tool call and the
# tools the agent offered for the call.
last_request = {}


def make_handler(plan):
    class Handler(BaseHTTPRequestHandler):
        """A mock OpenAI-compatible provider. It answers with one tool call per case, in order,
        and finishes each turn with a plain text message."""

        def do_POST(self):
            length = int(self.headers.get("Content-Length", 0))
            request = json.loads(self.rfile.read(length))
            last_request["value"] = request

            # The number of tool calls already made is the number of tool results in the history,
            # and the number of turns is the number of questions in it.
            done = sum(1 for m in request["messages"] if m.get("role") == "tool")
            calls = plan(sum(1 for m in request["messages"] if m.get("role") == "user"))
            if done < len(calls):
                name, arguments = calls[done]
                message = {
                    "role": "assistant",
                    "content": None,
                    "tool_calls": [
                        {
                            "id": f"call_{name}",
                            "type": "function",
                            "function": {
                                "name": name,
                                "arguments": json.dumps(arguments),
                            },
                        }
                    ],
                }
                finish_reason = "tool_calls"
            else:
                message = {"role": "assistant", "content": FINAL_ANSWER}
                finish_reason = "stop"

            body = json.dumps(
                {
                    "id": "chatcmpl-1",
                    "object": "chat.completion",
                    "created": 1,
                    "model": "gpt-4o",
                    "choices": [
                        {"index": 0, "message": message, "finish_reason": finish_reason}
                    ],
                    "usage": {
                        "prompt_tokens": 1,
                        "completion_tokens": 1,
                        "total_tokens": 2,
                    },
                }
            ).encode()

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *args):
            pass

    return Handler


def make_config(port, session, const_log_comment):
    """A client configuration that points the AI agent at the mock provider and turns on the query
    log, which `clickhouse-local` writes only when it is configured. The credentials come from the
    configuration and not from the environment, so the agent does not ask for the confirmation of
    using an API key found there."""
    base = os.path.join(
        os.environ["CLICKHOUSE_TMP"],
        os.path.basename(os.path.abspath(__file__)).removesuffix(".python")
        + f".{session}",
    )

    # `const` on `log_comment` alone leaves the session otherwise writable, which is the state the
    # agent cannot mark its queries in and the `readonly` setting does not show.
    constraints = (
        "<constraints><log_comment><const/></log_comment></constraints>"
        if const_log_comment
        else ""
    )
    with open(base + ".users.xml", "w") as f:
        f.write(
            "<clickhouse>"
            f"<profiles><default>{constraints}</default></profiles>"
            "<users><default>"
            "<password></password><networks><ip>::/0</ip></networks>"
            "<profile>default</profile><quota>default</quota>"
            "<access_management>1</access_management>"
            "</default></users>"
            "<quotas><default></default></quotas>"
            "</clickhouse>"
        )

    path = base + ".config.xml"
    with open(path, "w") as f:
        f.write(
            "<clickhouse>"
            f"<users_config>{os.path.basename(base)}.users.xml</users_config>"
            "<query_log>"
            "<database>system</database><table>query_log</table>"
            "<flush_interval_milliseconds>7500</flush_interval_milliseconds>"
            "</query_log>"
            "<ai>"
            "<provider>openai</provider>"
            "<api_key>mock-key</api_key>"
            f"<base_url>http://127.0.0.1:{port}/v1</base_url>"
            "<model>gpt-4o</model>"
            "<max_steps>8</max_steps>"
            "</ai></clickhouse>"
        )
    return path


def drain(master, debug_log_fd, idle):
    global client_gone
    while True:
        r, _, _ = select.select([master], [], [], idle)
        if not r:
            break
        try:
            chunk = os.read(master, 65536)
        except OSError:
            client_gone = True
            break
        if not chunk:
            client_gone = True
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()


def read_until(master, debug_log_fd, predicate, timeout):
    global client_gone
    output = ""
    deadline = time.time() + timeout
    while time.time() < deadline:
        r, _, _ = select.select([master], [], [], 0.3)
        if not r:
            continue
        try:
            chunk = os.read(master, 65536)
        except OSError:
            client_gone = True
            break
        if not chunk:
            client_gone = True
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()
        output += chunk.decode(errors="replace")
        if predicate(output):
            return output
    return output


def run_statement(master, debug_log_fd, statement):
    """Type a statement, wait for it to run, and return the output it produced.

    A `?` turn leaves the client in AI chat mode, where the prompt is the magenta `:?` and a line
    is sent to the model as another question instead of being run. Backspace on the empty line
    switches back, but waiting for the SQL prompt to reappear is not a way to know that it
    happened: when the client draws the AI prompt it prints `:) ` and immediately overwrites it,
    so such a wait matches that stale prompt and returns before the backspace has been processed -
    which is exactly how this test used to send its statements to the model.

    So a backspace goes in front of every statement - on an empty SQL line it does nothing, so it
    costs nothing when the client is already in SQL mode - and the answer of the mock provider is
    used as the signal that a line went to the model anyway: another backspace is sent and the
    statement typed again. The timing line the client prints when a query is done is the signal
    that it did not."""
    for attempt in range(3):
        os.write(master, b"\x7f")
        os.write(master, statement.encode() + b"\n")
        output = read_until(
            master,
            debug_log_fd,
            lambda o: "Elapsed:" in o or FINAL_ANSWER in o,
            TIMEOUT_SECONDS if attempt == 0 else STATEMENT_RETRY_TIMEOUT_SECONDS,
        )
        if "Elapsed:" in output:
            return output
        if client_gone:
            break
    return ""


def report_client_if_gone(child_pid, session):
    """Print how the client ended if it is gone. The expected output has no such line, so it shows
    up in the diff of the failure instead of leaving only unmet expectations behind."""
    if not client_gone:
        return
    try:
        _, status = os.waitpid(child_pid, os.WNOHANG)
    except ChildProcessError:
        print(f"client_gone: session {session}, already reaped")
        return
    if os.WIFSIGNALED(status):
        print(f"client_gone: session {session}, killed by signal {os.WTERMSIG(status)}")
    elif os.WIFEXITED(status):
        print(f"client_gone: session {session}, exited with code {os.WEXITSTATUS(status)}")
    else:
        print(f"client_gone: session {session}, yes")


def run_session(session, plan, turns, const_log_comment, probe, debug_log_fd):
    """One `clickhouse-local` session: type the query of the user, then run the given turns - each
    a question and the statements that follow it - and finally, if asked, flush the log and run the
    probe query over it. Returns the last request the mock provider saw and the probe answers."""
    global client_gone
    client_gone = False
    last_request.clear()
    log_is_flushed.clear()

    server = HTTPServer(("127.0.0.1", 0), make_handler(plan))
    threading.Thread(target=server.serve_forever, daemon=True).start()

    # A fresh storage directory for every run. `clickhouse-local` keeps no metadata for its
    # `system` database, so a `system.query_log` left on disk by an earlier run of this test cannot
    # be attached again and its creation fails instead - and then everything the two sessions
    # assert about the query log is asserted about a table that is not there. The flaky check runs
    # a test many times in one `CLICKHOUSE_TMP`, which is where this showed up.
    db_path = os.path.join(os.environ["CLICKHOUSE_TMP"], f"05137_local_db_{session}")
    shutil.rmtree(db_path, ignore_errors=True)

    base = shlex.split(os.environ["CLICKHOUSE_LOCAL"])
    argv = base + [
        "--config-file",
        make_config(server.server_port, session, const_log_comment),
        "--history_file=/dev/null",
        # The suggestion query of the client reads `system.tables` and `system.settings` among
        # others, unmarked, because it is the user's client asking rather than the agent. The log
        # is right to keep it, and it has no business in what is asserted here.
        "--disable_suggestion",
        "--path",
        db_path,
    ]

    child_pid, master = pty.fork()
    if child_pid == 0:
        os.environ["TERM"] = "xterm"
        # An API key in the environment would take precedence over the configured mock provider.
        os.environ.pop("OPENAI_API_KEY", None)
        os.environ.pop("ANTHROPIC_API_KEY", None)
        os.execv(base[0], argv)
        return {}, []

    try:
        read_until(master, debug_log_fd, lambda o: ":)" in o, TIMEOUT_SECONDS)

        # Every statement waits for the timing line the interactive client prints when a query is
        # done. Waiting for the prompt instead would not do: `replxx` repaints it while the line is
        # being typed, so it is already there before the statement has run, and `replxx` submits
        # everything that is buffered when it starts reading as a single statement - the question
        # that follows would be merged into the setup and the `?` would never start the agent.
        run_statement(master, debug_log_fd, USER_QUERY)

        for question, statements in turns:
            os.write(master, question.encode() + b"\n")
            read_until(master, debug_log_fd, lambda o: FINAL_ANSWER in o, TIMEOUT_SECONDS)
            for statement in statements:
                if statement is WAIT_FOR_THE_LOG:
                    if not wait_for_the_user_query_in_the_log(master, debug_log_fd):
                        print(f"the query of the user never reached the log in session {session}")
                    log_is_flushed["value"] = True
                else:
                    run_statement(master, debug_log_fd, statement)
        request = last_request.get("value", {})
        report_client_if_gone(child_pid, session)

        answers = []
        if probe:
            # The flush is explicit, so what the probe reads does not depend on the flush interval.
            run_statement(master, debug_log_fd, "SYSTEM FLUSH LOGS")
            log_is_flushed["value"] = True
            output = run_statement(master, debug_log_fd, PROBE_QUERY)
            found = re.search(PROBE_SENTINEL + r":((?: \w+)+)", output)
            answers = found.group(1).split() if found else []

        return request, answers
    finally:
        os.write(master, b"exit\n")
        drain(master, debug_log_fd, 1.0)
        os.close(master)
        server.shutdown()


def wait_for_the_user_query_in_the_log(master, debug_log_fd):
    """Flush the query log until the query the user typed is in it, and say whether it got there.

    `read_query_log` is asserted to return that query, and the assertion is only about the filter
    of the tool if the row is there to be filtered. Flushing once is not enough to know that it is:
    a flush is synchronous for the entries that are already queued, and this one competes with the
    agent's own queries from the turn that just ended, so the row can still be missing when the
    next turn reads the log - which is how this test failed once in `amd_tsan` with the read
    returning no rows at all."""
    for _ in range(READY_ATTEMPTS):
        run_statement(master, debug_log_fd, "SYSTEM FLUSH LOGS")
        output = run_statement(master, debug_log_fd, READY_QUERY)
        found = re.search(READY_SENTINEL + r": (\d+)", output)
        if found and int(found.group(1)) > 0:
            return True
    return False


def offered_tools(request):
    return {tool.get("function", {}).get("name") for tool in request.get("tools", [])}


def tool_results(request):
    results = {}
    for message in request.get("messages", []):
        if message.get("role") == "tool":
            results[message.get("tool_call_id")] = str(message.get("content"))
    return results


def main():
    debug_log_fd = open(DEBUG_LOG, "a")
    try:
        # A session that cannot attach the `log_comment` marker: the tool that reads the log is not
        # offered there, and what the agent leaves in the log is what a later session would read.
        first, answers = run_session(
            session=1,
            plan=internal_tools_only,
            turns=[("? look around", [])],
            const_log_comment=True,
            probe=True,
            debug_log_fd=debug_log_fd,
        )
        print(
            "session_1_read_query_log_offered: "
            f"{'yes' if 'read_query_log' in offered_tools(first) else 'no'}"
        )
        if len(answers) != len(PROBE_ANSWERS):
            print(f"probe_answers: {answers}")
        else:
            for name, answer in zip(PROBE_ANSWERS, answers):
                print(f"{name}: {answer}")

        # A session that can: the tool is offered, and it must return the query of the user and
        # none of the agent's own.
        # The flush between the turns is what makes the second one meaningful: the queries of the
        # first turn are in the log by then, so the tool has something to exclude.
        second, _ = run_session(
            session=2,
            plan=then_read_the_log,
            turns=[("? look around", [WAIT_FOR_THE_LOG]), ("? what did I run", [])],
            const_log_comment=False,
            probe=False,
            debug_log_fd=debug_log_fd,
        )
        print(
            "session_2_read_query_log_offered: "
            f"{'yes' if 'read_query_log' in offered_tools(second) else 'no'}"
        )

        # What the read returned is printed when it is not what was expected: the tool answers an
        # error the same way it answers a result, so a bare `no` says nothing about whether the
        # query of the user was filtered out or the read never worked.
        history = tool_results(second).get("call_read_query_log", "")
        if USER_QUERY_MARKER in history:
            print("user_query_is_returned: yes")
        else:
            print(f"user_query_is_returned: no, the read returned {history[:2000]!r}")
        if "system.documentation" in history or "system.tables" in history:
            print(f"assistant_queries_are_returned: yes, in {history[:2000]}")
        else:
            print("assistant_queries_are_returned: no")
    finally:
        debug_log_fd.close()


if __name__ == "__main__":
    main()

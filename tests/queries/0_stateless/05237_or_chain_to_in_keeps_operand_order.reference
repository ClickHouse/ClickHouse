SELECT (__table1.number IN (0, 2, 3)) OR (intDiv(1, __table1.number - 2) != 0) AS `or(equals(number, 0), notEquals(intDiv(1, minus(number, 2)), 0), equals(number, 2), equals(number, 3))`
FROM numbers(4) AS __table1

SELECT (__table1.number IN (0, 2, 3)) OR (intDiv(1, __table1.number) != 0) OR (toString(__table1.number) = \'x\') OR (toString(__table1.number) = \'y\') AS `or(equals(number, 0), notEquals(intDiv(1, number), 0), equals(toString(number), \'x\'), equals(toString(number), \'y\'), equals(number, 2), equals(number, 3))`
FROM numbers(4) AS __table1

-- initial definition
CREATE TABLE default.t_modify_index_projection\n(\n    `region` String,\n    `v` UInt64,\n    PROJECTION p INDEX region TYPE basic WITH SETTINGS (index_granularity = 1024)\n)\nENGINE = MergeTree\nORDER BY v\nSETTINGS index_granularity = 8192, index_granularity_bytes = 10485760
-- modify projection settings
-- new definition reflects the new setting
CREATE TABLE default.t_modify_index_projection\n(\n    `region` String,\n    `v` UInt64,\n    PROJECTION p INDEX region TYPE basic WITH SETTINGS (index_granularity = 128)\n)\nENGINE = MergeTree\nORDER BY v\nSETTINGS index_granularity = 8192, index_granularity_bytes = 10485760
-- the old part keeps the old granularity, a new part gets the new one
p	10000	11
p	10000	79
-- a merge rebuilds the projection with the new granularity
p	20000	157
-- errors

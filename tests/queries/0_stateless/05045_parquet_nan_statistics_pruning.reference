-- statistics: min and max exclude the NaN
(3,NULL,NULL,'5.000000','5.000000')
-- a negated range predicate must still see the NaN row
not_equals on=1 off=1
not_equals_negated on=1 off=1
not_equals_float32 on=1 off=1
not_equals_nullable on=1 off=1
not_equals_low_cardinality on=1 off=1
-- and so must a negated set predicate
not_in_one on=1 off=1
not_in_two on=1 off=1
not_in_three on=1 off=1
-- a set holding a NaN must match the NaN row the bounds hide
in_nan on=1 off=1
in_finite_and_nan on=1 off=1
in_nan_float32 on=1 off=1
in_nan_and_null on=1 off=1
in_nan_and_null_nullable on=1 off=1
in_null_and_nan_nullable on=1 off=1
-- a set ending in NULL still has to find the NaN
in_nan_null_transform on=2 off=2
in_null_nan_transform on=2 off=2
-- page statistics prune the same way, with row group pushdown disabled
page_not_equals on=1 off=1
page_not_in on=1 off=1
page_in_nan on=1 off=1
-- already correct before, must stay correct
equals on=2 off=2
in_finite on=2 off=2
in_nan_and_present_finite on=3 off=3
not_in_finite_and_nan on=2 off=2
equals_nan on=0 off=0
is_nan on=1 off=1
self_inequality on=1 off=1
in_finite_and_null on=2 off=2
is_null on=1 off=1
-- pruning is preserved: nothing below may read a row

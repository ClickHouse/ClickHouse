-- No ORDER BY: the functions must see all rows of each query in a single block.
-- { echoOn }

SELECT arrayMinIndex(a), arrayMaxIndex(a)
FROM values(
    'a Array(Int32)',
    ([5, 3, 3, 7]),
    ([]),
    ([42]),
    ([2, 8, 1])
);
2	4
0	0
1	1
3	2
SELECT arrayMinIndex(a), arrayMaxIndex(a)
FROM values(
    'a Array(Int128)',
    ([5, 3, 3, 7]),
    ([]),
    ([42]),
    ([2, 8, 1]),
    ([-9, 4, -9, 4])
);
2	4
0	0
1	1
3	2
1	2
SELECT arrayMinIndex(a), arrayMaxIndex(a)
FROM values(
    'a Array(Decimal256(2))',
    ([5, 3, 3, 7]),
    ([]),
    ([42]),
    ([2, 8, 1]),
    ([-9, 4, -9, 4])
);
2	4
0	0
1	1
3	2
1	2

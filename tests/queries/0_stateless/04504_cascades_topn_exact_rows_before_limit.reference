-- 1. default: two-stage top-N with a per-shard cap
Expression (Project names)
  Limit (preliminary LIMIT)
    Limit (TopN merge Sorting for ORDER BY)
      GatherExchange
        Sorting
          Expression ((Before ORDER BY + (Projection + Change column names to column identifiers)))
            ReadFromMergeTree (ParallelRead default.t_topn_exact)
-- 2. exact_rows_before_limit: one full sort instead
Expression (Project names)
  Limit (preliminary LIMIT)
    Sorting
      Expression ((Before ORDER BY + (Projection + Change column names to column identifiers)))
        ReadFromMergeTree (default.t_topn_exact)
-- 3. same results in both modes

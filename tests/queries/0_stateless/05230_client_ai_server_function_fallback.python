# The assistant of the client has three ways to reach a model, tried in that order: a provider
# configured in the client configuration, one inferred from the environment, and - when there is
# no client-side provider at all - the `aiGenerate` function of the server it is connected to.
# The third one is the only one the client cannot decide on its own: it asks the server whether
# the function exists, whether default credentials are configured for it
# (`ai_function_text_default_credentials`) and whether it is enabled
# (`allow_experimental_ai_functions`), and the assistant exists only if all three hold.
#
# This walks that boundary, one session per case and no client-side provider anywhere: the
# assistant is unavailable while either setting is missing, and answers through `aiGenerate` once
# both are there. The credentials point at a mock provider on the loopback interface, so nothing
# leaves the machine.
import json
import os
import pty
import select
import shlex
import signal
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, HTTPServer

TIMEOUT_SECONDS = 120

# How long a client may take to end after its terminal was closed, before it is killed.
TEARDOWN_SECONDS = 30

# `clickhouse-test` prints this file when the test fails, and it names it after the test case -
# the `.sh` wrapper - not after this script. Writing anywhere else means the trace of a failure in
# CI is collected and then never shown, which is the only record of what the client did.
DEBUG_LOG = os.path.join(
    os.environ["CLICKHOUSE_TMP"],
    os.path.basename(os.path.abspath(__file__)).removesuffix(".python") + ".sh.debuglog",
)

# Set when the pseudo-terminal reaches end of file: the client is gone. Every later read then
# returns at once and every write is silently discarded, so without noticing it the test runs to
# the end and reports every expectation as unmet, saying nothing about the client having died.
client_gone = False

FINAL_ANSWER = "MOCK-DONE"

# What the client prints when it has no way to reach a model at all.
UNAVAILABLE_LINE = "The AI agent is not available"

COLLECTION = "ai_fallback_nc"


class Handler(BaseHTTPRequestHandler):
    """A mock OpenAI-compatible provider, reached by `aiGenerate` on the server side. The text
    protocol of the server-function transport carries the whole conversation in one prompt, so a
    single answer without a `<tool_call>` block ends the turn."""

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        self.rfile.read(length)
        body = json.dumps(
            {
                "id": "chatcmpl-1",
                "object": "chat.completion",
                "created": 1,
                "model": "chat-model",
                "choices": [
                    {
                        "index": 0,
                        "message": {"role": "assistant", "content": FINAL_ANSWER},
                        "finish_reason": "stop",
                    }
                ],
                "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2},
            }
        ).encode()

        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


def drain(master, debug_log_fd, idle):
    global client_gone
    while True:
        r, _, _ = select.select([master], [], [], idle)
        if not r:
            break
        try:
            chunk = os.read(master, 65536)
        except OSError:
            client_gone = True
            break
        if not chunk:
            client_gone = True
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()


def read_until(master, debug_log_fd, predicate, timeout):
    global client_gone
    output = ""
    deadline = time.time() + timeout
    while time.time() < deadline:
        r, _, _ = select.select([master], [], [], 0.3)
        if not r:
            continue
        try:
            chunk = os.read(master, 65536)
        except OSError:
            client_gone = True
            break
        if not chunk:
            client_gone = True
            break
        debug_log_fd.write(repr(chunk) + "\n")
        debug_log_fd.flush()
        output += chunk.decode(errors="replace")
        if predicate(output):
            return output
    return output


def report_client_if_gone(child_pid):
    """Print how the client ended if it is gone. The expected output has no such line, so it
    shows up in the diff of the failure instead of leaving only unmet expectations behind."""
    if not client_gone:
        return
    try:
        _, status = os.waitpid(child_pid, os.WNOHANG)
    except ChildProcessError:
        print("client_gone: already reaped")
        return
    if os.WIFSIGNALED(status):
        print(f"client_gone: killed by signal {os.WTERMSIG(status)}")
    elif os.WIFEXITED(status):
        print(f"client_gone: exited with code {os.WEXITSTATUS(status)}")
    else:
        print("client_gone: yes")


def run_session(argv, line, expected):
    """Start one client, type one line, and report whether the expected answer came back.

    A session per case, rather than one session that changes the settings as it goes: the first
    `?` puts the line editor into AI-chat mode, where a line is a question for the assistant and
    not a statement for the server, so the settings of a later case could not be applied any more.
    """
    global client_gone
    client_gone = False

    child_pid, master = pty.fork()
    if child_pid == 0:
        os.environ["TERM"] = "xterm"
        # This test is about having no client-side provider at all: a key in the environment
        # would be inferred into one and the fallback would never be reached.
        os.environ.pop("OPENAI_API_KEY", None)
        os.environ.pop("ANTHROPIC_API_KEY", None)
        os.execv(argv[0], argv)
        return False

    debug_log_fd = open(DEBUG_LOG, "a")
    try:
        read_until(master, debug_log_fd, lambda o: ":)" in o, TIMEOUT_SECONDS)
        os.write(master, line.encode() + b"\n")
        output = read_until(master, debug_log_fd, lambda o: expected in o, TIMEOUT_SECONDS)
        found = expected in output
        report_client_if_gone(child_pid)
        return found
    finally:
        # The client is in AI-chat mode after the question, where `exit` is a question as well,
        # so it is ended by closing its terminal rather than by typing anything.
        os.close(master)
        debug_log_fd.close()
        wait_for_client(child_pid)


def wait_for_client(child_pid):
    """Wait for the client to end after its terminal was closed, and make sure it is gone."""
    deadline = time.time() + TEARDOWN_SECONDS
    while time.time() < deadline:
        try:
            reaped, _ = os.waitpid(child_pid, os.WNOHANG)
        except ChildProcessError:
            return
        if reaped == child_pid:
            return
        time.sleep(0.05)
    try:
        os.kill(child_pid, signal.SIGKILL)
        os.waitpid(child_pid, 0)
    except (ChildProcessError, ProcessLookupError):
        pass


def main():
    server = HTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()

    base = shlex.split(os.environ["CLICKHOUSE_LOCAL"])
    path = os.path.join(os.environ["CLICKHOUSE_TMP"], "05230_local_db")
    common = ["--history_file=/dev/null", "--path", path]

    # The credentials the server-side function resolves are a named collection, created once in
    # the same `--path` every session below opens.
    subprocess.run(
        base
        + common
        + [
            "--query",
            f"CREATE NAMED COLLECTION IF NOT EXISTS {COLLECTION} AS provider = 'openai', "
            f"endpoint = 'http://127.0.0.1:{server.server_port}/v1/chat/completions', "
            "model = 'chat-model', api_key = 'fake-key'",
        ],
        check=True,
    )

    credentials = [f"--ai_function_text_default_credentials={COLLECTION}"]
    enabled = ["--allow_experimental_ai_functions=1"]

    try:
        # The same question in every session, because what is being varied is the two settings.
        # `aiGenerate` exists as a function in all of them, and that alone must not make the
        # assistant available - it could not call it.
        #
        # There is no client-side provider anywhere here - no `ai` section in the configuration
        # and no API key in the environment - so an answer can only have come through the
        # server-side function: the whole path, not just the transport in isolation.
        cases = [
            ("no_settings", base + common, UNAVAILABLE_LINE, "UNAVAILABLE"),
            ("credentials_only", base + common + credentials, UNAVAILABLE_LINE, "UNAVAILABLE"),
            ("enabled_only", base + common + enabled, UNAVAILABLE_LINE, "UNAVAILABLE"),
            ("both_settings", base + common + credentials + enabled, FINAL_ANSWER, "ANSWERED"),
        ]
        for name, argv, expected, ok in cases:
            print(f"{name}: {ok if run_session(argv, '? say hello', expected) else 'UNEXPECTED'}")
    finally:
        server.shutdown()


if __name__ == "__main__":
    main()

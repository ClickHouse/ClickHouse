#!/usr/bin/expect -f

# Test for the client-side /dialect command (aliases /lang, /language) and
# the display of a non-default dialect in the prompt.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0
set history_file $CLICKHOUSE_TMP/$basename.history

log_user 0
set timeout 60
match_max 100000

expect_after {
    # Do not ignore eof from expect
    -i $any_spawn_id eof { exp_continue }
    # A default timeout action is to do nothing, change it to fail
    -i $any_spawn_id timeout { exit 1 }
}

spawn bash -c "source $basedir/../shell_config.sh; TERM=xterm \$CLICKHOUSE_LOCAL --hints 0 --history_file=$history_file --allow_experimental_kusto_dialect=1"
expect ":) "

send -- "/dialect\r"
expect -- "Current dialect: clickhouse"
expect -- ":) "

# The prompt shows a non-default dialect in parentheses.
send -- "/dialect kusto\r"
expect -- "(kusto) :) "

send -- "/dialect\r"
expect -- "Current dialect: kusto"
expect -- "(kusto) :) "

# The argument may be quoted, as in the equivalent SET query.
send -- "/dialect 'clickhouse'\r"
expect -- ":) "

send -- "/dialect 'kusto'\r"
expect -- "(kusto) :) "

# A dialect transition clears KQL let bindings, just like the equivalent SET.
send -- "let x = 42\r"
expect -- "(kusto) :) "
send -- "/dialect clickhouse\r"
expect -- ":) "
send -- "/dialect kusto\r"
expect -- "(kusto) :) "
send -- "print x\r"
expect -- "Unknown expression identifier `x`"
expect -- "(kusto) :) "

# The SQL SET escape follows the same Kusto binding cleanup rules.
send -- "let x = 42\r"
expect -- "(kusto) :) "
send -- "SET dialect = 'clickhouse'\r"
expect -- ":) "
send -- "SET dialect = 'kusto'\r"
expect -- "(kusto) :) "
send -- "print x\r"
expect -- "Unknown expression identifier `x`"
expect -- "(kusto) :) "

# The /language and /lang aliases work; the default dialect is not shown in the prompt.
send -- "/language clickhouse\r"
expect -- ":) "

send -- "SELECT 42\r"
expect -- "42"
expect -- ":) "

send -- "/lang kusto\r"
expect -- "(kusto) :) "

# An unknown dialect is rejected and the current dialect is kept.
send -- "/dialect unknown_dialect\r"
expect -- "Unexpected value of Dialect"
expect -- "(kusto) :) "

# The command works even when the current dialect cannot parse a SET query.
send -- "/dialect clickhouse\r"
expect -- ":) "
send -- "/dialect\r"
expect -- "Current dialect: clickhouse"
expect -- ":) "

# A successful plain SET is also retained in the client context, so the
# prompt, /dialect, and parsing of the next query use the server's dialect.
send -- "SET dialect = 'kusto'\r"
expect -- "(kusto) :) "
send -- "/dialect\r"
expect -- "Current dialect: kusto"
expect -- "(kusto) :) "
send -- "SET dialect = 'clickhouse'\r"
expect -- ":) "
send -- "/dialect\r"
expect -- "Current dialect: clickhouse"
expect -- ":) "

# A PromQL metric named `set` must not be mistaken for the SQL SET escape.
send -- "SET dialect = 'promql'\r"
expect -- "(promql) :) "
send -- "set{job=\"x\"}\r"
expect -- "TimeSeries table to use with promql dialect is not specified"
expect -- "(promql) :) "
send -- "SET dialect = 'clickhouse'\r"
expect -- ":) "

send -- "exit\r"
expect eof

# `clickhouse-local` also recognizes the command in noninteractive scripts and
# parses the following SQL chunk with the newly selected dialect.
set queries_file "$CLICKHOUSE_TMP/$basename.queries"
set fp [open $queries_file w]
puts $fp "/dialect kusto\nprint 0"
close $fp
if {[catch {exec bash -c "source $basedir/../shell_config.sh; \$CLICKHOUSE_LOCAL --allow_experimental_kusto_dialect=1 --queries-file=$queries_file"} output]} {
    puts stderr "clickhouse-local failed: $output"
    exit 1
}
if {![regexp {(^|\n)0(\r?\n|$)} $output]} {
    puts stderr "clickhouse-local did not return the expected result: $output"
    exit 1
}
file delete $queries_file

# A line that resembles a dialect command remains inline FORMAT data.
set insert_file "$CLICKHOUSE_TMP/$basename.insert"
set fp [open $insert_file w]
puts $fp "CREATE TABLE t (s String) ENGINE = Memory;\nINSERT INTO t FORMAT TSV\n/dialect\n\nSELECT s FROM t;"
close $fp
if {[catch {exec bash -c "source $basedir/../shell_config.sh; \$CLICKHOUSE_LOCAL --queries-file=$insert_file"} output]} {
    puts stderr "clickhouse-local failed to keep /dialect as INSERT data: $output"
    exit 1
}
if {![regexp {(^|\n)/dialect(\r?\n|$)} $output]} {
    puts stderr "clickhouse-local did not preserve /dialect INSERT data: $output"
    exit 1
}
file delete $insert_file

# A comment-only prefix does not hide the following dialect command.
set comment_file "$CLICKHOUSE_TMP/$basename.comment"
set fp [open $comment_file w]
puts $fp "-- a comment\n\n/dialect kusto\nprint 1"
close $fp
if {[catch {exec bash -c "source $basedir/../shell_config.sh; \$CLICKHOUSE_LOCAL --allow_experimental_kusto_dialect=1 --queries-file=$comment_file"} output]} {
    puts stderr "clickhouse-local failed after a comment-only prefix: $output"
    exit 1
}
if {![regexp {(^|\n)1(\r?\n|$)} $output]} {
    puts stderr "clickhouse-local did not handle /dialect after a comment: $output"
    exit 1
}
file delete $comment_file

# The command is still an escape hatch when a plain `SET dialect` earlier in the
# script already switched the parser to a foreign dialect.
set escape_file "$CLICKHOUSE_TMP/$basename.escape"
set fp [open $escape_file w]
puts $fp "SET dialect = 'kusto';\nprint 2\n/dialect clickhouse\nSELECT 3;"
close $fp
if {[catch {exec bash -c "source $basedir/../shell_config.sh; \$CLICKHOUSE_LOCAL --allow_experimental_kusto_dialect=1 --queries-file=$escape_file"} output]} {
    puts stderr "clickhouse-local failed to escape from a dialect set by SET: $output"
    exit 1
}
if {![regexp {(^|\n)2(\r?\n|$)} $output] || ![regexp {(^|\n)3(\r?\n|$)} $output]} {
    puts stderr "clickhouse-local did not escape from a dialect set by SET: $output"
    exit 1
}
file delete $escape_file

# A rejected command aborts the script, just like a rejected `SET dialect`.
set rejected_file "$CLICKHOUSE_TMP/$basename.rejected"
set fp [open $rejected_file w]
puts $fp "SELECT 4;\n/dialect unknown_dialect\nSELECT 5;"
close $fp
if {![catch {exec bash -c "source $basedir/../shell_config.sh; \$CLICKHOUSE_LOCAL --queries-file=$rejected_file"} output]} {
    puts stderr "clickhouse-local did not fail on a rejected dialect command: $output"
    exit 1
}
if {[regexp {(^|\n)5(\r?\n|$)} $output]} {
    puts stderr "clickhouse-local kept running after a rejected dialect command: $output"
    exit 1
}
file delete $rejected_file

# A newline-terminated noninteractive meta-command without a dialect command
# must retain the regular `clickhouse-local` processing path.
set clear_file "$CLICKHOUSE_TMP/$basename.clear"
set fp [open $clear_file w]
puts $fp "clear"
close $fp
if {[catch {exec bash -c "source $basedir/../shell_config.sh; \$CLICKHOUSE_LOCAL --queries-file=$clear_file"} output]} {
    puts stderr "clickhouse-local failed to process clear: $output"
    exit 1
}
file delete $clear_file

# A server-side setting constraint must reject the meta-command without
# changing the client-side parser or prompt.
spawn bash -c "source $basedir/../shell_config.sh; TERM=xterm \$CLICKHOUSE_LOCAL --hints 0 --history_file=$history_file --allow_experimental_kusto_dialect=1 --readonly=1"
expect ":) "

send -- "/dialect kusto\r"
expect ":) "
send -- "/dialect\r"
expect -- "Current dialect: clickhouse"
expect -- ":) "
send -- "SELECT 42\r"
expect -- "42"
expect -- ":) "
send -- "exit\r"
expect eof

# A custom prompt does not have to contain the {display_name} placeholder:
# the active dialect is appended to it anyway.
spawn bash -c "source $basedir/../shell_config.sh; TERM=xterm \$CLICKHOUSE_LOCAL --hints 0 --history_file=$history_file --prompt 'custom-prompt>' --allow_experimental_kusto_dialect=1"
expect "custom-prompt> :) "

send -- "/dialect kusto\r"
expect -- "custom-prompt> (kusto) :) "

send -- "/dialect clickhouse\r"
expect -- "custom-prompt> :) "

send -- "exit\r"
expect eof

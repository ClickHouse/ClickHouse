-- 4. LEFT join and GROUP BY the key of the right table: the rows with no match are one group on all nodes
Expression ((Project names + Projection))
  MergingAggregated
    GatherExchange
      Aggregating
        Expression ((Before GROUP BY + (Change column names to column identifiers + (Project names + Projection))))
          Aggregating
            Expression (Before GROUP BY)
              ShuffleExchange
                JoinLogical (Shuffle HashJoin (co-located by modulo(cityHash64(#0), 8)) )
                  Expression (Change column names to column identifiers)
                    ReadFromMergeTree (PartitionedRead default.t_coloc_chain_events)
                  Expression (Change column names to column identifiers)
                    ReadFromMergeTree (PartitionedRead default.t_coloc_chain_groups)

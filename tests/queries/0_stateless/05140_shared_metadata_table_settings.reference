-- settings the shared metadata is authoritative for
after_processing	keep	shared_metadata
loading_retries	42	shared_metadata
mode	unordered	shared_metadata
-- keeper_path names where the shared metadata lives, but is not part of it
keeper_path	1	definition
-- a setting the queue does not keep there is still attributed normally
parallel_inserts	default
polling_min_timeout_ms	default
-- every source this table reports
default
definition
shared_metadata
-- the shared metadata wins over a definition that states otherwise
1
loading_retries	42	shared_metadata
polling_min_timeout_ms	1234	definition
-- use_hive_partitioning reports the source of partitioning_mode, into which it is folded
smd_hive_by_flag	partitioning_mode	hive	shared_metadata
smd_hive_by_flag	use_hive_partitioning	1	shared_metadata
smd_hive_by_mode	partitioning_mode	hive	shared_metadata
smd_hive_by_mode	use_hive_partitioning	1	shared_metadata

[('__name__','metric'),('instance','a'),('job','1')]	[(900000,2)]
info(metric @ 300, {data=~".+"}) from 300 to 900 step 300
[('__name__','metric'),('data','new'),('instance','a'),('job','1')]	[(300000,1)]
info(sum by (instance, job) (metric @ 300)) from 300 to 900 step 300
[('data','new'),('instance','a'),('job','1')]	[(300000,1),(600000,1),(900000,1)]

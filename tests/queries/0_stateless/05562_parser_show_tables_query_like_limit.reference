-- accepted forms, printed back from the parsed AST
SHOW DATABASES ILIKE \'%sys%\' LIMIT 3
SHOW DATABASES NOT LIKE \'a\'
SHOW CLUSTERS NOT ILIKE \'%x%\' LIMIT 1 + 1
SHOW MERGES NOT ILIKE \'a\'
SHOW CHANGED SETTINGS ILIKE \'%max%\'
SHOW TABLES FROM db1 ILIKE \'%t%\' LIMIT 2
SHOW DICTIONARIES FROM db1 WHERE name != \'\' LIMIT 1

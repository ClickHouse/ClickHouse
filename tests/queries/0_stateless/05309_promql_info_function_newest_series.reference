-- the newest info series is used, with the lookback
[('__name__','metric'),('instance','a'),('job','1'),('version','new')]	[('1970-01-01 00:03:00.000',3),('1970-01-01 00:04:00.000',4)]
[('__name__','metric'),('instance','a'),('job','1'),('version','old')]	[('1970-01-01 00:01:00.000',0),('1970-01-01 00:02:00.000',2)]
[('__name__','metric'),('instance','a'),('job','1'),('version','old')]	[('1970-01-01 00:01:00.000',0),('1970-01-01 00:02:00.000',0),('1970-01-01 00:03:00.000',0),('1970-01-01 00:04:00.000',0)]
[('__name__','metric'),('instance','a'),('job','1'),('version','new')]	[('1970-01-01 00:03:00.000',2),('1970-01-01 00:04:00.000',3)]
[('__name__','metric'),('instance','a'),('job','1'),('version','old')]	[('1970-01-01 00:01:00.000',0),('1970-01-01 00:02:00.000',0)]
-- the first selector of an aggregation is in its expression
[('__name__','metric'),('instance','a'),('job','1'),('version','new')]	[('1970-01-01 00:03:00.000',3),('1970-01-01 00:04:00.000',4)]
[('__name__','metric'),('instance','a'),('job','1'),('version','old')]	[('1970-01-01 00:01:00.000',0),('1970-01-01 00:02:00.000',2)]
-- subqueries
[('__name__','metric'),('instance','a'),('job','1'),('version','new')]	[('1970-01-01 00:03:00.000',3),('1970-01-01 00:04:00.000',4)]
[('__name__','metric'),('instance','a'),('job','1'),('version','old')]	[('1970-01-01 00:01:00.000',0),('1970-01-01 00:02:00.000',2),('1970-01-01 00:03:00.000',2)]
[('instance','a'),('job','1'),('version','new')]	[('1970-01-01 00:03:00.000',3),('1970-01-01 00:04:00.000',4)]

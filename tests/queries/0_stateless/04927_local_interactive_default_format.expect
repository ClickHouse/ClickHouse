#!/usr/bin/expect -f

# Test that interactive clickhouse-local renders query results with the terminal default format
# (`PrettyCompact`), while an explicit `default_format` setting is still honored as the fallback
# format.
#
# The display default regressed to `TSV` when `clickhouse-local` started to seed the `default_format`
# setting on the global context for the sessions of the embedded protocol listeners
# (`SYSTEM START LISTEN`): the seed leaked into the client context, which the per-query format
# resolution consults for the fallback format.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0

log_user 0
set timeout 60
match_max 100000

expect_after {
    # Do not ignore eof from expect
    -i $any_spawn_id eof { exp_continue }
    # A default timeout action is to do nothing, change it to fail
    -i $any_spawn_id timeout { exit 1 }
}

spawn bash -c "source $basedir/../shell_config.sh ; \$CLICKHOUSE_LOCAL --disable_suggestion --enable-progress-table-toggle=0"
expect ":) "

# The terminal display default is PrettyCompact. The expected string contains box-drawing
# characters, so it cannot be matched in the echo of the typed query. The value must stay at three
# digits: with more, Pretty formats underline the digit groups when writing to a terminal, and the
# escape sequences inside the number would break the literal match.
send -- "SELECT 246 AS x\r"
expect "│ 246 │"
expect "1 row in set."
expect ":) "

# An explicit `default_format` setting is still honored as the fallback format. The expected string
# cannot be matched in the echo of the typed query: the echo has no JSON punctuation around the value.
send -- "SET default_format = 'JSONEachRow'\r"
expect ":) "
send -- "SELECT 246 AS x\r"
expect "{\"x\":246}"
expect "1 row in set."
expect ":) "

# An in-query `SETTINGS` clause is honored too and wins over the session-level setting. Build the
# marker at run time with `concat` so the expected token (`CSV_RESULT_555`) never appears in the
# query text itself, where the echo of the typed query would match it before the query even runs.
send -- "SELECT concat('CSV_RESULT_', toString(5 * 111)) SETTINGS default_format = 'CSV'\r"
expect "CSV_RESULT_555"
expect "1 row in set."
expect ":) "

send -- "exit\r"
expect eof

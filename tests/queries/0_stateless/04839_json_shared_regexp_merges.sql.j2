-- Tags: no-fasttest, no-random-settings, no-random-merge-tree-settings

SET enable_json_type = 1;

{% for name, vertical_rows, vertical_columns in [('horizontal', 1000000, 1000000), ('vertical', 1, 1)] -%}
DROP TABLE IF EXISTS merge_04839_{{ name }};

CREATE TABLE merge_04839_{{ name }}
(
    id UInt64,
    j JSON(max_dynamic_paths=1, SHARED REGEXP '^forced[.]')
)
ENGINE = MergeTree
ORDER BY id
SETTINGS
    min_rows_for_wide_part=0,
    min_bytes_for_wide_part=0,
    enable_vertical_merge_algorithm={{ 0 if name == 'horizontal' else 1 }},
    vertical_merge_algorithm_min_rows_to_activate={{ vertical_rows }},
    vertical_merge_algorithm_min_columns_to_activate={{ vertical_columns }},
    vertical_merge_algorithm_min_bytes_to_activate=0;

SYSTEM STOP MERGES merge_04839_{{ name }};

INSERT INTO merge_04839_{{ name }}
SELECT
    number,
    toJSONString(map('forced.k' || toString(number), number, 'hot', number))
FROM numbers(10)
SETTINGS max_threads=1;

INSERT INTO merge_04839_{{ name }}
SELECT
    number + 10,
    toJSONString(map('forced.k' || toString(number + 10), number, 'cold', number))
FROM numbers(6)
SETTINGS max_threads=1;

SELECT
    '{{ name }} before',
    countIf(has(JSONDynamicPaths(j), 'hot')),
    countIf(has(JSONDynamicPaths(j), 'cold')),
    countIf(arrayExists(path -> startsWith(path, 'forced.'), JSONDynamicPaths(j))),
    countIf(has(JSONSharedDataPaths(j), 'cold')),
    countIf(arrayExists(path -> startsWith(path, 'forced.'), JSONSharedDataPaths(j)))
FROM merge_04839_{{ name }};

SYSTEM START MERGES merge_04839_{{ name }};
OPTIMIZE TABLE merge_04839_{{ name }} FINAL;
SYSTEM FLUSH LOGS part_log;

SELECT
    '{{ name }} algorithm',
    merge_algorithm
FROM system.part_log
WHERE database=currentDatabase()
  AND table='merge_04839_{{ name }}'
  AND event_type='MergeParts'
ORDER BY event_time_microseconds DESC
LIMIT 1;

SELECT
    '{{ name }} after',
    countIf(has(JSONDynamicPaths(j), 'hot')),
    countIf(has(JSONDynamicPaths(j), 'cold')),
    countIf(arrayExists(path -> startsWith(path, 'forced.'), JSONDynamicPaths(j))),
    countIf(has(JSONSharedDataPaths(j), 'cold')),
    countIf(arrayExists(path -> startsWith(path, 'forced.'), JSONSharedDataPaths(j)))
FROM merge_04839_{{ name }};

DROP TABLE merge_04839_{{ name }};

-- The rule is added by ALTER after the parts were written without it.
DROP TABLE IF EXISTS merge_04839_{{ name }}_added;

CREATE TABLE merge_04839_{{ name }}_added
(
    id UInt64,
    j JSON(max_dynamic_paths=100)
)
ENGINE = MergeTree
ORDER BY id
SETTINGS
    min_rows_for_wide_part=0,
    min_bytes_for_wide_part=0,
    enable_vertical_merge_algorithm={{ 0 if name == 'horizontal' else 1 }},
    vertical_merge_algorithm_min_rows_to_activate={{ vertical_rows }},
    vertical_merge_algorithm_min_columns_to_activate={{ vertical_columns }},
    vertical_merge_algorithm_min_bytes_to_activate=0;

SYSTEM STOP MERGES merge_04839_{{ name }}_added;

INSERT INTO merge_04839_{{ name }}_added
SELECT
    number,
    toJSONString(map('forced.k' || toString(number % 3), number, 'hot', number))
FROM numbers(10)
SETTINGS max_threads=1;

INSERT INTO merge_04839_{{ name }}_added
SELECT
    number + 10,
    toJSONString(map('forced.k' || toString(number % 3), number, 'hot', number))
FROM numbers(6)
SETTINGS max_threads=1;

ALTER TABLE merge_04839_{{ name }}_added MODIFY COLUMN j JSON(max_dynamic_paths=100, SHARED REGEXP '^forced[.]');

SELECT '{{ name }} added mutations', count()
FROM system.mutations
WHERE database=currentDatabase() AND table='merge_04839_{{ name }}_added';

SELECT
    '{{ name }} added before',
    countIf(has(JSONDynamicPaths(j), 'hot')),
    countIf(arrayExists(path -> startsWith(path, 'forced.'), JSONDynamicPaths(j))),
    countIf(arrayExists(path -> startsWith(path, 'forced.'), JSONSharedDataPaths(j)))
FROM merge_04839_{{ name }}_added;

SYSTEM START MERGES merge_04839_{{ name }}_added;
OPTIMIZE TABLE merge_04839_{{ name }}_added FINAL;
SYSTEM FLUSH LOGS part_log;

SELECT
    '{{ name }} added algorithm',
    merge_algorithm
FROM system.part_log
WHERE database=currentDatabase()
  AND table='merge_04839_{{ name }}_added'
  AND event_type='MergeParts'
ORDER BY event_time_microseconds DESC
LIMIT 1;

SELECT
    '{{ name }} added after',
    countIf(has(JSONDynamicPaths(j), 'hot')),
    countIf(arrayExists(path -> startsWith(path, 'forced.'), JSONDynamicPaths(j))),
    countIf(arrayExists(path -> startsWith(path, 'forced.'), JSONSharedDataPaths(j)))
FROM merge_04839_{{ name }}_added;

SELECT '{{ name }} added part type', type
FROM system.parts_columns
WHERE database=currentDatabase() AND table='merge_04839_{{ name }}_added' AND column='j' AND active;

DROP TABLE merge_04839_{{ name }}_added;

{% endfor -%}

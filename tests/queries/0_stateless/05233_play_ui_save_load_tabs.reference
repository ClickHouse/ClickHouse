--- a section per tab: its title as a top-level heading, then its query in a fenced block
out.push('# ' + tab.title);
out.push(fence + '\n' + cell.query + '\n' + fence);
--- a notebook tab writes every cell, a Markdown cell as a block with the markdown info string
if (cell.type === 'text') {
out.push(text_fence + 'markdown\n' + cell.text + '\n' + text_fence);
--- the fence is one backtick longer than the longest run of backticks inside the query
return '`'.repeat(Math.max(3, longest + 1));
--- the parameter values follow the query, written as JSON so that they round-trip exactly
out.push('## Parameters');
out.push(params_fence + 'json\n' + json + '\n' + params_fence);
--- a cell of a result table escapes what would otherwise break the row apart
return text.replace(/\\/g, '\\\\').replace(/([`|])/g, '\\$1').replace(/\r?\n/g, '<br>');
--- loading reads back the title, the cells and the parameters - and nothing else

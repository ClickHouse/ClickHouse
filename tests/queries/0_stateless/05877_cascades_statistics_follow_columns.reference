-- UNION ALL has the rows and the distinct values of both inputs: 10001000 rows, 1001000 groups
Expression ((Project names + Projection)) (rows: <unknown>)
  Aggregating (rows: ~1001000.0)
    Union (rows: ~10001000.0)
      Expression ((Before GROUP BY + (Change column names to column identifiers + (Project names + (Projection + Change column names to column identifiers))))) (rows: ~1000.0)
        ReadFromMergeTree (default.t_stats_rows_small) (rows: ~1000.0)
      Expression ((Before GROUP BY + (Change column names to column identifiers + (Project names + (Projection + Change column names to column identifiers))))) (rows: ~10000000.0)
        ReadFromMergeTree (default.t_stats_rows_large) (rows: ~10000000.0)
-- UNION ALL: the same estimates with the inputs in the other order
Expression ((Project names + Projection)) (rows: <unknown>)
  Aggregating (rows: ~1001000.0)
    Union (rows: ~10001000.0)
      Expression ((Before GROUP BY + (Change column names to column identifiers + (Project names + (Projection + Change column names to column identifiers))))) (rows: ~10000000.0)
        ReadFromMergeTree (default.t_stats_rows_large) (rows: ~10000000.0)
      Expression ((Before GROUP BY + (Change column names to column identifiers + (Project names + (Projection + Change column names to column identifiers))))) (rows: ~1000.0)
        ReadFromMergeTree (default.t_stats_rows_small) (rows: ~1000.0)
-- an input of UNION ALL without a distinct count adds its rows to the distinct count: 10 + 1000 groups
Expression ((Project names + Projection)) (rows: <unknown>)
  Aggregating (rows: ~1010.0)
    Union (rows: ~2000.0)
      Expression ((Before GROUP BY + (Change column names to column identifiers + (Project names + (Projection + Change column names to column identifiers))))) (rows: ~1000.0)
        ReadFromMergeTree (default.t_stats_rows_small) (rows: ~1000.0)
      Expression ((Before GROUP BY + (Change column names to column identifiers + (Project names + (Projection + Change column names to column identifiers))))) (rows: ~1000.0)
        ReadFromMergeTree (default.t_stats_rows_no_counts) (rows: ~1000.0)
-- ROLLUP has a set of groups for each prefix of the keys: 1000 + 10 + 1 rows
Expression ((Project names + Projection)) (rows: <unknown>)
  Rollup (rows: ~1011.0)
    GatherExchange (rows: ~1000.0)
      Aggregating (rows: ~1000.0)
        Expression ((Before GROUP BY + Change column names to column identifiers)) (rows: ~1000.0)
          ReadFromMergeTree (ParallelRead default.t_stats_rows_small) (rows: ~1000.0)
-- CUBE has a set of groups for each subset of the keys: 1000 + 1000 + 10 + 1 rows
Expression ((Project names + Projection)) (rows: <unknown>)
  Cube (rows: ~2011.0)
    GatherExchange (rows: ~1000.0)
      Aggregating (rows: ~1000.0)
        Expression ((Before GROUP BY + Change column names to column identifiers)) (rows: ~1000.0)
          ReadFromMergeTree (ParallelRead default.t_stats_rows_small) (rows: ~1000.0)
-- GROUPING SETS: 10 + 1000 rows
Expression ((Project names + Projection)) (rows: <unknown>)
  Aggregating (rows: ~1010.0)
    Expression ((Before GROUP BY + Change column names to column identifiers)) (rows: ~1000.0)
      ReadFromMergeTree (default.t_stats_rows_small) (rows: ~1000.0)
-- a key of ROLLUP has one more value, in the rows of the sets without the key: 10 + 1 groups by k
Expression ((Project names + Projection)) (rows: <unknown>)
  Aggregating (rows: ~11.0)
    Expression ((Before GROUP BY + (Change column names to column identifiers + (Project names + Projection)))) (rows: ~1011.0)
      Rollup (rows: ~1011.0)
        GatherExchange (rows: ~1000.0)
          Aggregating (rows: ~1000.0)
            Expression ((Before GROUP BY + Change column names to column identifiers)) (rows: ~1000.0)
              ReadFromMergeTree (ParallelRead default.t_stats_rows_small) (rows: ~1000.0)

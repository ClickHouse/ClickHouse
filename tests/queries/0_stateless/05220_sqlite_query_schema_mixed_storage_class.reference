-- the first row makes the column Int64, a REAL value in a later row fails the read
x	Nullable(Int64)					
-- a TEXT value in an Int64 column fails as well
-- the first row makes the column Float64, a small INTEGER value converts exactly and is read
x	Nullable(Float64)					
1.5
2
3
-- an INTEGER value beyond 2^53 does not convert exactly to Float64 and fails the read
-- a TEXT value in a Float64 column fails the read
-- mixed values are read when the column is declared as String or cast to text in SQLite
1

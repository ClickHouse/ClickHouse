#!/usr/bin/env bash

# The server allows a single root workload, so tests that need one share whatever root exists and
# create `all` only when there is none. Only the creator drops it, hence such tests are no-parallel.
WORKLOAD_ROOT=
WORKLOAD_ROOT_CREATED=

function workload_ensure_root()
{
    WORKLOAD_ROOT=$($CLICKHOUSE_CLIENT -q "SELECT name FROM system.workloads WHERE parent = ''")
    if [[ -z $WORKLOAD_ROOT ]]; then
        $CLICKHOUSE_CLIENT -q "CREATE WORKLOAD all"
        WORKLOAD_ROOT=all
        WORKLOAD_ROOT_CREATED=1
    fi
}

function workload_remove_our_root()
{
    if [[ -n $WORKLOAD_ROOT_CREATED ]]; then
        $CLICKHOUSE_CLIENT -q "DROP WORKLOAD IF EXISTS $WORKLOAD_ROOT"
    fi
}

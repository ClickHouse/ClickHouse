#!/usr/bin/env bash

# Shared helpers for the `reattach_tables_before_query_execution` suite. The suite is split across
# several test files so that no single one approaches the per-test timeout: a check costs one
# `clickhouse-client` invocation, and on a sanitizer build that is seconds rather than milliseconds.
#   `02461_reattach_tables`           - reads and writes, `BACKUP`/`RESTORE`, temporary tables, CTE scoping
#   `05099_reattach_tables_access`    - the access preflight the internal `DETACH`/`ATTACH` has to pass
#   `05100_reattach_tables_create`    - unresolvable references, object kinds, `CREATE` destinations
#   `05101_reattach_tables_engines`   - engines and database engines the hook has to skip
#   `05102_reattach_tables_mutations` - mutation carriers, a busy table, `max_tables`, `INSERT`
#   `05103_reattach_tables_internal_settings` - the settings the internal `DETACH`/`ATTACH` runs with
#   `05104_reattach_tables_dynamic_disk` - a table that builds its own disk with the `disk` function
#   `05398_reattach_tables_bindings_quota_limits` - `IN` bindings, SQL UDFs, quotas, `CREATE` table limits
#   `05441_reattach_tables_indirect_sources` - `Alias` targets, table functions, CTE-named columns
#   `05479_reattach_tables_type_gates_refreshable_view` - setting-gated `AggregateFunction` types, refreshable views
#   `05480_reattach_tables_create_explicit_schema_scalars` - explicit-schema `CREATE ... AS SELECT`, scalar grant checks
#   `05557_reattach_tables_constrained_scope_export_access` - constrained nested `WITH` scope, export grants of inner engines

MY_CLICKHOUSE_CLIENT=$(echo ${CLICKHOUSE_CLIENT} | sed 's/'"--send_logs_level=${CLICKHOUSE_CLIENT_SERVER_LOGS_LEVEL}"'/--send_logs_level=trace/g')

# Run the query and capture both the client exit code and its output (including trace logs).
# A non-zero client exit code means the query itself failed, which must be reported as FAIL by the
# callers instead of being silently treated as "the table was not detached".
function check_if_detached_impl()
{
    query="$1"
    REATTACH_OUTPUT=$(${MY_CLICKHOUSE_CLIENT} \
        --reattach_tables_before_query_execution=1  \
        --query "$query" 2>&1)
    REATTACH_STATUS=$?
}

function check_if_detached()
{
    check_if_detached_impl "$1" "$2"
    # The hook skips a table that is in use right now: it probes the exclusive lock for only 100 ms, and a
    # brief share lock held concurrently, e.g. by the table's own background merge selection that the
    # previous check's `ATTACH` scheduled, makes it skip one randomization. That is the intended best-effort
    # behaviour, so repeat a read-only query a few times before reporting that the table was not detached.
    # A query that writes is not repeated, because that would change the data the later checks look at.
    if echo "$1" | grep -qiE '^[[:space:]]*(SELECT|WITH)[[:space:]]'; then
        for _ in {1..4}
        do
            if [ "$REATTACH_STATUS" -ne 0 ] || echo "$REATTACH_OUTPUT" | grep -q "DETACH TABLE $CLICKHOUSE_DATABASE.$2"; then
                break
            fi
            check_if_detached_impl "$1" "$2"
        done
    fi
    if [ "$REATTACH_STATUS" -ne 0 ]; then
        echo "FAIL (client error: $REATTACH_OUTPUT)"
    elif echo "$REATTACH_OUTPUT" | grep -q "DETACH TABLE $CLICKHOUSE_DATABASE.$2"; then
        echo "OK"
    else
        echo "FAIL"
    fi
}

function check_if_not_detached()
{
    check_if_detached_impl "$1" "$2"
    if [ "$REATTACH_STATUS" -ne 0 ]; then
        echo "FAIL (client error: $REATTACH_OUTPUT)"
    elif echo "$REATTACH_OUTPUT" | grep -q "DETACH TABLE $CLICKHOUSE_DATABASE.$2"; then
        echo "FAIL"
    else
        echo "OK"
    fi
}

function check_fails_kind_without_detach()
{
    local expected_error="${3:-BAD_ARGUMENTS}"
    check_if_detached_impl "$1" "$2"
    if [ "$REATTACH_STATUS" -eq 0 ]; then
        echo "FAIL (query unexpectedly succeeded)"
    elif ! echo "$REATTACH_OUTPUT" | grep -q "$expected_error"; then
        echo "FAIL (unexpected error: $REATTACH_OUTPUT)"
    elif echo "$REATTACH_OUTPUT" | grep -q "DETACH TABLE $CLICKHOUSE_DATABASE.$2"; then
        echo "FAIL (table was detached for a kind-mismatched metadata query)"
    else
        echo "OK"
    fi
}

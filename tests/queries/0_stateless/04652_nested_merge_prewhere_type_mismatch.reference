-- single level: the mismatched column is already rejected for PREWHERE --
-- nested: must be rejected too, not abort in ActionsDAG --
-- a column whose type matches all the way down still supports PREWHERE --
10
0	1
1	2
2	3
-- the same predicate as WHERE keeps working --
9
10
1	2
2	3
3	4
-- view over a mismatched target is already rejected --
-- view over a view must be rejected too --
-- a matching column still supports PREWHERE through the chain --
10
0	1
1	2
2	3
-- the same predicates as WHERE keep working --
9
10
1	2
2	3
3	4
-- Merge over a materialized view must be rejected too --
-- and a matching column still works --
10
0	1
1	2
2	3
-- the same predicates as WHERE keep working --
9
10
1	2
2	3
3	4
-- re-attached tables are lazy proxies --
lazy_inner	TableProxy
lazy_leaf	TableProxy
lazy_outer	TableProxy
-- the proxy must still reject the mismatched column, not abort --
-- a matching column still supports PREWHERE through the proxy --
10
0	1
1	2
2	3
-- the same predicates as WHERE keep working through the proxy --
9
10

-- plain
Order: nowInBlock() ASC
Flush on order key change: 1
-- monotonic function
Order: toStartOfMinute(nowInBlock()) ASC
-- decreasing function
Order: -toInt64(nowInBlock()) DESC
-- nowInBlock64
Order: nowInBlock64(6, \'UTC\') ASC
-- the time and other keys
Order: toStartOfSecond(nowInBlock64()) ASC
-- the time from a subquery
Order: nowInBlock() ASC

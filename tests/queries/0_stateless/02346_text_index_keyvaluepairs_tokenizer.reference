-- the index prunes granules
Granules: 2/2
Name: idx
Granules: 1/2
-- exact direct read: the predicate is replaced by a text index virtual column
1
-- both accessor forms work: arrayElement and the m.key_<key> subcolumn
subcolumns=0	1
subcolumns=0	3
subcolumns=1	1
subcolumns=1	3
subcolumns=0	1
subcolumns=1	1
-- AND / OR / NOT, with and without the index
and idx	3
and scan	3
or idx	2
or idx	3
or scan	2
or scan	3
not idx	2
not idx	4
not scan	2
not scan	4
-- comparing to the empty string is true for rows without the key too, and those have no token: the index is bypassed
idx	4
scan	4
not replaced	0
-- a FixedString needle carries padding bytes, so it must not silently drop rows
idx	[1,3]
scan	[1,3]
-- duplicate keys: m[key] is the value of the first occurrence
first idx	1
first scan	1
second idx	2
second scan	2
-- the later duplicate is a distinct token: is_rest = 1 sets the lowest bit of the length prefix

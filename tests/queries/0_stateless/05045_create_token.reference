-- The generated secrets are stored hashed and are not shown by SHOW CREATE USER
CREATE USER user IDENTIFIED WITH plaintext_password, sha256_password, sha256_password, sha256_password GRANTS (SELECT ON db.t1), sha256_password VALID UNTIL \'2077-01-01 00:00:00\' GRANTS (SELECT ON db.t2)

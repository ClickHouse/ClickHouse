DROP TABLE IF EXISTS t_tuple_key_desc;
CREATE TABLE t_tuple_key_desc (name String, other String, id Int32)
ENGINE = MergeTree ORDER BY (name, (id, other) DESC)
SETTINGS index_granularity = 1024;

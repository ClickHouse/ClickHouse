#!/usr/bin/expect -f
# `clickhouse install` asks to repeat the password for the default user typed in the terminal.
# The installation goes to a temporary prefix, without creating a dedicated user and group, so it does not need root.

set basedir [file dirname $argv0]
set basename [file tail $argv0]
if {[info exists env(CLICKHOUSE_TMP)]} {
    set CLICKHOUSE_TMP $env(CLICKHOUSE_TMP)
} else {
    set CLICKHOUSE_TMP "."
}
exp_internal -f $CLICKHOUSE_TMP/$basename.debuglog 0
set prefix [file normalize $CLICKHOUSE_TMP/$basename.install]
set password_file $prefix/etc/clickhouse-server/users.d/default-password.xml

log_user 0
set timeout 60
match_max 100000

expect_after {
    # Do not ignore eof from expect
    -i $any_spawn_id eof { exp_continue }
    # A default timeout action is to do nothing, change it to fail
    -i $any_spawn_id timeout { exit 1 }
}

# The installer makes some files read-only.
proc remove_prefix {} {
    global prefix
    if {[file exists $prefix]} {
        exec chmod -R u+w $prefix
        file delete -force $prefix
    }
}

# The stub of `capsh` makes the installer skip setting capabilities,
# which it would set on the binary of the test, because it is installed as a symlink (`--link`).
remove_prefix
# Also on failure, otherwise the read-only files remain.
exit -onexit remove_prefix
file mkdir $prefix/stub
exec sh -c "printf '#!/bin/sh\\nexit 1\\n' > $prefix/stub/capsh && chmod +x $prefix/stub/capsh"

proc spawn_install {} {
    global basedir prefix spawn_id
    spawn bash -c "source $basedir/../shell_config.sh ; unset DEBIAN_FRONTEND ; PATH=$prefix/stub:\$PATH \$CLICKHOUSE_BINARY install --link --prefix $prefix --user '' --group ''"
}

proc expect_status {expected_success} {
    global spawn_id
    expect eof
    lassign [wait] pid spawn_id os_error status
    if {($status == 0) != $expected_success} {
        send_user "The installation finished with the unexpected status $status.\n"
        exit 1
    }
}

proc expect_success {} { expect_status 1 }
proc expect_failure {} { expect_status 0 }

# The passwords do not match, so the password is asked again.
spawn_install
expect "Set up the password for the default user: "
send -- "pw1\r"
expect "Repeat the password: "
send -- "pw2\r"
expect "Passwords do not match, try again."
expect "Set up the password for the default user: "
send -- "pw1\r"
expect "Repeat the password: "
send -- "pw1\r"
expect "Password for the default user is saved"
# The default answer (no) keeps the server listening on localhost only.
expect "Allow server to accept connections from the network"
send -- "\r"
expect_success
if {![file exists $password_file]} {
    send_user "The password is not saved.\n"
    exit 1
}

# An empty confirmation (Ctrl+D or Enter) fails the installation, so that the default user is not left without a password.
exec chmod u+w [file dirname $password_file]
file delete $password_file
spawn_install
expect "Set up the password for the default user: "
send -- "pw1\r"
expect "Repeat the password: "
send -- "\x04"
expect "The password for the default user is not confirmed"
expect_failure
if {[file exists $password_file]} {
    send_user "The password is saved without confirmation.\n"
    exit 1
}

# Without a controlling terminal (`setsid`), the password is read from stdin once, and it is not asked again.
exec chmod u+w [file dirname $password_file]
spawn setsid -w bash -c "source $basedir/../shell_config.sh ; unset DEBIAN_FRONTEND ; PATH=$prefix/stub:\$PATH \$CLICKHOUSE_BINARY install --link --prefix $prefix --user '' --group ''"
expect "Set up the password for the default user: "
send -- "pw1\r"
expect {
    "Repeat the password" {
        send_user "The password is asked again without a terminal.\n"
        exit 1
    }
    "Password for the default user is saved" {}
}
expect "Allow server to accept connections from the network"
send -- "\r"
expect_success
if {![file exists $password_file]} {
    send_user "The password is not saved.\n"
    exit 1
}

remove_prefix

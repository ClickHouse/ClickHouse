-- histogram_quantile over a native histogram: q=0.5 lands on [2,4], fraction 1/3, linear -> 2 + 2/3
[('job','e2e')]	1970-01-01 00:02:00.000	2.6666666666666665
-- histogram_quantile over classic buckets: the classic branch (UNION ALL with the empty native branch)
[('job','classic')]	1970-01-01 00:02:00.000	0.75
-- histogram_quantile over both: UNION ALL of the classic and native branches
[('job','classic')]	1970-01-01 00:02:00.000	0.75
[('job','e2e')]	1970-01-01 00:02:00.000	2.6666666666666665
-- out-of-range phi on a native histogram: phi 2 -> +Inf (the scalar function carries the semantics)
[('job','e2e')]	1970-01-01 00:02:00.000	inf
-- histogram_quantile over a pure-float series: no histogram samples, the series is skipped
-- histogram_fraction over a native histogram: linear ranks 1 and 5 in [1,2] and [2,4] -> (5-1)/8 = 0.5
[('job','e2e')]	1970-01-01 00:02:00.000	0.5
-- histogram_fraction over classic buckets: not supported, empty result
-- histogram_fraction over a pure-float series: empty result
-- range query over the native histogram: the quantile is emitted at every step seeing the sample
[('job','e2e')]	[('1970-01-01 00:01:50.000',2.6666666666666665),('1970-01-01 00:02:00.000',2.6666666666666665)]

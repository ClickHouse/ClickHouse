query tree: CUBE
SELECT
    __table1.a AS a,
    abs(__table1.a) AS `abs(a)`
FROM default.t_order_by_modifiers AS __table1
GROUP BY
    __table1.a,
    abs(__table1.a)
    WITH CUBE
ORDER BY
    __table1.a ASC,
    abs(__table1.a) ASC
query tree: ROLLUP
SELECT
    __table1.a AS a,
    abs(__table1.a) AS `abs(a)`
FROM default.t_order_by_modifiers AS __table1
GROUP BY
    __table1.a,
    abs(__table1.a)
    WITH ROLLUP
ORDER BY
    __table1.a ASC,
    abs(__table1.a) ASC
query tree: GROUPING SETS
SELECT
    __table1.a AS a,
    abs(__table1.a) AS `abs(a)`
FROM default.t_order_by_modifiers AS __table1
GROUP BY
    GROUPING SETS (
        (__table1.a, abs(__table1.a)),
        (abs(__table1.a)))
ORDER BY
    __table1.a ASC,
    abs(__table1.a) ASC
query tree: plain GROUP BY
SELECT
    __table1.a AS a,
    abs(__table1.a) AS `abs(a)`
FROM default.t_order_by_modifiers AS __table1
GROUP BY __table1.a
ORDER BY __table1.a ASC
query tree: WITH TOTALS
SELECT
    __table1.a AS a,
    abs(__table1.a) AS `abs(a)`
FROM default.t_order_by_modifiers AS __table1
GROUP BY
    __table1.a,
    abs(__table1.a)
    WITH TOTALS
ORDER BY __table1.a ASC

-- format_display_secrets_in_show_and_select = 0
-- same-side literal
Filter column: empty(HMAC(\'sha256\', toString(number), [HIDDEN]))
-- key from a derived table
Filter column: empty(HMAC(\'sha256\', toString(number), [HIDDEN]))
-- key from the opposite JOIN side
Filter column: empty(HMAC(\'sha256\', toString(number), [HIDDEN]))
-- legacy format
Filter column: empty(HMAC(\'sha256\'_String, toString(__table1.number), [HIDDEN id: 1]_String)) (removed)
-- format_display_secrets_in_show_and_select = 1
-- same-side literal
Filter column: empty(HMAC(\'sha256\', toString(number), \'LITERAL_SECRET\'))
-- key from a derived table
Filter column: empty(HMAC(\'sha256\', toString(number), \'DERIVED_SECRET\'))
-- key from the opposite JOIN side
Filter column: empty(HMAC(\'sha256\', toString(number), \'JOIN_SECRET\'))
-- legacy format
Filter column: empty(HMAC(\'sha256\'_String, toString(__table1.number), \'LITERAL_SECRET\'_String)) (removed)

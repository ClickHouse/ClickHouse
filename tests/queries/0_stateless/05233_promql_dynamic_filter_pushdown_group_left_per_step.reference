-- a duplicate on the right side at a step where the left side is empty is not reported, as in Prometheus
[('dc','a'),('env','prod'),('host','h1')]	[('1970-01-01 00:23:20.000',40)]
[('dc','a'),('host','h1')]	[('1970-01-01 00:23:20.000',40)]
[('dc','a'),('env','prod'),('host','h1')]	[('1970-01-01 00:23:20.000',40)]
[('dc','a'),('env','prod'),('host','h1')]	[('1970-01-01 00:23:20.000',5)]
-- a duplicate on the right side at a step where the left side has a sample is reported, also in a join group the left side does not have

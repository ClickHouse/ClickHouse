[[0,0],[0,0]]
[[1,2],[3,4]]
SELECT einsum((i, j, k) -> (((a[i])[k]) * ((b[k])[j])))
SELECT einsum(\'ik,kj->ij\', __table1.a, __table1.b) AS `einsum(\'ik,kj->ij\', a, b)`
FROM
(
    SELECT
        _CAST([[1]], \'Array(Array(UInt8))\') AS a,
        _CAST([[2]], \'Array(Array(UInt8))\') AS b
    FROM system.one AS __table2
) AS __table1
SELECT einsum(\'ij,ij->ij\', ((x1, x2) -> ((0.5 * x1) + (0.5 * x2))), arrayMap(x -> arrayMap(y -> arrayElement(y, 1), x), __table1.m), arrayMap(x -> arrayMap(y -> arrayElement(y, 2), x), __table1.m)) AS `einsum(\'ij,ij->ij\', lambda(tuple(x1, x2), plus(multiply(0.5, x1), multiply(0.5, x2))), arrayMap(lambda(tuple(x), arrayMap(lambda(tuple(y), arrayElement(y, 1)), x)), m), arrayMap(lambda(tuple(x), arrayMap(lambda(tuple(y), arrayElement(y, 2)), x)), m))`
FROM
(
    SELECT _CAST([[[1, 2]]], \'Array(Array(Array(UInt8)))\') AS m
    FROM system.one AS __table2
) AS __table1

-- `GROUP BY ... ORDER BY count() LIMIT n` keeps only the best n groups of each two-level bucket. When `count()` is the
-- only aggregate function, each pair of cells prints that pruned top-5 (`top_k 1`) and the full one (`top_k 0`) for
-- numeric, short and long `String` keys (the empty string is the heaviest group), the legacy `String` table and a
-- `String` and number key, in both sort directions, with and without the adaptive aggregator. The five heaviest and the
-- five lightest groups have unique counts, so each top-5 is exact and both cells of a pair print the same rows.
-- The switch is a top-level setting: inside a subquery it does not reach the plan optimization.

SET max_threads = 4;
SET max_block_size = 8192;
SET group_by_two_level_threshold = 100;
SET max_bytes_before_external_group_by = 0;
SET max_bytes_ratio_before_external_group_by = 0;
SET adaptive_aggregator_freeze_threshold = 128;
SET collect_hash_table_stats_during_aggregation = 0;
SET automatic_parallel_replicas_mode = 0;
SET query_plan_enable_optimizations = 1;
SET query_plan_push_down_limit = 1;

DROP TABLE IF EXISTS t_bucket_top_k_simple_count;
CREATE TABLE t_bucket_top_k_simple_count (k UInt64) ENGINE = Memory;

-- 20000 groups of 6 rows, five heavy groups of 100..104 rows and five light groups of 1..5 rows.
INSERT INTO t_bucket_top_k_simple_count SELECT number % 20000 FROM numbers(120000);
INSERT INTO t_bucket_top_k_simple_count SELECT 1000000 + i FROM (SELECT number AS i FROM numbers(5)) ARRAY JOIN range(100 + i) AS j;
INSERT INTO t_bucket_top_k_simple_count SELECT 2000000 + i FROM (SELECT number AS i FROM numbers(5)) ARRAY JOIN range(1 + i) AS j;

{% set key_sets = [
    ('UInt64', 'k', 'k', 1),
    ('short String', "if(k = 1000004, '', toString(k)) AS sk", 'sk', 1),
    ('long String', "if(k = 1000004, '', concat('https://example.com/item/', toString(k))) AS sk", 'sk', 1),
    ('String, legacy table', "if(k = 1000004, '', toString(k)) AS sk", 'sk', 0),
    ('String and number', 'toString(k) AS sk, k % 7', 'sk, k % 7', 1),
] -%}
{% for adaptive in [0, 1] -%}
SET enable_adaptive_aggregator = {{ adaptive }};
{% for key_label, keys, group_keys, packed in key_sets -%}
SET enable_packed_string_keys_in_aggregation = {{ packed }};
{% for direction in ['DESC', 'ASC'] -%}
{% for top_k in [1, 0] -%}
SELECT 'adaptive {{ adaptive }}, {{ key_label }}, {{ direction }}, top_k {{ top_k }}', arraySort(groupArray(tuple(*)))
FROM (SELECT {{ keys }}, count() AS c FROM t_bucket_top_k_simple_count GROUP BY {{ group_keys }} ORDER BY c {{ direction }} LIMIT 5)
SETTINGS query_plan_aggregation_bucket_top_k = {{ top_k }};
{% endfor -%}
{% endfor -%}
{% endfor -%}
{% endfor -%}

DROP TABLE t_bucket_top_k_simple_count;

-- Finite values
0
1
1970
2
[('job','j')]	1
-- NaN and infinite values
nan
nan
nan
nan
nan
[('job','nan')]	nan
-- Time steps without a value stay NULL
[('job','j')]	[('1970-01-01 00:00:00.000',0),('1970-01-01 01:00:00.000',1)]
[('job','j')]	[('1970-01-01 00:00:00.000',1970),('1970-01-01 01:00:00.000',1970)]
[('job','nan')]	[('1970-01-01 00:00:00.000',nan)]
-- Without short-circuit evaluation
[('job','j')]	0
[('job','nan')]	nan
[('job','j')]	[('1970-01-01 00:00:00.000',1970),('1970-01-01 01:00:00.000',1970)]
[('job','nan')]	[('1970-01-01 00:00:00.000',nan)]

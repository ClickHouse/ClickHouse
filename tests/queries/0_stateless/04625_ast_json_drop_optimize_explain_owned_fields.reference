DROP TEMPORARY TABLE db.t
DETACH TABLE db.t PERMANENTLY
TRUNCATE ALL TABLES FROM db NOT LIKE \'x%\'
OPTIMIZE TABLE db.t DEDUPLICATE BY x, y
OPTIMIZE TABLE t FINAL DEDUPLICATE BY * EXCEPT (a, b)
OPTIMIZE TABLE t DEDUPLICATE BY COLUMNS(\'.*id\')
EXPLAIN CURRENT TRANSACTION
EXPLAIN TABLE OVERRIDE mysql(\'127.0.0.1:3306\', \'db\', \'t\', \'user\', \'pw\') PARTITION BY x

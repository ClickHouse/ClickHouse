load("@clickhouse//bazel/rules:cmake_link.bzl", "cmake_link")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "base/pcg-random/pcg_extras.hpp",
    "base/pcg-random/pcg_random.hpp",
    "base/pcg-random/pcg_uint128.hpp",
    "base/poco/LICENSE",
    "cmake/generate_export_header.h.in",
    "cmake/localize_rust_c_symbols.sh",
    "cmake/strip_rust_symbols.sh",
    "utils/list-licenses/Apache-2.0.txt",
    "utils/list-licenses/BSD-3-Clause.txt",
    "utils/list-licenses/BSL-1.0.txt",
    "utils/list-licenses/ISC.txt",
    "utils/list-licenses/MIT.txt",
    "utils/list-licenses/MPL-2.0.txt",
])

cmake_link(
    name = "clickhouse",
    features = [
        "-static_link_cpp_runtimes",
        "-fortify_source",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "unit_tests_dbms",
    actual = "//src:unit_tests_dbms",
)

cc_library(
    name = "headers",
    hdrs = glob([
        "**/*.h",
        "**/*.hpp",
    ]),
    textual_hdrs = glob([
        "**/*.inc",
        "**/*.def",
    ]),
)

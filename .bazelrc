common --check_direct_dependencies=error

common --incompatible_strict_action_env
common --compilation_mode=opt
common --features=system_include_paths

common:dwyu --aspects=//bazel/rules:dwyu.bzl%dwyu
common:dwyu --output_groups=dwyu
common:dwyu --keep_going
# Common CMake flags for ClickHouse's native libraries. Per-target copts
# retain exceptions such as -ffp-contract=fast on the array functions.
common --copt=-O3
common --copt=-DNDEBUG
common --copt=-DOS_LINUX
common --copt=-gz=zlib
common --copt=--no-default-config
common --copt=-pipe
common --copt=-fasynchronous-unwind-tables
common --copt=-fdebug-compilation-dir=.
common --copt=-falign-functions=64
common --copt=-falign-loops=32
common --copt=-ffunction-sections
common --copt=-fdata-sections
common --copt=-faddrsig
common --copt=-fstack-protector-strong
common --copt=-fstack-clash-protection
common --copt=-ffp-contract=off
common --copt=-fno-math-errno
common --copt=-fPIE
common --copt=-fdiagnostics-absolute-paths
common --copt=-fdiagnostics-color=always
common --copt=-Werror
common --cxxopt=-fstrict-vtable-pointers
# Match cmake/cxx.cmake for libraries supplied by external Bazel modules too.
common --cxxopt=-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST
common --verbose_failures
common --@rules_rust//rust/toolchain/channel=nightly
common --@rules_python//python/config_settings:bootstrap_impl=script
common --@llvm//toolchain:bootstrap_stage=stage1_from_source
common --@llvm//toolchain:sysroot_compile_files=@clickhouse_sysroot//:linux_compile_files
# Match contrib/llvm-project-cmake/config/llvm-config.h.in. ClickHouse links
# its own compression libraries; the compiler retains its compression support.
common --@llvm-project//third-party:llvm_enable_zlib=false
common --@llvm-project//third-party:llvm_enable_zstd=false

common:x86_64 --platforms=@rules_rs//rs/platforms:x86_64-unknown-linux-gnu
common:x86_64 --per_file_copt=//bazel:google_(api|cloud|iam|longrunning|rpc|storage|type)_.*_proto$@-w,-std=c++23,-march=x86-64-v3,-mpclmul,-mbranches-within-32B-boundaries,-DSTD_EXCEPTION_HAS_STACK_TRACE=1,-D_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS,-D_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1,-D_LIBUNWIND_IS_NATIVE_ONLY
# Match CMake's code-generation flags for the LLVM libraries in ClickHouse.
# per_file_copt leaves exec tools and the separately configured runtimes alone.
common:x86_64 --per_file_copt=external/llvm[+][+]llvm[+]llvm-project/llvm/.*@--no-default-config,-O3,-march=x86-64-v3,-mpclmul,-falign-functions=64,-falign-loops=32,-fasynchronous-unwind-tables,-faddrsig,-mbranches-within-32B-boundaries,-fstack-protector-strong,-fstack-clash-protection,-ffp-contract=off,-fno-math-errno,-fdebug-compilation-dir=.
common:x86_64 --per_file_copt=external/llvm[+][+]llvm[+]llvm-project/llvm/.*[.](c|cpp)$@-fPIE
common:x86_64 --per_file_copt=external/llvm[+][+]llvm[+]llvm-project/llvm/.*[.]cpp$@-fstrict-vtable-pointers
common:x86_64 --per_file_copt=external/llvm[+][+]llvm[+]llvm-project/llvm/.*[.]c$@-std=gnu11
common:x86_64 --per_file_copt=external/llvm[+][+]llvm[+]llvm-project/llvm/lib/Support/BLAKE3/blake3_avx512_x86-64_unix[.]S$@-mavx512f,-mavx512vl
common:aarch64 --platforms=@rules_rs//rs/platforms:aarch64-unknown-linux-gnu
common:aarch64 --per_file_copt=//bazel:google_(api|cloud|iam|longrunning|rpc|storage|type)_.*_proto$@-w,-std=c++23,-march=armv8.2-a+simd+crypto+dotprod+ssbs+rcpc+bf16,-DSTD_EXCEPTION_HAS_STACK_TRACE=1,-D_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS,-D_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1,-D_LIBUNWIND_IS_NATIVE_ONLY

# Use LLVM's Linux x86-64 execution platform for C++, Rust, and code generators.
common:remote --extra_execution_platforms=//bazel:buildbuddy_linux_x86_64
common:remote --remote_executor=grpcs://remote.buildbuddy.io
common:remote --remote_cache=grpcs://remote.buildbuddy.io
common:remote --bes_backend=grpcs://remote.buildbuddy.io
common:remote --bes_results_url=https://app.buildbuddy.io/invocation/
common:remote --remote_cache_compression
common:remote --remote_download_outputs=minimal
common:remote --jobs=500
common:remote --remote_timeout=3600
common:remote --noremote_local_fallback
common:remote --shell_executable=/bin/bash

# Reproduce the recorded x86-64 CMake comparison under BuildBuddy.
common:cmake_match --config=remote
common:cmake_match --config=x86_64
common:cmake_match --//bazel:cmake_metadata

# Compile and run the ARM64 comparison on native ARM64 workers.
common:cmake_match_aarch64 --config=remote
common:cmake_match_aarch64 --extra_execution_platforms=//bazel:buildbuddy_linux_aarch64,//bazel:buildbuddy_linux_aarch64_test,//bazel:buildbuddy_linux_x86_64
common:cmake_match_aarch64 --config=aarch64
common:cmake_match_aarch64 --//bazel:cmake_metadata

try-import %workspace%/.bazelrc.local

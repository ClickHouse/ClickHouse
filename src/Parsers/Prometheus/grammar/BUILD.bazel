load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "llvm_toolchain_path", "repository_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

ch_cc_library(
    name = "clickhouse_antlr4_grammars",
    srcs = glob(["generated/antlr4_grammars/*.cpp"]),
    hdrs = [
        "generated/antlr4_grammars/PromQLLexer.h",
        "generated/antlr4_grammars/PromQLParser.h",
        "generated/antlr4_grammars/PromQLParserBaseListener.h",
        "generated/antlr4_grammars/PromQLParserBaseVisitor.h",
        "generated/antlr4_grammars/PromQLParserListener.h",
        "generated/antlr4_grammars/PromQLParserVisitor.h",
    ],
    clickhouse_code = True,
    copts = [
        "-w",
        "-fno-xray-instrument",
        "-I",
        "$(GENDIR)/bazel/gen/includes/configs",
        "-I",
        repository_path("contrib/antlr4-cpp-runtime") + "/runtime/Cpp/runtime/src",
    ],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "generated",
    ] + [
        "../../../../" + (llvm_toolchain_path() + "/libunwind/include"),
        "../../../../" + (llvm_toolchain_path() + "/libc"),
        "../../../../" + (llvm_toolchain_path() + "/compiler-rt/include"),
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse_antlr4_cpp_runtime//:_ch_contrib_antlr4_cpp_runtime",
        "@clickhouse_llvm_project//:clang_rt_builtins",
        "@clickhouse_llvm_project//:cxx",
        "@clickhouse_llvm_project//:cxxabi",
        "//base/glibc-compatibility:glibc-compatibility",
        "@clickhouse_llvm_project//:unwind",
    ],
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
)

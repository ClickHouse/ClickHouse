load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "repository_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

ch_cc_library(
    name = "daemon",
    srcs = [
        "BaseDaemon.cpp",
        "GraphiteWriter.cpp",
        "CrashWriter.cpp",
    ],
    clickhouse_code = True,
    copts = [
        "-I",
        "$(GENDIR)/bazel/gen/includes/configs",
        "-I",
    ] + select({
        "@platforms//cpu:x86_64": ["$(GENDIR)/bazel/gen/src"],
        "@platforms//cpu:aarch64": ["$(GENDIR)/bazel/gen/src"],
    }) + [
        "-I",
        repository_path("contrib/libfiu") + "/libfiu",
        "-I",
        "$(GENDIR)/" + repository_path("contrib/libssh") + "/config/contrib/libssh/include",
        "-I",
        repository_path("contrib/libarchive") + "/libarchive",
        "-I",
        "rust/workspace/pco/include",
    ],
    local_defines = select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            "ARM_ACLE",
            "ARM_ASM_HWCAP",
            "ARM_AUXV_HAS_CRC32",
            "ARM_AUXV_HAS_NEON",
            "ARM_FEATURES",
            "ARM_NEON",
            "ARM_NEON_HASLD4",
        ],
    }) + [
        "BOOST_ASIO_HAS_STD_INVOKE_RESULT=1",
        "BOOST_ASIO_STANDALONE=1",
        "BOOST_TIMER_ENABLE_DEPRECATED=1",
        "ENABLE_DISTRIBUTED_CACHE=0",
        "ENABLE_MULTITARGET_CODE=1",
        "FIU_ENABLE",
    ] + select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            "HAVE_ARM_ACLE_H",
        ],
    }) + [
        "HAVE_ATTRIBUTE_ALIGNED",
        "HAVE_BUILTIN_CTZ",
        "HAVE_BUILTIN_CTZLL",
        "HAVE_CONFIG_H",
        "HAVE_POSIX_MEMALIGN",
    ] + select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            "HAVE_SYS_AUXV_H",
        ],
    }) + [
        "HAVE_VISIBILITY_HIDDEN",
        "HAVE_VISIBILITY_INTERNAL",
        "JEMALLOC_NO_RENAME",
        "PICOJSON_USE_LOCALE=0",
        "POCO_ENABLE_CPP11",
        "POCO_OS_FAMILY_UNIX",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "UNALIGNED_OK",
        "USE_CLICKHOUSE_THREADS=1",
        "WITH_COVERAGE=0",
        "WITH_COVERAGE_DEPTH=0",
        "WITH_GZFILEOP",
        "X86_64",
    ] + select({
        "@platforms//cpu:x86_64": [
            "X86_AVX2",
            "X86_FEATURES",
            "X86_PCLMULQDQ_CRC",
            "X86_SSE2",
            "X86_SSE42",
            "X86_SSSE3",
        ],
        "@platforms//cpu:aarch64": [],
    }) + [
        "ZLIB_COMPAT",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "../../bazel/gen/base",
        "../../" + (repository_path("contrib/llvm-project") + "/llvm/include"),
    ],
    deps = [
        "@clickhouse_llvm_project//:LLVMDebugInfoDWARF",
        "@clickhouse_llvm_project//:LLVMExecutionEngine",
        "@clickhouse_llvm_project//:LLVMPasses",
        "@clickhouse_llvm_project//:LLVMSupport",
        "@clickhouse_llvm_project//:LLVMXRay",
        "@llvm-project//third-party/siphash:siphash",
        "@clickhouse_boost//:boost_headers",
        "@clickhouse_fmtlib//:_fmt",
        "//src/Loggers:loggers",
        "@clickhouse_aws_c_mqtt//:aws_c_mqtt",
        "@clickhouse_fast_float//:fast_float",
        "@clickhouse_jwt_cpp//:jwt_cpp",
        "@clickhouse_libdivide//:libdivide",
        "@clickhouse_magic_enum//:magic_enum",
        "@clickhouse_miniselect//:miniselect",
        "@clickhouse_msgpack_c//:msgpack_c",
        "@clickhouse_pocketfft//:pocketfft",
        "@clickhouse_sparsehash_c11//:sparsehash_c11",
        "@clickhouse_sz3//:sz3",
        "//base/glibc-compatibility:headers",
        "//base/glibc-rseq:headers",
        "//base/poco/Foundation:headers",
        "//base/poco/JSON:headers",
        "//base/poco/Net:headers",
        "//base/poco/NetSSL_OpenSSL:headers",
        "//base/poco/Redis:headers",
        "//base/poco/Util:headers",
        "//base/poco/XML:headers",
        "//base/readpassphrase:headers",
        "//base/widechar_width:headers",
        "//contrib/cityhash102:headers",
        "//contrib/driftsort:headers",
        "//contrib/ipnsort:headers",
        "//contrib/jemalloc-cmake:headers",
        "//contrib/libdivide-cmake:headers",
        "//contrib/openssl-cmake:headers",
        "//contrib/pdqsort:headers",
        "//contrib/sz3-cmake:headers",
        "//:headers",
        "//base:base_headers",
        "//src:headers",
        "//src/Access/Common:headers",
        "//src/AggregateFunctions:headers",
        "//src/Common:headers",
        "//src/Common/Config:headers",
        "//src/Common/ZooKeeper:headers",
        "//src/Common/mysqlxx:headers",
        "//src/Compression:headers",
        "//src/Dictionaries:headers",
        "//src/Dictionaries/Embedded:headers",
        "//src/Functions:headers",
        "//src/Functions/GatherUtils:headers",
        "//src/Functions/JSONPath:headers",
        "//src/Functions/TimeSeries:headers",
        "//src/Functions/URL:headers",
        "//src/Functions/UniqTheta:headers",
        "//src/Functions/array:headers",
        "//src/Loggers:headers",
        "//src/Parsers:headers",
        "//src/Parsers/Prometheus/grammar:headers",
        "//src/Storages/System:headers",
        "//src/TableFunctions:headers",
    ],
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
)

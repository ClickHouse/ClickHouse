# Heavily templated code here makes the static analyzer re-analyze thousands of
# instantiations with inlined callees (up to 38 minutes for one file). Shallow mode
# does not inline callees, which makes it about eight times faster. It is passed as a
# compiler flag because `clang-analyzer-mode` in `CheckOptions` has no effect.
InheritParentConfig: true

ExtraArgs: ['-Xclang', '-analyzer-config', '-Xclang', 'mode=shallow']

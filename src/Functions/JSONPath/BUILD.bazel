load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//src:common_io_flags.bzl", "DBMS_CONSUMER_DEFINES")

package(default_visibility = ["//visibility:public"])

_PRIVATE_FUNCTIONS_JSONPATH_HEADERS = glob(
    [
        "ASTs/*.h",
        "Generator/VisitorJSONPath*.h",
        "Parsers/*.h",
    ],
    exclude = [
        "Parsers/ParserJSONPath.h",
    ],
)

ch_cc_library(
    name = "clickhouse_functions_jsonpath",
    srcs = glob(["Parsers/*.cpp"]) + _PRIVATE_FUNCTIONS_JSONPATH_HEADERS,
    hdrs = glob(
        [
            "**/*.h",
        ],
        exclude = _PRIVATE_FUNCTIONS_JSONPATH_HEADERS,
    ),
    clickhouse_code = True,
    copts = ["-g1"],
    implementation_deps = [
        "//src/Parsers:headers",
        "//src:headers",
        "//src/Common",
        "//src/Common:string_utils",
        "//src:io_string_buffers",
    ],
    link_runtime = True,
    local_defines = DBMS_CONSUMER_DEFINES,
    deps = [
        "//src/Parsers:parser_api",
        "//src/Common:memory_tracking_api",
    ],
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//src:common_io_flags.bzl", "common_io_defines")

package(default_visibility = ["//visibility:public"])

ch_cc_library(
    name = "clickhouse_common_config",
    srcs = [
        "AbstractConfigurationComparison.cpp",
        "ConfigProcessor.cpp",
        "ConfigurationWithUsageTracking.cpp",
        "getClientConfigPath.cpp",
        "getConfigPath.cpp",
        "getLocalConfigPath.cpp",
        "ConfigReloader.cpp",
        "YAMLParser.cpp",
        "ConfigHelper.cpp",
        "parseConnectionCredentials.cpp",
    ],
    hdrs = glob(["*.h"]),
    clickhouse_code = True,
    implementation_deps = [
        "//src:headers",
        "//src/Common/ZooKeeper:clickhouse_common_zookeeper_base",
        "//src/Common/ZooKeeper:headers",
        "@clickhouse_boost//:boost_headers_no_openssl",
        "@clickhouse_yaml_cpp//:_yaml_cpp",
        "//src/Compression:clickhouse_compression",
        "//src/Common:exception_api",
        "//src/Common:string_utils",
        "//src:io_string_buffers",
        "//src/Compression:codec_api",
    ],
    link_runtime = True,
    local_defines = common_io_defines([
        "ENABLE_MULTITARGET_CODE=1",
        "USE_CLICKHOUSE_THREADS=1",
    ]),
    source_headers = True,
    strip_include_prefix = "/src",
    deps = [
        "//src:core_types",
        "@clickhouse_llvm_project//:LLVMAggressiveInstCombine",
        "@clickhouse_llvm_project//:LLVMSupport",
        "@clickhouse_aws//:_aws",
        "@clickhouse_boost//:_boost_context",
        "@clickhouse_openldap//:_ldap",
        "//contrib/lz4-cmake:_lz4",
        "@clickhouse_silk//:_silk_fibers",
        "@clickhouse_zstd//:_zstd",
        "//src/Common/ZooKeeper:clickhouse_common_zookeeper",
        "//src/Common",
        "//base/poco/Foundation:_poco_foundation",
        "//base/poco/Util:_poco_util",
        "//base/poco/XML:_poco_xml",
        "//bazel:clickhouse_config_headers",
        "//base:common",
        "//src/Common:parser_support_api",
    ],
)

<clickhouse>
    <profiles>
        <default>
            <constraints>
                <!--
                    Prevent pathologically slow/hung queries built from deeply nested
                    expressions (e.g. `SELECT formatQuery($$SELECT [[[[...20000...]]]]$$)`).
                    Bound the parser/AST depth and size settings to [1, default] so neither
                    the query fuzzer nor a test can raise them to values that build huge,
                    slow-to-parse/format queries. The `<min>1</min>` matters: for all of these
                    a value of `0` means "unlimited" and disables the guard, so a `<max>` alone
                    would still let `SET ... = 0` remove the safeguard. Lowering to any value
                    >= 1 is still allowed.

                    Installed by both the AST fuzzer and the stress test, since the stress
                    test ignores `no-*` build tags and runs the fuzzer over every query.

                    `max_parser_backtracks` is additionally pinned on the client command line
                    (run-fuzzer.sh, stress.py): its pre-24.3 default is 0, so a client
                    `compatibility=...` reverts it to 0 and sends that to the server, which a
                    value in this profile cannot prevent (the client value wins).
                -->
                <max_ast_depth>
                    <min>1</min>
                    <max>1000</max>
                </max_ast_depth>
                <max_parser_depth>
                    <min>1</min>
                    <max>1000</max>
                </max_parser_depth>
                <max_parser_backtracks>
                    <min>1</min>
                    <max>1000000</max>
                </max_parser_backtracks>
                <max_ast_elements>
                    <min>1</min>
                    <max>50000</max>
                </max_ast_elements>
                <max_expanded_ast_elements>
                    <min>1</min>
                    <max>500000</max>
                </max_expanded_ast_elements>

                <!--
                    Time-duration/timeout settings pinned read-only so the fuzzer cannot inflate a
                    timeout/sleep/interval into a multi-minute server wait (lock/socket wait that
                    ignores query cancellation), which the stress-test hung-check flags as a false
                    "possible deadlock".

                    Settings that CI harness clients pass on the command line (and therefore ship
                    with every query) must NOT be read-only - that rejects every query the harness
                    runs. Those get [min, max] bounds instead: receive_timeout / send_timeout
                    (clickhouse-client health checks and setup_log_cluster.sh pass 5..45, the AST
                    fuzzer client passes 10) and receive_data_timeout_ms (the AST fuzzer client
                    passes 10000).
                -->
                <receive_timeout>
                    <min>1</min>
                    <max>300</max>
                </receive_timeout>
                <send_timeout>
                    <min>1</min>
                    <max>300</max>
                </send_timeout>
                <receive_data_timeout_ms>
                    <min>1</min>
                    <max>10000</max>
                </receive_data_timeout_ms>
                <connect_timeout>
                    <readonly/>
                </connect_timeout>
                <distributed_replica_error_half_life>
                    <readonly/>
                </distributed_replica_error_half_life>
                <http_connection_timeout>
                    <readonly/>
                </http_connection_timeout>
                <http_headers_read_timeout>
                    <readonly/>
                </http_headers_read_timeout>
                <http_receive_timeout>
                    <readonly/>
                </http_receive_timeout>
                <http_send_timeout>
                    <readonly/>
                </http_send_timeout>
                <iceberg_compaction_data_cleanup>
                    <readonly/>
                </iceberg_compaction_data_cleanup>
                <iceberg_compaction_delay_bias>
                    <readonly/>
                </iceberg_compaction_delay_bias>
                <lock_acquire_timeout>
                    <readonly/>
                </lock_acquire_timeout>
                <query_cache_ttl>

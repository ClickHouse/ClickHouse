<clickhouse>
    <!-- Allow merge tree settings to avoid errors while fuzzing definitions of tables -->
    <merge_tree>
        <allow_nullable_key>1</allow_nullable_key>
        <allow_floating_point_partition_key>1</allow_floating_point_partition_key>
        <allow_suspicious_indices>1</allow_suspicious_indices>
        <allow_minmax_index_for_json>1</allow_minmax_index_for_json>
        <allow_summing_columns_in_partition_or_order_key>1</allow_summing_columns_in_partition_or_order_key>
        <allow_coalescing_columns_in_partition_or_order_key>1</allow_coalescing_columns_in_partition_or_order_key>
        <allow_dimensions_outside_sorting_key>1</allow_dimensions_outside_sorting_key>
        <allow_tuple_element_aggregation>1</allow_tuple_element_aggregation>
        <allow_commit_order_projection>1</allow_commit_order_projection>
        <!-- `support_phrase_search` in a text index definition -->
        <allow_experimental_text_index_phrase_search>1</allow_experimental_text_index_phrase_search>
        <!-- `is_deleted` column of ReplacingMergeTree and `OPTIMIZE ... CLEANUP` -->
        <allow_experimental_replacing_merge_with_cleanup>1</allow_experimental_replacing_merge_with_cleanup>
        <enable_adaptive_codec_selection>1</enable_adaptive_codec_selection>
    </merge_tree>
    <!-- Definitions to be used by BuzzHouse -->
    <!-- TODO: Enable back after the issue with `assertHasValidVersionMetadata` will be fixed:
         https://play.clickhouse.com/play?user=play&run=1# -->
    <allow_experimental_transactions>0</allow_experimental_transactions>
    <!-- Experimental UDF kinds. Without these the corpus queries of e.g.
         `03206_wasm_module_manage.sql` are rejected before they can be mutated. -->
    <allow_experimental_webassembly_udf>1</allow_experimental_webassembly_udf>
    <allow_experimental_executable_udf_drivers>1</allow_experimental_executable_udf_drivers>
    <keeper_map_path_prefix>/keeper_map_tables</keeper_map_path_prefix>
    <named_collections>
        <local />
    </named_collections>
    <remote_servers>
        <cluster0>
            <shard>
                <replica>
                    <host>localhost</host>
                    <port>9000</port>
                </replica>
            </shard>
        </cluster0>
    </remote_servers>
    <shared_database_catalog />
    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
        <replicas_path>/clickhouse/task_queue/replicas</replicas_path>
    </distributed_ddl>
    <backups>
        <allowed_disk>default</allowed_disk>
        <allowed_path>/var/lib/clickhouse/</allowed_path>
        <allowed_path>/var/lib/clickhouse/user_files/</allowed_path>
    </backups>
    <tmp_path>/var/lib/clickhouse/tmp/</tmp_path>
</clickhouse>

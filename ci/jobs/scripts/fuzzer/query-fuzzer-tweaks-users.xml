<clickhouse>
    <profiles>
        <default>
            <max_execution_time>10</max_execution_time>
            <max_memory_usage>10G</max_memory_usage>

            <!--
                Otherwise we will get the TOO_MANY_SIMULTANEOUS_QUERIES errors,
                they are ok, but complicate debugging.
            -->
            <table_function_remote_max_addresses>200</table_function_remote_max_addresses>

            <!--
                Don't let the fuzzer change this setting (I've actually seen it
                do this before).
            -->
            <constraints>
                <max_execution_time>
                    <max>10</max>
                </max_execution_time>

                <max_memory_usage>
                    <max>5G</max>
                </max_memory_usage>

                <table_function_remote_max_addresses>
                    <max>200</max>
                </table_function_remote_max_addresses>

                <!-- Recursion-limiting constraints (max_ast_depth, max_parser_depth,
                     max_parser_backtracks) and the max_threads cap live in
                     limit-recursion-settings.xml, installed alongside this file and
                     shared with the stress test. -->

            </constraints>

            <!-- Allow all experimental features by default -->
            <ast_fuzzer_runs>5</ast_fuzzer_runs>
            <ast_fuzzer_any_query>true</ast_fuzzer_any_query>

            <ai_function_allow_insecure_endpoint>1</ai_function_allow_insecure_endpoint>
            <allow_block_nested_loop_join>1</allow_block_nested_loop_join>
            <allow_correlated_subqueries>1</allow_correlated_subqueries>
            <allow_create_index_without_type>1</allow_create_index_without_type>
            <allow_custom_error_code_in_throwif>1</allow_custom_error_code_in_throwif>
            <allow_database_glue_catalog>1</allow_database_glue_catalog>
            <allow_database_iceberg>1</allow_database_iceberg>
            <allow_database_unity_catalog>1</allow_database_unity_catalog>
            <allow_ddl>1</allow_ddl>
            <allow_delta_lake_create_table>1</allow_delta_lake_create_table>
            <allow_delta_lake_writes>1</allow_delta_lake_writes>
            <allow_distributed_ddl>1</allow_distributed_ddl>
            <allow_drop_detached>1</allow_drop_detached>
            <allow_dynamic_type_in_join_keys>1</allow_dynamic_type_in_join_keys>
            <allow_experimental_hash_functions>1</allow_experimental_hash_functions>
            <allow_experimental_iceberg_compaction>1</allow_experimental_iceberg_compaction>
            <allow_experimental_nlp_functions>1</allow_experimental_nlp_functions>
            <allow_experimental_shuffle_query>1</allow_experimental_shuffle_query>
            <allow_expire_snapshots>1</allow_expire_snapshots>
            <allow_fuzz_query_functions>1</allow_fuzz_query_functions>
            <allow_geo_types_in_iceberg>1</allow_geo_types_in_iceberg>
            <allow_get_client_http_header>1</allow_get_client_http_header>
            <allow_iceberg_remove_orphan_files>1</allow_iceberg_remove_orphan_files>
            <allow_insert_into_iceberg>1</allow_insert_into_iceberg>
            <allow_introspection_functions>1</allow_introspection_functions>
            <allow_join_right_table_sorting>1</allow_join_right_table_sorting>
            <allow_kafka_offsets_storage_in_keeper>1</allow_kafka_offsets_storage_in_keeper>
            <allow_materialized_view_with_bad_select>1</allow_materialized_view_with_bad_select>
            <allow_non_metadata_alters>1</allow_non_metadata_alters>
            <allow_nonconst_timezone_arguments>1</allow_nonconst_timezone_arguments>
            <allow_nondeterministic_mutations>1</allow_nondeterministic_mutations>
            <allow_nondeterministic_optimize_skip_unused_shards>1</allow_nondeterministic_optimize_skip_unused_shards>
            <allow_nullable_tuple_in_extracted_subcolumns>1</allow_nullable_tuple_in_extracted_subcolumns>
            <allow_rank_dense_rank_arguments>1</allow_rank_dense_rank_arguments>
            <allow_replace_partition_from_empty_source>1</allow_replace_partition_from_empty_source>
            <allow_settings_after_format_in_insert>1</allow_settings_after_format_in_insert>
            <allow_suspicious_codecs>1</allow_suspicious_codecs>
            <allow_suspicious_fixed_string_types>1</allow_suspicious_fixed_string_types>
            <allow_suspicious_indexes>1</allow_suspicious_indexes>
            <allow_suspicious_low_cardinality_types>1</allow_suspicious_low_cardinality_types>
            <allow_suspicious_primary_key>1</allow_suspicious_primary_key>
            <allow_suspicious_ttl_expressions>1</allow_suspicious_ttl_expressions>
            <allow_suspicious_types_in_group_by>1</allow_suspicious_types_in_group_by>
            <allow_suspicious_types_in_order_by>1</allow_suspicious_types_in_order_by>
            <allow_suspicious_variant_types>1</allow_suspicious_variant_types>
            <allow_url_wildcard_from_index_pages>1</allow_url_wildcard_from_index_pages>
            <enable_cleanup_old_data_files_compaction>1</enable_cleanup_old_data_files_compaction>
            <enable_database_hms_catalog>1</enable_database_hms_catalog>
            <enable_database_materialized_postgresql>1</enable_database_materialized_postgresql>
            <enable_database_paimon_rest_catalog>1</enable_database_paimon_rest_catalog>
            <enable_elasticsearch>1</enable_elasticsearch>
            <enable_eval_table_function>1</enable_eval_table_function>
            <enable_full_text_index>1</enable_full_text_index>
            <enable_funnel_functions>1</enable_funnel_functions>
            <enable_gdeflate_codec>1</enable_gdeflate_codec>
            <enable_ipcrypt>1</enable_ipcrypt>
            <enable_json_ast_dialect>1</enable_json_ast_dialect>
            <enable_json_lazy_type_hints>1</enable_json_lazy_type_hints>
            <enable_kusto_dialect>1</enable_kusto_dialect>
            <enable_lateral_join>1</enable_lateral_join>
            <enable_lightweight_delete>1</enable_lightweight_delete>
            <enable_lightweight_update>1</enable_lightweight_update>
            <enable_logsql_dialect>1</enable_logsql_dialect>
            <enable_materialized_cte>1</enable_materialized_cte>
            <enable_materialized_postgresql_table>1</enable_materialized_postgresql_table>
            <enable_object_storage_queue_hive_partitioning>1</enable_object_storage_queue_hive_partitioning>
            <enable_order_by_all>1</enable_order_by_all>
            <enable_paimon_storage_engine>1</enable_paimon_storage_engine>
            <enable_pco_codec>1</enable_pco_codec>
            <enable_polyglot_dialect>1</enable_polyglot_dialect>
            <enable_positional_arguments>1</enable_positional_arguments>
            <enable_prql_dialect>1</enable_prql_dialect>
            <enable_quantized_codec>1</enable_quantized_codec>
            <enable_streaming_queries>1</enable_streaming_queries>
            <enable_subcolumn_codecs>1</enable_subcolumn_codecs>
            <enable_sz3_codec>1</enable_sz3_codec>
            <enable_time_series_aggregate_functions>1</enable_time_series_aggregate_functions>
            <enable_time_series_table>1</enable_time_series_table>
            <enable_time_time64_type>1</enable_time_time64_type>
            <enable_trino_dialect>1</enable_trino_dialect>
            <enable_unique_key>1</enable_unique_key>
            <enable_xgboost>1</enable_xgboost>
            <enable_ytsaurus_dictionary_source>1</enable_ytsaurus_dictionary_source>
            <enable_ytsaurus_table_engine>1</enable_ytsaurus_table_engine>
            <enable_ytsaurus_table_function>1</enable_ytsaurus_table_function>
            <enable_zxc_codec>1</enable_zxc_codec>
            <input_format_parquet_allow_geoparquet_parser>1</input_format_parquet_allow_geoparquet_parser>
            <insert_allow_materialized_columns>1</insert_allow_materialized_columns>
            <parallel_replicas_allow_materialized_views>1</parallel_replicas_allow_materialized_views>
        </default>
    </profiles>
</clickhouse>

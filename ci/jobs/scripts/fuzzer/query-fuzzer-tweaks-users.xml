<clickhouse>
    <profiles>
        <default>
            <max_execution_time>10</max_execution_time>
            <max_memory_usage>10G</max_memory_usage>

            <!--
                Otherwise we will get the TOO_MANY_SIMULTANEOUS_QUERIES errors,
                they are ok, but complicate debugging.
            -->
            <table_function_remote_max_addresses>200</table_function_remote_max_addresses>

            <!--
                Don't let the fuzzer change this setting (I've actually seen it
                do this before).
            -->
            <constraints>
                <max_execution_time>
                    <max>10</max>
                </max_execution_time>

                <max_memory_usage>
                    <max>5G</max>
                </max_memory_usage>

                <table_function_remote_max_addresses>
                    <max>200</max>
                </table_function_remote_max_addresses>

                <!-- Don't waste cycles testing the old interpreter. Spend time in the analyzer instead -->
                <enable_analyzer>
                    <min>1</min>
                </enable_analyzer>

                <!-- Prevent stack overflow -->
                <max_ast_depth>
                    <readonly/>
                </max_ast_depth>

                <!--
                    Time-duration/timeout settings pinned read-only so the fuzzer cannot inflate a
                    timeout/sleep/interval into a multi-minute server wait (lock/socket wait that
                    ignores query cancellation), which the stress-test hung-check flags as a false
                    "possible deadlock".
                -->
                <connect_timeout>
                    <readonly/>
                </connect_timeout>
                <distributed_replica_error_half_life>
                    <readonly/>
                </distributed_replica_error_half_life>
                <http_connection_timeout>
                    <readonly/>
                </http_connection_timeout>
                <http_headers_read_timeout>
                    <readonly/>
                </http_headers_read_timeout>
                <http_receive_timeout>
                    <readonly/>
                </http_receive_timeout>
                <http_send_timeout>
                    <readonly/>
                </http_send_timeout>
                <iceberg_compaction_data_cleanup>
                    <readonly/>
                </iceberg_compaction_data_cleanup>
                <iceberg_compaction_delay_bias>
                    <readonly/>
                </iceberg_compaction_delay_bias>
                <lock_acquire_timeout>
                    <readonly/>
                </lock_acquire_timeout>
                <max_estimated_execution_time>
                    <readonly/>
                </max_estimated_execution_time>
                <max_execution_time_leaf>
                    <readonly/>
                </max_execution_time_leaf>
                <query_cache_ttl>
                    <readonly/>
                </query_cache_ttl>
                <receive_timeout>
                    <readonly/>
                </receive_timeout>
                <send_timeout>
                    <readonly/>
                </send_timeout>
                <tcp_keep_alive_timeout>
                    <readonly/>
                </tcp_keep_alive_timeout>
                <timeout_before_checking_execution_speed>
                    <readonly/>
                </timeout_before_checking_execution_speed>
                <wait_for_async_insert_timeout>
                    <readonly/>
                </wait_for_async_insert_timeout>
                <wait_for_window_view_fire_signal_timeout>
                    <readonly/>
                </wait_for_window_view_fire_signal_timeout>
                <window_view_clean_interval>
                    <readonly/>
                </window_view_clean_interval>
                <window_view_heartbeat_interval>
                    <readonly/>
                </window_view_heartbeat_interval>
                <async_insert_busy_timeout_max_ms>
                    <readonly/>
                </async_insert_busy_timeout_max_ms>
                <async_insert_busy_timeout_min_ms>
                    <readonly/>
                </async_insert_busy_timeout_min_ms>
                <async_insert_poll_timeout_ms>
                    <readonly/>
                </async_insert_poll_timeout_ms>
                <connection_pool_max_wait_ms>
                    <readonly/>
                </connection_pool_max_wait_ms>
                <connect_timeout_with_failover_ms>
                    <readonly/>
                </connect_timeout_with_failover_ms>
                <connect_timeout_with_failover_secure_ms>
                    <readonly/>
                </connect_timeout_with_failover_secure_ms>
                <distributed_background_insert_max_sleep_time_ms>
                    <readonly/>
                </distributed_background_insert_max_sleep_time_ms>
                <distributed_background_insert_sleep_time_ms>
                    <readonly/>
                </distributed_background_insert_sleep_time_ms>
                <handshake_timeout_ms>
                    <readonly/>
                </handshake_timeout_ms>
                <hedged_connection_timeout_ms>
                    <readonly/>
                </hedged_connection_timeout_ms>
                <insert_quorum_timeout>
                    <readonly/>
                </insert_quorum_timeout>
                <kafka_max_wait_ms>
                    <readonly/>
                </kafka_max_wait_ms>
                <log_queries_min_query_duration_ms>
                    <readonly/>
                </log_queries_min_query_duration_ms>
                <low_priority_query_wait_time_ms>
                    <readonly/>
                </low_priority_query_wait_time_ms>
                <parallel_replicas_connect_timeout_ms>
                    <readonly/>
                </parallel_replicas_connect_timeout_ms>
                <query_cache_min_query_duration>
                    <readonly/>
                </query_cache_min_query_duration>
                <queue_max_wait_ms>
                    <readonly/>
                </queue_max_wait_ms>
                <rabbitmq_max_wait_ms>
                    <readonly/>
                </rabbitmq_max_wait_ms>
                <read_backoff_min_interval_between_events_ms>
                    <readonly/>
                </read_backoff_min_interval_between_events_ms>
                <read_backoff_min_latency_ms>
                    <readonly/>
                </read_backoff_min_latency_ms>
                <receive_data_timeout_ms>
                    <readonly/>
                </receive_data_timeout_ms>
                <replace_running_query_max_wait_ms>
                    <readonly/>
                </replace_running_query_max_wait_ms>
                <sleep_after_receiving_query_ms>
                    <readonly/>
                </sleep_after_receiving_query_ms>
                <sleep_in_send_data_ms>
                    <readonly/>
                </sleep_in_send_data_ms>
                <sleep_in_send_tables_status_ms>
                    <readonly/>
                </sleep_in_send_tables_status_ms>
                <storage_system_stack_trace_pipe_read_timeout_ms>
                    <readonly/>
                </storage_system_stack_trace_pipe_read_timeout_ms>
                <stream_flush_interval_ms>
                    <readonly/>
                </stream_flush_interval_ms>
                <stream_poll_timeout_ms>
                    <readonly/>
                </stream_poll_timeout_ms>
                <distributed_background_insert_timeout>
                    <readonly/>
                </distributed_background_insert_timeout>
                <function_sleep_max_microseconds_per_block>
                    <readonly/>
                </function_sleep_max_microseconds_per_block>
                <merge_tree_storage_snapshot_sleep_ms>
                    <readonly/>
                </merge_tree_storage_snapshot_sleep_ms>
                <memory_usage_overcommit_max_wait_microseconds>
                    <readonly/>
                </memory_usage_overcommit_max_wait_microseconds>
                <filesystem_cache_reserve_space_wait_lock_timeout_milliseconds>
                    <readonly/>
                </filesystem_cache_reserve_space_wait_lock_timeout_milliseconds>
                <temporary_data_in_cache_reserve_space_wait_lock_timeout_milliseconds>
                    <readonly/>
                </temporary_data_in_cache_reserve_space_wait_lock_timeout_milliseconds>
                <!--
                    MergeTree table-engine throttle settings.
                -->
                <merge_tree_sleep_before_commit_local_part_in_replicated_table_ms>
                    <readonly/>
                </merge_tree_sleep_before_commit_local_part_in_replicated_table_ms>
                <merge_tree_max_delay_to_insert>
                    <readonly/>
                </merge_tree_max_delay_to_insert>
                <merge_tree_min_delay_to_insert_ms>
                    <readonly/>
                </merge_tree_min_delay_to_insert_ms>
                <merge_tree_max_delay_to_mutate_ms>
                    <readonly/>
                </merge_tree_max_delay_to_mutate_ms>
                <merge_tree_min_delay_to_mutate_ms>
                    <readonly/>
                </merge_tree_min_delay_to_mutate_ms>
            </constraints>

            <!-- Allow all experimental features by default -->
            <ast_fuzzer_runs>5</ast_fuzzer_runs>
            <ast_fuzzer_any_query>true</ast_fuzzer_any_query>

            <allow_create_index_without_type>1</allow_create_index_without_type>

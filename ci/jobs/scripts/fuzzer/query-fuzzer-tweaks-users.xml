            <allow_experimental_delta_kernel_rs>1</allow_experimental_delta_kernel_rs>
            <allow_experimental_delta_lake_writes>1</allow_experimental_delta_lake_writes>
            <allow_experimental_paimon_storage_engine>1</allow_experimental_paimon_storage_engine>
            <allow_experimental_expire_snapshots>1</allow_experimental_expire_snapshots>
            <allow_experimental_funnel_functions>1</allow_experimental_funnel_functions>
            <allow_experimental_geo_types_in_iceberg>1</allow_experimental_geo_types_in_iceberg>
            <allow_experimental_hash_functions>1</allow_experimental_hash_functions>
            <allow_experimental_iceberg_compaction>1</allow_experimental_iceberg_compaction>
            <allow_experimental_join_right_table_sorting>1</allow_experimental_join_right_table_sorting>
            <allow_experimental_json_lazy_type_hints>1</allow_experimental_json_lazy_type_hints>

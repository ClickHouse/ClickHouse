#!/bin/bash
# Pre-fetches Docker images in parallel before integration tests start.
#
# Images that are unavailable for the current architecture (e.g. amd64-only
# images on arm64 runners) are silently skipped rather than failing the job.
#
# Usage:
#   ci/prefetch-integration-test-images IMAGE [IMAGE ...]
#
# Environment variables:
#   PULL_RETRIES   Number of pull attempts per image (default: 3)
#   PULL_TIMEOUT   Per-attempt timeout in seconds (default: 300)
#   PULL_PARALLEL  Images pulled at once (default: 8); 0 means all at once

set -uo pipefail

PULL_RETRIES="${PULL_RETRIES:-3}"
PULL_TIMEOUT="${PULL_TIMEOUT:-300}"
# Bounds the daemon's anon working set, which follows the pulls in flight. The layer page cache it
# also writes through is charged per batch, not per pull, so that is capped on the cgroup instead.
PULL_PARALLEL="${PULL_PARALLEL:-8}"

images=("$@")
if [[ ${#images[@]} -eq 0 ]]; then
    echo "No images to pre-fetch."
    exit 0
fi

if ((PULL_PARALLEL > 0)); then
    echo "Pre-fetching ${#images[@]} Docker image(s), $PULL_PARALLEL at a time:"
else
    echo "Pre-fetching ${#images[@]} Docker image(s) in parallel:"
fi
for img in "${images[@]}"; do
    echo "  $img"
done

work_dir="$(mktemp -d)"
trap 'rm -rf "$work_dir"' EXIT

pull_one()
{
    local image="$1"
    local fail_file="$2"
    local attempt out start elapsed

    for ((attempt = 1; attempt <= PULL_RETRIES; attempt++)); do
        echo "Pulling $image (attempt $attempt/$PULL_RETRIES) ..."
        start=$SECONDS
        if out=$(timeout "$PULL_TIMEOUT" docker pull "$image" 2>&1); then
            elapsed=$((SECONDS - start))
            echo "Pulled $image in ${elapsed}s"
            return 0
        fi
        elapsed=$((SECONDS - start))
        # Arch-specific image — not a real failure on this runner.
        if echo "$out" | grep -q "no matching manifest"; then
            echo "SKIP $image: no manifest for this architecture (${elapsed}s)"
            return 0
        fi
        echo "Pull of $image failed on attempt $attempt (${elapsed}s elapsed):"
        echo "$out"
        if ((attempt < PULL_RETRIES)); then
            sleep 5
        fi
    done

    echo "FAILED to pull $image after $PULL_RETRIES attempt(s)"
    echo "$image" > "$fail_file"
    return 1
}

# Freeing a slot reaps a child, so its exit status is no longer available to a later `wait`:
# every pull records its own outcome on disk, and a missing outcome below is a failure.
# Keyed by index rather than by the image name, which is not injective once sanitized to a
# filename: `foo:bar` and `foo/bar` are distinct references that would share one outcome, so a
# killed pull could read as its namesake's success.
for i in "${!images[@]}"; do
    if ((PULL_PARALLEL > 0)); then
        # `jobs -rp` lists only running children, so this counts pulls in flight.
        while (($(jobs -rp | wc -l) >= PULL_PARALLEL)); do
            wait -n 2>/dev/null || :
        done
    fi
    (
        if pull_one "${images[i]}" "$work_dir/fail_$i"; then
            echo ok > "$work_dir/done_$i"
        else
            echo failed > "$work_dir/done_$i"
        fi
    ) &
done
wait

# Report failures.
failed=()
missing=()
for i in "${!images[@]}"; do
    if [[ -s "$work_dir/fail_$i" ]]; then
        failed+=("${images[i]}")
    elif [[ ! -s "$work_dir/done_$i" ]]; then
        missing+=("${images[i]}")
    fi
done

if [[ ${#failed[@]} -gt 0 ]]; then
    echo "ERROR: Failed to pull the following image(s) after $PULL_RETRIES attempt(s): ${failed[*]}"
    exit 1
fi

if [[ ${#missing[@]} -gt 0 ]]; then
    # A pull left no outcome at all, e.g. its shell was killed. Never a success.
    echo "ERROR: No pull outcome recorded for: ${missing[*]}"
    exit 1
fi

echo "All images pre-fetched successfully."

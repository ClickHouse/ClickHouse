<clickhouse>
    <path from_env="CLICKHOUSE_TEST_DATA_PATH"/>
    <filesystem_caches>
        <docker_relative_cache>
            <max_size>10000000</max_size>
            <max_file_segment_size>2097152</max_file_segment_size>
            <boundary_alignment>2097152</boundary_alignment>
            <path>docker_relative_cache</path>
        </docker_relative_cache>
    </filesystem_caches>
</clickhouse>

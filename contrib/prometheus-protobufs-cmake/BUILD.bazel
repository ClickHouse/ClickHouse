        "@clickhouse_abseil_cpp//:absl_flags_reflection",
        "@clickhouse_abseil_cpp//:absl_graphcycles_internal",
        "@clickhouse_abseil_cpp//:absl_hardening",
        "@clickhouse_abseil_cpp//:absl_hash",
        "@clickhouse_abseil_cpp//:absl_hashtablez_sampler",
        "@clickhouse_abseil_cpp//:absl_int128",
        "@clickhouse_abseil_cpp//:absl_kernel_timeout_internal",
        "@clickhouse_abseil_cpp//:absl_leak_check",
        "@clickhouse_abseil_cpp//:absl_log_globals",

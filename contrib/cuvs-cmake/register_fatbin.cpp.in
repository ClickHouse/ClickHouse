// librtcx's register_fatbin.cpp.in with the class written out: nvcc's front end rejects an alias in the declarator of an
// explicit specialization.
#include "@fatbin_header_file@"
#include <rtcx/fragment_entry.hpp>

@fragment_tag_header_files@

namespace
{

using fragment_tag = @fragment_tag@;

}

template <>
const uint8_t * const rtcx::static_fatbin_fragment_entry<fragment_tag>::data = embedded_fatbin;

template <>
const size_t rtcx::static_fatbin_fragment_entry<fragment_tag>::length = sizeof(embedded_fatbin);

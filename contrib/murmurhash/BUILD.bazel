load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_murmurhash",
    srcs = [
        "src/MurmurHash2.cpp",
        "src/MurmurHash3.cpp",
    ],
    hdrs = [
        "include/MurmurHash2.h",
        "include/MurmurHash3.h",
    ],
    copts = [
        "-w",
        "-std=c++23",
    ],
    includes = ["include"],
    link_runtime = True,
    llvm_headers = True,
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = [
        "@clickhouse_llvm_project//:clang_rt_builtins",
        "//base/glibc-compatibility",
    ],
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
)

cc_library(
    name = "functions_hashing_headers",
    hdrs = glob(["include/*.h"]),
    features = ["-system_include_paths"],
    strip_include_prefix = "include",
    visibility = ["//src/Functions:__pkg__"],
)

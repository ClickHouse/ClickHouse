load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_murmurhash",
    srcs = [
        "src/MurmurHash2.cpp",
        "src/MurmurHash3.cpp",
    ],
    hdrs = glob(["include/*.h"]),
    copts = [
        "-w",
        "-std=c++23",
    ],
    features = ["-system_include_paths"],
    local_defines = CXX_RUNTIME_DEFINES,
    strip_include_prefix = "include",
    deps = [
        "//base/glibc-compatibility",
        "@clickhouse_llvm_project//:unwind",
    ],
)

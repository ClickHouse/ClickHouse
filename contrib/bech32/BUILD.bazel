load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE-MIT",
])

ch_cc_library(
    name = "_bech32",
    srcs = ["src/bech32.cpp"],
    hdrs = glob(["include/*.h"]),
    copts = [
        "-w",
        "-std=c++23",
    ],
    includes = ["include"],
    link_runtime = True,
    local_defines = CXX_RUNTIME_DEFINES,
    local_includes = ["src"],
    deps = [
        "//base/glibc-compatibility",
    ],
)

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "COPYING",
    "include/city.h",
    "include/citycrc.h",
])

ch_cc_library(
    name = "_cityhash",
    srcs = [
        "src/city.cc",
        "src/config.h",
    ],
    hdrs = [
        "include/city.h",
        "include/citycrc.h",
    ],
    additional_compiler_inputs = ["src/city.cc"],
    copts = [
        "-w",
        "-std=c++23",
    ],
    link_runtime = True,
    llvm_headers = True,
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        "../../" + "contrib/cityhash102/include",
        "../../" + "contrib/cityhash102/src",
    ],
    deps = [
        "@clickhouse_llvm_project//:clang_rt_builtins",
        "//base/glibc-compatibility:glibc-compatibility",
    ],
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
)

[profile.release]
debug = false
strip = true
@RUST_RELEASE_PROFILE_EXTRA@

# We use LTO to slightly decrease binary size
[profile.release-thinlto]
inherits = "release"
lto = true

@RUST_DEV_PROFILE@
[profile.dev.package._ch_rust_dwarf]
opt-level = 2
[profile.dev.package.gimli]
opt-level = 2
[profile.dev.package.object]
opt-level = 2
[profile.dev.package.memchr]
opt-level = 2
[source.vendored-sources]
directory = "@RUST_VENDOR_DIR@"

[source.crates-io]
registry = 'sparse+https://index.crates.io/'
replace-with = 'vendored-sources'

# chdig
[source."git+https://github.com/azat-rust/clickhouse-rs?branch=next"]
git = "https://github.com/azat-rust/clickhouse-rs"
branch = "next"
replace-with = "vendored-sources"
[source."git+https://github.com/azat-rust/flamelens?branch=chdig"]
git = "https://github.com/azat-rust/flamelens"
branch = "chdig"
replace-with = "vendored-sources"

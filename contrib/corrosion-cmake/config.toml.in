@RUST_BUILD_DIR_CONFIG@
[profile.release]
debug = false
strip = true
@RUST_TRIM_PATHS@
@RUST_RELEASE_PROFILE_EXTRA@

# We use LTO to slightly decrease binary size
[profile.release-thinlto]
inherits = "release"
lto = "thin"

[profile.dev]
@RUST_TRIM_PATHS@
@RUST_DEV_PROFILE@
# Features are resolved once for all members of the workspace in `contrib/Cargo.toml`,
# so a crate that several members use is compiled once.
[unstable]
feature-unification = true
@RUST_UNSTABLE_TRIM_PATHS@

[resolver]
feature-unification = "workspace"

[source.vendored-sources]
directory = "@RUST_VENDOR_DIR@"

[source.crates-io]
registry = 'sparse+https://index.crates.io/'
replace-with = 'vendored-sources'

# arrow-rs
[source."git+https://github.com/ClickHouse/arrow-rs?branch=ClickHouse/58.4.1"]
git = "https://github.com/ClickHouse/arrow-rs"
branch = "ClickHouse/58.4.1"
replace-with = "vendored-sources"
# ipnet
[source."git+https://github.com/ClickHouse/ipnet?branch=ClickHouse/2.12.2"]
git = "https://github.com/ClickHouse/ipnet"
branch = "ClickHouse/2.12.2"
replace-with = "vendored-sources"
# chdig
[source."git+https://github.com/azat-rust/clickhouse-rs?branch=next"]
git = "https://github.com/azat-rust/clickhouse-rs"
branch = "next"
replace-with = "vendored-sources"
[source."git+https://github.com/azat-rust/flamelens?branch=chdig"]
git = "https://github.com/azat-rust/flamelens"
branch = "chdig"
replace-with = "vendored-sources"

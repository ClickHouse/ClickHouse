load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

cc_library(
    name = "headers",
    hdrs = select({
        ":linux_x86_64": [
            "linux_x86_64/include/lber_types.h",
            "linux_x86_64/include/ldap_features.h",
        ],
        ":linux_aarch64": [
            "linux_aarch64/include/lber_types.h",
            "linux_aarch64/include/ldap_features.h",
        ],
    }),
    includes = select({
        ":linux_x86_64": ["linux_x86_64/include"],
        ":linux_aarch64": ["linux_aarch64/include"],
    }),
    deps = ["@clickhouse_openldap//:_config_support"],
)

# Both C libraries include portable.h before using SIZEOF_* or HAVE_*.
cc_library(
    name = "private_config",
    hdrs = select({
        ":linux_x86_64": [
            "linux_x86_64/include/ldap_config.h",
            "linux_x86_64/include/portable.h",
        ],
        ":linux_aarch64": [
            "linux_aarch64/include/ldap_config.h",
            "linux_aarch64/include/portable.h",
        ],
    }),
    includes = select({
        ":linux_x86_64": ["linux_x86_64/include"],
        ":linux_aarch64": ["linux_aarch64/include"],
    }),
    # portable.h sets HAVE_*, FD_SETSIZE, LDAP_DEBUG and LDAP_LOCALIZE
    # before including these fragments. They are checked in that context.
    textual_hdrs = [
        "@clickhouse_openldap//:include/ac/assert.h",
        "@clickhouse_openldap//:include/ac/fdset.h",
        "@clickhouse_openldap//:include/ac/localize.h",
    ],
    deps = [
        ":headers",
        "@clickhouse_openldap//:_config_support",
    ],
)

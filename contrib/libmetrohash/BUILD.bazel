load("@clickhouse//bazel/rules:ch_cc_library.bzl", "CXX_RUNTIME_DEFINES", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_metrohash",
    srcs = [
        "src/metrohash64.cpp",
        "src/metrohash128.cpp",
        "src/platform.h",
    ],
    hdrs = glob(["src/metrohash*.h"]),
    copts = [
        "-w",
        "-std=c++23",
    ],
    includes = ["src"],
    local_defines = CXX_RUNTIME_DEFINES,
)

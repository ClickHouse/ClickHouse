load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
])

ch_cc_library(
    name = "_metrohash",
    srcs = [
        "src/metrohash64.cpp",
        "src/metrohash128.cpp",
        "src/platform.h",
    ],
    hdrs = glob(["src/metrohash*.h"]),
    copts = [
        "-w",
        "-std=c++23",
    ],
    includes = ["src"],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = [
        "//base/glibc-compatibility",
        "@clickhouse_llvm_project//:unwind",
    ],
)

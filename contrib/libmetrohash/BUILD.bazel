load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
    "src/metrohash.h",
    "src/metrohash128.h",
    "src/metrohash128crc.h",
    "src/metrohash64.h",
    "src/platform.h",
    "src/testvector.h",
])

ch_cc_library(
    name = "_metrohash",
    srcs = [
        "src/metrohash64.cpp",
        "src/metrohash128.cpp",
    ],
    hdrs = [
        "src/metrohash.h",
        "src/metrohash128.h",
        "src/metrohash128crc.h",
        "src/metrohash64.h",
        "src/platform.h",
        "src/testvector.h",
    ],
    additional_compiler_inputs = [
        "src/metrohash64.cpp",
        "src/metrohash128.cpp",
    ],
    copts = [
        "-w",
        "-std=c++23",
        "-I",
        "contrib/libmetrohash/src",
    ],
    local_defines = [
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    deps = [
        "@llvm-project//compiler-rt:headers",
        "@llvm-project//libc:libc_headers",
        "@llvm-project//libunwind:headers",
        "@clickhouse_llvm_project//:clang_rt_builtins",
        "@clickhouse_llvm_project//:cxx",
        "@clickhouse_llvm_project//:cxxabi",
        "//base/glibc-compatibility:glibc-compatibility",
        "@clickhouse_llvm_project//:unwind",
    ],
    alwayslink = False,
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
    textual_hdrs = [],
)

    clickhouse_code = True,
    implementation_deps = [
        "//src:core_types",
        "@clickhouse_rapidjson//:rapidjson",
        "//src/Common/Config:clickhouse_common_config",
        "//base:common",
        "//base:pcg_random",
        "//base/poco/Foundation:_poco_foundation",
        "//base/poco/Net:_poco_net",
        "//base/poco/Util:_poco_util",
        "@clickhouse_boost//:boost_headers",
        "@clickhouse_fmtlib//:_fmt",
        "//src/Common",
        "//src/AggregateFunctions:clickhouse_aggregate_functions__compile_0",
        "//src/Common/ZooKeeper:headers",
        "//src/Common/ZooKeeper:clickhouse_common_zookeeper_base",
        "//src/Dictionaries:clickhouse_dictionaries",
    ],
    link_runtime = True,
    local_defines = CLICKHOUSE_PROGRAM_COMPRESSION_DEFINES,
    local_includes = [
        ".",
        "../../" + "bazel/gen",
    ],
    source_headers = True,

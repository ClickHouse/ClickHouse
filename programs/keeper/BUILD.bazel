    srcs = [
        "keeper_main.cpp",
        "//bazel:gen/embedded/programs/keeper/Keeper.cpp",
    ] + glob(["**/*.h"]),
    additional_compiler_inputs = ["//bazel:gen/embedded/programs/keeper/keeper_embedded.xml"],
    clickhouse_code = True,
    implementation_deps = [
        "//bazel:clickhouse_config_headers",
        "//base/poco/Foundation:_poco_foundation",
        "//base/poco/Net:_poco_net",
        "//base/poco/NetSSL_OpenSSL:_poco_net_ssl__compile_0",
        "//base/poco/Util:_poco_util",
        "//src/Common",
        "@clickhouse_fmtlib//:_fmt",
        "//src/Common/ZooKeeper:clickhouse_common_zookeeper_base",
        "//src/Common/Config:clickhouse_common_config",
        "//src:clickhouse_common_io__compile_0",
        "//base:common",
        "//src/Daemon:headers",
        "//programs/keeper-client:clickhouse-keeper-client-lib",
        "//programs/keeper-converter:clickhouse-keeper-converter-lib",
        "//src/Common:exception_api",
        "//src:dbms__compile_0",
        "//src/Common:string_utils",
        "//src:headers",
        "//src/Common:parser_support_api",
        "//src:core_defines",
    ],
    link_runtime = True,
    local_defines = CLICKHOUSE_PROGRAM_COMPRESSION_DEFINES,
    local_includes = [
        ".",

load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//programs:program_defines.bzl", "CLICKHOUSE_PROGRAM_COMPRESSION_DEFINES")

package(default_visibility = ["//visibility:public"])


load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//programs:program_defines.bzl", "CLICKHOUSE_PROGRAM_COMPRESSION_DEFINES")

package(default_visibility = ["//visibility:public"])

ch_cc_library(
    name = "clickhouse-client-lib",
    srcs = [
        "Client.cpp",
        "FuzzLoop.cpp",
    ] + glob(["**/*.h"]),
    clickhouse_code = True,
    implementation_deps = [
        "//bazel:clickhouse_config_headers",
        "//base/poco/Foundation:_poco_foundation",
        "//base/poco/Util:_poco_util",
        "//src/Common",
        "//src/Common/Config:clickhouse_common_config",
        "//base:common",
        "@clickhouse_boost//:boost_headers",
        "//src/AggregateFunctions:clickhouse_aggregate_functions__compile_0",
        "//src/Functions:clickhouse_functions_obj__compile_0",
        "//src/Parsers:clickhouse_parsers",
    ],
    link_runtime = True,
    local_defines = CLICKHOUSE_PROGRAM_COMPRESSION_DEFINES,
    local_includes = [
        ".",
        "../../" + "bazel/gen",
    ],
    source_headers = True,
    deps = [
        "//src/AggregateFunctions:clickhouse_aggregate_functions",
        "//src/Dictionaries:clickhouse_dictionaries",
    ],
)

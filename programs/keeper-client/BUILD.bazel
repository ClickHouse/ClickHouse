load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//programs:program_defines.bzl", "CLICKHOUSE_PROGRAM_DEFINES")

package(default_visibility = ["//visibility:public"])

ch_cc_library(
    name = "clickhouse-keeper-client-lib",
    srcs = [
        "KeeperClient.cpp",
    ] + glob(["**/*.h"]),
    clickhouse_code = True,
    implementation_deps = [
        "//base/poco/NetSSL_OpenSSL:_poco_net_ssl__compile_0",
        "//base/poco/Util:_poco_util",
        "//src/Common",
        "//src/Common/Config:clickhouse_common_config",
        "//src/Common/ZooKeeper:headers",
        "//src/Parsers:clickhouse_parsers",
        "//src/Common/Config:config_processor_api",
        "//src:dbms",
    ],
    link_runtime = True,
    local_defines = CLICKHOUSE_PROGRAM_DEFINES,
    local_includes = [
        ".",
        "../../" + "bazel/gen",
    ],
    source_headers = True,
)

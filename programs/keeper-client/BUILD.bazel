load("@clickhouse//bazel/rules:ch_cc_library.bzl", "ch_cc_library")
load("@clickhouse//bazel/rules:repository_paths.bzl", "repository_path")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

ch_cc_library(
    name = "clickhouse-keeper-client-lib",
    srcs = [
        "KeeperClient.cpp",
    ],
    clickhouse_code = True,
    copts = [
        "-I",
        "$(GENDIR)/bazel/gen/includes/configs",
        "-I",
    ] + select({
        "@platforms//cpu:x86_64": ["$(GENDIR)/bazel/gen/src"],
        "@platforms//cpu:aarch64": ["$(GENDIR)/bazel/gen/src"],
    }) + [
        "-I",
        repository_path("contrib/libfiu") + "/libfiu",
        "-I",
        "$(GENDIR)/" + repository_path("contrib/libssh") + "/config/contrib/libssh/include",
        "-I",
        repository_path("contrib/libarchive") + "/libarchive",
        "-I",
        "rust/workspace/pco/include",
        "-I",
        "rust/workspace/skim/include",
        "-I",
        "$(GENDIR)/" + repository_path("contrib/arrow") + "/config/contrib/arrow-cmake/cpp/src",
        "-I",
        "$(GENDIR)/bazel/gen/contrib/arrow-cmake/cpp/src",
    ],
    link_runtime = True,
    local_defines = [
        "AI_SDK_HAS_ANTHROPIC=1",
        "AI_SDK_HAS_OPENAI=1",
    ] + select({
        "@platforms//cpu:x86_64": [
            "ARROW_HAVE_AVX2",
            "ARROW_HAVE_BMI2",
            "ARROW_HAVE_RUNTIME_AVX2",
            "ARROW_HAVE_RUNTIME_BMI2",
            "ARROW_HAVE_RUNTIME_SSE4_2",
            "ARROW_HAVE_SSE4_2",
        ],
        "@platforms//cpu:aarch64": [
            "ARM_ACLE",
            "ARM_ASM_HWCAP",
            "ARM_AUXV_HAS_CRC32",
            "ARM_AUXV_HAS_NEON",
            "ARM_FEATURES",
            "ARM_NEON",
            "ARM_NEON_HASLD4",
            "ARROW_HAVE_NEON",
        ],
    }) + [
        "BOOST_ASIO_HAS_STD_INVOKE_RESULT=1",
        "BOOST_ASIO_STANDALONE=1",
        "BOOST_TIMER_ENABLE_DEPRECATED=1",
        "ENABLE_DISTRIBUTED_CACHE=0",
        "FIU_ENABLE",
    ] + select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            "HAVE_ARM_ACLE_H",
        ],
    }) + [
        "HAVE_ATTRIBUTE_ALIGNED",
        "HAVE_BUILTIN_CTZ",
        "HAVE_BUILTIN_CTZLL",
        "HAVE_CONFIG_H",
        "HAVE_POSIX_MEMALIGN",
    ] + select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [
            "HAVE_SYS_AUXV_H",
        ],
    }) + [
        "HAVE_VISIBILITY_HIDDEN",
        "HAVE_VISIBILITY_INTERNAL",
        "JEMALLOC_NO_RENAME",
        "PICOJSON_USE_LOCALE=0",
        "POCO_ENABLE_CPP11",
        "POCO_OS_FAMILY_UNIX",
        "SIMSIMD_DYNAMIC_DISPATCH",
        "SIMSIMD_NATIVE_BF16=0",
        "STD_EXCEPTION_HAS_STACK_TRACE=1",
        "UNALIGNED_OK",
        "USEARCH_CAN_COMPILE_BF16=0",
        "USEARCH_CAN_COMPILE_FLOAT16",
        "USEARCH_USE_FP16LIB",
        "USEARCH_USE_SIMSIMD",
        "USE_CLICKHOUSE_THREADS=1",
        "WITH_COVERAGE=0",
        "WITH_COVERAGE_DEPTH=0",
        "WITH_GZFILEOP",
        "X86_64",
    ] + select({
        "@platforms//cpu:x86_64": [
            "X86_AVX2",
            "X86_FEATURES",
            "X86_PCLMULQDQ_CRC",
            "X86_SSE2",
            "X86_SSE42",
            "X86_SSSE3",
        ],
        "@platforms//cpu:aarch64": [],
    }) + [
        "ZLIB_COMPAT",
        "_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES=1",
        "_LIBUNWIND_IS_NATIVE_ONLY",
    ],
    local_includes = [
        ".",
        "../../bazel/gen/base",
        "../../" + (repository_path("contrib/orc") + "/config/contrib/orc/c++/include"),
        "../../" + (repository_path("contrib/librdkafka") + "/config/contrib/librdkafka-cmake"),
        "../../" + (repository_path("contrib/mongo-c-driver") + "/config/contrib/mongo-c-driver/src/libmongoc/src"),
        "../../" + (repository_path("contrib/mongo-cxx-driver") + "/src/bsoncxx/lib/bsoncxx/v_noabi"),
        "../../" + (repository_path("contrib/mongo-cxx-driver") + "/config/contrib/mongo-cxx-driver/src/bsoncxx/lib"),
        "../../" + (repository_path("contrib/mongo-cxx-driver") + "/config/contrib/mongo-cxx-driver/src/bsoncxx/lib/bsoncxx/v_noabi"),
        "../../" + (repository_path("contrib/mongo-cxx-driver") + "/config/contrib/mongo-cxx-driver/src/mongocxx/lib"),
        "../../" + (repository_path("contrib/mongo-cxx-driver") + "/config/contrib/mongo-cxx-driver/src/mongocxx/lib/mongocxx/v_noabi"),
        "../../" + (repository_path("contrib/mariadb-connector-c") + "/config/contrib/mariadb-connector-c-cmake/include-public"),
        "../../" + "bazel/gen/src/Server/grpc_protos",
        "../../" + "contrib/s2geometry-cmake",
        "../../" + (repository_path("contrib/libpqxx") + "/config/contrib/libpqxx-cmake"),
        "../../" + "bazel/gen/contrib/prometheus-protobufs-cmake",
        "../../" + repository_path("contrib/google-cloud-cpp"),
        "../../" + (repository_path("contrib/google-cloud-cpp") + "/config/contrib/google-cloud-cpp-cmake"),
        "../../" + "bazel/gen/contrib/google-cloud-cpp-cmake",
        "../../" + (repository_path("contrib/grpc") + "/spm-cpp-include"),
        "../../" + "bazel/gen",
        "../../" + "bazel/gen/contrib/flatbuffers",
        "../../" + (repository_path("contrib/llvm-project") + "/llvm/include"),
    ],
    deps = [
        "@llvm-project//third-party/siphash:siphash",
        "//src:dbms",
    ],
)

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
)

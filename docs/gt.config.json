{
  "framework": "mintlify",
  "options": {
    "experimentalClearLocaleDirs": true,
    "skipFileValidation": {
      "mdx": true
    },
    "mintlify": {
      "inferTitleFromFilename": true,
      "openapi": {
        "files": [
          "./ar/_specs/cloud-openapi.json",
          "./ar/_specs/hyperdx-openapi.json",
          "./es/_specs/cloud-openapi.json",
          "./es/_specs/hyperdx-openapi.json",
          "./fr/_specs/cloud-openapi.json",
          "./fr/_specs/hyperdx-openapi.json",
          "./ja/_specs/cloud-openapi.json",
          "./ja/_specs/hyperdx-openapi.json",
          "./ko/_specs/cloud-openapi.json",
          "./ko/_specs/hyperdx-openapi.json",
          "./pt-BR/_specs/cloud-openapi.json",
          "./pt-BR/_specs/hyperdx-openapi.json",
          "./ru/_specs/cloud-openapi.json",
          "./ru/_specs/hyperdx-openapi.json",
          "./zh/_specs/cloud-openapi.json",
          "./zh/_specs/hyperdx-openapi.json"
        ]
      }
    },
    "jsonSchema": {
      "./docs.json": {
        "preset": "mintlify-hide-default"
      },
      "./ar/_specs/cloud-openapi.json": {
        "preset": "openapi"
      },
      "./ar/_specs/hyperdx-openapi.json": {
        "preset": "openapi"
      },
      "./es/_specs/cloud-openapi.json": {
        "preset": "openapi"
      },
      "./es/_specs/hyperdx-openapi.json": {
        "preset": "openapi"
      },
      "./fr/_specs/cloud-openapi.json": {
        "preset": "openapi"
      },
      "./fr/_specs/hyperdx-openapi.json": {
        "preset": "openapi"
      },
      "./ja/_specs/cloud-openapi.json": {
        "preset": "openapi"
      },
      "./ja/_specs/hyperdx-openapi.json": {
        "preset": "openapi"
      },
      "./ko/_specs/cloud-openapi.json": {
        "preset": "openapi"
      },
      "./ko/_specs/hyperdx-openapi.json": {
        "preset": "openapi"
      },
      "./pt-BR/_specs/cloud-openapi.json": {
        "preset": "openapi"
      },
      "./pt-BR/_specs/hyperdx-openapi.json": {
        "preset": "openapi"
      },
      "./ru/_specs/cloud-openapi.json": {
        "preset": "openapi"
      },
      "./ru/_specs/hyperdx-openapi.json": {
        "preset": "openapi"
      },
      "./zh/_specs/cloud-openapi.json": {
        "preset": "openapi"
      },
      "./zh/_specs/hyperdx-openapi.json": {
        "preset": "openapi"
      }
    },
    "docsUrlPattern": "/[locale]",
    "docsImportPattern": "/snippets/[locale]",
    "generateRedirects": "./docs.json",
    "experimentalLocalizeStaticImports": true,
    "experimentalLocalizeStaticUrls": true,
    "experimentalLocalizeRelativeAssets": true,
    "docsHideDefaultLocaleImport": true,
    "experimentalHideDefaultLocale": true,
    "experimentalAddHeaderAnchorIds": "mintlify"
  },
  "files": {
    "json": {
      "include": [
        "./docs.json",
        "./ar/_specs/cloud-openapi.json",
        "./ar/_specs/hyperdx-openapi.json",
        "./es/_specs/cloud-openapi.json",
        "./es/_specs/hyperdx-openapi.json",
        "./fr/_specs/cloud-openapi.json",
        "./fr/_specs/hyperdx-openapi.json",
        "./ja/_specs/cloud-openapi.json",
        "./ja/_specs/hyperdx-openapi.json",
        "./ko/_specs/cloud-openapi.json",
        "./ko/_specs/hyperdx-openapi.json",
        "./pt-BR/_specs/cloud-openapi.json",
        "./pt-BR/_specs/hyperdx-openapi.json",
        "./ru/_specs/cloud-openapi.json",
        "./ru/_specs/hyperdx-openapi.json",
        "./zh/_specs/cloud-openapi.json",
        "./zh/_specs/hyperdx-openapi.json"
      ],
      "transform": [
        {
          "match": "^ar/_specs/cloud-openapi.json$",
          "replace": "{locale}/ar/_specs/cloud-openapi.json"
        },
        {
          "match": "^ar/_specs/hyperdx-openapi.json$",
          "replace": "{locale}/ar/_specs/hyperdx-openapi.json"
        },
        {
          "match": "^es/_specs/cloud-openapi.json$",
          "replace": "{locale}/es/_specs/cloud-openapi.json"
        },
        {
          "match": "^es/_specs/hyperdx-openapi.json$",
          "replace": "{locale}/es/_specs/hyperdx-openapi.json"
        },
        {
          "match": "^fr/_specs/cloud-openapi.json$",
          "replace": "{locale}/fr/_specs/cloud-openapi.json"
        },
        {
          "match": "^fr/_specs/hyperdx-openapi.json$",
          "replace": "{locale}/fr/_specs/hyperdx-openapi.json"
        },
        {
          "match": "^ja/_specs/cloud-openapi.json$",
          "replace": "{locale}/ja/_specs/cloud-openapi.json"
        },
        {
          "match": "^ja/_specs/hyperdx-openapi.json$",
          "replace": "{locale}/ja/_specs/hyperdx-openapi.json"
        },
        {
          "match": "^ko/_specs/cloud-openapi.json$",
          "replace": "{locale}/ko/_specs/cloud-openapi.json"
        },
        {
          "match": "^ko/_specs/hyperdx-openapi.json$",
          "replace": "{locale}/ko/_specs/hyperdx-openapi.json"
        },
        {
          "match": "^pt-BR/_specs/cloud-openapi.json$",
          "replace": "{locale}/pt-BR/_specs/cloud-openapi.json"
        },
        {
          "match": "^pt-BR/_specs/hyperdx-openapi.json$",
          "replace": "{locale}/pt-BR/_specs/hyperdx-openapi.json"
        },
        {
          "match": "^ru/_specs/cloud-openapi.json$",
          "replace": "{locale}/ru/_specs/cloud-openapi.json"
        },
        {
          "match": "^ru/_specs/hyperdx-openapi.json$",
          "replace": "{locale}/ru/_specs/hyperdx-openapi.json"
        },
        {
          "match": "^zh/_specs/cloud-openapi.json$",
          "replace": "{locale}/zh/_specs/cloud-openapi.json"
        },
        {
          "match": "^zh/_specs/hyperdx-openapi.json$",
          "replace": "{locale}/zh/_specs/hyperdx-openapi.json"
        }
      ]
    },
    "js": {
      "include": [
        "./snippets/**/*.jsx",
        "./snippets/**/*.js"
      ],
      "exclude": [
        "./snippets/[locales]/**/*.jsx",
        "./snippets/[locales]/**/*.js"
      ],
      "transform": {
        "match": "^(snippets/)?(.*)$",
        "replace": "$1{locale}/$2"
      }
    },
    "mdx": {
      "include": [
        "./**/*.mdx",
        "./**/*.md"
      ],
      "transform": {
        "match": "^(snippets/)?(.*)$",
        "replace": "$1{locale}/$2"
      },
      "exclude": [
        "./[locales]/**/*.mdx",
        "./snippets/[locales]/**/*.mdx",
        "./[locales]/**/*.md",
        "./snippets/[locales]/**/*.md",
        "./**/_TEMPLATE.mdx",
        "./**/_TEMPLATE.md",
        "./**/README.md",
        "./**/LICENSE.md",
        "./**/COPYING.md",
        "./**/NOTICE.md",
        "./**/CHANGELOG.md",
        "./**/HISTORY.md",
        "./**/CODE_OF_CONDUCT.md",
        "./**/CONTRIBUTING.md",
        "./**/SECURITY.md",
        "./**/GOVERNANCE.md",
        "./**/AGENTS.md",
        "./**/OWNERS.md",
        "./**/MAINTAINERS.md",
        "./_description_templates/**/*.md",
        "./_description_templates/**/*.mdx",
        "./_includes/**/*.md",
        "./_includes/**/*.mdx",
        "./changelogs/**/*.md",
        "./changelogs/**/*.mdx",
        "./en/**/*.md",
        "./en/**/*.mdx"
      ]
    }
  },
  "locales": [
    "en",
    "es",
    "ja",
    "ko",
    "pt-BR",
    "ru",
    "zh",
    "ar",
    "fr"
  ],
  "defaultLocale": "en",
  "$schema": "https://assets.gtx.dev/config-schema.json"
}
---
/**
 * ApiMethodChip — the method indicator for an API operation. Colours come from
 * the shared `--nb-m-*` palette (`globals.css`); the variant key comes from
 * `methodVariant` (`./method`), shared across the sidebar, endpoint card, and
 * code rail so they can never disagree on a method's colour.
 *
 * `display` selects the presentation:
 *   - "glyph" — direction arrow only, in a 20×20 square (code rail, card).
 *   - "label" — the verb word only (sidebar).
 *
 * `decorative` (glyph only) drops the `role="img"`/`aria-label` and marks the
 * arrow `aria-hidden` — for when a visible verb word sits beside it (endpoint
 * card header) and should own the accessible name instead, avoiding a
 * double-announce.
 *
 * Label chips share one uniform width (`--nb-api-verb`, sized to the widest
 * verb) so operation rows align into a clean column; long verbs are abbreviated
 * to stay inside it. The full verb is preserved as the accessible name. POST,
 * PUT, and PATCH intentionally share one "write" arrow (PATCH folds to PUT's
 * colour) — the word disambiguates them everywhere except the glyph rail, which
 * sits beside a labelled endpoint card.
 *
 * Renders nothing for a missing/blank method.
 */
import { methodVariant } from "./method";

interface Props {
  method?: string;
  display?: "glyph" | "label";
  size?: "sm" | "md";
  decorative?: boolean;
}

const { method, display = "glyph", size = "sm", decorative = false } = Astro.props;
const verb = method?.toLowerCase();
const name = verb?.toUpperCase();
const variant = methodVariant(method);

const abbr: Record<string, string> = { delete: "DEL", options: "OPT", connect: "CONN" };
const label = verb ? (abbr[verb] ?? verb.toUpperCase()) : undefined;

const S = `width:1.4em;height:1.4em;flex:none`;
const A = `viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="${S}" aria-hidden="true"`;
const glyphs: Record<string, string> = {
  get: `<svg ${A}><path d="M17 7 7 17"/><path d="M17 17H7V7"/></svg>`,
  post: `<svg ${A}><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>`,
  put: `<svg ${A}><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>`,
  delete: `<svg ${A}><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>`,
  other: `<svg viewBox="0 0 24 24" fill="currentColor" stroke="none" style="${S}" aria-hidden="true"><circle cx="12" cy="12" r="3.25"/></svg>`,
};
---

{
  variant &&
    (display === "glyph" ? (
      <span
        class:list={["nb-api-chip", `nb-api-chip--${variant}`, "is-glyph", `is-${size}`]}
        role={decorative ? undefined : "img"}
        aria-label={decorative ? undefined : name}
        aria-hidden={decorative ? "true" : undefined}
      >
        <Fragment set:html={glyphs[variant]} />
      </span>
    ) : (
      <span class:list={["nb-api-chip", `nb-api-chip--${variant}`, "is-label", `is-${size}`]}>
        <span class="nb-api-chip__label">{label}</span>
      </span>
    ))
}

<style>
  .nb-api-chip {
    --nb-api-verb: 5ch;
    font-size: 0.625rem;
    box-sizing: border-box;
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    height: 2em;
    border: 1px solid color-mix(in oklab, var(--m) 24%, transparent);
    border-radius: 0.4em;
    background-color: color-mix(in oklab, var(--m) 14%, transparent);
    color: var(--m);
    font-family: var(--nb-font-mono, ui-monospace, monospace);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    -webkit-font-smoothing: antialiased;
  }
  .nb-api-chip.is-md {
    font-size: 0.8125rem;
  }
  .nb-api-chip__label {
    display: inline-block;
    padding-top: 0.1em;
    padding-left: 0.02em;
  }
  .nb-api-chip svg {
    width: 1.4em;
    height: 1.4em;
    flex: none;
  }
  .nb-api-chip.is-glyph {
    width: 2em;
  }
  .nb-api-chip.is-label {
    width: calc(var(--nb-api-verb) + 0.5em);
  }

  .nb-api-chip--get {
    --m: var(--nb-m-get);
  }
  .nb-api-chip--post {
    --m: var(--nb-m-post);
  }
  .nb-api-chip--put {
    --m: var(--nb-m-put);
  }
  .nb-api-chip--delete {
    --m: var(--nb-m-delete);
  }
  .nb-api-chip--other {
    --m: var(--nb-m-other);
  }
</style>

---
/** Button that opens the search dialog. Cmd+K on macOS, Ctrl+K elsewhere. */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  /** Compact Mintlify-style control for the desktop and mobile sidebar. */
  sidebar?: boolean;
}

const { class: className, sidebar = false, ...attrs } = Astro.props;
---

<button
  data-search-trigger
  data-sidebar-tool={sidebar ? "" : undefined}
  type="button"
  class={cn(
    sidebar
      ? "group/search flex h-9 w-full min-w-0 items-center justify-between gap-2 truncate rounded border border-border bg-card px-3.5 text-sm leading-6 text-muted-foreground transition-colors hover:border-border-strong hover:text-foreground"
      : "flex items-center gap-2 rounded-md border border-border bg-card p-2 text-sm text-muted-foreground transition-colors hover:border-border-strong hover:text-foreground sm:px-2.5 sm:py-1.5",
    className,
  )}
  aria-label="Search documentation"
  aria-keyshortcuts="Control+K"
  {...attrs}
>
  <span class="flex min-w-0 items-center gap-2">
    <Icon name="ph:magnifying-glass" class="h-4 w-4 min-w-4 shrink-0" />
    <span class:list={[sidebar ? "min-w-0 truncate" : "hidden md:inline"]}>{sidebar ? "Search…" : "Search"}</span>
  </span>
  <kbd class:list={[
    "items-center gap-0.5 text-muted-foreground",
    sidebar
      ? "inline-flex shrink-0 p-0 text-xs font-semibold"
      : "hidden sm:inline-flex rounded border border-border bg-muted px-1.5 py-0.5 text-[0.625rem] font-medium",
  ]}>
    <span data-shortcut-key>Ctrl</span>K
  </kbd>
</button>

<script>
  import "./search-trigger.client";
</script>

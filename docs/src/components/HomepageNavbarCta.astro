---
const signInUrl = "https://console.clickhouse.cloud/signIn?loc=docs-nav-signIn-cta";
const signUpUrl = "https://clickhouse.cloud/signUp?loc=docs-nav-signUp-cta";
---

<div class="ch-navbar-cta">
  <a
    href="https://github.com/ClickHouse/ClickHouse"
    target="_blank"
    rel="noopener"
    class="ch-gh-stars"
    aria-label="ClickHouse on GitHub"
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M8 1.75C4.27 1.75 1.25 4.77 1.25 8.5c0 2.99 1.93 5.51 4.62 6.4.34.06.46-.14.46-.32 0-.16-.01-.69-.01-1.26-1.7.32-2.14-.6-2.27-.98-.08-.19-.41-.79-.7-.95-.24-.13-.58-.44-.01-.45.53-.01.91.49 1.04.69.61 1.02 1.58.73 1.97.56.06-.44.24-.74.43-.91-1.5-.17-3.07-.75-3.07-3.33 0-.73.26-1.34.69-1.81-.07-.17-.3-.86.07-1.79 0 0 .57-.18 1.86.69.54-.15 1.11-.23 1.69-.23.57 0 1.14.08 1.68.23 1.29-.88 1.86-.69 1.86-.69.37.93.14 1.62.07 1.79.43.47.69 1.07.69 1.81 0 2.59-1.58 3.16-3.08 3.33.25.21.46.62.46 1.25 0 .9-.01 1.63-.01 1.86 0 .18.13.39.47.32 2.67-.9 4.58-3.41 4.58-6.4 0-3.73-3.02-6.75-6.75-6.75Z"
        fill="currentColor"
      />
    </svg>
    <span data-home-github-stars>49.6k</span>
  </a>
  <a href={signInUrl} class="ch-sign-in" target="_blank" rel="noopener">
    Sign in
  </a>
  <a
    href={signUpUrl}
    class="ch-cta-btn"
    target="_blank"
    rel="noopener"
    data-galaxy-event="docs.navbar.get-started"
    data-galaxy-prop-href={signUpUrl}
  >
    Get Started
  </a>
</div>

<script>
  function formatStars(count: number) {
    return count >= 1000 ? `${(count / 1000).toFixed(1).replace(/\.0$/, "")}k` : String(count);
  }

  async function updateStars() {
    const targets = document.querySelectorAll<HTMLElement>("[data-home-github-stars]");
    if (!targets.length) return;
    try {
      const response = await fetch("https://api.github.com/repos/ClickHouse/ClickHouse");
      if (!response.ok) return;
      const data = await response.json() as { stargazers_count?: number };
      if (typeof data.stargazers_count !== "number") return;
      const label = formatStars(data.stargazers_count);
      targets.forEach((target) => { target.textContent = label; });
    } catch {
      // Keep the source-compatible fallback value when the public request fails.
    }
  }

  updateStars();
  document.addEventListener("astro:page-load", updateStars);
</script>

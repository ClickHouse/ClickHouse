#!/usr/bin/env python3
"""Generate system-table documentation from a ClickHouse binary.

Queries system.documentation and system.tables via clickhouse-local, then
generates/updates Markdown documentation files. The C++ registration provides
the description, examples and related material; system.documentation combines
those parts with the live column schema into a consistently structured page.

Usage:
    python3 utils/generate-system-tables-docs --binary ./build/programs/clickhouse --docs-dir docs/reference/system-tables/
"""

import argparse
import csv
import io
import os
import re
import subprocess
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
DEFAULT_CONFIG = os.path.join(SCRIPT_DIR, "generate-system-tables-docs-config.xml")

AUTOGENERATED_START = "{/*AUTOGENERATED_START*/}"
AUTOGENERATED_END = "{/*AUTOGENERATED_END*/}"
FRONTMATTER_RE = re.compile(r"\A---\n.*?\n---\n*", re.DOTALL)

# A few historical pages have a filename which differs from the table name.
# Generate the canonical, more complete page instead of the legacy duplicate.
DOC_FILENAMES = {
    "delta_lake_metadata_log": "delta_metadata_log.mdx",
    "warnings": "system_warnings.mdx",
}

# Tables to skip in documentation generation (internal/helper tables).
SKIP_TABLES = {"transposed_metric_log"}


def unescape_tsv(value):
    """Unescape TSV escape sequences (\\n, \\t, \\', \\\\).

    Order matters: backslash must be replaced last to avoid
    double-unescaping (e.g., \\\\n -> \\n -> newline).
    """
    result = []
    i = 0
    while i < len(value):
        if value[i] == "\\" and i + 1 < len(value):
            next_char = value[i + 1]
            if next_char == "n":
                result.append("\n")
                i += 2
                continue
            elif next_char == "t":
                result.append("\t")
                i += 2
                continue
            elif next_char == "\\":
                result.append("\\")
                i += 2
                continue
            elif next_char == "'":
                result.append("'")
                i += 2
                continue
        result.append(value[i])
        i += 1
    return "".join(result)


def run_query(binary, config, query, use_client=False, extra_args=None):
    """Run a query via clickhouse-local (or clickhouse-client) and return TSV rows."""
    if use_client:
        cmd = [binary, "client", "--query", query, "--format", "TSVWithNamesAndTypes"]
    else:
        cmd = [binary, "local", "--query", query, "--format", "TSVWithNamesAndTypes"]
    if config and not use_client:
        cmd.extend(["--config-file", config])
    if extra_args:
        cmd.extend(extra_args)
    stdout = ""
    stderr = ""
    returncode = 0
    timed_out = False
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
        stdout = result.stdout
        stderr = result.stderr
        returncode = result.returncode
    except subprocess.TimeoutExpired as e:
        def _as_text(x):
            if x is None:
                return ""
            return x if isinstance(x, str) else x.decode("utf-8", errors="replace")
        stdout = _as_text(e.stdout)
        stderr = _as_text(e.stderr)
        returncode = -1
        timed_out = True
        print(f"Error: query timed out after 300 seconds: {query}", file=sys.stderr)
    reader = csv.reader(io.StringIO(stdout), delimiter="\t")
    rows = list(reader)
    # `clickhouse-local` can exit with a non-zero status because of races
    # between system log teardown and `Poco::Application` destruction, even
    # after the query has produced complete output to stdout. Tolerate that
    # specific case only: the process must have exited cleanly (no timeout)
    # and stdout must parse as TSVWithNamesAndTypes (header + types row).
    # Timeouts always propagate, since partial output may be silently accepted
    # otherwise.
    if returncode != 0:
        if not timed_out and len(rows) >= 2:
            print(
                f"Warning: query exited with code {returncode} but"
                f" produced {len(rows)} rows of output, treating as success.",
                file=sys.stderr,
            )
            if stderr:
                print(f"stderr: {stderr}", file=sys.stderr)
        else:
            print(f"Error running query: {query}", file=sys.stderr)
            print(f"stderr: {stderr}", file=sys.stderr)
            sys.exit(1)
    if len(rows) < 2:
        return []
    headers = rows[0]
    # rows[1] is the types row, skip it
    return [
        {k: unescape_tsv(v) for k, v in zip(headers, row)}
        for row in rows[2:]
    ]


def update_full_doc_file(filepath, documentation_md):
    """Replace a page body with its structured embedded documentation.

    Frontmatter and an initial MDX import/component preamble remain maintained
    in the docs tree. Everything after that preamble is a single generated
    region so descriptions, columns and examples cannot drift from the
    documentation embedded in the binary.
    """
    with open(filepath, "r") as f:
        content = f.read()

    frontmatter = FRONTMATTER_RE.match(content)
    prefix = frontmatter.group(0).rstrip("\n") if frontmatter else ""
    body = content[frontmatter.end():] if frontmatter else content

    # Some system-table pages import and render an MDX-only cloud availability
    # notice. It cannot be embedded in C++, but it must remain ahead of the
    # generated Markdown body. Only preserve the well-defined initial preamble;
    # prose and headings are owned by the structured C++ documentation.
    preamble_lines = []
    for line in body.lstrip("\n").splitlines():
        stripped = line.strip()
        if not stripped:
            if preamble_lines:
                preamble_lines.append(line)
            continue
        if line.startswith("import ") or re.fullmatch(r"<[A-Z][^>]*?/>", stripped):
            preamble_lines.append(line)
            continue
        break
    preamble = "\n".join(preamble_lines).strip("\n")

    generated = (
        AUTOGENERATED_START
        + "\n"
        + documentation_md.strip("\n")
        + "\n"
        + AUTOGENERATED_END
        + "\n"
    )
    parts = [part for part in (prefix, preamble, generated.rstrip("\n")) if part]
    new_content = "\n\n".join(parts) + "\n"

    if new_content != content:
        with open(filepath, "w") as f:
            f.write(new_content)
        return True
    return False


def create_doc_file(filepath, table_name, table_comment, documentation_md):
    """Create a new documentation file for a system table."""
    # Escape single quotes in the description for YAML.
    escaped_comment = table_comment.replace("'", "''")

    body = (
        f"{AUTOGENERATED_START}\n"
        f"{documentation_md.strip()}\n"
        f"{AUTOGENERATED_END}\n"
    )

    content = f"""---
description: '{escaped_comment}'
keywords: ['system table', '{table_name}']
sidebarTitle: 'system.{table_name}'
slug: /operations/system-tables/{table_name}
title: 'system.{table_name}'
doc_type: 'reference'
---

{body}"""
    with open(filepath, "w") as f:
        f.write(content)


def main():
    parser = argparse.ArgumentParser(
        description="Generate system tables documentation from a ClickHouse binary."
    )
    parser.add_argument(
        "--binary",
        required=True,
        help="Path to the clickhouse binary.",
    )
    parser.add_argument(
        "--docs-dir",
        required=True,
        help="Path to docs/reference/system-tables/ directory.",
    )
    parser.add_argument(
        "--config",
        default=DEFAULT_CONFIG,
        help="Path to the config file for clickhouse-local (optional).",
    )
    parser.add_argument(
        "--use-client",
        action="store_true",
        help="Use clickhouse-client instead of clickhouse-local (requires a running server).",
    )
    parser.add_argument(
        "--port",
        default=None,
        help="Port for clickhouse-client connection (default: 9000).",
    )
    args = parser.parse_args()

    binary = os.path.abspath(args.binary)
    docs_dir = os.path.abspath(args.docs_dir)
    config = os.path.abspath(args.config) if args.config else None
    use_client = args.use_client
    extra_args = []
    if args.port:
        extra_args.extend(["--port", args.port])

    if not os.path.isfile(binary):
        print(f"Error: binary not found: {binary}", file=sys.stderr)
        sys.exit(1)

    if not os.path.isdir(docs_dir):
        print(f"Error: docs directory not found: {docs_dir}", file=sys.stderr)
        sys.exit(1)

    # Query table metadata.
    # Filter out rotated log tables (e.g., query_log_0, trace_log_1) and
    # user-created tables by requiring a non-empty comment (all real system
    # tables have comments set during registration).
    print("Querying system tables...")
    tables = run_query(
        binary,
        config,
        "SELECT name, comment FROM system.tables"
        " WHERE database = 'system'"
        " AND comment != ''"
        " AND NOT match(name, '_\\\\d+$')"
        " ORDER BY name",
        use_client,
        extra_args,
    )

    # Each row is already assembled from the structured C++ documentation and
    # the live schema into the complete generated Markdown body.
    print("Querying structured system table documentation...")
    documentation = run_query(
        binary,
        config,
        "SELECT name, description FROM system.documentation"
        " WHERE type = 'System Table'"
        " ORDER BY name",
        use_client,
        extra_args,
    )
    full_documentation = {row["name"]: row["description"] for row in documentation}
    table_comments = {t["name"]: t["comment"] for t in tables}

    missing_documentation = sorted(
        set(table_comments) - set(full_documentation) - SKIP_TABLES
    )
    if missing_documentation:
        print(
            "Error: system.documentation has no entry for: "
            + ", ".join(missing_documentation),
            file=sys.stderr,
        )
        sys.exit(1)

    updated = 0
    created = 0
    skipped = 0

    for table_name in sorted(table_comments):
        if table_name in SKIP_TABLES:
            continue

        comment = table_comments[table_name]
        documentation_md = full_documentation[table_name]

        doc_filename = DOC_FILENAMES.get(table_name, f"{table_name}.mdx")
        doc_filepath = os.path.join(docs_dir, doc_filename)

        if os.path.isfile(doc_filepath):
            changed = update_full_doc_file(doc_filepath, documentation_md)
            if changed:
                updated += 1
                print(f"  Updated: {doc_filename}")
            else:
                skipped += 1
        else:
            if comment:
                create_doc_file(
                    doc_filepath,
                    table_name,
                    comment,
                    documentation_md,
                )
                created += 1
                print(f"  Created: {doc_filename}")
            else:
                print(f"  Skipped (no comment): {table_name}", file=sys.stderr)

    print(f"\nDone: {updated} updated, {created} created, {skipped} unchanged.")


if __name__ == "__main__":
    main()
